    "G4-year-closed": {
      "verdict": "FAIL",
      "quote": ".Where(p => p.Month.Year == year)\n            .ToDictionaryAsync(p => p.Month.Month, p => p);",
      "why": "В IQueryable ClosedPeriods идёт обращение к члену Year у Month, а Month сконвертирован в int через HasConversion; EF такое не транслирует, и GET /reports/year/{year} упадёт с InvalidOperationException."
    },
    "G4-client-projects": {
      "verdict": "PASS",
      "quote": ".ExecuteUpdateAsync(s => s\n                .SetProperty(p => p.IsDeleted, true)\n                .SetProperty(p => p.DeletedAt, now));",
      "why": "Удаление мягкое: ExecuteUpdate выставляет IsDeleted и DeletedAt, записи времени остаются в БД."
    },
    "G4-code-index": {
      "verdict": "PASS",
      "quote": "unique: true,\n            filter: \"\\\"IsDeleted\\\" = false\");",
      "why": "Миграция создаёт частичный уникальный индекс только по неудалённым строкам, так что пары «удалённый + заведённый заново» не мешают ему создаться; при этом в модели стоит IsUnique() без HasFilter, и модель расходится с миграцией."
    },
