+namespace Shop.Data;
+
+public record ActiveOrderSummary(Guid Id, string CustomerName, decimal Total, int ItemsCount);
+public record OverdueOrderSummary(Guid Id, string CustomerName, DateTime CreatedAt, decimal Total);
+
+public class OrderReportService
+{
+    private readonly OrderRepository _repo;
+    public OrderReportService(OrderRepository repo) => _repo = repo;
+
+    public Task<List<ActiveOrderSummary>> GetActiveOrdersAsync() =>
+        _repo.QueryActive()
+            .Select(o => new ActiveOrderSummary(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public async Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync()
+    {
+        var rows = await _repo.QueryActive()
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToListAsync();
+        return rows.ToDictionary(r => r.Category, r => r.Count);
+    }
+
+    // now must have DateTime.Kind = Unspecified: CreatedAt maps to "timestamp without time zone".
+    // Order.IsOverdue(now) itself isn't translatable to SQL, so its condition is inlined here.
+    public Task<List<OverdueOrderSummary>> GetOverdueOrdersAsync(DateTime now) =>
+        _repo.Query()
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Select(o => new OverdueOrderSummary(o.Id, o.Customer.Name, o.CreatedAt, o.Total))
+            .ToListAsync();
+}
