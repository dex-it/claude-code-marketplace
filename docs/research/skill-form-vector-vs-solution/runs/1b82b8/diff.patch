+using Microsoft.EntityFrameworkCore;
+
+namespace Tarif.Billing;
+
+public record BankStatementImportResult(int Credited, int AlreadyProcessed, int Unresolved);
+
+public class BankStatementService
+{
+    private readonly BillingDbContext _db;
+
+    public BankStatementService(BillingDbContext db) => _db = db;
+
+    public async Task<BankStatementImportResult> ImportAsync(TextReader reader)
+    {
+        var lines = BankStatement.Parse(reader);
+        var refs = lines.Select(l => l.BankRef).ToList();
+
+        // Строки, уже зачисленные или уже отложенные бухгалтеру при прошлой загрузке этой же выписки, пропускаем.
+        var processedRefs = await _db.Payments
+            .Where(p => refs.Contains(p.BankRef))
+            .Select(p => p.BankRef)
+            .Concat(_db.UnmatchedPayments
+                .Where(p => refs.Contains(p.BankRef))
+                .Select(p => p.BankRef))
+            .ToHashSetAsync();
+
+        var now = DateTime.Now;
+        int credited = 0, alreadyProcessed = 0, unresolved = 0;
+
+        foreach (var line in lines)
+        {
+            if (processedRefs.Contains(line.BankRef))
+            {
+                alreadyProcessed++;
+                continue;
+            }
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var subscriber = contractNo is null
+                ? null
+                : await _db.Subscribers.SingleOrDefaultAsync(s => s.ContractNo == contractNo);
+
+            if (subscriber is null)
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    DetectedAt = now,
+                });
+                unresolved++;
+                continue;
+            }
+
+            subscriber.Balance += line.Amount;
+            _db.Payments.Add(new Payment
+            {
+                SubscriberId = subscriber.Id,
+                Amount = line.Amount,
+                BankRef = line.BankRef,
+                PaidOn = line.PaidOn,
+                CreditedAt = now,
+                Purpose = line.Purpose,
+            });
+
+            if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+            {
+                subscriber.Status = SubscriberStatus.Active;
+                subscriber.ReactivatedAt = now;
+            }
+
+            credited++;
+        }
+
+        await _db.SaveChangesAsync();
+        return new BankStatementImportResult(credited, alreadyProcessed, unresolved);
+    }
+}
