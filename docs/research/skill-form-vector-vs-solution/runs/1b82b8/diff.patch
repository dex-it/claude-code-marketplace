+    public async Task<List<SubscriberDto>> SearchByPhoneAsync(string phoneSuffix)
+    {
+        return await _db.Subscribers.AsNoTracking()
+            .Where(s => s.Phone.EndsWith(phoneSuffix))
+            .OrderBy(s => s.Id)
+            .Take(20)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+    }
