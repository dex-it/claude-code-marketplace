+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearSummaryMonth(
+    int Month,
+    DateOnly? ActSignedOn,
+    decimal TotalHours
+);
+
+public record YearSummaryResponse(int Year, List<YearSummaryMonth> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearSummaryResponse> GetYearSummaryAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .AsNoTracking()
+            .Where(p => p.Month.Year == year)
+            .ToListAsync();
+
+        var closedDict = closedPeriods.ToDictionary(p => p.Month.Month, p => p.ActSignedOn);
+
+        var yearStart = new DateOnly(year, 1, 1);
+        var yearEnd = new DateOnly(year, 12, 31);
+
+        var hoursByMonth = await _db.TimeEntries
+            .AsNoTracking()
+            .Where(t => t.WorkDate >= yearStart && t.WorkDate <= yearEnd)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, TotalHours = g.Sum(t => t.Hours) })
+            .ToListAsync();
+
+        var hoursDict = hoursByMonth.ToDictionary(x => x.Month, x => x.TotalHours);
+
+        var months = new List<YearSummaryMonth>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var actSignedOn = closedDict.TryGetValue(month, out var signed) ? signed : null;
+            var totalHours = hoursDict.TryGetValue(month, out var hours) ? hours : 0;
+            months.Add(new YearSummaryMonth(month, actSignedOn, totalHours));
+        }
+
+        return new YearSummaryResponse(year, months);
+    }
+}
