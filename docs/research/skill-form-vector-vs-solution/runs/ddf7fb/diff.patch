+    // Удаление клиента по просьбе клиента: сам клиент, его питомцы и визиты питомцев
+    // перестают появляться в списках/карточках/расписании. Физически данные не удаляются
+    // (требование ветнадзора хранить историю 5 лет), поэтому помечаем IsDeleted каскадно
+    // по всем зависимым таблицам одной транзакцией. Идемпотентно: повторный вызов ничего не меняет.
+    public async Task DeleteOwnerAsync(int ownerId)
+    {
