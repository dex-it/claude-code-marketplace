+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record ClosePayload(string Comment);
+
+public record PlanItemPayload(string WorkCode, string Title, int PeriodDays);
+
+// Регистрация эндпоинтов сервиса: подключить MapHousingEndpoints() в Program.cs.
+public static class HousingEndpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/requests", async (
+            HousingService service,
+            string? text, RequestStatus? status, int? houseId, string? district,
+            string sort = "date", string dir = "desc", int page = 1, int pageSize = 50) =>
+        {
+            try
+            {
+                var rows = await service.SearchAsync(
+                    new RequestSearch(text, status, houseId, district, sort, dir, page, pageSize));
+                return Results.Ok(rows);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        app.MapGet("/requests/{id:int}", async (int id, HousingService service) =>
+        {
+            var card = await service.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        app.MapPost("/requests/{id:int}/close", async (int id, ClosePayload payload, HousingService service) =>
+        {
+            try
+            {
+                await service.CloseRequestAsync(id, payload.Comment);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (RequestStateConflictException ex)
+            {
+                return Results.Conflict(ex.Message);
+            }
+        });
+
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemPayload> items, PlanService service) =>
+        {
+            try
+            {
+                var input = items.Select(i => new PlanItemInput(i.WorkCode, i.Title, i.PeriodDays)).ToList();
+                await service.ReplacePlanAsync(id, input);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+        });
+
+        return app;
+    }
+}
