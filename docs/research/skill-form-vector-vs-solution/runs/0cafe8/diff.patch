+    // Инженер присылает план целиком: план дома становится таким, как присланный список.
+    // Работы, которые остаются в плане (совпадают по WorkCode), сохраняют свой PlanItem.Id и историю
+    // выполнения; работы, которых больше нет в списке, удаляются вместе со своей историей;
+    // новые работы добавляются как новые PlanItem без истории.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+            throw new KeyNotFoundException($"Дом {houseId} не найден");
+
+        var codes = items.Select(i => i.WorkCode).ToList();
+        if (codes.Distinct().Count() != codes.Count)
+            throw new ArgumentException("Коды работ в плане не должны повторяться.");
+
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var incomingByCode = items.ToDictionary(i => i.WorkCode);
+
+        foreach (var existing in plan.Items.ToList())
+        {
+            if (incomingByCode.TryGetValue(existing.WorkCode, out var updated))
+            {
+                existing.Title = updated.Title;
+                existing.PeriodDays = updated.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Remove(existing);
+                _db.PlanItems.Remove(existing);
+            }
+        }
+
+        var existingCodes = plan.Items.Select(i => i.WorkCode).ToHashSet();
+        foreach (var item in items.Where(i => !existingCodes.Contains(i.WorkCode)))
+        {
+            plan.Items.Add(new PlanItem
+            {
+                WorkCode = item.WorkCode,
+                Title = item.Title,
+                PeriodDays = item.PeriodDays,
+            });
+        }
+
+        await _db.SaveChangesAsync();
+    }
