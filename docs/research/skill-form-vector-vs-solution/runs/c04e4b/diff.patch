+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthlyReport(int Month, bool IsClosed, DateOnly? ActSignedOn, decimal TotalHours);
+
+public record YearReport(int Year, List<MonthlyReport> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearReport> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .AsNoTracking()
+            .Where(p => p.Month.Year == year)
+            .ToDictionaryAsync(p => p.Month.Month);
+
+        var monthlyHours = await _db.TimeEntries
+            .AsNoTracking()
+            .Where(t => t.WorkDate.Year == year)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(x => x.Month);
+
+        var months = new List<MonthlyReport>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var isClosed = closedPeriods.TryGetValue(month, out var closed);
+            var hours = monthlyHours.TryGetValue(month, out var h) ? h : 0;
+            months.Add(new MonthlyReport(month, isClosed, closed?.ActSignedOn, hours));
+        }
+
+        return new YearReport(year, months);
+    }
+}
