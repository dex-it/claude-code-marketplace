+    public async Task UpdatePlanAsync(int houseId, List<PlanItemDto> items)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId)
+            ?? throw new KeyNotFoundException($"План дома с id {houseId} не найден");
+
+        var newCodes = items.Select(i => i.WorkCode).ToHashSet();
+        var existingItems = plan.Items.ToList();
+
+        foreach (var item in existingItems.Where(i => !newCodes.Contains(i.WorkCode)).ToList())
+        {
+            item.Completions.Clear();
+            plan.Items.Remove(item);
+        }
+
+        foreach (var dto in items)
+        {
+            var existing = existingItems.FirstOrDefault(i => i.WorkCode == dto.WorkCode);
+            if (existing != null)
+            {
+                existing.Title = dto.Title;
+                existing.PeriodDays = dto.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = dto.WorkCode,
+                    Title = dto.Title,
+                    PeriodDays = dto.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
