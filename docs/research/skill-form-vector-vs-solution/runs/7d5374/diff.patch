@@ -0,0 +1,49 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesRow(int? InstructorId, string Instructor, bool Dismissed, DateOnly? DismissedOn, int Graduates);
+public record GraduatesReport(int Year, int Total, List<GraduatesRow> Instructors);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Выпускники за год (по дате выпуска) по инструкторам, включая уволенных — для продления лицензии.
+    public async Task<GraduatesReport> GraduatesAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated && s.GraduatedOn >= from && s.GraduatedOn < to)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var withGraduates = counts.Where(c => c.InstructorId != null).Select(c => c.InstructorId!.Value).ToList();
+
+        // Фильтр модели скрывает уволенных, поэтому он снят, а автошкола ограничена явно.
+        // В отчёт попадают все, кто работал в этом году, и все, у кого есть выпускники за год.
+        var schoolId = _db.SchoolId;
+        var instructors = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == schoolId)
+            .Where(i => !i.IsDeleted || i.DismissedOn == null || i.DismissedOn >= from || withGraduates.Contains(i.Id))
+            .ToListAsync();
+
+        var rows = instructors
+            .Select(i => new GraduatesRow(i.Id, i.FullName, i.IsDeleted, i.DismissedOn,
+                counts.FirstOrDefault(c => c.InstructorId == i.Id)?.Count ?? 0))
+            .OrderByDescending(r => r.Graduates)
+            .ThenBy(r => r.Instructor)
+            .ToList();
+
+        var unassigned = counts.FirstOrDefault(c => c.InstructorId == null)?.Count ?? 0;
+        if (unassigned > 0)
+            rows.Add(new GraduatesRow(null, "Без инструктора", false, null, unassigned));
+
+        return new GraduatesReport(year, counts.Sum(c => c.Count), rows);
+    }
+}
