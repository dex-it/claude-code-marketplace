+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginCodeRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResult(int StudentId, string Token, DateTime ExpiresAt);
+
+// Вход в мобильное приложение ученика по одноразовому коду из письма.
+public class AppLoginService
+{
+    private static readonly TimeSpan CodeLifetime = TimeSpan.FromMinutes(10);
+    private static readonly TimeSpan ResendInterval = TimeSpan.FromMinutes(1);
+    private static readonly TimeSpan SessionLifetime = TimeSpan.FromDays(30);
+    private const int MaxAttempts = 5;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppLoginService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Ответ вызывающему всегда одинаковый: по нему нельзя узнать, есть ли такой ученик.
+    public async Task RequestCodeAsync(LoginCodeRequest req)
+    {
+        var student = await FindStudentAsync(req.Email);
+        if (student is null)
+            return;
+
+        var now = DateTime.UtcNow;
+        var old = await _db.AppLoginCodes.Where(c => c.StudentId == student.Id).ToListAsync();
+        if (old.Any(c => c.ExpiresAt > now && c.CreatedAt > now - ResendInterval))
+            return; // не чаще раза в минуту
+
+        // Новый код отменяет предыдущие.
+        _db.AppLoginCodes.RemoveRange(old);
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.AppLoginCodes.Add(new AppLoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = HashCode(student.Id, code),
+            CreatedAt = now,
+            ExpiresAt = now + CodeLifetime,
+        });
+
+        // Код сохраняется до отправки письма, чтобы ученик не получил код, которого нет в базе.
+        await _db.SaveChangesAsync();
+        await _email.SendAsync(student.Email, "Код входа в приложение автошколы",
+            $"Ваш код для входа: {code}. Код действует 10 минут.");
+    }
+
+    public async Task<LoginResult?> ConfirmAsync(LoginConfirmRequest req)
+    {
+        var code = (req.Code ?? "").Trim();
+        if (code.Length != 6 || !code.All(char.IsAsciiDigit))
+            return null;
+
+        var student = await FindStudentAsync(req.Email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var entry = await _db.AppLoginCodes
+            .Where(c => c.StudentId == student.Id && c.ExpiresAt > now)
+            .OrderByDescending(c => c.CreatedAt)
+            .FirstOrDefaultAsync();
+        if (entry is null || entry.Attempts >= MaxAttempts)
+            return null;
+
+        var expected = Encoding.ASCII.GetBytes(entry.CodeHash);
+        var actual = Encoding.ASCII.GetBytes(HashCode(student.Id, code));
+        if (!CryptographicOperations.FixedTimeEquals(expected, actual))
+        {
+            entry.Attempts++; // сохраняется SaveChangesFilter
+            return null;
+        }
+
+        _db.AppLoginCodes.Remove(entry);
+
+        var token = Convert.ToHexString(RandomNumberGenerator.GetBytes(32));
+        var session = new AppSession
+        {
+            StudentId = student.Id,
+            TokenHash = HashToken(token),
+            ExpiresAt = now + SessionLifetime,
+        };
+        _db.AppSessions.Add(session);
+
+        return new LoginResult(student.Id, token, session.ExpiresAt);
+    }
+
+    // Ученик по заголовку "Authorization: Bearer <token>"; null — нет действующей сессии.
+    public async Task<int?> AuthenticateAsync(string? authorization)
+    {
+        const string prefix = "Bearer ";
+        if (string.IsNullOrEmpty(authorization) || !authorization.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
+            return null;
+
+        var hash = HashToken(authorization[prefix.Length..].Trim());
+        var now = DateTime.UtcNow;
+        return await _db.AppSessions.AsNoTracking()
+            .Where(s => s.TokenHash == hash && s.ExpiresAt > now)
+            .Select(s => (int?)s.StudentId)
+            .FirstOrDefaultAsync();
+    }
+
+    // E-mail в карточке хранится как ввёл администратор, ученик вводит как подставит клавиатура:
+    // сравниваем без учёта регистра и пробелов по краям. Неоднозначное совпадение — не входим.
+    private async Task<Student?> FindStudentAsync(string? email)
+    {
+        var normalized = (email ?? "").Trim().ToLowerInvariant();
+        if (normalized.Length == 0)
+            return null;
+
+        var found = await _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == normalized && s.Status != StudentStatus.Expelled)
+            .Take(2)
+            .ToListAsync();
+        return found.Count == 1 ? found[0] : null;
+    }
+
+    private static string HashCode(int studentId, string code) => Sha256Hex($"{studentId}:{code}");
+
+    private static string HashToken(string token) => Sha256Hex(token);
+
+    private static string Sha256Hex(string value) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
+}
