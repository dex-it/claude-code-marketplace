@@ -41,10 +44,37 @@ public class ShopDbContext : DbContext
     public DbSet<Order> Orders => Set<Order>();
     public DbSet<Product> Products => Set<Product>();
     public DbSet<AuditLog> AuditLogs => Set<AuditLog>();
+    // Колонка остаётся "timestamp without time zone" (её видят отчёты DBA), но Npgsql 8 требует
+    // Kind=Unspecified при записи в такую колонку и отдаёт Kind=Unspecified при чтении.
+    // Конвертер снимает/восстанавливает Kind=Utc на границе с БД, чтобы в коде всегда был UTC.
+    private static readonly ValueConverter<DateTime, DateTime> UtcNoTzConverter = new(
+        toDb => DateTime.SpecifyKind(toDb.Kind == DateTimeKind.Local ? toDb.ToUniversalTime() : toDb, DateTimeKind.Unspecified),
+        fromDb => DateTime.SpecifyKind(fromDb, DateTimeKind.Utc));
+
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(UtcNoTzConverter);
+
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint("CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Cascade обязателен: OrderItem.OrderId/Payment.OrderId не nullable, а ClearItems()
+        // разрывает связь через Clear() коллекции - при Restrict/ClientSetNull EF попытается
+        // обнулить обязательный FK и SaveChanges бросит InvalidOperationException.
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .OnDelete(DeleteBehavior.Cascade);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .OnDelete(DeleteBehavior.Cascade);
     }
 }
