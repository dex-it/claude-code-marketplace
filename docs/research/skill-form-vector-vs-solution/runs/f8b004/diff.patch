 namespace Shop.Data;
 
+public record ActiveOrderReportLine(Guid OrderId, string CustomerName, decimal Total, int ItemCount);
+
 public class OrderRepository
 {
     private readonly ShopDbContext _db;
     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    private IQueryable<Order> ActiveOrders => _db.Orders.Where(o => o.Status == "active");
+
+    public Task<List<ActiveOrderReportLine>> GetActiveOrderLinesAsync() =>
+        ActiveOrders
+            .Select(o => new ActiveOrderReportLine(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync() =>
+        ActiveOrders
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    // Mirrors Order.IsOverdue (ShippedAt == null && CreatedAt.AddDays(3) < now) so it can be evaluated in SQL.
+    public Task<List<Order>> GetOverdueOrdersAsync(DateTime now) =>
+        _db.Orders
+            .Include(o => o.Customer)
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .ToListAsync();
 }
