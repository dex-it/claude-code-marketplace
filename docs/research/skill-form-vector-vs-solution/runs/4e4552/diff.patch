+    // Карточка последнего состоявшегося визита питомца (запланированные и отменённые не считаются)
+    public async Task<LastVisitCard?> GetLastVisitCardAsync(int petId, CancellationToken ct = default)
+    {
+        // Сначала однозначно выбираем визит: при совместном приёме у питомца несколько визитов с одним SlotStart,
