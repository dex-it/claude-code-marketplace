new file mode 100644
index 0000000..aa05ee4
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,45 @@
+name: Deploy
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch: {}
+
+env:
+  DOTNET_VERSION: "8.0.x"
+  # Adjust to the actual path of the Shop.Data project in the real repo.
+  MIGRATIONS_PROJECT: Shop.Data/Shop.Data.csproj
+
+jobs:
+  migrate-production-db:
+    name: Apply EF Core migrations (production)
+    runs-on: ubuntu-latest
+    environment: production   # requires manual approval via environment protection rules
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: ${{ env.DOTNET_VERSION }}
+
+      - name: Build migrations bundle
+        run: |
+          dotnet tool install --global dotnet-ef
+          dotnet ef migrations bundle \
+            --project "${{ env.MIGRATIONS_PROJECT }}" \
+            --configuration Release \
+            --self-contained -r linux-x64 \
+            --output efbundle
+
+      - name: Apply migrations to production
+        env:
+          ConnectionStrings__Default: ${{ secrets.PRODUCTION_DB_CONNECTION_STRING }}
+        run: ./efbundle --connection "$ConnectionStrings__Default"
+
+  deploy-app:
+    name: Deploy application
+    runs-on: ubuntu-latest
+    needs: migrate-production-db
+    environment: production
+    steps:
+      - run: echo "App deploy steps go here (run after migrations succeed)."
