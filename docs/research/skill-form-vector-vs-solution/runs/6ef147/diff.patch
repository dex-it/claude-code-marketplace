+
+    // Карточка последнего состоявшегося визита питомца. Питомец может быть в одном слоте у нескольких
+    // врачей (совместный приём), поэтому возвращаются все визиты последнего слота, а не один произвольный.
+    // Пустой список - у питомца нет состоявшихся визитов.
+    public async Task<IReadOnlyList<VisitCard>> GetLastVisitCardAsync(int petId, CancellationToken ct = default)
+    {
+        var held = db.Visits.Where(v => v.PetId == petId && HeldStatuses.Contains(v.Status));
+
+        var lastSlot = await held.MaxAsync(v => (DateTime?)v.SlotStart, ct);
+        if (lastSlot is null)
+            return [];
+
+        var slot = lastSlot.Value;
+
+        // Две коллекции одного уровня - грузятся split-запросами (настроено в Program.cs)
