+namespace VetClinic.Journal.Services;
+
+// Местное время клиники (филиал в Екатеринбурге). В БД моменты хранятся в UTC (timestamptz).
+public static class ClinicTime
+{
+    public static readonly TimeZoneInfo Zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Yekaterinburg");
+
+    public static DateTimeOffset ToLocal(DateTime utc) =>
+        TimeZoneInfo.ConvertTime(new DateTimeOffset(DateTime.SpecifyKind(utc, DateTimeKind.Utc)), Zone);
+
+    // Начало местных суток как UTC-момент (Kind=Utc - Npgsql пишет в timestamptz только Utc)
+    public static DateTime StartOfDayUtc(DateOnly date) =>
+        TimeZoneInfo.ConvertTimeToUtc(date.ToDateTime(TimeOnly.MinValue, DateTimeKind.Unspecified), Zone);
+}
