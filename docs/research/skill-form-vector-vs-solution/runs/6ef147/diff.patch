+                v.Diagnosis,
+                v.LabResults
+                    .Select(r => new LabResultItem(r.Id, r.TestCode, r.Value, r.Unit, ClinicTime.ToLocal(r.TakenAt)))
+                    .ToList(),
+                v.Prescriptions))
