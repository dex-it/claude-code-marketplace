+    // Выгрузка состоявшихся приёмов врача за период [from; to] по местным датам клиники.
+    // Строки читаются потоком и сразу пишутся в output - выборка целиком в память не поднимается.
+    public async Task ExportVetVisitsCsvAsync(int vetId, DateOnly from, DateOnly to, Stream output, CancellationToken ct = default)
+    {
+        if (to < from)
+            throw new ArgumentException("Дата окончания периода раньше даты начала.", nameof(to));
+
+        var fromUtc = ClinicTime.StartOfDayUtc(from);
+        var toUtcExclusive = ClinicTime.StartOfDayUtc(to.AddDays(1));
+
+        var rows = db.Visits
+            .Where(v => v.VetId == vetId
+                        && v.SlotStart >= fromUtc
+                        && v.SlotStart < toUtcExclusive
+                        && HeldStatuses.Contains(v.Status))
+            .OrderBy(v => v.SlotStart)
+            .ThenBy(v => v.Id)
+            .Select(v => new
+            {
+                v.SlotStart,
+                PetName = v.Pet.Name,
+                v.Complaint,
+                v.Diagnosis,
+                PrescriptionCount = v.Prescriptions.Count()
+            })
+            .AsAsyncEnumerable();
+
+        // UTF-8 с BOM и разделитель ";" - так файл корректно открывается в Excel с русской локалью
+        await using var writer = new StreamWriter(output, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true), 64 * 1024, leaveOpen: true)
+        {
+            NewLine = "\r\n"
+        };
+
+        await writer.WriteLineAsync("Дата и время приёма;Кличка;Жалоба;Диагноз;Число назначений");
+
+        await foreach (var r in rows.WithCancellation(ct))
+        {
+            await writer.WriteLineAsync(string.Join(';',
+                ClinicTime.ToLocal(r.SlotStart).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture),
+                Csv(r.PetName),
+                Csv(r.Complaint),
+                Csv(r.Diagnosis),
+                r.PrescriptionCount.ToString(CultureInfo.InvariantCulture)));
+        }
+
+        await writer.FlushAsync(ct);
+    }
+
+    private static string Csv(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+            return "";
+
+        return value.IndexOfAny([';', '"', '\r', '\n']) >= 0
+            ? "\"" + value.Replace("\"", "\"\"") + "\""
+            : value;
+    }
 }
