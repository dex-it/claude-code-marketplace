+    DateTimeOffset SlotStart,
+    VisitStatus Status,
+    int PetId,
+    string PetName,
+    int VetId,
+    string VetName,
+    string Complaint,
+    string? Diagnosis,
+    IReadOnlyList<LabResultItem> LabResults,
+    IReadOnlyList<PrescriptionItem> Prescriptions);
