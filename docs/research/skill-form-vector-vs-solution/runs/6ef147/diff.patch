-app.MapGet("/journal/search", (string q, int page, VisitJournalService s) => s.SearchAsync(q, page));
+app.MapGet("/journal/search", async (string q, int page, string? scope, VisitJournalService s) =>
+    VisitJournalService.TryParseScope(scope, out var searchScope)
+        ? Results.Ok(await s.SearchAsync(q, searchScope, page))
+        : Results.BadRequest("scope: complaint | diagnosis | drug"));
+
+app.MapGet("/pets/{petId:int}/last-visit", async (int petId, VisitJournalService s, CancellationToken ct) =>
+{
+    var cards = await s.GetLastVisitCardAsync(petId, ct);
+    return cards.Count == 0 ? Results.NotFound() : Results.Ok(cards);
+});
+
+app.MapGet("/vets/{vetId:int}/visits/export.csv",
+    (int vetId, DateOnly from, DateOnly to, VisitJournalService s, CancellationToken ct) =>
+        to < from
+            ? Results.BadRequest("from должна быть не позже to")
+            : Results.Stream(
+                stream => s.ExportVetVisitsCsvAsync(vetId, from, to, stream, ct),
+                "text/csv; charset=utf-8",
+                $"visits-vet{vetId}-{from:yyyy-MM-dd}-{to:yyyy-MM-dd}.csv"));
 
 app.Run();
