@@ -0,0 +1,30 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Pixelwork.Timesheets;
+
+public static class ReportAndClientEndpoints
+{
+    // В Program.cs: app.MapReportAndClientEndpoints();
+    public static IEndpointRouteBuilder MapReportAndClientEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/reports/year/{year:int}", async (int year, TimeEntryService svc) =>
+        {
+            if (year is < 2000 or > 2100)
+                return Results.BadRequest(new { error = "Год вне допустимого диапазона" });
+
+            return Results.Ok(await svc.YearSummaryAsync(year));
+        });
+
+        app.MapDelete("/clients/{id:int}/projects", async (int id, ProjectService svc) =>
+        {
+            var deleted = await svc.DeleteClientProjectsAsync(id);
+            return deleted is null
+                ? Results.NotFound()
+                : Results.Ok(new { deleted });
+        });
+
+        return app;
+    }
+}
