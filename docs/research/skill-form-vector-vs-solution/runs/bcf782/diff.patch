+    // Обновить план дома: заменить список работ на новый, сохраняя историю выполнения.
+    public async Task UpdatePlanAsync(int houseId, List<PlanItemUpdateDto> items)
+    {
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .SingleAsync(p => p.HouseId == houseId);
+
+        var newWorkCodes = items.Select(i => i.WorkCode).ToHashSet();
+        var oldItems = plan.Items.ToList();
+
+        // Удалить работы, которых нет в новом плане
+        foreach (var item in oldItems.Where(i => !newWorkCodes.Contains(i.WorkCode)).ToList())
+        {
+            plan.Items.Remove(item);
+        }
+
+        // Добавить или обновить работы из нового плана
+        foreach (var newItem in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == newItem.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = newItem.Title;
+                existing.PeriodDays = newItem.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
