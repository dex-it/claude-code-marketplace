+        b.Entity<Order>().Property(o => o.Complexity).IsRequired();
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint("CK_Order_Complexity", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Колонка остаётся timestamp (отчёты DBA): пишем UTC-значение с Kind=Unspecified
