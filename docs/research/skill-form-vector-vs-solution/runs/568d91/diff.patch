+    // Обновить план дома целиком: история выполнения сохраняется для работ, остающихся в плане.
+    public async Task UpdatePlanAsync(int houseId, List<UpdatePlanItemDto> newPlan)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .SingleAsync(p => p.HouseId == houseId);
+
+        var newWorkCodes = newPlan.Select(p => p.WorkCode).ToHashSet();
+        var currentItems = plan.Items.ToDictionary(i => i.WorkCode);
+
+        var itemsToDelete = plan.Items.Where(i => !newWorkCodes.Contains(i.WorkCode)).ToList();
+        foreach (var item in itemsToDelete)
+        {
+            _db.PlanItems.Remove(item);
+        }
+
+        foreach (var newItem in newPlan)
+        {
+            if (currentItems.TryGetValue(newItem.WorkCode, out var existing))
+            {
+                existing.Title = newItem.Title;
+                existing.PeriodDays = newItem.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
 }
