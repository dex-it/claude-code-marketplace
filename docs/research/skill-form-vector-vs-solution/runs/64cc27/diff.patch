diff --git a/ReportService.cs b/ReportService.cs
new file mode 100644
index 0000000..5388ec5
--- /dev/null
+++ b/ReportService.cs
@@ -0,0 +1,146 @@
+using System.Globalization;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+
+namespace BookQuarter.Library;
+
+public record OverdueLoanDto(int LoanId, string ReaderName, string CardNumber, string Phone,
+    string Title, DateOnly DueDate, int OverdueDays);
+
+public record BranchLoansDto(int BranchId, string BranchName, int Loans);
+
+public record CsvExport(byte[] Content, int Rows);
+
+public class ReportService
+{
+    private const string DebtorsTarget = "debtors.csv";
+
+    private readonly LibraryDbContext _db;
+    private readonly decimal _finePerDay;
+
+    public ReportService(LibraryDbContext db, IOptions<FinesOptions> fines)
+    {
+        _db = db;
+        _finePerDay = fines.Value.PerDay;
+    }
+
+    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);
+
+    // Просроченные выдачи филиала для обзвона. Телефон полный - его набирает сотрудник.
+    // Loan.IsOverdue/OverdueDays не переводятся в SQL, поэтому условие повторено явно,
+    // а дни считаются после загрузки. Сортировка по сроку возврата = по дням просрочки.
+    public async Task<IReadOnlyList<OverdueLoanDto>?> GetOverdueAsync(int branchId)
+    {
+        if (!await _db.Branches.AnyAsync(b => b.Id == branchId))
+            return null;
+
+        var today = Today;
+        var rows = await _db.Loans
+            .AsNoTracking()
+            .Where(l => l.BranchId == branchId && l.ReturnedAt == null && l.DueDate < today)
+            .OrderBy(l => l.DueDate)
+            .ThenBy(l => l.Reader.FullName)
+            .Select(l => new
+            {
+                l.Id, l.Reader.FullName, l.Reader.CardNumber, l.Reader.Phone, l.Book.Title, l.DueDate,
+            })
+            .ToListAsync();
+
+        return rows
+            .Select(r => new OverdueLoanDto(r.Id, r.FullName, r.CardNumber, r.Phone, r.Title,
+                r.DueDate, today.DayNumber - r.DueDate.DayNumber))
+            .ToList();
+    }
+
+    // Выгрузка должников всей сети для коллекторского агентства.
+    // Контакты маскируются так же, как на карточке читателя; штраф - только за текущую
+    // (ещё не закрытую возвратом) просрочку по всем открытым выдачам читателя.
+    public async Task<CsvExport> ExportDebtorsAsync(string exportedBy)
+    {
+        var today = Today;
+        var loans = await _db.Loans
+            .AsNoTracking()
+            .Where(l => l.ReturnedAt == null && l.DueDate < today)
+            .Select(l => new
+            {
+                l.ReaderId, l.Reader.FullName, l.Reader.CardNumber, l.Reader.Phone, l.Reader.Email, l.DueDate,
+            })
+            .ToListAsync();
+
+        var debtors = loans
+            .GroupBy(l => l.ReaderId)
+            .Select(g =>
+            {
+                var r = g.First();
+                var days = g.Sum(l => today.DayNumber - l.DueDate.DayNumber);
+                return new
+                {
+                    r.FullName,
+                    r.CardNumber,
+                    Phone = ReaderExtensions.MaskPhone(r.Phone),
+                    Email = ReaderExtensions.MaskEmail(r.Email),
+                    Fine = days * _finePerDay,
+                };
+            })
+            .OrderBy(d => d.FullName)
+            .ThenBy(d => d.CardNumber)
+            .ToList();
+
+        var sb = new StringBuilder();
+        sb.Append("ФИО;Номер билета;Телефон;E-mail;Штраф\r\n");
+        foreach (var d in debtors)
+        {
+            sb.Append(Csv(d.FullName)).Append(';')
+              .Append(Csv(d.CardNumber)).Append(';')
+              .Append(Csv(d.Phone)).Append(';')
+              .Append(Csv(d.Email)).Append(';')
+              .Append(d.Fine.ToString("0.00", CultureInfo.InvariantCulture))
+              .Append("\r\n");
+        }
+
+        _db.ExportLogs.Add(new ExportLog
+        {
+            Target = DebtorsTarget,
+            ExportedBy = exportedBy,
+            ExportedAt = DateTime.UtcNow,
+            Rows = debtors.Count,
+        });
+        await _db.SaveChangesAsync();
+
+        // BOM - чтобы Excel открыл кириллицу без ручного выбора кодировки.
+        var content = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
+        return new CsvExport(content, debtors.Count);
+    }
+
+    // Число выдач по филиалам за период [from; to] включительно (даты по UTC).
+    // Верхняя граница - начало дня, следующего за "to", иначе выдачи за последний день теряются.
+    public async Task<IReadOnlyList<BranchLoansDto>> GetLoansByBranchAsync(DateOnly from, DateOnly to)
+    {
+        var start = from.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
+        var end = to.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
+
+        return await _db.Branches
+            .AsNoTracking()
+            .OrderBy(b => b.Name)
+            .Select(b => new BranchLoansDto(
+                b.Id,
+                b.Name,
+                _db.Loans.Count(l => l.BranchId == b.Id && l.IssuedAt >= start && l.IssuedAt < end)))
+            .ToListAsync();
+    }
+
+    // RFC 4180-экранирование + защита от CSV/formula injection при открытии в Excel.
+    private static string Csv(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+            return "";
+
+        if (value[0] is '=' or '+' or '-' or '@' or '\t' or '\r')
+            value = "'" + value;
+
+        return value.IndexOfAny(new[] { ';', '"', '\r', '\n' }) >= 0
+            ? "\"" + value.Replace("\"", "\"\"") + "\""
+            : value;
+    }
+}
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..f357e99
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,17 @@
+Все четыре задачи сделаны. Сборку и тесты я не запускал, как и просили, так что код ни разу не компилировался и не выполнялся.
+
+**Созданы:**
+- `ReportService.cs` — просроченные выдачи (а), CSV по должникам с записью в ExportLog (б), отчёт по выдачам (в).
+- `FinesOptions.cs` — настройки штрафа (г).
+- `appsettings.json` — секция `Fines:PerDay` (= 10, как было в коде).
+
+**Изменены:**
+- `Program.cs` — три новых endpoint'а; ставка штрафа читается из конфигурации и проверяется при старте.
+- `LoanService.cs` — ставка штрафа берётся из конфигурации вместо константы; при чтении карточки читателя EF больше не отслеживает загруженного читателя (`AsNoTracking`).
+- `ReaderExtensions.cs` — из `MaskContacts` выделены отдельные функции `MaskPhone` и `MaskEmail`, которые не меняют объект.
+
+**Решения:**
+- **Не испортить контакты в базе.** `MaskContacts` подменяет телефон и e-mail прямо в объекте читателя. Выгрузка должников после этого сохраняет запись в журнал. Если бы маскировались читатели, загруженные с отслеживанием EF, вместе с журналом в базу записались бы маски вместо настоящих контактов. Поэтому выгрузка и карточка читают данные без отслеживания, а маскирование идёт через функции, которые объект не меняют.
+- **Просрочка и штраф.** `IsOverdue` и `OverdueDays` не переводятся в SQL, поэтому условие просрочки повторено в запросе, а дни считаются после загрузки. Сортировка по сроку возврата по возрастанию — это то же, что «самые давние сверху». Штраф в CSV — это дни текущей просрочки по всем открытым выдачам читателя, умноженные на ставку. Уже начисленный `FineBalance` в эту сумму не входит.
+- **Отчёт за период.** Выдачи отбираются от начала дня `from` до начала дня после `to`, иначе выдачи за последний день периода терялись бы. Даты считаются по UTC. Филиалы без выдач попадают в отчёт с нулём. Если `from` позже `to`, возвращается 400.
+- **CSV.** Разделитель `;`, кодировка UTF-8 с BOM (чтобы Excel сразу показывал кириллицу), значения экранируются, плюс защита от формул в ячейках. Если нет заголовка `X-User`, возвращается 400.
