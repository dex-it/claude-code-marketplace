@@ -0,0 +1,32 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+// Период в часовом поясе пользователя; DateTimeOffset сравнивается с IssuedAt (timestamptz) по UTC-моменту, офсет роли не играет.
+public record LoansByBranchRequest(DateTimeOffset From, DateTimeOffset To);
+
+public sealed class BranchLoanCount
+{
+    public int BranchId { get; init; }
+    public string BranchName { get; init; } = "";
+    public int LoanCount { get; init; }
+}
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // Число выдач по каждому филиалу за период; филиалы без выдач тоже входят в отчёт, с нулём.
+    public Task<List<BranchLoanCount>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to) =>
+        _db.Branches
+            .OrderBy(b => b.Id)
+            .Select(b => new BranchLoanCount
+            {
+                BranchId = b.Id,
+                BranchName = b.Name,
+                LoanCount = _db.Loans.Count(l => l.BranchId == b.Id && l.IssuedAt >= from && l.IssuedAt < to),
+            })
+            .ToListAsync();
+}
