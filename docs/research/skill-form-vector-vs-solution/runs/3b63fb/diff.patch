+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (а) карточка одного заказа: один JOIN-запрос эффективнее split query для single entity
+    public Task<Order?> GetOrderCardAsync(Guid orderId) =>
+        _db.Orders
+            .AsNoTracking()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync(o => o.Id == orderId);
+
+    // (б) у клиента тысячи заказов х Items x Payments — JOIN даст cartesian explosion, нужен AsSplitQuery
+    public Task<List<Order>> GetCustomerOrdersAsync(Guid customerId) =>
+        _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .ToListAsync();
+
+    // (в) sku уникален только в рамках склада; если warehouse не передан — по sku может быть несколько строк,
+    // поэтому Single() допустим лишь когда warehouse задан
+    public Task<Product?> GetProductBySkuAsync(string sku, string? warehouse) =>
+        warehouse is null
+            ? _db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.Sku == sku)
+            : _db.Products.AsNoTracking().SingleOrDefaultAsync(p => p.Sku == sku && p.Warehouse == warehouse);
+
+    // (г) MAX(ShippedAt) считается в SQL; ShippedAt != null отфильтрован в WHERE, поэтому .Value безопасен.
+    // Если у клиента нет отгруженных заказов — контракт non-nullable DateTime нарушить нечем, кидаем исключение.
+    public async Task<DateTime> GetLastShippedDateAsync(Guid customerId)
+    {
+        var lastShippedAt = await _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .MaxAsync(o => o.ShippedAt);
+
+        if (lastShippedAt is null)
+            throw new InvalidOperationException($"Customer {customerId} has no shipped orders");
+
+        return lastShippedAt.Value;
+    }
+}
