+    public async Task<DateTime> FreezeMembershipAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Число дней должно быть положительным");
+
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FreezeUntil = DateTime.UtcNow.AddDays(days);
+        await _db.SaveChangesAsync();
+        return member.FreezeUntil.Value;
+    }
+
+    public async Task UnfreezeMembershipAsync(int memberId)
+    {
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FreezeUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<RandomSessionDto?> GetRandomQualitySessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        var count = await _db.Sessions.CountAsync(s => s.StartsAt >= now && s.StartsAt <= until);
+        if (count == 0)
+            return null;
+
+        var index = Random.Shared.Next(count);
+
+        var sessionId = await _db.Sessions
+            .Where(s => s.StartsAt >= now && s.StartsAt <= until)
+            .OrderBy(s => s.Id)
+            .Skip(index)
+            .Select(s => s.Id)
+            .FirstAsync();
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .FirstAsync(s => s.Id == sessionId);
+
+        return new RandomSessionDto(session.Id, session.Course.Title, session.Course.Trainer.FullName,
+            session.Hall.Name, session.StartsAt,
+            session.Enrollments
+                .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                .Select(e => e.Member.FullName)
+                .ToList());
+    }
 }
