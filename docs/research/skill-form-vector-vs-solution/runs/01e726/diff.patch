+    public async Task FreezeMemberAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Число дней должно быть положительным");
+
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenFrom = DateTime.UtcNow;
+        member.FrozenUntil = member.FrozenFrom.Value.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeMemberAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenFrom = null;
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<QualityCheckDto?> GetRandomSessionForQualityCheckAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        var sessionIds = await _db.Sessions
+            .Where(s => s.StartsAt >= now && s.StartsAt <= until)
+            .Select(s => s.Id)
+            .ToListAsync();
+
+        if (sessionIds.Count == 0)
+            return null;
+
+        var chosenId = sessionIds[Random.Shared.Next(sessionIds.Count)];
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments.Where(e => e.Status != EnrollmentStatus.Cancelled))
+                .ThenInclude(e => e.Member)
+            .FirstAsync(s => s.Id == chosenId);
+
+        return new QualityCheckDto(
+            session.Id,
+            session.Course.Title,
+            session.Course.Trainer.FullName,
+            session.Hall.Name,
+            session.StartsAt,
+            session.Enrollments
+                .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                .Select(e => e.Member.FullName)
+                .ToList());
+    }
 }
