+    // Инженер присылает план целиком: план дома становится ровно таким. Работы сопоставляются
+    // по WorkCode - оставшиеся обновляются на месте (Id и история выполнения сохраняются),
+    // новые добавляются, отсутствующие в присланном списке удаляются вместе со своими отметками.
+    public async Task ReplacePlanAsync(int houseId, IReadOnlyList<PlanItemInput> items)
+    {
+        var incoming = ValidatePlan(items);
+
+        if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+            throw new KeyNotFoundException($"Дом {houseId} не найден");
+
+        await using var tx = await _db.Database.BeginTransactionAsync();
+
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId);
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var removed = plan.Items.Where(i => !incoming.ContainsKey(i.WorkCode)).ToList();
+        if (removed.Count > 0)
+        {
+            var removedIds = removed.Select(i => i.Id).ToList();
+            await _db.PlanItemCompletions
+                .Where(c => removedIds.Contains(c.PlanItemId))
+                .ExecuteDeleteAsync();
+            // Явный Remove: DeleteOrphansTiming = Never, простое удаление из plan.Items
+            // строку не удалит, а упадёт на SaveChanges (обязательный FK).
+            _db.PlanItems.RemoveRange(removed);
+        }
+
+        foreach (var input in incoming.Values)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == input.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = input.Title;
+                existing.PeriodDays = input.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+        await tx.CommitAsync();
+    }
+
+    private static Dictionary<string, PlanItemInput> ValidatePlan(IReadOnlyList<PlanItemInput>? items)
+    {
+        if (items is null)
+            throw new ArgumentException("Не передан список работ");
+
+        var result = new Dictionary<string, PlanItemInput>(StringComparer.Ordinal);
+        foreach (var raw in items)
+        {
+            var code = raw.WorkCode?.Trim() ?? "";
+            var title = raw.Title?.Trim() ?? "";
+            if (code.Length == 0)
+                throw new ArgumentException("У работы не указан код");
+            if (title.Length == 0)
+                throw new ArgumentException($"У работы {code} не указано название");
+            if (raw.PeriodDays <= 0)
+                throw new ArgumentException($"У работы {code} периодичность должна быть больше нуля");
+            if (!result.TryAdd(code, new PlanItemInput(code, title, raw.PeriodDays)))
+                throw new ArgumentException($"Работа {code} указана в плане дважды");
+        }
+        return result;
+    }
