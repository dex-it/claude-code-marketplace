+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+public static class Endpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Реестр заявок диспетчера: ?sort=date|address|status&dir=asc|desc, остальные фильтры как раньше.
+        app.MapGet("/requests", async (HousingService svc, string? text, RequestStatus? status,
+            int? houseId, string? district, string? sort, string? dir, int page = 1, int pageSize = 50) =>
+        {
+            if (!TryParseSort(sort, out var sortBy))
+                return Results.BadRequest($"Недопустимое значение sort: {sort}");
+
+            if (!TryParseDir(dir, out var sortDir))
+                return Results.BadRequest($"Недопустимое значение dir: {dir}");
+
+            var result = await svc.SearchAsync(new RequestSearch(text, status, houseId, district,
+                sortBy, sortDir, page, pageSize));
+            return Results.Ok(result);
+        });
+
+        app.MapGet("/requests/{id:int}", async (HousingService svc, int id) =>
+        {
+            var card = await svc.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        // Мастер закрывает заявку: только из InProgress, с обязательным комментарием.
+        app.MapPost("/requests/{id:int}/close", async (HousingService svc, int id, CloseRequestBody body) =>
+        {
+            if (string.IsNullOrWhiteSpace(body.Comment))
+                return Results.BadRequest("Комментарий о выполненных работах обязателен");
+
+            try
+            {
+                var closed = await svc.CloseRequestAsync(id, body.Comment);
+                return closed ? Results.NoContent() : Results.NotFound();
+            }
+            catch (RequestNotInProgressException ex)
+            {
+                return Results.Conflict(ex.Message);
+            }
+        });
+
+        // Инженер присылает план дома целиком - план дома становится ровно таким.
+        app.MapPut("/houses/{id:int}/plan", async (PlanService svc, int id, List<PlanItemInput> items) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+        });
+
+        return app;
+    }
+
+    private static bool TryParseSort(string? sort, out RequestSortField value)
+    {
+        switch (sort?.Trim().ToLowerInvariant())
+        {
+            case null or "":
+            case "date":
+                value = RequestSortField.Date;
+                return true;
+            case "address":
+                value = RequestSortField.Address;
+                return true;
+            case "status":
+                value = RequestSortField.Status;
+                return true;
+            default:
+                value = default;
+                return false;
+        }
+    }
+
+    private static bool TryParseDir(string? dir, out SortDirection value)
+    {
+        switch (dir?.Trim().ToLowerInvariant())
+        {
+            case null or "":
+            case "desc":
+                value = SortDirection.Desc;
+                return true;
+            case "asc":
+                value = SortDirection.Asc;
+                return true;
+            default:
+                value = default;
+                return false;
+        }
+    }
+}
