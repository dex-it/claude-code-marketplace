+    // Инженер присылает план целиком: он становится точной копией присланного списка.
+    // Работы, которые остаются в плане (совпадает work_code), не пересоздаются - сохраняют Id и историю
+    // выполнения; работы, которых нет среди присланных, удаляются вместе со своей историей (cascade по FK);
+    // новые work_code добавляются как новые PlanItem.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var incomingCodes = items.Select(i => i.WorkCode).ToHashSet();
+
+        // Явное удаление (а не просто Items.Remove), т.к. DeleteOrphansTiming=Never в контексте
+        // рассчитан на перенос работ между планами (MergePlansAsync) и не удалит "осиротевшую" работу сам.
+        foreach (var removed in plan.Items.Where(i => !incomingCodes.Contains(i.WorkCode)).ToList())
+            _db.PlanItems.Remove(removed);
+
+        foreach (var input in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == input.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = input.Title;
+                existing.PeriodDays = input.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
