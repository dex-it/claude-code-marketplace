+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+
+namespace Domovoy.Housing;
+
+public static class Endpoints
+{
+    public static void MapHousingEndpoints(this WebApplication app)
+    {
+        var group = app.MapGroup("/requests").WithTags("Requests");
+
+        group.MapPost("/{id}/close", CloseRequest)
+            .WithName("CloseRequest")
+            .WithOpenApi();
+
+        var planGroup = app.MapGroup("/houses").WithTags("Houses");
+
+        planGroup.MapPut("/{id}/plan", UpdateHousePlan)
+            .WithName("UpdateHousePlan")
+            .WithOpenApi();
+    }
+
+    private static async Task<IResult> CloseRequest(int id, CloseRequestDto dto, HousingService service)
+    {
+        try
+        {
+            await service.CloseRequestAsync(id, dto.Comment);
+            return Results.NoContent();
+        }
+        catch (ArgumentException ex)
+        {
+            return Results.BadRequest(new { message = ex.Message });
+        }
+        catch (KeyNotFoundException)
+        {
+            return Results.NotFound();
+        }
+        catch (InvalidOperationException)
+        {
+            return Results.Conflict();
+        }
+    }
+
+    private static async Task<IResult> UpdateHousePlan(int id, UpdateHousePlanDto dto, PlanService service)
+    {
+        try
+        {
+            await service.UpdatePlanAsync(id, dto.Items.Select(i => (i.WorkCode, i.Title, i.PeriodDays)).ToList());
+            return Results.NoContent();
+        }
+        catch (KeyNotFoundException)
+        {
+            return Results.NotFound();
+        }
+    }
+}
+
+public record CloseRequestDto(string Comment);
+
+public record UpdateHousePlanDto(List<PlanItemInput> Items);
+
+public record PlanItemInput(string WorkCode, string Title, int PeriodDays);
