+    public async Task UpdatePlanAsync(int houseId, List<(string WorkCode, string Title, int PeriodDays)> newItems)
+    {
+        var plan = await _db.MaintenancePlans.Include(p => p.Items).ThenInclude(i => i.Completions)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId)
+            ?? throw new KeyNotFoundException($"План дома {houseId} не найден");
+
+        var newCodes = newItems.Select(i => i.WorkCode).ToHashSet();
+        var existingCodes = plan.Items.Select(i => i.WorkCode).ToHashSet();
+
+        // Удаляем работы, которых нет в новом плане
+        foreach (var item in plan.Items.Where(i => !newCodes.Contains(i.WorkCode)).ToList())
+        {
+            plan.Items.Remove(item);
+            _db.PlanItems.Remove(item);
+        }
+
+        // Обновляем или добавляем работы
+        foreach (var newItem in newItems)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == newItem.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = newItem.Title;
+                existing.PeriodDays = newItem.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
 }
