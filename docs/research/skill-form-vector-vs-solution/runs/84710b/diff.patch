+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesReportRow(int InstructorId, string InstructorFullName, int GraduatesCount);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Отчёт для продления лицензии: выпускники по году выпуска и инструктору,
+    // включая уже уволенных инструкторов.
+    public async Task<List<GraduatesReportRow>> GetGraduatesByInstructorAsync(int year)
+    {
+        var counts = await _db.Students.AsNoTracking()
+            .Where(s => s.Status == StudentStatus.Graduated
+                     && s.InstructorId != null
+                     && s.GraduatedOn != null
+                     && s.GraduatedOn!.Value.Year == year)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var instructorIds = counts.Select(c => c.InstructorId).ToList();
+        var names = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .ToDictionaryAsync(i => i.Id, i => i.FullName);
+
+        return counts
+            .Select(c => new GraduatesReportRow(c.InstructorId, names.GetValueOrDefault(c.InstructorId, "—"), c.Count))
+            .OrderByDescending(r => r.GraduatesCount)
+            .ToList();
+    }
+}
