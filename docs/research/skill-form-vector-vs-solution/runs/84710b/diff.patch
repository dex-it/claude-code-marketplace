diff --git a/StudentAppService.cs b/StudentAppService.cs
new file mode 100644
index 0000000..c40e8de
--- /dev/null
+++ b/StudentAppService.cs
@@ -0,0 +1,87 @@
+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResult(int StudentId, string FullName);
+public record ProgressDto(int StudentId, double HoursDone, double HoursRequired);
+
+// Мобильное приложение ученика: вход по коду и прогресс обучения.
+public class StudentAppService
+{
+    private const int CodeLifetimeMinutes = 10;
+    private const int RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public StudentAppService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestLoginCodeAsync(string email)
+    {
+        var normalized = email.Trim();
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalized.ToLower());
+
+        // Не сообщаем, найден ли e-mail в базе: иначе эндпоинт можно использовать для перебора учеников.
+        if (student is null) return;
+
+        await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && c.ConsumedAtUtc == null)
+            .ExecuteDeleteAsync();
+
+        var now = DateTime.UtcNow;
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            CreatedAtUtc = now,
+            ExpiresAtUtc = now.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа",
+            $"Ваш код для входа: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<LoginResult?> ConfirmLoginCodeAsync(string email, string code)
+    {
+        var normalizedEmail = email.Trim();
+        var normalizedCode = code.Trim();
+
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail.ToLower());
+        if (student is null) return null;
+
+        var now = DateTime.UtcNow;
+        var login = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id
+                     && c.Code == normalizedCode
+                     && c.ConsumedAtUtc == null
+                     && c.ExpiresAtUtc > now)
+            .OrderByDescending(c => c.CreatedAtUtc)
+            .FirstOrDefaultAsync();
+        if (login is null) return null;
+
+        login.ConsumedAtUtc = now;
+        return new LoginResult(student.Id, student.FullName);
+    }
+
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AsNoTracking().AnyAsync(s => s.Id == studentId);
+        if (!exists) return null;
+
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(studentId, Math.Round(minutesDone / 60.0, 2), RequiredHours);
+    }
+}
