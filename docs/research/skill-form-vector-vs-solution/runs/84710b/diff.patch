+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(
+    int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAtUtc);
+
+// Мобильное приложение инструктора: список закреплённых учеников.
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorStudentDto>?> GetMyStudentsAsync(int instructorId)
+    {
+        var isActiveInstructor = await _db.Instructors.AsNoTracking().AnyAsync(i => i.Id == instructorId);
+        if (!isActiveInstructor) return null;
+
+        var now = DateTime.UtcNow;
+        var rows = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .Select(s => new
+            {
+                s.Id,
+                s.FullName,
+                s.Phone,
+                s.Email,
+                s.PassportNo,
+                NextLessonAtUtc = _db.Lessons
+                    .Where(l => l.StudentId == s.Id && !l.Done && l.StartsAt >= now)
+                    .OrderBy(l => l.StartsAt)
+                    .Select(l => (DateTime?)l.StartsAt)
+                    .FirstOrDefault(),
+            })
+            .ToListAsync();
+
+        return rows
+            .Select(r => new InstructorStudentDto(
+                r.Id, r.FullName, r.Phone,
+                Student.MaskEmail(r.Email), Student.MaskPassport(r.PassportNo),
+                r.NextLessonAtUtc))
+            .ToList();
+    }
+}
