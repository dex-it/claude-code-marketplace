+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearMonthReport(int Year, int Month, bool IsClosed, DateOnly? ActSignedOn, decimal TotalHours);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<YearMonthReport>> GetYearReportAsync(int year)
+    {
+        var reports = new List<YearMonthReport>();
+
+        for (int month = 1; month <= 12; month++)
+        {
+            var ym = new YearMonth(year, month);
+            var closed = await _db.ClosedPeriods
+                .FirstOrDefaultAsync(p => p.Month == ym);
+
+            var from = new DateOnly(year, month, 1);
+            var to = from.AddMonths(1);
+            var totalHours = await _db.TimeEntries
+                .Where(t => t.WorkDate >= from && t.WorkDate < to)
+                .SumAsync(t => t.Hours);
+
+            reports.Add(new YearMonthReport(
+                year, month,
+                closed != null,
+                closed?.ActSignedOn,
+                totalHours
+            ));
+        }
+
+        return reports;
+    }
+}
