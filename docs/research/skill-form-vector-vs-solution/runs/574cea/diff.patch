+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public class ClientService
+{
+    private readonly AgencyDbContext _db;
+
+    public ClientService(AgencyDbContext db) => _db = db;
+
+    /// <summary>Мягко удаляет все проекты клиента одним запросом. Возвращает null, если клиента нет.</summary>
+    public async Task<int?> DeleteAllProjectsAsync(int clientId)
+    {
+        if (!await _db.Clients.AnyAsync(c => c.Id == clientId))
+            return null;
+
+        return await _db.Projects
+            .Where(p => p.ClientId == clientId)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(p => p.IsDeleted, true)
+                .SetProperty(p => p.DeletedAt, DateTime.UtcNow));
+    }
+}
