+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Pixelwork.Timesheets;
+
+public static class ClientEndpoints
+{
+    public static IEndpointRouteBuilder MapClientEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapDelete("/clients/{id:int}/projects", async (int id, ClientService svc) =>
+        {
+            var deleted = await svc.DeleteAllProjectsAsync(id);
+            return deleted is null ? Results.NotFound() : Results.Ok(new { deleted });
+        });
+
+        return app;
+    }
+}
