+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthSummary(int Month, bool IsClosed, DateOnly? ActSignedOn, decimal TotalHours);
+
+public record YearSummary(int Year, List<MonthSummary> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearSummary> YearSummaryAsync(int year)
+    {
+        // Таблица закрытых периодов маленькая (строка на месяц на всю компанию),
+        // фильтруем по году в памяти - сравнение по YearMonth в SQL не транслируется.
+        var closedByMonth = (await _db.ClosedPeriods.ToListAsync())
+            .Where(p => p.Month.Year == year)
+            .ToDictionary(p => p.Month.Month);
+
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+        var hoursByMonth = await _db.TimeEntries
+            .Where(t => t.WorkDate >= from && t.WorkDate < to)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Total = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(g => g.Month, g => g.Total);
+
+        var months = Enumerable.Range(1, 12)
+            .Select(m =>
+            {
+                closedByMonth.TryGetValue(m, out var closedPeriod);
+                hoursByMonth.TryGetValue(m, out var hours);
+                return new MonthSummary(m, closedPeriod is not null, closedPeriod?.ActSignedOn, hours);
+            })
+            .ToList();
+
+        return new YearSummary(year, months);
+    }
+}
