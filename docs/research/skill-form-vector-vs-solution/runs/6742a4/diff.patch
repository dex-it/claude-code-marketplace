+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearMonthReport(int Month, decimal TotalHours, DateOnly? ActSignedOn);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<YearMonthReport>> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .Where(p => p.Month.Year == year)
+            .AsNoTracking()
+            .ToDictionaryAsync(p => p.Month, p => p.ActSignedOn);
+
+        var hoursByMonth = await _db.TimeEntries
+            .Where(t => t.WorkDate.Year == year)
+            .AsNoTracking()
+            .GroupBy(t => YearMonth.Of(t.WorkDate))
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(x => x.Month, x => x.Hours);
+
+        var result = new List<YearMonthReport>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var ym = new YearMonth(year, month);
+            var hours = hoursByMonth.TryGetValue(ym, out var h) ? h : 0;
+            var actSignedOn = closedPeriods.TryGetValue(ym, out var date) ? date : null;
+            result.Add(new YearMonthReport(month, hours, actSignedOn));
+        }
+
+        return result;
+    }
+}
