+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginResultDto(int StudentId, string FullName);
+
+// Вход в мобильное приложение ученика по одноразовому коду, присланному на e-mail.
+public class AppAuthService
+{
+    private const int CodeExpiryMinutes = 10;
+    private const int MaxAttempts = 5;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _emailSender;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender emailSender)
+    {
+        _db = db;
+        _emailSender = emailSender;
+    }
+
+    public async Task RequestCodeAsync(string rawEmail)
+    {
+        var email = Normalize(rawEmail);
+        var student = await FindByNormalizedEmailAsync(email);
+        if (student is null)
+            return; // не раскрываем, зарегистрирован ли такой e-mail
+
+        var code = GenerateCode();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeExpiryMinutes),
+        });
+
+        await _emailSender.SendAsync(student.Email, "Код для входа в AutoSchool.Cloud",
+            $"Ваш код: {code}. Он действует {CodeExpiryMinutes} минут.");
+    }
+
+    public async Task<LoginResultDto?> ConfirmCodeAsync(string rawEmail, string code)
+    {
+        var email = Normalize(rawEmail);
+        var student = await FindByNormalizedEmailAsync(email);
+        if (student is null)
+            return null;
+
+        var entry = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > DateTime.UtcNow)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+
+        if (entry is null || entry.Attempts >= MaxAttempts)
+            return null;
+
+        entry.Attempts++;
+        if (entry.CodeHash != Hash(code.Trim()))
+            return null;
+
+        entry.Used = true;
+        return new LoginResultDto(student.Id, student.FullName);
+    }
+
+    private Task<Student?> FindByNormalizedEmailAsync(string normalizedEmail) =>
+        _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail);
+
+    private static string Normalize(string email) => email.Trim().ToLowerInvariant();
+
+    private static string GenerateCode() => RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+
+    private static string Hash(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
