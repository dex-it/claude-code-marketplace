+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(
+    int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+// Данные для мобильного приложения инструктора.
+public class InstructorService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorService(SchoolDbContext db) => _db = db;
+
+    // Закреплённые ученики, которые сейчас учатся: вид как в выгрузке для инструкторов
+    // (паспорт и почта скрыты), плюс дата и время ближайшего занятия вождения.
+    public async Task<List<InstructorStudentDto>> GetCurrentStudentsAsync(int instructorId)
+    {
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var now = DateTime.UtcNow;
+        var nextLessons = await _db.Lessons.AsNoTracking()
+            .Where(l => l.InstructorId == instructorId && !l.Done && l.StartsAt > now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextAt = g.Min(l => l.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.NextAt);
+
+        return students
+            .Select(s => s.MaskForInstructor())
+            .Select(s => new InstructorStudentDto(
+                s.Id, s.FullName, s.Phone, s.Email, s.PassportNo,
+                nextLessons.TryGetValue(s.Id, out var at) ? at : null))
+            .ToList();
+    }
+}
