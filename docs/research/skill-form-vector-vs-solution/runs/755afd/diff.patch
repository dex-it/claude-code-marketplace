@@ -0,0 +1,24 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record ProgressDto(double HoursDone, int HoursRequired);
+
+// Прогресс ученика по часам вождения для мобильного приложения.
+public class ProgressService
+{
+    private const int RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+
+    public ProgressService(SchoolDbContext db) => _db = db;
+
+    public async Task<ProgressDto> GetProgressAsync(int studentId)
+    {
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(Math.Round(minutesDone / 60.0, 2), RequiredHours);
+    }
+}
