+namespace Notify.Api.Services;
+
+public sealed class SmsSender : INotificationSender
+{
+    private readonly ILogger<SmsSender> _log;
+    public SmsSender(ILogger<SmsSender> log) => _log = log;
+
+    public Task SendAsync(string recipient, string text, CancellationToken ct = default)
+    {
+        _log.LogInformation("sms to {Recipient}", recipient);
+        return Task.CompletedTask;
+    }
+}
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..f33b252
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,14 @@
+**Созданы:**
+- `Services/SmsSender.cs` — `SmsSender : INotificationSender`, пока только пишет в лог
+- `Services/NotificationChannels.cs` — константы ключей `"email"` / `"sms"`
+- `Controllers/ReportsController.cs` — `POST /reports/{id}/send?email=...`
+
+**Изменены:**
+- `Program.cs` — вместо одной обычной регистрации два keyed-singleton: `AddKeyedSingleton<INotificationSender, ...>(key)`
+- `Services/OrderService.cs` — получает `[FromKeyedServices(NotificationChannels.Sms)] INotificationSender`
+- `Controllers/OrdersController.cs` — query-параметр `email` → `phone`
+
+**Решения:**
+- Оба отправителя зарегистрированы только по ключам, обычной регистрации `INotificationSender` больше нет. Так никто не получит канал случайно, каждый потребитель явно выбирает свой через `[FromKeyedServices]`. Ключи вынесены в константы, чтобы не было опечаток в строках.
+- **Ломающее изменение API:** SMS нельзя отправить на email, поэтому `POST /orders/{id}/confirm` теперь принимает `?phone=` вместо `?email=`. Клиентов нужно предупредить. Если нужна обратная совместимость, можно временно принимать оба параметра.
+- `id` отчёта принимается как `Guid` (`{id:guid}`), так же как у заказов. Реального отчёта в проекте нет, поэтому в письме пока текст-заглушка «Отчёт {id}». Сборку и тесты я не запускал.
