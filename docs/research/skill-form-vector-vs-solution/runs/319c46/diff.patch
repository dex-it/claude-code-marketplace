+    public async Task FreezeAsync(int memberId, int days)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException();
+        member.FrozenUntil = DateTime.UtcNow.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException();
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    public record RandomSessionDto(string Course, string Trainer, string Hall, DateTime StartsAt,
+        IReadOnlyList<string> EnrolledMembers);
+
+    public async Task<RandomSessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var week = now.AddDays(7);
+
+        var sessions = await _db.Sessions
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .Where(s => s.Course.Status == CourseStatus.Published
+                && s.StartsAt > now
+                && s.StartsAt <= week)
+            .ToListAsync();
+
+        if (sessions.Count == 0)
+            return null;
+
+        var random = new Random();
+        var session = sessions[random.Next(sessions.Count)];
+
+        var members = session.Enrollments
+            .Where(e => e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToList();
+
+        return new RandomSessionDto(session.Course.Title, session.Course.Trainer.FullName,
+            session.Hall.Name, session.StartsAt, members);
+    }
 }
