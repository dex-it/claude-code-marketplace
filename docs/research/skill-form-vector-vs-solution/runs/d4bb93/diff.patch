+
+    public async Task UpdatePlanAsync(int houseId, List<PlanItemDto> newPlan)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId)
+            ?? throw new KeyNotFoundException($"План для дома {houseId} не найден");
+
+        var newCodes = new HashSet<string>(newPlan.Select(p => p.WorkCode));
+        var existingCodes = new Dictionary<string, PlanItem>(plan.Items.ToDictionary(i => i.WorkCode));
+
+        foreach (var item in plan.Items.ToList())
+        {
+            if (!newCodes.Contains(item.WorkCode))
+                _db.PlanItems.Remove(item);
+        }
+
+        foreach (var newItem in newPlan)
+        {
+            if (existingCodes.TryGetValue(newItem.WorkCode, out var existing))
+            {
+                existing.Title = newItem.Title;
+                existing.PeriodDays = newItem.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
 }
