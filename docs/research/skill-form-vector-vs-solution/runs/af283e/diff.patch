+    public async Task FreezeMemberAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Число дней заморозки должно быть положительным");
+
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenUntil = DateTime.UtcNow.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeMemberAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    // «Тайный гость»: случайное занятие из ближайших 7 дней.
+    public async Task<RandomSessionDto?> GetRandomSessionForQualityCheckAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        var candidateIds = await _db.Sessions
+            .Where(s => s.StartsAt >= now && s.StartsAt <= until)
+            .Select(s => s.Id)
+            .ToListAsync();
+
+        if (candidateIds.Count == 0)
+            return null;
+
+        var pickedId = candidateIds[Random.Shared.Next(candidateIds.Count)];
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments.Where(e => e.Status != EnrollmentStatus.Cancelled))
+                .ThenInclude(e => e.Member)
+            .FirstAsync(s => s.Id == pickedId);
+
+        return new RandomSessionDto(
+            session.Id,
+            session.Course.Title,
+            session.Course.Trainer.FullName,
+            session.Hall.Name,
+            session.StartsAt,
+            session.Enrollments
+                .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                .Select(e => e.Member.FullName)
+                .ToList());
+    }
 }
