+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    private const string Subject = "Сообщение от магазина";
+
+    // Список из маркетинговой системы может быть большим - читаем клиентов пачками,
+    // чтобы не держать в памяти всё сразу и не держать открытым DataReader во время отправки.
+    private const int BatchSize = 5_000;
+
+    private readonly ShopDbContext _db;
+    private readonly IEmailSender _email;
+
+    public CustomerNotifier(ShopDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Возвращает число отправленных писем. Id, которых нет в базе, пропускаются.
+    public async Task<int> NotifyCustomers(IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        ArgumentNullException.ThrowIfNull(customerIds);
+        ArgumentException.ThrowIfNullOrWhiteSpace(text);
+
+        // Один обход входной последовательности + удаление дублей: клиент получит одно письмо.
+        var ids = customerIds.Distinct().ToArray();
+        var sent = 0;
+
+        foreach (var batch in ids.Chunk(BatchSize))
+        {
+            // EF Core 8 + Npgsql передаёт массив одним параметром (= ANY(@ids)), один запрос на пачку.
+            var recipients = await _db.Customers
+                .Where(c => batch.Contains(c.Id))
+                .Select(c => new { c.Id, c.Email })
+                .ToListAsync(ct);
+
+            foreach (var r in recipients)
+            {
+                if (string.IsNullOrWhiteSpace(r.Email)) continue;
+
+                await _email.SendAsync(r.Email, Subject, text, ct);
+                sent++;
+            }
+        }
+
+        return sent;
+    }
+}
