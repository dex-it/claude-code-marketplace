diff --git a/StudentAppService.cs b/StudentAppService.cs
new file mode 100644
index 0000000..6c7ab01
--- /dev/null
+++ b/StudentAppService.cs
@@ -0,0 +1,85 @@
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginResultDto(int StudentId, string FullName, string Email);
+public record ProgressDto(int StudentId, double HoursDone, int HoursRequired);
+
+public class StudentAppService
+{
+    private const int RequiredHours = 56;
+    private static readonly TimeSpan CodeLifetime = TimeSpan.FromMinutes(10);
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _emailSender;
+
+    public StudentAppService(SchoolDbContext db, IEmailSender emailSender)
+    {
+        _db = db;
+        _emailSender = emailSender;
+    }
+
+    // Ученик может ввести e-mail в любом регистре - ищем без учёта регистра.
+    public async Task RequestLoginAsync(string email)
+    {
+        var typed = email.Trim();
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => EF.Functions.ILike(s.Email, typed));
+
+        if (student is null)
+            return; // не подтверждаем и не опровергаем наличие e-mail в базе
+
+        var code = GenerateCode();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            ExpiresAt = DateTime.UtcNow.Add(CodeLifetime),
+        });
+
+        await _emailSender.SendAsync(student.Email, "Код для входа в AutoSchool.Cloud", $"Ваш код: {code}");
+    }
+
+    public async Task<LoginResultDto?> ConfirmLoginAsync(string email, string code)
+    {
+        var typed = email.Trim();
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => EF.Functions.ILike(s.Email, typed));
+        if (student is null)
+            return null;
+
+        var hash = Hash(code);
+        var now = DateTime.UtcNow;
+        var login = await _db.LoginCodes
+            .Where(l => l.StudentId == student.Id && !l.Used && l.ExpiresAt > now && l.CodeHash == hash)
+            .OrderByDescending(l => l.Id)
+            .FirstOrDefaultAsync();
+        if (login is null)
+            return null;
+
+        login.Used = true;
+        return new LoginResultDto(student.Id, student.FullName, student.Email);
+    }
+
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AsNoTracking().AnyAsync(s => s.Id == studentId);
+        if (!exists)
+            return null;
+
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(studentId, Math.Round(minutesDone / 60.0, 2), RequiredHours);
+    }
+
+    private static string GenerateCode() => RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+
+    private static string Hash(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..0442b4a
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,15 @@
+## Изменённые файлы
+- `Models.cs` — добавлена сущность `LoginCode` (хеш кода, срок действия, флаг использования).
+- `SchoolDbContext.cs` — `DbSet<LoginCode>`, маппинг (индекс StudentId+ExpiresAt, каскад на Student).
+- `QueryFilters.cs` — глобальный фильтр по SchoolId для `LoginCode`.
+- `Program.cs` — регистрация новых сервисов и endpoints: `POST /api/app/login/request`, `POST /api/app/login/confirm`, `GET /api/app/progress`, `GET /api/instructor/students`, `GET /api/reports/graduates`.
+
+## Новые файлы
+- `StudentAppService.cs` — вход по одноразовому коду (поиск e-mail через `EF.Functions.ILike`, без учёта регистра; код хранится как SHA-256-хеш, живёт 10 минут; ответ на `request` не раскрывает, есть ли такой e-mail) и прогресс по часам вождения (`SumAsync(Minutes)` по занятиям с `Done`, из 56 часов).
+- `InstructorAppService.cs` — список учеников инструктора (`Status == Learning`), замаскированных тем же методом `MaskForInstructor()`, что и в CSV-выгрузке, плюс ближайшее незавершённое занятие одним сгруппированным запросом (без N+1).
+- `ReportsService.cs` — отчёт о выпускниках по годам: подсчёт в БД через `GroupBy` на `Students`, затем список инструкторов получен через `IgnoreQueryFilters()` (чтобы не терять уволенных) с явным восстановлением `SchoolId == db.SchoolId`, иначе отчёт утёк бы между автошколами.
+
+## Решения
+- Код входа сравнивается по хешу в самом SQL-запросе (`CodeHash == hash`), а не вычислением на клиенте после загрузки всех кодов — остаётся одним транслируемым условием.
+- Для (б) `IgnoreQueryFilters()` снимает сразу оба условия комбинированного фильтра Instructor (SchoolId и IsDeleted), поэтому SchoolId возвращён вручную — иначе отчёт показывал бы инструкторов всех автошкол.
+- Для (в) в проекцию в `Student` берутся только нужные для маски и ответа колонки (Id/FullName/Phone/Email/PassportNo), запрос — `AsNoTracking`; ближайшее занятие на всех учеников получено одним `GROUP BY` по `StudentId`, не в цикле.
