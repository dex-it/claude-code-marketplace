+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduateReportItem(int InstructorId, string InstructorName, bool Dismissed, int Graduates);
+
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Для продления лицензии нужны и уволенные инструкторы - обходим фильтр, но сохраняем изоляцию по автошколе вручную.
+    public async Task<List<GraduateReportItem>> GetGraduatesByInstructorAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = new DateOnly(year, 12, 31);
+
+        var graduatesByInstructor = await _db.Students.AsNoTracking()
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.InstructorId != null
+                        && s.GraduatedOn >= from && s.GraduatedOn <= to)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Graduates = g.Count() })
+            .ToDictionaryAsync(x => x.InstructorId, x => x.Graduates);
+
+        var instructors = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == _db.SchoolId)
+            .Select(i => new { i.Id, i.FullName, i.IsDeleted })
+            .ToListAsync();
+
+        return instructors
+            .Select(i => new GraduateReportItem(i.Id, i.FullName, i.IsDeleted, graduatesByInstructor.GetValueOrDefault(i.Id)))
+            .OrderByDescending(r => r.Graduates)
+            .ToList();
+    }
+}
