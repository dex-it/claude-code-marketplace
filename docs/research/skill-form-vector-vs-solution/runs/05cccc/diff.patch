+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesByInstructorDto(int InstructorId, string InstructorFullName, bool InstructorDismissed, int GraduatesCount);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Для продления лицензии считаем и уже уволенных инструкторов - выпуск был под их руководством.
+    public async Task<List<GraduatesByInstructorDto>> GetGraduatesByInstructorAsync(int year)
+    {
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn != null
+                        && s.GraduatedOn.Value.Year == year
+                        && s.InstructorId != null)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        if (counts.Count == 0) return [];
+
+        var instructorIds = counts.Select(c => c.InstructorId).ToList();
+
+        var instructors = await _db.Instructors
+            .IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .ToDictionaryAsync(i => i.Id);
+
+        return counts
+            .Select(c => instructors.TryGetValue(c.InstructorId, out var instr)
+                ? new GraduatesByInstructorDto(instr.Id, instr.FullName, instr.IsDeleted, c.Count)
+                : new GraduatesByInstructorDto(c.InstructorId, "(инструктор не найден)", true, c.Count))
+            .OrderByDescending(x => x.GraduatesCount)
+            .ToList();
+    }
+}
