+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginResultDto(int StudentId, string FullName);
+public record ProgressDto(int StudentId, double HoursDone, double HoursRequired, double HoursRemaining);
+
+// Вход и личный прогресс ученика в мобильном приложении.
+public class AppService
+{
+    private const int CodeTtlMinutes = 10;
+    private const double RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestLoginCodeAsync(string email)
+    {
+        var student = await FindByEmailAsync(email);
+        if (student is null) return; // не раскрываем, зарегистрирован ли такой e-mail
+
+        var activeCodes = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used)
+            .ToListAsync();
+        foreach (var old in activeCodes) old.Used = true;
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeTtlMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа в приложение",
+            $"Ваш код: {code}. Он действует {CodeTtlMinutes} минут.");
+    }
+
+    public async Task<LoginResultDto?> ConfirmLoginAsync(string email, string code)
+    {
+        var student = await FindByEmailAsync(email);
+        if (student is null) return null;
+
+        var now = DateTime.UtcNow;
+        var entry = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt >= now)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+
+        var typedCode = code.Trim();
+        if (entry is null || !CryptographicOperations.FixedTimeEquals(
+                Encoding.UTF8.GetBytes(entry.Code), Encoding.UTF8.GetBytes(typedCode)))
+            return null;
+
+        entry.Used = true;
+        return new LoginResultDto(student.Id, student.FullName);
+    }
+
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AnyAsync(s => s.Id == studentId);
+        if (!exists) return null;
+
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => (int?)l.Minutes) ?? 0;
+
+        var hoursDone = Math.Round(minutesDone / 60.0, 2);
+        return new ProgressDto(studentId, hoursDone, RequiredHours, Math.Max(0, Math.Round(RequiredHours - hoursDone, 2)));
+    }
+
+    // Почта вводится как придётся (регистр клавиатуры телефона) - сравниваем без учёта регистра.
+    private Task<Student?> FindByEmailAsync(string email)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        return _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == normalized);
+    }
+}
