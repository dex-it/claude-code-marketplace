+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+public class InstructorService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorService(SchoolDbContext db) => _db = db;
+
+    // Список учеников инструктора в приложении: тот же вид карточки, что и в CSV-выгрузке (StudentService),
+    // плюс дата и время ближайшего незавершённого занятия.
+    public async Task<List<InstructorStudentDto>?> GetAssignedStudentsAsync(int instructorId)
+    {
+        var instructorExists = await _db.Instructors.AnyAsync(i => i.Id == instructorId);
+        if (!instructorExists) return null;
+
+        var students = await _db.Students
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var studentIds = students.Select(s => s.Id).ToList();
+        var now = DateTime.UtcNow;
+        var nextLessons = await _db.Lessons
+            .Where(l => studentIds.Contains(l.StudentId) && !l.Done && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextAt = g.Min(l => l.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.NextAt);
+
+        return students
+            .Select(s => s.MaskForInstructor())
+            .Select(s => new InstructorStudentDto(
+                s.Id, s.FullName, s.Phone, s.Email, s.PassportNo,
+                nextLessons.TryGetValue(s.Id, out var at) ? at : null))
+            .ToList();
+    }
+}
