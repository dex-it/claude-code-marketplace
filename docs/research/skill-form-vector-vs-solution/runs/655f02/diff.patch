+    // Инженер присылает план дома целиком: он заменяет текущий план. Для работ, которые
+    // остаются в плане (совпадение по WorkCode), запись PlanItem не пересоздаётся - история
+    // выполнения (Completions) сохраняется. Работы, которых нет в присланном списке, удаляются
+    // вместе со своей историей.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var codes = new HashSet<string>();
+        foreach (var item in items)
+        {
+            if (string.IsNullOrWhiteSpace(item.WorkCode))
+                throw new ArgumentException("Код работы обязателен");
+            if (item.PeriodDays <= 0)
+                throw new ArgumentException($"Периодичность работы {item.WorkCode} должна быть положительной");
+            if (!codes.Add(item.WorkCode))
+                throw new ArgumentException($"Код работы {item.WorkCode} повторяется в присланном плане");
+        }
+
+        if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+            throw new KeyNotFoundException($"Дом {houseId} не найден");
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var incoming = items.ToDictionary(i => i.WorkCode);
+        var existingByCode = plan.Items.ToDictionary(i => i.WorkCode);
+
+        foreach (var existing in existingByCode.Values.Where(e => !incoming.ContainsKey(e.WorkCode)))
+        {
+            // Явное удаление сущности: разрыв required-связи через Collection.Remove() при
+            // DeleteOrphansTiming = Never не удалит запись сам по себе.
+            _db.PlanItems.Remove(existing);
+        }
+
+        foreach (var item in incoming.Values)
+        {
+            if (existingByCode.TryGetValue(item.WorkCode, out var existing))
+            {
+                existing.Title = item.Title.Trim();
+                existing.PeriodDays = item.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = item.WorkCode,
+                    Title = item.Title.Trim(),
+                    PeriodDays = item.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
+
