+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+public record UpdatePlanItemBody(string WorkCode, string Title, int PeriodDays);
+
+public record UpdatePlanBody(List<UpdatePlanItemBody> Items);
+
+public static class RequestEndpoints
+{
+    public static IEndpointRouteBuilder MapRequestEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService service) =>
+        {
+            try
+            {
+                await service.CloseRequestAsync(id, body.Comment);
+                return Results.NoContent();
+            }
+            catch (RequestNotInProgressException ex)
+            {
+                return Results.Conflict(new { error = ex.Message });
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(new { error = ex.Message });
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+        });
+
+        return app;
+    }
+}
+
+public static class HouseEndpoints
+{
+    public static IEndpointRouteBuilder MapHouseEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPut("/houses/{id:int}/plan", async (int id, UpdatePlanBody body, PlanService service) =>
+        {
+            try
+            {
+                var items = body.Items
+                    .Select(i => new PlanItemInput(i.WorkCode, i.Title, i.PeriodDays))
+                    .ToList();
+                await service.ReplacePlanAsync(id, items);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(new { error = ex.Message });
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+        });
+
+        return app;
+    }
+}
