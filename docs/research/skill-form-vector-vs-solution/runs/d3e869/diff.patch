+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException();
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<QualityCheckDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var from = now;
+        var to = now.AddDays(7);
+
+        var sessions = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments)
+            .Where(s => s.Course.Status == CourseStatus.Published
+                && s.StartsAt >= from
+                && s.StartsAt < to)
+            .ToListAsync();
+
+        if (sessions.Count == 0)
+            return null;
+
+        var random = new Random();
+        var session = sessions[random.Next(sessions.Count)];
+
+        var members = await _db.Enrollments
+            .AsNoTracking()
+            .Include(e => e.Member)
+            .Where(e => e.SessionId == session.Id && e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToListAsync();
+
+        return new QualityCheckDto(
+            session.Course.Title,
+            session.Course.Trainer.FullName,
+            session.Hall.Name,
+            session.StartsAt,
+            members);
+    }
 }
