+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    private const string Subject = "Shop";
+
+    private readonly ShopDbContext _db;
+    private readonly IEmailSender _emailSender;
+
+    public CustomerNotifier(ShopDbContext db, IEmailSender emailSender)
+    {
+        _db = db;
+        _emailSender = emailSender;
+    }
+
+    // Список id приходит из маркетинговой системы: возможны дубли и несуществующие id.
+    public async Task NotifyCustomers(IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        // Один проход по входу и снятие дублей: один клиент - одно письмо.
+        var ids = customerIds.Distinct().ToArray();
+        if (ids.Length == 0) return;
+
+        // Один запрос: в Npgsql Contains -> "Id = ANY(@ids)" одним параметром-массивом.
+        var emails = await _db.Customers
+            .AsNoTracking()
+            .Where(c => ids.Contains(c.Id))
+            .Select(c => c.Email)
+            .ToListAsync(ct);
+
+        foreach (var email in emails)
+            await _emailSender.SendAsync(email, Subject, text, ct);
+    }
+}
