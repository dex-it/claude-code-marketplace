+namespace Shop.Data;
+
+public record ActiveOrderReportItem(Guid Id, string CustomerName, decimal Total, int ItemsCount);
+public record OverdueOrderReportItem(Guid Id, string CustomerName, DateTime CreatedAt, decimal Total);
+
+// Read-only queries backing the orders report page.
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public async Task<List<ActiveOrderReportItem>> GetActiveOrdersAsync()
+    {
+        var orders = await _orders.GetActiveAsync();
+        return orders
+            .Select(o => new ActiveOrderReportItem(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToList();
+    }
+
+    public async Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync()
+    {
+        var orders = await _orders.GetActiveAsync();
+        return orders
+            .GroupBy(o => o.Category)
+            .ToDictionary(g => g.Key, g => g.Count());
+    }
+
+    public async Task<List<OverdueOrderReportItem>> GetOverdueOrdersAsync(DateTime now)
+    {
+        var orders = await _orders.GetOverdueAsync(now);
+        return orders
+            .Where(o => o.IsOverdue(now))
+            .Select(o => new OverdueOrderReportItem(o.Id, o.Customer.Name, o.CreatedAt, o.Total))
+            .ToList();
+    }
+}
