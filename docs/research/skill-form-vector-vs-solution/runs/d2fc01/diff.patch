+    public Task<List<Order>> GetOverdueAsync(DateTime now) =>
+        _db.Orders
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Include(o => o.Customer)
+            .ToListAsync();
