+            e.HasMany(o => o.Items)
+                .WithOne()
+                .HasForeignKey(i => i.OrderId)
+                .IsRequired()
+                .OnDelete(DeleteBehavior.Cascade);
+
+            // Финансовые записи: физическое удаление Order не должно молча утянуть платежи
+            // каскадом в БД - Restrict заставит обработать это явно.
+            e.HasMany(o => o.Payments)
+                .WithOne()
+                .HasForeignKey(p => p.OrderId)
+                .IsRequired()
+                .OnDelete(DeleteBehavior.Restrict);
+        });
