+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public record NotifyResult(int Sent, IReadOnlyList<Guid> NotFound, IReadOnlyList<Guid> Failed);
+
+public class CustomerNotifier
+{
+    private const int BatchSize = 500;
+    private const string Subject = "Сообщение от магазина";
+
+    private readonly ShopDbContext _db;
+    private readonly IEmailSender _email;
+
+    public CustomerNotifier(ShopDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // customerIds приходят из маркетинговой системы: могут быть дубликаты,
+    // неизвестные id и тысячи элементов.
+    public async Task<NotifyResult> NotifyCustomers(
+        IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        ArgumentNullException.ThrowIfNull(customerIds);
+        ArgumentException.ThrowIfNullOrWhiteSpace(text);
+
+        // Один клиент — одно письмо; источник перечисляем один раз.
+        var uniqueIds = customerIds.Distinct().ToList();
+        if (uniqueIds.Count == 0)
+            return new NotifyResult(0, Array.Empty<Guid>(), Array.Empty<Guid>());
+
+        var notFound = new List<Guid>();
+        var failed = new List<Guid>();
+        var sentEmails = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        var sent = 0;
+
+        foreach (var batch in uniqueIds.Chunk(BatchSize))
+        {
+            var recipients = await _db.Customers
+                .AsNoTracking()
+                .Where(c => batch.Contains(c.Id))
+                .Select(c => new { c.Id, c.Email })
+                .ToDictionaryAsync(c => c.Id, c => c.Email, ct);
+
+            foreach (var id in batch)
+            {
+                if (!recipients.TryGetValue(id, out var email) || string.IsNullOrWhiteSpace(email))
+                {
+                    notFound.Add(id);
+                    continue;
+                }
+
+                // Разные клиенты с одним адресом не должны получить письмо дважды.
+                if (!sentEmails.Add(email))
+                    continue;
+
+                try
+                {
+                    await _email.SendAsync(email, Subject, text, ct);
+                    sent++;
+                }
+                catch (Exception) when (!ct.IsCancellationRequested)
+                {
+                    // Сбой одного адреса не прерывает рассылку остальным.
+                    failed.Add(id);
+                }
+            }
+        }
+
+        return new NotifyResult(sent, notFound, failed);
+    }
+}
