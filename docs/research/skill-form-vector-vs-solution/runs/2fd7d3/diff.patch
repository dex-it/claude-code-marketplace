+namespace Notify.Api.Services;
+
+public sealed class ReportsService
+{
+    private readonly IKeyedServiceProvider _provider;
+    public ReportsService(IKeyedServiceProvider provider) => _provider = provider;
+
+    public Task SendReportAsync(Guid reportId, string email, CancellationToken ct = default)
+    {
+        var sender = _provider.GetRequiredKeyedService<INotificationSender>("email");
+        return sender.SendAsync(email, $"Отчёт {reportId}", ct);
+    }
+}
