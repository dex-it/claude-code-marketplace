+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    public async Task<Order?> GetOrderDetailsAsync(Guid orderId)
+    {
+        return await _db.Orders
+            .Where(o => o.Id == orderId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync();
+    }
+
+    public IQueryable<Order> GetCustomerOrdersQuery(Guid customerId)
+    {
+        return _db.Orders
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsNoTracking();
+    }
+
+    public async Task<Product?> GetProductBySkuAsync(string sku, string? warehouse)
+    {
+        if (warehouse != null)
+        {
+            return await _db.Products
+                .Where(p => p.Sku == sku && p.Warehouse == warehouse)
+                .FirstOrDefaultAsync();
+        }
+
+        return await _db.Products
+            .Where(p => p.Sku == sku)
+            .FirstOrDefaultAsync();
+    }
+
+    public async Task<DateTime> GetLastShippedDateAsync(Guid customerId)
+    {
+        var lastShipped = await _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .OrderByDescending(o => o.ShippedAt)
+            .Select(o => o.ShippedAt)
+            .FirstOrDefaultAsync();
+
+        return lastShipped ?? DateTime.MinValue;
+    }
+}
