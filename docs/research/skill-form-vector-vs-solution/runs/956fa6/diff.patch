+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record AppLoginRequest(string Email);
+public record AppLoginConfirmRequest(string Email, string Code);
+public record AppLoginResult(int StudentId, string FullName);
+
+public class AppAuthService
+{
+    private const int CodeLifetimeMinutes = 10;
+    private const int MaxAttempts = 5;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Почта с телефона приходит как придётся по регистру - ищем карточку без учёта регистра.
+    public async Task RequestCodeAsync(string email)
+    {
+        var normalized = email.Trim();
+        var students = await _db.Students
+            .Where(s => EF.Functions.ILike(s.Email, normalized))
+            .ToListAsync();
+
+        // Код шлём только при однозначном совпадении; ответ эндпоинта одинаков в обоих
+        // случаях, чтобы не раскрывать, есть ли такой e-mail в базе.
+        if (students.Count != 1) return;
+        var student = students[0];
+
+        var now = DateTime.UtcNow;
+        var pending = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && c.ConsumedAt == null)
+            .ToListAsync();
+        foreach (var p in pending) p.ConsumedAt = now;
+
+        var code = GenerateCode();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            ExpiresAt = now.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа", $"Ваш код: {code}. Действует 10 минут.");
+    }
+
+    public async Task<AppLoginResult?> ConfirmCodeAsync(string email, string code)
+    {
+        var normalized = email.Trim();
+        var students = await _db.Students
+            .Where(s => EF.Functions.ILike(s.Email, normalized))
+            .ToListAsync();
+
+        if (students.Count != 1) return null;
+        var student = students[0];
+
+        var now = DateTime.UtcNow;
+        var entry = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id
+                     && c.ConsumedAt == null
+                     && c.ExpiresAt > now
+                     && c.Attempts < MaxAttempts)
+            .FirstOrDefaultAsync();
+
+        if (entry is null) return null;
+
+        if (entry.CodeHash != Hash(code.Trim()))
+        {
+            entry.Attempts++;
+            return null;
+        }
+
+        entry.ConsumedAt = now;
+        return new AppLoginResult(student.Id, student.FullName);
+    }
+
+    private static string GenerateCode() => RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+
+    private static string Hash(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
