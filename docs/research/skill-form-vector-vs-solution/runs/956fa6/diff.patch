@@ -0,0 +1,43 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesReportRow(int InstructorId, string InstructorName, bool InstructorDismissed, int Graduates);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Отчёт нужен для продления лицензии - уволенные инструкторы остаются в выдаче.
+    public async Task<List<GraduatesReportRow>> GraduatesByInstructorAsync(int year)
+    {
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                     && s.GraduatedOn != null
+                     && s.GraduatedOn.Value.Year == year
+                     && s.InstructorId != null)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Graduates = g.Count() })
+            .ToListAsync();
+
+        if (counts.Count == 0) return new List<GraduatesReportRow>();
+
+        var instructorIds = counts.Select(c => c.InstructorId).ToList();
+        var schoolId = _db.SchoolId;
+
+        // IgnoreQueryFilters снимает фильтр !IsDeleted у инструкторов, SchoolId возвращаем вручную.
+        var instructors = await _db.Instructors
+            .IgnoreQueryFilters()
+            .Where(i => i.SchoolId == schoolId && instructorIds.Contains(i.Id))
+            .Select(i => new { i.Id, i.FullName, i.IsDeleted })
+            .ToListAsync();
+
+        return counts
+            .Join(instructors, c => c.InstructorId, i => i.Id,
+                (c, i) => new GraduatesReportRow(i.Id, i.FullName, i.IsDeleted, c.Graduates))
+            .OrderByDescending(r => r.Graduates)
+            .ToList();
+    }
+}
