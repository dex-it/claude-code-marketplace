+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Migrations;
+
+#nullable disable
+
+namespace Domovoy.Housing.Migrations;
+
+// Уникальность лицевого счёта.
+// В проде есть дубли лицевых счетов после переноса из старого биллинга (2023), на них ссылаются заявки,
+// поэтому просто создать уникальный индекс нельзя (миграция упадёт), а удалять строки - нельзя тем более.
+// Все записи по счёту, кроме последней (она актуальна - см. FindByAccountAsync), помечаются is_superseded
+// и в уникальный индекс не входят. Пустые лицевые счета тоже не проверяются.
+[DbContext(typeof(HousingDbContext))]
+[Migration("20261002120000_UniqueAccountNumber")]
+public partial class UniqueAccountNumber : Migration
+{
+    protected override void Up(MigrationBuilder migrationBuilder)
+    {
+        migrationBuilder.AddColumn<bool>(
+            name: "is_superseded",
+            table: "apartments",
+            type: "boolean",
+            nullable: false,
+            defaultValue: false);
+
+        migrationBuilder.Sql("""
+            UPDATE apartments a
+            SET is_superseded = TRUE
+            WHERE a.account_number <> ''
+              AND EXISTS (SELECT 1 FROM apartments b
+                          WHERE b.account_number = a.account_number AND b.id > a.id);
+            """);
+
+        migrationBuilder.DropIndex(
+            name: "ix_apartments_account_number",
+            table: "apartments");
+
+        migrationBuilder.CreateIndex(
+            name: "ux_apartments_account_number",
+            table: "apartments",
+            column: "account_number",
+            unique: true,
+            filter: "NOT is_superseded AND account_number <> ''");
+    }
+
+    protected override void Down(MigrationBuilder migrationBuilder)
+    {
+        migrationBuilder.DropIndex(
+            name: "ux_apartments_account_number",
+            table: "apartments");
+
+        migrationBuilder.CreateIndex(
+            name: "ix_apartments_account_number",
+            table: "apartments",
+            column: "account_number");
+
+        migrationBuilder.DropColumn(
+            name: "is_superseded",
+            table: "apartments");
+    }
+}
