+namespace Domovoy.Housing;
+
+// Подключение: app.MapHousingEndpoints() в Program.cs.
+public static class HousingEndpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // GET /requests?text=&status=&sort=id|created_at|address|status|category&dir=asc|desc&page=&pageSize=
+        app.MapGet("/requests", async (HousingService svc, string? text, RequestStatus? status,
+            string? sort, string? dir, int? page, int? pageSize) =>
+        {
+            try
+            {
+                return Results.Ok(await svc.SearchAsync(
+                    new RequestSearch(text, status, page ?? 1, pageSize ?? 50, sort, dir)));
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+        });
+
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.Ok(await svc.GetPlanAsync(id));
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(new { error = ex.Message });
+            }
+        });
+
+        return app;
+    }
+}
