@@ -0,0 +1,44 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesByInstructorDto(int? InstructorId, string? InstructorName, bool InstructorDismissed, int GraduatesCount);
+
+// Отчёты для продления лицензии автошколы.
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Число выпускников за год по каждому инструктору, включая уже уволенных.
+    public async Task<List<GraduatesByInstructorDto>> GetGraduatesByInstructorAsync(int year)
+    {
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn.HasValue
+                        && s.GraduatedOn.Value.Year == year)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new { InstructorId = g.Key, GraduatesCount = g.Count() })
+            .ToListAsync();
+
+        var instructorIds = counts
+            .Where(c => c.InstructorId != null)
+            .Select(c => c.InstructorId!.Value)
+            .ToList();
+
+        // IgnoreQueryFilters, т.к. стандартный фильтр скрывает уволенных инструкторов;
+        // принадлежность школе проверяется вручную, чтобы не потерять изоляцию по школе.
+        var instructors = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .Select(i => new { i.Id, i.FullName, i.IsDeleted })
+            .ToDictionaryAsync(i => i.Id);
+
+        return counts
+            .Select(c => c.InstructorId is { } id && instructors.TryGetValue(id, out var instructor)
+                ? new GraduatesByInstructorDto(id, instructor.FullName, instructor.IsDeleted, c.GraduatesCount)
+                : new GraduatesByInstructorDto(c.InstructorId, null, false, c.GraduatesCount))
+            .OrderBy(x => x.InstructorName)
+            .ToList();
+    }
+}
