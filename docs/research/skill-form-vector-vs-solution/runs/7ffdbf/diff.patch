+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+// Приложение инструктора: его текущие ученики.
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorStudentDto>?> GetStudentsAsync(int instructorId)
+    {
+        var instructorExists = await _db.Instructors.AnyAsync(i => i.Id == instructorId);
+        if (!instructorExists)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var rows = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .Select(s => new
+            {
+                s.Id,
+                s.FullName,
+                s.Phone,
+                s.Email,
+                s.PassportNo,
+                NextLessonAt = _db.Lessons
+                    .Where(l => l.StudentId == s.Id && !l.Done && l.StartsAt >= now)
+                    .OrderBy(l => l.StartsAt)
+                    .Select(l => (DateTime?)l.StartsAt)
+                    .FirstOrDefault(),
+            })
+            .ToListAsync();
+
+        return rows
+            .Select(r => new InstructorStudentDto(
+                r.Id,
+                r.FullName,
+                r.Phone,
+                PrivacyMasking.MaskEmail(r.Email),
+                PrivacyMasking.MaskPassport(r.PassportNo),
+                r.NextLessonAt))
+            .ToList();
+    }
+}
