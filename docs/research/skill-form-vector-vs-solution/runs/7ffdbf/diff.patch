+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginConfirmResult(int StudentId, string FullName);
+public record StudentProgressDto(int StudentId, double DoneHours, int RequiredHours, double RemainingHours);
+
+// Вход в приложение ученика по одноразовому коду, отправленному на e-mail.
+public class AppLoginService
+{
+    private const int CodeLifetimeMinutes = 10;
+    private const int MaxAttempts = 5;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppLoginService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestCodeAsync(LoginRequestDto req)
+    {
+        var student = await FindStudentByEmailAsync(req.Email);
+        if (student is null)
+            return; // не подтверждаем и не отрицаем наличие e-mail в системе
+
+        var code = GenerateCode();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = HashCode(code),
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа", $"Ваш код: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<LoginConfirmResult?> ConfirmCodeAsync(LoginConfirmDto req)
+    {
+        var student = await FindStudentByEmailAsync(req.Email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var activeCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && c.ConsumedAt == null && c.ExpiresAt > now)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+
+        if (activeCode is null || activeCode.AttemptCount >= MaxAttempts)
+            return null;
+
+        if (activeCode.CodeHash != HashCode(req.Code.Trim()))
+        {
+            activeCode.AttemptCount++;
+            return null;
+        }
+
+        activeCode.ConsumedAt = now;
+        return new LoginConfirmResult(student.Id, student.FullName);
+    }
+
+    // Ученик вводит e-mail как придётся (регистр клавиатуры телефона не имеет значения).
+    private record StudentLite(int Id, string FullName, string Email);
+
+    private Task<StudentLite?> FindStudentByEmailAsync(string email)
+    {
+        var normalized = email.Trim();
+        return _db.Students.AsNoTracking()
+            .Where(s => EF.Functions.ILike(s.Email, normalized))
+            .OrderBy(s => s.Id)
+            .Select(s => new StudentLite(s.Id, s.FullName, s.Email))
+            .FirstOrDefaultAsync();
+    }
+
+    private static string GenerateCode() => RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+
+    private static string HashCode(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
+
+// Прогресс ученика по часам вождения.
+public class StudentProgressService
+{
+    private const int RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+
+    public StudentProgressService(SchoolDbContext db) => _db = db;
+
+    public async Task<StudentProgressDto?> GetProgressAsync(int studentId)
+    {
+        var studentExists = await _db.Students.AnyAsync(s => s.Id == studentId);
+        if (!studentExists)
+            return null;
+
+        var doneMinutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => (int?)l.Minutes) ?? 0;
+
+        var doneHours = doneMinutes / 60.0;
+        return new StudentProgressDto(studentId, doneHours, RequiredHours, Math.Max(0, RequiredHours - doneHours));
+    }
+}
