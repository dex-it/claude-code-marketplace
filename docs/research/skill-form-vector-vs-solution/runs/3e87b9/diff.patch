@@ -50,4 +50,20 @@ public class SubscriberService
             ? null
             : new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance);
     }
+
+    // Поиск для колл-центра по последним цифрам телефона, без учёта формата записи номера.
+    public async Task<List<SubscriberDto>> SearchByPhoneAsync(string phoneSuffix)
+    {
+        var pattern = "%" + EscapeLike(phoneSuffix.Trim());
+
+        return await _db.Subscribers.AsNoTracking()
+            .Where(s => EF.Functions.Like(s.Phone, pattern, "\\"))
+            .OrderBy(s => s.Id)
+            .Take(20)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+    }
+
+    private static string EscapeLike(string s) =>
+        s.Replace("\\", "\\\\").Replace("%", "\\%").Replace("_", "\\_");
 }
