+using Microsoft.EntityFrameworkCore;
+
+namespace Tarif.Billing;
+
+public record BankImportResult(int Credited, int Unmatched, int Skipped);
+
+public class BankStatementService
+{
+    private readonly BillingDbContext _db;
+
+    public BankStatementService(BillingDbContext db) => _db = db;
+
+    public async Task<BankImportResult> ImportAsync(Stream file)
+    {
+        using var reader = new StreamReader(file);
+        var lines = BankStatement.Parse(reader);
+
+        var refs = lines.Select(l => l.BankRef).ToList();
+
+        // Строка выписки уже зачислена или отложена как неразобранная ранее -> повторная
+        // загрузка той же выписки её пропускает (BankRef - уникальный номер операции банка).
+        var seen = new HashSet<string>(await _db.Payments
+            .Where(p => refs.Contains(p.BankRef))
+            .Select(p => p.BankRef)
+            .ToListAsync());
+        seen.UnionWith(await _db.UnmatchedPayments
+            .Where(u => refs.Contains(u.BankRef))
+            .Select(u => u.BankRef)
+            .ToListAsync());
+
+        int credited = 0, unmatched = 0, skipped = 0;
+
+        foreach (var line in lines)
+        {
+            if (!seen.Add(line.BankRef))
+            {
+                skipped++;
+                continue;
+            }
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var subscriber = contractNo is null
+                ? null
+                : await _db.Subscribers.SingleOrDefaultAsync(s => s.ContractNo == contractNo);
+
+            if (subscriber is null)
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    ImportedAt = DateTime.Now,
+                });
+                unmatched++;
+                continue;
+            }
+
+            subscriber.Balance += line.Amount;
+
+            _db.Payments.Add(new Payment
+            {
+                SubscriberId = subscriber.Id,
+                Amount = line.Amount,
+                BankRef = line.BankRef,
+                PaidOn = line.PaidOn,
+                CreditedAt = DateTime.Now,
+                Purpose = line.Purpose,
+            });
+
+            if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+            {
+                subscriber.Status = SubscriberStatus.Active;
+                subscriber.ReactivatedAt = DateTime.Now;
+            }
+
+            credited++;
+        }
+
+        await _db.SaveChangesAsync();
+        return new BankImportResult(credited, unmatched, skipped);
+    }
+}
