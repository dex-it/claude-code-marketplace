+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public static class HousingEndpoints
+{
+    public static void MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Мастер закрывает заявку: только из InProgress, с обязательным комментарием.
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService service) =>
+        {
+            if (string.IsNullOrWhiteSpace(body.Comment))
+                return Results.BadRequest("Комментарий о выполненных работах обязателен.");
+
+            var result = await service.CloseRequestAsync(id, body.Comment);
+            return result switch
+            {
+                CloseRequestResult.Ok => Results.NoContent(),
+                CloseRequestResult.NotFound => Results.NotFound(),
+                CloseRequestResult.Conflict => Results.Conflict(
+                    "Закрыть можно только заявку в статусе InProgress."),
+                _ => Results.Problem(),
+            };
+        });
+
+        // Инженер присылает план дома целиком - план дома становится ровно таким.
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanReplacementItem> items, PlanService service) =>
+        {
+            if (items.Select(i => i.WorkCode).Distinct().Count() != items.Count)
+                return Results.BadRequest("Коды работ в плане должны быть уникальны.");
+
+            await service.ReplacePlanAsync(id, items);
+            return Results.NoContent();
+        });
+    }
+}
