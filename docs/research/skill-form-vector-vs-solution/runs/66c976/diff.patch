+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<object?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var sevenDaysLater = now.AddDays(7);
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .Where(s => s.StartsAt >= now && s.StartsAt <= sevenDaysLater)
+            .OrderBy(s => EF.Functions.Random())
+            .FirstOrDefaultAsync();
+
+        if (session is null)
+            return null;
+
+        var members = session.Enrollments
+            .Where(e => e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToList();
+
+        return new
+        {
+            course = session.Course.Title,
+            trainer = session.Course.Trainer.FullName,
+            hall = session.Hall.Name,
+            startsAt = session.StartsAt,
+            members = members
+        };
+    }
 }
