+using Microsoft.EntityFrameworkCore;
+
+namespace Tarif.Billing;
+
+public record BankStatementImportResult(int Credited, int Unmatched, int AlreadyProcessed);
+
+public class BankStatementService
+{
+    private readonly BillingDbContext _db;
+    private readonly SubscriberService _subscribers;
+
+    public BankStatementService(BillingDbContext db, SubscriberService subscribers)
+    {
+        _db = db;
+        _subscribers = subscribers;
+    }
+
+    public async Task<BankStatementImportResult> ImportAsync(TextReader reader)
+    {
+        var lines = BankStatement.Parse(reader);
+        int credited = 0, unmatched = 0, alreadyProcessed = 0;
+
+        foreach (var line in lines)
+        {
+            // BankRef уникален в рамках выписки - по нему и определяем, что строка уже обработана.
+            var processed = await _db.Payments.AnyAsync(p => p.BankRef == line.BankRef)
+                || await _db.UnmatchedPayments.AnyAsync(p => p.BankRef == line.BankRef);
+            if (processed)
+            {
+                alreadyProcessed++;
+                continue;
+            }
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var subscriber = contractNo is null
+                ? null
+                : await _subscribers.FindTrackedByContractAsync(contractNo);
+
+            var now = DateTime.Now;
+
+            if (subscriber is null)
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    CreatedAt = now,
+                });
+                unmatched++;
+            }
+            else
+            {
+                _subscribers.CreditBalance(subscriber, line.Amount, now);
+                _db.Payments.Add(new Payment
+                {
+                    SubscriberId = subscriber.Id,
+                    Amount = line.Amount,
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    CreditedAt = now,
+                    Purpose = line.Purpose,
+                });
+                credited++;
+            }
+        }
+
+        await _db.SaveChangesAsync();
+        return new BankStatementImportResult(credited, unmatched, alreadyProcessed);
+    }
+}
