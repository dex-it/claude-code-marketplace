@@ -50,4 +50,32 @@ public class SubscriberService
             ? null
             : new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance);
     }
+
+    public async Task<List<SubscriberDto>> SearchByPhoneAsync(string phoneSuffix)
+    {
+        if (string.IsNullOrWhiteSpace(phoneSuffix))
+            return new List<SubscriberDto>();
+
+        return await _db.Subscribers.AsNoTracking()
+            .Where(s => s.Phone.EndsWith(phoneSuffix))
+            .OrderBy(s => s.Id)
+            .Take(20)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+    }
+
+    // Tracked-сущность для изменения баланса из BankStatementService в рамках одной транзакции.
+    public Task<Subscriber?> FindTrackedByContractAsync(string contractNo) =>
+        _db.Subscribers.SingleOrDefaultAsync(x => x.ContractNo == contractNo);
+
+    public void CreditBalance(Subscriber subscriber, decimal amount, DateTime creditedAt)
+    {
+        subscriber.Balance += amount;
+
+        if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+        {
+            subscriber.Status = SubscriberStatus.Active;
+            subscriber.ResumedAt = creditedAt;
+        }
+    }
 }
