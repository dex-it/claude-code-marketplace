+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+public sealed class BranchLoanCount
+{
+    public int BranchId { get; init; }
+    public string BranchName { get; init; } = "";
+    public int Count { get; init; }
+}
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // from/to - моменты времени с указанием пояса пользователя; сравнение идёт по UTC-инстанту,
+    // поэтому пояс конкретного филиала на отбор выдач не влияет.
+    public async Task<List<BranchLoanCount>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(g => g.BranchId, g => g.Count);
+
+        var branches = await _db.Branches.OrderBy(b => b.Name).ToListAsync();
+
+        return branches
+            .Select(b => new BranchLoanCount
+            {
+                BranchId = b.Id,
+                BranchName = b.Name,
+                Count = counts.GetValueOrDefault(b.Id),
+            })
+            .ToList();
+    }
+}
