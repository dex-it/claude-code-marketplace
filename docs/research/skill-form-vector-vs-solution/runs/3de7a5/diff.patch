+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestInput(string Comment);
+
+public static class RequestCloseEndpoint
+{
+    public static IEndpointRouteBuilder MapRequestCloseEndpoint(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestInput input, HousingService svc) =>
+        {
+            try
+            {
+                await svc.CloseRequestAsync(id, input.Comment);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+            catch (RequestStatusConflictException ex)
+            {
+                return Results.Conflict(ex.Message);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        return app;
+    }
+}
+
+public static class HousePlanEndpoint
+{
+    public static IEndpointRouteBuilder MapHousePlanEndpoint(this IEndpointRouteBuilder app)
+    {
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        return app;
+    }
+}
