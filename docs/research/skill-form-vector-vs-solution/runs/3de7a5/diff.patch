+    // Инженер присылает план целиком: он становится новым состоянием плана дома.
+    // Работы, которые остаются (совпадают по коду), сохраняют Id и историю выполнения;
+    // работы, которых больше нет в присланном списке, удаляются вместе со своей историей;
+    // новые коды добавляются как новые PlanItem без истории.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var codes = items.Select(i => i.WorkCode).ToList();
+        if (codes.Distinct().Count() != codes.Count)
+            throw new ArgumentException("Код работы должен быть уникальным в плане.");
+        if (items.Any(i => i.PeriodDays <= 0))
+            throw new ArgumentException("Периодичность работы должна быть положительной.");
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId)
+            ?? throw new KeyNotFoundException($"План дома {houseId} не найден.");
+
+        var incomingCodes = codes.ToHashSet();
+        var removed = plan.Items.Where(i => !incomingCodes.Contains(i.WorkCode)).ToList();
+        if (removed.Count > 0)
+            _db.PlanItems.RemoveRange(removed);
+
+        foreach (var input in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == input.WorkCode);
+            if (existing is null)
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+            else
+            {
+                existing.Title = input.Title;
+                existing.PeriodDays = input.PeriodDays;
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
