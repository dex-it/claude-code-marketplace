@@ -6,4 +6,12 @@ public class OrderRepository
     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    // Позиции удаляются одним DELETE; заказ должен существовать и не быть мягко удалённым
+    // (query filter на Orders применяется в подзапросе). Items.Clear() не годится:
+    // FK обязательный + Restrict -> EF бросит на SaveChanges вместо удаления сирот.
+    public Task<int> ClearItemsAsync(Guid orderId) =>
+        _db.Set<OrderItem>()
+            .Where(i => i.OrderId == orderId && _db.Orders.Any(o => o.Id == orderId))
+            .ExecuteDeleteAsync();
 }
