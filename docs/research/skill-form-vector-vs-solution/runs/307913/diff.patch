+    // Полнотекстовый поиск по жалобе, диагнозу или назначенным препаратам
+    public async Task<IReadOnlyList<VisitRow>> SearchAsync(string text, int page, SearchScope scope = SearchScope.Complaint)
+    {
+        var sql = scope switch
