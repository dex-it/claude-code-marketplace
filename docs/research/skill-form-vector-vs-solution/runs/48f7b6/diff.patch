+    }
+
+    // Заменяет список аллергий питомца присланным. Совпадающие по аллергену записи
+    // обновляются на месте, лишние мягко удаляются, новые добавляются.
+    // false - питомец не найден; ArgumentException - некорректный список.
+    public async Task<bool> ReplaceAllergiesAsync(int petId, IReadOnlyList<AllergyInput> allergies)
+    {
+        var wanted = NormalizeAllergies(allergies);
+
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        // Блокировка строки питомца до Commit: параллельные замены списка одного питомца
+        // выполняются по очереди и не задваивают добавляемые аллергии.
+        await db.Database.ExecuteSqlAsync($"""SELECT 1 FROM "Pets" WHERE "Id" = {petId} FOR UPDATE""");
+
+        var pet = await db.Pets
+            .Include(p => p.Allergies)
+            .SingleOrDefaultAsync(p => p.Id == petId);
+        if (pet is null)
+            return false;
+
+        var now = DateTime.UtcNow;
+        var pending = wanted.ToDictionary(a => a.Allergen, StringComparer.OrdinalIgnoreCase);
+
+        // Старые дубликаты одного аллергена: остаётся самая ранняя запись, остальные удаляются.
+        foreach (var existing in pet.Allergies.OrderBy(a => a.Id))
+        {
+            if (pending.Remove(existing.Allergen, out var input))
+            {
+                existing.Allergen = input.Allergen;
+                existing.Reaction = input.Reaction;
+                existing.Severity = input.Severity;
+            }
+            else
+            {
+                // Не Remove/Clear: записи медкарты только мягко удаляются.
+                existing.IsDeleted = true;
+                existing.DeletedAt = now;
+            }
+        }
+
+        foreach (var input in wanted.Where(a => pending.ContainsKey(a.Allergen)))
+        {
+            pet.Allergies.Add(new Allergy
+            {
+                Allergen = input.Allergen,
+                Reaction = input.Reaction,
+                Severity = input.Severity
+            });
+        }
+
+        await db.SaveChangesAsync();
+        await tx.CommitAsync();
+        return true;
+    }
+
+    public async Task UpdateVisitAnamnesisAsync(int visitId, string? anamnesis)
     {
         var visit = await db.Visits.SingleAsync(v => v.Id == visitId);
-        visit.Notes = notes;
+        visit.Anamnesis = anamnesis;
         await db.SaveChangesAsync();
     }
+
+    private static List<AllergyInput> NormalizeAllergies(IReadOnlyList<AllergyInput> allergies)
+    {
+        var result = new List<AllergyInput>(allergies.Count);
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+        foreach (var a in allergies)
+        {
+            var allergen = a?.Allergen?.Trim();
+            if (string.IsNullOrEmpty(allergen) || allergen.Length > AllergenMaxLength)
+                throw new ArgumentException($"Аллерген должен быть непустой строкой до {AllergenMaxLength} символов.");
+            if (!Enum.IsDefined(a!.Severity))
+                throw new ArgumentException($"Неизвестная тяжесть аллергии «{a.Severity}» для «{allergen}».");
+            if (!seen.Add(allergen))
+                throw new ArgumentException($"Аллерген «{allergen}» указан в списке дважды.");
+
+            result.Add(a with { Allergen = allergen });
+        }
+
+        return result;
+    }
