+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthReportItem(int Month, DateOnly? ActSignedOn, decimal TotalHours);
+
+public record YearReportDto(int Year, List<MonthReportItem> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearReportDto> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .Where(p => p.Month.Year == year)
+            .AsNoTracking()
+            .ToListAsync();
+
+        var closedByMonth = closedPeriods
+            .ToDictionary(p => p.Month.Month, p => p.ActSignedOn);
+
+        var monthlyHours = await _db.TimeEntries
+            .Where(t => t.WorkDate.Year == year)
+            .AsNoTracking()
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToListAsync();
+
+        var hoursByMonth = monthlyHours
+            .ToDictionary(m => m.Month, m => m.Hours);
+
+        var months = new List<MonthReportItem>();
+        for (int month = 1; month <= 12; month++)
+        {
+            closedByMonth.TryGetValue(month, out var actSignedOn);
+            hoursByMonth.TryGetValue(month, out var hours);
+            months.Add(new MonthReportItem(month, actSignedOn, hours));
+        }
+
+        return new YearReportDto(year, months);
+    }
+}
