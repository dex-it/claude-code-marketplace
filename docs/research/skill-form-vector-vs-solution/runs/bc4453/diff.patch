+    {
+        var query =
+            from b in _db.Branches
+            join l in _db.Loans.Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+                on b.Id equals l.BranchId into branchLoans
+            orderby b.Name
+            select new LoansByBranchRow
+            {
+                BranchId = b.Id,
+                BranchName = b.Name,
+                LoansCount = branchLoans.Count(),
+            };
+
+        return await query.ToListAsync();
