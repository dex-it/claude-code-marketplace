@@ -0,0 +1,70 @@
+name: Deploy
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+
+jobs:
+  migrate-database:
+    name: Apply EF Core migrations (production)
+    runs-on: ubuntu-latest
+    # Requires a "production" environment with required reviewers configured in repo settings,
+    # so this step waits for manual approval instead of running unattended on every push.
+    environment: production
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: "8.0.x"
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Restore
+        run: dotnet restore
+
+      # Idempotent script: each statement is guarded by a check against __EFMigrationsHistory,
+      # so re-running this job (retry after a transient failure) is safe and applies only what's
+      # still missing, instead of relying on `dotnet ef database update` racing multiple runners.
+      - name: Generate idempotent migration script
+        run: |
+          dotnet ef migrations script \
+            --idempotent \
+            --project Shop.Data \
+            --output migration.sql \
+            --no-build || dotnet ef migrations script --idempotent --output migration.sql
+
+      - name: Apply migrations to production
+        env:
+          PGCONNECT_TIMEOUT: "10"
+          DATABASE_URL: ${{ secrets.PRODUCTION_DATABASE_URL }}
+        run: |
+          # lock_timeout: fail fast instead of blocking production traffic on Orders if another
+          # transaction is holding a conflicting lock, rather than waiting indefinitely.
+          # statement_timeout: guard against the data-backfill migration running away on an
+          # unexpectedly large Orders table.
+          psql "$DATABASE_URL" \
+            --set ON_ERROR_STOP=1 \
+            -c "SET lock_timeout = '5s';" \
+            -c "SET statement_timeout = '15min';" \
+            -f migration.sql
+
+      - name: Upload applied migration script
+        uses: actions/upload-artifact@v4
+        with:
+          name: migration-sql-${{ github.sha }}
+          path: migration.sql
+
+  deploy-app:
+    name: Deploy application
+    needs: migrate-database
+    runs-on: ubuntu-latest
+    environment: production
+    steps:
+      - uses: actions/checkout@v4
+      # ... build/publish/deploy the app image here.
+      # Runs only after migrate-database succeeds, so the schema the new app version expects
+      # (Categories / OrderCategories) already exists before any instance of it starts.
+      - run: echo "deploy app"
