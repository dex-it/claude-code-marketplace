+namespace Shop.Data;
+
+public record OrderReportDto(Guid Id, string CustomerName, decimal Total, int ItemCount);
+
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public Task<List<OrderReportDto>> GetActiveOrdersAsync() =>
+        _orders.Query()
+            .Where(o => o.Status == "active")
+            .Select(o => new OrderReportDto(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountByCategoryAsync() =>
+        _orders.Query()
+            .Where(o => o.Status == "active")
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    // IsOverdue's condition is inlined (not called as a method) so EF Core can translate it into SQL.
+    public Task<List<OrderReportDto>> GetOverdueOrdersAsync(DateTime now) =>
+        _orders.Query()
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Select(o => new OrderReportDto(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+}
