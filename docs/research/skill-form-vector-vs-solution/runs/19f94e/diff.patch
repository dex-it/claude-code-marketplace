+            .Include(l => l.Reader)
+            .Include(l => l.Book)
+            .Select(l => new DebtorRow
+            {
+                Reader = l.Reader.FullName,
+                Phone = l.Reader.Phone,
+                Book = l.Book.Title,
+                DueDate = l.DueDate,
+                DaysOverdue = Fines.DaysOverdue(l.DueDate, today),
+                Fine = Fines.Amount(l.DueDate, today, l.Reader.Category, _rules),
+            })
+            .ToListAsync();
+
+        var sorted = debtors.OrderByDescending(d => d.Fine).ToList();
+        var totalFines = sorted.Sum(d => d.Fine);
+
+        return new DebtorsResponse
+        {
+            Debtors = sorted,
+            TotalFines = totalFines
+        };
+    }
+
+    public async Task<LoansByBranchResponse> GetLoanCountByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var loans = await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .Include(l => l.Branch)
+            .GroupBy(l => new { l.BranchId, l.Branch.Name })
+            .Select(g => new LoanCountByBranch
+            {
+                BranchId = g.Key.BranchId,
+                BranchName = g.Key.Name,
+                Count = g.Count()
+            })
+            .OrderBy(x => x.BranchId)
+            .ToListAsync();
+
+        return new LoansByBranchResponse { Data = loans };
+    }
