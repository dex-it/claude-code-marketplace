+using Microsoft.EntityFrameworkCore;
+
+namespace FlowStudio.Schedule;
+
+public record RandomSessionDto(int SessionId, string Course, string Trainer, string Hall,
+    DateTime StartsAt, IReadOnlyList<string> Members);
+
+public class QualityService
+{
+    private readonly StudioDbContext _db;
+
+    public QualityService(StudioDbContext db) => _db = db;
+
+    public async Task<RandomSessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        var upcoming = _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.Course.Status == CourseStatus.Published
+                && s.StartsAt >= now && s.StartsAt <= until);
+
+        var count = await upcoming.CountAsync();
+        if (count == 0)
+            return null;
+
+        var index = Random.Shared.Next(count);
+
+        return await upcoming
+            .OrderBy(s => s.Id)
+            .Skip(index)
+            .Select(s => new RandomSessionDto(
+                s.Id,
+                s.Course.Title,
+                s.Course.Trainer.FullName,
+                s.Hall.Name,
+                s.StartsAt,
+                s.Enrollments
+                    .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                    .Select(e => e.Member.FullName)
+                    .ToList()))
+            .FirstAsync();
+    }
+}
