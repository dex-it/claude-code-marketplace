+using Microsoft.EntityFrameworkCore;
+
+namespace FlowStudio.Schedule;
+
+public class MembershipService
+{
+    private readonly StudioDbContext _db;
+
+    public MembershipService(StudioDbContext db) => _db = db;
+
+    public async Task<bool> FreezeAsync(int memberId, int days)
+    {
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId);
+        if (member is null)
+            return false;
+
+        var now = DateTime.UtcNow;
+        member.FreezeStartsAt = now;
+        member.FreezeEndsAt = now.AddDays(days);
+        await _db.SaveChangesAsync();
+        return true;
+    }
+
+    public async Task<bool> UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId);
+        if (member is null)
+            return false;
+
+        member.FreezeStartsAt = null;
+        member.FreezeEndsAt = null;
+        await _db.SaveChangesAsync();
+        return true;
+    }
+}
