@@ -43,8 +46,38 @@ public class ShopDbContext : DbContext
     public DbSet<AuditLog> AuditLogs => Set<AuditLog>();
     protected override void OnModelCreating(ModelBuilder b)
     {
-        b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+        // Колонка остаётся timestamp without time zone (нужна DBA-отчётам); в БД храним
+        // без Kind (Unspecified), а на границе с кодом всегда возвращаем/принимаем Utc.
+        var createdAtUtc = new ValueConverter<DateTime, DateTime>(
+            v => DateTime.SpecifyKind(v, DateTimeKind.Unspecified),
+            v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
+        b.Entity<Order>(e =>
+        {
+            e.HasQueryFilter(o => !o.IsDeleted);
+
+            e.Property(o => o.CreatedAt)
+                .HasColumnType("timestamp without time zone")
+                .HasConversion(createdAtUtc);
+
+            e.Property(o => o.Complexity).IsRequired();
+            e.HasCheckConstraint("CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5");
+
+            // Items/Payments - обязательные зависимые (OrderId не nullable), поэтому при
+            // разрыве связи (Clear() коллекции) EF должен удалять записи, а не пытаться
+            // занулить FK - иначе SaveChanges бросит InvalidOperationException.
+            e.HasMany(o => o.Items)
+                .WithOne()
+                .HasForeignKey(i => i.OrderId)
+                .IsRequired()
+                .OnDelete(DeleteBehavior.Cascade);
+
+            e.HasMany(o => o.Payments)
+                .WithOne()
+                .HasForeignKey(p => p.OrderId)
+                .IsRequired()
+                .OnDelete(DeleteBehavior.Cascade);
+        });
     }
 }
