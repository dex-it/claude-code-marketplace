+    // Список должников филиала для обзвона: сначала самые большие штрафы, в конце - сумма по филиалу.
+    public async Task<DebtorsReport> GetDebtorsAsync(int branchId)
+    {
+        var branch = await _db.Branches.FindAsync(branchId)
+            ?? throw new InvalidOperationException("Филиал не найден");
+
+        var debtorsQuery = _db.Loans
+            .Where(l => l.BranchId == branchId && l.ReturnedAt == null)
+            .ToLoanRows(LocalToday(branch), _rules)
+            .Where(r => r.Fine > 0);
+
+        var debtors = await debtorsQuery.OrderByDescending(r => r.Fine).ToListAsync();
+        var totalFine = await debtorsQuery.SumAsync(r => r.Fine);
+
+        return new DebtorsReport { Debtors = debtors, TotalFine = totalFine };
+    }
+
+    // Отчёт методисту: число выдач по каждому филиалу за период (period - в абсолютных моментах времени).
+    public Task<List<BranchLoanCount>> GetLoansByBranchReportAsync(DateTimeOffset from, DateTimeOffset to) =>
+        (from branch in _db.Branches
+         join loan in _db.Loans.Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+             on branch.Id equals loan.BranchId into g
+         orderby branch.Name
+         select new BranchLoanCount
+         {
+             BranchId = branch.Id,
+             Branch = branch.Name,
+             Loans = g.Count(),
+         }).ToListAsync();
