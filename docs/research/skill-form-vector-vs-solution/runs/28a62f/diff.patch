-    public async Task UpdateVisitNotesAsync(int visitId, string? notes)
+    // Мягкое удаление клиента: клиент, его питомцы и их запланированные визиты помечаются
+    // удалёнными одной отметкой DeletedAt (по ней поддержка восстанавливает всё разом).
+    // Аллергии и прошедшие визиты остаются как есть - они видны только через карточку питомца,
+    // а питомец скрыт фильтром.
+    public async Task<bool> DeleteOwnerAsync(int ownerId)
     {
-        var visit = await db.Visits.SingleAsync(v => v.Id == visitId);
-        visit.Notes = notes;
+        var now = DateTime.UtcNow;
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        var owners = await db.Owners
+            .Where(o => o.Id == ownerId)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(o => o.IsDeleted, true)
+                .SetProperty(o => o.DeletedAt, now));
+        if (owners == 0)
+            return false;
+
+        // Визиты - до питомцев: фильтр Pet участвует в join и скрыл бы уже удалённых питомцев.
+        await db.Visits
+            .Where(v => v.Pet.OwnerId == ownerId && v.Status == VisitStatus.Planned)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(v => v.IsDeleted, true)
+                .SetProperty(v => v.DeletedAt, now));
+
+        await db.Pets
+            .Where(p => p.OwnerId == ownerId)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(p => p.IsDeleted, true)
+                .SetProperty(p => p.DeletedAt, now));
+
+        await tx.CommitAsync();
+        return true;
+    }
+
+    // Форма присылает полный список. Совпадающие записи остаются нетронутыми, лишние
+    // помечаются удалёнными (история хранится), недостающие добавляются.
+    public async Task<bool> ReplaceAllergiesAsync(int petId, IReadOnlyList<AllergyInput> allergies)
+    {
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        // Блокировка строки питомца сериализует параллельные сохранения формы одного питомца.
+        var petExists = await db.Pets
+            .FromSql($"""SELECT * FROM "Pets" WHERE "Id" = {petId} FOR UPDATE""")
+            .AnyAsync();
+        if (!petExists)
+            return false;
+
+        var stale = await db.Allergies
+            .Where(a => a.PetId == petId)
+            .ToListAsync();
+
+        foreach (var input in allergies)
+        {
+            var allergen = input.Allergen.Trim();
+            var same = stale.FirstOrDefault(a =>
+                a.Allergen == allergen && a.Reaction == input.Reaction && a.Severity == input.Severity);
+
+            if (same is not null)
+                stale.Remove(same);
+            else
+                db.Allergies.Add(new Allergy
+                {
+                    PetId = petId,
+                    Allergen = allergen,
+                    Reaction = input.Reaction,
+                    Severity = input.Severity
+                });
+        }
+
+        var now = DateTime.UtcNow;
+        foreach (var allergy in stale)
+        {
+            allergy.IsDeleted = true;
+            allergy.DeletedAt = now;
+        }
+
+        await db.SaveChangesAsync();
+        await tx.CommitAsync();
+        return true;
+    }
+
+    public async Task<bool> UpdateVisitAnamnesisAsync(int visitId, string? anamnesis)
+    {
+        var visit = await db.Visits.SingleOrDefaultAsync(v => v.Id == visitId);
+        if (visit is null)
+            return false;
+
+        visit.Anamnesis = anamnesis;
         await db.SaveChangesAsync();
+        return true;
     }
 }
