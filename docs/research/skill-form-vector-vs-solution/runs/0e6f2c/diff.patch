+
+    public async Task ProcessBankStatementAsync(TextReader csvReader)
+    {
+        var lines = BankStatement.Parse(csvReader);
+        var now = DateTime.UtcNow;
+
+        foreach (var line in lines)
+        {
+            if (await _db.Payments.AnyAsync(p => p.BankRef == line.BankRef))
+                continue;
+
+            if (await _db.UnresolvedPayments.AnyAsync(p => p.BankRef == line.BankRef))
+                continue;
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var subscriber = contractNo is not null
+                ? await _db.Subscribers.FirstOrDefaultAsync(s => s.ContractNo == contractNo)
+                : null;
+
+            if (subscriber is null)
+            {
+                _db.UnresolvedPayments.Add(new UnresolvedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    CreatedAt = now
+                });
+            }
+            else
+            {
+                subscriber.Balance += line.Amount;
+
+                _db.Payments.Add(new Payment
+                {
+                    SubscriberId = subscriber.Id,
+                    Amount = line.Amount,
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    CreditedAt = now,
+                    Purpose = line.Purpose
+                });
+
+                if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+                {
+                    subscriber.Status = SubscriberStatus.Active;
+                    _db.SuspendedReactivations.Add(new SuspendedReactivation
+                    {
+                        SubscriberId = subscriber.Id,
+                        ReactivatedAt = now
+                    });
+                }
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<List<SubscriberDto>> SearchByPhoneAsync(string phoneSuffix)
+    {
+        var pattern = $"%{phoneSuffix}";
+        var subscribers = await _db.Subscribers.AsNoTracking()
+            .Where(s => EF.Functions.Like(s.Phone, pattern))
+            .Take(20)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+
+        return subscribers;
+    }
 }
