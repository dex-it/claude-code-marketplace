+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResult(int StudentId, string FullName);
+public record InstructorStudentDto(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+public record GraduatesRow(int? InstructorId, string Instructor, bool IsDismissed, int Graduates);
+public record ProgressDto(int StudentId, decimal HoursDone, int HoursRequired);
+
+// Вход ученика в мобильное приложение по одноразовому коду из письма.
+public class AppLoginService
+{
+    private static readonly TimeSpan CodeTtl = TimeSpan.FromMinutes(10);
+    private static readonly TimeSpan ResendCooldown = TimeSpan.FromSeconds(60);
+    private const int MaxAttempts = 5;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppLoginService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Ответ одинаковый независимо от того, найден ли ученик, - чтобы не раскрывать, чьи адреса есть в базе.
+    public async Task RequestAsync(string email)
+    {
+        var student = await FindStudentAsync(email);
+        if (student is null)
+            return;
+
+        var now = DateTime.UtcNow;
+        var old = await _db.LoginCodes.Where(c => c.StudentId == student.Id).ToListAsync();
+        if (old.Any(c => c.UsedAt == null && c.CreatedAt > now - ResendCooldown))
+            return; // код только что отправлен, не спамим почту
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.RemoveRange(old); // новый код отменяет все прежние
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(student.Id, code),
+            CreatedAt = now,
+            ExpiresAt = now + CodeTtl,
+        });
+        await _db.SaveChangesAsync(); // код должен быть в базе до того, как уйдёт письмо
+
+        await _email.SendAsync(student.Email, "Код для входа",
+            $"Ваш код для входа в приложение: {code}. Код действует 10 минут.");
+    }
+
+    public async Task<LoginResult?> ConfirmAsync(string email, string code)
+    {
+        code = (code ?? "").Trim();
+        if (code.Length != 6 || !code.All(char.IsAsciiDigit))
+            return null;
+
+        var student = await FindStudentAsync(email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var lc = await _db.LoginCodes.AsNoTracking()
+            .Where(c => c.StudentId == student.Id && c.UsedAt == null && c.ExpiresAt > now)
+            .OrderByDescending(c => c.CreatedAt)
+            .FirstOrDefaultAsync();
+        if (lc is null)
+            return null;
+
+        // Попытка засчитывается атомарно, иначе параллельными запросами можно обойти лимит перебора.
+        var counted = await _db.LoginCodes
+            .Where(c => c.Id == lc.Id && c.Attempts < MaxAttempts)
+            .ExecuteUpdateAsync(u => u.SetProperty(c => c.Attempts, c => c.Attempts + 1));
+        if (counted == 0)
+            return null;
+
+        if (!CryptographicOperations.FixedTimeEquals(Hash(student.Id, code), lc.CodeHash))
+            return null;
+
+        // Одноразовость: погасить код может только один запрос.
+        var used = await _db.LoginCodes
+            .Where(c => c.Id == lc.Id && c.UsedAt == null)
+            .ExecuteUpdateAsync(u => u.SetProperty(c => c.UsedAt, now));
+        return used == 1 ? new LoginResult(student.Id, student.FullName) : null;
+    }
+
+    // E-mail в карточке хранится как его ввёл администратор, ученик тоже вводит как придётся - сравниваем без учёта регистра.
+    // Уникальный индекс регистрозависимый, поэтому при двух карточках, отличающихся только регистром, вход не выполняем.
+    private async Task<Student?> FindStudentAsync(string email)
+    {
+        var normalized = (email ?? "").Trim().ToLowerInvariant();
+        if (normalized.Length == 0)
+            return null;
+
+        var matches = await _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == normalized && s.Status != StudentStatus.Expelled)
+            .Take(2)
+            .ToListAsync();
+        return matches.Count == 1 ? matches[0] : null;
+    }
+
+    private static byte[] Hash(int studentId, string code) =>
+        SHA256.HashData(Encoding.UTF8.GetBytes($"{studentId}:{code}"));
+}
+
+public class AppReportService
+{
+    public const int RequiredDrivingHours = 56;
+
+    private readonly SchoolDbContext _db;
+
+    public AppReportService(SchoolDbContext db) => _db = db;
+
+    // Отчёт для продления лицензии: выпускники за год по инструкторам, включая уволенных.
+    public async Task<List<GraduatesRow>> GraduatesByInstructorAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated && s.GraduatedOn >= from && s.GraduatedOn < to)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var ids = counts.Where(c => c.InstructorId != null).Select(c => c.InstructorId!.Value).ToList();
+
+        // IgnoreQueryFilters снимает и фильтр уволенных, и фильтр автошколы - автошколу возвращаем явно.
+        var instructors = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == _db.SchoolId && ids.Contains(i.Id))
+            .ToDictionaryAsync(i => i.Id);
+
+        return counts
+            .Select(c => c.InstructorId is int id && instructors.TryGetValue(id, out var i)
+                ? new GraduatesRow(id, i.FullName, i.IsDeleted, c.Count)
+                : new GraduatesRow(c.InstructorId, "Без инструктора", false, c.Count))
+            .OrderBy(r => r.InstructorId == null)
+            .ThenBy(r => r.Instructor)
+            .ToList();
+    }
+
+    // Ученики инструктора, которые сейчас учатся, в виде выгрузки для инструктора + ближайшее занятие.
+    public async Task<List<InstructorStudentDto>?> InstructorStudentsAsync(int instructorId)
+    {
+        // Уволенный инструктор и инструктор другой автошколы отсекаются фильтрами.
+        if (!await _db.Instructors.AnyAsync(i => i.Id == instructorId))
+            return null;
+
+        var now = DateTime.UtcNow;
+        // AsNoTracking обязателен: MaskForInstructor меняет сущность, а SaveChangesFilter сохранил бы маску в базу.
+        var rows = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .Select(s => new
+            {
+                Student = s,
+                NextLessonAt = _db.Lessons
+                    .Where(l => l.StudentId == s.Id && !l.Done && l.StartsAt > now)
+                    .Min(l => (DateTime?)l.StartsAt),
+            })
+            .ToListAsync();
+
+        return rows.Select(r =>
+        {
+            var s = r.Student.MaskForInstructor();
+            var next = r.NextLessonAt is { } t ? DateTime.SpecifyKind(t, DateTimeKind.Utc) : (DateTime?)null;
+            return new InstructorStudentDto(s.Id, s.FullName, s.Phone, s.Email, s.PassportNo, next);
+        }).ToList();
+    }
+
+    public async Task<ProgressDto?> ProgressAsync(int studentId)
+    {
+        if (!await _db.Students.AnyAsync(s => s.Id == studentId))
+            return null;
+
+        var minutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(studentId, Math.Round(minutes / 60m, 1), RequiredDrivingHours);
+    }
+}
