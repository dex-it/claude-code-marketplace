+namespace Pixelwork.Timesheets;
+
+public static class ClientsEndpoints
+{
+    public static IEndpointRouteBuilder MapClientsEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapDelete("/clients/{id:int}/projects", async (int id, ProjectService service) =>
+        {
+            try
+            {
+                var deleted = await service.DeleteAllForClientAsync(id);
+                return Results.Ok(new { deleted });
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+        });
+
+        return app;
+    }
+}
