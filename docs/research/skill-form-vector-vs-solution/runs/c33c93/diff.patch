+namespace Pixelwork.Timesheets;
+
+public static class TimeEntriesEndpoints
+{
+    public static IEndpointRouteBuilder MapTimeEntriesEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/time-entries", async (TimeEntryDto dto, TimeEntryService service) =>
+        {
+            try
+            {
+                var id = await service.AddAsync(dto);
+                return Results.Created($"/time-entries/{id}", new { id });
+            }
+            catch (Exception ex) when (ex is ArgumentOutOfRangeException or InvalidOperationException)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        app.MapPut("/time-entries/{id:int}", async (int id, TimeEntryDto dto, TimeEntryService service) =>
+        {
+            if (id != dto.Id)
+                return Results.BadRequest("Id в маршруте и теле не совпадают");
+
+            try
+            {
+                await service.UpdateAsync(dto);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (Exception ex) when (ex is ArgumentOutOfRangeException or InvalidOperationException)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        return app;
+    }
+}
