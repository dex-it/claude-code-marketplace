+    public async Task<int> DeleteAllForClientAsync(int clientId)
+    {
+        var clientExists = await _db.Clients.AnyAsync(c => c.Id == clientId);
+        if (!clientExists)
+            throw new KeyNotFoundException();
+
+        var projects = await _db.Projects.Where(p => p.ClientId == clientId).ToListAsync();
+        _db.Projects.RemoveRange(projects);
+        await _db.SaveChangesAsync();
+        return projects.Count;
