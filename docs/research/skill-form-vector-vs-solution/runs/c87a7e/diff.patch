-    public async Task UpdateVisitNotesAsync(int visitId, string? notes)
+    // Мягкое удаление клиента вместе с питомцами, их аллергиями и визитами (см. README: физически не удаляем).
+    // Глобальный фильтр Visit не смотрит на питомца, поэтому визиты помечаем явно - иначе они останутся
+    // в расписании врача. Всё помечается одним DeletedAt, чтобы поддержка могла восстановить удаление целиком.
+    // Уже удалённые ранее записи отсекаются фильтрами и сохраняют свой DeletedAt.
+    public async Task<bool> DeleteOwnerAsync(int ownerId)
+    {
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        var now = DateTime.UtcNow;
+
+        var deleted = await db.Owners
+            .Where(o => o.Id == ownerId)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(o => o.IsDeleted, true)
+                .SetProperty(o => o.DeletedAt, now));
+        if (deleted == 0)
+            return false;
+
+        var petIds = await db.Pets
+            .Where(p => p.OwnerId == ownerId)
+            .Select(p => p.Id)
+            .ToListAsync();
+
+        await db.Visits
+            .Where(v => petIds.Contains(v.PetId))
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(v => v.IsDeleted, true)
+                .SetProperty(v => v.DeletedAt, now));
+
+        await db.Allergies
+            .Where(a => petIds.Contains(a.PetId))
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(a => a.IsDeleted, true)
+                .SetProperty(a => a.DeletedAt, now));
+
+        await db.Pets
+            .Where(p => petIds.Contains(p.Id))
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(p => p.IsDeleted, true)
+                .SetProperty(p => p.DeletedAt, now));
+
+        await tx.CommitAsync();
+        return true;
+    }
+
+    // Полная замена списка аллергий. Неизменившиеся записи остаются как есть, отсутствующие в новом
+    // списке и изменённые (реакция/тяжесть) помечаются удалёнными, новые/изменённые добавляются заново -
+    // так прежние значения остаются в истории медкарты. Физически ничего не удаляется.
+    public async Task<bool> ReplaceAllergiesAsync(int petId, IReadOnlyList<AllergyInput> inputs)
+    {
+        var normalized = inputs
+            .Select(i => new AllergyInput(
+                i.Allergen?.Trim() ?? "",
+                string.IsNullOrWhiteSpace(i.Reaction) ? null : i.Reaction.Trim(),
+                i.Severity))
+            .ToList();
+
+        if (normalized.Any(i => i.Allergen.Length == 0))
+            throw new ArgumentException("Аллерген не может быть пустым.");
+        if (normalized.Any(i => !Enum.IsDefined(i.Severity)))
+            throw new ArgumentException("Недопустимая тяжесть аллергии.");
+        if (normalized.GroupBy(i => i.Allergen, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
+            throw new ArgumentException("Аллерген указан в списке несколько раз.");
+
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        // Блокируем строку питомца, чтобы две одновременные замены списка (или удаление клиента) не перемешались.
+        await db.Database.ExecuteSqlAsync($"""SELECT 1 FROM "Pets" WHERE "Id" = {petId} FOR UPDATE""");
+
+        if (!await db.Pets.AnyAsync(p => p.Id == petId))
+            return false;
+
+        var current = await db.Allergies.Where(a => a.PetId == petId).ToListAsync();
+        var now = DateTime.UtcNow;
+
+        foreach (var existing in current)
+        {
+            var match = normalized.FirstOrDefault(i =>
+                string.Equals(i.Allergen, existing.Allergen, StringComparison.OrdinalIgnoreCase));
+
+            if (match is not null && match.Allergen == existing.Allergen
+                && match.Reaction == existing.Reaction && match.Severity == existing.Severity)
+            {
+                normalized.Remove(match);
+                continue;
+            }
+
+            existing.IsDeleted = true;
+            existing.DeletedAt = now;
+        }
+
+        foreach (var input in normalized)
+        {
+            db.Allergies.Add(new Allergy
+            {
+                PetId = petId,
+                Allergen = input.Allergen,
+                Reaction = input.Reaction,
+                Severity = input.Severity
+            });
+        }
+
+        await db.SaveChangesAsync();
+        await tx.CommitAsync();
+        return true;
+    }
+
+    public async Task UpdateVisitAnamnesisAsync(int visitId, string? anamnesis)
     {
         var visit = await db.Visits.SingleAsync(v => v.Id == visitId);
-        visit.Notes = notes;
+        visit.Anamnesis = anamnesis;
         await db.SaveChangesAsync();
     }
 }
