+namespace Shop.Data;
+
+public record ActiveOrderReportRow(Guid OrderId, string CustomerName, decimal Total, int ItemsCount);
+
+public record OverdueOrderReportRow(Guid OrderId, string CustomerName, decimal Total, DateTime CreatedAt);
+
+// Только чтение: все выборки без трекинга, фильтры/группировки/проекции выполняются в БД.
+public class OrderReportService
+{
+    private readonly OrderRepository _repo;
+    public OrderReportService(OrderRepository repo) => _repo = repo;
+
+    public Task<List<ActiveOrderReportRow>> GetActiveOrdersAsync() =>
+        _repo.QueryActive()
+            .Select(o => new ActiveOrderReportRow(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync() =>
+        _repo.QueryActive()
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    // now - точка отсчёта "текущего момента" отчёта; правило просрочки как в Order.IsOverdue,
+    // но выражено в виде транслируемого в SQL условия (сам IsOverdue - не транслируемый метод).
+    public Task<List<OverdueOrderReportRow>> GetOverdueOrdersAsync(DateTime now) =>
+        _repo.QueryOverdue(now)
+            .Select(o => new OverdueOrderReportRow(o.Id, o.Customer.Name, o.Total, o.CreatedAt))
+            .ToListAsync();
+}
