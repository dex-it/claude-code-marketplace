+
+    // Возвращают IQueryable, чтобы вызывающая сторона сама выбирала проекцию/фильтры/группировку,
+    // не материализуя выборку внутри репозитория.
+    public IQueryable<Order> QueryActive() =>
+        _db.Orders.AsNoTracking().Where(o => o.Status == "active");
+
+    public IQueryable<Order> QueryOverdue(DateTime now) =>
+        _db.Orders.AsNoTracking().Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now);
 }
