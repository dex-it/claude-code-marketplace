+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+// Список закреплённых учеников для приложения инструктора.
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorStudentDto>> GetStudentsAsync(int instructorId)
+    {
+        // AsNoTracking: MaskForInstructor меняет поля студента в памяти,
+        // а SaveChangesFilter сохраняет изменения после каждого запроса в /api.
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var studentIds = students.Select(s => s.Id).ToList();
+        var now = DateTime.UtcNow;
+
+        var nextLessons = await _db.Lessons.AsNoTracking()
+            .Where(l => l.InstructorId == instructorId && studentIds.Contains(l.StudentId)
+                        && !l.Done && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextAt = g.Min(l => l.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.NextAt);
+
+        return students.Select(s =>
+        {
+            var masked = s.MaskForInstructor();
+            nextLessons.TryGetValue(masked.Id, out var nextAt);
+            return new InstructorStudentDto(masked.Id, masked.FullName, masked.Phone, masked.Email, masked.PassportNo,
+                nextAt == default ? null : nextAt);
+        }).ToList();
+    }
+}
