+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorGraduatesDto(int? InstructorId, string InstructorName, bool InstructorDismissed, int GraduatesCount);
+
+// Отчёт для продления лицензии: выпускники за год по инструкторам.
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorGraduatesDto>> GraduatesByInstructorAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = new DateOnly(year, 12, 31);
+
+        var grouped = await _db.Students.AsNoTracking()
+            .Where(s => s.Status == StudentStatus.Graduated && s.GraduatedOn >= from && s.GraduatedOn <= to)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var instructorIds = grouped.Where(g => g.InstructorId.HasValue).Select(g => g.InstructorId!.Value).ToList();
+
+        // Отчёт должен учитывать и уже уволенных инструкторов, поэтому обходим их фильтр.
+        var instructors = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .ToDictionaryAsync(i => i.Id);
+
+        return grouped
+            .Select(g => g.InstructorId.HasValue && instructors.TryGetValue(g.InstructorId.Value, out var ins)
+                ? new InstructorGraduatesDto(ins.Id, ins.FullName, ins.IsDeleted, g.Count)
+                : new InstructorGraduatesDto(null, "Без инструктора", false, g.Count))
+            .OrderByDescending(r => r.GraduatesCount)
+            .ToList();
+    }
+}
