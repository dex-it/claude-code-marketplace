+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginResultDto(int StudentId, string FullName);
+
+// Вход ученика в приложение по одноразовому коду из письма.
+public class AppAuthService
+{
+    private static readonly TimeSpan CodeLifetime = TimeSpan.FromMinutes(10);
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestCodeAsync(string rawEmail)
+    {
+        var email = rawEmail.Trim();
+
+        // Почта вводится вручную на телефоне, поэтому сравниваем без учёта регистра.
+        var student = await _db.Students
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == email.ToLower());
+        if (student is null)
+            return; // не подтверждаем и не опровергаем наличие ученика с таким e-mail
+
+        var activeCodes = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used)
+            .ToListAsync();
+        foreach (var old in activeCodes)
+            old.Used = true;
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        var now = DateTime.UtcNow;
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            CreatedAtUtc = now,
+            ExpiresAtUtc = now + CodeLifetime,
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа в AutoSchool.Cloud",
+            $"Ваш код для входа: {code}. Он действует 10 минут.");
+    }
+
+    public async Task<LoginResultDto?> ConfirmCodeAsync(string rawEmail, string rawCode)
+    {
+        var email = rawEmail.Trim();
+        var code = rawCode.Trim();
+
+        var student = await _db.Students
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == email.ToLower());
+        if (student is null)
+            return null;
+
+        var hash = Hash(code);
+        var now = DateTime.UtcNow;
+        var entry = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAtUtc > now && c.CodeHash == hash)
+            .OrderByDescending(c => c.CreatedAtUtc)
+            .FirstOrDefaultAsync();
+        if (entry is null)
+            return null;
+
+        entry.Used = true;
+        return new LoginResultDto(student.Id, student.FullName);
+    }
+
+    private static string Hash(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
