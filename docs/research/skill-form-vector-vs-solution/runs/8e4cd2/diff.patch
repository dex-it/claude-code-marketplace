@@ -0,0 +1,30 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record ProgressDto(int StudentId, double CompletedHours, int RequiredHours, double RemainingHours);
+
+// Прогресс ученика по часам вождения для приложения ученика.
+public class StudentProgressService
+{
+    private const int RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+
+    public StudentProgressService(SchoolDbContext db) => _db = db;
+
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AsNoTracking().AnyAsync(s => s.Id == studentId);
+        if (!exists)
+            return null;
+
+        var doneMinutes = await _db.Lessons.AsNoTracking()
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => (int?)l.Minutes) ?? 0;
+
+        var completedHours = Math.Round(doneMinutes / 60.0, 2);
+        var remainingHours = Math.Max(0, RequiredHours - completedHours);
+        return new ProgressDto(studentId, completedHours, RequiredHours, remainingHours);
+    }
+}
