diff --git a/Model.cs b/Model.cs
index cc90064..00a305c 100644
--- a/Model.cs
+++ b/Model.cs
@@ -14,6 +14,7 @@ public class Order
     public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
+    public int Complexity { get; set; }              // 1..5, сложность комплектации
     public List<OrderItem> Items { get; set; } = new();
     public List<Payment> Payments { get; set; } = new();
     public bool IsOverdue(DateTime now) => ShippedAt == null && CreatedAt.AddDays(3) < now;
@@ -44,7 +45,34 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        // Колонка остаётся "timestamp without time zone" (нельзя менять из-за отчётов DBA),
+        // но в CLR-коде значение всегда должно иметь Kind = Utc.
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                toDb => toDb.Kind == DateTimeKind.Utc ? toDb : toDb.ToUniversalTime(),
+                fromDb => DateTime.SpecifyKind(fromDb, DateTimeKind.Utc));
+
+        // Npgsql 8 хранит Complexity как integer; допустимый диапазон 1..5 закреплён CHECK-констрейнтом.
+        b.Entity<Order>().Property(o => o.Complexity).IsRequired();
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint(
+            "CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Order -> Items / Order -> Payments: обе коллекции - обязательные зависимые (FK OrderId не nullable).
+        // При Items.Clear()/Payments.Clear() на отслеживаемом Order EF физически удаляет осиротевшие строки,
+        // сам Order при этом не трогается (soft-delete через IsDeleted/HasQueryFilter выше).
+        b.Entity<Order>().HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .OnDelete(DeleteBehavior.Cascade)
+            .IsRequired();
+
+        b.Entity<Order>().HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .OnDelete(DeleteBehavior.Cascade)
+            .IsRequired();
     }
 }
 // Options: UseNpgsql(cs).UseLazyLoadingProxies()
diff --git a/OrderRepository.cs b/OrderRepository.cs
index 72637b8..bf4d306 100644
--- a/OrderRepository.cs
+++ b/OrderRepository.cs
@@ -6,4 +6,13 @@ public class OrderRepository
     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    public async Task ClearItemsAsync(Guid orderId)
+    {
+        var order = await _db.Orders.Include(o => o.Items).FirstOrDefaultAsync(o => o.Id == orderId);
+        if (order is null) return;
+
+        order.Items.Clear();
+        await _db.SaveChangesAsync();
+    }
 }
