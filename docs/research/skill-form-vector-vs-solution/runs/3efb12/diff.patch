+
+    public async Task<FreezeDto> FreezeAsync(int memberId, int days)
+    {
+        if (days is < 1 or > 365)
+            throw new ArgumentOutOfRangeException(nameof(days), "Срок заморозки — от 1 до 365 дней");
+
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        if (member.IsFrozenAt(now))
+            throw new InvalidOperationException("Абонемент уже заморожен");
+
+        member.FrozenFrom = now;
+        member.FrozenUntil = now.AddDays(days);
+        await _db.SaveChangesAsync();
+        return new FreezeDto(member.FrozenFrom.Value, member.FrozenUntil.Value);
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        if (!member.IsFrozenAt(now))
+            return;
+
+        member.FrozenUntil = now;
+        await _db.SaveChangesAsync();
+    }
+
+    // Случайное занятие опубликованного курса из ближайших 7 дней (для «тайного гостя»).
+    public async Task<QualitySessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var to = now.AddDays(7);
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.StartsAt >= now && s.StartsAt < to
+                && s.Course.Status == CourseStatus.Published)
+            .OrderBy(_ => EF.Functions.Random())
+            .Select(s => new
+            {
+                s.Id,
+                Course = s.Course.Title,
+                Trainer = s.Course.Trainer.FullName,
+                Hall = s.Hall.Name,
+                s.StartsAt,
+            })
+            .FirstOrDefaultAsync();
+
+        if (session is null)
+            return null;
+
+        var attendees = await _db.Enrollments
+            .AsNoTracking()
+            .Where(e => e.SessionId == session.Id && e.Status != EnrollmentStatus.Cancelled)
+            .OrderBy(e => e.Member.FullName)
+            .Select(e => e.Member.FullName)
+            .ToListAsync();
+
+        return new QualitySessionDto(session.Id, session.Course, session.Trainer, session.Hall,
+            session.StartsAt, attendees);
+    }
 }
