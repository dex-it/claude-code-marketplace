+namespace Shop.Data;
+
+public class ActiveOrderReportItem
+{
+    public Guid Id { get; set; }
+    public string CustomerName { get; set; } = "";
+    public decimal Total { get; set; }
+    public int ItemsCount { get; set; }
+}
+
+public class OverdueOrderReportItem
+{
+    public Guid Id { get; set; }
+    public string CustomerName { get; set; } = "";
+    public decimal Total { get; set; }
+    public DateTime CreatedAt { get; set; }
+}
+
+// Read-only reports built on top of OrderRepository.Query(); no entities are tracked or mutated here.
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public Task<List<ActiveOrderReportItem>> GetActiveOrdersAsync(CancellationToken ct = default) =>
+        _orders.Query()
+            .Where(o => o.Status == "active")
+            .Select(o => new ActiveOrderReportItem
+            {
+                Id = o.Id,
+                CustomerName = o.Customer.Name,
+                Total = o.Total,
+                ItemsCount = o.Items.Count
+            })
+            .ToListAsync(ct);
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync(CancellationToken ct = default) =>
+        _orders.Query()
+            .Where(o => o.Status == "active")
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count, ct);
+
+    // Mirrors Order.IsOverdue(now); kept inline because EF Core cannot translate a call to the instance method into SQL.
+    public Task<List<OverdueOrderReportItem>> GetOverdueOrdersAsync(DateTime now, CancellationToken ct = default) =>
+        _orders.Query()
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Select(o => new OverdueOrderReportItem
+            {
+                Id = o.Id,
+                CustomerName = o.Customer.Name,
+                Total = o.Total,
+                CreatedAt = o.CreatedAt
+            })
+            .ToListAsync(ct);
+}
