+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduateReportItem(int InstructorId, string InstructorName, bool InstructorDismissed, int GraduatesCount);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Отчёт для продления лицензии: выпускники за год по каждому инструктору,
+    // включая уже уволенных - для них глобальный фильтр по IsDeleted снимается явно,
+    // а принадлежность к автошколе проверяется вручную (фильтр по SchoolId снят вместе с остальными).
+    public async Task<List<GraduateReportItem>> GraduatesByInstructorAsync(int year)
+    {
+        var counts = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId != null
+                        && s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn != null
+                        && s.GraduatedOn.Value.Year == year)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.InstructorId, x => x.Count);
+
+        var instructors = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == _db.SchoolId)
+            .OrderBy(i => i.FullName)
+            .Select(i => new { i.Id, i.FullName, i.IsDeleted })
+            .ToListAsync();
+
+        return instructors
+            .Select(i => new GraduateReportItem(i.Id, i.FullName, i.IsDeleted, counts.GetValueOrDefault(i.Id)))
+            .ToList();
+    }
+}
