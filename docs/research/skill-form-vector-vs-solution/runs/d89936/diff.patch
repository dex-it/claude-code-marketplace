@@ -0,0 +1,76 @@
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResultDto(int StudentId, string FullName);
+
+// Вход ученика в мобильное приложение по одноразовому коду, отправленному на почту.
+public class AppAuthService
+{
+    private const int CodeLifetimeMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestCodeAsync(string email)
+    {
+        var student = await FindStudentAsync(email);
+        if (student is null)
+            return; // не подтверждаем и не опровергаем существование e-mail в базе
+
+        await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used)
+            .ExecuteUpdateAsync(s => s.SetProperty(c => c.Used, true));
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа",
+            $"Ваш код для входа: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<LoginResultDto?> ConfirmCodeAsync(string email, string code)
+    {
+        var student = await FindStudentAsync(email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var login = await _db.LoginCodes
+            .SingleOrDefaultAsync(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now);
+
+        if (login is null || !CryptographicOperations.FixedTimeEquals(
+                Encoding.UTF8.GetBytes(login.CodeHash),
+                Encoding.UTF8.GetBytes(Hash(code))))
+            return null;
+
+        login.Used = true;
+        return new LoginResultDto(student.Id, student.FullName);
+    }
+
+    // Ученик вводит e-mail как придётся (регистр клавиатуры телефона) - сравниваем без учёта регистра.
+    // SingleOrDefaultAsync: при коллизии регистронезависимого совпадения вход явно падает, а не выбирает карточку наугад.
+    private Task<Student?> FindStudentAsync(string email)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        return _db.Students.AsNoTracking().SingleOrDefaultAsync(s => s.Email.ToLower() == normalized);
+    }
+
+    private static string Hash(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
