+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(int Id, string FullName, string Email, string Phone, string PassportNo, DateTime? NextLessonAt);
+
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    // Список закреплённых учеников, которые сейчас учатся - маскировка та же, что и в выгрузке для инструкторов,
+    // плюс дата/время ближайшего незавершённого занятия (подзапрос с Min, без обхода в цикле).
+    public async Task<List<InstructorStudentDto>> GetStudentsAsync(int instructorId)
+    {
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var studentIds = students.Select(s => s.Id).ToList();
+        var now = DateTime.UtcNow;
+
+        var nextLessons = await _db.Lessons.AsNoTracking()
+            .Where(l => studentIds.Contains(l.StudentId) && !l.Done && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, Next = g.Min(x => x.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.Next);
+
+        return students
+            .Select(s => s.MaskForInstructor())
+            .Select(s => new InstructorStudentDto(
+                s.Id, s.FullName, s.Email, s.Phone, s.PassportNo,
+                nextLessons.TryGetValue(s.Id, out var next) ? next : null))
+            .ToList();
+    }
+}
