+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (а) +10% к цене всем продуктам категории — один SQL UPDATE, без загрузки entities
+    public Task<int> RaisePricesAsync(string category, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * 1.1m), ct);
+
+    // (б) ночная очистка AuditLogs старше года. Таблица ~50 млн строк, ~40 млн под удаление —
+    // одна транзакция на весь объём заблокирует таблицу и раздует WAL, поэтому удаляем батчами.
+    // Вызывающий (например, BackgroundService) должен резолвить CatalogMaintenance через
+    // IServiceScopeFactory на каждый запуск — сам этот сервис Scoped и держит ShopDbContext.
+    public async Task<long> CleanupOldAuditLogsAsync(
+        int batchSize = 1000,
+        TimeSpan? delayBetweenBatches = null,
+        CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow.AddYears(-1);
+        var delay = delayBetweenBatches ?? TimeSpan.FromMilliseconds(200);
+        long totalDeleted = 0;
+
+        while (!ct.IsCancellationRequested)
+        {
+            var deleted = await _db.AuditLogs
+                .Where(a => a.At < cutoff)
+                .OrderBy(a => a.Id)
+                .Take(batchSize)
+                .ExecuteDeleteAsync(ct);
+
+            totalDeleted += deleted;
+            if (deleted < batchSize) break;
+
+            await Task.Delay(delay, ct);
+        }
+
+        return totalDeleted;
+    }
+
+    // (в) увеличить Stock у набора продуктов и сохранить одним SaveChanges
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var deltas = items
+            .GroupBy(i => i.Id)
+            .ToDictionary(g => g.Key, g => g.Sum(i => i.Add));
+
+        var ids = deltas.Keys.ToList();
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToListAsync(ct);
+
+        foreach (var product in products)
+            product.Stock += deltas[product.Id];
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (г) создать продукт с client-generated Guid — Add(), не AddAsync (нет HiLo)
+    public async Task<Product> CreateProductAsync(
+        string sku,
+        string warehouse,
+        string category,
+        decimal price,
+        int stock,
+        CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Warehouse = warehouse,
+            Category = category,
+            Price = price,
+            Stock = stock
+        };
+
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
