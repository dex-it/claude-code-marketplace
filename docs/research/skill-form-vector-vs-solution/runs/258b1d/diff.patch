+
+    public async Task UnfreezeMemberAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<RandomSessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var weekLater = now.AddDays(7);
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .Where(s => s.StartsAt >= now && s.StartsAt <= weekLater)
+            .OrderBy(s => EF.Functions.Random())
+            .FirstOrDefaultAsync();
+
+        if (session is null)
+            return null;
+
+        var enrolledMembers = session.Enrollments
+            .Where(e => e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToList();
+
+        return new RandomSessionDto(
+            session.Id,
+            session.Course.Title,
+            session.Course.Trainer.FullName,
+            session.Hall.Name,
+            session.StartsAt,
+            enrolledMembers);
+    }
+
+    private bool IsMemberFrozen(Member member, DateTime sessionStartsAt)
+    {
+        return member.FrozenUntil.HasValue && member.FrozenUntil.Value > sessionStartsAt;
+    }
 }
