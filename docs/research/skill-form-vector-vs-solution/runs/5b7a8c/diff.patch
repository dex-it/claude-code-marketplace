+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearMonthReport(int Month, DateOnly? ActSignedOn, decimal Hours);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<YearMonthReport>> GetYearReportAsync(int year)
+    {
+        var closed = await _db.ClosedPeriods
+            .Where(cp => cp.Month.Year == year)
+            .AsNoTracking()
+            .ToDictionaryAsync(cp => cp.Month, cp => cp.ActSignedOn);
+
+        var entries = await _db.TimeEntries
+            .Where(te => te.WorkDate.Year == year)
+            .AsNoTracking()
+            .GroupBy(te => YearMonth.Of(te.WorkDate))
+            .Select(g => new { Month = g.Key, Hours = g.Sum(te => te.Hours) })
+            .ToListAsync();
+
+        var report = new List<YearMonthReport>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var ym = new YearMonth(year, month);
+            var hours = entries.FirstOrDefault(e => e.Month == ym)?.Hours ?? 0;
+            var signedOn = closed.TryGetValue(ym, out var date) ? date : null;
+            report.Add(new YearMonthReport(month, signedOn, hours));
+        }
+
+        return report;
+    }
+}
