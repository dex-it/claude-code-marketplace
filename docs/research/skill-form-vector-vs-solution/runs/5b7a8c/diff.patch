+using Microsoft.AspNetCore.Mvc;
+
+namespace Pixelwork.Timesheets.Controllers;
+
+[ApiController]
+[Route("clients/{clientId}/projects")]
+public class ProjectsController : ControllerBase
+{
+    private readonly ProjectService _projectService;
+
+    public ProjectsController(ProjectService projectService) => _projectService = projectService;
+
+    [HttpDelete]
+    public async Task<IActionResult> DeleteAllClientProjects(int clientId)
+    {
+        await _projectService.DeleteAllClientProjectsAsync(clientId);
+        return NoContent();
+    }
+}
