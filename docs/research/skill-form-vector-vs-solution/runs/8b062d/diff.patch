+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public class ClientService
+{
+    private readonly AgencyDbContext _db;
+
+    public ClientService(AgencyDbContext db) => _db = db;
+
+    // Массовое удаление всех проектов клиента (например, при расторжении договора).
+    // Возвращает null, если клиент не найден, иначе количество удалённых проектов.
+    // Удаление - мягкое (ISoftDeletable), как и при удалении проекта по одному.
+    public async Task<int?> DeleteAllProjectsAsync(int clientId)
+    {
+        if (!await _db.Clients.AnyAsync(c => c.Id == clientId))
+            return null;
+
+        var projects = await _db.Projects.Where(p => p.ClientId == clientId).ToListAsync();
+        _db.Projects.RemoveRange(projects);
+        await _db.SaveChangesAsync();
+        return projects.Count;
+    }
+}
