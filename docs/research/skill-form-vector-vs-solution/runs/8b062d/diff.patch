+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthSummary(int Month, bool IsClosed, DateOnly? ActSignedOn, decimal TotalHours);
+
+public record YearSummary(int Year, List<MonthSummary> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearSummary> GetYearSummaryAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+
+        // ClosedPeriods - маленький справочник (одна запись на месяц за всю историю),
+        // фильтруем по году в памяти, т.к. YearMonth хранится как сконвертированный int.
+        var signedOnByMonth = (await _db.ClosedPeriods.AsNoTracking().ToListAsync())
+            .Where(p => p.Month.Year == year)
+            .ToDictionary(p => p.Month.Month, p => p.ActSignedOn);
+
+        var hoursByMonth = await _db.TimeEntries
+            .Where(t => t.WorkDate >= from && t.WorkDate < to)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(x => x.Month, x => x.Hours);
+
+        var months = Enumerable.Range(1, 12)
+            .Select(m =>
+            {
+                var isClosed = signedOnByMonth.TryGetValue(m, out var signedOn);
+                return new MonthSummary(m, isClosed, isClosed ? signedOn : null, hoursByMonth.GetValueOrDefault(m));
+            })
+            .ToList();
+
+        return new YearSummary(year, months);
+    }
+}
