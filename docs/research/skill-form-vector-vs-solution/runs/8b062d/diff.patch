+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Pixelwork.Timesheets;
+
+public static class ReportEndpoints
+{
+    public static IEndpointRouteBuilder MapReportEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/reports/year/{year:int}", async (int year, ReportService svc) =>
+        {
+            var summary = await svc.GetYearSummaryAsync(year);
+            return Results.Ok(summary);
+        });
+
+        return app;
+    }
+}
+
+public static class ClientEndpoints
+{
+    public static IEndpointRouteBuilder MapClientEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapDelete("/clients/{id:int}/projects", async (int id, ClientService svc) =>
+        {
+            var deletedCount = await svc.DeleteAllProjectsAsync(id);
+            return deletedCount is null
+                ? Results.NotFound()
+                : Results.Ok(new { deletedCount });
+        });
+
+        return app;
+    }
+}
