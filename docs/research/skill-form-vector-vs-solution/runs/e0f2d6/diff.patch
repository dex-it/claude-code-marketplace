@@ -11,7 +11,8 @@ public class Order
     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
-    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
+    public int? Complexity { get; set; }             // сложность комплектации 1..5; null - исторические заказы до появления поля
+    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone; в коде всегда Kind=Utc
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
     public List<OrderItem> Items { get; set; } = new();
@@ -44,7 +45,33 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint("CK_Orders_Complexity", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Колонка остаётся timestamp without time zone и хранит UTC-время.
+        // Npgsql 6+ в такую колонку принимает только Kind=Unspecified (Utc бросает), читает Unspecified -
+        // поэтому на записи приводим к UTC и снимаем Kind, на чтении помечаем Utc.
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                v => DateTime.SpecifyKind(v.Kind == DateTimeKind.Local ? v.ToUniversalTime() : v, DateTimeKind.Unspecified),
+                v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
+        // Заказы удаляются мягко: каскада в БД нет, физическое удаление Order с зависимыми - ошибка FK.
+        // Позиции/платежи удаляет код явно (см. OrderRepository.ClearItems).
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Restrict);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Restrict);
     }
 }
