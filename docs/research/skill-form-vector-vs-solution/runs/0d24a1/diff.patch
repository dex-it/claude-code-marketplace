+using Microsoft.AspNetCore.Mvc;
+
+namespace Pixelwork.Timesheets;
+
+[ApiController]
+[Route("api")]
+public class TimesheetsController : ControllerBase
+{
+    private readonly ReportService _reportService;
+    private readonly ProjectService _projectService;
+
+    public TimesheetsController(ReportService reportService, ProjectService projectService)
+    {
+        _reportService = reportService;
+        _projectService = projectService;
+    }
+
+    [HttpGet("reports/year/{year}")]
+    public async Task<ActionResult<YearSummary>> GetYearReport(int year)
+    {
+        try
+        {
+            var summary = await _reportService.GetYearSummaryAsync(year);
+            return Ok(summary);
+        }
+        catch (Exception ex)
+        {
+            return BadRequest(ex.Message);
+        }
+    }
+
+    [HttpDelete("clients/{id}/projects")]
+    public async Task<ActionResult> DeleteClientProjects(int id)
+    {
+        try
+        {
+            await _projectService.DeleteProjectsByClientAsync(id);
+            return Ok();
+        }
+        catch (Exception ex)
+        {
+            return BadRequest(ex.Message);
+        }
+    }
+}
