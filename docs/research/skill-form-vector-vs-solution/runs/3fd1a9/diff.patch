+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    private readonly IEmailSender _emailSender;
+    private readonly ShopDbContext _db;
+
+    public CustomerNotifier(IEmailSender emailSender, ShopDbContext db)
+    {
+        _emailSender = emailSender;
+        _db = db;
+    }
+
+    public async Task NotifyCustomers(IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        var uniqueIds = new HashSet<Guid>(customerIds);
+        if (uniqueIds.Count == 0)
+            return;
+
+        // Batching для больших списков (SKILL: Contains ограничен ~2100 параметров)
+        foreach (var batch in uniqueIds.Chunk(500))
+        {
+            var customers = await _db.Customers
+                .Where(c => batch.Contains(c.Id))
+                .Select(c => new { c.Email, c.Name })
+                .ToListAsync(ct);
+
+            foreach (var customer in customers)
+            {
+                await _emailSender.SendAsync(customer.Email, "Notification", text, ct);
+            }
+        }
+    }
+}
