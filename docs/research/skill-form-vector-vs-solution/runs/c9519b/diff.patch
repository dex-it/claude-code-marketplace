+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (а) Карточка одного заказа по Id со всеми позициями и платежами
+    public async Task<OrderCardDto?> GetOrderCardAsync(Guid orderId)
+    {
+        return await _db.Orders
+            .AsNoTracking()
+            .Where(o => o.Id == orderId)
+            .Select(o => new OrderCardDto
+            {
+                Id = o.Id,
+                CustomerId = o.CustomerId,
+                Status = o.Status,
+                Category = o.Category,
+                Total = o.Total,
+                CreatedAt = o.CreatedAt,
+                ShippedAt = o.ShippedAt,
+                Items = o.Items.Select(i => new OrderItemDto
+                {
+                    Id = i.Id,
+                    ProductId = i.ProductId,
+                    Qty = i.Qty
+                }).ToList(),
+                Payments = o.Payments.Select(p => new PaymentDto
+                {
+                    Id = p.Id,
+                    Amount = p.Amount
+                }).ToList()
+            })
+            .FirstOrDefaultAsync();
+    }
+
+    // (б) Выгрузка всех заказов клиента с позициями и платежами (для тысяч заказов)
+    public async Task<List<OrderCardDto>> GetCustomerOrdersAsync(Guid customerId)
+    {
+        return await _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId)
+            .OrderByDescending(o => o.CreatedAt)
+            .Select(o => new OrderCardDto
+            {
+                Id = o.Id,
+                CustomerId = o.CustomerId,
+                Status = o.Status,
+                Category = o.Category,
+                Total = o.Total,
+                CreatedAt = o.CreatedAt,
+                ShippedAt = o.ShippedAt,
+                Items = o.Items.Select(i => new OrderItemDto
+                {
+                    Id = i.Id,
+                    ProductId = i.ProductId,
+                    Qty = i.Qty
+                }).ToList(),
+                Payments = o.Payments.Select(p => new PaymentDto
+                {
+                    Id = p.Id,
+                    Amount = p.Amount
+                }).ToList()
+            })
+            .AsSplitQuery()
+            .ToListAsync();
+    }
+
+    // (в) Получить продукт по SKU на складе (warehouse может быть null)
+    public async Task<Product?> GetProductBySkuAsync(string sku, string? warehouse = null)
+    {
+        var query = _db.Products
+            .AsNoTracking()
+            .Where(p => p.Sku == sku);
+
+        if (!string.IsNullOrEmpty(warehouse))
+            query = query.Where(p => p.Warehouse == warehouse);
+
+        return await query.FirstOrDefaultAsync();
+    }
+
+    // (г) Дата отгрузки последнего отгруженного заказа клиента (DateTime, не nullable)
+    public async Task<DateTime> GetLastShippedDateAsync(Guid customerId)
+    {
+        var date = await _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .Select(o => o.ShippedAt)
+            .OrderByDescending(o => o)
+            .FirstOrDefaultAsync();
+
+        return date ?? DateTime.MinValue;
+    }
+}
+
+public class OrderCardDto
+{
+    public Guid Id { get; set; }
+    public Guid CustomerId { get; set; }
+    public string Status { get; set; } = "";
+    public string Category { get; set; } = "";
+    public decimal Total { get; set; }
+    public DateTime CreatedAt { get; set; }
+    public DateTime? ShippedAt { get; set; }
+    public List<OrderItemDto> Items { get; set; } = new();
+    public List<PaymentDto> Payments { get; set; } = new();
+}
+
+public class OrderItemDto
+{
+    public int Id { get; set; }
+    public Guid ProductId { get; set; }
+    public int Qty { get; set; }
+}
+
+public class PaymentDto
+{
+    public int Id { get; set; }
+    public decimal Amount { get; set; }
+}
