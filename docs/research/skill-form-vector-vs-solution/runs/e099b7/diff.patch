+    // Список должников филиала для обзвона.
+    public async Task<DebtorsResponse> GetDebtorsAsync(int branchId)
+    {
+        var branch = await _db.Branches.FindAsync(branchId)
+            ?? throw new InvalidOperationException("Филиал не найден");
+
+        var today = LocalToday(branch);
+
+        var loans = await _db.Loans
+            .Where(l => l.BranchId == branchId && l.ReturnedAt == null)
+            .Include(l => l.Reader)
+            .Include(l => l.Book)
+            .AsNoTracking()
+            .ToListAsync();
+
+        var debtors = loans
+            .Select(l => new DebtorRow
+            {
+                LoanId = l.Id,
+                CardNumber = l.Reader.CardNumber,
+                Reader = l.Reader.FullName,
+                Phone = l.Reader.Phone,
+                Book = l.Book.Title,
+                DueDate = l.DueDate,
+                DaysOverdue = Fines.DaysOverdue(l.DueDate, today),
+                Fine = Fines.Amount(l.DueDate, today, l.Reader.Category, _rules),
+            })
+            .Where(r => r.DaysOverdue > 0)
+            .OrderByDescending(r => r.Fine)
+            .ToList();
+
+        return new DebtorsResponse
+        {
+            Debtors = debtors,
+            TotalFine = debtors.Sum(d => d.Fine)
+        };
+    }
+
+    // Отчёт: число выдач по каждому филиалу за период.
+    public async Task<LoansReport> GetLoansReportAsync(LoansReportRequest request)
+    {
+        var items = await _db.Loans
+            .Where(l => l.IssuedAt >= request.From && l.IssuedAt <= request.To)
+            .GroupBy(l => new { l.BranchId, l.Branch.Name })
+            .Select(g => new LoansReportItem
+            {
+                BranchId = g.Key.BranchId,
+                BranchName = g.Key.Name,
+                Count = g.Count()
+            })
+            .OrderBy(x => x.BranchId)
+            .AsNoTracking()
+            .ToListAsync();
+
+        return new LoansReport { Items = items };
+    }
