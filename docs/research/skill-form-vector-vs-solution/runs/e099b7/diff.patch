+namespace BookQuarter.Library;
+
+public sealed class DebtorRow
+{
+    public int LoanId { get; init; }
+    public string CardNumber { get; init; } = "";
+    public string Reader { get; init; } = "";
+    public string Phone { get; init; } = "";
+    public string Book { get; init; } = "";
+    public DateOnly DueDate { get; init; }
+    public int DaysOverdue { get; init; }
+    public decimal Fine { get; init; }
+}
+
+public sealed class DebtorsResponse
+{
+    public List<DebtorRow> Debtors { get; set; } = new();
+    public decimal TotalFine { get; set; }
+}
+
+public static class DebtorRows
+{
+    public static IQueryable<DebtorRow> ToDebtorRows(this IQueryable<Loan> loans, DateOnly today, FineRules rules) =>
+        loans.Select(l => new DebtorRow
+        {
+            LoanId = l.Id,
+            CardNumber = l.Reader.CardNumber,
+            Reader = l.Reader.FullName,
+            Phone = l.Reader.Phone,
+            Book = l.Book.Title,
+            DueDate = l.DueDate,
+            DaysOverdue = Fines.DaysOverdue(l.DueDate, today),
+            Fine = Fines.Amount(l.DueDate, today, l.Reader.Category, rules),
+        });
+}
