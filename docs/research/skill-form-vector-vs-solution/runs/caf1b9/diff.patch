+    public async Task UpdatePlanAsync(int houseId, List<NewPlanItem> newItems)
+    {
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+            await _db.SaveChangesAsync();
+        }
+
+        var newWorkCodes = newItems.Select(i => i.WorkCode).ToHashSet();
+        var currentItems = plan.Items.ToDictionary(i => i.WorkCode);
+
+        var toRemove = plan.Items.Where(i => !newWorkCodes.Contains(i.WorkCode)).ToList();
+        foreach (var item in toRemove)
+            plan.Items.Remove(item);
+
+        foreach (var newItem in newItems)
+        {
+            if (currentItems.TryGetValue(newItem.WorkCode, out var existing))
+            {
+                existing.Title = newItem.Title;
+                existing.PeriodDays = newItem.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
 }
