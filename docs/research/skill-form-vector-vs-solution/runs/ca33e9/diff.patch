+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesRow(int? InstructorId, string Instructor, bool Dismissed, DateOnly? DismissedOn, int Graduates);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Выпускники за год (по дате выпуска) по инструкторам, включая уволенных.
+    public async Task<List<GraduatesRow>> GraduatesByInstructorAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated && s.GraduatedOn >= from && s.GraduatedOn < to)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var ids = counts.Where(c => c.InstructorId != null).Select(c => c.InstructorId!.Value).ToList();
+
+        // Уволенные скрыты глобальным фильтром. IgnoreQueryFilters снимает и фильтр по автошколе,
+        // поэтому возвращаем его явно.
+        var instructors = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == _db.SchoolId && ids.Contains(i.Id))
+            .ToDictionaryAsync(i => i.Id);
+
+        return counts
+            .Select(c =>
+            {
+                if (c.InstructorId is not int id)
+                    return new GraduatesRow(null, "Без инструктора", false, null, c.Count);
+                instructors.TryGetValue(id, out var i);
+                return new GraduatesRow(id, i?.FullName ?? $"Инструктор #{id}",
+                    i?.IsDeleted ?? false, i?.DismissedOn, c.Count);
+            })
+            .OrderBy(r => r.InstructorId is null)
+            .ThenBy(r => r.Instructor)
+            .ToList();
+    }
+}
