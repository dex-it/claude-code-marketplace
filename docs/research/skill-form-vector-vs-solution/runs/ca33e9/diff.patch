+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResult(int StudentId, string Token, DateTime ExpiresAt);
+
+// Вход ученика в мобильное приложение по одноразовому коду из письма.
+public class AppLoginService
+{
+    private static readonly TimeSpan CodeLifetime = TimeSpan.FromMinutes(10);
+    private static readonly TimeSpan ResendInterval = TimeSpan.FromMinutes(1);
+    private static readonly TimeSpan SessionLifetime = TimeSpan.FromDays(30);
+    private const int MaxAttempts = 5;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppLoginService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Ответ вызывающему всегда одинаковый: не раскрываем, есть ли ученик с таким e-mail.
+    public async Task RequestCodeAsync(string? email)
+    {
+        var student = await FindStudentAsync(email);
+        if (student is null) return;
+
+        var now = DateTime.UtcNow;
+        var active = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now)
+            .ToListAsync();
+        if (active.Any(c => c.CreatedAt > now - ResendInterval)) return;
+        foreach (var c in active) c.Used = true; // действует только последний код
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = HashCode(student.Id, code),
+            CreatedAt = now,
+            ExpiresAt = now + CodeLifetime,
+        });
+        // Код должен оказаться в базе до отправки письма, иначе ученик получит неработающий код.
+        await _db.SaveChangesAsync();
+
+        await _email.SendAsync(student.Email, "Код входа в приложение автошколы",
+            $"Ваш код: {code}. Код действует 10 минут.");
+    }
+
+    public async Task<LoginResult?> ConfirmAsync(string? email, string? code)
+    {
+        var student = await FindStudentAsync(email);
+        if (student is null) return null;
+
+        var now = DateTime.UtcNow;
+        var login = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now)
+            .OrderByDescending(c => c.CreatedAt)
+            .FirstOrDefaultAsync();
+        if (login is null) return null;
+
+        // Попытка учитывается и при неверном коде: SaveChangesFilter сохранит счётчик.
+        login.Attempts++;
+        var ok = CryptographicOperations.FixedTimeEquals(
+            Convert.FromHexString(login.CodeHash),
+            Convert.FromHexString(HashCode(student.Id, (code ?? "").Trim())));
+        if (!ok)
+        {
+            if (login.Attempts >= MaxAttempts) login.Used = true;
+            return null;
+        }
+
+        login.Used = true;
+        var token = Convert.ToHexString(RandomNumberGenerator.GetBytes(32));
+        var expiresAt = now + SessionLifetime;
+        _db.AppSessions.Add(new AppSession
+        {
+            StudentId = student.Id,
+            TokenHash = HashToken(token),
+            ExpiresAt = expiresAt,
+        });
+        return new LoginResult(student.Id, token, expiresAt);
+    }
+
+    // Ученик по токену из Authorization: Bearer ...; null, если токен неизвестен или истёк.
+    public async Task<int?> GetStudentIdAsync(string? token)
+    {
+        if (string.IsNullOrWhiteSpace(token)) return null;
+        var hash = HashToken(token.Trim());
+        var now = DateTime.UtcNow;
+        return await _db.AppSessions
+            .Where(x => x.TokenHash == hash && x.ExpiresAt > now)
+            .Select(x => (int?)x.StudentId)
+            .FirstOrDefaultAsync();
+    }
+
+    // В карточках e-mail хранится как ввёл администратор, ученик вводит как подставила клавиатура:
+    // сравниваем без учёта регистра. Если совпало несколько карточек - вход не выполняем.
+    private async Task<Student?> FindStudentAsync(string? email)
+    {
+        var normalized = (email ?? "").Trim().ToLowerInvariant();
+        if (normalized.Length == 0) return null;
+
+        var matches = await _db.Students
+            .Where(s => s.Email.ToLower() == normalized && s.Status != StudentStatus.Expelled)
+            .Take(2)
+            .ToListAsync();
+        return matches.Count == 1 ? matches[0] : null;
+    }
+
+    private static string HashCode(int studentId, string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes($"{studentId}:{code}")));
+
+    private static string HashToken(string token) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(token)));
+}
