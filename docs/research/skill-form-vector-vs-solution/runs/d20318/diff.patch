@@ -0,0 +1,31 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+public sealed record BranchLoansCount(int BranchId, string BranchName, int Count);
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // Отчёт методиста: число выдач по каждому филиалу за период.
+    // Границы периода приходят как абсолютный момент времени (DateTimeOffset), поэтому
+    // пояс, в котором фронт их записал, не важен — сравнение идёт с IssuedAt (UTC).
+    // "to" не включается в период (полуоткрытый интервал), чтобы не задваивать выдачи на границе.
+    public async Task<List<BranchLoansCount>> LoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var branches = await _db.Branches.OrderBy(b => b.Name).ToListAsync();
+
+        return branches
+            .Select(b => new BranchLoansCount(b.Id, b.Name, counts.FirstOrDefault(c => c.BranchId == b.Id)?.Count ?? 0))
+            .ToList();
+    }
+}
