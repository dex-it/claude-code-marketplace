+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentView(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+// Список закреплённых учеников для приложения инструктора.
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorStudentView>> GetAssignedStudentsAsync(int instructorId)
+    {
+        var now = DateTime.UtcNow;
+
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .Select(s => new InstructorStudentView(
+                s.Id, s.FullName, s.Phone, s.Email, s.PassportNo,
+                _db.Lessons
+                    .Where(l => l.StudentId == s.Id && l.StartsAt >= now)
+                    .OrderBy(l => l.StartsAt)
+                    .Select(l => (DateTime?)l.StartsAt)
+                    .FirstOrDefault()))
+            .ToListAsync();
+
+        // Маскирование - то же представление, что и в выгрузке для инструкторов (паспорт и почта скрыты).
+        return students
+            .Select(s => s with { Email = Masking.MaskEmail(s.Email), PassportNo = Masking.MaskPassport(s.PassportNo) })
+            .ToList();
+    }
+}
