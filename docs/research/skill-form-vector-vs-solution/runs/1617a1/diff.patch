+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorGraduatesReportItem(int InstructorId, string InstructorFullName, bool IsDismissed, int Graduates);
+
+// Отчёт для продления лицензии автошколы.
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorGraduatesReportItem>> GetGraduatesReportAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var toExclusive = new DateOnly(year + 1, 1, 1);
+        var schoolId = _db.SchoolId;
+
+        // IgnoreQueryFilters нужен, чтобы попали и уволенные инструкторы (их исключает глобальный фильтр
+        // !i.IsDeleted); фильтр по школе восстанавливаем вручную, иначе уйдёт межшкольная выборка.
+        return await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => i.SchoolId == schoolId)
+            .Select(i => new InstructorGraduatesReportItem(
+                i.Id,
+                i.FullName,
+                i.IsDeleted,
+                _db.Students.Count(s => s.InstructorId == i.Id
+                                         && s.Status == StudentStatus.Graduated
+                                         && s.GraduatedOn >= from
+                                         && s.GraduatedOn < toExclusive)))
+            .OrderBy(x => x.InstructorFullName)
+            .ToListAsync();
+    }
+}
