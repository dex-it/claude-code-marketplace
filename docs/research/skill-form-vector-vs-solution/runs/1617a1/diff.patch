+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record ProgressDto(int StudentId, double HoursDone, int HoursRequired);
+
+// Вход ученика в мобильное приложение по одноразовому коду и его прогресс по часам вождения.
+public class AppService
+{
+    private const int RequiredHours = 56;
+    private const int CodeLifetimeMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestLoginCodeAsync(string email)
+    {
+        var student = await FindByEmailCaseInsensitiveAsync(email);
+        if (student is null)
+            return; // не раскрываем, зарегистрирован ли такой e-mail
+
+        var code = GenerateCode();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            CreatedAt = DateTime.UtcNow,
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа",
+            $"Ваш код для входа: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<int?> ConfirmLoginCodeAsync(string email, string code)
+    {
+        var student = await FindByEmailCaseInsensitiveAsync(email);
+        if (student is null)
+            return null;
+
+        var trimmedCode = code.Trim();
+        var now = DateTime.UtcNow;
+
+        var loginCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id
+                        && c.Code == trimmedCode
+                        && c.ConsumedAt == null
+                        && c.ExpiresAt > now)
+            .OrderByDescending(c => c.CreatedAt)
+            .FirstOrDefaultAsync();
+
+        if (loginCode is null)
+            return null;
+
+        loginCode.ConsumedAt = now;
+        return student.Id;
+    }
+
+    public async Task<ProgressDto> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AnyAsync(s => s.Id == studentId);
+        if (!exists)
+            throw new KeyNotFoundException();
+
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(studentId, minutesDone / 60.0, RequiredHours);
+    }
+
+    // E-mail вводится на телефоне как придётся (регистр клавиатуры), поэтому сверяем без учёта регистра.
+    // Уникальность по (SchoolId, Email) в БД регистрозависимая, поэтому Single здесь не гарантирован - берём детерминированно первую запись.
+    private async Task<Student?> FindByEmailCaseInsensitiveAsync(string email)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        return await _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == normalized)
+            .OrderBy(s => s.Id)
+            .FirstOrDefaultAsync();
+    }
+
+    private static string GenerateCode() => RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+}
