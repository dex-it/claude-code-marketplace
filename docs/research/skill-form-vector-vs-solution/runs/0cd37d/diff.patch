+    // (а) Запрос кода подтверждения для входа
+    public async Task RequestLoginCodeAsync(string email)
+    {
+        var normalizedEmail = email.ToLower().Trim();
+        var student = await _db.Students
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail);
+
+        if (student is null)
+            throw new KeyNotFoundException();
+
+        var code = GenerateCode();
+        var loginCode = new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            ExpiresAt = DateTime.UtcNow.AddMinutes(10),
+            IsUsed = false
+        };
+        _db.LoginCodes.Add(loginCode);
+        await _emailSender.SendAsync(student.Email, "Ваш код входа", $"Ваш код входа: {code}");
+    }
+
+    // (а) Подтверждение кода и вход
+    public async Task<int> ConfirmLoginCodeAsync(string email, string code)
+    {
+        var normalizedEmail = email.ToLower().Trim();
+        var student = await _db.Students
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail);
+
+        if (student is null)
+            throw new KeyNotFoundException();
+
+        var loginCode = await _db.LoginCodes
+            .FirstOrDefaultAsync(c => c.StudentId == student.Id && c.Code == code && !c.IsUsed);
+
+        if (loginCode is null || loginCode.ExpiresAt < DateTime.UtcNow)
+            throw new InvalidOperationException("Неверный или истёкший код");
+
+        loginCode.IsUsed = true;
+        return student.Id;
+    }
+
+    // (б) Отчёт по выпускникам за год
+    public async Task<List<GraduateReportDto>> GetGraduatesByYearAsync(int year)
+    {
+        var startDate = new DateOnly(year, 1, 1);
+        var endDate = new DateOnly(year, 12, 31);
+
+        var report = await _db.Students
+            .IgnoreQueryFilters()
+            .Where(s => s.SchoolId == _db.SchoolId && s.Status == StudentStatus.Graduated && s.GraduatedOn >= startDate && s.GraduatedOn <= endDate)
+            .Include(s => s.Instructor)
+            .AsNoTracking()
+            .ToListAsync();
+
+        return report
+            .GroupBy(s => s.Instructor)
+            .Select(g => new GraduateReportDto(g.Key?.FullName ?? "Без инструктора", g.Count()))
+            .OrderBy(x => x.InstructorName)
+            .ToList();
+    }
+
+    // (в) Список учеников инструктора с ближайшим занятием
+    public async Task<List<InstructorStudentDto>> GetInstructorStudentsAsync(int instructorId)
+    {
+        var now = DateTime.UtcNow;
+
+        var students = await _db.Students
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .AsNoTracking()
+            .ToListAsync();
+
+        var result = new List<InstructorStudentDto>();
+        foreach (var s in students)
+        {
+            var nextLesson = await _db.Lessons
+                .Where(l => l.StudentId == s.Id && l.StartsAt > now)
+                .OrderBy(l => l.StartsAt)
+                .FirstOrDefaultAsync();
+
+            var masked = new Student { PassportNo = s.PassportNo, Email = s.Email }.MaskForInstructor();
+            result.Add(new InstructorStudentDto(
+                s.Id,
+                s.FullName,
+                s.Phone,
+                masked.Email,
+                masked.PassportNo,
+                nextLesson?.StartsAt
+            ));
+        }
+
+        return result;
+    }
+
+    // (г) Прогресс ученика: часы вождения
+    public async Task<ProgressDto> GetProgressAsync(int studentId)
+    {
+        var completedMinutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        var completedHours = completedMinutes / 60;
+        const int totalHours = 56;
+
+        return new ProgressDto(completedHours, totalHours);
+    }
+
+    private static string GenerateCode() => Random.Shared.Next(100000, 999999).ToString();
