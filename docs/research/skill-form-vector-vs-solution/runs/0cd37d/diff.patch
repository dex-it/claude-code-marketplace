+// (а) Вход по одноразовому коду
+var appApi = api.MapGroup("/app");
+appApi.MapPost("/login/request", async (LoginCodeRequest req, StudentService s) =>
+{
+    try
+    {
+        await s.RequestLoginCodeAsync(req.Email);
+        return Results.Ok();
+    }
+    catch (KeyNotFoundException)
+    {
+        return Results.NotFound();
+    }
+});
+
+appApi.MapPost("/login/confirm", async (LoginConfirmRequest req, StudentService s) =>
+{
+    try
+    {
+        var studentId = await s.ConfirmLoginCodeAsync(req.Email, req.Code);
+        return Results.Ok(new { studentId });
+    }
+    catch
+    {
+        return Results.BadRequest();
+    }
+});
+
+// (г) Прогресс ученика
+appApi.MapGet("/progress", async (int studentId, StudentService s) =>
+{
+    var progress = await s.GetProgressAsync(studentId);
+    return Results.Ok(progress);
+});
+
 // Файлы для печати отдаются отдельно от API.
 app.MapGet("/exports/instructors/{id:int}/students.csv", async (int id, StudentService s) =>
     Results.Text(await s.ExportForInstructorCsvAsync(id), "text/csv"));
 
+// (б) Отчёт по выпускникам
+var reports = api.MapGroup("/reports");
+reports.MapGet("/graduates", async (int year, StudentService s) =>
+{
+    var graduates = await s.GetGraduatesByYearAsync(year);
+    return Results.Ok(graduates);
+});
+
+// (в) Список учеников инструктора
+var instructor = api.MapGroup("/instructor");
+instructor.MapGet("/students", async (HttpContext ctx, StudentService s) =>
+{
+    var instructorIdHeader = ctx.Request.Headers["X-Instructor-Id"].ToString();
+    if (!int.TryParse(instructorIdHeader, out var instructorId))
+        return Results.BadRequest("Отсутствует заголовок X-Instructor-Id");
+
+    var students = await s.GetInstructorStudentsAsync(instructorId);
+    return Results.Ok(students);
+});
+
 app.Run();
 
