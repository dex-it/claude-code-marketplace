+namespace Domovoy.Housing;
+
+public record AddApartmentRequest(string Number, string AccountNumber);
+
+public static class HousingEndpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // GET /requests?q=&status=&page=&pageSize=&sort=id|created_at|address|status|category&dir=asc|desc
+        app.MapGet("/requests", async (HousingService svc, string? q, RequestStatus? status,
+            int? page, int? pageSize, string? sort, string? dir) =>
+        {
+            try
+            {
+                return Results.Ok(await svc.SearchAsync(
+                    new RequestSearch(q, status, page ?? 1, pageSize ?? 50, sort, dir)));
+            }
+            catch (ArgumentException e)
+            {
+                return Results.BadRequest(new { error = e.Message });
+            }
+        });
+
+        app.MapPost("/houses/{id:int}/apartments", async (int id, AddApartmentRequest body, HousingService svc) =>
+        {
+            try
+            {
+                var apartmentId = await svc.AddApartmentAsync(id, body.Number, body.AccountNumber);
+                return Results.Created($"/apartments/{apartmentId}", new { id = apartmentId });
+            }
+            catch (DuplicateAccountException e)
+            {
+                return Results.Conflict(new { error = e.Message });
+            }
+        });
+
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.Ok(await svc.GetPlanAsync(id));
+            }
+            catch (KeyNotFoundException e)
+            {
+                return Results.NotFound(new { error = e.Message });
+            }
+            catch (ArgumentException e)
+            {
+                return Results.BadRequest(new { error = e.Message });
+            }
+        });
+
+        return app;
+    }
+}
