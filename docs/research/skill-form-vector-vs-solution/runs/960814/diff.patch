+namespace Notify.Api.Services;
+
+public interface IReportService
+{
+    Task SendAsync(Guid reportId, string email, CancellationToken ct = default);
+}
+
+public sealed class ReportService : IReportService
+{
+    private readonly INotificationSender _sender;
+    public ReportService([FromKeyedServices(NotificationChannels.Email)] INotificationSender sender) => _sender = sender;
+
+    public Task SendAsync(Guid reportId, string email, CancellationToken ct = default)
+        => _sender.SendAsync(email, $"Отчёт {reportId}", ct);
+}
