+namespace Notify.Api.Services;
+
+public sealed class SmsSender : INotificationSender
+{
+    private readonly ILogger<SmsSender> _log;
+    public SmsSender(ILogger<SmsSender> log) => _log = log;
+
+    public Task SendAsync(string recipient, string text, CancellationToken ct = default)
+    {
+        _log.LogInformation("sms to {Recipient}", recipient);
+        return Task.CompletedTask;
+    }
+}
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..a570ceb
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,15 @@
+**Созданы:**
+- `Services/NotificationChannels.cs` — константы ключей `Email` / `Sms`
+- `Services/SmsSender.cs` — `SmsSender : INotificationSender`, пока пишет в лог
+- `Services/ReportService.cs` — `IReportService` / `ReportService`, получает email-отправителя по ключу
+- `Controllers/ReportsController.cs` — `POST /reports/{id:guid}/send?email=...`
+
+**Изменены:**
+- `Program.cs` — `AddKeyedSingleton` для обоих отправителей; сервисы регистрируются как интерфейс → реализация
+- `Services/OrderService.cs` — добавлен `IOrderService`, в конструкторе `[FromKeyedServices(NotificationChannels.Sms)]`
+- `Controllers/OrdersController.cs` — зависит от `IOrderService`, query-параметр `email` → `phone`
+
+**Решения:**
+- Ключи вынесены в константы `NotificationChannels`. Обычная (без ключа) регистрация `INotificationSender` убрана, так что по умолчанию никакой канал не подставится незаметно. Отправители — Singleton: у них нет состояния и есть только `ILogger`. `OrderService` и `ReportService` — Scoped.
+- **Ломающее изменение API:** `/orders/{id}/confirm` теперь принимает `?phone=` вместо `?email=`, потому что SMS на email-адрес не отправить. Клиентов, которые вызывают этот эндпоинт, нужно обновить.
+- Сборку и тесты не запускал.
