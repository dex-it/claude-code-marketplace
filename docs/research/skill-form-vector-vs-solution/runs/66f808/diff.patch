@@ -44,7 +47,31 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        // Колонка остаётся timestamp without time zone (её смотрят отчёты DBA);
+        // конвертер снимает Kind при записи и помечает Utc при чтении, чтобы в коде всегда был UTC.
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(new ValueConverter<DateTime, DateTime>(
+                v => DateTime.SpecifyKind(v, DateTimeKind.Unspecified),
+                v => DateTime.SpecifyKind(v, DateTimeKind.Utc)));
+
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint(
+            "CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // FK без каскада в БД: Order помечается IsDeleted, а не удаляется,
