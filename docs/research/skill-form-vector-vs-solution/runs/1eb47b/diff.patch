+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResult(int StudentId, string FullName);
+
+// Вход ученика в мобильное приложение по одноразовому коду, присланному на почту.
+public class AppLoginService
+{
+    private const int CodeTtlMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppLoginService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestCodeAsync(string email)
+    {
+        var normalized = Normalize(email);
+        var student = await _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == normalized);
+        if (student is null)
+            return; // не подтверждаем ни существование, ни отсутствие ученика с таким e-mail
+
+        var code = GenerateCode();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeTtlMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа", $"Ваш код для входа: {code}. Он действует 10 минут.");
+    }
+
+    public async Task<LoginResult?> ConfirmCodeAsync(string email, string code)
+    {
+        var normalized = Normalize(email);
+        var student = await _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == normalized);
+        if (student is null)
+            return null;
+
+        var hash = Hash(code.Trim());
+        var now = DateTime.UtcNow;
+        var login = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now && c.CodeHash == hash)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+        if (login is null)
+            return null;
+
+        login.Used = true;
+        return new LoginResult(student.Id, student.FullName);
+    }
+
+    // Почта из телефонной клавиатуры может прийти с пробелами и в любом регистре.
+    private static string Normalize(string email) => email.Trim().ToLowerInvariant();
+
+    private static string GenerateCode() => RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+
+    private static string Hash(string code) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
