@@ -80,4 +85,88 @@ public class StudentService
 
     private static StudentDto ToDto(Student s) =>
         new(s.Id, s.FullName, s.Email, s.Phone, s.Status, s.Instructor?.FullName);
+
+    public async Task RequestLoginCodeAsync(LoginRequestDto req, IEmailSender emailSender)
+    {
+        var email = req.Email.Trim();
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == email.ToLower())
+            ?? throw new KeyNotFoundException("Ученик не найден");
+
+        var code = new Random().Next(100000, 1000000).ToString();
+        var emailLower = email.ToLower();
+        var existing = await _db.LoginTokens.FirstOrDefaultAsync(t => t.Email == emailLower);
+        if (existing != null)
+            _db.LoginTokens.Remove(existing);
+
+        var token = new LoginToken { Email = emailLower, Code = code, ExpiresAt = DateTime.UtcNow.AddMinutes(10) };
+        _db.LoginTokens.Add(token);
+        await _db.SaveChangesAsync();
+
+        await emailSender.SendAsync(student.Email, "Код входа", $"Ваш код: {code}");
+    }
+
+    public async Task<bool> ConfirmLoginCodeAsync(LoginConfirmDto req)
+    {
+        var email = req.Email.Trim().ToLower();
+        var token = await _db.LoginTokens.FirstOrDefaultAsync(t => t.Email == email && t.Code == req.Code)
+            ?? throw new KeyNotFoundException("Неверный код");
+
+        if (token.ExpiresAt < DateTime.UtcNow)
+            throw new InvalidOperationException("Код истёк");
+
+        _db.LoginTokens.Remove(token);
+        return true;
+    }
+
+    public async Task<List<StudentForInstructorDto>> GetStudentsForInstructorAsync(int instructorId)
+    {
+        var students = await _db.Students
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var result = new List<StudentForInstructorDto>();
+        foreach (var student in students.Select(x => x.MaskForInstructor()))
+        {
+            var nextLesson = await _db.Lessons
+                .Where(l => l.StudentId == student.Id && l.StartsAt > DateTime.UtcNow)
+                .OrderBy(l => l.StartsAt)
+                .FirstOrDefaultAsync();
+
+            result.Add(new StudentForInstructorDto(student.Id, student.FullName, student.Phone, student.PassportNo, nextLesson?.StartsAt));
+        }
+
+        return result;
+    }
+
+    public async Task<ProgressDto> GetProgressAsync(int studentId)
+    {
+        var hoursCompleted = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(hoursCompleted / 60, 56);
+    }
+
+    public async Task<List<GraduateReportDto>> GetGraduatesReportAsync(int year)
+    {
+        var graduates = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated && s.GraduatedOn.HasValue && s.GraduatedOn.Value.Year == year && s.InstructorId.HasValue)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var result = new List<GraduateReportDto>();
+        foreach (var grad in graduates)
+        {
+            var instructor = await _db.Instructors.IgnoreQueryFilters()
+                .Where(i => i.Id == grad.InstructorId && i.SchoolId == _db.SchoolId)
+                .FirstOrDefaultAsync();
+
+            result.Add(new GraduateReportDto(grad.InstructorId, instructor?.FullName ?? "Unknown", grad.Count));
+        }
+
+        return result;
+    }
 }
