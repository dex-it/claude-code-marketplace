+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthSummary(
+    int Month,
+    bool IsClosed,
+    DateOnly? ActSignedOn,
+    decimal TotalHours
+);
+
+public record YearSummary(int Year, List<MonthSummary> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearSummary> GetYearSummaryAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .Where(cp => cp.Month.Year == year)
+            .ToDictionaryAsync(cp => cp.Month.Month);
+
+        var timeEntriesByMonth = await _db.TimeEntries
+            .Where(t => t.WorkDate.Year == year)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(x => x.Month, x => x.Hours);
+
+        var months = new List<MonthSummary>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var isClosed = closedPeriods.TryGetValue(month, out var closedPeriod);
+            var totalHours = timeEntriesByMonth.TryGetValue(month, out var hours) ? hours : 0;
+
+            months.Add(new MonthSummary(
+                Month: month,
+                IsClosed: isClosed,
+                ActSignedOn: isClosed ? closedPeriod.ActSignedOn : null,
+                TotalHours: totalHours
+            ));
+        }
+
+        return new YearSummary(year, months);
+    }
+}
