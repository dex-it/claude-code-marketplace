+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (a) Bulk price raise for a category, done server-side (no row materialization).
+    public Task<int> RaisePricesAsync(string category, decimal percentage = 0.10m, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * (1 + percentage)), ct);
+
+    // (b) Nightly purge of AuditLogs older than `retention` (default 1 year).
+    // Deletes in small batches (own transaction each) so a ~40M-row purge out of ~50M
+    // doesn't hold one giant transaction/lock or bloat WAL; relies on an index on At.
+    public async Task<long> CleanupOldAuditLogsAsync(
+        TimeSpan? retention = null,
+        int batchSize = 5000,
+        TimeSpan? delayBetweenBatches = null,
+        CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow - (retention ?? TimeSpan.FromDays(365));
+        var delay = delayBetweenBatches ?? TimeSpan.FromMilliseconds(200);
+        long totalDeleted = 0;
+
+        while (!ct.IsCancellationRequested)
+        {
+            var deleted = await _db.Database.ExecuteSqlInterpolatedAsync($@"
+                DELETE FROM ""AuditLogs""
+                WHERE ""Id"" IN (
+                    SELECT ""Id"" FROM ""AuditLogs""
+                    WHERE ""At"" < {cutoff}
+                    ORDER BY ""At""
+                    LIMIT {batchSize}
+                )", ct);
+
+            totalDeleted += deleted;
+            if (deleted < batchSize) break;
+            if (delay > TimeSpan.Zero) await Task.Delay(delay, ct);
+        }
+
+        return totalDeleted;
+    }
+
+    // (c) Load requested products in one query, bump Stock, save.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> updates, CancellationToken ct = default)
+    {
+        var list = updates as ICollection<(Guid Id, int Add)> ?? updates.ToList();
+        var ids = list.Select(u => u.Id).Distinct().ToList();
+
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToDictionaryAsync(p => p.Id, ct);
+
+        foreach (var (id, add) in list)
+        {
+            if (products.TryGetValue(id, out var product))
+                product.Stock += add;
+        }
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (d) Create a new product with a fresh Guid.
+    public async Task<Product> CreateProductAsync(
+        string sku,
+        string category,
+        string warehouse,
+        decimal price,
+        int stock = 0,
+        CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Category = category,
+            Warehouse = warehouse,
+            Price = price,
+            Stock = stock,
+        };
+
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
