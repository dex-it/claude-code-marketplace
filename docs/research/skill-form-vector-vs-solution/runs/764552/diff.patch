+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (a) Карточка одного заказа: все позиции и платежи одним запросом (без декартова произведения).
+    public Task<Order?> GetOrderCardAsync(Guid id) =>
+        _db.Orders
+            .AsNoTracking()
+            .AsSplitQuery()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync(o => o.Id == id);
+
+    // (b) Все заказы клиента с позициями и платежами. У клиента бывают тысячи заказов,
+    // поэтому используем AsSplitQuery (иначе Items x Payments даёт декартово произведение)
+    // и отдаём результат потоково через IAsyncEnumerable, не материализуя всё в List.
+    public IAsyncEnumerable<Order> GetCustomerOrdersAsync(Guid customerId) =>
+        _db.Orders
+            .AsNoTracking()
+            .AsSplitQuery()
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsAsyncEnumerable();
+
+    // (в) Продукт по SKU на складе. Один и тот же SKU может лежать на разных складах,
+    // но на конкретном складе SKU уникален. Если склад не передан, SKU однозначен только
+    // тогда, когда он существует ровно на одном складе - в противном случае это ошибка
+    // вызывающей стороны, и мы не имеем права молча вернуть "случайный" склад.
+    public async Task<Product?> GetProductBySku(string sku, string? warehouse)
+    {
+        if (!string.IsNullOrEmpty(warehouse))
+        {
+            return await _db.Products
+                .AsNoTracking()
+                .SingleOrDefaultAsync(p => p.Sku == sku && p.Warehouse == warehouse);
+        }
+
+        var candidates = await _db.Products
+            .AsNoTracking()
+            .Where(p => p.Sku == sku)
+            .ToListAsync();
+
+        if (candidates.Count > 1)
+        {
+            throw new InvalidOperationException(
+                $"SKU '{sku}' найден на {candidates.Count} складах ({string.Join(", ", candidates.Select(p => p.Warehouse))}); " +
+                "нужно передать склад явно.");
+        }
+
+        return candidates.SingleOrDefault();
+    }
+
+    // (г) Дата отгрузки последнего отгруженного заказа клиента.
+    // Возврат не-nullable DateTime: если у клиента ещё нет отгруженных заказов,
+    // это ошибка вызывающей стороны (нужно сначала проверить наличие), поэтому кидаем исключение,
+    // а не подменяем отсутствие данных на DateTime.MinValue.
+    public async Task<DateTime> GetLastShippedDateAsync(Guid customerId)
+    {
+        var lastShippedAt = await _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .OrderByDescending(o => o.ShippedAt)
+            .Select(o => o.ShippedAt)
+            .FirstOrDefaultAsync();
+
+        if (lastShippedAt is null)
+        {
+            throw new InvalidOperationException($"У клиента {customerId} нет отгруженных заказов.");
+        }
+
+        return lastShippedAt.Value;
+    }
+}
