+using Microsoft.EntityFrameworkCore;
+
+namespace FlowStudio.Schedule;
+
+public class MemberNotFrozenException : Exception
+{
+    public MemberNotFrozenException() : base("Абонемент не заморожен") { }
+}
+
+public class MembersService
+{
+    private readonly StudioDbContext _db;
+
+    public MembersService(StudioDbContext db) => _db = db;
+
+    public async Task FreezeAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Срок заморозки должен быть положительным");
+
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenUntil = DateTime.UtcNow.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        if (member.FrozenUntil is null)
+            throw new MemberNotFrozenException();
+
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+}
