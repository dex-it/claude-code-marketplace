+using Microsoft.EntityFrameworkCore;
+
+namespace FlowStudio.Schedule;
+
+public record RandomSessionDto(int SessionId, string Course, string Trainer, string Hall,
+    DateTime StartsAt, IReadOnlyList<string> Attendees);
+
+// "Тайный гость": случайное занятие из ближайших 7 дней для выборочной проверки качества.
+public class QualityService
+{
+    private readonly StudioDbContext _db;
+
+    public QualityService(StudioDbContext db) => _db = db;
+
+    public async Task<RandomSessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var horizon = now.AddDays(7);
+
+        var candidateIds = await _db.Sessions
+            .Where(s => s.StartsAt >= now && s.StartsAt <= horizon)
+            .Select(s => s.Id)
+            .ToListAsync();
+
+        if (candidateIds.Count == 0)
+            return null;
+
+        var sessionId = candidateIds[Random.Shared.Next(candidateIds.Count)];
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments.Where(e => e.Status != EnrollmentStatus.Cancelled))
+                .ThenInclude(e => e.Member)
+            .FirstAsync(s => s.Id == sessionId);
+
+        return new RandomSessionDto(
+            session.Id,
+            session.Course.Title,
+            session.Course.Trainer.FullName,
+            session.Hall.Name,
+            session.StartsAt,
+            session.Enrollments.Select(e => e.Member.FullName).ToList());
+    }
+}
