+++ b/.github/workflows/deploy-migrations.yml
@@ -0,0 +1,57 @@
+name: Deploy DB Migrations (Production)
+
+# Manual trigger only: applying migrations to production must be a deliberate,
+# reviewed action, not an automatic side effect of pushing to main.
+on:
+  workflow_dispatch: {}
+
+concurrency:
+  group: production-db-migration
+  cancel-in-progress: false
+
+jobs:
+  migrate-production:
+    runs-on: ubuntu-latest
+    # Requires a "production" GitHub Environment with required reviewers configured,
+    # so the run pauses for approval before touching the production database.
+    environment: production
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '8.0.x'
+
+      - name: Restore
+        run: dotnet restore
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Generate idempotent migration script
+        # Idempotent script checks __EFMigrationsHistory itself, so it only
+        # applies AddCategoriesAndOrderCategories/BackfillOrderCategories if
+        # they haven't run yet - safe to re-run this job.
+        run: |
+          dotnet ef migrations script --idempotent \
+            --project Shop.Data \
+            --output "$RUNNER_TEMP/migration.sql"
+
+      - name: Upload migration script for audit
+        uses: actions/upload-artifact@v4
+        with:
+          name: migration-script-${{ github.run_id }}
+          path: ${{ runner.temp }}/migration.sql
+
+      - name: Apply migration to production
+        env:
+          PGHOST: ${{ secrets.PROD_DB_HOST }}
+          PGPORT: ${{ secrets.PROD_DB_PORT }}
+          PGDATABASE: ${{ secrets.PROD_DB_NAME }}
+          PGUSER: ${{ secrets.PROD_DB_USER }}
+          PGPASSWORD: ${{ secrets.PROD_DB_PASSWORD }}
+        run: |
+          psql "sslmode=require" \
+            -v ON_ERROR_STOP=1 \
+            -f "$RUNNER_TEMP/migration.sql"
