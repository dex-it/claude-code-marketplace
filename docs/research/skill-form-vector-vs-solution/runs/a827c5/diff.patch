+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (a) Raise the price of every product in a category by `percent` (default 10%).
+    // Uses ExecuteUpdateAsync so the update runs as a single set-based UPDATE in the
+    // database, without loading products into memory or the change tracker.
+    public Task<int> RaisePricesAsync(string category, decimal percent = 0.10m, CancellationToken ct = default)
+        => _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * (1 + percent)), ct);
+
+    // (b) Nightly cleanup of AuditLogs older than `retention` (default 1 year).
+    // The table is huge (~50M rows, ~40M eligible for deletion), so a single
+    // ExecuteDeleteAsync/DELETE would hold a long-running transaction, bloat the
+    // table/WAL and block autovacuum. Instead we delete in small batches, each in
+    // its own transaction, with a short pause between batches to limit I/O/lock
+    // pressure on a live system. `maxDuration` lets the nightly job stop within its
+    // window and resume the next night rather than running unbounded.
+    public async Task<long> CleanupOldAuditLogsAsync(
+        TimeSpan? retention = null,
+        int batchSize = 5_000,
+        TimeSpan? throttleDelay = null,
+        TimeSpan? maxDuration = null,
+        CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow - (retention ?? TimeSpan.FromDays(365));
+        var delay = throttleDelay ?? TimeSpan.FromMilliseconds(50);
+        var deadline = maxDuration.HasValue ? DateTime.UtcNow + maxDuration.Value : (DateTime?)null;
+        long totalDeleted = 0;
+
+        while (true)
+        {
+            ct.ThrowIfCancellationRequested();
+            if (deadline.HasValue && DateTime.UtcNow >= deadline.Value) break;
+
+            // No ORDER BY: we don't care which eligible rows go first, only that the
+            // index on At is used for a cheap scan+limit instead of sorting the
+            // (potentially tens-of-millions-row) matching set on every batch.
+            var idsBatch = await _db.AuditLogs
+                .Where(a => a.At < cutoff)
+                .Select(a => a.Id)
+                .Take(batchSize)
+                .ToListAsync(ct);
+
+            if (idsBatch.Count == 0) break;
+
+            totalDeleted += await _db.AuditLogs
+                .Where(a => idsBatch.Contains(a.Id))
+                .ExecuteDeleteAsync(ct);
+
+            if (idsBatch.Count < batchSize) break;
+
+            await Task.Delay(delay, ct);
+        }
+
+        return totalDeleted;
+    }
+
+    // (c) Load the given products and increase their Stock, then save.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var list = items as IReadOnlyCollection<(Guid Id, int Add)> ?? items.ToList();
+        if (list.Count == 0) return;
+
+        var ids = list.Select(i => i.Id).Distinct().ToList();
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToDictionaryAsync(p => p.Id, ct);
+
+        foreach (var (id, add) in list)
+            if (products.TryGetValue(id, out var product))
+                product.Stock += add;
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (d) Create a new product with a fresh Guid.
+    public async Task<Product> CreateProductAsync(
+        string sku, string warehouse, string category, decimal price, int stock = 0, CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Warehouse = warehouse,
+            Category = category,
+            Price = price,
+            Stock = stock,
+        };
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
