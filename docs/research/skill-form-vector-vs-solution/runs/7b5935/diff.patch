+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record StudentWithLessonDto(
+    int Id,
+    string FullName,
+    string Phone,
+    StudentStatus Status,
+    string PassportNo,
+    DateTime? NextLessonAt);
+
+public class InstructorService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<StudentWithLessonDto>> GetStudentsAsync(int instructorId)
+    {
+        var students = await _db.Students
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var studentIds = students.Select(s => s.Id).ToList();
+
+        var nextLessons = await _db.Lessons
+            .Where(l => studentIds.Contains(l.StudentId) && l.StartsAt > DateTime.UtcNow)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextLesson = g.OrderBy(l => l.StartsAt).First().StartsAt })
+            .ToDictionaryAsync(x => x.StudentId, x => x.NextLesson);
+
+        return students.Select(s => new StudentWithLessonDto(
+            s.Id,
+            s.FullName,
+            s.Phone,
+            s.Status,
+            s.PassportNo.Length > 4 ? new string('*', s.PassportNo.Length - 4) + s.PassportNo[^4..] : "****",
+            nextLessons.TryGetValue(s.Id, out var nextLesson) ? nextLesson : null
+        )).ToList();
+    }
+}
