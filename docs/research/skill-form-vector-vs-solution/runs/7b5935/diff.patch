+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record ProgressDto(int CompletedMinutes, int TotalMinutes);
+
+public class ProgressService
+{
+    private readonly SchoolDbContext _db;
+    private const int TotalRequiredMinutes = 56 * 60; // 56 часов в минутах
+
+    public ProgressService(SchoolDbContext db) => _db = db;
+
+    public async Task<ProgressDto> GetStudentProgressAsync(int studentId)
+    {
+        var student = await _db.Students.FirstOrDefaultAsync(s => s.Id == studentId);
+        if (student is null)
+            throw new KeyNotFoundException("Ученик не найден");
+
+        var completedMinutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(completedMinutes, TotalRequiredMinutes);
+    }
+}
