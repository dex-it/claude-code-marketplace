+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+
+public class AuthService
+{
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _emailSender;
+
+    public AuthService(SchoolDbContext db, IEmailSender emailSender)
+    {
+        _db = db;
+        _emailSender = emailSender;
+    }
+
+    public async Task RequestLoginCodeAsync(string email)
+    {
+        var normalizedEmail = email.Trim().ToLower();
+
+        var student = await _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail);
+        if (student is null)
+            throw new KeyNotFoundException("Ученик не найден");
+
+        var code = Random.Shared.Next(100000, 999999).ToString();
+        var expiresAt = DateTime.UtcNow.AddMinutes(10);
+
+        var loginCode = new LoginCode
+        {
+            Email = normalizedEmail,
+            Code = code,
+            ExpiresAt = expiresAt,
+            Used = false
+        };
+
+        _db.LoginCodes.Add(loginCode);
+        await _emailSender.SendAsync(student.Email, "Код входа в AutoSchool", $"Ваш код входа: {code}\nКод действует 10 минут.");
+    }
+
+    public async Task<StudentDto?> ConfirmLoginCodeAsync(string email, string code)
+    {
+        var normalizedEmail = email.Trim().ToLower();
+
+        var loginCode = await _db.LoginCodes
+            .Where(l => l.Email == normalizedEmail && l.Code == code && !l.Used)
+            .OrderByDescending(l => l.ExpiresAt)
+            .FirstOrDefaultAsync();
+
+        if (loginCode is null || loginCode.ExpiresAt < DateTime.UtcNow)
+            throw new InvalidOperationException("Неверный или истёкший код");
+
+        loginCode.Used = true;
+
+        var student = await _db.Students
+            .AsNoTracking()
+            .Include(x => x.Instructor)
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail);
+
+        return student is null ? null : StudentService.ToDto(student);
+    }
+}
