+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduateCountDto(string InstructorName, int Count);
+
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<GraduateCountDto>> GetGraduatesByYearAsync(int year)
+    {
+        var startDate = new DateOnly(year, 1, 1);
+        var endDate = new DateOnly(year, 12, 31);
+
+        var graduates = await _db.Students
+            .Where(s => s.GraduatedOn >= startDate && s.GraduatedOn <= endDate)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new
+            {
+                InstructorId = g.Key,
+                Count = g.Count()
+            })
+            .ToListAsync();
+
+        var instructorIds = graduates.Select(g => g.InstructorId).ToList();
+
+        var instructors = await _db.Instructors
+            .IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .ToDictionaryAsync(i => i.Id, i => i.FullName);
+
+        return graduates
+            .Select(g => new GraduateCountDto(
+                instructors.TryGetValue(g.InstructorId ?? 0, out var name) ? name : "Без инструктора",
+                g.Count))
+            .OrderByDescending(x => x.Count)
+            .ToList();
+    }
+}
