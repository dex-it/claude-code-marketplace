+using Microsoft.EntityFrameworkCore.Migrations;
+
+#nullable disable
+
+namespace Shop.Data.Migrations
+{
+    /// <summary>
+    /// Data-only: backfills Categories / OrderCategories from the legacy Order.Category string.
+    /// Deliberately kept separate from the schema migration (see team checklist: "Данные и схема
+    /// в одной миграции"). Runs against the whole Orders table, bypassing the app-level
+    /// IsDeleted query filter on purpose, so soft-deleted orders keep a consistent category link.
+    /// Idempotent via ON CONFLICT DO NOTHING, safe to re-run if the deploy step retries.
+    /// Order.Category itself is left untouched here and will be dropped in a later migration
+    /// once all readers are confirmed to use Categories/OrderCategories instead.
+    /// </summary>
+    public partial class BackfillOrderCategoriesFromOrderCategory : Migration
+    {
+        protected override void Up(MigrationBuilder migrationBuilder)
+        {
+            migrationBuilder.Sql(
+                """
+                INSERT INTO "Categories" ("Name")
+                SELECT DISTINCT o."Category"
+                FROM "Orders" o
+                WHERE o."Category" IS NOT NULL AND o."Category" <> ''
+                ON CONFLICT ("Name") DO NOTHING;
+                """);
+
+            migrationBuilder.Sql(
+                """
+                INSERT INTO "OrderCategories" ("OrderId", "CategoryId")
+                SELECT o."Id", c."Id"
+                FROM "Orders" o
+                JOIN "Categories" c ON c."Name" = o."Category"
+                WHERE o."Category" IS NOT NULL AND o."Category" <> ''
+                ON CONFLICT ("OrderId", "CategoryId") DO NOTHING;
+                """);
+        }
+
+        protected override void Down(MigrationBuilder migrationBuilder)
+        {
+            migrationBuilder.Sql("""DELETE FROM "OrderCategories";""");
+            migrationBuilder.Sql("""DELETE FROM "Categories";""");
+        }
+    }
+}
