new file mode 100644
index 0000000..8b0995a
--- /dev/null
+++ b/.github/workflows/deploy-migration.yml
@@ -0,0 +1,77 @@
+name: Deploy DB migration (production)
+
+# Manual, separate from the app deploy: schema/data changes must be able to run
+# (and be reviewed) independently of rolling out new app code.
+on:
+  workflow_dispatch:
+    inputs:
+      confirm:
+        description: 'Type "deploy" to apply pending EF Core migrations to production'
+        required: true
+
+permissions:
+  contents: read
+
+jobs:
+  migrate-production:
+    if: github.event.inputs.confirm == 'deploy'
+    runs-on: ubuntu-latest
+    environment:
+      name: production   # requires manual reviewer approval in repo settings
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '8.0.x'
+
+      - name: Restore
+        run: dotnet restore
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Generate idempotent SQL script for review
+        run: >
+          dotnet ef migrations script
+          --idempotent
+          --output ${{ runner.temp }}/migration.sql
+          --project Shop.Data
+        # Idempotent script only applies migrations not yet recorded in
+        # __EFMigrationsHistory, so a rerun after a partial/aborted apply is safe.
+
+      - name: Upload migration script as artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: migration-script-${{ github.run_id }}
+          path: ${{ runner.temp }}/migration.sql
+
+      - name: Backup production database
+        env:
+          PGPASSWORD: ${{ secrets.PROD_DB_PASSWORD }}
+        run: |
+          pg_dump -h ${{ secrets.PROD_DB_HOST }} -U ${{ secrets.PROD_DB_USER }} -d ${{ secrets.PROD_DB_NAME }} \
+            -F c -f ${{ runner.temp }}/pre-migration-backup.dump
+
+      - name: Upload backup as artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: pre-migration-backup-${{ github.run_id }}
+          path: ${{ runner.temp }}/pre-migration-backup.dump
+          retention-days: 30
+
+      - name: Apply migration
+        env:
+          PGPASSWORD: ${{ secrets.PROD_DB_PASSWORD }}
+        # -1 wraps the whole idempotent script in a single transaction and
+        # ON_ERROR_STOP aborts (and rolls back) on the first failing statement,
+        # so a half-applied migration can never be left on production.
+        run: |
+          psql -v ON_ERROR_STOP=1 -1 \
+            -h ${{ secrets.PROD_DB_HOST }} -U ${{ secrets.PROD_DB_USER }} -d ${{ secrets.PROD_DB_NAME }} \
+            -f ${{ runner.temp }}/migration.sql
+
+      # Deploy the new app revision (which relies on Categories/OrderCategories)
+      # only after the schema/backfill above have committed successfully.
+      - name: Trigger app deploy
+        run: echo "Hand off to the app deploy workflow here (e.g. workflow_call or repository_dispatch)."
