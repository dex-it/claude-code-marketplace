@@ -0,0 +1,31 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+public record LoansByBranchRequest(DateTimeOffset From, DateTimeOffset To);
+
+public sealed record BranchLoanCount(int BranchId, string Branch, int Loans);
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // Число выдач по каждому филиалу за период [from, to).
+    // Моменты приходят со смещением пользователя; Npgsql пишет в timestamptz
+    // только DateTimeOffset с нулевым смещением, поэтому приводим к UTC.
+    public async Task<List<BranchLoanCount>> LoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var fromUtc = from.ToUniversalTime();
+        var toUtc = to.ToUniversalTime();
+
+        return await _db.Branches
+            .OrderBy(b => b.Name)
+            .Select(b => new BranchLoanCount(
+                b.Id,
+                b.Name,
+                _db.Loans.Count(l => l.BranchId == b.Id && l.IssuedAt >= fromUtc && l.IssuedAt < toUtc)))
+            .ToListAsync();
+    }
+}
