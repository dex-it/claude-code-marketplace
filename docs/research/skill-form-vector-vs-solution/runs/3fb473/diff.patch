-    public static readonly FineRules Default = new(10m, 3, 500m);
+    public static FineRules FromConfiguration(IConfiguration config)
+    {
+        var section = config.GetSection("Fines");
+        if (!section.Exists())
+            throw new InvalidOperationException("В конфигурации нет секции Fines");
+
+        var rules = section.Get<FineRules>()
+            ?? throw new InvalidOperationException("Секция Fines заполнена некорректно");
+        if (rules.PerDay < 0 || rules.GraceDays < 0 || rules.Max < 0)
+            throw new InvalidOperationException("Параметры Fines не могут быть отрицательными");
+        return rules;
+    }
 }
 
