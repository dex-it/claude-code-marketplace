+    // Обновить план дома целиком: заменить список работ, сохранив историю выполнения для оставляющихся работ.
+    public async Task UpdatePlanAsync(int houseId, List<PlanItemUpdate> updates)
+    {
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId)
+            ?? throw new KeyNotFoundException($"План дома {houseId} не найден");
+
+        var newCodes = updates.Select(u => u.WorkCode).ToHashSet();
+
+        // Удалить работы, которых нет в новом плане
+        var toRemove = plan.Items.Where(i => !newCodes.Contains(i.WorkCode)).ToList();
+        foreach (var item in toRemove)
+            plan.Items.Remove(item);
+
+        // Обновить или добавить работы
+        foreach (var update in updates)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == update.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = update.Title;
+                existing.PeriodDays = update.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = update.WorkCode,
+                    Title = update.Title,
+                    PeriodDays = update.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
