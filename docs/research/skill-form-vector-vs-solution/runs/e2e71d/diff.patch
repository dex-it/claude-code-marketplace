+using System.Runtime.CompilerServices;
+using Microsoft.EntityFrameworkCore;
+
+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private const int CustomerOrdersBatchSize = 500;
+
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (а) Карточка заказа. Две коллекции -> split query, чтобы не получить декартово произведение Items x Payments.
+    public Task<Order?> GetOrderCardAsync(Guid orderId, CancellationToken ct = default) =>
+        _db.Orders
+            .AsNoTracking()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .SingleOrDefaultAsync(o => o.Id == orderId, ct);
+
+    // (б) Все заказы клиента. Заказов могут быть тысячи, поэтому сначала берём только Id,
+    // затем грузим заказы пачками (split query + no tracking) и отдаём потоком.
+    public async IAsyncEnumerable<Order> StreamCustomerOrdersAsync(
+        Guid customerId, [EnumeratorCancellation] CancellationToken ct = default)
+    {
+        var ids = await _db.Orders
+            .Where(o => o.CustomerId == customerId)
+            .OrderBy(o => o.CreatedAt).ThenBy(o => o.Id)
+            .Select(o => o.Id)
+            .ToListAsync(ct);
+
+        foreach (var chunk in ids.Chunk(CustomerOrdersBatchSize))
+        {
+            var batch = await _db.Orders
+                .AsNoTracking()
+                .Where(o => chunk.Contains(o.Id))
+                .Include(o => o.Items)
+                .Include(o => o.Payments)
+                .AsSplitQuery()
+                .OrderBy(o => o.CreatedAt).ThenBy(o => o.Id)
+                .ToListAsync(ct);
+
+            foreach (var order in batch)
+                yield return order;
+        }
+    }
+
+    // (в) SKU уникален только в пределах склада. Если склад не передан, возвращаем продукт
+    // лишь когда SKU однозначен; при нескольких складах - ошибка, а не произвольная запись.
+    public async Task<Product?> GetProductBySku(string sku, string? warehouse, CancellationToken ct = default)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(sku);
+
+        var query = _db.Products.AsNoTracking().Where(p => p.Sku == sku);
+        if (warehouse != null)
+            query = query.Where(p => p.Warehouse == warehouse);
+
+        var found = await query.OrderBy(p => p.Warehouse).Take(2).ToListAsync(ct);
+        if (found.Count > 1)
+            throw new InvalidOperationException(warehouse == null
+                ? $"SKU '{sku}' is present in several warehouses; warehouse must be specified."
+                : $"SKU '{sku}' is not unique in warehouse '{warehouse}'.");
+
+        return found.FirstOrDefault();
+    }
+
+    // (г) Max по nullable-проекции: без неё EF упадёт с "Sequence contains no elements"
+    // или вернёт default(DateTime). Отсутствие отгрузок - явная ошибка, а не 0001-01-01.
+    public async Task<DateTime> GetLastShippedAtAsync(Guid customerId, CancellationToken ct = default)
+    {
+        var last = await _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .MaxAsync(o => (DateTime?)o.ShippedAt, ct);
+
+        return last ?? throw new InvalidOperationException(
+            $"Customer '{customerId}' has no shipped orders.");
+    }
+}
