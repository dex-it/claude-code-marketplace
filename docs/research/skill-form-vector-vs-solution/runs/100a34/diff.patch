@@ -46,10 +48,122 @@ public class ClinicCardService(ClinicDbContext db)
         await db.SaveChangesAsync();
     }
 
-    public async Task UpdateVisitNotesAsync(int visitId, string? notes)
+    public async Task UpdateVisitAnamnesisAsync(int visitId, string? anamnesis)
     {
         var visit = await db.Visits.SingleAsync(v => v.Id == visitId);
-        visit.Notes = notes;
+        visit.Anamnesis = anamnesis;
+        await db.SaveChangesAsync();
+    }
+
+    // «Удаление» клиента = soft-delete клиента и всей его медкарты (питомцы, аллергии, визиты)
+    // одной транзакцией с общим DeletedAt, чтобы поддержка могла восстановить ровно этот набор.
+    // Уже удалённые ранее записи не трогаем - их DeletedAt сохраняется.
+    public async Task<bool> DeleteOwnerAsync(int ownerId)
+    {
+        var now = DateTime.UtcNow;
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        var owners = await db.Owners
+            .Where(o => o.Id == ownerId)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(o => o.IsDeleted, true)
+                .SetProperty(o => o.DeletedAt, now));
+        if (owners == 0)
+            return false;
+
+        // Фильтры зависимых ссылаются на principal'а, который уже помечен удалённым, -
+        // поэтому дальше IgnoreQueryFilters и явное условие !IsDeleted.
+        await db.Pets.IgnoreQueryFilters()
+            .Where(p => p.OwnerId == ownerId && !p.IsDeleted)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(p => p.IsDeleted, true)
+                .SetProperty(p => p.DeletedAt, now));
+
+        await db.Visits.IgnoreQueryFilters()
+            .Where(v => v.Pet.OwnerId == ownerId && !v.IsDeleted)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(v => v.IsDeleted, true)
+                .SetProperty(v => v.DeletedAt, now));
+
+        await db.Allergies.IgnoreQueryFilters()
+            .Where(a => a.Pet.OwnerId == ownerId && !a.IsDeleted)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(a => a.IsDeleted, true)
+                .SetProperty(a => a.DeletedAt, now));
+
+        await tx.CommitAsync();
+        return true;
+    }
+
+    // Полная замена списка аллергий. Аллергии не удаляются физически: совпавшие по аллергену
+    // обновляются, отсутствующие в новом списке помечаются удалёнными, новые добавляются.
+    public async Task<bool> ReplaceAllergiesAsync(int petId, IReadOnlyList<AllergyInput> allergies)
+    {
+        var incoming = allergies
+            .Select(i => i with { Allergen = (i.Allergen ?? "").Trim() })
+            .ToList();
+        if (incoming.Any(i => i.Allergen.Length == 0 || i.Allergen.Length > AllergenMaxLength))
+            throw new ArgumentException($"Аллерген обязателен и не длиннее {AllergenMaxLength} символов.");
+        if (incoming.Any(i => !Enum.IsDefined(i.Severity)))
+            throw new ArgumentException("Недопустимая степень тяжести аллергии.");
+
+        var byAllergen = new Dictionary<string, AllergyInput>(StringComparer.OrdinalIgnoreCase);
+        foreach (var input in incoming)
+        {
+            if (!byAllergen.TryAdd(input.Allergen, input))
+                throw new ArgumentException($"Аллерген «{input.Allergen}» указан в списке несколько раз.");
+        }
+
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        // Блокируем строку питомца до Commit: параллельные замены списка одного питомца
+        // выполняются по очереди, а не плодят дубликаты/перетирают друг друга вперемешку.
+        var locked = await db.Database.SqlQuery<int>($"""
+            SELECT p."Id" AS "Value"
+            FROM "Pets" p
+            JOIN "Owners" o ON o."Id" = p."OwnerId"
+            WHERE p."Id" = {petId} AND NOT p."IsDeleted" AND NOT o."IsDeleted"
+            FOR UPDATE OF p
+            """).ToListAsync();
+        if (locked.Count == 0)
+            return false;
+
+        var now = DateTime.UtcNow;
+        var current = await db.Allergies
+            .Where(a => a.PetId == petId)
+            .OrderBy(a => a.Id)
+            .ToListAsync();
+
+        var matched = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var allergy in current)
+        {
+            if (byAllergen.TryGetValue(allergy.Allergen.Trim(), out var input) && matched.Add(input.Allergen))
+            {
+                allergy.Allergen = input.Allergen;
+                allergy.Reaction = input.Reaction;
+                allergy.Severity = input.Severity;
+            }
+            else
+            {
+                // Нет в новом списке или дубликат уже сопоставленной записи.
+                allergy.IsDeleted = true;
+                allergy.DeletedAt = now;
+            }
+        }
+
+        foreach (var input in incoming.Where(i => !matched.Contains(i.Allergen)))
+        {
+            db.Allergies.Add(new Allergy
+            {
+                PetId = petId,
+                Allergen = input.Allergen,
+                Reaction = input.Reaction,
+                Severity = input.Severity
+            });
+        }
+
         await db.SaveChangesAsync();
+        await tx.CommitAsync();
+        return true;
     }
 }
