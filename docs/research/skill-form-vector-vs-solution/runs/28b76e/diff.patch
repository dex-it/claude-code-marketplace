+
+    public async Task ProcessStatementAsync(TextReader csvReader)
+    {
+        var lines = BankStatement.Parse(csvReader);
+
+        foreach (var line in lines)
+        {
+            var alreadyProcessed = await _db.Payments.AnyAsync(p => p.BankRef == line.BankRef) ||
+                                   await _db.UnreconciledPayments.AnyAsync(p => p.BankRef == line.BankRef);
+
+            if (alreadyProcessed)
+                continue;
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var subscriber = contractNo != null
+                ? await _db.Subscribers.FirstOrDefaultAsync(s => s.ContractNo == contractNo)
+                : null;
+
+            if (subscriber != null)
+            {
+                subscriber.Balance += line.Amount;
+
+                if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+                {
+                    subscriber.Status = SubscriberStatus.Active;
+                    subscriber.ResumedAt = DateTime.Now;
+                }
+
+                var payment = new Payment
+                {
+                    SubscriberId = subscriber.Id,
+                    Amount = line.Amount,
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    CreditedAt = DateTime.Now,
+                    Purpose = line.Purpose
+                };
+                _db.Payments.Add(payment);
+            }
+            else
+            {
+                var unreconciled = new UnreconciledPayment
+                {
+                    Amount = line.Amount,
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    CreatedAt = DateTime.Now,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose
+                };
+                _db.UnreconciledPayments.Add(unreconciled);
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<List<SubscriberDto>> SearchByPhoneAsync(string phoneSuffix)
+    {
+        return await _db.Subscribers.AsNoTracking()
+            .Where(s => s.Phone.EndsWith(phoneSuffix))
+            .Take(20)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+    }
 }
