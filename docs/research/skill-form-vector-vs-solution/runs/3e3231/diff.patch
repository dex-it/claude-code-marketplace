+    // Колонка CreatedAt остаётся "timestamp without time zone" (на неё смотрят отчёты DBA),
+    // но по конвенции хранит момент в UTC. Конвертер снимает/проставляет Kind, чтобы в коде
+    // (при чтении, записи и в параметрах запросов) DateTime всегда был Utc.
+    private static readonly ValueConverter<DateTime, DateTime> UtcCreatedAtConverter = new(
+        toProvider => toProvider.Kind == DateTimeKind.Local ? toProvider.ToUniversalTime() : DateTime.SpecifyKind(toProvider, DateTimeKind.Unspecified),
+        fromProvider => DateTime.SpecifyKind(fromProvider, DateTimeKind.Utc));
