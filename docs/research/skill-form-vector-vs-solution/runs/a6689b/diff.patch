@@ -0,0 +1,40 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+public record LoansByBranchRequest(DateTimeOffset? From, DateTimeOffset? To);
+
+public record BranchLoanCount(int BranchId, string Branch, int Loans);
+
+public record LoansByBranchReport(DateTimeOffset From, DateTimeOffset To, List<BranchLoanCount> Branches);
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // Число выдач по филиалам за период [from, to). Границы - абсолютные моменты времени
+    // с поясом пользователя; Npgsql пишет в timestamptz только DateTimeOffset с нулевым смещением.
+    public async Task<LoansByBranchReport> LoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var fromUtc = from.ToUniversalTime();
+        var toUtc = to.ToUniversalTime();
+
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= fromUtc && l.IssuedAt < toUtc)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.BranchId, x => x.Count);
+
+        // Филиалы без выдач тоже попадают в отчёт - с нулём.
+        var branches = await _db.Branches
+            .OrderBy(b => b.Name)
+            .Select(b => new { b.Id, b.Name })
+            .ToListAsync();
+
+        return new LoansByBranchReport(from, to, branches
+            .Select(b => new BranchLoanCount(b.Id, b.Name, counts.GetValueOrDefault(b.Id)))
+            .ToList());
+    }
+}
