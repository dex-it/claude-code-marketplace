+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginConfirmResultDto(int StudentId, string FullName);
+
+public class AppAuthService
+{
+    private const int CodeLifetimeMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestCodeAsync(string email)
+    {
+        var student = await FindByEmailAsync(email);
+        if (student is null)
+            return; // не раскрываем, есть ли такой e-mail в базе
+
+        var oldCodes = await _db.LoginCodes.Where(c => c.StudentId == student.Id && !c.Used).ToListAsync();
+        _db.LoginCodes.RemoveRange(oldCodes);
+
+        var code = GenerateCode();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа",
+            $"Ваш код для входа: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<LoginConfirmResultDto?> ConfirmAsync(string email, string code)
+    {
+        var student = await FindByEmailAsync(email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var enteredCode = code.Trim();
+        var loginCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now && c.Code == enteredCode)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+
+        if (loginCode is null)
+            return null;
+
+        loginCode.Used = true;
+        return new LoginConfirmResultDto(student.Id, student.FullName);
+    }
+
+    // Почта вводится как придётся (регистр клавиатуры телефона), поэтому сравниваем без учёта регистра.
+    private Task<Student?> FindByEmailAsync(string email)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        return _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == normalized);
+    }
+
+    private static string GenerateCode() => RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+}
