@@ -0,0 +1,45 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesByInstructorDto(int InstructorId, string InstructorFullName, bool InstructorDismissed, int GraduatesCount);
+
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Отчёт для продления лицензии: число выпускников года по каждому инструктору,
+    // включая тех, кто уже уволен (обходим стандартный фильтр "не уволен").
+    public async Task<List<GraduatesByInstructorDto>> GetGraduatesByYearAsync(int year)
+    {
+        var grouped = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn.HasValue
+                        && s.GraduatedOn.Value.Year == year
+                        && s.InstructorId != null)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var instructorIds = grouped.Select(g => g.InstructorId).ToList();
+
+        var instructors = await _db.Instructors.IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .ToDictionaryAsync(i => i.Id);
+
+        return grouped
+            .Select(g =>
+            {
+                var instructor = instructors.GetValueOrDefault(g.InstructorId);
+                return new GraduatesByInstructorDto(
+                    g.InstructorId,
+                    instructor?.FullName ?? "—",
+                    instructor?.IsDeleted ?? false,
+                    g.Count);
+            })
+            .OrderByDescending(r => r.GraduatesCount)
+            .ToList();
+    }
+}
