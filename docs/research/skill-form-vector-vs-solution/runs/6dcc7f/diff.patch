+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+[ApiController]
+[Route("requests")]
+public class RequestsController : ControllerBase
+{
+    private readonly HousingService _service;
+
+    public RequestsController(HousingService service) => _service = service;
+
+    // Реестр заявок диспетчерской: фильтры как раньше + сортировка по клику на заголовок.
+    [HttpGet]
+    public async Task<ActionResult<List<RequestRow>>> Search(
+        [FromQuery] string? text, [FromQuery] RequestStatus? status, [FromQuery] int? houseId,
+        [FromQuery] string? district, [FromQuery] string sort = "date", [FromQuery] string? dir = null,
+        [FromQuery] int page = 1, [FromQuery] int pageSize = 50)
+    {
+        RequestSort sortField;
+        switch (sort.ToLowerInvariant())
+        {
+            case "date": sortField = RequestSort.Date; break;
+            case "address": sortField = RequestSort.Address; break;
+            case "status": sortField = RequestSort.Status; break;
+            default: return BadRequest($"Неизвестное поле сортировки: {sort}");
+        }
+
+        // По умолчанию дата - новые сверху (desc), остальные поля - по возрастанию.
+        var dirValue = dir?.ToLowerInvariant() ?? (sortField == RequestSort.Date ? "desc" : "asc");
+        SortDirection direction;
+        switch (dirValue)
+        {
+            case "asc": direction = SortDirection.Asc; break;
+            case "desc": direction = SortDirection.Desc; break;
+            default: return BadRequest($"Неизвестное направление сортировки: {dir}");
+        }
+
+        var rows = await _service.SearchAsync(new RequestSearch(text, status, houseId, district,
+            sortField, direction, page, pageSize));
+        return Ok(rows);
+    }
+
+    [HttpGet("{id}")]
+    public async Task<ActionResult<RequestCard>> Get(int id)
+    {
+        var card = await _service.GetRequestAsync(id);
+        return card is null ? NotFound() : Ok(card);
+    }
+
+    [HttpPost]
+    public async Task<ActionResult<int>> Create([FromBody] NewRequest request)
+    {
+        var id = await _service.CreateRequestAsync(request);
+        return CreatedAtAction(nameof(Get), new { id }, id);
+    }
+
+    // Мастер закрывает заявку: Done + обязательный комментарий, только из InProgress.
+    [HttpPost("{id}/close")]
+    public async Task<IActionResult> Close(int id, [FromBody] CloseRequestBody body)
+    {
+        if (string.IsNullOrWhiteSpace(body.Comment))
+            return BadRequest("Комментарий о выполненных работах обязателен.");
+
+        var result = await _service.CloseRequestAsync(id, body.Comment);
+        return result switch
+        {
+            CloseRequestResult.Done => NoContent(),
+            CloseRequestResult.NotFound => NotFound(),
+            CloseRequestResult.NotInProgress =>
+                Conflict("Закрыть можно только заявку в статусе InProgress."),
+            _ => StatusCode(500),
+        };
+    }
+}
