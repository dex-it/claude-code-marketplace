+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing;
+
+[ApiController]
+[Route("houses")]
+public class HousesController : ControllerBase
+{
+    private readonly PlanService _service;
+
+    public HousesController(PlanService service) => _service = service;
+
+    [HttpGet("{id}/plan")]
+    public async Task<ActionResult<List<PlanItemDto>>> GetPlan(int id) =>
+        Ok(await _service.GetPlanAsync(id));
+
+    // Инженер присылает план дома целиком: план становится таким, как прислано,
+    // история выполнения сохраняется для работ, которые остаются в плане.
+    [HttpPut("{id}/plan")]
+    public async Task<IActionResult> ReplacePlan(int id, [FromBody] List<PlanItemInput> items)
+    {
+        var codes = items.Select(i => i.WorkCode).ToList();
+        if (codes.Distinct().Count() != codes.Count)
+            return BadRequest("Коды работ в плане не должны повторяться.");
+
+        await _service.ReplacePlanAsync(id, items);
+        return NoContent();
+    }
+}
