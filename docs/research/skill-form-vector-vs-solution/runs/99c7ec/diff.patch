+using Microsoft.EntityFrameworkCore;
+
+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (a) карточка одного заказа: одна сущность -> JOIN дешевле двух round-trip'ов, без AsSplitQuery
+    public Task<Order?> GetOrderCardAsync(Guid id) =>
+        _db.Orders
+            .AsNoTracking()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync(o => o.Id == id);
+
+    // (b) у клиента бывают тысячи заказов: два Include дали бы cartesian explosion, поэтому AsSplitQuery
+    public Task<List<Order>> GetCustomerOrdersWithDetailsAsync(Guid customerId) =>
+        _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .ToListAsync();
+
+    // (c) SKU уникален только в рамках склада; warehouse может отсутствовать -> не гадать, а явно
+    // упасть, если по одному SKU без склада находится больше одной записи (Single() без уникального условия — бомба)
+    public async Task<Product?> GetProductBySkuAsync(string sku, string? warehouse)
+    {
+        var query = _db.Products.AsNoTracking().Where(p => p.Sku == sku);
+        if (warehouse != null)
+            query = query.Where(p => p.Warehouse == warehouse);
+
+        var matches = await query.Take(2).ToListAsync();
+        if (matches.Count > 1)
+            throw new InvalidOperationException(
+                $"SKU '{sku}' найден на нескольких складах, укажите warehouse явно.");
+
+        return matches.SingleOrDefault();
+    }
+
+    // (г) дата отгрузки последнего отгруженного заказа; ShippedAt nullable в БД -> фильтр на null
+    // до агрегации, исключение вместо тихого DateTime.MinValue, если отгруженных заказов ещё нет
+    public async Task<DateTime> GetLastShippedAtAsync(Guid customerId)
+    {
+        var lastShippedAt = await _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .MaxAsync(o => (DateTime?)o.ShippedAt);
+
+        if (lastShippedAt == null)
+            throw new InvalidOperationException($"У клиента {customerId} нет отгруженных заказов.");
+
+        return lastShippedAt.Value;
+    }
+}
