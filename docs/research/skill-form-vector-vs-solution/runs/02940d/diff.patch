@@ -0,0 +1,58 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string? Comment);
+
+// Подключается в Program.cs: app.MapHousingEndpoints();
+// Реестр (GET /requests), приём заявки и карточка остаются на прежних маршрутах: sort/dir и
+// contactPhone приходят через расширенные RequestSearch / NewRequest. SearchAsync и
+// CreateRequestAsync бросают ArgumentException на неверный ввод - его нужно отдавать как 400.
+public static class HousingEndpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService svc) =>
+        {
+            try
+            {
+                return await svc.CloseRequestAsync(id, body.Comment) switch
+                {
+                    CloseResult.Closed => Results.NoContent(),
+                    CloseResult.NotFound => Results.NotFound(),
+                    _ => Results.Problem("Закрыть можно только заявку в работе (InProgress)",
+                        statusCode: StatusCodes.Status409Conflict),
+                };
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.Problem(ex.Message, statusCode: StatusCodes.Status400BadRequest);
+            }
+        });
+
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.Ok(await svc.GetPlanAsync(id));
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.Problem(ex.Message, statusCode: StatusCodes.Status400BadRequest);
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (InvalidOperationException ex)
+            {
+                return Results.Problem(ex.Message, statusCode: StatusCodes.Status409Conflict);
+            }
+        });
+
+        return app;
+    }
+}
