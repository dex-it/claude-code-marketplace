+    // Инженер прислал план дома целиком. Работы сопоставляются по коду: оставшиеся обновляются
+    // на месте (Id и история выполнения сохраняются), новые добавляются, отсутствующие удаляются.
+    public async Task ReplacePlanAsync(int houseId, IReadOnlyList<PlanItemInput>? items)
+    {
+        if (items is null)
+            throw new ArgumentException("План не передан");
+
+        var incoming = items.Select(i => new PlanItemInput(
+            (i.WorkCode ?? "").Trim(), (i.Title ?? "").Trim(), i.PeriodDays)).ToList();
+
+        foreach (var i in incoming)
+        {
+            if (i.WorkCode.Length == 0)
+                throw new ArgumentException("У работы не указан код");
+            if (i.Title.Length == 0)
+                throw new ArgumentException($"У работы {i.WorkCode} не указано название");
+            if (i.PeriodDays <= 0)
+                throw new ArgumentException($"У работы {i.WorkCode} периодичность должна быть больше нуля");
+        }
+
+        var duplicate = incoming.GroupBy(i => i.WorkCode).FirstOrDefault(g => g.Count() > 1);
+        if (duplicate is not null)
+            throw new ArgumentException($"Работа {duplicate.Key} указана в плане несколько раз");
+
+        if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+            throw new KeyNotFoundException($"Дом {houseId} не найден");
+
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId);
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var byCode = incoming.ToDictionary(i => i.WorkCode);
+
+        foreach (var item in plan.Items.ToList())
+        {
+            if (byCode.ContainsKey(item.WorkCode))
+                continue;
+
+            // DeleteOrphansTiming = Never: убрать из коллекции недостаточно - удаляем явно.
+            // Отметки о выполнении удалённой работы уходят каскадом по FK.
+            plan.Items.Remove(item);
+            _db.PlanItems.Remove(item);
+        }
+
+        foreach (var input in incoming)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == input.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = input.Title;
+                existing.PeriodDays = input.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+        }
+
+        try
+        {
+            await _db.SaveChangesAsync();
+        }
+        catch (DbUpdateException ex) when (ex.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })
+        {
+            // Параллельное обновление того же плана успело добавить ту же работу.
+            throw new InvalidOperationException("План дома изменён параллельно, повторите запрос", ex);
+        }
+    }
+
