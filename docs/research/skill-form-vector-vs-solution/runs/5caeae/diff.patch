+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResult(int StudentId);
+
+// Вход ученика в мобильное приложение по одноразовому коду.
+public class AppLoginService
+{
+    private const int CodeLifetimeMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppLoginService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestCodeAsync(LoginRequest req)
+    {
+        var student = await FindByEmailOrNullAsync(req.Email);
+        if (student is null)
+            return; // ответ одинаков для существующей и несуществующей почты - не раскрываем наличие карточки
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа",
+            $"Ваш код: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<LoginResult?> ConfirmCodeAsync(LoginConfirmRequest req)
+    {
+        var student = await FindByEmailOrNullAsync(req.Email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var hash = Hash(req.Code.Trim());
+        var match = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && c.CodeHash == hash
+                        && c.ConsumedAt == null && c.ExpiresAt > now)
+            .FirstOrDefaultAsync();
+
+        if (match is null)
+            return null;
+
+        match.ConsumedAt = now;
+        return new LoginResult(student.Id);
+    }
+
+    // Почта вводится как придётся (регистр клавиатуры телефона) - ищем без учёта регистра.
+    // При нескольких совпадениях (гипотетические дубликаты в разном регистре) карточка не выбирается наугад.
+    private async Task<Student?> FindByEmailOrNullAsync(string email)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        var matches = await _db.Students
+            .Where(s => s.Email.ToLower() == normalized)
+            .ToListAsync();
+        return matches.Count == 1 ? matches[0] : null;
+    }
+
+    private static string Hash(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
