+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentRow(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonStartsAt);
+
+// Приложение инструктора.
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    // Закреплённые ученики, которые сейчас учатся - в виде карточки, как в выгрузке для инструктора
+    // (паспорт и почта скрыты), плюс дата и время ближайшего занятия вождения.
+    public async Task<List<InstructorStudentRow>> GetLearningStudentsAsync(int instructorId)
+    {
+        var now = DateTime.UtcNow;
+
+        var raw = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .Select(s => new
+            {
+                s.Id,
+                s.FullName,
+                s.Phone,
+                s.Email,
+                s.PassportNo,
+                NextLessonStartsAt = _db.Lessons
+                    .Where(l => l.StudentId == s.Id && l.StartsAt >= now)
+                    .OrderBy(l => l.StartsAt)
+                    .Select(l => (DateTime?)l.StartsAt)
+                    .FirstOrDefault(),
+            })
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        return raw.Select(s => new InstructorStudentRow(
+                s.Id, s.FullName, s.Phone, Mask.Email(s.Email), Mask.Passport(s.PassportNo), s.NextLessonStartsAt))
+            .ToList();
+    }
+}
