+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesByInstructorRow(int InstructorId, string InstructorFullName, bool InstructorDismissed, int GraduatesCount);
+
+// Отчёты для продления лицензии автошколы.
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Выпускники за год по каждому инструктору, включая уже уволенных:
+    // стандартный фильтр скрывает уволенных инструкторов, здесь он снят явно, а SchoolId проверяется заново.
+    public Task<List<GraduatesByInstructorRow>> GraduatesByInstructorAsync(int year)
+    {
+        var schoolId = _db.SchoolId;
+        var from = new DateOnly(year, 1, 1);
+        var to = new DateOnly(year, 12, 31);
+
+        var instructors = _db.Instructors.IgnoreQueryFilters()
+            .Where(i => i.SchoolId == schoolId);
+
+        return _db.Students.IgnoreQueryFilters()
+            .Where(s => s.SchoolId == schoolId
+                        && s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn.HasValue
+                        && s.GraduatedOn.Value >= from && s.GraduatedOn.Value <= to
+                        && s.InstructorId != null)
+            .Join(instructors, s => s.InstructorId, i => i.Id, (s, i) => i)
+            .GroupBy(i => new { i.Id, i.FullName, i.IsDeleted })
+            .Select(g => new GraduatesByInstructorRow(g.Key.Id, g.Key.FullName, g.Key.IsDeleted, g.Count()))
+            .OrderBy(r => r.InstructorFullName)
+            .ToListAsync();
+    }
+}
