+using System.Linq.Expressions;
+
 namespace Shop.Data;
 
 public class OrderRepository
@@ -6,4 +8,31 @@ public class OrderRepository
     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    // Тот же критерий, что и в Order.IsOverdue, но как выражение: вызов самого
+    // инстанс-метода внутри LINQ-запроса EF Core не транслирует в SQL.
+    private static Expression<Func<Order, bool>> OverdueFilter(DateTime now) =>
+        o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now;
+
+    private static readonly Expression<Func<Order, OrderSummaryDto>> ToSummary =
+        o => new OrderSummaryDto(o.Id, o.Customer.Name, o.Total, o.Items.Count);
+
+    public Task<List<OrderSummaryDto>> GetActiveSummariesAsync() =>
+        _db.Orders.AsNoTracking()
+            .Where(o => o.Status == "active")
+            .Select(ToSummary)
+            .ToListAsync();
+
+    public async Task<Dictionary<string, int>> GetActiveCountsByCategoryAsync() =>
+        await _db.Orders.AsNoTracking()
+            .Where(o => o.Status == "active")
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    public Task<List<OrderSummaryDto>> GetOverdueSummariesAsync(DateTime now) =>
+        _db.Orders.AsNoTracking()
+            .Where(OverdueFilter(now))
+            .Select(ToSummary)
+            .ToListAsync();
 }
