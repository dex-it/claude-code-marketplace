+namespace Shop.Data;
+
+// Только чтение: данные для страницы отчётов. Опирается на OrderRepository,
+// который делает выборку и группировку на стороне БД (не в памяти).
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    // (а) Активные заказы: Id, имя клиента, Total, число позиций.
+    public Task<List<OrderSummaryDto>> GetActiveOrdersAsync() =>
+        _orders.GetActiveSummariesAsync();
+
+    // (б) Число активных заказов по категориям.
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync() =>
+        _orders.GetActiveCountsByCategoryAsync();
+
+    // (в) Просроченные заказы на момент now (правило см. Order.IsOverdue).
+    // now должен быть того же DateTimeKind, что и CreatedAt (Unspecified,
+    // колонка timestamp without time zone) — иначе сравнение будет некорректным.
+    public Task<List<OrderSummaryDto>> GetOverdueOrdersAsync(DateTime now) =>
+        _orders.GetOverdueSummariesAsync(now);
+}
