+    public async Task FreezeMemberAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Количество дней должно быть больше нуля");
+
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        member.FreezeStartedAt = now;
+        member.FreezeUntil = now.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeMemberAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FreezeStartedAt = null;
+        member.FreezeUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    // "Тайный гость": случайное занятие из ближайших 7 дней.
+    public async Task<QualitySessionDto?> GetRandomQualitySessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        var sessionIds = await _db.Sessions
+            .Where(s => s.StartsAt >= now && s.StartsAt <= until)
+            .Select(s => s.Id)
+            .ToListAsync();
+
+        if (sessionIds.Count == 0)
+            return null;
+
+        var pickedId = sessionIds[Random.Shared.Next(sessionIds.Count)];
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .FirstAsync(s => s.Id == pickedId);
+
+        var members = session.Enrollments
+            .Where(e => e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToList();
+
+        return new QualitySessionDto(session.Id, session.Course.Title, session.Course.Trainer.FullName,
+            session.Hall.Name, session.StartsAt, members);
+    }
 }
