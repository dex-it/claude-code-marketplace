+namespace Shop.Data;
+
+// Использует IDbContextFactory, а не внедрённый ShopDbContext: сервис предназначен
+// для вызова из BackgroundService (ночная очистка) и не должен зависеть от чужого scope.
+public class CatalogMaintenance
+{
+    private readonly IDbContextFactory<ShopDbContext> _dbFactory;
+    private const int DeleteBatchSize = 5_000;
+
+    public CatalogMaintenance(IDbContextFactory<ShopDbContext> dbFactory) => _dbFactory = dbFactory;
+
+    // (а) Массовый пересчёт цены - без загрузки строк в память и без трекинга.
+    public async Task RaisePricesAsync(string category, CancellationToken ct = default)
+    {
+        using var db = await _dbFactory.CreateDbContextAsync(ct);
+        await db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * 1.1m), ct);
+    }
+
+    // (б) Ночная очистка AuditLogs старше года.
+    // ExecuteDelete не поддерживает Skip/Take, поэтому батчи режем через LIMIT в сыром SQL
+    // (значения передаются как параметры интерполяции, а не конкатенацией строки).
+    // Каждый вызов ExecuteSqlInterpolatedAsync - отдельная короткая транзакция,
+    // так что ~40 млн строк не удаляются одним махом с долгой блокировкой таблицы.
+    public async Task CleanupOldAuditLogsAsync(TimeSpan retention, CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow - retention;
+        using var db = await _dbFactory.CreateDbContextAsync(ct);
+
+        int deleted;
+        do
+        {
+            deleted = await db.Database.ExecuteSqlInterpolatedAsync($@"
+                DELETE FROM ""AuditLogs""
+                WHERE ""Id"" IN (
+                    SELECT ""Id"" FROM ""AuditLogs""
+                    WHERE ""At"" < {cutoff}
+                    ORDER BY ""Id""
+                    LIMIT {DeleteBatchSize}
+                )", ct);
+        } while (deleted > 0 && !ct.IsCancellationRequested);
+    }
+
+    // (в) Пополнение остатков: одна выборка + один SaveChanges, без цикла по SaveChanges.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> increments, CancellationToken ct = default)
+    {
+        var totals = new Dictionary<Guid, int>();
+        foreach (var (id, add) in increments)
+            totals[id] = totals.GetValueOrDefault(id) + add;
+
+        if (totals.Count == 0) return;
+
+        using var db = await _dbFactory.CreateDbContextAsync(ct);
+        var ids = totals.Keys.ToList();
+        var products = await db.Products.Where(p => ids.Contains(p.Id)).ToListAsync(ct);
+
+        foreach (var product in products)
+            product.Stock += totals[product.Id];
+
+        await db.SaveChangesAsync(ct);
+    }
+
+    // (г) Создание продукта: Guid генерируется на клиенте, поэтому обычный Add достаточен.
+    public async Task<Product> CreateProductAsync(
+        string sku, string category, string warehouse, decimal price, int stock, CancellationToken ct = default)
+    {
+        using var db = await _dbFactory.CreateDbContextAsync(ct);
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Category = category,
+            Warehouse = warehouse,
+            Price = price,
+            Stock = stock
+        };
+
+        db.Products.Add(product);
+        await db.SaveChangesAsync(ct);
+        return product;
+    }
+}
