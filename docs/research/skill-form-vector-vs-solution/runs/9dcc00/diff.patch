+using Microsoft.EntityFrameworkCore;
+
+namespace FlowStudio.Schedule;
+
+public record FreezeDto(int MemberId, DateTime FrozenFrom, DateTime FrozenUntil);
+
+// Конфликт состояния абонемента — отдаётся как 409.
+public class MembershipConflictException : InvalidOperationException
+{
+    public MembershipConflictException(string message) : base(message) { }
+}
+
+public class MembershipService
+{
+    public const int MaxFreezeDays = 365;
+
+    private readonly StudioDbContext _db;
+
+    public MembershipService(StudioDbContext db) => _db = db;
+
+    // Заморожен ли абонемент в момент времени at (UTC).
+    public static Task<bool> IsFrozenAtAsync(StudioDbContext db, int memberId, DateTime at,
+        CancellationToken ct = default) =>
+        db.MemberFreezes.AnyAsync(f => f.MemberId == memberId && f.StartsAt <= at && f.EndsAt > at, ct);
+
+    public async Task<FreezeDto> FreezeAsync(int memberId, int days)
+    {
+        if (days < 1 || days > MaxFreezeDays)
+            throw new ArgumentOutOfRangeException(nameof(days), $"Срок заморозки: от 1 до {MaxFreezeDays} дней");
+
+        if (!await _db.Members.AnyAsync(m => m.Id == memberId))
+            throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        if (await IsFrozenAtAsync(_db, memberId, now))
+            throw new MembershipConflictException("Абонемент уже заморожен");
+
+        var freeze = new MemberFreeze
+        {
+            MemberId = memberId,
+            StartsAt = now,
+            EndsAt = now.AddDays(days),
+        };
+        _db.MemberFreezes.Add(freeze);
+        await _db.SaveChangesAsync();
+        return new FreezeDto(memberId, freeze.StartsAt, freeze.EndsAt);
+    }
+
+    // Досрочное снятие: активная заморозка заканчивается сейчас.
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var now = DateTime.UtcNow;
+        var active = await _db.MemberFreezes
+            .Where(f => f.MemberId == memberId && f.StartsAt <= now && f.EndsAt > now)
+            .ToListAsync();
+        if (active.Count == 0)
+            throw new KeyNotFoundException("Активной заморозки нет");
+
+        foreach (var f in active)
+        {
+            f.EndsAt = now;
+            f.LiftedAt = now;
+        }
+        await _db.SaveChangesAsync();
+    }
+}
