     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
-    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
+    public int Complexity { get; set; }              // сложность комплектации, 1..5
+    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone, значение всегда UTC (Kind=Utc в коде)
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
     public List<OrderItem> Items { get; set; } = new();
@@ -43,8 +44,34 @@ public class ShopDbContext : DbContext
     public DbSet<AuditLog> AuditLogs => Set<AuditLog>();
     protected override void OnModelCreating(ModelBuilder b)
     {
-        b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+        var order = b.Entity<Order>();
+
+        order.HasQueryFilter(o => !o.IsDeleted);
+
+        order.Property(o => o.Complexity).IsRequired();
+        order.ToTable(t => t.HasCheckConstraint("CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Колонка остаётся timestamp without time zone (на неё смотрят отчёты DBA).
+        // Конвертер нормализует значение на запись/чтение так, чтобы в коде всегда был Kind=Utc.
+        order.Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                v => DateTime.SpecifyKind(v.ToUniversalTime(), DateTimeKind.Unspecified),
+                v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
+        // Soft-delete у Order: физический DELETE FROM orders не должен каскадно уносить Items/Payments
+        // в БД (DB-level NO ACTION), но при явном order.Items.Clear()/Payments.Clear() через EF
+        // осиротевшие записи (required FK) удаляются штатно — ClientCascade даёт это client-side,
+        // не создавая ON DELETE CASCADE constraint на стороне БД.
+        order.HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .OnDelete(DeleteBehavior.ClientCascade);
+
+        order.HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .OnDelete(DeleteBehavior.ClientCascade);
     }
 }
