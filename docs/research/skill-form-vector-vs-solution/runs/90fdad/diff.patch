+        var newCodes = newItems.Select(i => i.WorkCode).ToHashSet();
+        var oldCodes = plan.Items.Select(i => i.WorkCode).ToHashSet();
+
+        foreach (var oldItem in plan.Items.Where(i => !newCodes.Contains(i.WorkCode)).ToList())
+            plan.Items.Remove(oldItem);
+
+        foreach (var newItem in newItems)
+        {
+            var existingItem = plan.Items.FirstOrDefault(i => i.WorkCode == newItem.WorkCode);
+            if (existingItem is null)
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+            else
+            {
+                existingItem.Title = newItem.Title;
+                existingItem.PeriodDays = newItem.PeriodDays;
+            }
+        }
+
