+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    private const string Subject = "Shop";
+
+    private readonly ShopDbContext _db;
+    private readonly IEmailSender _email;
+
+    public CustomerNotifier(ShopDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Список id приходит из маркетинговой системы: может быть большим и содержать дубли.
+    public async Task NotifyCustomers(IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        // Один обход входа, дубли снимаются: один id - одно письмо.
+        var ids = customerIds.Distinct().ToArray();
+        if (ids.Length == 0) return;
+
+        // Один запрос: Npgsql передаёт массив одним параметром (Id = ANY(@ids)); берём только Email.
+        var emails = await _db.Customers
+            .Where(c => ids.Contains(c.Id))
+            .Select(c => c.Email)
+            .ToListAsync(ct);
+
+        foreach (var email in emails)
+            await _email.SendAsync(email, Subject, text, ct);
+    }
+}
