+            .ToLoanRows(today, _rules)
+            .OrderByDescending(r => r.Fine)
+            .ToListAsync();
+
+        return new DebtorsReport
+        {
+            Debtors = debtors,
+            TotalFines = debtors.Sum(r => r.Fine),
