+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // Карточка заказа: коллекции Items и Payments в одном Include дают cartesian product,
+    // поэтому используем AsSplitQuery, чтобы не перемножать строки.
+    public Task<Order?> GetOrderCardAsync(Guid orderId) =>
+        _db.Orders
+            .AsNoTracking()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .SingleOrDefaultAsync(o => o.Id == orderId);
+
+    // У клиента могут быть тысячи заказов с items/payments - split query обязателен,
+    // иначе один Include с двумя коллекциями даст многократно перемноженный результат.
+    public Task<List<Order>> GetCustomerOrdersAsync(Guid customerId) =>
+        _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .ToListAsync();
+
+    // SKU уникален только в паре с warehouse. Если warehouse не передан, а SKU
+    // встречается на нескольких складах - это не ошибка данных, а ожидаемая
+    // неоднозначность запроса, поэтому не используем Single() вслепую.
+    public async Task<Product?> GetProductBySkuAsync(string sku, string? warehouse)
+    {
+        var query = _db.Products.AsNoTracking().Where(p => p.Sku == sku);
+
+        if (warehouse != null)
+            return await query.SingleOrDefaultAsync(p => p.Warehouse == warehouse);
+
+        var matches = await query.Take(2).ToListAsync();
+        if (matches.Count > 1)
+            throw new InvalidOperationException(
+                $"SKU '{sku}' найден на нескольких складах, укажите warehouse.");
+
+        return matches.SingleOrDefault();
+    }
+
+    // Агрегат считается в БД (MAX), без выгрузки всех заказов клиента в память.
+    // Если отгруженных заказов нет, честный non-nullable результат невозможен - кидаем исключение.
+    public async Task<DateTime> GetLastShippedDateAsync(Guid customerId)
+    {
+        var lastShipped = await _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .MaxAsync(o => (DateTime?)o.ShippedAt);
+
+        if (lastShipped is null)
+            throw new InvalidOperationException($"У клиента {customerId} нет отгруженных заказов.");
+
+        return lastShipped.Value;
+    }
+}
