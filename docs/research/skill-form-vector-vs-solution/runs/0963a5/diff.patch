+using Microsoft.EntityFrameworkCore;
+
+namespace FlowStudio.Schedule;
+
+public class MembershipFrozenException : Exception
+{
+    public MembershipFrozenException(string message) : base(message) { }
+}
+
+public static class FreezeQueries
+{
+    public static Task<bool> IsMemberFrozenAtAsync(
+        this StudioDbContext db, int memberId, DateTime pointInTime, CancellationToken ct = default) =>
+        db.MembershipFreezes.AnyAsync(f =>
+            f.MemberId == memberId && f.StartsAt <= pointInTime && pointInTime < f.EndsAt, ct);
+}
+
+public class MembershipService
+{
+    private readonly StudioDbContext _db;
+
+    public MembershipService(StudioDbContext db) => _db = db;
+
+    public async Task FreezeAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Число дней должно быть положительным");
+
+        var memberExists = await _db.Members.AnyAsync(m => m.Id == memberId);
+        if (!memberExists)
+            throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        var alreadyFrozen = await _db.IsMemberFrozenAtAsync(memberId, now);
+        if (alreadyFrozen)
+            throw new InvalidOperationException("Абонемент уже заморожен");
+
+        _db.MembershipFreezes.Add(new MembershipFreeze
+        {
+            MemberId = memberId,
+            StartsAt = now,
+            EndsAt = now.AddDays(days),
+        });
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var now = DateTime.UtcNow;
+        var active = await _db.MembershipFreezes
+            .Where(f => f.MemberId == memberId && f.StartsAt <= now && now < f.EndsAt)
+            .SingleOrDefaultAsync()
+            ?? throw new KeyNotFoundException("Активная заморозка не найдена");
+
+        active.EndsAt = now;
+        await _db.SaveChangesAsync();
+    }
+}
