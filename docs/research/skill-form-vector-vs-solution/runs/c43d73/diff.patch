+namespace Shop.Data;
+
+public record ActiveOrderReportItem(Guid Id, string CustomerName, decimal Total, int ItemsCount);
+
+public record OverdueOrderReportItem(Guid Id, string CustomerName, decimal Total, DateTime CreatedAt, DateTime? ShippedAt);
+
+// Read-only reporting queries backed by OrderRepository.Query(). No tracking, no writes.
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public Task<List<ActiveOrderReportItem>> GetActiveOrdersAsync() =>
+        _orders.Query()
+            .Where(o => o.Status == "active")
+            .Select(o => new ActiveOrderReportItem(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync() =>
+        _orders.Query()
+            .Where(o => o.Status == "active")
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    // Mirrors Order.IsOverdue(now) inline, since instance methods don't translate to SQL.
+    public Task<List<OverdueOrderReportItem>> GetOverdueOrdersAsync(DateTime now) =>
+        _orders.Query()
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Select(o => new OverdueOrderReportItem(o.Id, o.Customer.Name, o.Total, o.CreatedAt, o.ShippedAt))
+            .ToListAsync();
+}
