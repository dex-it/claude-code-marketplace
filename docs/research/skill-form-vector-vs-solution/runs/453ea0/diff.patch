+namespace Shop.Data;
+
+// CatalogMaintenance и ShopDbContext - scoped, поэтому в фоновом сервисе (singleton)
+// нельзя держать DbContext полем; на каждый прогон создаётся свой scope.
+public class AuditLogCleanupHostedService : BackgroundService
+{
+    private readonly IServiceScopeFactory _scopeFactory;
+    private readonly TimeSpan _interval;
+
+    public AuditLogCleanupHostedService(IServiceScopeFactory scopeFactory, TimeSpan? interval = null)
+    {
+        _scopeFactory = scopeFactory;
+        _interval = interval ?? TimeSpan.FromDays(1);
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        using var timer = new PeriodicTimer(_interval);
+        do
+        {
+            using var scope = _scopeFactory.CreateScope();
+            var maintenance = scope.ServiceProvider.GetRequiredService<CatalogMaintenance>();
+            await maintenance.PurgeOldAuditLogsAsync(ct: stoppingToken);
+        } while (await timer.WaitForNextTickAsync(stoppingToken));
+    }
+}
