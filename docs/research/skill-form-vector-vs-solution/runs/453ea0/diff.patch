+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (а) Поднять цены на 10% всем продуктам категории.
+    // ExecuteUpdate - один UPDATE на сервере, без загрузки сущностей и без трекинга.
+    public Task<int> RaisePricesAsync(string category, decimal percent = 0.10m, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * (1 + percent)), ct);
+
+    // (б) Ночная очистка AuditLogs старше года.
+    // Таблица ~50 млн строк, ~40 млн на удаление - один DELETE на всю выборку держал бы
+    // многочасовую транзакцию и лок/раздутие WAL, поэтому удаляем пачками по batchSize,
+    // каждая пачка - собственная неявная транзакция (autocommit).
+    // At маппится по умолчанию на timestamp with time zone => сравнение только с DateTime.Kind=Utc.
+    public async Task<long> PurgeOldAuditLogsAsync(
+        TimeSpan? retention = null,
+        int batchSize = 5_000,
+        TimeSpan? delayBetweenBatches = null,
+        CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow - (retention ?? TimeSpan.FromDays(365));
+        long totalDeleted = 0;
+        int deletedInBatch;
+        do
+        {
+            deletedInBatch = await _db.Database.ExecuteSqlInterpolatedAsync($@"
+                DELETE FROM ""AuditLogs""
+                WHERE ""Id"" IN (
+                    SELECT ""Id"" FROM ""AuditLogs""
+                    WHERE ""At"" < {cutoff}
+                    ORDER BY ""Id""
+                    LIMIT {batchSize}
+                )", ct);
+            totalDeleted += deletedInBatch;
+
+            if (deletedInBatch > 0 && delayBetweenBatches is { } delay)
+                await Task.Delay(delay, ct);
+        } while (deletedInBatch > 0);
+
+        return totalDeleted;
+    }
+
+    // (в) Загрузить продукты и увеличить Stock, сохранить одним SaveChanges.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var list = items as ICollection<(Guid Id, int Add)> ?? items.ToList();
+        var ids = list.Select(i => i.Id).ToList();
+
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToDictionaryAsync(p => p.Id, ct);
+
+        foreach (var (id, add) in list)
+        {
+            if (products.TryGetValue(id, out var product))
+                product.Stock += add;
+        }
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (г) Создать продукт с новым Guid. Id генерируется на клиенте, поэтому Add без Async.
+    public async Task<Product> CreateProductAsync(
+        string sku, string warehouse, string category, decimal price, int stock = 0, CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Warehouse = warehouse,
+            Category = category,
+            Price = price,
+            Stock = stock,
+        };
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
