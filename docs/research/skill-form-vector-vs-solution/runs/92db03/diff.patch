@@ -0,0 +1,29 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+// Период задаётся двумя моментами времени с часовым поясом фронта (ISO 8601);
+// сравнение идёт по абсолютному моменту IssuedAt, без привязки к поясу филиала.
+public record LoansByBranchPeriodRequest(DateTimeOffset From, DateTimeOffset To);
+
+public record LoansByBranchRow(int BranchId, string BranchName, int LoanCount);
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    public async Task<List<LoansByBranchRow>> LoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        if (to <= from)
+            throw new InvalidOperationException("Период задан некорректно");
+
+        return await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .GroupBy(l => new { l.BranchId, l.Branch.Name })
+            .Select(g => new LoansByBranchRow(g.Key.BranchId, g.Key.Name, g.Count()))
+            .OrderByDescending(r => r.LoanCount)
+            .ToListAsync();
+    }
+}
