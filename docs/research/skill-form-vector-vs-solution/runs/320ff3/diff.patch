+    // E-mail уникален только в рамках мероприятия, а в один день на площадке идут несколько
+    // мероприятий. Поэтому ищем среди мероприятий сегодняшнего дня (или по явному eventId),
+    // а при неоднозначности отдаём стойке список для выбора.
+    public async Task<CheckInResult> CheckInAsync(string email, int? eventId)
+    {
+        email = NormalizeEmail(email);
+        var today = DateOnly.FromDateTime(DateTime.Now); // локальная дата площадки
+
+        var query = _db.Registrations
+            .Include(r => r.Event)
+            .Include(r => r.Tickets).ThenInclude(t => t.Workshop)
+            .Where(r => r.Email == email);
+        query = eventId is int id
+            ? query.Where(r => r.EventId == id)
+            : query.Where(r => r.Event.Date == today);
+
+        var found = await query.ToListAsync();
+        if (found.Count == 0)
+            return new CheckInResult(CheckInStatus.NotFound);
+        if (found.Count > 1)
+            return new CheckInResult(CheckInStatus.Ambiguous, Candidates: found
+                .Select(r => new CheckInCandidateDto(r.EventId, r.Event.Title))
+                .OrderBy(c => c.EventTitle)
+                .ToList());
+
+        var registration = found[0];
+        var alreadyCheckedIn = registration.CheckedInAt is not null;
+        if (!alreadyCheckedIn)
+        {
+            registration.CheckedInAt = DateTime.UtcNow;
+            await _db.SaveChangesAsync();
+        }
+
+        // WorkshopTicket создаётся только при оплате (PaidOn обязателен), так что все билеты оплачены.
+        var workshops = registration.Tickets
+            .Select(t => t.Workshop)
+            .OrderBy(w => w.StartsAt)
+            .Select(w => new BadgeWorkshopDto(w.Title, w.StartsAt))
+            .ToList();
+
+        return new CheckInResult(CheckInStatus.Ok, new BadgeDto(
+            registration.Id,
+            registration.FullName,
+            registration.Company,
+            registration.Event.Title,
+            registration.CheckedInAt!.Value,
+            alreadyCheckedIn,
+            workshops));
+    }
+
+    public async Task<List<HallRevenueDto>> GetWorkshopRevenueAsync(int year, int quarter)
+    {
+        var from = new DateOnly(year, (quarter - 1) * 3 + 1, 1);
+        var to = from.AddMonths(3);
+
+        // IgnoreQueryFilters: выручка по залам, выведенным из эксплуатации, тоже должна попасть в отчёт.
+        // Сумма берётся из фактических оплат (PaidAmount), а не из текущей цены воркшопа.
+        return await _db.WorkshopTickets
+            .IgnoreQueryFilters()
+            .Where(t => t.PaidOn >= from && t.PaidOn < to)
+            .GroupBy(t => new { t.Workshop.HallId, t.Workshop.Hall.Name })
+            .Select(g => new HallRevenueDto(g.Key.HallId, g.Key.Name, g.Sum(t => t.PaidAmount), g.Count()))
+            .OrderBy(r => r.HallName)
+            .ToListAsync();
+    }
+
+    public async Task<ProgramDto?> GetCurrentProgramAsync(int eventId)
+    {
+        // PublishedOn хранит только дату: при нескольких публикациях за день побеждает более поздняя (больший Id).
+        return await _db.ProgramVersions
+            .AsNoTracking()
+            .Where(v => v.EventId == eventId)
+            .OrderByDescending(v => v.PublishedOn)
+            .ThenByDescending(v => v.Id)
+            .Select(v => new ProgramDto(
+                v.EventId,
+                v.Id,
+                v.PublishedOn,
+                v.Items
+                    .OrderBy(i => i.StartsAt)
+                    .ThenBy(i => i.Id)
+                    .Select(i => new ProgramItemDto(i.StartsAt, i.Title, i.Speaker, i.HallName))
+                    .ToList()))
+            .FirstOrDefaultAsync();
+    }
+
+    private static string NormalizeEmail(string email) => email.Trim().ToLowerInvariant();
