+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearReportItem(int Month, bool IsClosed, DateOnly? ActSignedOn, decimal Hours);
+
+public record YearReportDto(int Year, List<YearReportItem> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearReportDto> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .Where(p => p.Month.Year == year)
+            .ToListAsync();
+
+        var closedByMonth = closedPeriods.ToDictionary(p => p.Month.Month, p => (p.ActSignedOn, p.ClosedAt));
+
+        var entries = await _db.TimeEntries
+            .Where(t => t.WorkDate.Year == year)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToListAsync();
+
+        var hoursByMonth = entries.ToDictionary(e => e.Month, e => e.Hours);
+
+        var months = new List<YearReportItem>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var isClosed = closedByMonth.TryGetValue(month, out var closed);
+            var hours = hoursByMonth.GetValueOrDefault(month, 0);
+            months.Add(new YearReportItem(month, isClosed, isClosed ? closed.ActSignedOn : null, hours));
+        }
+
+        return new YearReportDto(year, months);
+    }
+}
