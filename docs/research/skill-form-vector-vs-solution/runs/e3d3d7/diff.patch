+    // Стойка регистрации. Один e-mail может быть зарегистрирован на разные мероприятия (уникален только
+    // в паре с EventId), поэтому ищем среди мероприятий сегодняшнего дня; если их несколько
+    // (в разных залах в один день) и eventId не указан — просим уточнить, а не отмечаем наугад.
+    public async Task<CheckInResult> CheckInAsync(string email, int? eventId)
+    {
+        email = email.Trim().ToLowerInvariant();
+        // Дата по локальному времени сервера площадки, а не по UTC: иначе около полуночи «сегодня» съезжает.
+        var today = DateOnly.FromDateTime(DateTime.Now);
+
+        var query = _db.Registrations.Where(r => r.Email == email);
+        query = eventId is int id
+            ? query.Where(r => r.EventId == id)
+            : query.Where(r => r.Event.Date == today);
+
+        var candidates = await query
+            .Select(r => new { r.Id, r.EventId, r.Event.Title })
+            .ToListAsync();
+
+        if (candidates.Count == 0)
+            return new CheckInResult(CheckInStatus.NotFound);
+        if (candidates.Count > 1)
+            return new CheckInResult(CheckInStatus.Ambiguous,
+                Candidates: candidates.Select(c => new EventChoiceDto(c.EventId, c.Title)).ToList());
+
+        var registration = await _db.Registrations.SingleAsync(r => r.Id == candidates[0].Id);
+        // Повторное прикладывание не перезаписывает время первого прихода.
+        registration.CheckedInAt ??= DateTime.UtcNow;
+        await _db.SaveChangesAsync();
+
+        // Проекция без Hall: глобальный фильтр удалённых залов не должен прятать оплаченные воркшопы.
+        var workshops = await _db.WorkshopTickets
+            .Where(t => t.RegistrationId == registration.Id)
+            .OrderBy(t => t.Workshop.StartsAt).ThenBy(t => t.Workshop.Title)
+            .Select(t => t.Workshop.Title)
+            .ToListAsync();
+
+        return new CheckInResult(CheckInStatus.Ok, new BadgeDto(
+            registration.Id, registration.FullName, registration.Company, candidates[0].Title,
+            registration.CheckedInAt.Value, workshops));
+    }
+
+    // Выручка воркшопов за квартал по дате оплаты (PaidOn), в разрезе залов.
+    public async Task<WorkshopReportDto> GetWorkshopRevenueAsync(int year, int quarter)
+    {
+        if (quarter is < 1 or > 4)
+            throw new ArgumentOutOfRangeException(nameof(quarter));
+
+        var from = new DateOnly(year, (quarter - 1) * 3 + 1, 1);
+        var to = from.AddMonths(3); // граница не включается
+
+        // IgnoreQueryFilters: деньги, полученные за воркшопы в залах, выведенных потом из эксплуатации,
+        // обязаны попасть в отчёт. Считаем фактически оплаченные суммы, а не текущий прайс воркшопа.
+        var halls = await _db.WorkshopTickets
+            .IgnoreQueryFilters()
+            .Where(t => t.PaidOn >= from && t.PaidOn < to)
+            .GroupBy(t => new { t.Workshop.HallId, t.Workshop.Hall.Name })
+            .Select(g => new HallRevenueDto(g.Key.HallId, g.Key.Name, g.Sum(t => t.PaidAmount), g.Count()))
+            .ToListAsync();
+
+        halls = halls.OrderBy(h => h.HallName).ThenBy(h => h.HallId).ToList();
+        return new WorkshopReportDto(year, quarter, from, to.AddDays(-1), halls,
+            halls.Sum(h => h.Revenue), halls.Sum(h => h.SeatsSold));
+    }
+
+    // Актуальная программа: последняя опубликованная версия. PublishedOn — только дата, в один день
+    // версий может быть несколько, поэтому при равенстве берём более позднюю по Id.
+    public async Task<ProgramDto?> GetCurrentProgramAsync(int eventId)
+    {
+        var program = await _db.ProgramVersions
+            .Where(v => v.EventId == eventId)
+            .OrderByDescending(v => v.PublishedOn).ThenByDescending(v => v.Id)
+            .Select(v => new
+            {
+                v.Id,
+                v.PublishedOn,
+                v.Event.Title,
+                v.Event.Date,
+                Items = v.Items
+                    .OrderBy(i => i.StartsAt).ThenBy(i => i.Id)
+                    .Select(i => new ProgramItemDto(i.StartsAt, i.Title, i.Speaker, i.HallName))
+                    .ToList(),
+            })
+            .FirstOrDefaultAsync();
+
+        return program is null
+            ? null
+            : new ProgramDto(eventId, program.Title, program.Date, program.Id, program.PublishedOn, program.Items);
+    }
