+namespace Domovoy.Housing.Migrations;
+
+// Уникальность лицевого счёта. В проде есть задвоения после переноса из биллинга 2023:
+// строки не удаляем (на них висят заявки), старые копии помечаем is_legacy_duplicate
+// и исключаем из частичного уникального индекса - актуальной остаётся запись с максимальным id,
+// как и в FindByAccountAsync.
+[DbContext(typeof(HousingDbContext))]
+[Migration("20261002120000_UniqueAccountNumber")]
+public partial class UniqueAccountNumber : Migration
+{
+    protected override void Up(MigrationBuilder migrationBuilder)
+    {
+        migrationBuilder.AddColumn<bool>(
+            name: "is_legacy_duplicate",
+            table: "apartments",
+            type: "boolean",
+            nullable: false,
+            defaultValue: false);
+
+        // Миграция идёт до раскатки нового кода: старое приложение ещё может заводить квартиры.
+        // Блокируем запись в apartments до конца транзакции миграции, чтобы между разметкой
+        // дублей и созданием индекса не появился новый дубль. Таблица небольшая - блокировка короткая;
+        // lock_timeout не даст повесить прод, если таблицу держит долгая транзакция (тогда просто перезапустить).
+        migrationBuilder.Sql("SET LOCAL lock_timeout = '10s';");
+        migrationBuilder.Sql("LOCK TABLE apartments IN SHARE ROW EXCLUSIVE MODE;");
+
+        migrationBuilder.Sql("""
+            UPDATE apartments a
+            SET is_legacy_duplicate = TRUE
+            WHERE a.account_number <> ''
+              AND EXISTS (SELECT 1 FROM apartments n
+                          WHERE n.account_number = a.account_number AND n.id > a.id);
+            """);
+
+        migrationBuilder.DropIndex(
+            name: "ix_apartments_account_number",
+            table: "apartments");
+
+        migrationBuilder.CreateIndex(
+            name: "ux_apartments_account_number",
+            table: "apartments",
+            column: "account_number",
+            unique: true,
+            filter: "account_number <> '' AND NOT is_legacy_duplicate");
+    }
+
+    protected override void Down(MigrationBuilder migrationBuilder)
+    {
+        migrationBuilder.DropIndex(
+            name: "ux_apartments_account_number",
+            table: "apartments");
+
+        migrationBuilder.CreateIndex(
+            name: "ix_apartments_account_number",
+            table: "apartments",
+            column: "account_number");
+
+        migrationBuilder.DropColumn(
+            name: "is_legacy_duplicate",
+            table: "apartments");
