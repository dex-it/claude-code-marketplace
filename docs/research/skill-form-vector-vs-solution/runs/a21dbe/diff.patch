+    // Замена плана дома целиком. Сопоставление по WorkCode: существующие работы обновляются
+    // (их история выполнения сохраняется), новые добавляются, отсутствующие в присланном плане
+    // архивируются, а не удаляются - иначе каскадом пропадут акты. Повторно присланная архивная
+    // работа возвращается в план вместе со своей историей.
+    public async Task ReplacePlanAsync(int houseId, IReadOnlyList<PlanItemInput> input)
+    {
+        var items = Validate(input);
+
+        await using var tx = await _db.Database.BeginTransactionAsync();
+
+        // Сериализуем параллельные PUT по одному дому (в т.ч. создание плана, которого ещё нет).
+        // ToListAsync, а не AnyAsync: EF не должен оборачивать FOR UPDATE в подзапрос.
+        var locked = await _db.Database
+            .SqlQuery<int>($"SELECT id AS \"Value\" FROM houses WHERE id = {houseId} FOR UPDATE")
+            .ToListAsync();
+        if (locked.Count == 0)
+            throw new KeyNotFoundException($"Дом {houseId} не найден");
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .Where(p => p.HouseId == houseId)
+            .OrderBy(p => p.Id)
+            .FirstOrDefaultAsync();
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var now = DateTime.UtcNow;
+        var existing = plan.Items.ToDictionary(i => i.WorkCode, StringComparer.Ordinal);
+
+        foreach (var src in items)
+        {
+            if (existing.TryGetValue(src.WorkCode, out var item))
+            {
+                item.Title = src.Title;
+                item.PeriodDays = src.PeriodDays;
+                item.ArchivedAt = null;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem { WorkCode = src.WorkCode, Title = src.Title, PeriodDays = src.PeriodDays });
+            }
+        }
+
+        var incomingCodes = items.Select(i => i.WorkCode).ToHashSet(StringComparer.Ordinal);
+        foreach (var item in plan.Items.Where(i => i.Id != 0 && i.ArchivedAt == null && !incomingCodes.Contains(i.WorkCode)))
+            item.ArchivedAt = now;
+
+        await _db.SaveChangesAsync();
+        await tx.CommitAsync();
+    }
+
+    private static List<PlanItemInput> Validate(IReadOnlyList<PlanItemInput>? input)
+    {
+        if (input is null)
+            throw new ArgumentException("План не передан");
+
+        var result = new List<PlanItemInput>(input.Count);
+        var seen = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var i in input)
+        {
+            var code = i.WorkCode?.Trim() ?? "";
+            var title = i.Title?.Trim() ?? "";
+            if (code.Length == 0)
+                throw new ArgumentException("Не указан код работы");
+            if (title.Length == 0)
+                throw new ArgumentException($"Не указано название работы {code}");
+            if (i.PeriodDays <= 0)
+                throw new ArgumentException($"Периодичность работы {code} должна быть положительной");
+            if (!seen.Add(code))
+                throw new ArgumentException($"Работа {code} указана в плане дважды");
+            result.Add(new PlanItemInput(code, title, i.PeriodDays));
+        }
+        return result;
+    }
 }
