+namespace Domovoy.Housing;
+
+public static class Endpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // GET /requests?text=&status=&page=&pageSize=&sort=id|created_at|address|status|category&dir=asc|desc
+        app.MapGet("/requests", async ([AsParameters] RequestSearch search, HousingService svc) =>
+        {
+            try
+            {
+                return Results.Ok(await svc.SearchAsync(search));
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+        });
+
+        app.MapPost("/houses/{houseId:int}/apartments", async (int houseId, NewApartment body, HousingService svc) =>
+        {
+            try
+            {
+                var id = await svc.AddApartmentAsync(houseId, body.Number, body.AccountNumber);
+                return Results.Created($"/apartments/{id}", new { id });
+            }
+            catch (AccountNumberTakenException ex)
+            {
+                return Results.Conflict(new { error = ex.Message });
+            }
+        });
+
+        app.MapGet("/houses/{id:int}/plan", (int id, PlanService svc) => svc.GetPlanAsync(id));
+
+        // Тело - полный список работ плана: [{ "workCode": "...", "title": "...", "periodDays": 30 }, ...]
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.Ok(await svc.GetPlanAsync(id));
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(new { error = ex.Message });
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+        });
+
+        return app;
+    }
+}
+
+public record NewApartment(string Number, string AccountNumber);
