+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    private const int BatchSize = 500;
+    private const string Subject = "Shop";
+
+    private readonly ShopDbContext _db;
+    private readonly IEmailSender _emailSender;
+
+    public CustomerNotifier(ShopDbContext db, IEmailSender emailSender)
+    {
+        _db = db;
+        _emailSender = emailSender;
+    }
+
+    // Список id приходит из маркетинговой системы: может быть большим, с дубликатами
+    // и с id несуществующих клиентов. Один клиент — одно письмо.
+    public async Task NotifyCustomers(IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        ArgumentNullException.ThrowIfNull(customerIds);
+        ArgumentNullException.ThrowIfNull(text);
+
+        var uniqueIds = customerIds.Distinct().ToList();
+        if (uniqueIds.Count == 0) return;
+
+        foreach (var batch in uniqueIds.Chunk(BatchSize))
+        {
+            var emails = await _db.Customers
+                .Where(c => batch.Contains(c.Id) && c.Email != "")
+                .Select(c => c.Email)
+                .ToListAsync(ct);
+
+            foreach (var email in emails)
+                await _emailSender.SendAsync(email, Subject, text, ct);
+        }
+    }
+}
