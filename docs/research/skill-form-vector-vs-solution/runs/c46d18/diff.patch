@@ -46,10 +46,117 @@ public class ClinicCardService(ClinicDbContext db)
         await db.SaveChangesAsync();
     }
 
-    public async Task UpdateVisitNotesAsync(int visitId, string? notes)
+    public async Task<bool> UpdateVisitAnamnesisAsync(int visitId, string? anamnesis)
     {
-        var visit = await db.Visits.SingleAsync(v => v.Id == visitId);
-        visit.Notes = notes;
+        var visit = await db.Visits.SingleOrDefaultAsync(v => v.Id == visitId);
+        if (visit is null)
+            return false;
+
+        visit.Anamnesis = anamnesis;
+        await db.SaveChangesAsync();
+        return true;
+    }
+
+    // Мягкое удаление клиента вместе с питомцами, их аллергиями и визитами (физически ничего не удаляется,
+    // см. README). Глобальные фильтры не смотрят на родителя, поэтому помечаем каждый уровень явно.
+    // Одна метка DeletedAt на всё - поддержка восстанавливает клиента целиком по ней.
+    public async Task<bool> DeleteOwnerAsync(int ownerId)
+    {
+        DateTime? deletedAt = DateTime.UtcNow;
+
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        var owners = await db.Owners
+            .Where(o => o.Id == ownerId)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(o => o.IsDeleted, true)
+                .SetProperty(o => o.DeletedAt, deletedAt));
+        if (owners == 0)
+            return false;
+
+        // Пока питомцы не помечены, подзапрос видит ровно действующих питомцев клиента
+        var petIds = db.Pets.Where(p => p.OwnerId == ownerId).Select(p => p.Id);
+
+        await db.Visits
+            .Where(v => petIds.Contains(v.PetId))
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(v => v.IsDeleted, true)
+                .SetProperty(v => v.DeletedAt, deletedAt));
+
+        await db.Allergies
+            .Where(a => petIds.Contains(a.PetId))
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(a => a.IsDeleted, true)
+                .SetProperty(a => a.DeletedAt, deletedAt));
+
+        await db.Pets
+            .Where(p => p.OwnerId == ownerId)
+            .ExecuteUpdateAsync(s => s
+                .SetProperty(p => p.IsDeleted, true)
+                .SetProperty(p => p.DeletedAt, deletedAt));
+
+        await tx.CommitAsync();
+        return true;
+    }
+
+    // Форма присылает полный список аллергий. Совпадающие записи остаются как есть, остальные действующие
+    // помечаются удалёнными, недостающие добавляются - прежние значения остаются в истории.
+    public async Task<bool> ReplaceAllergiesAsync(int petId, IReadOnlyList<AllergyInput> allergies)
+    {
+        var wanted = allergies
+            .Select(a => new AllergyInput(
+                a.Allergen?.Trim() ?? "",
+                string.IsNullOrWhiteSpace(a.Reaction) ? null : a.Reaction.Trim(),
+                a.Severity))
+            .ToList();
+
+        if (wanted.Any(a => a.Allergen.Length == 0))
+            throw new ArgumentException("Аллерген не может быть пустым.", nameof(allergies));
+        if (wanted.Any(a => !Enum.IsDefined(a.Severity)))
+            throw new ArgumentException("Неизвестная степень тяжести аллергии.", nameof(allergies));
+        if (wanted.GroupBy(a => a.Allergen, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
+            throw new ArgumentException("Аллерген указан в списке больше одного раза.", nameof(allergies));
+
+        await using var tx = await db.Database.BeginTransactionAsync();
+
+        // Блокировка строки питомца до конца транзакции: два одновременных сохранения формы
+        // выполняются по очереди, и второе видит результат первого.
+        var locked = await db.Database
+            .SqlQuery<int>($"""SELECT "Id" AS "Value" FROM "Pets" WHERE "Id" = {petId} AND NOT "IsDeleted" FOR UPDATE""")
+            .ToListAsync();
+        if (locked.Count == 0)
+            return false;
+
+        var current = await db.Allergies.Where(a => a.PetId == petId).ToListAsync();
+        var deletedAt = DateTime.UtcNow;
+
+        foreach (var allergy in current)
+        {
+            var match = wanted.FindIndex(w =>
+                w.Allergen == allergy.Allergen && w.Reaction == allergy.Reaction && w.Severity == allergy.Severity);
+            if (match >= 0)
+            {
+                wanted.RemoveAt(match);
+                continue;
+            }
+
+            allergy.IsDeleted = true;
+            allergy.DeletedAt = deletedAt;
+        }
+
+        foreach (var input in wanted)
+        {
+            db.Allergies.Add(new Allergy
+            {
+                PetId = petId,
+                Allergen = input.Allergen,
+                Reaction = input.Reaction,
+                Severity = input.Severity
+            });
+        }
+
         await db.SaveChangesAsync();
+        await tx.CommitAsync();
+        return true;
     }
 }
