+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing;
+
+[ApiController]
+[Route("api/[controller]")]
+public class RequestsController : ControllerBase
+{
+    private readonly HousingService _service;
+
+    public RequestsController(HousingService service) => _service = service;
+
+    [HttpPost("{id}/close")]
+    public async Task<IActionResult> CloseRequest(int id, [FromBody] CloseRequestDto dto)
+    {
+        try
+        {
+            await _service.CloseRequestAsync(id, dto.Comment);
+            return Ok();
+        }
+        catch (KeyNotFoundException)
+        {
+            return NotFound();
+        }
+        catch (InvalidOperationException ex)
+        {
+            return StatusCode(409, new { error = ex.Message });
+        }
+    }
+}
+
+[ApiController]
+[Route("api/[controller]")]
+public class HousesController : ControllerBase
+{
+    private readonly PlanService _service;
+
+    public HousesController(PlanService service) => _service = service;
+
+    [HttpPut("{id}/plan")]
+    public async Task<IActionResult> UpdatePlan(int id, [FromBody] List<UpdatePlanItemDto> items)
+    {
+        try
+        {
+            await _service.UpdatePlanAsync(id, items);
+            return Ok();
+        }
+        catch (KeyNotFoundException)
+        {
+            return NotFound();
+        }
+    }
+}
+
+public record CloseRequestDto(string Comment);
