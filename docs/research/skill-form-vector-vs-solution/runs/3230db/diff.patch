+    public async Task UpdatePlanAsync(int houseId, List<UpdatePlanItemDto> items)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId)
+            ?? throw new KeyNotFoundException($"План дома {houseId} не найден");
+
+        var newWorkCodes = items.Select(i => i.WorkCode).ToHashSet();
+        var existingItems = plan.Items.ToDictionary(i => i.WorkCode);
+
+        // Удаляем работы, которых нет в новом плане
+        foreach (var item in plan.Items.ToList())
+        {
+            if (!newWorkCodes.Contains(item.WorkCode))
+            {
+                plan.Items.Remove(item);
+            }
+        }
+
+        // Обновляем или добавляем работы
+        foreach (var newItem in items)
+        {
+            if (existingItems.TryGetValue(newItem.WorkCode, out var existing))
+            {
+                existing.Title = newItem.Title;
+                existing.PeriodDays = newItem.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
 }
