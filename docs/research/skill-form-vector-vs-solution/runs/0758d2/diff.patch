+namespace Shop.Data;
+
+public record OrderSummaryDto(Guid Id, string CustomerName, decimal Total, int ItemCount);
+
+// Read-only queries for the reports page. Projections keep results to the
+// columns/counts actually needed instead of materializing full Order graphs.
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public Task<List<OrderSummaryDto>> GetActiveOrdersAsync() =>
+        _orders.ActiveOrders()
+            .Select(o => new OrderSummaryDto(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync() =>
+        _orders.ActiveOrders()
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    public Task<List<OrderSummaryDto>> GetOverdueOrdersAsync(DateTime now) =>
+        _orders.OverdueOrders(now)
+            .Select(o => new OrderSummaryDto(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+}
diff --git a/OrderRepository.cs b/OrderRepository.cs
index 72637b8..6e149a7 100644
--- a/OrderRepository.cs
+++ b/OrderRepository.cs
@@ -6,4 +6,16 @@ public class OrderRepository
     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    public IQueryable<Order> ActiveOrders() =>
+        _db.Orders.AsNoTracking().Where(o => o.Status == "active");
+
+    // Order.IsOverdue(now) can't be translated by EF (instance method on the entity),
+    // so the rule is inlined here. CreatedAt/the column are "timestamp without time zone",
+    // so `now` is normalized to Kind=Unspecified to avoid Npgsql rejecting a Utc/Local value.
+    public IQueryable<Order> OverdueOrders(DateTime now)
+    {
+        var cutoff = DateTime.SpecifyKind(now, DateTimeKind.Unspecified);
+        return _db.Orders.AsNoTracking().Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < cutoff);
+    }
 }
