+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    private const string Subject = "Shop";
+    // Список из маркетинговой системы может быть большим - грузим адреса порциями.
+    private const int BatchSize = 5000;
+
+    private readonly ShopDbContext _db;
+    private readonly IEmailSender _email;
+
+    public CustomerNotifier(ShopDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task NotifyCustomers(IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        // Один проход по входной последовательности; дубли id не должны давать повторные письма.
+        var ids = customerIds.ToHashSet();
+        if (ids.Count == 0) return;
+
+        foreach (var batch in ids.Chunk(BatchSize))
+        {
+            // Один запрос на порцию (Npgsql: WHERE "Id" = ANY(@ids)), только нужная колонка.
+            var emails = await _db.Customers
+                .AsNoTracking()
+                .Where(c => batch.Contains(c.Id))
+                .Select(c => c.Email)
+                .ToListAsync(ct);
+
+            foreach (var email in emails)
+            {
+                if (string.IsNullOrWhiteSpace(email)) continue;
+                await _email.SendAsync(email, Subject, text, ct);
+            }
+        }
+    }
+}
