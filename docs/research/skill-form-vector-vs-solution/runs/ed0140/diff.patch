new file mode 100644
index 0000000..b4f1654
--- /dev/null
+++ b/.github/workflows/deploy-migrations.yml
@@ -0,0 +1,62 @@
+name: Deploy DB migrations
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "Migrations/**"
+  workflow_dispatch: {}
+
+jobs:
+  # Собираем идемпотентный SQL-скрипт из миграций и кладём на ревью артефактом.
+  # Ничего не применяем здесь — только генерация, см. SKILL.md: "dotnet ef database update
+  # на production" запрещён, обязателен ревью SQL перед применением.
+  generate-script:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: "8.0.x"
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Restore
+        run: dotnet restore
+
+      # Пути --project/--context поправить под актуальную структуру решения (csproj Shop.Data).
+      - name: Generate idempotent migration script
+        run: |
+          mkdir -p artifacts
+          dotnet ef migrations script --idempotent \
+            --project Shop.Data \
+            --context ShopDbContext \
+            --output artifacts/migrate.sql
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: migration-script
+          path: artifacts/migrate.sql
+
+  # Отдельный job с GitHub Environment "production" — применяется только после
+  # ручного approve required reviewer'ом (Settings → Environments → production).
+  deploy-production:
+    needs: generate-script
+    runs-on: ubuntu-latest
+    environment:
+      name: production
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: migration-script
+          path: artifacts
+
+      - name: Apply migration script to production DB
+        env:
+          PGPASSWORD: ${{ secrets.PROD_DB_PASSWORD }}
+        run: |
+          psql "host=${{ secrets.PROD_DB_HOST }} dbname=${{ secrets.PROD_DB_NAME }} user=${{ secrets.PROD_DB_USER }} sslmode=require" \
+            -v ON_ERROR_STOP=1 \
+            -f artifacts/migrate.sql
