+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+public static class HousingEndpoints
+{
+    public static void MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Реестр заявок диспетчера: фильтры + sort=date|address|status, dir=asc|desc.
+        app.MapGet("/requests", async ([AsParameters] RequestSearch search, HousingService service) =>
+        {
+            try
+            {
+                return Results.Ok(await service.SearchAsync(search));
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        app.MapGet("/requests/{id:int}", async (int id, HousingService service) =>
+        {
+            var card = await service.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        // Приём заявки диспетчером, включая необязательный контактный телефон заявителя.
+        app.MapPost("/requests", async (NewRequest body, HousingService service) =>
+        {
+            var id = await service.CreateRequestAsync(body);
+            return Results.Created($"/requests/{id}", id);
+        });
+
+        // Мастер закрывает заявку: Done + обязательный комментарий, только из InProgress.
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService service) =>
+        {
+            try
+            {
+                await service.CloseRequestAsync(id, body.Comment);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+            catch (RequestStateConflictException ex)
+            {
+                return Results.Conflict(ex.Message);
+            }
+        });
+
+        // Инженер присылает план дома целиком - план дома становится ровно таким.
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> body, PlanService service) =>
+        {
+            try
+            {
+                await service.ReplacePlanAsync(id, body);
+                return Results.NoContent();
+            }
+            catch (InvalidOperationException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+        });
+    }
+}
