+    // Инженер присылает план дома целиком: план становится ровно таким списком работ.
+    // Работы, которые остаются (совпадает WorkCode), сохраняют свою историю выполнения;
+    // работы, которых больше нет в присланном плане, удаляются вместе со своей историей.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .SingleAsync(p => p.HouseId == houseId);
+
+        var incomingCodes = items.Select(i => i.WorkCode).ToHashSet();
+
+        foreach (var existing in plan.Items.ToList())
+        {
+            if (!incomingCodes.Contains(existing.WorkCode))
+                _db.PlanItems.Remove(existing);
+        }
+
+        foreach (var incoming in items)
+        {
+            var existing = plan.Items.SingleOrDefault(i => i.WorkCode == incoming.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = incoming.Title;
+                existing.PeriodDays = incoming.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = incoming.WorkCode,
+                    Title = incoming.Title,
+                    PeriodDays = incoming.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
