+            ?? throw new KeyNotFoundException($"План дома {houseId} не найден");
+
+        var incomingCodes = items.Select(i => i.WorkCode).ToHashSet();
+
+        var removed = plan.Items.Where(i => !incomingCodes.Contains(i.WorkCode)).ToList();
+        foreach (var item in removed)
+            plan.Items.Remove(item);
+        _db.PlanItems.RemoveRange(removed);
+
+        foreach (var incoming in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == incoming.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = incoming.Title;
+                existing.PeriodDays = incoming.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = incoming.WorkCode,
+                    Title = incoming.Title,
+                    PeriodDays = incoming.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
