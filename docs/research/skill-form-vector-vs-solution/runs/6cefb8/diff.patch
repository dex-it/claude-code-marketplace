+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestInput(string Comment);
+
+public record UpdatePlanInput(List<PlanItemInput> Items);
+
+public static class Endpoints
+{
+    public static void MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Мастер закрывает заявку: Done + обязательный комментарий, только из InProgress.
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestInput input, HousingService svc) =>
+        {
+            if (string.IsNullOrWhiteSpace(input.Comment))
+                return Results.ValidationProblem(new Dictionary<string, string[]>
+                {
+                    ["comment"] = new[] { "Комментарий о выполненных работах обязателен." },
+                });
+
+            try
+            {
+                await svc.CloseRequestAsync(id, input.Comment);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (InvalidRequestStatusException ex)
+            {
+                return Results.Conflict(new { error = ex.Message });
+            }
+        });
+
+        // Инженер присылает план дома целиком - план дома становится таким, как прислано.
+        app.MapPut("/houses/{id:int}/plan", async (int id, UpdatePlanInput input, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, input.Items);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+        });
+    }
+}
