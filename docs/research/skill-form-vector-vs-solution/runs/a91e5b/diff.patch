+    // Запрос кода для входа в мобильное приложение.
+    public async Task RequestLoginCodeAsync(string email, int schoolId)
+    {
+        var normalizedEmail = email.Trim().ToLower();
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail)
+            ?? throw new KeyNotFoundException("Ученик не найден");
+
+        var code = new Random().Next(100000, 999999).ToString();
+        var expiresAt = DateTime.UtcNow.AddMinutes(10);
+
+        var existing = await _db.LoginCodes
+            .FirstOrDefaultAsync(c => c.StudentId == student.Id);
+
+        if (existing != null)
+        {
+            existing.Code = code;
+            existing.ExpiresAt = expiresAt;
+        }
+        else
+        {
+            _db.LoginCodes.Add(new LoginCode
+            {
+                StudentId = student.Id,
+                Code = code,
+                ExpiresAt = expiresAt
+            });
+        }
+
+        await _emailSender.SendAsync(student.Email, "Код входа в мобильное приложение",
+            $"Ваш одноразовый код: {code}");
+    }
+
+    // Проверка кода и вход в мобильное приложение.
+    public async Task<StudentDto?> ConfirmLoginCodeAsync(string email, string code)
+    {
+        var normalizedEmail = email.Trim().ToLower();
+        var student = await _db.Students
+            .Include(s => s.Instructor)
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalizedEmail);
+
+        if (student is null)
+            return null;
+
+        var loginCode = await _db.LoginCodes
+            .FirstOrDefaultAsync(c => c.StudentId == student.Id);
+
+        if (loginCode is null || loginCode.Code != code || loginCode.ExpiresAt < DateTime.UtcNow)
+            return null;
+
+        _db.LoginCodes.Remove(loginCode);
+        return ToDto(student);
+    }
+
+    // Список студентов инструктора с ближайшим занятием.
+    public async Task<List<StudentForInstructorDto>> GetStudentsForInstructorAsync(int instructorId)
+    {
+        var students = await _db.Students
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .AsNoTracking()
+            .ToListAsync();
+
+        var result = new List<StudentForInstructorDto>();
+
+        foreach (var student in students)
+        {
+            var nextLesson = await _db.Lessons
+                .Where(l => l.StudentId == student.Id && l.StartsAt > DateTime.UtcNow)
+                .OrderBy(l => l.StartsAt)
+                .Select(l => l.StartsAt)
+                .FirstOrDefaultAsync();
+
+            var masked = student.MaskForInstructor();
+            result.Add(new StudentForInstructorDto(
+                masked.Id,
+                masked.FullName,
+                masked.Phone,
+                masked.Status,
+                nextLesson == default ? null : nextLesson
+            ));
+        }
+
+        return result.OrderBy(s => s.FullName).ToList();
+    }
+
+    // Отчёт о выпускниках за год по инструкторам.
+    public async Task<List<GraduatesReportDto>> GetGraduatesReportAsync(int year)
+    {
+        var startDate = new DateOnly(year, 1, 1);
+        var endDate = new DateOnly(year, 12, 31);
+
+        var graduates = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated &&
+                        s.GraduatedOn >= startDate &&
+                        s.GraduatedOn <= endDate)
+            .GroupBy(s => new { s.InstructorId, InstructorName = s.Instructor != null ? s.Instructor.FullName : "N/A" })
+            .Select(g => new GraduatesReportDto(g.Key.InstructorName, g.Count()))
+            .OrderBy(r => r.InstructorFullName)
+            .ToListAsync();
+
+        return graduates;
+    }
+
+    // Прогресс студента: часы вождения из 56.
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => s.Id == studentId);
+
+        if (student is null)
+            return null;
+
+        var hoursPassed = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        return new ProgressDto(hoursPassed / 60, 56);
+    }
+
     private static StudentDto ToDto(Student s) =>
         new(s.Id, s.FullName, s.Email, s.Phone, s.Status, s.Instructor?.FullName);
 }
