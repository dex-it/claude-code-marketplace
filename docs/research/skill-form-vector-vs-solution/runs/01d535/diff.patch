diff --git a/OrderRepository.cs b/OrderRepository.cs
index 72637b8..52f21d4 100644
--- a/OrderRepository.cs
+++ b/OrderRepository.cs
@@ -6,4 +6,19 @@ public class OrderRepository
     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    // Связь Order -> Items required с Restrict: Items.Clear() бросил бы в SaveChanges,
+    // поэтому позиции удаляются явно. Возвращает false, если заказ не найден (или удалён).
+    public async Task<bool> ClearItems(Guid orderId)
+    {
+        var order = await _db.Orders
+            .Include(o => o.Items)
+            .FirstOrDefaultAsync(o => o.Id == orderId);
+        if (order is null) return false;
+
+        _db.RemoveRange(order.Items);
+        order.Items.Clear();
+        await _db.SaveChangesAsync();
+        return true;
+    }
 }
