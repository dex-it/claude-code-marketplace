@@ -0,0 +1,44 @@
+name: Deploy DB Migrations
+
+on:
+  workflow_dispatch: {}
+  push:
+    branches: [main]
+    paths:
+      - 'Migrations/**'
+
+jobs:
+  migrate-production:
+    runs-on: ubuntu-latest
+    # Configure a "production" environment with required reviewers in
+    # repo Settings -> Environments so this step needs manual approval.
+    environment: production
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup .NET 8
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '8.0.x'
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Build production migration bundle
+        # A self-contained bundle avoids shipping source/SDK to the deploy
+        # step and applies pending migrations idempotently.
+        run: |
+          export PATH="$PATH:$HOME/.dotnet/tools"
+          dotnet ef migrations bundle \
+            --project Shop.Data/Shop.Data.csproj \
+            --configuration Release \
+            --self-contained \
+            --target-runtime linux-x64 \
+            --output efbundle \
+            --force
+
+      - name: Apply migrations to production database
+        env:
+          PROD_CONNECTION_STRING: ${{ secrets.PROD_DB_CONNECTION_STRING }}
+        run: ./efbundle --connection "$PROD_CONNECTION_STRING"
