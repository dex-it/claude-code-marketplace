index cc90064..f88a070 100644
--- a/Model.cs
+++ b/Model.cs
@@ -1,4 +1,6 @@
 // Shop.Data - EF Core 8, PostgreSQL (Npgsql.EntityFrameworkCore.PostgreSQL 8)
+using Microsoft.EntityFrameworkCore.Storage.ValueConversion;
+
 namespace Shop.Data;
 
 public class Customer { public Guid Id { get; set; } public string Name { get; set; } = ""; public List<Order> Orders { get; set; } = new(); }
@@ -11,7 +13,8 @@ public class Order
     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
-    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
+    public int Complexity { get; set; }               // сложность комплектации, 1..5
+    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone, always UTC in code
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
     public List<OrderItem> Items { get; set; } = new();
@@ -41,10 +44,40 @@ public class ShopDbContext : DbContext
     public DbSet<Order> Orders => Set<Order>();
     public DbSet<Product> Products => Set<Product>();
     public DbSet<AuditLog> AuditLogs => Set<AuditLog>();
+    // Колонка CreatedAt остаётся "timestamp without time zone" (на неё смотрят отчёты DBA),
+    // но в коде значение всегда должно быть DateTime с Kind=Utc. Npgsql 6+ не пишет Kind=Utc
+    // в timestamp without time zone, поэтому на запись метку снимаем (Unspecified),
+    // на чтение — снова помечаем Utc, не трогая само значение.
+    private static readonly ValueConverter<DateTime, DateTime> UtcDateTimeConverter = new(
+        v => DateTime.SpecifyKind(v.ToUniversalTime(), DateTimeKind.Unspecified),
+        v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
     protected override void OnModelCreating(ModelBuilder b)
     {
-        b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+        b.Entity<Order>(o =>
+        {
+            o.HasQueryFilter(x => !x.IsDeleted);
+
+            o.Property(x => x.CreatedAt)
+                .HasColumnType("timestamp without time zone")
+                .HasConversion(UtcDateTimeConverter);
+
+            o.Property(x => x.Complexity);
+            o.ToTable(t => t.HasCheckConstraint("CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+            // Soft-delete: FK у Items/Payments обязательный (non-nullable Guid), поэтому
+            // при физическом удалении Order (если оно вдруг произойдёт вручную/через миграцию)
+            // запрещаем БД каскадно удалять дочерние записи, чтобы не терять данные молча.
+            o.HasMany(x => x.Items)
+                .WithOne()
+                .HasForeignKey(i => i.OrderId)
+                .OnDelete(DeleteBehavior.Restrict);
+
+            o.HasMany(x => x.Payments)
+                .WithOne()
+                .HasForeignKey(p => p.OrderId)
+                .OnDelete(DeleteBehavior.Restrict);
+        });
     }
 }
 // Options: UseNpgsql(cs).UseLazyLoadingProxies()
