+    public async Task UpdatePlanAsync(int houseId, List<PlanItemInput> newItems)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .SingleAsync(p => p.HouseId == houseId);
+
+        var existingByCode = plan.Items.ToDictionary(i => i.WorkCode);
+        var newByCode = newItems.ToDictionary(i => i.WorkCode);
+        var itemsToRemove = plan.Items
+            .Where(i => !newByCode.ContainsKey(i.WorkCode))
+            .ToList();
+
+        foreach (var item in itemsToRemove)
+            _db.PlanItems.Remove(item);
+
+        foreach (var newItem in newItems)
+        {
+            if (existingByCode.TryGetValue(newItem.WorkCode, out var existing))
+            {
+                existing.Title = newItem.Title;
+                existing.PeriodDays = newItem.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = newItem.WorkCode,
+                    Title = newItem.Title,
+                    PeriodDays = newItem.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
 }
