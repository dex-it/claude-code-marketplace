+    // Инженер присылает план дома целиком: план становится таким, как прислано.
+    // Работы, которые остаются в плане (совпадают по WorkCode), сохраняют историю выполнения;
+    // убранные из плана работы удаляются вместе со своей историей, новые - добавляются без истории.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var codes = items.Select(i => i.WorkCode).ToList();
+        if (codes.Distinct().Count() != codes.Count)
+            throw new ArgumentException("Коды работ в присланном плане не должны повторяться");
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var incomingCodes = codes.ToHashSet();
+        foreach (var existing in plan.Items.ToList())
+        {
+            if (incomingCodes.Contains(existing.WorkCode))
+                continue;
+
+            _db.PlanItemCompletions.RemoveRange(existing.Completions);
+            _db.PlanItems.Remove(existing);
+        }
+
+        var existingByCode = plan.Items.ToDictionary(i => i.WorkCode);
+        foreach (var item in items)
+        {
+            if (existingByCode.TryGetValue(item.WorkCode, out var existing))
+            {
+                existing.Title = item.Title;
+                existing.PeriodDays = item.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = item.WorkCode,
+                    Title = item.Title,
+                    PeriodDays = item.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
