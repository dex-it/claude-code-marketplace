+    // Сортировка клика по заголовку: date (по умолчанию, новые сверху), address (дом, затем квартира), status.
+    // Sort/Dir приходят из фиксированных enum'ов, поэтому составлять ORDER BY строкой безопасно.
+    private static string BuildOrderBy(RequestSort sort, SortDirection? dir)
+    {
+        var (columns, defaultDir) = sort switch
+        {
+            RequestSort.Address => ("h.address, a.number", SortDirection.Asc),
+            RequestSort.Status => ("r.status", SortDirection.Asc),
+            _ => ("r.created_at", SortDirection.Desc),
+        };
+
+        var direction = (dir ?? defaultDir) == SortDirection.Asc ? "ASC" : "DESC";
+        // r.id - стабильный тай-брейк для пагинации при равных значениях сортировки.
+        return $"{columns} {direction}, r.id {direction}";
+    }
