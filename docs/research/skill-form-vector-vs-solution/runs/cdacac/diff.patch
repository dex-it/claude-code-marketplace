+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+public record ReplacePlanBody(List<PlanItemInput> Items);
+
+public static class Endpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Реестр заявок диспетчерской. Клик по заголовку таблицы на фронте передаёт
+        // sort=date|address|status и dir=asc|desc; остальные фильтры - как раньше.
+        app.MapGet("/requests", async (HousingService svc, string? text, RequestStatus? status,
+            int? houseId, string? district, int? page, int? pageSize, string? sort, string? dir) =>
+        {
+            if (!TryParseSort(sort, out var requestSort))
+                return Results.BadRequest($"Неизвестное значение sort: {sort}");
+
+            if (!TryParseDir(dir, out var sortDirection))
+                return Results.BadRequest($"Неизвестное значение dir: {dir}");
+
+            var search = new RequestSearch(text, status, houseId, district,
+                page ?? 1, pageSize ?? 50, requestSort, sortDirection);
+            return Results.Ok(await svc.SearchAsync(search));
+        });
+
+        app.MapGet("/requests/{id:int}", async (HousingService svc, int id) =>
+        {
+            var card = await svc.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        app.MapPost("/requests", async (HousingService svc, NewRequest body) =>
+        {
+            var id = await svc.CreateRequestAsync(body);
+            return Results.Created($"/requests/{id}", new { id });
+        });
+
+        // Мастер закрывает заявку: обязателен комментарий о выполненных работах,
+        // закрыть можно только заявку в статусе InProgress (иначе 409).
+        app.MapPost("/requests/{id:int}/close", async (HousingService svc, int id, CloseRequestBody body) =>
+        {
+            try
+            {
+                await svc.CloseRequestAsync(id, body.Comment);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+            catch (RequestStateConflictException ex)
+            {
+                return Results.Conflict(ex.Message);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        // Инженер присылает план дома целиком - план дома становится таким, как прислано;
+        // история по работам, которые остаются в плане, сохраняется.
+        app.MapPut("/houses/{id:int}/plan", async (PlanService svc, int id, ReplacePlanBody body) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, body.Items);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        return app;
+    }
+
+    private static bool TryParseSort(string? sort, out RequestSort result)
+    {
+        switch (sort?.Trim().ToLowerInvariant())
+        {
+            case null or "":
+            case "date":
+                result = RequestSort.Date;
+                return true;
+            case "address":
+                result = RequestSort.Address;
+                return true;
+            case "status":
+                result = RequestSort.Status;
+                return true;
+            default:
+                result = default;
+                return false;
+        }
+    }
+
+    private static bool TryParseDir(string? dir, out SortDirection? result)
+    {
+        switch (dir?.Trim().ToLowerInvariant())
+        {
+            case null or "":
+                result = null;
+                return true;
+            case "asc":
+                result = SortDirection.Asc;
+                return true;
+            case "desc":
+                result = SortDirection.Desc;
+                return true;
+            default:
+                result = null;
+                return false;
+        }
+    }
+}
