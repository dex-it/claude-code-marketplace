+namespace Domovoy.Housing;
+
+// Операция запрещена текущим статусом сущности (маппится на HTTP 409 в endpoint-слое).
+public class RequestStateConflictException : Exception
+{
+    public RequestStateConflictException(string message) : base(message) { }
+}
