+namespace Shop.Data;
+
+public record OrderReportRow(Guid Id, string CustomerName, decimal Total, int ItemCount);
+
+// Read-only queries backing the orders report page.
+public class OrderReportService
+{
+    private readonly OrderRepository _repo;
+    public OrderReportService(OrderRepository repo) => _repo = repo;
+
+    public Task<List<OrderReportRow>> GetActiveOrdersAsync() =>
+        ActiveOrders().Select(ToRow()).ToListAsync();
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync() =>
+        ActiveOrders()
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    // Overdue per Order.IsOverdue: not shipped and created more than 3 days before `now`.
+    public Task<List<OrderReportRow>> GetOverdueOrdersAsync(DateTime now) =>
+        _repo.Query()
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Select(ToRow())
+            .ToListAsync();
+
+    private IQueryable<Order> ActiveOrders() => _repo.Query().Where(o => o.Status == "active");
+
+    private static System.Linq.Expressions.Expression<Func<Order, OrderReportRow>> ToRow() =>
+        o => new OrderReportRow(o.Id, o.Customer.Name, o.Total, o.Items.Count);
+}
