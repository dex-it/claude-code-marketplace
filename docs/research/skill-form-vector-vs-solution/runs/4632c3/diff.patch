+namespace BookQuarter.Library;
+
+// Список должников филиала для обзвона: отсортирован по убыванию штрафа,
+// TotalFine — сумма штрафов по филиалу (идёт последним полем в ответе).
+public sealed record DebtorsReport(List<LoanRow> Debtors, decimal TotalFine);
+
+// Период запрашивается в часовом поясе пользователя; DateTimeOffset
+// сравнивается как момент времени, поэтому зона значения не меняет.
+public sealed record LoansByBranchRequest(DateTimeOffset From, DateTimeOffset To);
+
+public sealed record LoansByBranchRow(int BranchId, string BranchName, int Count);
