+    // Число выдач по каждому филиалу за период (отчёт для методиста).
+    public async Task<List<LoansByBranchRow>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var branches = await _db.Branches.OrderBy(b => b.Name).ToListAsync();
+
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.BranchId, x => x.Count);
+
+        return branches
+            .Select(b => new LoansByBranchRow(b.Id, b.Name, counts.GetValueOrDefault(b.Id)))
+            .ToList();
