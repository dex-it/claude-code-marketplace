+namespace Shop.Data;
+
+// Регистрировать как scoped-сервис; если вызывается из BackgroundService/шедулера,
+// создавать новый scope (и, следовательно, новый ShopDbContext) на каждый запуск,
+// а не держать DbContext в singleton-сервисе.
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (а) Поднять цены на 10% всем продуктам категории.
+    // Set-based UPDATE на стороне БД: без загрузки сущностей, без трекинга,
+    // одна SQL-команда независимо от числа строк.
+    public Task<int> RaisePricesAsync(string category, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * 1.1m), ct);
+
+    // (б) Ночная очистка AuditLogs старше года.
+    // Таблица ~50 млн строк, под удаление ~40 млн - удаление батчами по Id,
+    // каждый батч - собственная неявная транзакция ExecuteDeleteAsync
+    // (никакой явной транзакции на весь объём), чтобы не держать один
+    // многочасовой DELETE, не раздувать WAL/репликацию и не эскалировать блокировки.
+    // At маппится Npgsql в timestamp with time zone => сравнение только с UTC-значением.
+    public async Task CleanupOldAuditLogsAsync(CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow.AddYears(-1);
+        const int batchSize = 5_000;
+
+        while (true)
+        {
+            ct.ThrowIfCancellationRequested();
+
+            var batchIds = await _db.AuditLogs
+                .Where(a => a.At < cutoff)
+                .OrderBy(a => a.Id)
+                .Select(a => a.Id)
+                .Take(batchSize)
+                .ToListAsync(ct);
+
+            if (batchIds.Count == 0)
+                break;
+
+            await _db.AuditLogs
+                .Where(a => batchIds.Contains(a.Id))
+                .ExecuteDeleteAsync(ct);
+
+            // Пауза между батчами, чтобы не держать таблицу под непрерывной нагрузкой всю ночь.
+            await Task.Delay(TimeSpan.FromMilliseconds(200), ct);
+        }
+    }
+
+    // (в) Загрузить продукты и увеличить Stock, сохранить одним SaveChanges
+    // (без SaveChanges в цикле по строкам). Дубликаты id суммируются.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var deltas = items
+            .GroupBy(x => x.Id)
+            .ToDictionary(g => g.Key, g => g.Sum(x => x.Add));
+
+        if (deltas.Count == 0)
+            return;
+
+        var ids = deltas.Keys.ToList();
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToListAsync(ct);
+
+        foreach (var product in products)
+            product.Stock += deltas[product.Id];
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (г) Создать продукт с новым Guid. Id генерируется на клиенте,
+    // поэтому Add (не AddAsync - он нужен только для async value generators).
+    public async Task<Product> CreateProductAsync(
+        string sku, string category, string warehouse, decimal price, int stock, CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Category = category,
+            Warehouse = warehouse,
+            Price = price,
+            Stock = stock,
+        };
+
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
