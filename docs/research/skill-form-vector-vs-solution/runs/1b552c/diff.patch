     await s.GetByContractAsync(contractNo) is { } dto ? Results.Ok(dto) : Results.NotFound());
 
+app.MapGet("/subscribers/search", async (string? phone, SubscriberService s) =>
+{
+    var digits = new string((phone ?? "").Where(char.IsAsciiDigit).ToArray());
+    if (digits.Length < SubscriberService.MinPhoneDigits || digits.Length > 15)
+        return Results.BadRequest($"Укажите от {SubscriberService.MinPhoneDigits} до 15 цифр телефона");
+
+    return Results.Ok(await s.SearchByPhoneTailAsync(digits));
+});
+
+app.MapPost("/bank/statements", async (HttpRequest request, PaymentImportService import) =>
+{
+    using var buffer = new MemoryStream();
+    await request.Body.CopyToAsync(buffer);
+    var bytes = buffer.ToArray();
+
+    // Интернет-банки отдают CSV то в UTF-8, то в Windows-1251: пробуем строгий UTF-8, иначе 1251.
+    string text;
+    try
+    {
+        text = new UTF8Encoding(false, throwOnInvalidBytes: true).GetString(bytes);
+    }
+    catch (DecoderFallbackException)
+    {
+        text = Encoding.GetEncoding(1251).GetString(bytes);
+    }
+
+    List<StatementLine> lines;
+    try
+    {
+        lines = BankStatement.Parse(new StringReader(text.TrimStart('﻿')));
+    }
+    catch (Exception e) when (e is FormatException or IndexOutOfRangeException or OverflowException)
+    {
+        return Results.BadRequest($"Не удалось разобрать выписку: {e.Message}");
+    }
+
+    try
+    {
+        return Results.Ok(await import.ImportAsync(lines));
+    }
+    catch (DbUpdateException e) when (e.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })
+    {
+        // Та же выписка параллельно загружается другим запросом - эта транзакция откатилась целиком.
+        return Results.Conflict("Выписка уже загружается, повторите позже");
+    }
+});
+
 app.Run();
