+
+    public const int MinPhoneDigits = 4;
+    private const int SearchLimit = 20;
+
+    // Поиск по последним цифрам телефона; формат ввода (пробелы, скобки, дефисы) не важен.
+    public async Task<List<SubscriberDto>> SearchByPhoneTailAsync(string digits)
+    {
+        var reversed = new string(digits.Reverse().ToArray());
+
+        return await _db.Subscribers.AsNoTracking()
+            .Where(s => s.PhoneDigitsReversed.StartsWith(reversed))
+            .OrderBy(s => s.Id)
+            .Take(SearchLimit)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+    }
 }
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..f092d7f
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,11 @@
+**Файлы:**
+- `PaymentImportService.cs` — новый: загрузка выписки, зачисление на баланс, возврат приостановленных абонентов в Active.
+- `Models.cs` — новая сущность `UnmatchedPayment`; в `Subscriber` добавлены поля `ReactivatedAt` и `PhoneDigitsReversed`.
+- `BillingDbContext.cs` — `DbSet<UnmatchedPayment>` с уникальным `BankRef`; для `PhoneDigitsReversed` — генерируемая колонка и индекс `text_pattern_ops`.
+- `SubscriberService.cs` — метод `SearchByPhoneTailAsync`.
+- `Program.cs` — `POST /bank/statements` и `GET /subscribers/search`, регистрация сервиса и кодировки 1251.
+
+**Решения:**
+- Повторная загрузка: строка, чей `BankRef` уже есть в платежах или в неразобранных, пропускается; повторы внутри одного файла тоже. Вся выписка грузится в одной транзакции. Баланс увеличивается атомарным `UPDATE Balance = Balance + x`, поэтому одновременные изменения баланса не теряются. Если ту же выписку загружают параллельно, второй запрос упирается в уникальный индекс, откатывается и получает 409. Возврат в Active делается после зачисления условным `UPDATE` (`Suspended && Balance >= 0`), время записывается в `ReactivatedAt`. Платежи по закрытым договорам и с суммой ≤ 0 уходят в неразобранные с указанием причины.
+- Поиск: телефоны записаны в разном формате, поэтому в PostgreSQL добавлена генерируемая колонка — цифры телефона в обратном порядке. Тогда «заканчивается на 4518» превращается в индексируемый `LIKE '8154%'`, а для существующих строк колонка заполнится сама. Нужно от 4 до 15 цифр, не больше 20 результатов, сортировка по Id.
+- Миграций в репозитории нет, их нужно создать (`dotnet ef migrations add`). Сборку и тесты я не запускал, как и было сказано. Время пишется через `DateTime.Now`, как в остальном коде.
