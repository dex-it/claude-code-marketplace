diff --git a/PaymentImportService.cs b/PaymentImportService.cs
new file mode 100644
index 0000000..8d61e9f
--- /dev/null
+++ b/PaymentImportService.cs
@@ -0,0 +1,106 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace Tarif.Billing;
+
+public record StatementImportResult(int Credited, int Unmatched, int AlreadyLoaded, int Reactivated);
+
+public class PaymentImportService
+{
+    private readonly BillingDbContext _db;
+
+    public PaymentImportService(BillingDbContext db) => _db = db;
+
+    public async Task<StatementImportResult> ImportAsync(IReadOnlyList<StatementLine> lines)
+    {
+        var now = DateTime.Now;
+
+        // Вся выписка - одна транзакция: либо зачислена целиком, либо (при ошибке) не зачислено ничего,
+        // и её можно спокойно загрузить ещё раз.
+        await using var tx = await _db.Database.BeginTransactionAsync();
+
+        // Идемпотентность по банковскому референсу: уже загруженные строки (и разнесённые, и неразобранные) пропускаем.
+        var refs = lines.Select(l => l.BankRef).Distinct().ToList();
+        var known = new HashSet<string>(
+            await _db.Payments.Where(p => refs.Contains(p.BankRef)).Select(p => p.BankRef)
+                .Union(_db.UnmatchedPayments.Where(p => refs.Contains(p.BankRef)).Select(p => p.BankRef))
+                .ToListAsync());
+
+        var contractNos = lines.Select(l => PaymentPurpose.ExtractContractNo(l.Purpose))
+            .OfType<string>().Distinct().ToList();
+        var subscribers = await _db.Subscribers.AsNoTracking()
+            .Where(s => s.ContractNo != null && contractNos.Contains(s.ContractNo))
+            .Select(s => new { s.Id, ContractNo = s.ContractNo!, s.Status })
+            .ToDictionaryAsync(s => s.ContractNo);
+
+        var credits = new Dictionary<int, decimal>();
+        int credited = 0, unmatched = 0, alreadyLoaded = 0;
+
+        foreach (var line in lines)
+        {
+            // known пополняется по ходу, чтобы дубль строки внутри одного файла тоже не зачёлся дважды.
+            if (!known.Add(line.BankRef))
+            {
+                alreadyLoaded++;
+                continue;
+            }
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var reason =
+                line.Amount <= 0 ? "Неположительная сумма"
+                : contractNo is null ? "Номер договора не найден в назначении"
+                : !subscribers.TryGetValue(contractNo, out var s) ? $"Нет абонента с договором {contractNo}"
+                : s.Status == SubscriberStatus.Closed ? $"Договор {contractNo} закрыт"
+                : null;
+
+            if (reason is not null)
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    Reason = reason,
+                    LoadedAt = now,
+                });
+                unmatched++;
+                continue;
+            }
+
+            var subscriberId = subscribers[contractNo!].Id;
+            _db.Payments.Add(new Payment
+            {
+                SubscriberId = subscriberId,
+                Amount = line.Amount,
+                BankRef = line.BankRef,
+                PaidOn = line.PaidOn,
+                CreditedAt = now,
+                Purpose = line.Purpose,
+            });
+            credits[subscriberId] = credits.GetValueOrDefault(subscriberId) + line.Amount;
+            credited++;
+        }
+
+        // Вставка платежей первой: при параллельной загрузке той же выписки здесь сработает
+        // уникальный индекс по BankRef, и транзакция откатится до изменения балансов.
+        await _db.SaveChangesAsync();
+
+        // Баланс меняем атомарным UPDATE (Balance = Balance + x), чтобы не потерять параллельные списания.
+        foreach (var (subscriberId, amount) in credits)
+        {
+            await _db.Subscribers.Where(s => s.Id == subscriberId)
+                .ExecuteUpdateAsync(u => u.SetProperty(s => s.Balance, s => s.Balance + amount));
+        }
+
+        var creditedIds = credits.Keys.ToList();
+        var reactivated = await _db.Subscribers
+            .Where(s => creditedIds.Contains(s.Id) && s.Status == SubscriberStatus.Suspended && s.Balance >= 0)
+            .ExecuteUpdateAsync(u => u
+                .SetProperty(s => s.Status, SubscriberStatus.Active)
+                .SetProperty(s => s.ReactivatedAt, now));
+
+        await tx.CommitAsync();
+        return new StatementImportResult(credited, unmatched, alreadyLoaded, reactivated);
+    }
+}
