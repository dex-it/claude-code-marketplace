+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    // Список из маркетинговой системы может быть большим: читаем клиентов пачками,
+    // чтобы не тянуть всех в память и не делать запрос на каждого.
+    private const int BatchSize = 1000;
+
+    private readonly ShopDbContext _db;
+    private readonly IEmailSender _email;
+    private readonly string _subject;
+
+    public CustomerNotifier(ShopDbContext db, IEmailSender email, string subject = "Shop")
+    {
+        _db = db;
+        _email = email;
+        _subject = subject;
+    }
+
+    // Отправляет письмо каждому найденному клиенту (один раз на клиента).
+    // Неизвестные id и клиенты без email пропускаются. Ошибка отправки одному клиенту
+    // не прерывает рассылку остальным; все ошибки выбрасываются в конце AggregateException.
+    // Возвращает число отправленных писем.
+    public async Task<int> NotifyCustomers(IEnumerable<Guid> customerIds, string text, CancellationToken ct = default)
+    {
+        ArgumentNullException.ThrowIfNull(customerIds);
+        ArgumentNullException.ThrowIfNull(text);
+
+        var seen = new HashSet<Guid>();
+        var errors = new List<Exception>();
+        var sent = 0;
+
+        foreach (var chunk in customerIds.Where(seen.Add).Chunk(BatchSize))
+        {
+            var recipients = await _db.Customers
+                .AsNoTracking()
+                .Where(c => chunk.Contains(c.Id) && c.Email != "")
+                .Select(c => new { c.Id, c.Email })
+                .ToListAsync(ct);
+
+            foreach (var r in recipients)
+            {
+                ct.ThrowIfCancellationRequested();
+                try
+                {
+                    await _email.SendAsync(r.Email, _subject, text, ct);
+                    sent++;
+                }
+                catch (Exception ex) when (ex is not OperationCanceledException)
+                {
+                    errors.Add(new InvalidOperationException($"Failed to notify customer {r.Id}", ex));
+                }
+            }
+        }
+
+        if (errors.Count > 0)
+            throw new AggregateException($"Sent {sent}, failed {errors.Count}", errors);
+
+        return sent;
+    }
+}
