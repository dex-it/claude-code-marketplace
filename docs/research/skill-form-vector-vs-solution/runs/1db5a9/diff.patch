+using Microsoft.AspNetCore.Mvc;
+
+namespace Notify.Api.Services;
+
+public sealed class ReportsService
+{
+    private readonly INotificationSender _emailSender;
+    public ReportsService([FromKeyedServices(NotificationServiceKeys.Email)] INotificationSender emailSender)
+        => _emailSender = emailSender;
+
+    public Task SendReportAsync(Guid reportId, string email, CancellationToken ct = default)
+        => _emailSender.SendAsync(email, $"Отчёт {reportId}", ct);
+}
