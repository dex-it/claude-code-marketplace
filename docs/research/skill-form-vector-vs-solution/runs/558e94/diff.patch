@@ -66,4 +66,39 @@ public class PlanService
 
         await _db.SaveChangesAsync();
     }
+
+    public async Task UpdatePlanAsync(int houseId, List<PlanItemDto> newItems)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .SingleAsync(p => p.HouseId == houseId);
+
+        var newWorkCodes = newItems.Select(i => i.WorkCode).ToHashSet();
+
+        // Обновить существующие и добавить новые работы
+        foreach (var dto in newItems)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == dto.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = dto.Title;
+                existing.PeriodDays = dto.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = dto.WorkCode,
+                    Title = dto.Title,
+                    PeriodDays = dto.PeriodDays,
+                });
+            }
+        }
+
+        // Удалить работы, которых нет в новом плане
+        foreach (var item in plan.Items.Where(i => !newWorkCodes.Contains(i.WorkCode)).ToList())
+            plan.Items.Remove(item);
+
+        await _db.SaveChangesAsync();
+    }
 }
