--- /dev/null
+++ b/Migrations/20260929120100_BackfillOrderCategories.cs
@@ -0,0 +1,71 @@
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Migrations;
+using Shop.Data;
+
+#nullable disable
+
+namespace Shop.Data.Migrations
+{
+    // Data-only migration, kept separate from the schema migration above.
+    // Converts historical Order.Category strings into Categories + OrderCategories rows.
+    // Order.Category itself is left in place — it is dropped in a later migration
+    // once no code path still reads it.
+    [DbContext(typeof(ShopDbContext))]
+    [Migration("20260929120100_BackfillOrderCategories")]
+    public partial class BackfillOrderCategories : Migration
+    {
+        protected override void Up(MigrationBuilder migrationBuilder)
+        {
+            // Distinct category names are inherently few — a single statement is enough,
+            // no batching needed here.
+            migrationBuilder.Sql(@"
+                INSERT INTO ""Categories"" (""Id"", ""Name"")
+                SELECT gen_random_uuid(), src.name
+                FROM (
+                    SELECT DISTINCT o.""Category"" AS name
+                    FROM ""Orders"" o
+                    WHERE o.""Category"" IS NOT NULL AND o.""Category"" <> ''
+                ) src
+                ON CONFLICT (""Name"") DO NOTHING;
+            ");
+
+            // OrderCategories rows scale with the Orders table, which can be large.
+            // Batched, self-committing loop instead of one INSERT...SELECT over the
+            // whole table, so we don't hold one long transaction / blow up the WAL
+            // (see SKILL.md: "Массовое удаление одной транзакцией", same principle
+            // applies to large single-transaction inserts).
+            migrationBuilder.Sql(@"
+                DO $$
+                DECLARE
+                    batch_size CONSTANT integer := 5000;
+                    affected integer;
+                BEGIN
+                    LOOP
+                        INSERT INTO ""OrderCategories"" (""OrderId"", ""CategoryId"")
+                        SELECT o.""Id"", cat.""Id""
+                        FROM ""Orders"" o
+                        JOIN ""Categories"" cat ON cat.""Name"" = o.""Category""
+                        WHERE o.""Category"" IS NOT NULL AND o.""Category"" <> ''
+                          AND NOT EXISTS (
+                              SELECT 1 FROM ""OrderCategories"" oc
+                              WHERE oc.""OrderId"" = o.""Id"" AND oc.""CategoryId"" = cat.""Id""
+                          )
+                        LIMIT batch_size;
+
+                        GET DIAGNOSTICS affected = ROW_COUNT;
+                        EXIT WHEN affected = 0;
+                        COMMIT;
+                    END LOOP;
+                END $$;
+            ", suppressTransaction: true);
+        }
+
+        protected override void Down(MigrationBuilder migrationBuilder)
+        {
+            // Best-effort revert: safe only if nothing else has written to these tables
+            // since this migration ran (true right after this deploy, on a rollback).
+            migrationBuilder.Sql(@"TRUNCATE TABLE ""OrderCategories"";");
+            migrationBuilder.Sql(@"DELETE FROM ""Categories"";");
+        }
+    }
+}
