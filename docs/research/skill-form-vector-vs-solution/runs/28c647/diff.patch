index cc90064..92d91fc 100644
--- a/Model.cs
+++ b/Model.cs
@@ -1,4 +1,6 @@
 // Shop.Data - EF Core 8, PostgreSQL (Npgsql.EntityFrameworkCore.PostgreSQL 8)
+using Microsoft.EntityFrameworkCore.Storage.ValueConversion;
+
 namespace Shop.Data;
 
 public class Customer { public Guid Id { get; set; } public string Name { get; set; } = ""; public List<Order> Orders { get; set; } = new(); }
@@ -11,6 +13,7 @@ public class Order
     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
+    public int Complexity { get; set; }               // сложность комплектации, 1..5
     public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
@@ -44,7 +47,40 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        b.Entity<Order>()
+            .ToTable(t => t.HasCheckConstraint("CK_Order_Complexity", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Колонка остаётся timestamp without time zone (её видят отчёты DBA), но в коде
+        // CreatedAt всегда должен быть DateTime.Kind == Utc. Конвертер сохраняет "naive"
+        // значение как UTC-инстант и явно проставляет Kind=Utc при чтении, иначе Npgsql
+        // вернёт Kind=Unspecified и клиенты в разных таймзонах будут трактовать его по-разному.
+        var utcConverter = new ValueConverter<DateTime, DateTime>(
+            v => v.Kind == DateTimeKind.Utc ? v : v.ToUniversalTime(),
+            v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+        b.Entity<Order>()
+            .Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(utcConverter);
+
+        // Обе коллекции - обязательные зависимые (FK не nullable). Явная конфигурация
+        // с Cascade нужна, чтобы Items.Clear()/Payments.Clear() приводили к удалению
+        // осиротевших строк, а не к попытке проставить NULL в required FK, и чтобы
+        // случайный hard-delete Order (соглашение - soft-delete через IsDeleted)
+        // не оставлял в БД позиции/платежи без родителя мимо HasQueryFilter на Order.
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Cascade);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Cascade);
     }
 }
 // Options: UseNpgsql(cs).UseLazyLoadingProxies()
diff --git a/OrderRepository.cs b/OrderRepository.cs
