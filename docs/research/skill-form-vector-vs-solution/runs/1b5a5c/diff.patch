+    {
+        if (from >= to)
+            throw new ArgumentException("Начало периода должно быть раньше конца");
+
+        // Npgsql пишет в timestamptz только DateTimeOffset с нулевым смещением.
+        var fromUtc = from.ToUniversalTime();
+        var toUtc = to.ToUniversalTime();
+
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= fromUtc && l.IssuedAt < toUtc)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.BranchId, x => x.Count);
+
+        var branches = await _db.Branches
+            .OrderBy(b => b.Name)
+            .Select(b => new { b.Id, b.Name })
+            .ToListAsync();
+
+        return branches
+            .Select(b => new LoansByBranchRow(b.Id, b.Name, counts.GetValueOrDefault(b.Id)))
+            .ToList();
+    }
