+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesReportItem(int InstructorId, string InstructorName, int GraduatesCount);
+
+// Отчёты для продления лицензии автошколы.
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Выпускники за год по каждому инструктору, включая уже уволенных.
+    public async Task<List<GraduatesReportItem>> GraduatesByInstructorAsync(int year)
+    {
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                && s.InstructorId != null
+                && s.GraduatedOn != null
+                && s.GraduatedOn.Value.Year == year)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var instructorIds = counts.Select(c => c.InstructorId).ToList();
+
+        // IgnoreQueryFilters снимает и фильтр "не уволен", и фильтр по школе - школу возвращаем явно.
+        var names = await _db.Instructors.IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .Select(i => new { i.Id, i.FullName })
+            .ToDictionaryAsync(i => i.Id, i => i.FullName);
+
+        return counts
+            .Select(c => new GraduatesReportItem(c.InstructorId, names.GetValueOrDefault(c.InstructorId, "—"), c.Count))
+            .OrderByDescending(r => r.GraduatesCount)
+            .ToList();
+    }
+}
