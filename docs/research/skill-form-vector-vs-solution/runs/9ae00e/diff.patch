diff --git a/StudentAppService.cs b/StudentAppService.cs
new file mode 100644
index 0000000..c5b3b81
--- /dev/null
+++ b/StudentAppService.cs
@@ -0,0 +1,85 @@
+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginConfirmedDto(int StudentId);
+public record ProgressDto(int StudentId, double DoneHours, int RequiredHours, double RemainingHours);
+
+// Сервис мобильного приложения ученика: вход по одноразовому коду и прогресс обучения.
+public class StudentAppService
+{
+    private const int CodeLifetimeMinutes = 10;
+    private const int RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public StudentAppService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Ответ одинаковый независимо от того, найдена карточка или нет, - чтобы не раскрывать наличие e-mail в базе.
+    public async Task RequestLoginCodeAsync(string rawEmail)
+    {
+        var student = await FindByEmailCaseInsensitiveAsync(rawEmail);
+        if (student is null)
+            return;
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            ExpiresAtUtc = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа", $"Ваш код: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<LoginConfirmedDto?> ConfirmLoginAsync(string rawEmail, string code)
+    {
+        var student = await FindByEmailCaseInsensitiveAsync(rawEmail);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var loginCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && c.Code == code && !c.Used && c.ExpiresAtUtc > now)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+        if (loginCode is null)
+            return null;
+
+        loginCode.Used = true;
+        return new LoginConfirmedDto(student.Id);
+    }
+
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AnyAsync(s => s.Id == studentId);
+        if (!exists)
+            return null;
+
+        var doneMinutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        var doneHours = doneMinutes / 60.0;
+        return new ProgressDto(studentId, doneHours, RequiredHours, Math.Max(0, RequiredHours - doneHours));
+    }
+
+    // Почта из клавиатуры телефона может прийти в любом регистре - карточка ищется без учёта регистра.
+    private Task<Student?> FindByEmailCaseInsensitiveAsync(string rawEmail)
+    {
+        var email = rawEmail.Trim();
+        return _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == email.ToLower())
+            .OrderBy(s => s.Id)
+            .FirstOrDefaultAsync();
+    }
+}
