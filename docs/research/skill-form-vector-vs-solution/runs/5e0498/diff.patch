--- /dev/null
+++ b/ReportService.cs
@@ -0,0 +1,44 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthSummary(int Year, int Month, bool IsClosed, DateOnly? ActSignedOn, decimal TotalHours);
+
+public record YearReport(int Year, List<MonthSummary> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearReport> GetYearSummaryAsync(int year)
+    {
+        // ClosedPeriod.Month конвертируется в int через HasConversion, поэтому сравнение
+        // по Year/Month на уровне LINQ-to-SQL недоступно - фильтруем на клиенте
+        // (таблица закрытых периодов маленькая: одна запись на месяц на всё агентство).
+        var closedPeriods = await _db.ClosedPeriods.AsNoTracking().ToListAsync();
+        var closedByMonth = closedPeriods
+            .Where(p => p.Month.Year == year)
+            .ToDictionary(p => p.Month.Month, p => p.ActSignedOn);
+
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+        var hoursByMonth = await _db.TimeEntries
+            .AsNoTracking()
+            .Where(t => t.WorkDate >= from && t.WorkDate < to)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(g => g.Month, g => g.Hours);
+
+        var months = new List<MonthSummary>(12);
+        for (var month = 1; month <= 12; month++)
+        {
+            var actSignedOn = closedByMonth.GetValueOrDefault(month);
+            var hours = hoursByMonth.GetValueOrDefault(month);
+            months.Add(new MonthSummary(year, month, actSignedOn is not null, actSignedOn, hours));
+        }
+
+        return new YearReport(year, months);
+    }
+}
