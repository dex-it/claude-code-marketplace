+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets.Controllers;
+
+[ApiController]
+[Route("clients")]
+public class ClientsController : ControllerBase
+{
+    private readonly AgencyDbContext _db;
+    private readonly ProjectService _projects;
+
+    public ClientsController(AgencyDbContext db, ProjectService projects)
+    {
+        _db = db;
+        _projects = projects;
+    }
+
+    [HttpDelete("{id:int}/projects")]
+    public async Task<IActionResult> DeleteAllProjects(int id)
+    {
+        var clientExists = await _db.Clients.AnyAsync(c => c.Id == id);
+        if (!clientExists)
+            return NotFound();
+
+        var deletedCount = await _projects.DeleteAllByClientAsync(id);
+        return Ok(new { deletedCount });
+    }
+}
