diff --git a/StudentAppService.cs b/StudentAppService.cs
new file mode 100644
index 0000000..2cd2502
--- /dev/null
+++ b/StudentAppService.cs
@@ -0,0 +1,110 @@
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record AppLoginRequest(string Email);
+public record AppLoginConfirmRequest(string Email, string Code);
+public record AppLoginResult(int StudentId, string FullName);
+public record ProgressDto(int StudentId, double HoursCompleted, int HoursRequired, double HoursRemaining);
+
+public class StudentAppService
+{
+    private const int CodeLifetimeMinutes = 10;
+    private const int MaxAttempts = 5;
+    private const int RequiredDrivingHours = 56;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public StudentAppService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Код не раскрывает отправителю, есть ли такой e-mail в автошколе: ответ одинаков в обоих случаях.
+    public async Task RequestLoginCodeAsync(string email)
+    {
+        var student = await FindStudentByEmailAsync(email);
+        if (student is null)
+            return;
+
+        var now = DateTime.UtcNow;
+
+        // Старые невыданные коды того же ученика больше не годятся для входа.
+        await _db.StudentLoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used)
+            .ExecuteUpdateAsync(s => s.SetProperty(c => c.Used, true));
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.StudentLoginCodes.Add(new StudentLoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Convert.ToHexString(ComputeHash(code)),
+            CreatedAtUtc = now,
+            ExpiresAtUtc = now.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа", $"Ваш код для входа: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<AppLoginResult?> ConfirmLoginCodeAsync(string email, string code)
+    {
+        var student = await FindStudentByEmailAsync(email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var loginCode = await _db.StudentLoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAtUtc > now)
+            .OrderByDescending(c => c.CreatedAtUtc)
+            .FirstOrDefaultAsync();
+
+        if (loginCode is null)
+            return null;
+
+        if (loginCode.Attempts >= MaxAttempts)
+        {
+            loginCode.Used = true; // лимит попыток исчерпан, код больше нельзя подбирать
+            return null;
+        }
+
+        loginCode.Attempts++;
+
+        var expectedHash = Convert.FromHexString(loginCode.CodeHash);
+        var actualHash = ComputeHash(code.Trim());
+        if (!CryptographicOperations.FixedTimeEquals(expectedHash, actualHash))
+            return null;
+
+        loginCode.Used = true;
+        return new AppLoginResult(student.Id, student.FullName);
+    }
+
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AnyAsync(s => s.Id == studentId);
+        if (!exists)
+            return null;
+
+        var doneMinutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        var hoursCompleted = doneMinutes / 60.0;
+        return new ProgressDto(studentId, hoursCompleted, RequiredDrivingHours, Math.Max(0, RequiredDrivingHours - hoursCompleted));
+    }
+
+    // E-mail со телефона приходит как придётся (регистр клавиатуры); уникальность на уровне схемы его не гарантирует.
+    private Task<Student?> FindStudentByEmailAsync(string email)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        return _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == normalized)
+            .OrderBy(s => s.Id)
+            .FirstOrDefaultAsync();
+    }
+
+    private static byte[] ComputeHash(string code) => SHA256.HashData(Encoding.UTF8.GetBytes(code));
+}
