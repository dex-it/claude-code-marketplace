+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorStudentDto>> GetMyStudentsAsync(int instructorId)
+    {
+        var now = DateTime.UtcNow;
+
+        var nextLessons = _db.Lessons
+            .Where(l => l.InstructorId == instructorId && !l.Done && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextStartsAt = g.Min(l => l.StartsAt) });
+
+        var query =
+            from s in _db.Students.AsNoTracking()
+            where s.InstructorId == instructorId && s.Status == StudentStatus.Learning
+            join n in nextLessons on s.Id equals n.StudentId into ln
+            from n in ln.DefaultIfEmpty()
+            orderby s.FullName
+            select new
+            {
+                s.Id,
+                s.FullName,
+                s.Phone,
+                s.Email,
+                s.PassportNo,
+                NextLessonAt = (DateTime?)n.NextStartsAt,
+            };
+
+        var rows = await query.ToListAsync();
+
+        return rows.Select(r => new InstructorStudentDto(
+            r.Id,
+            r.FullName,
+            r.Phone,
+            Student.MaskEmail(r.Email),
+            Student.MaskPassport(r.PassportNo),
+            r.NextLessonAt)).ToList();
+    }
+}
