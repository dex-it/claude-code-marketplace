+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesReportRow(int InstructorId, string InstructorName, bool InstructorDismissed, int GraduatesCount);
+
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Для продления лицензии нужны и уже уволенные инструкторы, поэтому запрет на IsDeleted снят явно,
+    // а изоляция по автошколе восстановлена отдельным условием (IgnoreQueryFilters снимает оба фильтра сразу).
+    public async Task<List<GraduatesReportRow>> GetGraduatesByInstructorAsync(int year)
+    {
+        var query =
+            from s in _db.Students.AsNoTracking()
+            join i in _db.Instructors.AsNoTracking().IgnoreQueryFilters().Where(x => x.SchoolId == _db.SchoolId)
+                on s.InstructorId equals i.Id
+            where s.Status == StudentStatus.Graduated
+                  && s.GraduatedOn != null
+                  && s.GraduatedOn.Value.Year == year
+            group i by new { i.Id, i.FullName, i.IsDeleted } into g
+            orderby g.Key.FullName
+            select new GraduatesReportRow(g.Key.Id, g.Key.FullName, g.Key.IsDeleted, g.Count());
+
+        return await query.ToListAsync();
+    }
+}
