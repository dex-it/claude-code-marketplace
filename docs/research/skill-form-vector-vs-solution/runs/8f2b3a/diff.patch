+
+    // Отметка посещения по телефону: занятие начинается в ближайшие 30 минут или уже идёт.
+    public async Task<CheckinResult> CheckInAsync(string phone, int? enrollmentId)
+    {
+        var key = NormalizePhone(phone);
+        if (key.Length == 0)
+            throw new BadRequestException("Не указан телефон");
+
+        var now = DateTime.UtcNow;
+        var from = now.AddMinutes(-MaxSessionMinutes);
+        var to = now + CheckinLead;
+
+        // Телефоны в базе хранятся в произвольном формате, поэтому сравниваем нормализованные
+        // номера в памяти, предварительно ограничив выборку окном по времени.
+        var enrollments = await _db.Enrollments
+            .Include(e => e.Member)
+            .Include(e => e.Session).ThenInclude(s => s.Course)
+            .Include(e => e.Session).ThenInclude(s => s.Hall)
+            .Where(e => e.Status != EnrollmentStatus.Cancelled
+                        && e.Session.StartsAt >= from && e.Session.StartsAt <= to)
+            .ToListAsync();
+
+        var matches = enrollments
+            .Where(e => e.Session.StartsAt.AddMinutes(e.Session.DurationMinutes) > now
+                        && NormalizePhone(e.Member.Phone) == key)
+            .OrderBy(e => e.Session.StartsAt)
+            .ThenBy(e => e.Member.FullName)
+            .ToList();
+
+        Enrollment? target;
+        if (enrollmentId is not null)
+        {
+            target = matches.FirstOrDefault(e => e.Id == enrollmentId);
+            if (target is null)
+                return new CheckinResult(null, Array.Empty<CheckinCandidate>());
+        }
+        else
+        {
+            var booked = matches.Where(e => e.Status == EnrollmentStatus.Booked).ToList();
+            if (booked.Count > 1)
+                return new CheckinResult(null, booked.Select(ToCandidate).ToList());
+            // Если все подходящие записи уже отмечены - повторная отметка ничего не меняет.
+            target = booked.SingleOrDefault() ?? matches.FirstOrDefault();
+            if (target is null)
+                return new CheckinResult(null, Array.Empty<CheckinCandidate>());
+        }
+
+        if (target.Status == EnrollmentStatus.Booked)
+        {
+            target.Status = EnrollmentStatus.Attended;
+            target.AttendedAt = now;
+            await _db.SaveChangesAsync();
+        }
+
+        return new CheckinResult(ToCandidate(target), Array.Empty<CheckinCandidate>());
+    }
+
+    // Загрузка расписания курса целиком; разрешена только для черновика.
+    public async Task<CourseDto> ReplaceSessionsAsync(int courseId, IReadOnlyList<SessionInput>? input)
+    {
+        if (input is null)
+            throw new BadRequestException("Не передано расписание");
+
+        var planned = input
+            .Select((x, i) => (Index: i, Start: x.StartsAt.UtcDateTime, x.DurationMinutes, x.HallId))
+            .ToList();
+
+        foreach (var p in planned)
+        {
+            if (p.DurationMinutes <= 0 || p.DurationMinutes > MaxSessionMinutes)
+                throw new BadRequestException($"Занятие #{p.Index + 1}: длительность должна быть от 1 до {MaxSessionMinutes} минут");
+            if (p.Start.Minute % 30 != 0 || p.Start.Second != 0 || p.Start.Millisecond != 0)
+                throw new BadRequestException($"Занятие #{p.Index + 1}: начало должно быть в :00 или :30");
+        }
+
+        // Все занятия курса ведёт один тренер - внутри курса занятия не должны пересекаться.
+        var ordered = planned.OrderBy(p => p.Start).ToList();
+        for (var i = 1; i < ordered.Count; i++)
+        {
+            if (ordered[i - 1].Start.AddMinutes(ordered[i - 1].DurationMinutes) > ordered[i].Start)
+                throw new BadRequestException(
+                    $"Занятия #{ordered[i - 1].Index + 1} и #{ordered[i].Index + 1} пересекаются по времени");
+        }
+
+        await using var tx = await _db.Database.BeginTransactionAsync();
+
+        // Блокировка курса не даёт опубликовать его посреди замены расписания.
+        var course = (await _db.Courses
+                .FromSql($"SELECT * FROM \"Courses\" WHERE \"Id\" = {courseId} FOR UPDATE")
+                .ToListAsync())
+            .SingleOrDefault()
+            ?? throw new KeyNotFoundException("Курс не найден");
+
+        if (course.Status != CourseStatus.Draft)
+            throw new ConflictException("Расписание можно менять только у курса в черновике");
+
+        // Блокировки тренера и залов сериализуют параллельные загрузки, претендующие на те же ресурсы.
+        await _db.Trainers
+            .FromSql($"SELECT * FROM \"Trainers\" WHERE \"Id\" = {course.TrainerId} FOR UPDATE")
+            .ToListAsync();
+        var hallIds = planned.Select(p => p.HallId).Distinct().OrderBy(id => id).ToArray();
+        var halls = await _db.Halls
+            .FromSql($"SELECT * FROM \"Halls\" WHERE \"Id\" = ANY({hallIds}) ORDER BY \"Id\" FOR UPDATE")
+            .ToListAsync();
+        var missingHall = hallIds.Except(halls.Select(h => h.Id)).FirstOrDefault();
+        if (missingHall != 0 || halls.Count != hallIds.Length)
+            throw new BadRequestException($"Зал {missingHall} не найден");
+
+        if (planned.Count > 0)
+        {
+            var from = ordered[0].Start.AddMinutes(-MaxSessionMinutes);
+            var to = ordered.Max(p => p.Start.AddMinutes(p.DurationMinutes));
+            var others = await _db.Sessions
+                .AsNoTracking()
+                .Include(s => s.Course)
+                .Where(s => s.CourseId != courseId
+                            && s.Course.Status != CourseStatus.Archived
+                            && (hallIds.Contains(s.HallId) || s.Course.TrainerId == course.TrainerId)
+                            && s.StartsAt >= from && s.StartsAt < to)
+                .ToListAsync();
+
+            foreach (var p in planned)
+            {
+                var end = p.Start.AddMinutes(p.DurationMinutes);
+                var clash = others.FirstOrDefault(o =>
+                    o.StartsAt < end && p.Start < o.StartsAt.AddMinutes(o.DurationMinutes)
+                    && (o.HallId == p.HallId || o.Course.TrainerId == course.TrainerId));
+                if (clash is not null)
+                    throw new ConflictException(clash.HallId == p.HallId
+                        ? $"Занятие #{p.Index + 1}: зал занят курсом «{clash.Course.Title}»"
+                        : $"Занятие #{p.Index + 1}: у тренера в это время курс «{clash.Course.Title}»");
+            }
+        }
+
+        // У черновика записей нет (запись открыта только на опубликованные курсы).
+        await _db.Sessions.Where(s => s.CourseId == courseId).ExecuteDeleteAsync();
+
+        _db.Sessions.AddRange(planned.Select(p => new Session
+        {
+            CourseId = courseId,
+            HallId = p.HallId,
+            StartsAt = p.Start,
+            DurationMinutes = p.DurationMinutes,
+        }));
+        await _db.SaveChangesAsync();
+        await tx.CommitAsync();
+
+        return (await GetCourseAsync(courseId))!;
+    }
+
+    // Ближайшее начинающееся занятие; залы работают параллельно, поэтому занятий с одним
+    // временем начала может быть несколько - возвращаются все.
+    public async Task<IReadOnlyList<ScreenSessionDto>> GetNextSessionsAsync()
+    {
+        var now = DateTime.UtcNow;
+
+        var nextStart = await _db.Sessions
+            .Where(s => s.StartsAt > now && s.Course.Status == CourseStatus.Published)
+            .MinAsync(s => (DateTime?)s.StartsAt);
+        if (nextStart is null)
+            return Array.Empty<ScreenSessionDto>();
+
+        return await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.StartsAt == nextStart.Value && s.Course.Status == CourseStatus.Published)
+            .OrderBy(s => s.Hall.Name)
+            .Select(s => new ScreenSessionDto(s.Id, s.Course.Title, s.Hall.Name, s.StartsAt, s.DurationMinutes,
+                s.Enrollments
+                    .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                    .OrderBy(e => e.Member.FullName)
+                    .Select(e => e.Member.FullName)
+                    .ToList()))
+            .ToListAsync();
+    }
+
+    private static CheckinCandidate ToCandidate(Enrollment e) =>
+        new(e.Id, e.Member.FullName, e.Session.Course.Title, e.Session.Hall.Name, e.Session.StartsAt);
+
+    // Только цифры; российские 8XXXXXXXXXX и 7XXXXXXXXXX приводятся к 10 цифрам.
+    private static string NormalizePhone(string? phone)
+    {
+        var digits = new string((phone ?? "").Where(char.IsAsciiDigit).ToArray());
+        return digits.Length == 11 && (digits[0] == '7' || digits[0] == '8') ? digits[1..] : digits;
+    }
 }
