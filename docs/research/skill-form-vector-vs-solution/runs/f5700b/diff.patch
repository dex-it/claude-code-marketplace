+    // Список для приложения инструктора: та же маскировка, что и в выгрузке, плюс время ближайшего занятия.
+    public async Task<List<InstructorStudentDto>> StudentsForInstructorAsync(int instructorId)
+    {
+        var now = DateTime.UtcNow;
+
+        var nextLessons = await _db.Lessons
+            .Where(l => l.InstructorId == instructorId && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextLessonAt = g.Min(l => l.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.NextLessonAt);
+
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .Select(s => new { s.Id, s.FullName, s.Phone, s.Email, s.PassportNo })
+            .ToListAsync();
+
+        return students
+            .Select(s => new InstructorStudentDto(
+                s.Id,
+                s.FullName,
+                s.Phone,
+                Student.MaskEmail(s.Email),
+                Student.MaskPassport(s.PassportNo),
+                nextLessons.TryGetValue(s.Id, out var next) ? next : null))
+            .ToList();
+    }
+
+    // Прогресс ученика: часы вождения, пройденные по занятиям с отметкой Done, из положенных RequiredDrivingHours.
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AsNoTracking().AnyAsync(s => s.Id == studentId);
+        if (!exists) return null;
+
+        var minutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => (int?)l.Minutes) ?? 0;
+
+        var completedHours = minutes / 60.0;
+        return new ProgressDto(studentId, completedHours, RequiredDrivingHours,
+            Math.Max(0, RequiredDrivingHours - completedHours));
+    }
+
     private static StudentDto ToDto(Student s) =>
         new(s.Id, s.FullName, s.Email, s.Phone, s.Status, s.Instructor?.FullName);
 }
