+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduateReportRow(int InstructorId, string InstructorName, int GraduatesCount);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Для продления лицензии: выпускники за год по инструктору, включая уже уволенных.
+    public async Task<List<GraduateReportRow>> GraduatesByInstructorAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = new DateOnly(year, 12, 31);
+
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.InstructorId != null
+                        && s.GraduatedOn >= from && s.GraduatedOn <= to)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var instructorIds = counts.Select(c => c.InstructorId).ToList();
+
+        // IgnoreQueryFilters: уволенные инструкторы по умолчанию скрыты фильтром, но в отчёте они нужны.
+        var names = await _db.Instructors.IgnoreQueryFilters().AsNoTracking()
+            .Where(i => instructorIds.Contains(i.Id))
+            .Select(i => new { i.Id, i.FullName })
+            .ToDictionaryAsync(i => i.Id, i => i.FullName);
+
+        return counts
+            .Select(c => new GraduateReportRow(c.InstructorId, names.GetValueOrDefault(c.InstructorId, "—"), c.Count))
+            .OrderByDescending(r => r.GraduatesCount)
+            .ToList();
+    }
+}
