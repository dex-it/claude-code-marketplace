+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record AppLoginRequest(string Email);
+public record AppLoginConfirmRequest(string Email, string Code);
+public record AppLoginResult(int StudentId, string FullName);
+
+public class AppAuthService
+{
+    private const int CodeLifetimeMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestCodeAsync(string email)
+    {
+        var normalized = Normalize(email);
+
+        // E-mail не уникален без учёта регистра на уровне схемы, поэтому Single здесь не годится (чек-лист EF Core).
+        var student = await _db.Students
+            .Where(s => s.Email.ToLower() == normalized)
+            .OrderBy(s => s.Id)
+            .Select(s => new { s.Id, s.Email })
+            .FirstOrDefaultAsync();
+
+        // Не сообщаем, есть ли такой e-mail в автошколе - ответ для найденного и ненайденного ученика одинаков.
+        if (student is null) return;
+
+        await _db.LoginCodes.Where(l => l.StudentId == student.Id).ExecuteDeleteAsync();
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            ExpiresAtUtc = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа в AutoSchool.Cloud",
+            $"Ваш код для входа: {code}. Код действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<AppLoginResult?> ConfirmCodeAsync(string email, string code)
+    {
+        var normalized = Normalize(email);
+
+        var student = await _db.Students
+            .Where(s => s.Email.ToLower() == normalized)
+            .OrderBy(s => s.Id)
+            .Select(s => new { s.Id, s.FullName })
+            .FirstOrDefaultAsync();
+
+        if (student is null) return null;
+
+        var now = DateTime.UtcNow;
+        // Уникальный индекс на StudentId гарантирует не более одного действующего кода - Single корректен.
+        var login = await _db.LoginCodes
+            .SingleOrDefaultAsync(l => l.StudentId == student.Id && l.Code == code && l.ExpiresAtUtc > now);
+
+        if (login is null) return null;
+
+        _db.LoginCodes.Remove(login);
+        return new AppLoginResult(student.Id, student.FullName);
+    }
+
+    private static string Normalize(string email) => email.Trim().ToLowerInvariant();
+}
