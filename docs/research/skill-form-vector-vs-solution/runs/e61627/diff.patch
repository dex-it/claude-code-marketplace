+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthlyReport(int Month, DateOnly? ActSignedOn, decimal TotalHours);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<MonthlyReport>> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .AsNoTracking()
+            .Where(p => p.Month.Year == year)
+            .ToDictionaryAsync(p => p.Month, p => p.ActSignedOn);
+
+        var timeEntriesByMonth = await _db.TimeEntries
+            .AsNoTracking()
+            .Where(t => t.WorkDate.Year == year)
+            .GroupBy(t => new YearMonth(t.WorkDate.Year, t.WorkDate.Month))
+            .Select(g => new { Month = g.Key, TotalHours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(x => x.Month, x => x.TotalHours);
+
+        var result = new List<MonthlyReport>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var yearMonth = new YearMonth(year, month);
+            closedPeriods.TryGetValue(yearMonth, out var actSignedOn);
+            timeEntriesByMonth.TryGetValue(yearMonth, out var hours);
+
+            result.Add(new MonthlyReport(month, actSignedOn, hours));
+        }
+
+        return result;
+    }
+}
