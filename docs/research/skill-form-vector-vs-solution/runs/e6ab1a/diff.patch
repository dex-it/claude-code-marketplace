diff --git a/Migrations/20260929120100_BackfillOrderCategories.cs b/Migrations/20260929120100_BackfillOrderCategories.cs
new file mode 100644
index 0000000..facde78
--- /dev/null
+++ b/Migrations/20260929120100_BackfillOrderCategories.cs
@@ -0,0 +1,53 @@
+using Microsoft.EntityFrameworkCore.Migrations;
+
+#nullable disable
+
+namespace Shop.Data.Migrations
+{
+    /// <summary>
+    /// Data migration: переносит исторические значения Order.Category (строка) в Categories/OrderCategories.
+    /// Отдельно от схемной миграции (см. SKILL.md — "Данные и схема в одной миграции").
+    /// Order.Category не трогаем и не удаляем — это сделает последующая миграция, когда все читатели перейдут на новую схему.
+    /// </summary>
+    public partial class BackfillOrderCategories : Migration
+    {
+        protected override void Up(MigrationBuilder migrationBuilder)
+        {
+            // gen_random_uuid() для новых строк Categories (ядро PostgreSQL 13+, pgcrypto для более старых версий)
+            migrationBuilder.Sql("CREATE EXTENSION IF NOT EXISTS pgcrypto;");
+
+            // 1) уникальные непустые значения Order.Category -> строки в Categories
+            migrationBuilder.Sql(@"
+                INSERT INTO ""Categories"" (""Id"", ""Name"")
+                SELECT gen_random_uuid(), src.""Category""
+                FROM (
+                    SELECT DISTINCT ""Category""
+                    FROM ""Orders""
+                    WHERE ""Category"" IS NOT NULL AND ""Category"" <> ''
+                ) src
+                WHERE NOT EXISTS (
+                    SELECT 1 FROM ""Categories"" c WHERE c.""Name"" = src.""Category""
+                );
+            ");
+
+            // 2) связки Order <-> Category по прежнему строковому значению.
+            // Раскрыт весь Orders (включая IsDeleted = true), т.к. raw SQL не применяет query filter, а soft-deleted
+            // заказы всё ещё существуют физически и должны сохранить свои категории.
+            migrationBuilder.Sql(@"
+                INSERT INTO ""OrderCategories"" (""OrderId"", ""CategoryId"")
+                SELECT o.""Id"", c.""Id""
+                FROM ""Orders"" o
+                JOIN ""Categories"" c ON c.""Name"" = o.""Category""
+                WHERE o.""Category"" IS NOT NULL AND o.""Category"" <> ''
+                ON CONFLICT (""OrderId"", ""CategoryId"") DO NOTHING;
+            ");
+        }
+
+        protected override void Down(MigrationBuilder migrationBuilder)
+        {
+            // Намеренно no-op: к моменту отката в Categories/OrderCategories могут появиться записи,
+            // созданные пользователями уже после деплоя (не только бэкафилл) — безопасного отката данных нет.
+            // Схема (таблицы) откатывается предыдущей миграцией.
+        }
+    }
+}
