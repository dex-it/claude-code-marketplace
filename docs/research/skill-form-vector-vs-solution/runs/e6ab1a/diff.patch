@@ -0,0 +1,59 @@
+name: Deploy DB migration
+
+on:
+  workflow_dispatch: {}
+  push:
+    branches: [main]
+    paths:
+      - 'Migrations/**'
+
+jobs:
+  generate-script:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '8.0.x'
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Restore
+        run: dotnet restore
+
+      # SKILL.md: "dotnet ef database update на production" запрещён —
+      # генерируем идемпотентный SQL-скрипт для ревью вместо прямого apply
+      - name: Generate idempotent migration script
+        run: >
+          ~/.dotnet/tools/dotnet-ef migrations script --idempotent
+          --project Shop.Data/Shop.Data.csproj
+          --output migration.sql
+
+      - name: Upload migration script for review
+        uses: actions/upload-artifact@v4
+        with:
+          name: migration-sql
+          path: migration.sql
+
+  apply-to-production:
+    needs: generate-script
+    runs-on: ubuntu-latest
+    # environment "production" настроен в репозитории с обязательными reviewers —
+    # это и есть шаг "ревью SQL" из SKILL.md перед применением на проде
+    environment: production
+    steps:
+      - name: Download reviewed migration script
+        uses: actions/download-artifact@v4
+        with:
+          name: migration-sql
+
+      - name: Apply migration to production DB
+        env:
+          PGHOST: ${{ secrets.PROD_DB_HOST }}
+          PGPORT: ${{ secrets.PROD_DB_PORT }}
+          PGDATABASE: ${{ secrets.PROD_DB_NAME }}
+          PGUSER: ${{ secrets.PROD_DB_USER }}
+          PGPASSWORD: ${{ secrets.PROD_DB_PASSWORD }}
+        run: psql -v ON_ERROR_STOP=1 -f migration.sql
