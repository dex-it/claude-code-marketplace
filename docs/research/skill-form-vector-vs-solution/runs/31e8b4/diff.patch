@@ -0,0 +1,77 @@
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginResultDto(int StudentId, string FullName);
+
+// Вход ученика в мобильное приложение по одноразовому 6-значному коду на e-mail.
+public class AppAuthService
+{
+    private const int CodeTtlMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _emailSender;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender emailSender)
+    {
+        _db = db;
+        _emailSender = emailSender;
+    }
+
+    public async Task RequestCodeAsync(string rawEmail)
+    {
+        var email = rawEmail.Trim();
+
+        // Почта с телефона может прийти в любом регистре — ищем без учёта регистра.
+        var student = await _db.Students
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == email.ToLower());
+
+        // Не раскрываем наличие/отсутствие карточки ученика в ответе.
+        if (student is null) return;
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        var now = DateTime.UtcNow;
+
+        _db.LoginCodes.Add(new LoginOneTimeCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            CreatedAt = now,
+            ExpiresAt = now.AddMinutes(CodeTtlMinutes),
+        });
+
+        await _emailSender.SendAsync(
+            student.Email,
+            "Код для входа в приложение",
+            $"Ваш код для входа: {code}. Код действует {CodeTtlMinutes} минут.");
+    }
+
+    public async Task<LoginResultDto?> ConfirmCodeAsync(string rawEmail, string rawCode)
+    {
+        var email = rawEmail.Trim();
+        var code = rawCode.Trim();
+
+        var student = await _db.Students
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == email.ToLower());
+        if (student is null) return null;
+
+        var hash = Hash(code);
+        var now = DateTime.UtcNow;
+
+        var entry = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now && c.CodeHash == hash)
+            .OrderByDescending(c => c.CreatedAt)
+            .FirstOrDefaultAsync();
+        if (entry is null) return null;
+
+        entry.Used = true;
+        return new LoginResultDto(student.Id, student.FullName);
+    }
+
+    private static string Hash(string code) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(code)));
+}
