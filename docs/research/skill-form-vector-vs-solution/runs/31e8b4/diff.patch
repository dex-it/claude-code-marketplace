@@ -0,0 +1,45 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesByInstructorDto(int? InstructorId, string InstructorName, bool IsDismissed, int GraduatesCount);
+
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Отчёт для продления лицензии: число выпускников за год по каждому инструктору,
+    // включая уже уволенных.
+    public async Task<List<GraduatesByInstructorDto>> GraduatesByInstructorAsync(int year)
+    {
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn != null
+                        && s.GraduatedOn.Value.Year == year)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var instructors = await _db.Instructors
+            .IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId)
+            .OrderBy(i => i.FullName)
+            .ToListAsync();
+
+        var result = instructors
+            .Select(i => new GraduatesByInstructorDto(
+                i.Id,
+                i.FullName,
+                i.IsDeleted,
+                counts.FirstOrDefault(c => c.InstructorId == i.Id)?.Count ?? 0))
+            .ToList();
+
+        var withoutInstructor = counts.FirstOrDefault(c => c.InstructorId == null)?.Count ?? 0;
+        if (withoutInstructor > 0)
+            result.Add(new GraduatesByInstructorDto(null, "Без инструктора", false, withoutInstructor));
+
+        return result;
+    }
+}
