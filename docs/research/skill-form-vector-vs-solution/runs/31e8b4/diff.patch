+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(int Id, string FullName, string Email, string Phone, string PassportNo, DateTime? NextLessonAt);
+
+public class InstructorService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorService(SchoolDbContext db) => _db = db;
+
+    // Список учеников, закреплённых за инструктором и сейчас обучающихся,
+    // в виде карточки для инструктора (паспорт и почта скрыты) + ближайшее занятие.
+    public async Task<List<InstructorStudentDto>?> GetMyStudentsAsync(int instructorId)
+    {
+        var instructorExists = await _db.Instructors.AnyAsync(i => i.Id == instructorId);
+        if (!instructorExists) return null;
+
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var now = DateTime.UtcNow;
+        var nextLessons = await _db.Lessons.AsNoTracking()
+            .Where(l => l.InstructorId == instructorId && !l.Done && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextAt = g.Min(l => l.StartsAt) })
+            .ToListAsync();
+
+        return students
+            .Select(s => s.MaskForInstructor())
+            .Select(s => new InstructorStudentDto(
+                s.Id,
+                s.FullName,
+                s.Email,
+                s.Phone,
+                s.PassportNo,
+                nextLessons.FirstOrDefault(n => n.StudentId == s.Id)?.NextAt))
+            .ToList();
+    }
+}
