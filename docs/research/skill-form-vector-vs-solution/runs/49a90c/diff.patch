+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthReportItem(int Month, bool IsClosed, DateOnly? ActSignedOn, decimal Hours);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<MonthReportItem>> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .Where(p => p.Month.Year == year)
+            .ToListAsync();
+
+        var closedByMonth = closedPeriods.ToDictionary(p => p.Month.Month);
+
+        var monthlyHours = await _db.TimeEntries
+            .Where(t => t.WorkDate.Year == year)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToListAsync();
+
+        var hoursByMonth = monthlyHours.ToDictionary(x => x.Month, x => x.Hours);
+
+        var result = new List<MonthReportItem>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var isClosed = closedByMonth.TryGetValue(month, out var closedPeriod);
+            var hours = hoursByMonth.TryGetValue(month, out var h) ? h : 0m;
+            result.Add(new MonthReportItem(
+                month,
+                isClosed,
+                isClosed ? closedPeriod.ActSignedOn : null,
+                hours
+            ));
+        }
+
+        return result;
+    }
+}
