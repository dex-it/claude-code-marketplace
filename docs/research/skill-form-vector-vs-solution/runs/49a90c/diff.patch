+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Pixelwork.Timesheets;
+
+public static class TimesheetsEndpoints
+{
+    public static void MapTimesheetsEndpoints(this WebApplication app)
+    {
+        var group = app.MapGroup("/api");
+
+        // Задача (а): GET /reports/year/{year}
+        group.MapGet("/reports/year/{year}", GetYearReport)
+            .WithName("GetYearReport")
+            .WithOpenApi();
+
+        // Задача (б): DELETE /clients/{id}/projects
+        group.MapDelete("/clients/{id}/projects", DeleteClientProjects)
+            .WithName("DeleteClientProjects")
+            .WithOpenApi();
+    }
+
+    private static async Task<IResult> GetYearReport(
+        int year,
+        ReportService reportService)
+    {
+        var report = await reportService.GetYearReportAsync(year);
+        return Results.Ok(report);
+    }
+
+    private static async Task<IResult> DeleteClientProjects(
+        int id,
+        ProjectService projectService)
+    {
+        var deletedCount = await projectService.DeleteClientProjectsAsync(id);
+        return Results.Ok(new { deletedProjectsCount = deletedCount });
+    }
+}
