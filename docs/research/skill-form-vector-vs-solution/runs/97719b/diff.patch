+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (а) Карточка заказа: сам заказ + все позиции и все платежи.
+    public Task<Order?> GetOrderCardAsync(Guid orderId) =>
+        _db.Orders
+            .AsNoTracking()
+            .AsSplitQuery()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync(o => o.Id == orderId);
+
+    // (б) Все заказы клиента с позициями и платежами. У клиента могут быть тысячи
+    // заказов, поэтому отдаём поток (IAsyncEnumerable), а не List, чтобы не держать
+    // всё в памяти сразу; AsSplitQuery нужен, чтобы Items и Payments не давали
+    // перекрёстное произведение строк в одном JOIN-запросе.
+    public IAsyncEnumerable<Order> GetCustomerOrdersAsync(Guid customerId) =>
+        _db.Orders
+            .AsNoTracking()
+            .AsSplitQuery()
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .OrderBy(o => o.CreatedAt)
+            .AsAsyncEnumerable();
+
+    // (в) Продукт по SKU. На одном складе SKU уникален, но один и тот же SKU может
+    // лежать на нескольких складах. Если склад не передан (null), пытаемся найти
+    // товар только по SKU: если он есть ровно на одном складе - возвращаем его,
+    // если на нескольких - явно кидаем исключение, а не угадываем склад молча.
+    public async Task<Product?> GetProductBySku(string sku, string? warehouse)
+    {
+        if (warehouse is not null)
+        {
+            return await _db.Products
+                .AsNoTracking()
+                .SingleOrDefaultAsync(p => p.Sku == sku && p.Warehouse == warehouse);
+        }
+
+        var candidates = await _db.Products
+            .AsNoTracking()
+            .Where(p => p.Sku == sku)
+            .ToListAsync();
+
+        if (candidates.Count > 1)
+            throw new InvalidOperationException(
+                $"SKU '{sku}' найден на нескольких складах ({string.Join(", ", candidates.Select(p => p.Warehouse))}); нужно указать склад явно.");
+
+        return candidates.SingleOrDefault();
+    }
+
+    // (г) Дата отгрузки последнего отгруженного заказа клиента. Тип возврата не
+    // nullable, поэтому если у клиента вообще нет отгруженных заказов - это
+    // исключительная ситуация, а не "нет данных".
+    public async Task<DateTime> GetLastShippedAtAsync(Guid customerId)
+    {
+        var shippedAt = await _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .MaxAsync(o => (DateTime?)o.ShippedAt);
+
+        if (shippedAt is null)
+            throw new InvalidOperationException($"У клиента {customerId} нет отгруженных заказов.");
+
+        return shippedAt.Value;
+    }
+}
