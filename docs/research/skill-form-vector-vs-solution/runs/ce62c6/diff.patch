+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorGraduatesDto(int InstructorId, string InstructorName, bool Dismissed, int Graduates);
+
+// Отчёт для продления лицензии автошколы.
+public class ReportsService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportsService(SchoolDbContext db) => _db = db;
+
+    // Включает уволенных инструкторов - лицензия учитывает весь выпуск за год, а не только текущий штат.
+    public async Task<List<InstructorGraduatesDto>> GraduatesByInstructorAsync(int year)
+    {
+        return await _db.Instructors.IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId)
+            .Select(i => new InstructorGraduatesDto(
+                i.Id,
+                i.FullName,
+                i.IsDeleted,
+                _db.Students.Count(s =>
+                    s.InstructorId == i.Id &&
+                    s.Status == StudentStatus.Graduated &&
+                    s.GraduatedOn != null &&
+                    s.GraduatedOn.Value.Year == year)))
+            .OrderBy(r => r.InstructorName)
+            .ToListAsync();
+    }
+}
