+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+// Список учеников инструктора в его мобильном приложении.
+public class InstructorAppService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorAppService(SchoolDbContext db) => _db = db;
+
+    public async Task<List<InstructorStudentDto>> GetAssignedStudentsAsync(int instructorId)
+    {
+        // Только для чтения - без трекинга, чтобы маскирование паспорта/почты ниже не ушло в SaveChanges.
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        if (students.Count == 0) return new List<InstructorStudentDto>();
+
+        var studentIds = students.Select(s => s.Id).ToList();
+        var now = DateTime.UtcNow;
+
+        // Одним запросом ближайшее будущее занятие на каждого ученика - без N+1 по списку.
+        var nextByStudent = await _db.Lessons.AsNoTracking()
+            .Where(l => studentIds.Contains(l.StudentId) && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, Next = g.Min(l => l.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.Next);
+
+        return students
+            .Select(s => s.MaskForInstructor())
+            .Select(s => new InstructorStudentDto(
+                s.Id, s.FullName, s.Phone, s.Email, s.PassportNo,
+                nextByStudent.TryGetValue(s.Id, out var next) ? next : null))
+            .ToList();
+    }
+}
