diff --git a/StudentAppService.cs b/StudentAppService.cs
new file mode 100644
index 0000000..8318deb
--- /dev/null
+++ b/StudentAppService.cs
@@ -0,0 +1,121 @@
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginConfirmResult(bool Success, int? StudentId, string? FullName, string? Error);
+public record ProgressDto(int StudentId, double CompletedHours, double RequiredHours, double RemainingHours);
+
+// Вход ученика в мобильное приложение по одноразовому коду + его прогресс по часам вождения.
+public class StudentAppService
+{
+    private const int CodeLifetimeMinutes = 10;
+    private const int MaxAttempts = 5;
+    private const double RequiredDrivingHours = 56;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public StudentAppService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Почта из мобильной клавиатуры может прийти в любом регистре - сравниваем без учёта регистра.
+    public async Task RequestLoginCodeAsync(string rawEmail)
+    {
+        var normalized = rawEmail.Trim().ToLowerInvariant();
+
+        var student = await _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == normalized)
+            .OrderBy(s => s.Id)
+            .Select(s => new { s.Id, s.Email })
+            .FirstOrDefaultAsync();
+
+        // Карточка не найдена - письмо не отправляем, но ответ клиенту не выдаёт этого (без расхождения в поведении).
+        if (student is null) return;
+
+        await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used)
+            .ExecuteDeleteAsync();
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        var salt = Convert.ToBase64String(RandomNumberGenerator.GetBytes(16));
+
+        _db.LoginCodes.Add(new StudentLoginCode
+        {
+            StudentId = student.Id,
+            Salt = salt,
+            CodeHash = Hash(code, salt),
+            ExpiresAt = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+            Used = false,
+            Attempts = 0,
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа в AutoSchool.Cloud",
+            $"Ваш код: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<LoginConfirmResult> ConfirmLoginAsync(string rawEmail, string rawCode)
+    {
+        var normalized = rawEmail.Trim().ToLowerInvariant();
+        var code = rawCode.Trim();
+
+        var student = await _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == normalized)
+            .OrderBy(s => s.Id)
+            .Select(s => new { s.Id, s.FullName })
+            .FirstOrDefaultAsync();
+
+        const string invalidCodeError = "Код неверен или просрочен";
+        if (student is null) return new LoginConfirmResult(false, null, null, invalidCodeError);
+
+        var loginCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > DateTime.UtcNow)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+
+        if (loginCode is null) return new LoginConfirmResult(false, null, null, invalidCodeError);
+
+        if (loginCode.Attempts >= MaxAttempts)
+        {
+            loginCode.Used = true;
+            return new LoginConfirmResult(false, null, null, invalidCodeError);
+        }
+
+        var matches = CryptographicOperations.FixedTimeEquals(
+            Encoding.UTF8.GetBytes(Hash(code, loginCode.Salt)),
+            Encoding.UTF8.GetBytes(loginCode.CodeHash));
+
+        if (!matches)
+        {
+            loginCode.Attempts++;
+            return new LoginConfirmResult(false, null, null, invalidCodeError);
+        }
+
+        loginCode.Used = true;
+        return new LoginConfirmResult(true, student.Id, student.FullName, null);
+    }
+
+    // Прогресс ученика: сколько часов вождения уже отмечено Done из положенных 56.
+    public async Task<ProgressDto> GetProgressAsync(int studentId)
+    {
+        var completedMinutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        var completedHours = completedMinutes / 60.0;
+        return new ProgressDto(studentId, completedHours, RequiredDrivingHours,
+            Math.Max(0, RequiredDrivingHours - completedHours));
+    }
+
+    private static string Hash(string code, string salt)
+    {
+        var bytes = SHA256.HashData(Encoding.UTF8.GetBytes(code + salt));
+        return Convert.ToHexString(bytes);
+    }
+}
