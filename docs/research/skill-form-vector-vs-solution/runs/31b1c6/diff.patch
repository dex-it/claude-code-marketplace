+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record InstructorStudentDto(
+    int Id, string FullName, string Phone, string Email, string PassportNo, DateTime? NextLessonAt);
+
+// Приложение инструктора.
+public class InstructorService
+{
+    private readonly SchoolDbContext _db;
+
+    public InstructorService(SchoolDbContext db) => _db = db;
+
+    // Список закреплённых учеников, которые сейчас учатся - вид как в выгрузке для инструктора,
+    // плюс время ближайшего ещё не отмеченного как пройденное занятия.
+    public async Task<List<InstructorStudentDto>> GetStudentsAsync(int instructorId)
+    {
+        var now = DateTime.UtcNow;
+
+        var raw = await _db.Students
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .Select(s => new
+            {
+                s.Id,
+                s.FullName,
+                s.Phone,
+                s.Email,
+                s.PassportNo,
+                NextLessonAt = _db.Lessons
+                    .Where(l => l.StudentId == s.Id && !l.Done && l.StartsAt >= now)
+                    .OrderBy(l => l.StartsAt)
+                    .Select(l => (DateTime?)l.StartsAt)
+                    .FirstOrDefault(),
+            })
+            .ToListAsync();
+
+        return raw
+            .Select(s => new InstructorStudentDto(
+                s.Id, s.FullName, s.Phone,
+                Student.MaskEmail(s.Email), Student.MaskPassport(s.PassportNo),
+                s.NextLessonAt))
+            .ToList();
+    }
+}
