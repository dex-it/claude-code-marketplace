+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduateReportLine(int InstructorId, string InstructorName, bool InstructorDismissed, int GraduatesCount);
+
+// Отчёты для продления лицензии автошколы.
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Число выпускников за год по каждому инструктору, включая уже уволенных.
+    public async Task<List<GraduateReportLine>> GraduatesByInstructorAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = new DateOnly(year, 12, 31);
+
+        var counts = await _db.Students
+            .Where(s => s.Status == StudentStatus.Graduated
+                     && s.InstructorId != null
+                     && s.GraduatedOn >= from && s.GraduatedOn <= to)
+            .GroupBy(s => s.InstructorId!.Value)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        if (counts.Count == 0) return [];
+
+        var instructorIds = counts.Select(c => c.InstructorId).ToList();
+
+        // Уволенные инструкторы скрыты фильтром по умолчанию - для отчёта это не нужно.
+        var instructors = await _db.Instructors
+            .IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId && instructorIds.Contains(i.Id))
+            .Select(i => new { i.Id, i.FullName, i.IsDeleted })
+            .ToListAsync();
+
+        return counts
+            .Join(instructors, c => c.InstructorId, i => i.Id,
+                (c, i) => new GraduateReportLine(i.Id, i.FullName, i.IsDeleted, c.Count))
+            .OrderByDescending(l => l.GraduatesCount)
+            .ThenBy(l => l.InstructorName)
+            .ToList();
+    }
+}
