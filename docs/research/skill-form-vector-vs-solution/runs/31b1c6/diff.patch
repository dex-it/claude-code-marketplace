+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequestDto(string Email);
+public record LoginConfirmDto(string Email, string Code);
+public record LoginResultDto(int StudentId, string FullName);
+
+// Вход ученика в мобильное приложение по одноразовому коду на e-mail.
+public class AppAuthService
+{
+    private static readonly TimeSpan CodeLifetime = TimeSpan.FromMinutes(10);
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Ответ одинаков независимо от того, найден ли e-mail - чтобы не палить чужие карточки.
+    public async Task RequestCodeAsync(string email)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalized);
+        if (student is null) return;
+
+        var now = DateTime.UtcNow;
+        var activeCodes = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now)
+            .ToListAsync();
+        foreach (var c in activeCodes) c.Used = true;
+
+        var code = RandomNumberGenerator.GetInt32(100_000, 1_000_000).ToString();
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            ExpiresAt = now + CodeLifetime,
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа", $"Ваш код: {code}. Он действует 10 минут.");
+    }
+
+    public async Task<LoginResultDto?> ConfirmCodeAsync(string email, string code)
+    {
+        var normalized = email.Trim().ToLowerInvariant();
+        var student = await _db.Students.AsNoTracking()
+            .FirstOrDefaultAsync(s => s.Email.ToLower() == normalized);
+        if (student is null) return null;
+
+        var now = DateTime.UtcNow;
+        var loginCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && c.Code == code && !c.Used && c.ExpiresAt > now)
+            .OrderByDescending(c => c.ExpiresAt)
+            .FirstOrDefaultAsync();
+        if (loginCode is null) return null;
+
+        loginCode.Used = true;
+        return new LoginResultDto(student.Id, student.FullName);
+    }
+}
