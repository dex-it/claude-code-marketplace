@@ -0,0 +1,28 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record ProgressDto(int StudentId, double HoursDone, double HoursRequired, double HoursRemaining);
+
+// Приложение ученика: прогресс по часам вождения.
+public class ProgressService
+{
+    private const double RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+
+    public ProgressService(SchoolDbContext db) => _db = db;
+
+    public async Task<ProgressDto?> GetAsync(int studentId)
+    {
+        var exists = await _db.Students.AnyAsync(s => s.Id == studentId);
+        if (!exists) return null;
+
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        var hoursDone = minutesDone / 60.0;
+        return new ProgressDto(studentId, hoursDone, RequiredHours, Math.Max(0, RequiredHours - hoursDone));
+    }
+}
