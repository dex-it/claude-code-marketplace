+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace Tarif.Billing;
+
+public record StatementImportResult(int Credited, int Unmatched, int Duplicates, int Resumed);
+
+public class BankImportService
+{
+    // Ключ advisory-блокировки: загрузки выписок выполняются строго по одной
+    private const long ImportLockKey = 0x7461726966_01;
+
+    private readonly BillingDbContext _db;
+
+    static BankImportService() => Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
+
+    public BankImportService(BillingDbContext db) => _db = db;
+
+    // Интернет-банки отдают CSV то в UTF-8, то в windows-1251
+    public static TextReader OpenStatement(byte[] content)
+    {
+        string text;
+        try
+        {
+            text = new UTF8Encoding(false, throwOnInvalidBytes: true).GetString(content);
+        }
+        catch (DecoderFallbackException)
+        {
+            text = Encoding.GetEncoding(1251).GetString(content);
+        }
+        return new StringReader(text.TrimStart('﻿'));
+    }
+
+    public async Task<StatementImportResult> ImportAsync(IReadOnlyList<StatementLine> lines)
+    {
+        await using var tx = await _db.Database.BeginTransactionAsync();
+        await _db.Database.ExecuteSqlAsync($"SELECT pg_advisory_xact_lock({ImportLockKey})");
+
+        // Уже обработанные строки (зачисленные или отложенные) пропускаем - повторная загрузка безопасна
+        var refs = lines.Select(l => l.BankRef).Distinct().ToList();
+        var known = new HashSet<string>(
+            await _db.Payments.Where(p => refs.Contains(p.BankRef)).Select(p => p.BankRef)
+                .Concat(_db.UnmatchedPayments.Where(u => refs.Contains(u.BankRef)).Select(u => u.BankRef))
+                .ToListAsync());
+
+        var contracts = lines.Select(l => PaymentPurpose.ExtractContractNo(l.Purpose))
+            .OfType<string>().Distinct().ToList();
+
+        // FOR UPDATE: баланс не должен потеряться при параллельных изменениях абонента
+        var subscribers = await _db.Subscribers
+            .FromSql($"SELECT * FROM \"Subscribers\" WHERE \"ContractNo\" = ANY({contracts}) FOR UPDATE")
+            .ToDictionaryAsync(s => s.ContractNo!);
+
+        var now = DateTime.Now;
+        int credited = 0, unmatched = 0, duplicates = 0, resumed = 0;
+
+        foreach (var line in lines)
+        {
+            if (!known.Add(line.BankRef))
+            {
+                duplicates++;
+                continue;
+            }
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            string? reason = null;
+            Subscriber? s = null;
+
+            if (line.Amount <= 0)
+                reason = "Неположительная сумма";
+            else if (contractNo is null)
+                reason = "Номер договора не найден в назначении";
+            else if (!subscribers.TryGetValue(contractNo, out s))
+                reason = $"Нет абонента с договором {contractNo}";
+            else if (s.Status == SubscriberStatus.Closed)
+                reason = $"Договор {contractNo} расторгнут";
+
+            if (reason is not null)
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    Reason = reason,
+                    ReceivedAt = now,
+                });
+                unmatched++;
+                continue;
+            }
+
+            s!.Balance += line.Amount;
+            s.Payments.Add(new Payment
+            {
+                Amount = line.Amount,
+                BankRef = line.BankRef,
+                PaidOn = line.PaidOn,
+                CreditedAt = now,
+                Purpose = line.Purpose,
+            });
+            credited++;
+
+            if (s.Status == SubscriberStatus.Suspended && s.Balance >= 0)
+            {
+                s.Status = SubscriberStatus.Active;
+                s.ResumedAt = now;
+                resumed++;
+            }
+        }
+
+        await _db.SaveChangesAsync();
+        await tx.CommitAsync();
+
+        return new StatementImportResult(credited, unmatched, duplicates, resumed);
+    }
+}
