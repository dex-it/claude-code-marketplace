+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (a) Карточка заказа: одна сущность по PK -> Single безопасен, но данные только читаются.
+    // Include двух коллекций в одном запросе даёт декартово произведение Items x Payments,
+    // поэтому используем AsSplitQuery.
+    public Task<Order?> GetOrderCardAsync(Guid id) =>
+        _db.Orders
+            .AsNoTracking()
+            .Where(o => o.Id == id)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .SingleOrDefaultAsync();
+
+    // (б) У клиента могут быть тысячи заказов - тем более важно не строить декартово
+    // произведение по двум коллекциям в одном Include, поэтому тоже AsSplitQuery + AsNoTracking.
+    public Task<List<Order>> GetOrdersByCustomerAsync(Guid customerId) =>
+        _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId)
+            .OrderBy(o => o.CreatedAt)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .ToListAsync();
+
+    // (в) SKU уникален только в пределах склада, поэтому когда склад не передан (null),
+    // условие "sku" в домене неоднозначно - Single/SingleOrDefault здесь бросит на нескольких
+    // складах. Берём FirstOrDefault с детерминированной сортировкой по складу.
+    public Task<Product?> GetProductBySkuAsync(string sku, string? warehouse) =>
+        _db.Products
+            .AsNoTracking()
+            .Where(p => p.Sku == sku && (warehouse == null || p.Warehouse == warehouse))
+            .OrderBy(p => p.Warehouse)
+            .FirstOrDefaultAsync();
+
+    // (г) Агрегат считаем на стороне БД, а не после материализации всех заказов клиента.
+    // ShippedAt nullable - фильтруем и отбираем без "!", а null-результат (нет отгруженных
+    // заказов) явно превращаем в исключение, раз возвращаемый тип не nullable.
+    public async Task<DateTime> GetLastShippedAtAsync(Guid customerId)
+    {
+        var shippedAt = await _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .Select(o => o.ShippedAt)
+            .MaxAsync();
+
+        return shippedAt
+            ?? throw new InvalidOperationException($"У клиента {customerId} нет отгруженных заказов.");
+    }
+}
