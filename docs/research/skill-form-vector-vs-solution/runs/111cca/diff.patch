+using System.Security.Cryptography;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record AppStudentDto(int Id, string FullName, string Email, string Phone, StudentStatus Status);
+
+// Вход ученика в мобильное приложение по одноразовому коду.
+public class AppAuthService
+{
+    private const int CodeTtlMinutes = 10;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppAuthService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestLoginAsync(string email)
+    {
+        var student = await FindByEmailCaseInsensitiveAsync(email);
+        if (student is null)
+            return; // не раскрываем, зарегистрирован ли такой e-mail
+
+        var now = DateTime.UtcNow;
+
+        // Код, который ещё не был использован, больше не действует после выдачи нового.
+        var pending = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAtUtc > now)
+            .ToListAsync();
+        foreach (var c in pending)
+            c.Used = true;
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            Code = code,
+            ExpiresAtUtc = now.AddMinutes(CodeTtlMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код входа в AutoSchool.Cloud",
+            $"Ваш код для входа: {code}. Он действует {CodeTtlMinutes} минут.");
+    }
+
+    public async Task<AppStudentDto?> ConfirmLoginAsync(string email, string code)
+    {
+        var student = await FindByEmailCaseInsensitiveAsync(email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var enteredCode = code.Trim();
+        var loginCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && c.Code == enteredCode && !c.Used && c.ExpiresAtUtc > now)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+        if (loginCode is null)
+            return null;
+
+        loginCode.Used = true;
+        return new AppStudentDto(student.Id, student.FullName, student.Email, student.Phone, student.Status);
+    }
+
+    private Task<Student?> FindByEmailCaseInsensitiveAsync(string email)
+    {
+        var normalized = email.Trim().ToLower();
+        return _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == normalized);
+    }
+}
