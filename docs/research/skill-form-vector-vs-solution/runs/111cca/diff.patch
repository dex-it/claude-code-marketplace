+    // Список для приложения инструктора: закреплённые ученики, которые сейчас учатся,
+    // в виде карточки инструктора (паспорт и почта скрыты) + ближайшее занятие.
+    public async Task<List<InstructorStudentDto>> GetAssignedStudentsAsync(int instructorId)
+    {
+        // AsNoTracking: MaskForInstructor() меняет Email/PassportNo, эти значения не должны попасть в БД.
+        var students = await _db.Students.AsNoTracking()
+            .Where(s => s.InstructorId == instructorId && s.Status == StudentStatus.Learning)
+            .OrderBy(s => s.FullName)
+            .ToListAsync();
+
+        var now = DateTime.UtcNow;
+        var nextLessons = await _db.Lessons
+            .Where(l => l.InstructorId == instructorId && l.StartsAt >= now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, NextAt = g.Min(l => l.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.NextAt);
+
+        return students
+            .Select(x => x.MaskForInstructor())
+            .Select(s => new InstructorStudentDto(
+                s.Id, s.FullName, s.Email, s.Phone, s.PassportNo, s.Status,
+                nextLessons.TryGetValue(s.Id, out var at) ? at : null))
+            .ToList();
+    }
+
+    // Прогресс ученика: сколько часов вождения уже пройдено (занятия с отметкой Done) из положенных.
+    public async Task<ProgressDto> GetProgressAsync(int studentId)
+    {
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => l.Minutes);
+
+        var hoursDone = Math.Round(minutesDone / 60.0, 2);
+        var hoursRemaining = Math.Max(0, RequiredDrivingHours - hoursDone);
+        return new ProgressDto(studentId, hoursDone, RequiredDrivingHours, hoursRemaining);
+    }
+
     private static StudentDto ToDto(Student s) =>
         new(s.Id, s.FullName, s.Email, s.Phone, s.Status, s.Instructor?.FullName);
 }
