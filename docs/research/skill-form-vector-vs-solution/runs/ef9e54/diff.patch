+    public async Task LoadBankStatementAsync(TextReader reader)
+    {
+        var lines = BankStatement.Parse(reader);
+        var now = DateTime.Now;
+
+        foreach (var line in lines)
+        {
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+
+            if (contractNo is null)
+            {
+                var unrec = new UnreconciledPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    CreatedAt = now
+                };
+                _db.UnreconciledPayments.Add(unrec);
+                continue;
+            }
+
+            var subscriber = await _db.Subscribers.SingleOrDefaultAsync(s => s.ContractNo == contractNo);
+            if (subscriber is null)
+            {
+                var unrec = new UnreconciledPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    CreatedAt = now
+                };
+                _db.UnreconciledPayments.Add(unrec);
+                continue;
+            }
+
+            var existingPayment = await _db.Payments.AnyAsync(p => p.BankRef == line.BankRef);
+            if (existingPayment)
+                continue;
+
+            var payment = new Payment
+            {
+                SubscriberId = subscriber.Id,
+                Amount = line.Amount,
+                BankRef = line.BankRef,
+                PaidOn = line.PaidOn,
+                CreditedAt = now,
+                Purpose = line.Purpose
+            };
+
+            subscriber.Balance += line.Amount;
+
+            if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+            {
+                subscriber.Status = SubscriberStatus.Active;
+                subscriber.RestoredAt = now;
+            }
+
+            _db.Payments.Add(payment);
+        }
+
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<List<SubscriberDto>> SearchByPhoneAsync(string phoneDigits)
+    {
+        var subscribers = await _db.Subscribers.AsNoTracking()
+            .Where(s => s.Phone.EndsWith(phoneDigits))
+            .Take(20)
+            .ToListAsync();
+
+        return subscribers.Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToList();
+    }
 }
