+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+public record PlanWorkItemDto(string WorkCode, string Title, int PeriodDays);
+
+public static class HousingEndpoints
+{
+    public static void MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Реестр заявок диспетчера: сортировка по клику на заголовок таблицы.
+        app.MapGet("/requests", async (
+            string? text, RequestStatus? status, int? houseId, string? district,
+            string? sort, string? dir, int page, int pageSize, HousingService service) =>
+        {
+            var search = new RequestSearch(text, status, houseId, district,
+                ParseSort(sort), ParseDir(dir),
+                page == 0 ? 1 : page, pageSize == 0 ? 50 : pageSize);
+
+            return Results.Ok(await service.SearchAsync(search));
+        });
+
+        // Мастер закрывает заявку: Done + обязательный комментарий о выполненных работах.
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService service) =>
+        {
+            if (string.IsNullOrWhiteSpace(body.Comment))
+                return Results.BadRequest("Комментарий о выполненных работах обязателен");
+
+            var outcome = await service.CloseRequestAsync(id, body.Comment.Trim());
+            return outcome switch
+            {
+                CloseOutcome.Success => Results.NoContent(),
+                CloseOutcome.NotFound => Results.NotFound(),
+                CloseOutcome.Conflict => Results.Conflict("Закрыть можно только заявку в статусе InProgress"),
+                _ => Results.Problem(),
+            };
+        });
+
+        // Инженер присылает план обслуживания дома целиком - план дома становится таким, как присланный список.
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanWorkItemDto> items, PlanService service) =>
+        {
+            try
+            {
+                var plan = items.Select(i => new PlanWorkItem(i.WorkCode, i.Title, i.PeriodDays)).ToList();
+                await service.ReplacePlanAsync(id, plan);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+        });
+    }
+
+    private static RequestSort ParseSort(string? sort) => sort?.ToLowerInvariant() switch
+    {
+        "address" => RequestSort.Address,
+        "status" => RequestSort.Status,
+        _ => RequestSort.Date,
+    };
+
+    private static SortDirection ParseDir(string? dir) =>
+        string.Equals(dir, "asc", StringComparison.OrdinalIgnoreCase) ? SortDirection.Asc : SortDirection.Desc;
+}
