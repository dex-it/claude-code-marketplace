+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearReportItem(int Month, DateOnly? ActSignedOn, decimal TotalHours);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<YearReportItem>> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .Where(p => p.Month.Year == year)
+            .ToDictionaryAsync(p => p.Month.Month, p => p.ActSignedOn);
+
+        var result = new List<YearReportItem>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var from = new DateOnly(year, month, 1);
+            var to = from.AddMonths(1);
+            var totalHours = await _db.TimeEntries
+                .Where(t => t.WorkDate >= from && t.WorkDate < to)
+                .SumAsync(t => t.Hours);
+
+            closedPeriods.TryGetValue(month, out var actSignedOn);
+            result.Add(new YearReportItem(month, actSignedOn, totalHours));
+        }
+
+        return result;
+    }
+}
