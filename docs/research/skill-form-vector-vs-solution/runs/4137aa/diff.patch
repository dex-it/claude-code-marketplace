+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearReportMonthDto(int Month, DateTime? ActSignedOn, decimal TotalHours);
+
+public class ReportsService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportsService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<YearReportMonthDto>> GetYearReportAsync(int year)
+    {
+        var result = new List<YearReportMonthDto>();
+
+        for (int month = 1; month <= 12; month++)
+        {
+            var yearMonth = new YearMonth(year, month);
+            var fromDate = yearMonth.FirstDay;
+            var toDate = fromDate.AddMonths(1);
+
+            var closedPeriod = await _db.ClosedPeriods
+                .AsNoTracking()
+                .FirstOrDefaultAsync(p => p.Month == yearMonth);
+
+            var totalHours = await _db.TimeEntries
+                .AsNoTracking()
+                .Where(t => t.WorkDate >= fromDate && t.WorkDate < toDate)
+                .SumAsync(t => t.Hours);
+
+            result.Add(new YearReportMonthDto(month, closedPeriod?.ActSignedOn.ToDateTime(TimeOnly.MinValue), totalHours));
+        }
+
+        return result;
+    }
+}
