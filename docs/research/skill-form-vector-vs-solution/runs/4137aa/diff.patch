+using Microsoft.AspNetCore.Mvc;
+
+namespace Pixelwork.Timesheets;
+
+[ApiController]
+[Route("[controller]")]
+public class ReportsController(ReportsService reportsService) : ControllerBase
+{
+    [HttpGet("year/{year}")]
+    public async Task<ActionResult<List<YearReportMonthDto>>> GetYearReport(int year)
+    {
+        if (year < 1900 || year > 2100)
+            return BadRequest("Invalid year");
+
+        var report = await reportsService.GetYearReportAsync(year);
+        return Ok(report);
+    }
+}
+
+[ApiController]
+[Route("[controller]")]
+public class ClientsController(ProjectService projectService) : ControllerBase
+{
+    [HttpDelete("{id}/projects")]
+    public async Task<IActionResult> DeleteClientProjects(int id)
+    {
+        try
+        {
+            await projectService.DeleteClientProjectsAsync(id);
+            return NoContent();
+        }
+        catch (InvalidOperationException ex)
+        {
+            return BadRequest(ex.Message);
+        }
+    }
+}
