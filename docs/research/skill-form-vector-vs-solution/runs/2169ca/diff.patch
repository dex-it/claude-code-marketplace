@@ -0,0 +1,34 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+public record LoansByBranchReportRequest(DateTimeOffset From, DateTimeOffset To);
+
+public sealed class LoansByBranchRow
+{
+    public int BranchId { get; init; }
+    public string BranchName { get; init; } = "";
+    public int LoanCount { get; init; }
+}
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // Число выдач по каждому филиалу за период [from, to); DateTimeOffset сравнивается по
+    // абсолютному моменту времени, поэтому часовой пояс, присланный фронтом, роли не играет.
+    public async Task<List<LoansByBranchRow>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to) =>
+        await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .GroupBy(l => new { l.BranchId, l.Branch.Name })
+            .Select(g => new LoansByBranchRow
+            {
+                BranchId = g.Key.BranchId,
+                BranchName = g.Key.Name,
+                LoanCount = g.Count(),
+            })
+            .OrderBy(r => r.BranchName)
+            .ToListAsync();
+}
