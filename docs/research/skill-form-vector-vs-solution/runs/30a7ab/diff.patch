+using System.ComponentModel.DataAnnotations;
+
+namespace BookQuarter.Library;
+
+// Секция "Fines" в appsettings.
+public class FineOptions
+{
+    public const string Section = "Fines";
+
+    // Штраф за один день просрочки, руб.
+    [Range(typeof(decimal), "0", "100000")]
+    public decimal PerDay { get; set; } = 10m;
+}
+
+// Секция "Library" в appsettings.
+public class LibraryOptions
+{
+    public const string Section = "Library";
+
+    // Часовой пояс сети: в нём методист задаёт границы периода отчёта (даты из формы - местные).
+    [Required]
+    public string TimeZone { get; set; } = "Europe/Moscow";
+}
