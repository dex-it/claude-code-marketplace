diff --git a/ReportService.cs b/ReportService.cs
new file mode 100644
index 0000000..bf64ce6
--- /dev/null
+++ b/ReportService.cs
@@ -0,0 +1,167 @@
+using System.Globalization;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+
+namespace BookQuarter.Library;
+
+public record OverdueLoanDto(int LoanId, string CardNumber, string ReaderName, string Phone,
+    string BookTitle, string BookAuthor, DateOnly DueDate, int OverdueDays);
+
+public record BranchLoansDto(int BranchId, string BranchName, int Loans);
+
+public record CsvExport(byte[] Content, string FileName, int Rows);
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+    private readonly FineOptions _fines;
+    private readonly TimeZoneInfo _tz;
+
+    public ReportService(LibraryDbContext db, IOptions<FineOptions> fines, IOptions<LibraryOptions> library)
+    {
+        _db = db;
+        _fines = fines.Value;
+        _tz = TimeZoneInfo.FindSystemTimeZoneById(library.Value.TimeZone);
+    }
+
+    // "Сегодня" - так же, как в Loan.IsOverdue/OverdueDays, чтобы дни просрочки
+    // и сумма в выгрузке совпадали с тем, что начислит ReturnAsync.
+    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);
+
+    // (а) Просроченные выдачи филиала для обзвона. Телефон полный - список для сотрудников филиала.
+    public async Task<IReadOnlyList<OverdueLoanDto>?> GetBranchOverdueAsync(int branchId)
+    {
+        if (!await _db.Branches.AnyAsync(b => b.Id == branchId))
+            return null;
+
+        var today = Today;
+
+        // Loan.IsOverdue/OverdueDays вычисляются в C# и в SQL не транслируются,
+        // поэтому условие просрочки пишем явно, а дни считаем после загрузки.
+        var rows = await _db.Loans
+            .AsNoTracking()
+            .Where(l => l.BranchId == branchId && l.ReturnedAt == null && l.DueDate < today)
+            .OrderBy(l => l.DueDate)
+            .ThenBy(l => l.Reader.FullName)
+            .Select(l => new
+            {
+                l.Id,
+                l.Reader.CardNumber,
+                l.Reader.FullName,
+                l.Reader.Phone,
+                l.Book.Title,
+                l.Book.Author,
+                l.DueDate,
+            })
+            .ToListAsync();
+
+        return rows
+            .Select(r => new OverdueLoanDto(r.Id, r.CardNumber, r.FullName, r.Phone, r.Title, r.Author,
+                r.DueDate, today.DayNumber - r.DueDate.DayNumber))
+            .ToList();
+    }
+
+    // (б) Должники всей сети для коллекторского агентства + запись в журнал выгрузок.
+    public async Task<CsvExport> ExportDebtorsAsync(string exportedBy)
+    {
+        var today = Today;
+
+        // Проекция, а не сущности: контакты маскируем в строках, а не в отслеживаемом Reader,
+        // иначе SaveChanges для ExportLog записал бы маску в карточки читателей.
+        var loans = await _db.Loans
+            .AsNoTracking()
+            .Where(l => l.ReturnedAt == null && l.DueDate < today)
+            .Select(l => new
+            {
+                l.ReaderId,
+                l.Reader.FullName,
+                l.Reader.CardNumber,
+                l.Reader.Phone,
+                l.Reader.Email,
+                l.DueDate,
+            })
+            .ToListAsync();
+
+        // Сумма за текущую просрочку: по всем невозвращённым просроченным книгам читателя,
+        // по действующей ставке. Начисленный ранее FineBalance сюда не входит.
+        var debtors = loans
+            .GroupBy(l => l.ReaderId)
+            .Select(g =>
+            {
+                var r = g.First();
+                var days = g.Sum(l => today.DayNumber - l.DueDate.DayNumber);
+                return new
+                {
+                    r.FullName,
+                    r.CardNumber,
+                    Phone = ReaderExtensions.MaskPhone(r.Phone),
+                    Email = ReaderExtensions.MaskEmail(r.Email),
+                    Fine = days * _fines.PerDay,
+                };
+            })
+            .OrderBy(d => d.FullName, StringComparer.Create(new CultureInfo("ru-RU"), false))
+            .ThenBy(d => d.CardNumber)
+            .ToList();
+
+        var sb = new StringBuilder();
+        sb.Append("ФИО;Номер билета;Телефон;E-mail;Штраф\r\n");
+        foreach (var d in debtors)
+        {
+            sb.Append(Csv(d.FullName)).Append(';')
+              .Append(Csv(d.CardNumber)).Append(';')
+              .Append(Csv(d.Phone)).Append(';')
+              .Append(Csv(d.Email)).Append(';')
+              .Append(d.Fine.ToString("0.00", CultureInfo.InvariantCulture))
+              .Append("\r\n");
+        }
+
+        _db.ExportLogs.Add(new ExportLog
+        {
+            Target = "debtors.csv",
+            ExportedBy = exportedBy,
+            ExportedAt = DateTime.UtcNow,
+            Rows = debtors.Count,
+        });
+        await _db.SaveChangesAsync();
+
+        // UTF-8 с BOM, разделитель ";" - чтобы Excel с русской локалью открыл кириллицу и колонки.
+        var content = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
+        return new CsvExport(content, $"debtors-{today:yyyy-MM-dd}.csv", debtors.Count);
+    }
+
+    // (в) Число выдач по филиалам за период [from; to] включительно, даты - местные для сети.
+    public async Task<IReadOnlyList<BranchLoansDto>> GetLoansByBranchAsync(DateOnly from, DateOnly to)
+    {
+        // IssuedAt хранится в UTC: переводим местные границы суток в UTC,
+        // верхнюю границу берём как начало следующего дня (полуинтервал).
+        var fromUtc = TimeZoneInfo.ConvertTimeToUtc(from.ToDateTime(TimeOnly.MinValue), _tz);
+        var toUtc = TimeZoneInfo.ConvertTimeToUtc(to.AddDays(1).ToDateTime(TimeOnly.MinValue), _tz);
+
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= fromUtc && l.IssuedAt < toUtc)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.BranchId, x => x.Count);
+
+        // Филиалы без выдач тоже попадают в отчёт с нулём.
+        var branches = await _db.Branches.AsNoTracking().OrderBy(b => b.Name).ToListAsync();
+        return branches
+            .Select(b => new BranchLoansDto(b.Id, b.Name, counts.GetValueOrDefault(b.Id)))
+            .ToList();
+    }
+
+    private static string Csv(string? value)
+    {
+        value ??= "";
+
+        // Защита от CSV-инъекций: ячейки, начинающиеся с формульных символов, Excel исполнит.
+        if (value.Length > 0 && "=+-@\t\r".Contains(value[0]))
+            value = "'" + value;
+
+        if (value.IndexOfAny(new[] { ';', '"', '\r', '\n' }) >= 0)
+            value = "\"" + value.Replace("\"", "\"\"") + "\"";
+
+        return value;
+    }
+}
