+namespace Shop.Data;
+
+// Resolve one instance per unit of work (scoped DbContext). A nightly caller
+// (timer/hosted job) must create a fresh scope per run via IServiceScopeFactory
+// instead of holding this service/DbContext for the lifetime of a singleton.
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // a) +10% price to a whole category as a single UPDATE statement -
+    // no loading, no tracking, no per-row SaveChanges.
+    public Task<int> RaisePricesAsync(string category, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * 1.1m), ct);
+
+    // b) Nightly purge of AuditLogs older than a year (~40M of ~50M rows).
+    // Deletes in small batches instead of one ExecuteDeleteAsync over the whole
+    // predicate: a single statement affecting 40M rows would run as one long
+    // transaction, hold locks/row versions for its whole duration and bloat WAL,
+    // blocking autovacuum in the meantime. ExecuteDeleteAsync doesn't open an
+    // ambient transaction by itself, so each batch commits independently, keeps
+    // individual transactions short and lets autovacuum reclaim space as it goes.
+    // Batch selection can't use Take() directly inside ExecuteDeleteAsync (no
+    // ORDER BY/LIMIT support on the delete target in EF Core 8), so IDs are
+    // selected first and then deleted by ID.
+    public async Task<long> PurgeOldAuditLogsAsync(int batchSize = 5000, CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow.AddYears(-1); // At maps to timestamptz -> must stay Kind=Utc
+        long totalDeleted = 0;
+        int deletedInBatch;
+
+        do
+        {
+            var ids = await _db.AuditLogs
+                .Where(a => a.At < cutoff)
+                .OrderBy(a => a.Id)
+                .Select(a => a.Id)
+                .Take(batchSize)
+                .ToListAsync(ct);
+
+            if (ids.Count == 0)
+                break;
+
+            deletedInBatch = await _db.AuditLogs
+                .Where(a => ids.Contains(a.Id))
+                .ExecuteDeleteAsync(ct);
+
+            totalDeleted += deletedInBatch;
+
+            if (deletedInBatch > 0)
+                await Task.Delay(50, ct); // yield between batches instead of hammering the DB back-to-back
+        } while (deletedInBatch > 0);
+
+        return totalDeleted;
+    }
+
+    // в) Restock: load the requested products once, apply all increments in
+    // memory, then a single SaveChangesAsync for the whole batch (not one
+    // SaveChanges per row).
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var list = items as IReadOnlyCollection<(Guid Id, int Add)> ?? items.ToList();
+        if (list.Count == 0)
+            return;
+
+        var ids = list.Select(x => x.Id).Distinct().ToList();
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToDictionaryAsync(p => p.Id, ct);
+
+        foreach (var (id, add) in list)
+        {
+            if (products.TryGetValue(id, out var product))
+                product.Stock += add;
+        }
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // г) New product with a client-generated key: Add (not AddAsync), since the
+    // Guid needs no database round-trip to be generated.
+    public async Task<Product> CreateProductAsync(
+        string sku, string category, string warehouse, decimal price, int initialStock = 0,
+        CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Category = category,
+            Warehouse = warehouse,
+            Price = price,
+            Stock = initialStock
+        };
+
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+
+        return product;
+    }
+}
