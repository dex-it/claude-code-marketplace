+    public async Task FreezeAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Число дней должно быть больше нуля");
+
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        member.FrozenFrom = now;
+        member.FrozenUntil = now.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenFrom = null;
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    // «Тайный гость»: случайное занятие из ближайших 7 дней.
+    public async Task<QualityCheckDto?> GetRandomQualityCheckSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        var candidateIds = await _db.Sessions
+            .Where(s => s.StartsAt >= now && s.StartsAt <= until)
+            .Select(s => s.Id)
+            .ToListAsync();
+
+        if (candidateIds.Count == 0)
+            return null;
+
+        var sessionId = candidateIds[Random.Shared.Next(candidateIds.Count)];
+
+        return await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.Id == sessionId)
+            .Select(s => new QualityCheckDto(
+                s.Id,
+                s.Course.Title,
+                s.Course.Trainer.FullName,
+                s.Hall.Name,
+                s.StartsAt,
+                s.Enrollments
+                    .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                    .Select(e => e.Member.FullName)
+                    .ToList()))
+            .FirstAsync();
+    }
 }
