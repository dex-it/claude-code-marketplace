+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (a) +10% to all products in a category. Bulk UPDATE (ExecuteUpdateAsync) — no entities
+    // are loaded into memory, so this scales to large categories.
+    public Task<int> RaisePricesAsync(string category, decimal percent = 0.10m, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * (1 + percent)), ct);
+
+    // (b) Nightly purge of AuditLogs older than a year. Table is ~50M rows / ~40M to delete,
+    // so this is done as small batched DELETEs (subquery + LIMIT, PK order) instead of one
+    // giant DELETE: avoids a multi-hour transaction, excessive WAL/replication lag and long
+    // table locks, and lets autovacuum keep up. Intended to be invoked by a nightly job/cron.
+    public async Task<long> PurgeOldAuditLogsAsync(
+        TimeSpan? olderThan = null,
+        int batchSize = 5000,
+        TimeSpan? delayBetweenBatches = null,
+        CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow - (olderThan ?? TimeSpan.FromDays(365));
+        var delay = delayBetweenBatches ?? TimeSpan.FromMilliseconds(200);
+        long totalDeleted = 0;
+
+        while (!ct.IsCancellationRequested)
+        {
+            var deleted = await _db.Database.ExecuteSqlInterpolatedAsync($@"
+                DELETE FROM ""AuditLogs""
+                WHERE ""Id"" IN (
+                    SELECT ""Id"" FROM ""AuditLogs""
+                    WHERE ""At"" < {cutoff}
+                    ORDER BY ""Id""
+                    LIMIT {batchSize}
+                )", ct);
+
+            totalDeleted += deleted;
+            if (deleted < batchSize) break;
+
+            await Task.Delay(delay, ct);
+        }
+
+        return totalDeleted;
+    }
+
+    // (c) Load products and bump Stock, save once. Duplicate ids are summed; unknown ids are ignored.
+    public async Task<int> RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var increments = new Dictionary<Guid, int>();
+        foreach (var (id, add) in items)
+            increments[id] = increments.GetValueOrDefault(id) + add;
+
+        if (increments.Count == 0) return 0;
+
+        var ids = increments.Keys.ToList();
+        var products = await _db.Products.Where(p => ids.Contains(p.Id)).ToListAsync(ct);
+        foreach (var product in products)
+            product.Stock += increments[product.Id];
+
+        await _db.SaveChangesAsync(ct);
+        return products.Count;
+    }
+
+    // (d) Create a product with a fresh Guid.
+    public async Task<Product> CreateProductAsync(
+        string sku,
+        string category,
+        decimal price,
+        int stock = 0,
+        string warehouse = "",
+        CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Category = category,
+            Price = price,
+            Stock = stock,
+            Warehouse = warehouse,
+        };
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
