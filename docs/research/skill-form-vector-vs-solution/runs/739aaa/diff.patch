+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record YearMonthReport(int Month, DateTime? ActSignedOn, decimal TotalHours);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<List<YearMonthReport>> GetYearReportAsync(int year)
+    {
+        var closedPeriods = await _db.ClosedPeriods
+            .Where(p => p.Month.Year == year)
+            .ToDictionaryAsync(p => p.Month.Key, p => p.ActSignedOn);
+
+        var timeEntriesByMonth = await _db.TimeEntries
+            .Where(t => t.WorkDate.Year == year)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(x => x.Month, x => x.Hours);
+
+        var result = new List<YearMonthReport>();
+        for (int month = 1; month <= 12; month++)
+        {
+            var key = year * 100 + month;
+            var actSignedOn = closedPeriods.ContainsKey(key) ? closedPeriods[key] : (DateTime?)null;
+            var totalHours = timeEntriesByMonth.ContainsKey(month) ? timeEntriesByMonth[month] : 0m;
+            result.Add(new YearMonthReport(month, actSignedOn, totalHours));
+        }
+
+        return result;
+    }
+}
