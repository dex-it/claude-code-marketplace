@@ -0,0 +1,35 @@
+name: Deploy
+
+on:
+  push:
+    branches: [main]
+
+jobs:
+  migrate-database:
+    name: Apply EF Core migrations (production)
+    runs-on: ubuntu-latest
+    environment: production # requires manual approval + holds PROD_DB_CONNECTION_STRING secret
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: "8.0.x"
+
+      - name: Restore dotnet-ef
+        run: dotnet tool restore
+
+      - name: Apply migrations to production
+        run: >
+          dotnet tool run dotnet-ef database update
+          --project Shop.Data/Shop.Data.csproj
+          --connection "${{ secrets.PROD_DB_CONNECTION_STRING }}"
+          --verbose
+
+  deploy-app:
+    name: Deploy application
+    needs: migrate-database
+    runs-on: ubuntu-latest
+    environment: production
+    steps:
+      - run: echo "Deploy the app here (after migrations succeeded)"
