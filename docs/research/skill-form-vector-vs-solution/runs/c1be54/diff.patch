+namespace Shop.Data;
+
+public record ActiveOrderRow(Guid OrderId, string CustomerName, decimal Total, int ItemCount);
+
+public record OverdueOrderRow(Guid OrderId, string CustomerName, DateTime CreatedAt, decimal Total);
+
+public class OrderReportService
+{
+    private const string ActiveStatus = "active";
+
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    // (a) Active orders: id, customer name, total, item count.
+    public Task<List<ActiveOrderRow>> GetActiveOrdersAsync(CancellationToken ct = default) =>
+        _orders.Query()
+            .Where(o => o.Status == ActiveStatus)
+            .Select(o => new ActiveOrderRow(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync(ct);
+
+    // (b) Count of active orders per category.
+    public Task<Dictionary<string, int>> GetActiveOrderCountByCategoryAsync(CancellationToken ct = default) =>
+        _orders.Query()
+            .Where(o => o.Status == ActiveStatus)
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count, ct);
+
+    // (c) Overdue orders at the given moment, per Order.IsOverdue rule
+    // (ShippedAt == null && CreatedAt.AddDays(3) < now), inlined so EF can translate it to SQL.
+    public Task<List<OverdueOrderRow>> GetOverdueOrdersAsync(DateTime now, CancellationToken ct = default) =>
+        _orders.Query()
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Select(o => new OverdueOrderRow(o.Id, o.Customer.Name, o.CreatedAt, o.Total))
+            .ToListAsync(ct);
+}
