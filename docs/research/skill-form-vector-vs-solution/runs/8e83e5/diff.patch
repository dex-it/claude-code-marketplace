diff --git a/PaymentImportService.cs b/PaymentImportService.cs
new file mode 100644
index 0000000..0002a85
--- /dev/null
+++ b/PaymentImportService.cs
@@ -0,0 +1,94 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace Tarif.Billing;
+
+public record StatementImportResult(int Credited, int Unmatched, int AlreadyLoaded, int Reactivated);
+
+public class PaymentImportService
+{
+    private readonly BillingDbContext _db;
+
+    public PaymentImportService(BillingDbContext db) => _db = db;
+
+    public async Task<StatementImportResult> ImportAsync(IReadOnlyList<StatementLine> lines)
+    {
+        var now = DateTime.Now;
+
+        // Одна и та же строка может встретиться в файле дважды (выгрузка за пересекающиеся периоды).
+        var unique = lines.GroupBy(l => l.BankRef).Select(g => g.First()).ToList();
+        var refs = unique.Select(l => l.BankRef).ToList();
+
+        await using var tx = await _db.Database.BeginTransactionAsync();
+
+        // Повторная загрузка: строка уже есть либо среди платежей, либо среди неразобранных.
+        var known = new HashSet<string>(
+            await _db.Payments.Where(p => refs.Contains(p.BankRef)).Select(p => p.BankRef)
+                .Concat(_db.UnmatchedPayments.Where(u => refs.Contains(u.BankRef)).Select(u => u.BankRef))
+                .ToListAsync());
+        var fresh = unique.Where(l => !known.Contains(l.BankRef))
+            .Select(l => (Line: l, ContractNo: PaymentPurpose.ExtractContractNo(l.Purpose)))
+            .ToList();
+
+        var contractNos = fresh.Where(x => x.ContractNo != null).Select(x => x.ContractNo!).Distinct().ToList();
+        var subscriberIds = await _db.Subscribers.AsNoTracking()
+            .Where(s => s.ContractNo != null && contractNos.Contains(s.ContractNo))
+            .ToDictionaryAsync(s => s.ContractNo!, s => s.Id);
+
+        var payments = new List<Payment>();
+        foreach (var (line, contractNo) in fresh)
+        {
+            if (contractNo != null && subscriberIds.TryGetValue(contractNo, out var subscriberId))
+            {
+                payments.Add(new Payment
+                {
+                    SubscriberId = subscriberId,
+                    Amount = line.Amount,
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    CreditedAt = now,
+                    Purpose = line.Purpose,
+                });
+            }
+            else
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    ContractNo = contractNo,
+                    LoadedAt = now,
+                });
+            }
+        }
+        _db.Payments.AddRange(payments);
+
+        // Сначала вставляем платежи: при параллельной загрузке той же выписки вторая транзакция
+        // упадёт на уникальном индексе BankRef раньше, чем тронет балансы.
+        await _db.SaveChangesAsync();
+
+        // Баланс увеличиваем в самой БД, чтобы не затереть параллельные списания абонентской платы.
+        // Порядок по Id - чтобы две загрузки не взаимоблокировались.
+        var credits = payments.GroupBy(p => p.SubscriberId)
+            .Select(g => (SubscriberId: g.Key, Amount: g.Sum(p => p.Amount)))
+            .OrderBy(c => c.SubscriberId);
+        foreach (var (id, amount) in credits)
+        {
+            await _db.Subscribers.Where(s => s.Id == id)
+                .ExecuteUpdateAsync(u => u.SetProperty(s => s.Balance, s => s.Balance + amount));
+        }
+
+        var creditedIds = payments.Select(p => p.SubscriberId).Distinct().ToList();
+        var reactivated = await _db.Subscribers
+            .Where(s => creditedIds.Contains(s.Id) && s.Status == SubscriberStatus.Suspended && s.Balance >= 0)
+            .ExecuteUpdateAsync(u => u
+                .SetProperty(s => s.Status, SubscriberStatus.Active)
+                .SetProperty(s => s.ReactivatedAt, now));
+
+        await tx.CommitAsync();
+
+        return new StatementImportResult(payments.Count, fresh.Count - payments.Count, lines.Count - fresh.Count, reactivated);
+    }
+}
