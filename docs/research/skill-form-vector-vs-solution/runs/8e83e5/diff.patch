@@ -50,4 +50,25 @@ public class SubscriberService
             ? null
             : new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance);
     }
+
+    public const int MinPhoneSearchDigits = 4;
+    private const int MaxSearchResults = 20;
+
+    // Поиск по последним цифрам телефона; формат номера в базе любой («+7 (912) 345-45-18»),
+    // сравниваются только цифры.
+    public async Task<List<SubscriberDto>> SearchByPhoneTailAsync(string phoneTail)
+    {
+        var digits = new string(phoneTail.Where(char.IsAsciiDigit).ToArray());
+        if (digits.Length < MinPhoneSearchDigits)
+            throw new ArgumentException($"Нужно не меньше {MinPhoneSearchDigits} цифр телефона");
+
+        var reversed = new string(digits.Reverse().ToArray());
+
+        return await _db.Subscribers.AsNoTracking()
+            .Where(s => EF.Property<string>(s, BillingDbContext.PhoneDigitsReversed).StartsWith(reversed))
+            .OrderBy(s => s.FullName).ThenBy(s => s.Id)
+            .Take(MaxSearchResults)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+    }
 }
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..c8edfcb
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,14 @@
+Сделал все три задачи. Сборку и тесты не запускал, как и было сказано, так что код не проверен. Миграции БД я не создавал — их в проекте нет. Нужна миграция, которая добавит таблицу `UnmatchedPayments`, колонку `Subscribers.ReactivatedAt` и вычисляемую колонку с индексом для поиска.
+
+**Созданные/изменённые файлы**
+- `PaymentImportService.cs` (новый) — загрузка выписки: зачисление платежей, неразобранные строки, возврат приостановленных абонентов в Active.
+- `Models.cs` — добавил поле `Subscriber.ReactivatedAt` и сущность `UnmatchedPayment`.
+- `BillingDbContext.cs` — добавил `DbSet UnmatchedPayments` с уникальным `BankRef` и вычисляемую колонку `PhoneDigitsReversed` (цифры телефона в обратном порядке) с индексом `text_pattern_ops`.
+- `SubscriberService.cs` — добавил метод `SearchByPhoneTailAsync`.
+- `Program.cs` — добавил `POST /bank/statements` и `GET /subscribers/search`.
+
+**Решения**
+- **Повторная загрузка.** Строка выписки считается уже загруженной, если её `BankRef` есть среди платежей или среди неразобранных. Уникальные индексы на `BankRef` в обеих таблицах защищают и при параллельной загрузке: платежи вставляются раньше, чем меняются балансы, поэтому вторая загрузка падает на индексе, транзакция откатывается и endpoint отвечает 409.
+- **Баланс и статус.** Всё в одной транзакции. Баланс увеличивается в самой БД (`Balance = Balance + x`), чтобы не затереть одновременные списания абонентской платы. Затем одним запросом абоненты в Suspended с `Balance >= 0` переводятся в Active, и записывается `ReactivatedAt`.
+- **Поиск по телефону.** Телефоны в базе записаны в разных форматах, поэтому сравниваются только цифры. Перевёрнутая строка цифр превращает «последние цифры» в поиск по началу строки, который использует индекс. Нужно минимум 4 цифры, иначе 400. Отдаю не больше 20 результатов, сортировка по ФИО.
+- **Кодировка.** Считаю, что выписка приходит в UTF-8. Если банк выгружает в windows-1251, кодировку в endpoint нужно поменять.
