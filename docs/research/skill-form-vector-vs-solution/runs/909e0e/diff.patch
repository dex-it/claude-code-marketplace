+using Microsoft.EntityFrameworkCore;
+
+namespace Tarif.Billing;
+
+public record ImportResult(int Credited, int Unmatched, int Skipped);
+
+public class BankStatementService
+{
+    private readonly BillingDbContext _db;
+
+    public BankStatementService(BillingDbContext db) => _db = db;
+
+    public async Task<ImportResult> ImportAsync(TextReader reader)
+    {
+        var lines = BankStatement.Parse(reader);
+        var refs = lines.Select(l => l.BankRef).ToList();
+
+        var known = await _db.Payments.Where(p => refs.Contains(p.BankRef))
+            .Select(p => p.BankRef)
+            .Concat(_db.UnmatchedPayments.Where(p => refs.Contains(p.BankRef)).Select(p => p.BankRef))
+            .ToHashSetAsync();
+
+        int credited = 0, unmatched = 0, skipped = 0;
+
+        foreach (var line in lines)
+        {
+            // Уже загружали эту строку раньше (или она повторяется в этом же файле) - пропускаем.
+            if (!known.Add(line.BankRef))
+            {
+                skipped++;
+                continue;
+            }
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var subscriber = contractNo is null
+                ? null
+                : await _db.Subscribers.SingleOrDefaultAsync(s => s.ContractNo == contractNo);
+
+            if (subscriber is null)
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    ImportedAt = DateTime.Now,
+                });
+                unmatched++;
+                continue;
+            }
+
+            var creditedAt = DateTime.Now;
+            subscriber.Balance += line.Amount;
+            _db.Payments.Add(new Payment
+            {
+                SubscriberId = subscriber.Id,
+                Amount = line.Amount,
+                BankRef = line.BankRef,
+                PaidOn = line.PaidOn,
+                CreditedAt = creditedAt,
+                Purpose = line.Purpose,
+            });
+
+            if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+            {
+                subscriber.Status = SubscriberStatus.Active;
+                subscriber.ReactivatedAt = creditedAt;
+            }
+
+            credited++;
+        }
+
+        await _db.SaveChangesAsync();
+        return new ImportResult(credited, unmatched, skipped);
+    }
+}
