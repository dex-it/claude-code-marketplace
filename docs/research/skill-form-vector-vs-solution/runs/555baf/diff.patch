+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // Бюджетный UPDATE прямо в СУБД, без загрузки продуктов в память.
+    public Task<int> RaisePricesAsync(string category, decimal percentIncrease = 10m, CancellationToken ct = default)
+    {
+        var multiplier = 1 + percentIncrease / 100m;
+        return _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * multiplier), ct);
+    }
+
+    // Батчами: одна большая транзакция на ~40 млн строк удержит лок и раздует WAL.
+    // Каждая итерация - собственная неявная транзакция, ключ - индекс по At.
+    public async Task<long> PurgeOldAuditLogsAsync(TimeSpan? retention = null, int batchSize = 5000, CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow - (retention ?? TimeSpan.FromDays(365));
+        long totalDeleted = 0;
+        int deleted;
+        do
+        {
+            deleted = await _db.Database.ExecuteSqlInterpolatedAsync($@"
+                DELETE FROM ""AuditLogs""
+                WHERE ""Id"" IN (
+                    SELECT ""Id"" FROM ""AuditLogs""
+                    WHERE ""At"" < {cutoff}
+                    ORDER BY ""Id""
+                    LIMIT {batchSize}
+                )", ct);
+            totalDeleted += deleted;
+        } while (deleted > 0 && !ct.IsCancellationRequested);
+
+        return totalDeleted;
+    }
+
+    // Продукты уже трекаются после выборки - правим свойство напрямую,
+    // без UpdateRange, и сохраняем один раз после цикла, а не на каждой строке.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> increments, CancellationToken ct = default)
+    {
+        var list = increments.ToList();
+        var ids = list.Select(x => x.Id).ToList();
+
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToDictionaryAsync(p => p.Id, ct);
+
+        foreach (var (id, add) in list)
+        {
+            if (products.TryGetValue(id, out var product))
+                product.Stock += add;
+        }
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // Guid - клиентский ключ, значение из БД не нужно, поэтому Add, а не AddAsync.
+    public async Task<Product> CreateProductAsync(string sku, string warehouse, string category, decimal price, int stock, CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Warehouse = warehouse,
+            Category = category,
+            Price = price,
+            Stock = stock,
+        };
+
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
