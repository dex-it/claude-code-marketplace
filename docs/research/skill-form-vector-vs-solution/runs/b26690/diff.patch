+namespace Notify.Api.Services;
+
+public sealed class SmsSender : INotificationSender
+{
+    private readonly ILogger<SmsSender> _log;
+    public SmsSender(ILogger<SmsSender> log) => _log = log;
+
+    public Task SendAsync(string recipient, string text, CancellationToken ct = default)
+    {
+        _log.LogInformation("sms to {Recipient}", recipient);
+        return Task.CompletedTask;
+    }
+}
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..944f19a
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,15 @@
+**Созданы:**
+- `Services/NotificationChannels.cs` — константы ключей `Email` / `Sms`
+- `Services/SmsSender.cs` — `SmsSender : INotificationSender`, пока пишет в лог
+- `Services/IOrderService.cs` — интерфейс для `OrderService`
+- `Controllers/ReportsController.cs` — `POST /reports/{id:guid}/send?email=...`, отправляет отчёт через email-отправителя
+
+**Изменены:**
+- `Program.cs` — оба отправителя зарегистрированы через `AddKeyedSingleton<INotificationSender, ...>(NotificationChannels.X)`; `AddScoped<IOrderService, OrderService>()`
+- `Services/OrderService.cs` — берёт `[FromKeyedServices(NotificationChannels.Sms)] INotificationSender`, параметр переименован в `customerPhone`
+- `Controllers/OrdersController.cs` — зависит от `IOrderService`; query-параметр `email` → `phone`
+
+**Решения:**
+- Ключи keyed-сервисов вынесены в константы: одна и та же константа используется при регистрации и в `[FromKeyedServices]`, поэтому опечатку в ключе поймает компилятор, а не runtime. Незакейенная регистрация `INotificationSender` убрана, так что канал всегда выбирается явно.
+- Отправители оставлены Singleton: у них нет состояния, а из зависимостей только `ILogger`. `OrderService` остался Scoped и теперь зарегистрирован через интерфейс, как требуют правила команды.
+- ⚠️ Контракт API меняется: подтверждение заказа уходит по SMS, поэтому `/orders/{id}/confirm` теперь принимает `?phone=` вместо `?email=`, и клиентов нужно предупредить. Для отчётов `id` сделан `Guid` по аналогии с заказами. Сборка и тесты не запускались.
