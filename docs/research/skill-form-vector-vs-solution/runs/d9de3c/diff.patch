+namespace Domovoy.Housing;
+
+// Попытка перевести заявку в статус, недопустимый из её текущего статуса (-> 409 на endpoint-е).
+public class RequestStatusConflictException : Exception
+{
+    public RequestStatusConflictException(string message) : base(message) { }
+}
