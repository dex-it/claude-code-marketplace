+namespace Domovoy.Housing;
+
+public record CloseRequestInput(string Comment);
+
+// Query-параметры реестра заявок: sort=date|address|status, dir=asc|desc, остальное - фильтры.
+public record RequestSearchQuery(string? Text, RequestStatus? Status, int? HouseId, string? District,
+    string? Sort, string? Dir, int Page = 1, int PageSize = 50)
+{
+    public RequestSearch ToRequestSearch() => new(Text, Status, HouseId, District,
+        ParseSort(Sort), ParseDir(Dir), Page, PageSize);
+
+    private static RequestSort ParseSort(string? value) => value?.ToLowerInvariant() switch
+    {
+        "address" => RequestSort.Address,
+        "status" => RequestSort.Status,
+        _ => RequestSort.Date,
+    };
+
+    private static SortDir ParseDir(string? value) => value?.ToLowerInvariant() switch
+    {
+        "asc" => SortDir.Asc,
+        _ => SortDir.Desc,
+    };
+}
+
+public static class Endpoints
+{
+    public static void MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Реестр заявок диспетчера: фильтры + сортировка по клику на заголовок.
+        app.MapGet("/requests", async ([AsParameters] RequestSearchQuery query, HousingService service) =>
+            Results.Ok(await service.SearchAsync(query.ToRequestSearch())));
+
+        // Карточка заявки для мастера.
+        app.MapGet("/requests/{id:int}", async (int id, HousingService service) =>
+        {
+            var card = await service.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        // Приём заявки диспетчером, включая необязательный контактный телефон.
+        app.MapPost("/requests", async (NewRequest body, HousingService service) =>
+        {
+            var id = await service.CreateRequestAsync(body);
+            return Results.Created($"/requests/{id}", new { id });
+        });
+
+        // Мастер закрывает заявку: только из InProgress, с обязательным комментарием.
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestInput body, HousingService service) =>
+        {
+            try
+            {
+                await service.CloseRequestAsync(id, body.Comment);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.ValidationProblem(new Dictionary<string, string[]> { ["comment"] = [ex.Message] });
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (RequestStatusConflictException ex)
+            {
+                return Results.Conflict(new { message = ex.Message });
+            }
+        });
+
+        app.MapGet("/houses/{id:int}/plan", async (int id, PlanService service) =>
+            Results.Ok(await service.GetPlanAsync(id)));
+
+        // Инженер присылает план дома целиком - заменяет текущий план, сохраняя историю совпавших работ.
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> body, PlanService service) =>
+        {
+            try
+            {
+                await service.ReplacePlanAsync(id, body);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.ValidationProblem(new Dictionary<string, string[]> { ["items"] = [ex.Message] });
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+        });
+    }
+}
