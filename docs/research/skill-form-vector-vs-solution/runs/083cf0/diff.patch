@@ -0,0 +1,69 @@
+name: Deploy DB Migrations
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "Migrations/**"
+  workflow_dispatch:
+
+jobs:
+  generate-script:
+    name: Generate idempotent migration script
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: "8.0.x"
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Restore
+        run: dotnet restore
+        # ВАЖНО: пути к --project/--startup-project ниже — placeholder,
+        # подставить реальные .csproj из решения перед первым запуском.
+
+      - name: Build idempotent SQL script (schema + data migrations)
+        run: |
+          dotnet ef migrations script --idempotent \
+            --project Shop.Data.csproj \
+            --startup-project Shop.Data.csproj \
+            --context ShopDbContext \
+            --output migration.sql
+        # --idempotent: скрипт сам проверяет __EFMigrationsHistory и применяет
+        # только недостающие миграции — безопасно перезапускать.
+        # database update напрямую в проде не используем, см. SKILL.md.
+
+      - name: Upload script for review
+        uses: actions/upload-artifact@v4
+        with:
+          name: migration-script
+          path: migration.sql
+          retention-days: 30
+
+  apply-to-production:
+    name: Apply reviewed migration to production
+    needs: generate-script
+    runs-on: ubuntu-latest
+    # Environment "production" должен быть настроен с required reviewers —
+    # это и есть ревью/DBA-гейт перед применением SQL к проду.
+    environment:
+      name: production
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: migration-script
+
+      - name: Apply reviewed SQL script via psql
+        env:
+          PGPASSWORD: ${{ secrets.PROD_DB_PASSWORD }}
+        run: |
+          psql \
+            --host "${{ secrets.PROD_DB_HOST }}" \
+            --username "${{ secrets.PROD_DB_USER }}" \
+            --dbname "${{ secrets.PROD_DB_NAME }}" \
+            --set ON_ERROR_STOP=1 \
+            --file migration.sql
