+    /// Колонка Order.Category пока не удаляется — уберём отдельной миграцией
+    /// после того, как весь код перейдёт на Categories/OrderCategories.
+    /// </summary>
+    public partial class AddCategoriesAndOrderCategories : Migration
+    {
+        protected override void Up(MigrationBuilder migrationBuilder)
