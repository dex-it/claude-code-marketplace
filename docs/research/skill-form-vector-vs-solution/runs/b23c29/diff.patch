+namespace BookQuarter.Library;
+
+// Секция "Fines" в appsettings.json.
+public class FineOptions
+{
+    public const string SectionName = "Fines";
+
+    // Штраф за один день просрочки, руб.
+    public decimal PerDay { get; set; }
+
+    public decimal ForDays(int overdueDays) => overdueDays > 0 ? overdueDays * PerDay : 0m;
+}
