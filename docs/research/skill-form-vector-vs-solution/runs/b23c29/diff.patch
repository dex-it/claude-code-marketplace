diff --git a/ReportService.cs b/ReportService.cs
new file mode 100644
index 0000000..336c0c5
--- /dev/null
+++ b/ReportService.cs
@@ -0,0 +1,154 @@
+using System.Globalization;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+
+namespace BookQuarter.Library;
+
+public record OverdueLoanDto(int LoanId, string ReaderName, string CardNumber, string Phone,
+    string BookTitle, DateOnly DueDate, int OverdueDays);
+
+public record BranchLoansDto(int BranchId, string BranchName, int LoansCount);
+
+public record CsvExport(byte[] Content, int Rows);
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+    private readonly FineOptions _fines;
+
+    public ReportService(LibraryDbContext db, IOptions<FineOptions> fines)
+    {
+        _db = db;
+        _fines = fines.Value;
+    }
+
+    // Loan.IsOverdue/OverdueDays — вычисляемые свойства, EF их в SQL не переведёт,
+    // поэтому фильтр по сроку пишем явно, а дни считаем уже в памяти.
+    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);
+
+    // (а) Просроченные выдачи филиала для обзвона. Телефон полный — список для сотрудников филиала.
+    public async Task<IReadOnlyList<OverdueLoanDto>?> GetOverdueAsync(int branchId)
+    {
+        if (!await _db.Branches.AnyAsync(b => b.Id == branchId))
+            return null;
+
+        var today = Today;
+        var rows = await _db.Loans
+            .AsNoTracking()
+            .Where(l => l.BranchId == branchId && l.ReturnedAt == null && l.DueDate < today)
+            .OrderBy(l => l.DueDate)        // самый ранний срок = больше всего дней просрочки
+            .ThenBy(l => l.Reader.FullName)
+            .Select(l => new
+            {
+                l.Id,
+                l.Reader.FullName,
+                l.Reader.CardNumber,
+                l.Reader.Phone,
+                l.Book.Title,
+                l.DueDate,
+            })
+            .ToListAsync();
+
+        return rows
+            .Select(r => new OverdueLoanDto(r.Id, r.FullName, r.CardNumber, r.Phone, r.Title,
+                r.DueDate, today.DayNumber - r.DueDate.DayNumber))
+            .ToList();
+    }
+
+    // (б) CSV по должникам всей сети для коллекторского агентства + запись в ExportLog.
+    public async Task<CsvExport> ExportDebtorsCsvAsync(string exportedBy)
+    {
+        var today = Today;
+        var loans = await _db.Loans
+            .AsNoTracking()   // контакты маскируем; сущности не должны попасть в трекер
+            .Where(l => l.ReturnedAt == null && l.DueDate < today)
+            .Select(l => new
+            {
+                l.ReaderId,
+                l.Reader.FullName,
+                l.Reader.CardNumber,
+                l.Reader.Phone,
+                l.Reader.Email,
+                l.DueDate,
+            })
+            .ToListAsync();
+
+        var debtors = loans
+            .GroupBy(l => l.ReaderId)
+            .Select(g =>
+            {
+                var r = g.First();
+                var fine = g.Sum(l => _fines.ForDays(today.DayNumber - l.DueDate.DayNumber));
+                return new
+                {
+                    r.FullName,
+                    r.CardNumber,
+                    Phone = ReaderExtensions.MaskPhone(r.Phone),
+                    Email = ReaderExtensions.MaskEmail(r.Email),
+                    Fine = fine,
+                };
+            })
+            .OrderBy(d => d.FullName)
+            .ThenBy(d => d.CardNumber)
+            .ToList();
+
+        var sb = new StringBuilder();
+        sb.Append("FullName,CardNumber,Phone,Email,Fine\r\n");
+        foreach (var d in debtors)
+        {
+            sb.Append(Csv(d.FullName)).Append(',')
+              .Append(Csv(d.CardNumber)).Append(',')
+              .Append(Csv(d.Phone)).Append(',')
+              .Append(Csv(d.Email)).Append(',')
+              .Append(d.Fine.ToString("0.00", CultureInfo.InvariantCulture))
+              .Append("\r\n");
+        }
+
+        _db.ExportLogs.Add(new ExportLog
+        {
+            Target = "debtors.csv",
+            ExportedBy = exportedBy,
+            ExportedAt = DateTime.UtcNow,
+            Rows = debtors.Count,
+        });
+        await _db.SaveChangesAsync();
+
+        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
+        return new CsvExport(bytes, debtors.Count);
+    }
+
+    // (в) Число выдач по филиалам за период [from; to] включительно (даты по UTC, как и IssuedAt).
+    public async Task<IReadOnlyList<BranchLoansDto>> GetLoansByBranchAsync(DateOnly from, DateOnly to)
+    {
+        var start = from.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
+        var endExclusive = to.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
+
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= start && l.IssuedAt < endExclusive)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.BranchId, x => x.Count);
+
+        var branches = await _db.Branches.AsNoTracking().OrderBy(b => b.Name).ToListAsync();
+
+        // Филиалы без выдач тоже показываем — с нулём.
+        return branches
+            .Select(b => new BranchLoansDto(b.Id, b.Name, counts.GetValueOrDefault(b.Id)))
+            .ToList();
+    }
+
+    // RFC 4180 + защита от формул при открытии в Excel.
+    private static string Csv(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+            return "";
+
+        if (value[0] is '=' or '+' or '-' or '@' or '\t' or '\r')
+            value = "'" + value;
+
+        return value.IndexOfAny([',', '"', '\r', '\n']) >= 0
+            ? "\"" + value.Replace("\"", "\"\"") + "\""
+            : value;
+    }
+}
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..dd6303b
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,12 @@
+**Файлы**
+- Создан `ReportService.cs`: просроченные выдачи (а), CSV по должникам с записью в ExportLog (б), отчёт по выдачам (в).
+- Создан `FineOptions.cs`: ставка штрафа, читается из секции `Fines`.
+- Создан `appsettings.json`: `Fines:PerDay = 10`.
+- Изменён `Program.cs`: добавлены три endpoint'а. Опции штрафа подключаются с проверкой при старте `PerDay > 0`. Проверяются `X-User` и даты отчёта, при ошибке — 400.
+- Изменён `LoanService.cs`: ставка штрафа берётся из конфигурации. Карточка читателя читается через `AsNoTracking` и маскируется без изменения сущности.
+- Изменён `ReaderExtensions.cs`: добавлены отдельные функции `MaskPhone` и `MaskEmail`, которые не меняют объект. `MaskContacts` теперь вызывает их.
+
+**Решения**
+- `MaskContacts` изменял отслеживаемую EF-сущность. Выгрузка вызывает `SaveChanges`, чтобы записать ExportLog, и маски могли бы перезаписать настоящие телефоны и e-mail в БД. Поэтому маскирую отдельными функциями на данных, прочитанных без отслеживания.
+- `IsOverdue` и `OverdueDays` вычисляются в C# и не переводятся в SQL. Поэтому фильтр `ReturnedAt == null && DueDate < today` написан явно, а дни считаются после загрузки. Сумма в CSV — это штраф по ещё не возвращённым просроченным выдачам: дни × ставка из конфига. `FineBalance` в неё не входит.
+- В отчёт (в) попадают выдачи с `from 00:00` до `to+1 00:00` по UTC, то есть дата «по» включается целиком. Филиалы без выдач тоже выводятся, с нулём. Список (а) строится по филиалу выдачи (`Loan.BranchId`), а не по домашнему филиалу читателя. Телефон там полный, потому что список нужен для обзвона. Сборку и тесты не запускал.
