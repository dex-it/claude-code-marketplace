+    public async Task<RandomSessionDto?> GetRandomSessionAsync()
+    {
+        var sessions = await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.StartsAt >= DateTime.UtcNow && s.StartsAt <= DateTime.UtcNow.AddDays(7))
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .ToListAsync();
+
+        if (sessions.Count == 0)
+            return null;
+
+        var random = new Random();
+        var session = sessions[random.Next(sessions.Count)];
+
+        var enrolledMembers = session.Enrollments
+            .Where(e => e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToList();
+
+        return new RandomSessionDto(session.Id, session.Course.Title, session.Course.Trainer.FullName,
+            session.Hall.Name, session.StartsAt, enrolledMembers);
+    }
 }
