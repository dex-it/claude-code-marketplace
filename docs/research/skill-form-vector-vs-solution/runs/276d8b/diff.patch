@@ -0,0 +1,25 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+public sealed record LoansByBranchRequest(DateTimeOffset From, DateTimeOffset To);
+
+public sealed record BranchLoanCount(int BranchId, string BranchName, int LoansCount);
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // Число выдач по каждому филиалу за период [from, to); from/to - конкретные моменты
+    // времени (DateTimeOffset), поэтому пояс филиала здесь не нужен.
+    public async Task<List<BranchLoanCount>> LoansByBranchAsync(DateTimeOffset from, DateTimeOffset to) =>
+        await _db.Branches
+            .OrderBy(b => b.Id)
+            .Select(b => new BranchLoanCount(
+                b.Id,
+                b.Name,
+                _db.Loans.Count(l => l.BranchId == b.Id && l.IssuedAt >= from && l.IssuedAt < to)))
+            .ToListAsync();
+}
