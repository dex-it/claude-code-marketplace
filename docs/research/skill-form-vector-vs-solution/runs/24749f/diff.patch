@@ -0,0 +1,47 @@
+using Microsoft.AspNetCore.Diagnostics;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Pixelwork.Timesheets;
+
+// Регистрация в Program.cs:
+//   builder.Services.AddScoped<ReportService>();
+//   builder.Services.AddExceptionHandler<DailyHoursLimitExceptionHandler>();
+//   builder.Services.AddProblemDetails();
+//   app.UseExceptionHandler();
+//   app.MapTimesheetsEndpoints();
+public static class TimesheetsEndpoints
+{
+    public static IEndpointRouteBuilder MapTimesheetsEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/reports/year/{year:int}", async (int year, ReportService reports) =>
+            year is < 2000 or > 2100
+                ? Results.BadRequest(new { error = "Некорректный год" })
+                : Results.Ok(await reports.YearSummaryAsync(year)));
+
+        app.MapDelete("/clients/{id:int}/projects", async (int id, ProjectService projects) =>
+            await projects.DeleteClientProjectsAsync(id) is { } deleted
+                ? Results.Ok(new { deleted })
+                : Results.NotFound());
+
+        return app;
+    }
+}
+
+// 400 на превышение дневного лимита для существующих endpoint'ов добавления/правки записей.
+public class DailyHoursLimitExceptionHandler : IExceptionHandler
+{
+    public async ValueTask<bool> TryHandleAsync(HttpContext ctx, Exception ex, CancellationToken ct)
+    {
+        if (ex is not DailyHoursLimitException)
+            return false;
+
+        ctx.Response.StatusCode = StatusCodes.Status400BadRequest;
+        await ctx.Response.WriteAsJsonAsync(new ProblemDetails
+        {
+            Status = StatusCodes.Status400BadRequest,
+            Title = "Превышен дневной лимит часов",
+            Detail = ex.Message,
+        }, ct);
+        return true;
+    }
+}
