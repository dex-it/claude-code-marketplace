+
+    public const int MaxFreezeDays = 90;
+
+    public async Task<FreezeDto> FreezeAsync(int memberId, int days)
+    {
+        if (days < 1 || days > MaxFreezeDays)
+            throw new ArgumentOutOfRangeException(nameof(days), $"Срок заморозки: от 1 до {MaxFreezeDays} дней");
+
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        if (member.IsFrozenAt(now))
+            throw new ConflictException("Абонемент уже заморожен");
+
+        member.FrozenFrom = now;
+        member.FrozenUntil = now.AddDays(days);
+        await _db.SaveChangesAsync();
+        return new FreezeDto(member.Id, member.FrozenFrom.Value, member.FrozenUntil.Value);
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        if (!member.IsFrozenAt(now))
+            throw new ConflictException("Абонемент не заморожен");
+
+        // Период не стираем, а закрываем текущим моментом — см. комментарий в Member.
+        member.FrozenUntil = now;
+        await _db.SaveChangesAsync();
+    }
+
+    // «Тайный гость»: случайное занятие опубликованного курса в ближайшие 7 дней.
+    public async Task<QualitySessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var to = now.AddDays(7);
+
+        // Сначала выбираем только id: при SplitQuery коллекция грузится отдельным запросом,
+        // который повторил бы ORDER BY random() и мог вернуть записи другого занятия.
+        var sessionId = await _db.Sessions
+            .Where(s => s.StartsAt >= now && s.StartsAt < to
+                && s.Course.Status == CourseStatus.Published)
+            .OrderBy(s => EF.Functions.Random())
+            .Select(s => (int?)s.Id)
+            .FirstOrDefaultAsync();
+
+        if (sessionId is null)
+            return null;
+
+        return await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.Id == sessionId)
+            .Select(s => new QualitySessionDto(
+                s.Id,
+                s.Course.Title,
+                s.Course.Trainer.FullName,
+                s.Hall.Name,
+                s.StartsAt,
+                s.Enrollments
+                    .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                    .OrderBy(e => e.Member.FullName)
+                    .Select(e => e.Member.FullName)
+                    .ToList()))
+            .FirstOrDefaultAsync();
+    }
 }
