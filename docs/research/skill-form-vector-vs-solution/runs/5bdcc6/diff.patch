+    public async Task<List<BranchLoanCount>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.BranchId, x => x.Count);
+
+        var branches = await _db.Branches.OrderBy(b => b.Name).ToListAsync();
+
+        return branches
+            .Select(b => new BranchLoanCount(b.Id, b.Name, counts.GetValueOrDefault(b.Id)))
+            .ToList();
