+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestInput(string Comment);
+
+public record ReplacePlanInput(List<PlanItemInput> Items);
+
+// Подключается из Program.cs: app.MapHousingEndpoints();
+public static class Endpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/requests", async (
+            HousingService svc,
+            string? text, RequestStatus? status, int? houseId, string? district,
+            int page, int pageSize, string? sort, string? dir) =>
+        {
+            if (!TryParseSort(sort, out var sortField))
+                return Results.BadRequest($"Неизвестное значение sort: {sort}. Допустимо: date, address, status.");
+            if (!TryParseDir(dir, out var direction))
+                return Results.BadRequest($"Неизвестное значение dir: {dir}. Допустимо: asc, desc.");
+
+            var search = new RequestSearch(
+                text, status, houseId, district,
+                page == 0 ? 1 : page,
+                pageSize == 0 ? 50 : pageSize,
+                sortField ?? RequestSortField.Date,
+                direction ?? SortDirection.Desc);
+
+            return Results.Ok(await svc.SearchAsync(search));
+        });
+
+        app.MapGet("/requests/{id:int}", async (HousingService svc, int id) =>
+        {
+            var card = await svc.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        app.MapPost("/requests", async (HousingService svc, NewRequest req) =>
+        {
+            var id = await svc.CreateRequestAsync(req);
+            return Results.Created($"/requests/{id}", new { id });
+        });
+
+        // Мастер закрывает заявку: статус -> Done, обязательный комментарий о выполненных работах.
+        // Закрыть можно только заявку в статусе InProgress, иначе 409.
+        app.MapPost("/requests/{id:int}/close", async (HousingService svc, int id, CloseRequestInput input) =>
+        {
+            try
+            {
+                await svc.CloseRequestAsync(id, input.Comment);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+            catch (RequestNotInProgressException ex)
+            {
+                return Results.Conflict(ex.Message);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        // Инженер присылает план дома целиком: план становится ровно таким, как в теле запроса.
+        app.MapPut("/houses/{id:int}/plan", async (PlanService svc, int id, ReplacePlanInput input) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, input.Items);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        return app;
+    }
+
+    private static bool TryParseSort(string? value, out RequestSortField? sort)
+    {
+        sort = null;
+        if (string.IsNullOrWhiteSpace(value))
+            return true;
+
+        switch (value.Trim().ToLowerInvariant())
+        {
+            case "date": sort = RequestSortField.Date; return true;
+            case "address": sort = RequestSortField.Address; return true;
+            case "status": sort = RequestSortField.Status; return true;
+            default: return false;
+        }
+    }
+
+    private static bool TryParseDir(string? value, out SortDirection? dir)
+    {
+        dir = null;
+        if (string.IsNullOrWhiteSpace(value))
+            return true;
+
+        switch (value.Trim().ToLowerInvariant())
+        {
+            case "asc": dir = SortDirection.Asc; return true;
+            case "desc": dir = SortDirection.Desc; return true;
+            default: return false;
+        }
+    }
+}
