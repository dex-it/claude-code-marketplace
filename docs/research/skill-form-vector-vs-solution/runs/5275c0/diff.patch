+    // sort/dir приходят из enum, а не напрямую из строки запроса, поэтому в SQL их можно подставлять literal'ом.
+    private static string BuildOrderBy(RequestSortField sort, SortDirection dir)
+    {
+        var direction = dir == SortDirection.Asc ? "ASC" : "DESC";
+        var columns = sort switch
+        {
+            RequestSortField.Date => "r.created_at",
+            RequestSortField.Address => "h.address, a.number",
+            RequestSortField.Status => "r.status",
+            _ => throw new ArgumentOutOfRangeException(nameof(sort)),
