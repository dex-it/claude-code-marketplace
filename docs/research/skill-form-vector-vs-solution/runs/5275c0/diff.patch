+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var duplicateCode = items
+            .GroupBy(i => i.WorkCode)
+            .FirstOrDefault(g => g.Count() > 1)?.Key;
