+++ b/.github/workflows/deploy-migrations.yml
@@ -0,0 +1,43 @@
+name: Deploy DB migrations
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch: {}
+
+concurrency:
+  group: production-db-migrations
+  cancel-in-progress: false
+
+jobs:
+  migrate-production:
+    runs-on: ubuntu-latest
+    environment: production   # requires manual approval + scopes DB secret to this environment
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: "8.0.x"
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Build self-contained migration bundle
+        run: |
+          dotnet ef migrations bundle \
+            --project Shop.Data \
+            --configuration Release \
+            --self-contained \
+            --runtime linux-x64 \
+            --output efbundle
+        # bundle is produced from the migrations checked into this branch, so what
+        # runs against production is exactly what was reviewed in the PR
+
+      - name: Apply migrations to production database
+        env:
+          ConnectionStrings__Shop: ${{ secrets.PRODUCTION_DB_CONNECTION_STRING }}
+        run: ./efbundle --connection "$ConnectionStrings__Shop"
+        # additive migrations only (new tables + backfill) - safe to run before the
+        # app deploy job. A future migration that drops Order.Category must not be
+        # bundled together with an app version that still reads/writes that column.
