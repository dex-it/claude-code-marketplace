+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+public static class HousingEndpoints
+{
+    public static void MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService service) =>
+        {
+            try
+            {
+                await service.CloseRequestAsync(id, body.Comment);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (RequestNotInProgressException)
+            {
+                return Results.Conflict("Закрыть можно только заявку в статусе InProgress.");
+            }
+        });
+
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService service) =>
+        {
+            try
+            {
+                await service.ReplacePlanAsync(id, items);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+        });
+    }
+}
