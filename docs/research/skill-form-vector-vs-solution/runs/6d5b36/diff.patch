+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string? Comment);
+
+public static class HousingEndpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Реестр заявок. sort=date|address|status, dir=asc|desc.
+        // По умолчанию - дата, новые сверху; для адреса и статуса без dir - по возрастанию.
+        app.MapGet("/requests", async (string? text, RequestStatus? status, int? houseId, string? district,
+            int? page, int? pageSize, string? sort, string? dir, HousingService svc) =>
+        {
+            RequestSort sortBy;
+            switch (sort?.Trim().ToLowerInvariant())
+            {
+                case null or "" or "date": sortBy = RequestSort.Date; break;
+                case "address": sortBy = RequestSort.Address; break;
+                case "status": sortBy = RequestSort.Status; break;
+                default:
+                    return Results.ValidationProblem(new Dictionary<string, string[]>
+                        { ["sort"] = ["Допустимые значения: date, address, status"] });
+            }
+
+            bool descending;
+            switch (dir?.Trim().ToLowerInvariant())
+            {
+                case null or "": descending = sortBy == RequestSort.Date; break;
+                case "asc": descending = false; break;
+                case "desc": descending = true; break;
+                default:
+                    return Results.ValidationProblem(new Dictionary<string, string[]>
+                        { ["dir"] = ["Допустимые значения: asc, desc"] });
+            }
+
+            var rows = await svc.SearchAsync(new RequestSearch(text, status, houseId, district,
+                page ?? 1, pageSize ?? 50, sortBy, descending));
+            return Results.Ok(rows);
+        });
+
+        app.MapGet("/requests/{id:int}", async (int id, HousingService svc) =>
+            await svc.GetRequestAsync(id) is { } card ? Results.Ok(card) : Results.NotFound());
+
+        // Приём заявки диспетчером; ContactPhone необязателен.
+        app.MapPost("/requests", async (NewRequest req, HousingService svc) =>
+        {
+            try
+            {
+                var id = await svc.CreateRequestAsync(req);
+                return Results.Created($"/requests/{id}", new { id });
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.ValidationProblem(new Dictionary<string, string[]>
+                    { [nameof(NewRequest.ContactPhone)] = [ex.Message] });
+            }
+        });
+
+        // Мастер закрывает заявку: только из InProgress (иначе 409), комментарий обязателен (иначе 400).
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService svc) =>
+        {
+            CloseRequestResult result;
+            try
+            {
+                result = await svc.CloseRequestAsync(id, body.Comment ?? "");
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.ValidationProblem(new Dictionary<string, string[]>
+                    { ["comment"] = [ex.Message] });
+            }
+
+            return result switch
+            {
+                CloseRequestResult.Closed => Results.NoContent(),
+                CloseRequestResult.NotFound => Results.NotFound(),
+                _ => Results.Problem("Закрыть можно только заявку в статусе InProgress",
+                    statusCode: StatusCodes.Status409Conflict),
+            };
+        });
+
+        // Инженер присылает план обслуживания дома целиком.
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                if (!await svc.ReplacePlanAsync(id, items))
+                    return Results.NotFound();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.ValidationProblem(new Dictionary<string, string[]>
+                    { ["items"] = [ex.Message] });
+            }
+
+            return Results.Ok(await svc.GetPlanAsync(id));
+        });
+
+        return app;
+    }
+}
