+    // Инженер присылает план дома целиком: план становится ровно таким, как прислано.
+    // Работы сопоставляются по коду: оставшиеся обновляются на месте (история выполнения сохраняется),
+    // новые добавляются, отсутствующие в присланном списке удаляются вместе со своей историей (каскад FK).
+    // Возвращает false, если дома нет.
+    public async Task<bool> ReplacePlanAsync(int houseId, IReadOnlyList<PlanItemInput> items)
+    {
+        var normalized = items
+            .Select(i => new PlanItemInput(i.WorkCode?.Trim() ?? "", i.Title?.Trim() ?? "", i.PeriodDays))
+            .ToList();
+
+        if (normalized.Any(i => i.WorkCode.Length == 0 || i.Title.Length == 0))
+            throw new ArgumentException("У каждой работы должны быть код и название");
+        if (normalized.Any(i => i.PeriodDays <= 0))
+            throw new ArgumentException("Периодичность работы должна быть больше нуля дней");
+        var duplicate = normalized.GroupBy(i => i.WorkCode).FirstOrDefault(g => g.Count() > 1);
+        if (duplicate is not null)
+            throw new ArgumentException($"Работа {duplicate.Key} указана в плане несколько раз");
+
+        if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+            return false;
+
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId);
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var existing = plan.Items.ToDictionary(i => i.WorkCode);
+        var incomingCodes = normalized.Select(i => i.WorkCode).ToHashSet();
+
+        // DeleteOrphansTiming = Never: убрать работу из plan.Items недостаточно - её нужно удалить явно.
+        foreach (var item in existing.Values.Where(i => !incomingCodes.Contains(i.WorkCode)))
+            _db.PlanItems.Remove(item);
+
+        foreach (var input in normalized)
+        {
+            if (existing.TryGetValue(input.WorkCode, out var item))
+            {
+                item.Title = input.Title;
+                item.PeriodDays = input.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+        return true;
