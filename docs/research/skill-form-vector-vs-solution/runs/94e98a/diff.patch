+namespace Shop.Data;
+
+public record ActiveOrderSummary(Guid OrderId, string CustomerName, decimal Total, int ItemCount);
+
+public record OverdueOrderSummary(Guid OrderId, string CustomerName, decimal Total, DateTime CreatedAt);
+
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public Task<List<ActiveOrderSummary>> GetActiveOrdersAsync() =>
+        _orders.QueryActive()
+            .Select(o => new ActiveOrderSummary(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public async Task<Dictionary<string, int>> GetActiveOrderCountByCategoryAsync()
+    {
+        var rows = await _orders.QueryActive()
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToListAsync();
+        return rows.ToDictionary(r => r.Category, r => r.Count);
+    }
+
+    public Task<List<OverdueOrderSummary>> GetOverdueOrdersAsync(DateTime now) =>
+        _orders.QueryOverdue(now)
+            .Select(o => new OverdueOrderSummary(o.Id, o.Customer.Name, o.Total, o.CreatedAt))
+            .ToListAsync();
+}
