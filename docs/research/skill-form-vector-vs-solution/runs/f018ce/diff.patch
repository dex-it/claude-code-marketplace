+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private const int AuditLogPurgeBatchSize = 5_000;
+
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (a) raise prices by 10% for all products in a category - single server-side UPDATE, no entity loading/tracking
+    public Task<int> RaisePricesAsync(string category, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * 1.1m), ct);
+
+    // (b) nightly purge of AuditLogs older than a year. Deletes in small batches (ordered by the PK) instead of
+    // one giant statement, since ~40M of ~50M rows are due for deletion: a single DELETE would hold a long-running
+    // transaction, bloat WAL and block autovacuum/replicas. Each batch is its own implicit transaction, so the job
+    // is safely resumable if interrupted. Requires an index on AuditLog.At (see ShopDbContext.OnModelCreating).
+    public async Task<long> PurgeOldAuditLogsAsync(DateTime now, CancellationToken ct = default)
+    {
+        var cutoff = now.AddYears(-1);
+        long totalDeleted = 0;
+        int deleted;
+        do
+        {
+            deleted = await _db.AuditLogs
+                .Where(a => a.At < cutoff)
+                .OrderBy(a => a.Id)
+                .Take(AuditLogPurgeBatchSize)
+                .ExecuteDeleteAsync(ct);
+            totalDeleted += deleted;
+            if (deleted == AuditLogPurgeBatchSize)
+                await Task.Delay(TimeSpan.FromMilliseconds(50), ct); // brief pause between batches to ease lock/replication pressure
+        } while (deleted == AuditLogPurgeBatchSize);
+
+        return totalDeleted;
+    }
+
+    // (c) load products and bump Stock, then save
+    public async Task RestockAsync(IEnumerable<(Guid id, int add)> updates, CancellationToken ct = default)
+    {
+        var addByProductId = updates
+            .GroupBy(u => u.id)
+            .ToDictionary(g => g.Key, g => g.Sum(u => u.add));
+
+        var products = await _db.Products
+            .Where(p => addByProductId.Keys.Contains(p.Id))
+            .ToListAsync(ct);
+
+        foreach (var product in products)
+            product.Stock += addByProductId[product.Id];
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (d) create a product with a new Guid
+    public async Task<Product> CreateProductAsync(string sku, string warehouse, string category, decimal price, int stock = 0, CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Warehouse = warehouse,
+            Category = category,
+            Price = price,
+            Stock = stock,
+        };
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
