+namespace Pixelwork.Timesheets;
+
+// Регистрация в Program.cs:
+//   builder.Services.AddScoped<ReportService>();
+//   app.MapAccountingEndpoints();
+public static class AccountingEndpoints
+{
+    public static IEndpointRouteBuilder MapAccountingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/reports/year/{year:int}", async (int year, ReportService reports) =>
+            year is < 1 or > 9998
+                ? Results.BadRequest($"Некорректный год: {year}")
+                : Results.Ok(await reports.YearAsync(year)));
+
+        app.MapDelete("/clients/{id:int}/projects", async (int id, ProjectService projects) =>
+            await projects.DeleteClientProjectsAsync(id) is { } deleted
+                ? Results.Ok(new { deleted })
+                : Results.NotFound());
+
+        return app;
+    }
+}
