--- /dev/null
+++ b/ReportService.cs
@@ -0,0 +1,45 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace Pixelwork.Timesheets;
+
+public record MonthSummary(int Month, bool IsClosed, DateOnly? ActSignedOn, decimal Hours);
+
+public record YearSummary(int Year, List<MonthSummary> Months);
+
+public class ReportService
+{
+    private readonly AgencyDbContext _db;
+
+    public ReportService(AgencyDbContext db) => _db = db;
+
+    public async Task<YearSummary> YearAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+
+        // Часы считаем по всем записям, включая проекты, удалённые позже: по ним уже подписаны акты
+        // (так же, как TimeEntryService.HoursForMonthAsync — без join на Projects и его query filter).
+        var hours = await _db.TimeEntries
+            .AsNoTracking()
+            .Where(t => t.WorkDate >= from && t.WorkDate < to)
+            .GroupBy(t => t.WorkDate.Month)
+            .Select(g => new { Month = g.Key, Hours = g.Sum(t => t.Hours) })
+            .ToDictionaryAsync(x => x.Month, x => x.Hours);
+
+        // Month хранится через value converter (YearMonth -> 202609), его члены (Year/Month) в SQL
+        // не транслируются. Закрытых периодов по строке на месяц — фильтруем в памяти.
+        var closed = (await _db.ClosedPeriods.AsNoTracking().ToListAsync())
+            .Where(p => p.Month.Year == year)
+            .ToDictionary(p => p.Month.Month, p => p.ActSignedOn);
+
+        var months = Enumerable.Range(1, 12)
+            .Select(m => new MonthSummary(
+                m,
+                closed.ContainsKey(m),
+                closed.TryGetValue(m, out var signedOn) ? signedOn : null,
+                hours.GetValueOrDefault(m)))
+            .ToList();
+
+        return new YearSummary(year, months);
+    }
+}
