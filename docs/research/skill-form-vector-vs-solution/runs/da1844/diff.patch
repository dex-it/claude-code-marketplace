new file mode 100644
index 0000000..807cda8
--- /dev/null
+++ b/.github/workflows/deploy-migrations.yml
@@ -0,0 +1,32 @@
+name: Deploy DB migrations
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "Migrations/**"
+  workflow_dispatch: {}
+
+jobs:
+  migrate-production:
+    name: Apply EF Core migrations to production
+    runs-on: ubuntu-latest
+    # Requires manual approval via the "production" environment's protection rules.
+    environment: production
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: "8.0.x"
+
+      - name: Restore
+        run: dotnet restore
+
+      - name: Install dotnet-ef
+        run: dotnet tool install --global dotnet-ef --version 8.*
+
+      - name: Apply pending migrations
+        env:
+          ConnectionStrings__Default: ${{ secrets.PRODUCTION_DB_CONNECTION_STRING }}
+        run: dotnet ef database update --project Shop.Data.csproj --context ShopDbContext --verbose
