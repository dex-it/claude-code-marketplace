+    public record SessionWithMembersDto(string CourseName, string TrainerName, string HallName,
+        DateTime StartsAt, IReadOnlyList<string> MemberNames);
+
+    public async Task<SessionWithMembersDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var sevenDaysLater = now.AddDays(7);
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .Where(s => s.StartsAt > now && s.StartsAt <= sevenDaysLater)
+            .OrderBy(s => Guid.NewGuid())
+            .FirstOrDefaultAsync();
+
+        if (session is null)
+            return null;
+
+        var memberNames = session.Enrollments
+            .Where(e => e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToList();
+
+        return new SessionWithMembersDto(
+            session.Course.Title,
+            session.Course.Trainer.FullName,
+            session.Hall.Name,
+            session.StartsAt,
+            memberNames);
+    }
 }
