+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string Comment);
+
+public static class HousingEndpoints
+{
+    public static void MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/requests", async (HousingService svc, string? text, RequestStatus? status,
+            int? houseId, string? district, RequestSort sort = RequestSort.Date,
+            SortDir dir = SortDir.Desc, int page = 1, int pageSize = 50) =>
+        {
+            var search = new RequestSearch(text, status, houseId, district, sort, dir, page, pageSize);
+            return Results.Ok(await svc.SearchAsync(search));
+        });
+
+        app.MapGet("/requests/{id:int}", async (int id, HousingService svc) =>
+        {
+            var card = await svc.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        app.MapPost("/requests", async (NewRequest req, HousingService svc) =>
+            Results.Created($"/requests/{await svc.CreateRequestAsync(req)}", null));
+
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequestBody body, HousingService svc) =>
+        {
+            try
+            {
+                await svc.CloseRequestAsync(id, body.Comment);
+                return Results.NoContent();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (RequestNotInProgressException ex)
+            {
+                return Results.Conflict(new { error = ex.Message });
+            }
+        });
+
+        app.MapGet("/houses/{id:int}/plan", async (int id, PlanService svc) =>
+            Results.Ok(await svc.GetPlanAsync(id)));
+
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+        });
+    }
+}
