+    // Заменяет план дома целиком присланным списком работ. Работы, которые остаются в плане
+    // (совпадают по WorkCode), сохраняют Id и историю выполнения; остальные удаляются вместе
+    // со своей историей, новые добавляются без истории.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+            throw new KeyNotFoundException($"Дом {houseId} не найден");
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var incomingCodes = items.Select(i => i.WorkCode).ToHashSet();
+
+        foreach (var obsolete in plan.Items.Where(i => !incomingCodes.Contains(i.WorkCode)).ToList())
+        {
+            plan.Items.Remove(obsolete);
+            _db.PlanItems.Remove(obsolete);
+        }
+
+        foreach (var incoming in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == incoming.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = incoming.Title;
+                existing.PeriodDays = incoming.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = incoming.WorkCode,
+                    Title = incoming.Title,
+                    PeriodDays = incoming.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
