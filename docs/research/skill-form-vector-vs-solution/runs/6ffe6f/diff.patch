+    // Инженер присылает план целиком: он становится планом дома как есть.
+    // Работы, которые остаются в плане (совпадают по WorkCode), сохраняют свою историю выполнения -
+    // их записи PlanItem не пересоздаются, меняются только Title/PeriodDays.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var codes = items.Select(i => i.WorkCode).ToList();
+        if (codes.Distinct().Count() != codes.Count)
+            throw new ArgumentException("В присланном плане повторяется код работы", nameof(items));
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var incomingCodes = codes.ToHashSet();
+
+        // Работы, которых больше нет в присланном плане, удаляются вместе со своей историей.
+        foreach (var removed in plan.Items.Where(i => !incomingCodes.Contains(i.WorkCode)).ToList())
+        {
+            plan.Items.Remove(removed);
+            _db.PlanItems.Remove(removed);
+        }
+
+        foreach (var input in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == input.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = input.Title;
+                existing.PeriodDays = input.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
