+using Microsoft.AspNetCore.Diagnostics;
+using Microsoft.AspNetCore.Http;
+
+namespace Pixelwork.Timesheets;
+
+// Попытка изменить время в месяце, за который подписан акт (ClosedPeriods).
+public class PeriodClosedException : Exception
+{
+    public int Year { get; }
+    public int Month { get; }
+
+    public PeriodClosedException(int year, int month)
+        : base($"Period {year:D4}-{month:D2} is closed.")
+    {
+        Year = year;
+        Month = month;
+    }
+}
+
+// Превращает PeriodClosedException в 409 Conflict.
+// Регистрация: builder.Services.AddExceptionHandler<PeriodClosedExceptionHandler>();
+//              builder.Services.AddProblemDetails(); app.UseExceptionHandler();
+public class PeriodClosedExceptionHandler : IExceptionHandler
+{
+    public async ValueTask<bool> TryHandleAsync(HttpContext context, Exception exception, CancellationToken ct)
+    {
+        if (exception is not PeriodClosedException closed)
+            return false;
+
+        context.Response.StatusCode = StatusCodes.Status409Conflict;
+        await context.Response.WriteAsJsonAsync(new
+        {
+            title = "Period is closed",
+            status = StatusCodes.Status409Conflict,
+            detail = closed.Message,
+            year = closed.Year,
+            month = closed.Month,
+        }, ct);
+        return true;
+    }
+}
