+    // Инженер присылает план целиком. Работы сопоставляются по WorkCode: совпавшие обновляются
+    // на месте (id не меняется - история выполнения остаётся), новых - добавляются,
+    // отсутствующих в присланном списке - удаляются вместе со своей историей (FK cascade).
+    // Возвращает false, если дома нет.
+    public async Task<bool> ReplacePlanAsync(int houseId, IReadOnlyList<PlanItemInput> input)
+    {
+        var items = ValidatePlan(input);
+
+        var plan = await _db.MaintenancePlans.Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+                return false;
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        var incoming = items.ToDictionary(i => i.WorkCode, StringComparer.Ordinal);
+
+        // Удаляем явно через DbSet: DeleteOrphansTiming = Never, простое удаление из
+        // коллекции plan.Items строку не удалит.
+        foreach (var existing in plan.Items.Where(i => !incoming.ContainsKey(i.WorkCode)).ToList())
+        {
+            plan.Items.Remove(existing);
+            _db.PlanItems.Remove(existing);
+        }
+
+        foreach (var item in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == item.WorkCode);
+            if (existing is null)
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = item.WorkCode,
+                    Title = item.Title,
+                    PeriodDays = item.PeriodDays,
+                });
+            }
+            else
+            {
+                existing.Title = item.Title;
+                existing.PeriodDays = item.PeriodDays;
+            }
+        }
+
+        await _db.SaveChangesAsync();
+        return true;
+    }
+
+    private static List<PlanItemInput> ValidatePlan(IReadOnlyList<PlanItemInput>? input)
+    {
+        if (input is null)
+            throw new ArgumentException("План не передан");
+
+        var result = new List<PlanItemInput>(input.Count);
+        var codes = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var i in input)
+        {
+            var code = i.WorkCode?.Trim() ?? "";
+            var title = i.Title?.Trim() ?? "";
+            if (code.Length == 0)
+                throw new ArgumentException("Пустой код работы");
+            if (title.Length == 0)
+                throw new ArgumentException($"Пустое название работы {code}");
+            if (i.PeriodDays <= 0)
+                throw new ArgumentException($"Периодичность работы {code} должна быть больше нуля");
+            if (!codes.Add(code))
+                throw new ArgumentException($"Работа {code} указана в плане дважды");
+            result.Add(new PlanItemInput(code, title, i.PeriodDays));
+        }
+        return result;
+    }
+
