+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+namespace Domovoy.Housing;
+
+public record CloseRequestBody(string? Comment);
+
+// Подключение в Program.cs: app.MapHousingEndpoints();
+public static class HousingEndpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        // Реестр: ?sort=date|address|status&dir=asc|desc + прежние фильтры.
+        app.MapGet("/requests", async (HousingService svc,
+            string? text, RequestStatus? status, int? houseId, string? district,
+            string? sort, string? dir, int page = 1, int pageSize = 50) =>
+        {
+            RequestSort sortBy;
+            if (string.IsNullOrEmpty(sort))
+                sortBy = RequestSort.Date;
+            else if (!TryParseExact(sort, out sortBy))
+                return Results.BadRequest("sort: date | address | status");
+
+            SortDir? sortDir = null;
+            if (!string.IsNullOrEmpty(dir))
+            {
+                if (!TryParseExact(dir, out SortDir d))
+                    return Results.BadRequest("dir: asc | desc");
+                sortDir = d;
+            }
+
+            var rows = await svc.SearchAsync(new RequestSearch(text, status, houseId, district,
+                page, pageSize, sortBy, sortDir));
+            return Results.Ok(rows);
+        });
+
+        app.MapPost("/requests", async (HousingService svc, NewRequest body) =>
+        {
+            try
+            {
+                var id = await svc.CreateRequestAsync(body);
+                return Results.Created($"/requests/{id}", new { id });
+            }
+            catch (ArgumentException e)
+            {
+                return Results.BadRequest(e.Message);
+            }
+        });
+
+        app.MapGet("/requests/{id:int}", async (HousingService svc, int id) =>
+            await svc.GetRequestAsync(id) is { } card ? Results.Ok(card) : Results.NotFound());
+
+        app.MapPost("/requests/{id:int}/close", async (HousingService svc, int id, CloseRequestBody body) =>
+        {
+            try
+            {
+                return await svc.CloseRequestAsync(id, body.Comment ?? "") switch
+                {
+                    CloseResult.Closed => Results.NoContent(),
+                    CloseResult.NotFound => Results.NotFound(),
+                    _ => Results.Conflict("Закрыть можно только заявку в работе (InProgress)"),
+                };
+            }
+            catch (ArgumentException e)
+            {
+                return Results.BadRequest(e.Message);
+            }
+        });
+
+        app.MapPut("/houses/{id:int}/plan", async (PlanService svc, int id, [FromBody] List<PlanItemInput> body) =>
+        {
+            try
+            {
+                return await svc.ReplacePlanAsync(id, body) ? Results.NoContent() : Results.NotFound();
+            }
+            catch (ArgumentException e)
+            {
+                return Results.BadRequest(e.Message);
+            }
+            catch (DbUpdateException)
+            {
+                // Параллельная замена плана того же дома: уникальный индекс (plan_id, work_code).
+                return Results.Conflict("План дома одновременно изменён другим запросом, повторите");
+            }
+        });
+
+        return app;
+    }
+
+    // Enum.TryParse принимает и числа ("1"), и комбинации через запятую - для query это лишнее.
+    private static bool TryParseExact<T>(string value, out T result) where T : struct, Enum
+    {
+        foreach (var v in Enum.GetValues<T>())
+        {
+            if (string.Equals(v.ToString(), value, StringComparison.OrdinalIgnoreCase))
+            {
+                result = v;
+                return true;
+            }
+        }
+        result = default;
+        return false;
+    }
+}
