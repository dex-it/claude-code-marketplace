+            .OrderBy(s => EF.Functions.Random())
+            .Select(s => (int?)s.Id)
+            .FirstOrDefaultAsync();
+        if (sessionId is null)
+            return null;
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.Id == sessionId)
+            .Select(s => new
+            {
+                s.Id,
+                Course = s.Course.Title,
+                Trainer = s.Course.Trainer.FullName,
+                Hall = s.Hall.Name,
+                s.StartsAt,
+            })
+            .SingleAsync();
+
+        var members = await _db.Enrollments
+            .AsNoTracking()
+            .Where(e => e.SessionId == session.Id && e.Status != EnrollmentStatus.Cancelled)
+            .OrderBy(e => e.Member.FullName)
+            .Select(e => e.Member.FullName)
+            .ToListAsync();
+
+        return new QualitySessionDto(session.Id, session.Course, session.Trainer, session.Hall,
+            session.StartsAt, members);
+    }
