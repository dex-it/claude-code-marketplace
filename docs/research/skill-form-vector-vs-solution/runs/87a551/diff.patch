+    public async Task<QualitySessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        // Сначала выбираем только Id: при SplitQuery сортировка random() повторилась бы
