+using Microsoft.EntityFrameworkCore;
+
+namespace FlowStudio.Schedule;
+
+public record FreezeDto(int MemberId, DateTime StartsAt, DateTime EndsAt);
+
+public class MembershipFrozenException : InvalidOperationException
+{
+    public MembershipFrozenException(string message) : base(message) { }
+}
+
+public static class FreezeQueries
+{
+    // Заморожен ли абонемент в момент at (UTC).
+    public static Task<bool> IsFrozenAtAsync(this StudioDbContext db, int memberId, DateTime at,
+        CancellationToken ct = default) =>
+        db.MemberFreezes.AnyAsync(f => f.MemberId == memberId && f.StartsAt <= at && f.EndsAt > at, ct);
+}
+
+public class FreezeService
+{
+    public const int MaxDays = 365;
+
+    private readonly StudioDbContext _db;
+
+    public FreezeService(StudioDbContext db) => _db = db;
+
+    public async Task<FreezeDto> FreezeAsync(int memberId, int days)
+    {
+        if (days < 1 || days > MaxDays)
+            throw new ArgumentOutOfRangeException(nameof(days), $"Срок заморозки - от 1 до {MaxDays} дней");
+
+        if (!await _db.Members.AnyAsync(m => m.Id == memberId))
+            throw new KeyNotFoundException("Клиент не найден");
+
+        var now = DateTime.UtcNow;
+        if (await _db.IsFrozenAtAsync(memberId, now))
+            throw new MembershipFrozenException("Абонемент уже заморожен");
+
+        var freeze = new MemberFreeze
+        {
+            MemberId = memberId,
+            StartsAt = now,
+            EndsAt = now.AddDays(days),
+        };
+        _db.MemberFreezes.Add(freeze);
+        await _db.SaveChangesAsync();
+        return new FreezeDto(memberId, freeze.StartsAt, freeze.EndsAt);
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var now = DateTime.UtcNow;
+        var active = await _db.MemberFreezes
+            .Where(f => f.MemberId == memberId && f.StartsAt <= now && f.EndsAt > now)
+            .ToListAsync();
+        if (active.Count == 0)
+            throw new KeyNotFoundException("Активной заморозки нет");
+
+        foreach (var f in active)
+        {
+            f.EndsAt = now;
+            f.LiftedAt = now;
+        }
+        await _db.SaveChangesAsync();
+    }
+}
