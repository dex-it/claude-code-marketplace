+                item.Title = src.Title.Trim();
+                item.PeriodDays = src.PeriodDays;
+                item.ArchivedAt = null; // работу вернули в план - история снова видна
+            }
+            else if (item.ArchivedAt is null)
+            {
+                item.ArchivedAt = now;
+            }
+        }
+
+        foreach (var (code, src) in incoming)
+        {
+            plan.Items.Add(new PlanItem { WorkCode = code, Title = src.Title.Trim(), PeriodDays = src.PeriodDays });
+        }
+
+        await _db.SaveChangesAsync();
+    }
