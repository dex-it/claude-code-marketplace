+    private static List<string> Validate(IReadOnlyList<PlanItemInput> input)
+    {
+        var errors = new List<string>();
+        if (input is null)
+        {
+            errors.Add("Пустой план");
+            return errors;
+        }
+
+        foreach (var i in input)
+        {
+            if (string.IsNullOrWhiteSpace(i.WorkCode))
+                errors.Add("Не указан код работы");
+            if (string.IsNullOrWhiteSpace(i.Title))
+                errors.Add($"{i.WorkCode}: не указано название");
+            if (i.PeriodDays <= 0)
+                errors.Add($"{i.WorkCode}: периодичность должна быть больше нуля");
+        }
+
+        var duplicates = input
+            .Where(i => !string.IsNullOrWhiteSpace(i.WorkCode))
+            .GroupBy(i => i.WorkCode.Trim())
+            .Where(g => g.Count() > 1)
+            .Select(g => g.Key);
+        foreach (var code in duplicates)
+            errors.Add($"{code}: код работы повторяется");
+
+        return errors;
+    }
