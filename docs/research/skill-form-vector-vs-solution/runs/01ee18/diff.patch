+    public async Task FreezeMemberAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Количество дней должно быть положительным");
+
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenUntil = DateTime.UtcNow.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeMemberAsync(int memberId)
+    {
+        var member = await _db.Members.FirstOrDefaultAsync(m => m.Id == memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    // "Тайный гость": случайное занятие из ближайших 7 дней. Индекс выбирается в коде,
+    // а нужная строка выбирается в БД (Skip/Take), чтобы не вытягивать всю таблицу.
+    public async Task<RandomSessionDto?> GetRandomSessionForAuditAsync()
+    {
+        var from = DateTime.UtcNow;
+        var to = from.AddDays(7);
+
+        var query = _db.Sessions
+            .Where(s => s.StartsAt >= from && s.StartsAt < to
+                && s.Course.Status == CourseStatus.Published);
+
+        var count = await query.CountAsync();
+        if (count == 0)
+            return null;
+
+        var index = Random.Shared.Next(count);
+
+        return await query
+            .OrderBy(s => s.Id)
+            .Skip(index)
+            .Select(s => new RandomSessionDto(
+                s.Course.Title,
+                s.Course.Trainer.FullName,
+                s.Hall.Name,
+                s.StartsAt,
+                s.Enrollments
+                    .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                    .Select(e => e.Member.FullName)
+                    .ToList()))
+            .FirstOrDefaultAsync();
+    }
 }
