index cc90064..13e6301 100644
--- a/Model.cs
+++ b/Model.cs
@@ -14,6 +14,7 @@ public class Order
     public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
+    public int Complexity { get; set; }              // сложность комплектации: 1..5
     public List<OrderItem> Items { get; set; } = new();
     public List<Payment> Payments { get; set; } = new();
     public bool IsOverdue(DateTime now) => ShippedAt == null && CreatedAt.AddDays(3) < now;
@@ -44,7 +45,32 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        // Column stays "timestamp without time zone" (DBA reports depend on it); Npgsql 8 throws
+        // when writing Kind=Utc into that store type, so relabel the Kind at the boundary instead
+        // of changing the column: app code always sees CreatedAt as Kind=Utc.
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                v => DateTime.SpecifyKind(v, DateTimeKind.Unspecified),
+                v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
+        b.Entity<Order>().Property(o => o.Complexity).IsRequired();
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint("CK_Orders_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(oi => oi.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Cascade);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Cascade);
     }
 }
