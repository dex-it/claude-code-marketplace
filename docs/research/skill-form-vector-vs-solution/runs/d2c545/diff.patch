+    // Отчёт методиста: число выдач по каждому филиалу за период (period задан мгновениями времени).
+    public async Task<List<LoansByBranchRow>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var query =
+            from b in _db.Branches
+            join l in _db.Loans.Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+                on b.Id equals l.BranchId into loansInPeriod
+            orderby b.Id
+            select new LoansByBranchRow(b.Id, b.Name, loansInPeriod.Count());
+
+        return await query.ToListAsync();
+    }
