+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        if (items.Select(i => i.WorkCode).Distinct().Count() != items.Count)
+            throw new ArgumentException("Код работы повторяется в присланном плане");
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .SingleOrDefaultAsync(p => p.HouseId == houseId)
+            ?? throw new KeyNotFoundException($"У дома {houseId} нет плана обслуживания");
+
+        var incoming = items.ToDictionary(i => i.WorkCode);
+        var matchedCodes = new HashSet<string>();
+
+        foreach (var existing in plan.Items.ToList())
+        {
+            if (incoming.TryGetValue(existing.WorkCode, out var upd))
+            {
+                existing.Title = upd.Title;
+                existing.PeriodDays = upd.PeriodDays;
+                matchedCodes.Add(existing.WorkCode);
+            }
+            else
+            {
+                _db.PlanItems.Remove(existing);
+            }
+        }
+
+        foreach (var newItem in items.Where(i => !matchedCodes.Contains(i.WorkCode)))
+        {
+            plan.Items.Add(new PlanItem
+            {
+                WorkCode = newItem.WorkCode,
+                Title = newItem.Title,
+                PeriodDays = newItem.PeriodDays,
+            });
+        }
+
+        await _db.SaveChangesAsync();
