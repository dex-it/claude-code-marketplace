+namespace Domovoy.Housing;
+
+// Операция запрещена текущим состоянием сущности (мапится в HTTP 409 на уровне контроллера).
+public class RequestConflictException : Exception
+{
+    public RequestConflictException(string message) : base(message) { }
+}
