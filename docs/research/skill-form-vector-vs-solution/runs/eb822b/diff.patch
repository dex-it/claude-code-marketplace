@@ -0,0 +1,68 @@
+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing;
+
+[ApiController]
+[Route("requests")]
+public class RequestsController : ControllerBase
+{
+    private readonly HousingService _service;
+
+    public RequestsController(HousingService service) => _service = service;
+
+    // Реестр заявок диспетчера. sort=date|address|status, dir=asc|desc; остальные фильтры - как раньше.
+    [HttpGet]
+    public async Task<ActionResult<List<RequestRow>>> Search(
+        [FromQuery] string? text,
+        [FromQuery] RequestStatus? status,
+        [FromQuery] int? houseId,
+        [FromQuery] string? district,
+        [FromQuery] string? sort,
+        [FromQuery] string? dir,
+        [FromQuery] int page = 1,
+        [FromQuery] int pageSize = 50)
+    {
+        var result = await _service.SearchAsync(
+            new RequestSearch(text, status, houseId, district, sort, dir, page, pageSize));
+        return Ok(result);
+    }
+
+    [HttpGet("{id:int}")]
+    public async Task<ActionResult<RequestCard>> Get(int id)
+    {
+        var card = await _service.GetRequestAsync(id);
+        return card is null ? NotFound() : Ok(card);
+    }
+
+    [HttpPost]
+    public async Task<ActionResult<int>> Create([FromBody] NewRequest request)
+    {
+        var id = await _service.CreateRequestAsync(request);
+        return CreatedAtAction(nameof(Get), new { id }, id);
+    }
+
+    public record CloseRequestBody(string Comment);
+
+    // Мастер закрывает заявку: статус -> Done, комментарий обязателен. 409, если заявка не в InProgress.
+    [HttpPost("{id:int}/close")]
+    public async Task<IActionResult> Close(int id, [FromBody] CloseRequestBody body)
+    {
+        try
+        {
+            await _service.CloseRequestAsync(id, body.Comment);
+            return NoContent();
+        }
+        catch (KeyNotFoundException)
+        {
+            return NotFound();
+        }
+        catch (RequestConflictException ex)
+        {
+            return Conflict(ex.Message);
+        }
+        catch (ArgumentException ex)
+        {
+            return BadRequest(ex.Message);
+        }
+    }
+}
