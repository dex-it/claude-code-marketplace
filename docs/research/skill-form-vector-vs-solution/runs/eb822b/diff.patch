+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing;
+
+[ApiController]
+[Route("houses")]
+public class HousesController : ControllerBase
+{
+    private readonly PlanService _plans;
+
+    public HousesController(PlanService plans) => _plans = plans;
+
+    [HttpGet("{id:int}/plan")]
+    public async Task<ActionResult<List<PlanItemDto>>> GetPlan(int id) =>
+        Ok(await _plans.GetPlanAsync(id));
+
+    // Инженер присылает план дома целиком - план дома становится таким, как прислано.
+    [HttpPut("{id:int}/plan")]
+    public async Task<IActionResult> ReplacePlan(int id, [FromBody] List<PlanItemInput> items)
+    {
+        await _plans.ReplacePlanAsync(id, items);
+        return NoContent();
+    }
+}
