+    public async Task FreezeAsync(int memberId, int days)
+    {
+        if (days <= 0)
+            throw new ArgumentOutOfRangeException(nameof(days), "Число дней должно быть положительным");
+
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenUntil = DateTime.UtcNow.AddDays(days);
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    // "Тайный гость": случайное занятие из ближайших 7 дней для выборочной проверки качества.
+    public async Task<RandomSessionDto?> GetRandomSessionForAuditAsync()
+    {
+        var now = DateTime.UtcNow;
+        var until = now.AddDays(7);
+
+        var count = await _db.Sessions.CountAsync(s => s.StartsAt >= now && s.StartsAt <= until);
+        if (count == 0)
+            return null;
+
+        var skip = Random.Shared.Next(count);
+
+        return await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.StartsAt >= now && s.StartsAt <= until)
+            .OrderBy(s => s.Id)
+            .Skip(skip)
+            .Select(s => new RandomSessionDto(
+                s.Course.Title,
+                s.Course.Trainer.FullName,
+                s.Hall.Name,
+                s.StartsAt,
+                s.Enrollments
+                    .Where(e => e.Status != EnrollmentStatus.Cancelled)
+                    .Select(e => e.Member.FullName)
+                    .ToList()))
+            .FirstOrDefaultAsync();
+    }
 }
