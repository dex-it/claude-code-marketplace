@@ -44,7 +45,30 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        // Колонка timestamp without time zone неизменна (на неё смотрят отчёты DBA);
+        // конвертер хранит UTC-момент как Unspecified и восстанавливает Kind=Utc при чтении.
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                v => DateTime.SpecifyKind(v, DateTimeKind.Unspecified),
+                v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint("CK_Order_Complexity", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // FK зависимых без каскада: реальное удаление Items/Payments делает код (см. ClearItemsAsync),
+        // а не БД - Order удаляется только мягко (IsDeleted).
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .OnDelete(DeleteBehavior.Restrict);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .OnDelete(DeleteBehavior.Restrict);
     }
