+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (а) Карточка одного заказа по Id со всеми позициями и платежами
+    public async Task<Order?> GetOrderDetailsAsync(Guid orderId)
+    {
+        return await _db.Orders
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync(o => o.Id == orderId);
+    }
+
+    // (б) Выгрузка всех заказов клиента с позициями и платежами
+    // Использует IAsyncEnumerable для оптимизации памяти при больших объёмах
+    public IAsyncEnumerable<Order> GetCustomerOrdersAsync(Guid customerId)
+    {
+        return _db.Orders
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsAsyncEnumerable();
+    }
+
+    // (в) Получить продукт по SKU; склад может быть null
+    // Если warehouse не задан, берём первый доступный SKU
+    public async Task<Product?> GetProductBySkuAsync(string sku, string? warehouse = null)
+    {
+        var query = _db.Products.Where(p => p.Sku == sku);
+
+        if (!string.IsNullOrEmpty(warehouse))
+        {
+            query = query.Where(p => p.Warehouse == warehouse);
+        }
+
+        return await query.FirstOrDefaultAsync();
+    }
+
+    // (г) Дата отгрузки последнего отгруженного заказа клиента
+    // Возвращает DateTime.MinValue если отгруженных заказов нет
+    public async Task<DateTime> GetLastShippedDateAsync(Guid customerId)
+    {
+        var lastShipped = await _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt.HasValue)
+            .OrderByDescending(o => o.ShippedAt)
+            .Select(o => o.ShippedAt)
+            .FirstOrDefaultAsync();
+
+        return lastShipped ?? default;
+    }
+}
