+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (а) Карточка одного заказа по Id со всеми позициями и платежами
+    public Task<Order?> GetOrderAsync(Guid orderId) =>
+        _db.Orders
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync(o => o.Id == orderId);
+
+    // (б) Выгрузка всех заказов клиента с позициями и платежами
+    public Task<List<Order>> GetCustomerOrdersAsync(Guid customerId) =>
+        _db.Orders
+            .Where(o => o.CustomerId == customerId)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .ToListAsync();
+
+    // (в) Продукт по SKU на складе
+    public async Task<Product?> GetProductBySku(string sku, string? warehouse)
+    {
+        var query = _db.Products.Where(p => p.Sku == sku);
+
+        if (!string.IsNullOrEmpty(warehouse))
+        {
+            return await query.Where(p => p.Warehouse == warehouse).FirstOrDefaultAsync();
+        }
+        else
+        {
+            var results = await query.ToListAsync();
+            return results.Count == 1 ? results[0] : null;
+        }
+    }
+
+    // (г) Дата отгрузки последнего отгруженного заказа клиента
+    public Task<DateTime> GetLastShippedAtAsync(Guid customerId) =>
+        _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .OrderByDescending(o => o.ShippedAt)
+            .Select(o => o.ShippedAt!)
+            .FirstAsync();
+}
