+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing.Api;
+
+[ApiController]
+[Route("api/[controller]")]
+public class HousesController : ControllerBase
+{
+    private readonly PlanService _service;
+
+    public HousesController(PlanService service) => _service = service;
+
+    [HttpPut("{id}/plan")]
+    public async Task<IActionResult> UpdatePlan(int id, [FromBody] UpdatePlanDto dto)
+    {
+        try
+        {
+            if (dto.Items == null || !dto.Items.Any())
+                return BadRequest("План должен содержать хотя бы одну работу");
+
+            await _service.UpdatePlanAsync(id, dto.Items.Select(i =>
+                new PlanItemInput(i.WorkCode, i.Title, i.PeriodDays)).ToList());
+            return Ok();
+        }
+        catch (KeyNotFoundException)
+        {
+            return NotFound();
+        }
+    }
+}
+
+public record UpdatePlanDto(List<PlanItemInputDto> Items);
+
+public record PlanItemInputDto(string WorkCode, string Title, int PeriodDays);
