@@ -0,0 +1,35 @@
+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing.Api;
+
+[ApiController]
+[Route("api/[controller]")]
+public class RequestsController : ControllerBase
+{
+    private readonly HousingService _service;
+
+    public RequestsController(HousingService service) => _service = service;
+
+    [HttpPost("{id}/close")]
+    public async Task<IActionResult> CloseRequest(int id, [FromBody] CloseRequestDto dto)
+    {
+        try
+        {
+            if (string.IsNullOrWhiteSpace(dto.Comment))
+                return BadRequest("Комментарий обязателен");
+
+            await _service.CloseRequestAsync(id, dto.Comment);
+            return Ok();
+        }
+        catch (InvalidOperationException ex)
+        {
+            return StatusCode(409, ex.Message);
+        }
+        catch (KeyNotFoundException)
+        {
+            return NotFound();
+        }
+    }
+}
+
+public record CloseRequestDto(string Comment);
