+        var newCodes = newItems.Select(i => i.WorkCode).ToHashSet();
+        var currentCodes = plan.Items.Select(i => i.WorkCode).ToHashSet();
+
+        // Удаляем работы, которых нет в новом плане
+        foreach (var item in plan.Items.Where(i => !newCodes.Contains(i.WorkCode)).ToList())
+        {
+            plan.Items.Remove(item);
+        }
+
+        // Обновляем существующие и добавляем новые работы
+        foreach (var input in newItems)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == input.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = input.Title;
+                existing.PeriodDays = input.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
 }
