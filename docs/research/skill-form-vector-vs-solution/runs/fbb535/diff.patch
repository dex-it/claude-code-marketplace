diff --git a/StudentAppService.cs b/StudentAppService.cs
new file mode 100644
index 0000000..c3f22a4
--- /dev/null
+++ b/StudentAppService.cs
@@ -0,0 +1,85 @@
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record AppLoginRequest(string Email);
+public record AppLoginConfirmRequest(string Email, string Code);
+public record AppLoginResult(int StudentId, string FullName);
+public record AppProgressResult(int StudentId, double HoursDone, double TotalHours, double HoursLeft);
+
+// Эндпоинты мобильного приложения ученика: вход по одноразовому коду и прогресс обучения.
+public class StudentAppService
+{
+    private const int CodeLifetimeMinutes = 10;
+    private const double RequiredHours = 56;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public StudentAppService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    public async Task RequestLoginAsync(string rawEmail)
+    {
+        var email = NormalizeEmail(rawEmail);
+        var student = await _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == email);
+        if (student is null)
+            return; // не раскрываем, есть ли такой e-mail в базе
+
+        var code = RandomNumberGenerator.GetInt32(1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash(code),
+            ExpiresAtUtc = DateTime.UtcNow.AddMinutes(CodeLifetimeMinutes),
+        });
+
+        await _email.SendAsync(student.Email, "Код для входа", $"Ваш код для входа: {code}. Он действует {CodeLifetimeMinutes} минут.");
+    }
+
+    public async Task<AppLoginResult?> ConfirmLoginAsync(string rawEmail, string rawCode)
+    {
+        var email = NormalizeEmail(rawEmail);
+        var student = await _db.Students.FirstOrDefaultAsync(s => s.Email.ToLower() == email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var hash = Hash(rawCode.Trim());
+        var loginCode = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Consumed && c.ExpiresAtUtc > now && c.CodeHash == hash)
+            .OrderByDescending(c => c.Id)
+            .FirstOrDefaultAsync();
+
+        if (loginCode is null)
+            return null;
+
+        loginCode.Consumed = true;
+        return new AppLoginResult(student.Id, student.FullName);
+    }
+
+    public async Task<AppProgressResult?> GetProgressAsync(int studentId)
+    {
+        var exists = await _db.Students.AnyAsync(s => s.Id == studentId);
+        if (!exists)
+            return null;
+
+        var minutesDone = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
+            .SumAsync(l => (int?)l.Minutes) ?? 0;
+
+        var hoursDone = Math.Round(minutesDone / 60.0, 2);
+        var hoursLeft = Math.Max(0, Math.Round(RequiredHours - hoursDone, 2));
+        return new AppProgressResult(studentId, hoursDone, RequiredHours, hoursLeft);
+    }
+
+    private static string NormalizeEmail(string email) => email.Trim().ToLowerInvariant();
+
+    private static string Hash(string value) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
+}
