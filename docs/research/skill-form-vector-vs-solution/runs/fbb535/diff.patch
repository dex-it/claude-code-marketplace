+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesReportRow(int? InstructorId, string InstructorName, int GraduatesCount);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Выпускники за год по инструкторам, включая уже уволенных.
+    public async Task<List<GraduatesReportRow>> GraduatesByYearAsync(int year)
+    {
+        var graduates = await _db.Students.AsNoTracking()
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn != null
+                        && s.GraduatedOn.Value.Year == year)
+            .Select(s => s.InstructorId)
+            .ToListAsync();
+
+        var instructors = await _db.Instructors.AsNoTracking()
+            .IgnoreQueryFilters()
+            .Where(i => i.SchoolId == _db.SchoolId)
+            .ToDictionaryAsync(i => i.Id, i => i.FullName);
+
+        return graduates
+            .GroupBy(instructorId => instructorId)
+            .Select(g => new GraduatesReportRow(
+                g.Key,
+                g.Key is { } id && instructors.TryGetValue(id, out var name) ? name : "Без инструктора",
+                g.Count()))
+            .OrderByDescending(r => r.GraduatesCount)
+            .ToList();
+    }
+}
