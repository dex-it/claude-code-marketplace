+using Microsoft.EntityFrameworkCore.Storage.ValueConversion;
+
 namespace Shop.Data;
 
 public class Customer { public Guid Id { get; set; } public string Name { get; set; } = ""; public List<Order> Orders { get; set; } = new(); }
@@ -11,7 +13,8 @@ public class Order
     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
-    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
+    public int Complexity { get; set; }               // 1..5, сложность комплектации заказа
+    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone, значение всегда UTC
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
     public List<OrderItem> Items { get; set; } = new();
@@ -41,10 +44,38 @@ public class ShopDbContext : DbContext
     public DbSet<Order> Orders => Set<Order>();
     public DbSet<Product> Products => Set<Product>();
     public DbSet<AuditLog> AuditLogs => Set<AuditLog>();
+    // "timestamp without time zone" не хранит Kind. Npgsql 6+ требует Kind=Unspecified для
+    // записи в такую колонку и отдаёт Kind=Unspecified при чтении. Конвертер снимает Kind
+    // перед записью (в коде значение всегда UTC-момент) и восстанавливает Kind=Utc при чтении,
+    // не меняя ни тип колонки, ни хранимое значение - отчёты DBA не затрагиваются.
+    private static readonly ValueConverter<DateTime, DateTime> UtcNoTzConverter = new(
+        toProvider => DateTime.SpecifyKind(toProvider, DateTimeKind.Unspecified),
+        fromProvider => DateTime.SpecifyKind(fromProvider, DateTimeKind.Utc));
+
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(UtcNoTzConverter);
+
+        b.Entity<Order>().Property(o => o.Complexity).IsRequired();
+        b.Entity<Order>().HasCheckConstraint("CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5");
+
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Cascade);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Cascade);
     }
 }
