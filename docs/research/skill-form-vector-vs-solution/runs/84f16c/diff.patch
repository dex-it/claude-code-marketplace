+namespace Shop.Data;
+
+public record ActiveOrderReportItem(Guid Id, string CustomerName, decimal Total, int ItemsCount);
+public record OverdueOrderReportItem(Guid Id, string CustomerName, decimal Total, DateTime CreatedAt);
+
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public Task<List<ActiveOrderReportItem>> GetActiveOrdersAsync(CancellationToken ct = default) =>
+        _orders.Active()
+            .Select(o => new ActiveOrderReportItem(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync(ct);
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountByCategoryAsync(CancellationToken ct = default) =>
+        _orders.Active()
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count, ct);
+
+    // now должен иметь DateTimeKind.Unspecified - колонка CreatedAt смаплена как
+    // "timestamp without time zone", и Npgsql бросит исключение на параметре с Kind=Utc.
+    // Условие продублировано из Order.IsOverdue: сам метод - экземплярный вызов
+    // на CLR-объекте и не транслируется в SQL.
+    public Task<List<OverdueOrderReportItem>> GetOverdueOrdersAsync(DateTime now, CancellationToken ct = default) =>
+        _orders.Query()
+            .Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now)
+            .Select(o => new OverdueOrderReportItem(o.Id, o.Customer.Name, o.Total, o.CreatedAt))
+            .ToListAsync(ct);
+}
