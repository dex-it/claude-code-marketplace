+    // Удаление клиента — только мягкое (см. README): помечаем клиента и всю его медкарту
+    // (питомцы, аллергии, визиты) одной меткой DeletedAt, чтобы поддержка могла восстановить
+    // ровно то, что удалено этой операцией. Глобальные фильтры скрывают записи отовсюду,
+    // в т.ч. запланированные визиты из расписания врачей.
+    public async Task<bool> DeleteOwnerAsync(int ownerId)
+    {
+        var owner = await db.Owners
+            .Include(o => o.Pets).ThenInclude(p => p.Allergies)
+            .Include(o => o.Pets).ThenInclude(p => p.Visits)
+            .AsSplitQuery()
+            .SingleOrDefaultAsync(o => o.Id == ownerId);
+        if (owner is null)
+            return false;
+
+        var now = DateTime.UtcNow;
+        MarkDeleted(owner, now);
+        foreach (var pet in owner.Pets)
+        {
+            MarkDeleted(pet, now);
+            foreach (var allergy in pet.Allergies)
+                MarkDeleted(allergy, now);
+            foreach (var visit in pet.Visits)
+                MarkDeleted(visit, now);
+        }
+
+        await db.SaveChangesAsync();
+        return true;
+    }
+
+    // Замена списка аллергий целиком. Физически ничего не удаляем: аллергии, которых нет
+    // в новом списке или у которых изменились реакция/тяжесть, помечаются удалёнными,
+    // изменённые и новые добавляются отдельными записями — история медкарты сохраняется.
+    public async Task<bool> ReplaceAllergiesAsync(int petId, IReadOnlyList<AllergyInput> allergies)
+    {
+        var normalized = allergies
+            .Select(a => new AllergyInput(
+                a.Allergen?.Trim() ?? "",
+                string.IsNullOrWhiteSpace(a.Reaction) ? null : a.Reaction.Trim(),
+                a.Severity))
+            .ToList();
+
+        if (normalized.Any(a => a.Allergen.Length == 0))
+            throw new ArgumentException("Аллерген не может быть пустым.");
+        if (normalized.Any(a => a.Allergen.Length > 200))
+            throw new ArgumentException("Название аллергена длиннее 200 символов.");
+        if (normalized.Any(a => !Enum.IsDefined(a.Severity)))
+            throw new ArgumentException("Неизвестная тяжесть аллергии.");
+        if (normalized.GroupBy(a => a.Allergen, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
+            throw new ArgumentException("Аллерген указан в списке несколько раз.");
+
+        var pet = await db.Pets
+            .Include(p => p.Allergies)
+            .SingleOrDefaultAsync(p => p.Id == petId);
+        if (pet is null)
+            return false;
+
+        var now = DateTime.UtcNow;
+        var kept = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+        foreach (var existing in pet.Allergies.ToList())
+        {
+            var unchanged = normalized.Any(n =>
+                string.Equals(n.Allergen, existing.Allergen, StringComparison.OrdinalIgnoreCase)
+                && n.Reaction == existing.Reaction
+                && n.Severity == existing.Severity);
+            // kept.Add == false — дубль уже сохранённой аллергии, его тоже убираем
+            if (!unchanged || !kept.Add(existing.Allergen))
+                MarkDeleted(existing, now);
+        }
+
+        foreach (var input in normalized)
+        {
+            if (!kept.Contains(input.Allergen))
+            {
+                pet.Allergies.Add(new Allergy
+                {
+                    Allergen = input.Allergen,
+                    Reaction = input.Reaction,
+                    Severity = input.Severity
+                });
+            }
+        }
+
+        await db.SaveChangesAsync();
+        return true;
+    }
+
+    public async Task UpdateVisitAnamnesisAsync(int visitId, string? anamnesis)
     {
         var visit = await db.Visits.SingleAsync(v => v.Id == visitId);
-        visit.Notes = notes;
+        visit.Anamnesis = anamnesis;
         await db.SaveChangesAsync();
     }
+
+    private static void MarkDeleted(ISoftDeletable entity, DateTime now)
+    {
+        entity.IsDeleted = true;
+        entity.DeletedAt = now;
+    }
