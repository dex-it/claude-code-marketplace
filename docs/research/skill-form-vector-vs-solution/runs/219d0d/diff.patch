diff --git a/PaymentImportService.cs b/PaymentImportService.cs
new file mode 100644
index 0000000..c4b6028
--- /dev/null
+++ b/PaymentImportService.cs
@@ -0,0 +1,116 @@
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+using Npgsql;
+
+namespace Tarif.Billing;
+
+public record StatementImportResult(int Credited, int Unmatched, int AlreadyLoaded);
+
+public class PaymentImportService
+{
+    private readonly BillingDbContext _db;
+
+    public PaymentImportService(BillingDbContext db) => _db = db;
+
+    // Интернет-банк отдаёт выписку то в UTF-8, то в windows-1251: пробуем строгий UTF-8, иначе 1251.
+    public static TextReader OpenStatement(byte[] content)
+    {
+        try
+        {
+            var text = new UTF8Encoding(false, throwOnInvalidBytes: true).GetString(content);
+            return new StringReader(text.TrimStart('﻿'));
+        }
+        catch (DecoderFallbackException)
+        {
+            Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
+            return new StringReader(Encoding.GetEncoding(1251).GetString(content));
+        }
+    }
+
+    public async Task<StatementImportResult> ImportAsync(IReadOnlyList<StatementLine> lines)
+    {
+        // Одна и та же операция может встретиться в файле дважды - берём первую.
+        var unique = lines.GroupBy(l => l.BankRef).Select(g => g.First()).ToList();
+        var refs = unique.Select(l => l.BankRef).ToList();
+
+        await using var tx = await _db.Database.BeginTransactionAsync();
+
+        // Повторная загрузка: строки, уже зачисленные или уже отложенные бухгалтеру, пропускаем.
+        var loaded = (await _db.Payments.Where(p => refs.Contains(p.BankRef)).Select(p => p.BankRef).ToListAsync())
+            .Concat(await _db.UnmatchedPayments.Where(p => refs.Contains(p.BankRef)).Select(p => p.BankRef).ToListAsync())
+            .ToHashSet();
+        var fresh = unique.Where(l => !loaded.Contains(l.BankRef)).ToList();
+
+        var contractNos = fresh
+            .Select(l => PaymentPurpose.ExtractContractNo(l.Purpose))
+            .OfType<string>()
+            .Distinct()
+            .ToArray();
+
+        // Блокируем строки абонентов до конца транзакции, чтобы параллельные изменения баланса не потерялись.
+        var subscribers = await _db.Subscribers
+            .FromSql($"""SELECT * FROM "Subscribers" WHERE "ContractNo" = ANY({contractNos}) FOR UPDATE""")
+            .ToDictionaryAsync(s => s.ContractNo!);
+
+        var now = DateTime.Now;
+        int credited = 0, unmatched = 0;
+
+        foreach (var line in fresh)
+        {
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var reason =
+                line.Amount <= 0 ? "Некорректная сумма" :
+                contractNo is null ? "Нет номера договора" :
+                !subscribers.TryGetValue(contractNo, out var found) ? "Договор не найден" :
+                found.Status == SubscriberStatus.Closed ? "Договор расторгнут" :
+                null;
+
+            if (reason is not null)
+            {
+                _db.UnmatchedPayments.Add(new UnmatchedPayment
+                {
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    Amount = line.Amount,
+                    PayerName = line.PayerName,
+                    Purpose = line.Purpose,
+                    Reason = reason,
+                    LoadedAt = now,
+                });
+                unmatched++;
+                continue;
+            }
+
+            var s = subscribers[contractNo!];
+            s.Balance += line.Amount;
+            s.Payments.Add(new Payment
+            {
+                Amount = line.Amount,
+                BankRef = line.BankRef,
+                PaidOn = line.PaidOn,
+                CreditedAt = now,
+                Purpose = line.Purpose,
+            });
+
+            if (s.Status == SubscriberStatus.Suspended && s.Balance >= 0)
+            {
+                s.Status = SubscriberStatus.Active;
+                s.ResumedAt = now;
+            }
+            credited++;
+        }
+
+        try
+        {
+            await _db.SaveChangesAsync();
+            await tx.CommitAsync();
+        }
+        catch (DbUpdateException ex) when (ex.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })
+        {
+            // Ту же выписку параллельно грузит кто-то ещё; наша транзакция откатится целиком.
+            throw new InvalidOperationException("Выписка уже загружается, повторите позже", ex);
+        }
+
+        return new StatementImportResult(credited, unmatched, lines.Count - fresh.Count);
+    }
+}
