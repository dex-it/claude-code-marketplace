+
+// Файл выписки - тело запроса как есть (text/csv) либо первый файл multipart/form-data.
+app.MapPost("/bank/statements", async (HttpRequest request, PaymentImportService import) =>
+{
+    using var buffer = new MemoryStream();
+    if (request.HasFormContentType)
+    {
+        var form = await request.ReadFormAsync();
+        if (form.Files.Count == 0)
+            return Results.BadRequest("Файл выписки не передан");
+        await form.Files[0].CopyToAsync(buffer);
+    }
+    else
+    {
+        await request.Body.CopyToAsync(buffer);
+    }
+
+    List<StatementLine> lines;
+    try
+    {
+        lines = BankStatement.Parse(PaymentImportService.OpenStatement(buffer.ToArray()));
+    }
+    catch (Exception ex) when (ex is FormatException or IndexOutOfRangeException)
+    {
+        return Results.BadRequest($"Не удалось разобрать выписку: {ex.Message}");
+    }
+
+    try
+    {
+        return Results.Ok(await import.ImportAsync(lines));
+    }
+    catch (InvalidOperationException ex)
+    {
+        return Results.Conflict(ex.Message);
+    }
+});
+
 app.Run();
