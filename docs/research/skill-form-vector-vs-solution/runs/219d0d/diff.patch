+app.MapGet("/subscribers/search", async (string? phone, SubscriberService s) =>
+{
+    try
+    {
+        return Results.Ok(await s.SearchByPhoneTailAsync(phone ?? ""));
+    }
+    catch (ArgumentException ex)
