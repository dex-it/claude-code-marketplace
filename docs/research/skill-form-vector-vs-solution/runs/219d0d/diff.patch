@@ -50,4 +50,20 @@ public class SubscriberService
             ? null
             : new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance);
     }
+
+    // Поиск по последним цифрам телефона; телефоны хранятся как ввели («+7 (912) 345-45-18»),
+    // поэтому сравниваем с PhoneDigits. Во входе оставляем только цифры (заодно нет символов LIKE).
+    public async Task<List<SubscriberDto>> SearchByPhoneTailAsync(string tail)
+    {
+        var digits = new string(tail.Where(char.IsAsciiDigit).ToArray());
+        if (digits.Length < 4)
+            throw new ArgumentException("Нужно не меньше 4 цифр телефона");
+
+        return await _db.Subscribers.AsNoTracking()
+            .Where(s => s.PhoneDigits.EndsWith(digits))
+            .OrderBy(s => s.FullName).ThenBy(s => s.Id)
+            .Take(20)
+            .Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToListAsync();
+    }
 }
diff --git a/_answer.md b/_answer.md
new file mode 100644
index 0000000..483243a
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,13 @@
+**Файлы:**
+- `PaymentImportService.cs` — новый: импорт выписки (а, б), определение кодировки (UTF-8 или windows-1251).
+- `Models.cs` — новая сущность `UnmatchedPayment`; у `Subscriber` добавлены `ResumedAt` и `PhoneDigits`.
+- `BillingDbContext.cs` — `UnmatchedPayments` с уникальным `BankRef`; `PhoneDigits` — вычисляемая колонка `regexp_replace("Phone", '\D', '', 'g')`.
+- `SubscriberService.cs` — `SearchByPhoneTailAsync`.
+- `Program.cs` — `POST /bank/statements` (сырое тело или multipart) и `GET /subscribers/search?phone=`.
+
+**Решения:**
+- Повторная загрузка не зачисляет деньги второй раз: строка пропускается, если её `BankRef` уже есть в платежах или в неразобранных; на обеих таблицах уникальный индекс. Весь импорт идёт в одной транзакции, строки абонентов блокируются `SELECT … FOR UPDATE`. Если ту же выписку параллельно грузят второй раз, срабатывает уникальный индекс, транзакция откатывается целиком и клиент получает 409.
+- В неразобранные, с указанием причины, попадают строки без номера договора, с неизвестным или расторгнутым (Closed) договором и с суммой ≤ 0. Приостановленный абонент возвращается в Active сразу, как только баланс становится ≥ 0, время записывается в `ResumedAt`.
+- Телефоны хранятся в том виде, как их ввели, поэтому поиск идёт по колонке с одними цифрами. Нужно минимум 4 цифры, иначе 400. Выдаётся не больше 20 абонентов, сортировка по ФИО.
+
+Сборку и тесты не запускал. Миграции в проекте нет, её нужно создать (новая таблица и колонки `ResumedAt`, `PhoneDigits`).
