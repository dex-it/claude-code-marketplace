+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Storage.ValueConversion;
+
 namespace Shop.Data;
 
 public class Customer { public Guid Id { get; set; } public string Name { get; set; } = ""; public List<Order> Orders { get; set; } = new(); }
@@ -14,6 +17,7 @@ public class Order
     public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
+    public int Complexity { get; set; }              // сложность комплектации, 1..5
     public List<OrderItem> Items { get; set; } = new();
     public List<Payment> Payments { get; set; } = new();
     public bool IsOverdue(DateTime now) => ShippedAt == null && CreatedAt.AddDays(3) < now;
@@ -44,7 +48,34 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        // Колонка - timestamp without time zone, в БД хранится Unspecified.
+        // В коде CreatedAt всегда пишется/читается как Kind=Utc, конвертер лишь снимает/проставляет Kind.
+        var utcConverter = new ValueConverter<DateTime, DateTime>(
+            v => DateTime.SpecifyKind(v, DateTimeKind.Unspecified),
+            v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
+        b.Entity<Order>().Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(utcConverter);
+
+        b.Entity<Order>().ToTable(t => t.HasCheckConstraint(
+            "CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // FK у зависимых - без каскада в БД: soft-delete не должен провоцировать
+        // реальное каскадное удаление Items/Payments при физическом удалении Order.
+        // Разрывать связь через Clear() коллекции нельзя - код удаляет зависимые записи явно.
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .OnDelete(DeleteBehavior.Restrict);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .OnDelete(DeleteBehavior.Restrict);
     }
 }
