+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+// Подключается в Program.cs: app.MapHousingEndpoints();
+public static class Endpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/requests", async ([AsParameters] RequestSearch search, HousingService svc) =>
+            Results.Ok(await svc.SearchAsync(search)));
+
+        app.MapGet("/requests/{id:int}", async (int id, HousingService svc) =>
+        {
+            var card = await svc.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        app.MapPost("/requests", async (NewRequest body, HousingService svc) =>
+        {
+            var id = await svc.CreateRequestAsync(body);
+            return Results.Created($"/requests/{id}", new { id });
+        });
+
+        // Мастер закрывает заявку: Done + обязательный комментарий о выполненных работах, только из InProgress.
+        app.MapPost("/requests/{id:int}/close", async (int id, CloseRequest body, HousingService svc) =>
+        {
+            if (string.IsNullOrWhiteSpace(body.Comment))
+                return Results.BadRequest(new { error = "Комментарий о выполненных работах обязателен" });
+
+            try
+            {
+                await svc.CloseRequestAsync(id, body.Comment.Trim());
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (RequestConflictException ex)
+            {
+                return Results.Conflict(new { error = ex.Message });
+            }
+        });
+
+        // Инженер присылает план дома целиком.
+        app.MapPut("/houses/{id:int}/plan", async (int id, List<PlanItemInput> items, PlanService svc) =>
+        {
+            try
+            {
+                await svc.ReplacePlanAsync(id, items);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException)
+            {
+                return Results.NotFound();
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(new { error = ex.Message });
+            }
+        });
+
+        return app;
+    }
+}
