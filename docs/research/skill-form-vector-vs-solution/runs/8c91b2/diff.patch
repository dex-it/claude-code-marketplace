+
+    public const int RequiredDrivingHours = 56;
+
+    // Прогресс ученика: часы по занятиям с отметкой Done (в т.ч. с уже уволенными инструкторами -
+    // запрос не идёт через навигацию Instructor, поэтому её фильтр занятия не отсекает).
+    public async Task<ProgressDto?> GetProgressAsync(int studentId)
+    {
+        if (!await _db.Students.AnyAsync(s => s.Id == studentId))
+            return null;
+
+        var minutes = await _db.Lessons
+            .Where(l => l.StudentId == studentId && l.Done)
