+            .Where(l => ids.Contains(l.StudentId) && !l.Done && l.StartsAt > now)
+            .GroupBy(l => l.StudentId)
+            .Select(g => new { StudentId = g.Key, StartsAt = g.Min(l => l.StartsAt) })
+            .ToDictionaryAsync(x => x.StudentId, x => x.StartsAt);
+
+        return students
+            .Select(x => x.MaskForInstructor())
+            .Select(s => new InstructorStudentDto(s.Id, s.FullName, s.Phone, s.Email, s.PassportNo,
+                next.TryGetValue(s.Id, out var at) ? DateTime.SpecifyKind(at, DateTimeKind.Utc) : null))
+            .ToList();
