+    // Ученики инструктора в приложении: как в CSV-выгрузке (паспорт и почта скрыты) плюс ближайшее занятие.
+    // null - инструктора нет в этой автошколе или он уволен.
+    public async Task<List<InstructorStudentDto>?> ListForInstructorAsync(int instructorId)
+    {
+        if (!await _db.Instructors.AnyAsync(i => i.Id == instructorId))
+            return null;
+
+        // AsNoTracking обязателен: MaskForInstructor меняет сущность, а SaveChangesFilter сохранил бы маску в базу.
