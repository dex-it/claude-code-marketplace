@@ -0,0 +1,140 @@
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record LoginRequest(string Email);
+public record LoginConfirmRequest(string Email, string Code);
+public record LoginResult(string Token, int StudentId, DateTime ExpiresAt);
+
+// Вход в мобильное приложение ученика по одноразовому коду на e-mail.
+public class AppLoginService
+{
+    private static readonly TimeSpan CodeLifetime = TimeSpan.FromMinutes(10);
+    private static readonly TimeSpan ResendInterval = TimeSpan.FromMinutes(1);
+    private static readonly TimeSpan SessionLifetime = TimeSpan.FromDays(30);
+    private const int MaxAttempts = 5;
+
+    private readonly SchoolDbContext _db;
+    private readonly IEmailSender _email;
+
+    public AppLoginService(SchoolDbContext db, IEmailSender email)
+    {
+        _db = db;
+        _email = email;
+    }
+
+    // Ответ одинаковый независимо от того, нашёлся ли ученик, - чтобы по API нельзя было проверять, чьи адреса есть в базе.
+    public async Task RequestCodeAsync(string email)
+    {
+        var student = await FindStudentAsync(email);
+        if (student is null)
+            return;
+
+        var now = DateTime.UtcNow;
+        var resendAfter = now - ResendInterval;
+        var recent = await _db.LoginCodes.AnyAsync(c =>
+            c.StudentId == student.Id && !c.Used && c.CreatedAt > resendAfter);
+        if (recent)
+            return;
+
+        // Прежние неиспользованные коды гасим: действует только последний.
+        var old = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now)
+            .ToListAsync();
+        foreach (var c in old)
+            c.Used = true;
+
+        var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
+        _db.LoginCodes.Add(new LoginCode
+        {
+            StudentId = student.Id,
+            CodeHash = Hash($"{student.Id}:{code}"),
+            CreatedAt = now,
+            ExpiresAt = now + CodeLifetime,
+        });
+        // Код сохраняем до отправки письма, чтобы ученик не получил код, которого нет в базе.
+        await _db.SaveChangesAsync();
+
+        // Письмо - на адрес из карточки, а не на введённую строку.
+        await _email.SendAsync(student.Email, "Код входа в приложение автошколы",
+            $"Ваш код: {code}. Код действует 10 минут.");
+    }
+
+    public async Task<LoginResult?> ConfirmAsync(string email, string code)
+    {
+        var student = await FindStudentAsync(email);
+        if (student is null)
+            return null;
+
+        var now = DateTime.UtcNow;
+        var login = await _db.LoginCodes
+            .Where(c => c.StudentId == student.Id && !c.Used && c.ExpiresAt > now)
+            .OrderByDescending(c => c.CreatedAt)
+            .FirstOrDefaultAsync();
+        if (login is null || login.Attempts >= MaxAttempts)
+            return null;
+
+        var expected = Encoding.ASCII.GetBytes(login.CodeHash);
+        var actual = Encoding.ASCII.GetBytes(Hash($"{student.Id}:{code.Trim()}"));
+        if (!CryptographicOperations.FixedTimeEquals(expected, actual))
+        {
+            // Попытка сохраняется фильтром SaveChangesFilter после обработчика.
+            login.Attempts++;
+            return null;
+        }
+
+        login.Used = true;
+
+        var token = Base64UrlToken(RandomNumberGenerator.GetBytes(32));
+        var session = new AppSession
+        {
+            StudentId = student.Id,
+            TokenHash = Hash(token),
+            ExpiresAt = now + SessionLifetime,
+        };
+        _db.AppSessions.Add(session);
+        return new LoginResult(token, student.Id, session.ExpiresAt);
+    }
+
+    // Проверка токена приложения: сессия должна принадлежать именно этому ученику.
+    public async Task<bool> IsAuthorizedAsync(string? authorization, int studentId)
+    {
+        const string prefix = "Bearer ";
+        if (authorization is null || !authorization.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
+            return false;
+
+        var hash = Hash(authorization[prefix.Length..].Trim());
+        var now = DateTime.UtcNow;
+        return await _db.AppSessions.AnyAsync(s =>
+            s.TokenHash == hash && s.StudentId == studentId && s.ExpiresAt > now);
+    }
+
+    // E-mail с телефона приходит в произвольном регистре и с пробелами; в карточке он хранится как ввёл администратор.
+    private async Task<Student?> FindStudentAsync(string email)
+    {
+        var normalized = (email ?? "").Trim().ToLowerInvariant();
+        if (normalized.Length == 0)
+            return null;
+
+        var candidates = await _db.Students.AsNoTracking()
+            .Where(s => s.Email.ToLower() == normalized && s.Status != StudentStatus.Expelled)
+            .ToListAsync();
+
+        // Уникальный индекс регистрозависимый, поэтому теоретически карточек может быть несколько:
+        // тогда входим только при точном совпадении, иначе не угадываем.
+        return candidates.Count switch
+        {
+            1 => candidates[0],
+            0 => null,
+            _ => candidates.SingleOrDefault(s => s.Email == email!.Trim()),
+        };
+    }
+
+    private static string Hash(string value) =>
+        Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
+
+    private static string Base64UrlToken(byte[] bytes) =>
+        Convert.ToBase64String(bytes).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+}
