@@ -0,0 +1,41 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace AutoSchool.Cloud;
+
+public record GraduatesRow(int? InstructorId, string Instructor, bool Dismissed, int Graduates);
+
+public class ReportService
+{
+    private readonly SchoolDbContext _db;
+
+    public ReportService(SchoolDbContext db) => _db = db;
+
+    // Выпускники за год по дате выпуска, по каждому инструктору, включая уволенных.
+    public async Task<List<GraduatesRow>> GraduatesByInstructorAsync(int year)
+    {
+        var from = new DateOnly(year, 1, 1);
+        var to = from.AddYears(1);
+
+        var counts = await _db.Students.AsNoTracking()
+            .Where(s => s.Status == StudentStatus.Graduated
+                        && s.GraduatedOn >= from && s.GraduatedOn < to)
+            .GroupBy(s => s.InstructorId)
+            .Select(g => new { InstructorId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        // Фильтр Instructor скрывает уволенных, поэтому снимаем его; IgnoreQueryFilters снимает
+        // и фильтр по автошколе - его возвращаем явно.
+        var schoolId = _db.SchoolId;
+        var instructors = await _db.Instructors.AsNoTracking()
+            .IgnoreQueryFilters()
+            .Where(i => i.SchoolId == schoolId)
+            .ToDictionaryAsync(i => i.Id);
+
+        return counts
+            .Select(c => c.InstructorId is int id && instructors.TryGetValue(id, out var i)
+                ? new GraduatesRow(i.Id, i.FullName, i.IsDeleted, c.Count)
+                : new GraduatesRow(c.InstructorId, "Без инструктора", false, c.Count))
+            .OrderBy(r => r.Instructor)
+            .ToList();
+    }
+}
