+    public async Task<BankStatementUploadResult> ProcessBankStatementAsync(TextReader reader)
+    {
+        var lines = BankStatement.Parse(reader);
+        int processedCount = 0;
+        int unparsedCount = 0;
+
+        foreach (var line in lines)
+        {
+            if (await _db.Payments.AnyAsync(p => p.BankRef == line.BankRef))
+                continue;
+
+            var contractNo = PaymentPurpose.ExtractContractNo(line.Purpose);
+            var subscriber = contractNo is not null
+                ? await _db.Subscribers.FirstOrDefaultAsync(s => s.ContractNo == contractNo)
+                : null;
+
+            if (subscriber is null)
+            {
+                var existing = await _db.UnparsedStatements.AnyAsync(u => u.BankRef == line.BankRef);
+                if (!existing)
+                {
+                    _db.UnparsedStatements.Add(new UnparsedStatement
+                    {
+                        BankRef = line.BankRef,
+                        PaidOn = line.PaidOn,
+                        Amount = line.Amount,
+                        PayerName = line.PayerName,
+                        Purpose = line.Purpose,
+                        CreatedAt = DateTime.Now
+                    });
+                    unparsedCount++;
+                }
+            }
+            else
+            {
+                subscriber.Balance += line.Amount;
+
+                if (subscriber.Status == SubscriberStatus.Suspended && subscriber.Balance >= 0)
+                {
+                    subscriber.Status = SubscriberStatus.Active;
+                }
+
+                _db.Payments.Add(new Payment
+                {
+                    SubscriberId = subscriber.Id,
+                    Amount = line.Amount,
+                    BankRef = line.BankRef,
+                    PaidOn = line.PaidOn,
+                    CreditedAt = DateTime.Now,
+                    Purpose = line.Purpose
+                });
+
+                processedCount++;
+            }
+        }
+
+        await _db.SaveChangesAsync();
+        return new BankStatementUploadResult(processedCount, unparsedCount);
+    }
+
+    public async Task<List<SubscriberDto>> SearchByPhoneAsync(string phoneSuffix)
+    {
+        var subscribers = await _db.Subscribers.AsNoTracking()
+            .Where(s => s.Phone.EndsWith(phoneSuffix))
+            .Take(20)
+            .ToListAsync();
+
+        return subscribers.Select(s => new SubscriberDto(s.Id, s.FullName, s.Phone, s.Address, s.ContractNo, s.Status, s.Balance))
+            .ToList();
+    }
 }
