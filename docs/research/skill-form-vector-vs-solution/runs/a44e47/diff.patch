+namespace Shop.Data;
+
+public class CatalogMaintenanceService
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenanceService(ShopDbContext db) => _db = db;
+
+    // (a) Raise prices 10% for a whole category as a single server-side UPDATE
+    // (no entities loaded/tracked), matching every row of that category.
+    public Task<int> RaisePricesAsync(string category, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * 1.1m), ct);
+
+    // (b) Nightly cleanup of AuditLogs older than a year.
+    // ~40M of ~50M rows are due for deletion, so a single ExecuteDelete would run one huge
+    // DELETE, generating a massive amount of WAL and holding row locks for a long time.
+    // Instead we delete in small batches, each picked via an indexed subquery on At+Id
+    // (see AuditLog.At index in Model.cs) and its own short transaction.
+    public async Task<long> CleanupOldAuditLogsAsync(int batchSize = 10_000, CancellationToken ct = default)
+    {
+        // AuditLog.At is mapped as "timestamp without time zone", so the parameter must be
+        // Kind=Unspecified - Npgsql rejects a Utc DateTime for that column type.
+        var cutoff = DateTime.SpecifyKind(DateTime.UtcNow.AddYears(-1), DateTimeKind.Unspecified);
+
+        var previousTimeout = _db.Database.GetCommandTimeout();
+        _db.Database.SetCommandTimeout(TimeSpan.FromMinutes(5));
+        try
+        {
+            long totalDeleted = 0;
+            int deleted;
+            do
+            {
+                var batchIds = _db.AuditLogs
+                    .Where(a => a.At < cutoff)
+                    .OrderBy(a => a.Id)
+                    .Select(a => a.Id)
+                    .Take(batchSize);
+
+                deleted = await _db.AuditLogs
+                    .Where(a => batchIds.Contains(a.Id))
+                    .ExecuteDeleteAsync(ct);
+
+                totalDeleted += deleted;
+            } while (deleted == batchSize && !ct.IsCancellationRequested);
+
+            return totalDeleted;
+        }
+        finally
+        {
+            _db.Database.SetCommandTimeout(previousTimeout);
+        }
+    }
+
+    // (c) Load the requested products, bump Stock, save all changes in one SaveChanges call.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var addById = items
+            .GroupBy(i => i.Id)
+            .ToDictionary(g => g.Key, g => g.Sum(i => i.Add));
+        if (addById.Count == 0) return;
+
+        var ids = addById.Keys.ToList();
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToListAsync(ct);
+
+        foreach (var product in products)
+            product.Stock += addById[product.Id];
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (d) Create a new product with a freshly generated Id.
+    public async Task<Product> CreateProductAsync(
+        string sku, string category, string warehouse, decimal price, int stock, CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Category = category,
+            Warehouse = warehouse,
+            Price = price,
+            Stock = stock,
+        };
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
