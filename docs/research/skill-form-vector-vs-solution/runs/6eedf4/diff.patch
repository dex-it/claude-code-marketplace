+namespace Shop.Data;
+
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // (a) Карточка заказа: одна выборка, AsSplitQuery - у заказа две коллекции (Items, Payments),
+    // без него EF даёт декартово произведение строк.
+    public Task<Order?> GetOrderCardAsync(Guid id, CancellationToken ct = default) =>
+        _db.Orders
+            .AsNoTracking()
+            .AsSplitQuery()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .FirstOrDefaultAsync(o => o.Id == id, ct);
+
+    // (b) У клиента могут быть тысячи заказов - отдаём поток вместо List<Order>, чтобы не держать
+    // всё в памяти сразу; AsSplitQuery по той же причине, что и выше. ORDER BY обязателен для
+    // split query, иначе части результата могут не соответствовать друг другу между запросами.
+    public IAsyncEnumerable<Order> StreamOrdersByCustomerAsync(Guid customerId, CancellationToken ct = default) =>
+        _db.Orders
+            .AsNoTracking()
+            .AsSplitQuery()
+            .Where(o => o.CustomerId == customerId)
+            .OrderBy(o => o.CreatedAt).ThenBy(o => o.Id)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsAsyncEnumerable();
+
+    // (c) SKU уникален только в пределах склада. Если warehouse не передан, а один и тот же SKU
+    // лежит на нескольких складах - однозначно выбрать товар нельзя, поэтому SingleOrDefaultAsync
+    // бросит исключение при неоднозначности вместо того, чтобы молча вернуть случайную строку.
+    public Task<Product?> GetProductBySku(string sku, string? warehouse, CancellationToken ct = default)
+    {
+        var query = _db.Products.AsNoTracking().Where(p => p.Sku == sku);
+        if (!string.IsNullOrEmpty(warehouse))
+            query = query.Where(p => p.Warehouse == warehouse);
+
+        return query.SingleOrDefaultAsync(ct);
+    }
+
+    // (г) Возвращаемый тип не nullable по требованию - если у клиента нет отгруженных заказов,
+    // это исключительная ситуация, а не обычное "нет данных".
+    public async Task<DateTime> GetLastShippedAtAsync(Guid customerId, CancellationToken ct = default)
+    {
+        var shippedAt = await _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .MaxAsync(o => (DateTime?)o.ShippedAt, ct);
+
+        return shippedAt ?? throw new InvalidOperationException(
+            $"Customer {customerId} has no shipped orders.");
+    }
+}
