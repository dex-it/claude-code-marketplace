+    public async Task UnfreezeAsync(int memberId)
+    {
+        var freeze = await _db.MemberFreezes.FirstOrDefaultAsync(f => f.MemberId == memberId);
+        if (freeze is not null)
+        {
+            _db.MemberFreezes.Remove(freeze);
+            await _db.SaveChangesAsync();
+        }
+    }
+
+    public async Task<RandomSessionDto?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var weekFromNow = now.AddDays(7);
+
+        var session = await _db.Sessions
+            .AsNoTracking()
+            .Where(s => s.StartsAt >= now && s.StartsAt <= weekFromNow)
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments)
+            .OrderBy(s => EF.Functions.Random())
+            .FirstOrDefaultAsync();
+
+        if (session is null)
+            return null;
+
+        var enrolledMembers = await _db.Enrollments
+            .AsNoTracking()
+            .Where(e => e.SessionId == session.Id && e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToListAsync();
+
+        return new RandomSessionDto(
+            session.Course.Title,
+            session.Course.Trainer.FullName,
+            session.Hall.Name,
+            session.StartsAt,
+            enrolledMembers
+        );
+    }
 }
