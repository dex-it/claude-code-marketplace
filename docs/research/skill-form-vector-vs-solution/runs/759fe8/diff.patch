+
+    // Карточка последнего состоявшегося визита питомца. Питомец может быть в одном слоте у нескольких врачей
+    // (совместный приём), поэтому возвращаются все визиты последнего слота; пустой список - визитов не было.
+    public async Task<IReadOnlyList<VisitCard>> GetLastVisitCardAsync(int petId)
+    {
