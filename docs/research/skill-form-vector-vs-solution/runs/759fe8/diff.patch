+    // Выгрузка приёмов врача за период [from; to] (местные даты клиники, обе включительно) в CSV.
+    // Строки стримятся из БД в поток: до 100 тыс. приёмов не держим в памяти. Отменённые приёмы не выгружаются.
+    public async Task ExportVetVisitsCsvAsync(int vetId, DateOnly from, DateOnly to, Stream output, CancellationToken ct = default)
+    {
+        if (to < from)
+            throw new ArgumentException("Дата окончания периода раньше даты начала.", nameof(to));
+
+        var fromUtc = ClinicTime.LocalDayStartUtc(from);
+        var toUtcExclusive = ClinicTime.LocalDayStartUtc(to.AddDays(1));
+
+        var rows = db.Visits
+            .Where(v => v.VetId == vetId
+                        && v.SlotStart >= fromUtc
+                        && v.SlotStart < toUtcExclusive
+                        && v.Status != VisitStatus.Cancelled)
+            .OrderBy(v => v.SlotStart).ThenBy(v => v.Id)
+            .Select(v => new
+            {
+                v.SlotStart,
+                PetName = v.Pet.Name,
+                v.Complaint,
+                v.Diagnosis,
+                PrescriptionCount = v.Prescriptions.Count
+            })
+            .AsAsyncEnumerable()
+            .WithCancellation(ct);
+
+        // BOM - чтобы Excel бухгалтерии открыл кириллицу без мастера импорта
+        await using var writer = new StreamWriter(output, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true),
+            bufferSize: 64 * 1024, leaveOpen: true);
+
+        await writer.WriteLineAsync(string.Join(CsvSeparator, "Дата и время приёма", "Кличка", "Жалоба", "Диагноз", "Назначений"));
+
+        await foreach (var r in rows)
+        {
+            var line = new StringBuilder(256)
+                .Append(ClinicTime.ToLocal(r.SlotStart).ToString("yyyy-MM-dd HH:mm")).Append(CsvSeparator)
+                .Append(Csv(r.PetName)).Append(CsvSeparator)
+                .Append(Csv(r.Complaint)).Append(CsvSeparator)
+                .Append(Csv(r.Diagnosis)).Append(CsvSeparator)
+                .Append(r.PrescriptionCount);
+            await writer.WriteLineAsync(line, ct);
+        }
+
+        await writer.FlushAsync();
+    }
+
+    private static string Csv(string? value)
+    {
+        if (string.IsNullOrEmpty(value))
+            return "";
+
+        return value.IndexOfAny([CsvSeparator, '"', '\r', '\n']) >= 0
+            ? "\"" + value.Replace("\"", "\"\"") + "\""
+            : value;
+    }
 }
