@@ -13,6 +13,29 @@ builder.Services.AddScoped<VisitJournalService>();
 
 var app = builder.Build();
 
-app.MapGet("/journal/search", (string q, int page, VisitJournalService s) => s.SearchAsync(q, page));
+// scope: complaint | diagnosis | drug (по умолчанию complaint)
+app.MapGet("/journal/search", async (string q, int page, string? scope, VisitJournalService s) =>
+    SearchScopes.TryParse(scope, out var parsed)
+        ? Results.Ok(await s.SearchAsync(q, page, parsed))
+        : Results.BadRequest("scope: complaint | diagnosis | drug"));
+
+app.MapGet("/pets/{petId:int}/last-visit", async (int petId, VisitJournalService s) =>
+{
+    var cards = await s.GetLastVisitCardAsync(petId);
+    return cards.Count == 0 ? Results.NotFound() : Results.Ok(cards);
+});
+
+// from, to - местные даты клиники (yyyy-MM-dd), обе включительно
+app.MapGet("/vets/{vetId:int}/visits/export", async (int vetId, DateOnly from, DateOnly to,
+    HttpResponse response, VisitJournalService s, CancellationToken ct) =>
+{
+    if (to < from)
+        return Results.BadRequest("to раньше from");
+
+    response.ContentType = "text/csv; charset=utf-8";
+    response.Headers.ContentDisposition = $"attachment; filename=\"visits-vet{vetId}-{from:yyyyMMdd}-{to:yyyyMMdd}.csv\"";
+    await s.ExportVetVisitsCsvAsync(vetId, from, to, response.Body, ct);
+    return Results.Empty;
+});
 
 app.Run();
