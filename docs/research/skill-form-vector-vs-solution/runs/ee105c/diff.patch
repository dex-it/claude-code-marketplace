+using Microsoft.EntityFrameworkCore;
+
+namespace Shop;
+
+public class CustomerNotifier
+{
+    private readonly ShopDbContext _context;
+    private readonly IEmailSender _emailSender;
+
+    public CustomerNotifier(ShopDbContext context, IEmailSender emailSender)
+    {
+        _context = context;
+        _emailSender = emailSender;
+    }
+
+    public async Task NotifyCustomers(IEnumerable<Guid> customerIds, string text)
+    {
+        var idsList = customerIds.ToList();
+
+        var customers = await _context.Customers
+            .Where(c => idsList.Contains(c.Id))
+            .Select(c => new { c.Email })
+            .ToListAsync();
+
+        var tasks = customers.Select(c =>
+            _emailSender.SendAsync(c.Email, "Notification", text)
+        );
+
+        await Task.WhenAll(tasks);
+    }
+}
