+    public async Task ClearItems(Guid orderId)
+    {
+        var order = await _db.Orders.Include(o => o.Items).FirstOrDefaultAsync(o => o.Id == orderId);
+        if (order is null) return;
+        // Items - required FK + Cascade, поэтому удаление из уже загруженной коллекции
+        // помечает OrderItem на удаление без отдельного DbSet<OrderItem>.
+        order.Items.Clear();
