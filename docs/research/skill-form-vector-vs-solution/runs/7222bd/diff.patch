+++ b/Model.cs
@@ -11,7 +11,8 @@ public class Order
     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
-    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
+    public int Complexity { get; set; }              // 1..5, "сложность комплектации"
+    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone, always UTC in code
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
     public List<OrderItem> Items { get; set; } = new();
@@ -44,7 +45,39 @@ public class ShopDbContext : DbContext
     protected override void OnModelCreating(ModelBuilder b)
     {
         b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+
+        b.Entity<Order>()
+            .Property(o => o.Complexity)
+            .IsRequired();
+        b.Entity<Order>()
+            .ToTable(t => t.HasCheckConstraint("CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Column stays "timestamp without time zone" (DBA reports depend on it). Npgsql refuses to
+        // write Kind=Utc into that column type, so we round-trip via Unspecified on write and
+        // re-tag as Utc on read, keeping the in-memory value always UTC.
+        b.Entity<Order>()
+            .Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                toDb => DateTime.SpecifyKind(toDb.ToUniversalTime(), DateTimeKind.Unspecified),
+                fromDb => DateTime.SpecifyKind(fromDb, DateTimeKind.Utc));
+
+        // Order is soft-deleted (IsDeleted flag), so the DB-level FK must NOT cascade
+        // physically: a raw "DELETE FROM orders" (e.g. DBA script) would otherwise wipe
+        // out Items/Payments too. ClientCascade keeps app-driven deletes working (EF
+        // still removes children when they're taken out of the collection, e.g.
+        // ClearItems below) while the database constraint itself is NO ACTION.
+        b.Entity<Order>()
+            .HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .OnDelete(DeleteBehavior.ClientCascade);
+
+        b.Entity<Order>()
+            .HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .OnDelete(DeleteBehavior.ClientCascade);
     }
 }
