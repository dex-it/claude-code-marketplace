@@ -46,10 +46,70 @@ public class ClinicCardService(ClinicDbContext db)
         await db.SaveChangesAsync();
     }
 
-    public async Task UpdateVisitNotesAsync(int visitId, string? notes)
+    // Форма присылает полный список аллергий питомца: текущий набор заменяется целиком.
+    public async Task ReplaceAllergiesAsync(int petId, IReadOnlyList<AllergyInput> allergies)
+    {
+        var pet = await db.Pets.Include(p => p.Allergies).SingleAsync(p => p.Id == petId);
+        var now = DateTime.UtcNow;
+
+        foreach (var existing in pet.Allergies)
+        {
+            existing.IsDeleted = true;
+            existing.DeletedAt = now;
+        }
+
+        foreach (var input in allergies)
+        {
+            pet.Allergies.Add(new Allergy
+            {
+                Allergen = input.Allergen.Trim(),
+                Reaction = input.Reaction,
+                Severity = input.Severity
+            });
+        }
+
+        await db.SaveChangesAsync();
+    }
+
+    public async Task UpdateVisitAnamnesisAsync(int visitId, string? anamnesis)
     {
         var visit = await db.Visits.SingleAsync(v => v.Id == visitId);
-        visit.Notes = notes;
+        visit.Anamnesis = anamnesis;
+        await db.SaveChangesAsync();
+    }
+
+    // Удаление клиента по просьбе: клиент, его питомцы и их визиты перестают
+    // появляться где-либо (списки, карточки, расписание врачей) — soft delete каскадом.
+    public async Task DeleteOwnerAsync(int ownerId)
+    {
+        var owner = await db.Owners
+            .Include(o => o.Pets).ThenInclude(p => p.Allergies)
+            .Include(o => o.Pets).ThenInclude(p => p.Visits)
+            .SingleAsync(o => o.Id == ownerId);
+
+        var now = DateTime.UtcNow;
+
+        owner.IsDeleted = true;
+        owner.DeletedAt = now;
+
+        foreach (var pet in owner.Pets)
+        {
+            pet.IsDeleted = true;
+            pet.DeletedAt = now;
+
+            foreach (var allergy in pet.Allergies)
+            {
+                allergy.IsDeleted = true;
+                allergy.DeletedAt = now;
+            }
+
+            foreach (var visit in pet.Visits)
+            {
+                visit.IsDeleted = true;
+                visit.DeletedAt = now;
+            }
+        }
+
         await db.SaveChangesAsync();
     }
 }
