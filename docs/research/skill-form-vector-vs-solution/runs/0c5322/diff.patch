     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    // Read-only projection for report pages: active orders with Customer/Items loaded, no tracking.
+    public Task<List<Order>> GetActiveOrdersWithDetailsAsync() =>
+        _db.Orders
+            .Where(o => o.Status == "active")
+            .Include(o => o.Customer)
+            .Include(o => o.Items)
+            .AsNoTracking()
+            .ToListAsync();
 }
