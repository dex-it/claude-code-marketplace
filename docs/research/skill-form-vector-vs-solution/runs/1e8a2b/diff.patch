diff --git a/ReportService.cs b/ReportService.cs
new file mode 100644
index 0000000..1cc7109
--- /dev/null
+++ b/ReportService.cs
@@ -0,0 +1,155 @@
+using System.Globalization;
+using System.Text;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+
+namespace BookQuarter.Library;
+
+public record OverdueLoanDto(int LoanId, string CardNumber, string ReaderName, string Phone,
+    string Title, string Author, DateOnly DueDate, int OverdueDays);
+
+public record BranchLoansDto(int BranchId, string BranchName, int Loans);
+
+public class ReportService
+{
+    private const string DebtorsExportTarget = "debtors.csv";
+
+    private readonly LibraryDbContext _db;
+    private readonly decimal _finePerDay;
+
+    public ReportService(LibraryDbContext db, IOptions<FineOptions> fines)
+    {
+        _db = db;
+        _finePerDay = fines.Value.PerDay;
+    }
+
+    // Loan.IsOverdue/OverdueDays — вычисляемые свойства, EF их в SQL не транслирует,
+    // поэтому условие просрочки записано через DueDate, а дни считаются после загрузки.
+    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);
+
+    // (а) Просроченные выдачи филиала для обзвона. Телефон полный — он нужен для звонка.
+    public async Task<IReadOnlyList<OverdueLoanDto>?> GetBranchOverdueAsync(int branchId)
+    {
+        if (!await _db.Branches.AnyAsync(b => b.Id == branchId))
+            return null;
+
+        var today = Today;
+        var rows = await _db.Loans
+            .AsNoTracking()
+            .Where(l => l.BranchId == branchId && l.ReturnedAt == null && l.DueDate < today)
+            .OrderBy(l => l.DueDate)        // самый ранний срок = больше всего дней просрочки
+            .ThenBy(l => l.Id)
+            .Select(l => new
+            {
+                l.Id,
+                l.Reader.CardNumber,
+                l.Reader.FullName,
+                l.Reader.Phone,
+                l.Book.Title,
+                l.Book.Author,
+                l.DueDate,
+            })
+            .ToListAsync();
+
+        return rows
+            .Select(r => new OverdueLoanDto(r.Id, r.CardNumber, r.FullName, r.Phone,
+                r.Title, r.Author, r.DueDate, today.DayNumber - r.DueDate.DayNumber))
+            .ToList();
+    }
+
+    // (б) CSV по должникам всей сети для коллекторского агентства + запись в ExportLog.
+    // Должник — читатель с хотя бы одной невозвращённой просроченной выдачей;
+    // сумма — штраф за текущую просрочку по всем таким выдачам (FineBalance за уже
+    // возвращённые книги сюда не входит).
+    public async Task<byte[]> ExportDebtorsCsvAsync(string exportedBy)
+    {
+        var today = Today;
+        var loans = await _db.Loans
+            .AsNoTracking()
+            .Where(l => l.ReturnedAt == null && l.DueDate < today)
+            .Select(l => new
+            {
+                l.ReaderId,
+                l.Reader.FullName,
+                l.Reader.CardNumber,
+                l.Reader.Phone,
+                l.Reader.Email,
+                l.DueDate,
+            })
+            .ToListAsync();
+
+        var debtors = loans
+            .GroupBy(l => l.ReaderId)
+            .Select(g =>
+            {
+                var r = g.First();
+                var days = g.Sum(l => today.DayNumber - l.DueDate.DayNumber);
+                return new
+                {
+                    r.FullName,
+                    r.CardNumber,
+                    // Маскируем строки проекции, а не сущность Reader: так маска
+                    // гарантированно не уйдёт в БД при SaveChanges ниже.
+                    Phone = ReaderExtensions.MaskPhone(r.Phone),
+                    Email = ReaderExtensions.MaskEmail(r.Email),
+                    Fine = days * _finePerDay,
+                };
+            })
+            .OrderBy(d => d.FullName, StringComparer.Create(new CultureInfo("ru-RU"), false))
+            .ThenBy(d => d.CardNumber, StringComparer.Ordinal)
+            .ToList();
+
+        var sb = new StringBuilder();
+        sb.AppendLine("ФИО;Номер билета;Телефон;E-mail;Штраф");
+        foreach (var d in debtors)
+        {
+            sb.Append(Csv(d.FullName)).Append(';')
+              .Append(Csv(d.CardNumber)).Append(';')
+              .Append(Csv(d.Phone)).Append(';')
+              .Append(Csv(d.Email ?? "")).Append(';')
+              .Append(d.Fine.ToString("0.00", CultureInfo.InvariantCulture))
+              .AppendLine();
+        }
+
+        _db.ExportLogs.Add(new ExportLog
+        {
+            Target = DebtorsExportTarget,
+            ExportedBy = exportedBy,
+            ExportedAt = DateTime.UtcNow,
+            Rows = debtors.Count,
+        });
+        await _db.SaveChangesAsync();
+
+        // UTF-8 с BOM, чтобы Excel корректно открыл кириллицу.
+        return Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
+    }
+
+    // (в) Число выдач по филиалам за период [from; to] включительно (даты в UTC,
+    // как и IssuedAt). Филиалы без выдач тоже попадают в отчёт с нулём.
+    public async Task<IReadOnlyList<BranchLoansDto>> GetLoansByBranchAsync(DateOnly from, DateOnly to)
+    {
+        var fromUtc = DateTime.SpecifyKind(from.ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
+        // Полуинтервал до начала следующего дня: выдачи 30.09 в 18:45 тоже входят.
+        var toUtcExclusive = DateTime.SpecifyKind(to.AddDays(1).ToDateTime(TimeOnly.MinValue), DateTimeKind.Utc);
+
+        return await _db.Branches
+            .AsNoTracking()
+            .OrderBy(b => b.Name)
+            .Select(b => new BranchLoansDto(
+                b.Id,
+                b.Name,
+                _db.Loans.Count(l => l.BranchId == b.Id && l.IssuedAt >= fromUtc && l.IssuedAt < toUtcExclusive)))
+            .ToListAsync();
+    }
+
+    // Экранирование поля CSV + защита от CSV/formula injection при открытии в Excel.
+    private static string Csv(string value)
+    {
+        if (value.Length > 0 && "=+-@\t\r".Contains(value[0]))
+            value = "'" + value;
+
+        return value.IndexOfAny(new[] { ';', '"', '\n', '\r' }) >= 0
+            ? "\"" + value.Replace("\"", "\"\"") + "\""
+            : value;
+    }
+}
