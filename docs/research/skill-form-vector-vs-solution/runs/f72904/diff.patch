+    public async Task UpdatePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items)
+            .SingleAsync(p => p.HouseId == houseId);
+
+        var incomingCodes = items.Select(i => i.WorkCode).ToHashSet();
+        var existingItems = plan.Items.ToDictionary(i => i.WorkCode);
+
+        var itemsToRemove = plan.Items.Where(i => !incomingCodes.Contains(i.WorkCode)).ToList();
+        foreach (var item in itemsToRemove)
+        {
+            _db.PlanItems.Remove(item);
+        }
+
+        foreach (var input in items)
+        {
+            if (existingItems.TryGetValue(input.WorkCode, out var existing))
+            {
+                existing.Title = input.Title;
+                existing.PeriodDays = input.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = input.WorkCode,
+                    Title = input.Title,
+                    PeriodDays = input.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
