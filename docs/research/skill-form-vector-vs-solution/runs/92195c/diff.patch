+    public async Task UnfreezeAsync(int memberId)
+    {
+        var member = await _db.Members.FindAsync(memberId)
+            ?? throw new KeyNotFoundException("Клиент не найден");
+        member.FrozenUntil = null;
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<object?> GetRandomSessionAsync()
+    {
+        var now = DateTime.UtcNow;
+        var endDate = now.AddDays(7);
+
+        var sessions = await _db.Sessions
+            .AsNoTracking()
+            .Include(s => s.Course).ThenInclude(c => c.Trainer)
+            .Include(s => s.Hall)
+            .Include(s => s.Enrollments).ThenInclude(e => e.Member)
+            .Where(s => s.Course.Status == CourseStatus.Published && s.StartsAt >= now && s.StartsAt < endDate)
+            .ToListAsync();
+
+        if (sessions.Count == 0)
+            return null;
+
+        var random = new Random();
+        var session = sessions[random.Next(sessions.Count)];
+
+        var memberNames = session.Enrollments
+            .Where(e => e.Status != EnrollmentStatus.Cancelled)
+            .Select(e => e.Member.FullName)
+            .ToList();
+
+        return new { SessionId = session.Id, Course = session.Course.Title, Trainer = session.Course.Trainer.FullName, Hall = session.Hall.Name, StartsAt = session.StartsAt, Members = memberNames };
+    }
 }
