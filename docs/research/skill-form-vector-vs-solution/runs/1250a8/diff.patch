+            .Include(l => l.Reader)
+            .Include(l => l.Book)
+            .OrderByDescending(l => Fines.Amount(l.DueDate, today, l.Reader.Category, _rules))
+            .ToDebtorRows(today, _rules)
+            .ToListAsync();
+
+        var totalFines = debtors.Sum(d => d.Fine);
+
+        return new DebtorsResponse { Debtors = debtors, TotalFines = totalFines };
