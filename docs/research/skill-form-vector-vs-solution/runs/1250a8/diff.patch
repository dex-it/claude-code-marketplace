+    public async Task<List<LoansByBranchReport>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var branches = await _db.Branches.ToListAsync();
+
+        var results = new List<LoansByBranchReport>();
+
+        foreach (var branch in branches)
+        {
+            var tz = TimeZoneInfo.FindSystemTimeZoneById(branch.TimeZoneId);
+            var localFrom = TimeZoneInfo.ConvertTime(from, tz);
+            var localTo = TimeZoneInfo.ConvertTime(to, tz);
+
+            var count = await _db.Loans.CountAsync(l =>
+                l.BranchId == branch.Id &&
+                l.IssuedAt >= localFrom &&
+                l.IssuedAt < localTo);
+
+            results.Add(new LoansByBranchReport { BranchId = branch.Id, BranchName = branch.Name, LoanCount = count });
+        }
+
+        return results;
+    }
