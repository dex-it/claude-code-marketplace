+using Microsoft.AspNetCore.Mvc;
+using Notify.Api.Services;
+
+namespace Notify.Api.Controllers;
+
+[ApiController]
+[Route("reports")]
+public sealed class ReportsController : ControllerBase
+{
+    private readonly IKeyedServiceProvider _serviceProvider;
+    public ReportsController(IKeyedServiceProvider serviceProvider) => _serviceProvider = serviceProvider;
+
+    [HttpPost("{id:guid}/send")]
+    public async Task<IActionResult> SendReport(Guid id, [FromQuery] string email, CancellationToken ct)
+    {
+        var sender = _serviceProvider.GetRequiredKeyedService<INotificationSender>("email");
+        await sender.SendAsync(email, $"Отчёт {id}", ct);
+        return NoContent();
+    }
+}
