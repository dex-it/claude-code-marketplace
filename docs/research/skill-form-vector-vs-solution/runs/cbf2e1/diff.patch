+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // Bulk update in a single UPDATE statement — avoids loading the whole category into memory.
+    public Task<int> RaisePricesAsync(string category, decimal percent = 0.10m, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * (1 + percent)), ct);
+
+    // Deletes AuditLogs older than maxAge in small batches instead of one DELETE, since ~40M of ~50M
+    // rows are expected to match: a single statement would hold a long transaction/lock and bloat WAL.
+    // Requires an index on AuditLogs.At to avoid a full scan per batch; each batch commits independently
+    // so a restart (e.g. next nightly run) resumes safely without redoing already-deleted rows.
+    public async Task<long> CleanupOldAuditLogsAsync(
+        TimeSpan? maxAge = null,
+        int batchSize = 5000,
+        TimeSpan? delayBetweenBatches = null,
+        CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow - (maxAge ?? TimeSpan.FromDays(365));
+        var delay = delayBetweenBatches ?? TimeSpan.FromMilliseconds(200);
+        long totalDeleted = 0;
+
+        while (true)
+        {
+            ct.ThrowIfCancellationRequested();
+
+            var deleted = await _db.Database.ExecuteSqlInterpolatedAsync($@"
+                DELETE FROM ""AuditLogs""
+                WHERE ""Id"" IN (
+                    SELECT ""Id"" FROM ""AuditLogs""
+                    WHERE ""At"" < {cutoff}
+                    ORDER BY ""Id""
+                    LIMIT {batchSize}
+                )", ct);
+
+            totalDeleted += deleted;
+            if (deleted < batchSize)
+                break;
+
+            await Task.Delay(delay, ct);
+        }
+
+        return totalDeleted;
+    }
+
+    // Loads the requested products in one query and increments Stock; unknown ids are ignored.
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> updates, CancellationToken ct = default)
+    {
+        var list = updates as ICollection<(Guid Id, int Add)> ?? updates.ToList();
+        var ids = list.Select(u => u.Id).ToList();
+
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToDictionaryAsync(p => p.Id, ct);
+
+        foreach (var (id, add) in list)
+            if (products.TryGetValue(id, out var product))
+                product.Stock += add;
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    public async Task<Product> CreateProductAsync(
+        string sku,
+        string warehouse,
+        string category,
+        decimal price,
+        int stock = 0,
+        CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Warehouse = warehouse,
+            Category = category,
+            Price = price,
+            Stock = stock
+        };
+
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
