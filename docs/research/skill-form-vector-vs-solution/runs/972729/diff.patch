+using Microsoft.AspNetCore.Mvc;
+
+namespace Domovoy.Housing;
+
+[ApiController]
+[Route("api/[controller]")]
+public class RequestsController : ControllerBase
+{
+    private readonly HousingService _service;
+
+    public RequestsController(HousingService service) => _service = service;
+
+    [HttpPost("{id}/close")]
+    public async Task<IActionResult> CloseRequest(int id, [FromBody] CloseRequestInput input)
+    {
+        try
+        {
+            await _service.CloseRequestAsync(id, input.Comment);
+            return NoContent();
+        }
+        catch (InvalidOperationException)
+        {
+            return Conflict("Заявка не в статусе InProgress");
+        }
+        catch (KeyNotFoundException)
+        {
+            return NotFound();
+        }
+    }
+}
+
+[ApiController]
+[Route("api/[controller]")]
+public class HousesController : ControllerBase
+{
+    private readonly PlanService _service;
+
+    public HousesController(PlanService service) => _service = service;
+
+    [HttpPut("{id}/plan")]
+    public async Task<IActionResult> UpdatePlan(int id, [FromBody] List<PlanService.PlanItemInput> items)
+    {
+        try
+        {
+            await _service.UpdatePlanAsync(id, items);
+            return NoContent();
+        }
+        catch (KeyNotFoundException)
+        {
+            return NotFound();
+        }
+    }
+}
+
+public record CloseRequestInput(string Comment);
