+    // Инженер присылает план дома целиком: план становится таким, как присланный список работ.
+    // Работы, которые остаются в плане (совпадают по WorkCode), сохраняют свою историю выполнения;
+    // работы, которых больше нет в списке, удаляются из плана вместе со своей историей.
+    public async Task ReplacePlanAsync(int houseId, List<PlanItemInput> items)
+    {
+        if (!await _db.Houses.AnyAsync(h => h.Id == houseId))
+            throw new KeyNotFoundException($"Дом {houseId} не найден");
+
+        var incoming = items.ToDictionary(i => i.WorkCode);
+
+        var plan = await _db.MaintenancePlans
+            .Include(p => p.Items).ThenInclude(i => i.Completions)
+            .FirstOrDefaultAsync(p => p.HouseId == houseId);
+
+        if (plan is null)
+        {
+            plan = new MaintenancePlan { HouseId = houseId };
+            _db.MaintenancePlans.Add(plan);
+        }
+
+        foreach (var existing in plan.Items.ToList())
+        {
+            if (incoming.ContainsKey(existing.WorkCode))
+                continue;
+
+            plan.Items.Remove(existing);
+            _db.PlanItemCompletions.RemoveRange(existing.Completions);
+            _db.PlanItems.Remove(existing);
+        }
+
+        foreach (var item in items)
+        {
+            var existing = plan.Items.FirstOrDefault(i => i.WorkCode == item.WorkCode);
+            if (existing is not null)
+            {
+                existing.Title = item.Title;
+                existing.PeriodDays = item.PeriodDays;
+            }
+            else
+            {
+                plan.Items.Add(new PlanItem
+                {
+                    WorkCode = item.WorkCode,
+                    Title = item.Title,
+                    PeriodDays = item.PeriodDays,
+                });
+            }
+        }
+
+        await _db.SaveChangesAsync();
+    }
