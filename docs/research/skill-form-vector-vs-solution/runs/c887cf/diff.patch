+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+
+namespace Domovoy.Housing;
+
+// Минимальные API, которые используют HousingService/PlanService.
+// Вызвать app.MapHousingEndpoints() при настройке Program.cs (файл не входит в этот срез проекта).
+public static class Endpoints
+{
+    public static IEndpointRouteBuilder MapHousingEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/requests", async (
+            HousingService service,
+            string? text, RequestStatus? status, int? houseId, string? district,
+            string? sort, string? dir, int page = 1, int pageSize = 50) =>
+        {
+            if (!TryParseSort(sort, out var sortField))
+                return Results.BadRequest($"Недопустимое значение sort: '{sort}'. Ожидается date|address|status.");
+
+            if (!TryParseDir(dir, out var sortDir))
+                return Results.BadRequest($"Недопустимое значение dir: '{dir}'. Ожидается asc|desc.");
+
+            var rows = await service.SearchAsync(
+                new RequestSearch(text, status, houseId, district, sortField, sortDir, page, pageSize));
+            return Results.Ok(rows);
+        });
+
+        app.MapGet("/requests/{id:int}", async (HousingService service, int id) =>
+        {
+            var card = await service.GetRequestAsync(id);
+            return card is null ? Results.NotFound() : Results.Ok(card);
+        });
+
+        app.MapPost("/requests", async (HousingService service, NewRequest body) =>
+        {
+            var id = await service.CreateRequestAsync(body);
+            return Results.Created($"/requests/{id}", new { id });
+        });
+
+        // Мастер закрывает заявку: статус Done + обязательный комментарий о работах.
+        // 409, если заявка не в статусе InProgress.
+        app.MapPost("/requests/{id:int}/close", async (HousingService service, int id, CloseRequestBody body) =>
+        {
+            try
+            {
+                await service.CloseRequestAsync(id, body.Comment);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+            catch (RequestConflictException ex)
+            {
+                return Results.Conflict(ex.Message);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        app.MapGet("/houses/{id:int}/plan", async (PlanService service, int id) =>
+            Results.Ok(await service.GetPlanAsync(id)));
+
+        // Инженер присылает план дома целиком - план дома становится таким, как присланный список.
+        app.MapPut("/houses/{id:int}/plan", async (PlanService service, int id, List<PlanItemInput> items) =>
+        {
+            try
+            {
+                await service.ReplacePlanAsync(id, items);
+                return Results.NoContent();
+            }
+            catch (KeyNotFoundException ex)
+            {
+                return Results.NotFound(ex.Message);
+            }
+            catch (ArgumentException ex)
+            {
+                return Results.BadRequest(ex.Message);
+            }
+        });
+
+        return app;
+    }
+
+    private static bool TryParseSort(string? value, out RequestSortField field)
+    {
+        switch (value?.Trim().ToLowerInvariant())
+        {
+            case null or "":
+            case "date":
+                field = RequestSortField.Date;
+                return true;
+            case "address":
+                field = RequestSortField.Address;
+                return true;
+            case "status":
+                field = RequestSortField.Status;
+                return true;
+            default:
+                field = default;
+                return false;
+        }
+    }
+
+    private static bool TryParseDir(string? value, out SortDirection? dir)
+    {
+        switch (value?.Trim().ToLowerInvariant())
+        {
+            case null or "":
+                dir = null;
+                return true;
+            case "asc":
+                dir = SortDirection.Asc;
+                return true;
+            case "desc":
+                dir = SortDirection.Desc;
+                return true;
+            default:
+                dir = null;
+                return false;
+        }
+    }
+}
+
+public record CloseRequestBody(string Comment);
