+namespace Shop.Data;
+
+public class CatalogMaintenance
+{
+    private readonly ShopDbContext _db;
+    public CatalogMaintenance(ShopDbContext db) => _db = db;
+
+    // (a) +10% цены всем продуктам категории — один UPDATE в БД, без загрузки entities
+    public Task<int> RaisePricesAsync(string category, CancellationToken ct = default) =>
+        _db.Products
+            .Where(p => p.Category == category)
+            .ExecuteUpdateAsync(s => s.SetProperty(p => p.Price, p => p.Price * 1.1m), ct);
+
+    // (б) очистка AuditLogs старше года батчами — таблица ~50 млн строк, ~40 млн под удаление,
+    // один ExecuteDeleteAsync на всё разом держит транзакцию часами и раздувает WAL
+    public async Task<int> CleanupOldAuditLogsAsync(int batchSize = 1000, CancellationToken ct = default)
+    {
+        var cutoff = DateTime.UtcNow.AddYears(-1);
+        var totalDeleted = 0;
+        int deleted;
+        do
+        {
+            deleted = await _db.AuditLogs
+                .Where(a => a.At < cutoff)
+                .OrderBy(a => a.Id)
+                .Take(batchSize)
+                .ExecuteDeleteAsync(ct);
+            totalDeleted += deleted;
+            if (deleted > 0)
+                await Task.Delay(TimeSpan.FromMilliseconds(200), ct);
+        } while (deleted > 0);
+
+        return totalDeleted;
+    }
+
+    // (в) точечные приросты Stock — значения разные для каждого продукта, поэтому не ExecuteUpdate,
+    // а одна загрузка нужных id + один SaveChanges (не цикл SaveChanges на каждый продукт)
+    public async Task RestockAsync(IEnumerable<(Guid Id, int Add)> items, CancellationToken ct = default)
+    {
+        var list = items as IReadOnlyCollection<(Guid Id, int Add)> ?? items.ToList();
+        if (list.Count == 0) return;
+
+        var ids = list.Select(i => i.Id).Distinct().ToList();
+        var products = await _db.Products
+            .Where(p => ids.Contains(p.Id))
+            .ToDictionaryAsync(p => p.Id, ct);
+
+        foreach (var (id, add) in list)
+        {
+            if (products.TryGetValue(id, out var product))
+                product.Stock += add;
+        }
+
+        await _db.SaveChangesAsync(ct);
+    }
+
+    // (г) создание продукта с новым Guid
+    public async Task<Product> CreateProductAsync(
+        string sku, string warehouse, string category, decimal price, int stock = 0, CancellationToken ct = default)
+    {
+        var product = new Product
+        {
+            Id = Guid.NewGuid(),
+            Sku = sku,
+            Warehouse = warehouse,
+            Category = category,
+            Price = price,
+            Stock = stock
+        };
+        _db.Products.Add(product);
+        await _db.SaveChangesAsync(ct);
+        return product;
+    }
+}
