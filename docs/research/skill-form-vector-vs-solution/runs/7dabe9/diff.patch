--- /dev/null
+++ b/ReportService.cs
@@ -0,0 +1,41 @@
+using Microsoft.EntityFrameworkCore;
+
+namespace BookQuarter.Library;
+
+public sealed record LoansByBranchRequest(DateTimeOffset From, DateTimeOffset To);
+
+public sealed class BranchLoanCount
+{
+    public int BranchId { get; init; }
+    public string BranchName { get; init; } = "";
+    public int LoanCount { get; init; }
+}
+
+public class ReportService
+{
+    private readonly LibraryDbContext _db;
+
+    public ReportService(LibraryDbContext db) => _db = db;
+
+    // Число выдач по каждому филиалу за период; from/to приходят в своём часовом поясе,
+    // но DateTimeOffset сравнивается по единому моменту времени, так что пояс филиала тут не нужен.
+    public async Task<List<BranchLoanCount>> GetLoansByBranchAsync(DateTimeOffset from, DateTimeOffset to)
+    {
+        var counts = await _db.Loans
+            .Where(l => l.IssuedAt >= from && l.IssuedAt < to)
+            .GroupBy(l => l.BranchId)
+            .Select(g => new { BranchId = g.Key, Count = g.Count() })
+            .ToListAsync();
+
+        var countByBranch = counts.ToDictionary(x => x.BranchId, x => x.Count);
+
+        var branches = await _db.Branches.OrderBy(b => b.Name).ToListAsync();
+
+        return branches.Select(b => new BranchLoanCount
+        {
+            BranchId = b.Id,
+            BranchName = b.Name,
+            LoanCount = countByBranch.GetValueOrDefault(b.Id),
+        }).ToList();
+    }
+}
