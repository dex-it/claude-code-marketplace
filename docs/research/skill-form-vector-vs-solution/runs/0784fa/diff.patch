@@ -11,7 +11,8 @@ public class Order
     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
-    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
+    public int Complexity { get; set; }               // 1..5, сложность комплектации заказа
+    public DateTime CreatedAt { get; set; }           // column: timestamp without time zone, всегда UTC в коде
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
     public List<OrderItem> Items { get; set; } = new();
@@ -43,8 +44,32 @@ public class ShopDbContext : DbContext
     public DbSet<AuditLog> AuditLogs => Set<AuditLog>();
     protected override void OnModelCreating(ModelBuilder b)
     {
-        b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+        var order = b.Entity<Order>();
+
+        order.HasQueryFilter(o => !o.IsDeleted);
+
+        order.Property(o => o.Complexity).IsRequired();
+        order.ToTable(t => t.HasCheckConstraint("CK_Order_Complexity_Range", "\"Complexity\" BETWEEN 1 AND 5"));
+
+        // Колонка остаётся "timestamp without time zone" (нужна DBA-отчётам), но Npgsql 6+
+        // пишет/читает такие колонки только со значениями DateTimeKind.Unspecified.
+        // Конвертер прячет Kind при записи и восстанавливает Utc при чтении,
+        // так что в коде CreatedAt всегда DateTimeKind.Utc.
+        order.Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                toProvider => DateTime.SpecifyKind(toProvider, DateTimeKind.Unspecified),
+                fromProvider => DateTime.SpecifyKind(fromProvider, DateTimeKind.Utc));
+
+        order.HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .OnDelete(DeleteBehavior.Cascade);
+
+        order.HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .OnDelete(DeleteBehavior.Cascade);
     }
 }
