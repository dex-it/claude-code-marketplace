     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    // Composable, untracked queries for read-only reporting; callers project/materialize as needed.
+    public IQueryable<Order> QueryActive() =>
+        _db.Orders.AsNoTracking().Where(o => o.Status == "active");
+
+    // Mirrors Order.IsOverdue(now); kept inline so the condition translates to SQL.
+    public IQueryable<Order> QueryOverdue(DateTime now) =>
+        _db.Orders.AsNoTracking().Where(o => o.ShippedAt == null && o.CreatedAt.AddDays(3) < now);
 }
