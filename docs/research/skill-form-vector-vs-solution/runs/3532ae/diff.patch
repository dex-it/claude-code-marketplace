+namespace Shop.Data;
+
+public record OrderReportItem(Guid Id, string CustomerName, decimal Total, int ItemCount);
+
+// Read-only reporting over orders; all queries are AsNoTracking via OrderRepository.
+public class OrderReportService
+{
+    private readonly OrderRepository _orders;
+    public OrderReportService(OrderRepository orders) => _orders = orders;
+
+    public Task<List<OrderReportItem>> GetActiveOrdersAsync() =>
+        _orders.QueryActive()
+            .Select(o => new OrderReportItem(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+
+    public Task<Dictionary<string, int>> GetActiveOrderCountsByCategoryAsync() =>
+        _orders.QueryActive()
+            .GroupBy(o => o.Category)
+            .Select(g => new { Category = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.Category, x => x.Count);
+
+    public Task<List<OrderReportItem>> GetOverdueOrdersAsync(DateTime now) =>
+        _orders.QueryOverdue(now)
+            .Select(o => new OrderReportItem(o.Id, o.Customer.Name, o.Total, o.Items.Count))
+            .ToListAsync();
+}
