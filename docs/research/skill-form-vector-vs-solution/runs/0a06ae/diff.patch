+namespace Shop.Data;
+
+public enum ProductLookupStatus { Found, NotFound, Ambiguous }
+
+// Ambiguous: sku есть на нескольких складах, а склад не передан - вызывающий уточняет склад из Warehouses.
+public sealed record ProductLookupResult(ProductLookupStatus Status, Product? Product, IReadOnlyList<string> Warehouses)
+{
+    public static ProductLookupResult Found(Product p) => new(ProductLookupStatus.Found, p, new[] { p.Warehouse });
+    public static ProductLookupResult NotFound() => new(ProductLookupStatus.NotFound, null, Array.Empty<string>());
+    public static ProductLookupResult Ambiguous(IReadOnlyList<string> warehouses) => new(ProductLookupStatus.Ambiguous, null, warehouses);
+}
+
+// Только чтение: все выборки без трекинга. Регистрировать Scoped, как и ShopDbContext.
+public class OrderQueries
+{
+    private readonly ShopDbContext _db;
+    public OrderQueries(ShopDbContext db) => _db = db;
+
+    // Две коллекции одного уровня - split query, чтобы не получить декартово произведение Items x Payments.
+    public Task<Order?> GetOrderCardAsync(Guid orderId, CancellationToken ct = default) =>
+        _db.Orders
+            .AsNoTracking()
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .SingleOrDefaultAsync(o => o.Id == orderId, ct);
+
+    // Тысячи заказов x позиции x платежи: split query (3 запроса вместо одного взрывного JOIN), без трекинга.
+    public Task<List<Order>> GetCustomerOrdersAsync(Guid customerId, CancellationToken ct = default) =>
+        _db.Orders
+            .AsNoTracking()
+            .Where(o => o.CustomerId == customerId)
+            .OrderBy(o => o.CreatedAt).ThenBy(o => o.Id)
+            .Include(o => o.Items)
+            .Include(o => o.Payments)
+            .AsSplitQuery()
+            .ToListAsync(ct);
+
+    // (Sku, Warehouse) уникален, Sku сам по себе - нет. Без склада несколько совпадений не выбираются молча.
+    public async Task<ProductLookupResult> GetProductBySku(string sku, string? warehouse, CancellationToken ct = default)
+    {
+        if (warehouse is not null)
+        {
+            var product = await _db.Products
+                .AsNoTracking()
+                .SingleOrDefaultAsync(p => p.Sku == sku && p.Warehouse == warehouse, ct);
+            return product is null ? ProductLookupResult.NotFound() : ProductLookupResult.Found(product);
+        }
+
+        var matches = await _db.Products
+            .AsNoTracking()
+            .Where(p => p.Sku == sku)
+            .ToListAsync(ct);
+
+        return matches.Count switch
+        {
+            0 => ProductLookupResult.NotFound(),
+            1 => ProductLookupResult.Found(matches[0]),
+            _ => ProductLookupResult.Ambiguous(matches.Select(p => p.Warehouse).OrderBy(w => w).ToList()),
+        };
+    }
+
+    // ShippedAt без явного типа -> timestamptz, читается с Kind=Utc.
+    // Агрегат считается в БД; Max по nullable на пустой выборке даёт null, а не исключение.
+    public async Task<DateTime> GetLastShippedAtAsync(Guid customerId, CancellationToken ct = default)
+    {
+        var last = await _db.Orders
+            .Where(o => o.CustomerId == customerId && o.ShippedAt != null)
+            .MaxAsync(o => o.ShippedAt, ct);
+
+        return last ?? throw new InvalidOperationException($"Customer {customerId} has no shipped orders.");
+    }
+}
