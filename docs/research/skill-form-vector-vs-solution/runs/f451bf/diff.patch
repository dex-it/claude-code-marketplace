@@ -6,4 +6,17 @@ public class OrderRepository
     public OrderRepository(ShopDbContext db) => _db = db;
     public Task<List<Order>> GetAllAsync() => _db.Orders.ToListAsync();
     public Task<Order?> GetAsync(Guid id) => _db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+
+    // Удаляет все позиции заказа. Мягко удалённый заказ отсекается query filter'ом -> KeyNotFoundException.
+    public async Task ClearItems(Guid orderId)
+    {
+        var order = await _db.Orders
+            .Include(o => o.Items)
+            .FirstOrDefaultAsync(o => o.Id == orderId)
+            ?? throw new KeyNotFoundException($"Order {orderId} not found");
+
+        // Связь обязательная + Cascade: отсоединённые позиции EF удаляет как сирот.
+        order.Items.Clear();
+        await _db.SaveChangesAsync();
+    }
 }
