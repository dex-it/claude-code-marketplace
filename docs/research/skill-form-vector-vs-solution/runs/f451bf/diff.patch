 // Shop.Data - EF Core 8, PostgreSQL (Npgsql.EntityFrameworkCore.PostgreSQL 8)
 namespace Shop.Data;
 
-public class Customer { public Guid Id { get; set; } public string Name { get; set; } = ""; public List<Order> Orders { get; set; } = new(); }
+// UseLazyLoadingProxies требует, чтобы все навигации были virtual
+public class Customer { public Guid Id { get; set; } public string Name { get; set; } = ""; public virtual List<Order> Orders { get; set; } = new(); }
 
 public class Order
 {
+    public const int MinComplexity = 1, MaxComplexity = 5;
+
     public Guid Id { get; set; }
     public Guid CustomerId { get; set; }
     public virtual Customer Customer { get; set; } = null!;
     public string Status { get; set; } = "active";
     public string Category { get; set; } = "";
     public decimal Total { get; set; }
-    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone
+    public DateTime CreatedAt { get; set; }          // column: timestamp without time zone, значение всегда UTC
     public DateTime? ShippedAt { get; set; }
     public bool IsDeleted { get; set; }
-    public List<OrderItem> Items { get; set; } = new();
-    public List<Payment> Payments { get; set; } = new();
+
+    private int _complexity = MinComplexity;
+    // Сложность комплектации, 1..5
+    public int Complexity
+    {
+        get => _complexity;
+        set => _complexity = value is >= MinComplexity and <= MaxComplexity
+            ? value
+            : throw new ArgumentOutOfRangeException(nameof(Complexity), value, $"Complexity must be {MinComplexity}..{MaxComplexity}");
+    }
+
+    public virtual List<OrderItem> Items { get; set; } = new();
+    public virtual List<Payment> Payments { get; set; } = new();
     public bool IsOverdue(DateTime now) => ShippedAt == null && CreatedAt.AddDays(3) < now;
 }
 
@@ -43,8 +57,37 @@ public class ShopDbContext : DbContext
     public DbSet<AuditLog> AuditLogs => Set<AuditLog>();
     protected override void OnModelCreating(ModelBuilder b)
     {
-        b.Entity<Order>().HasQueryFilter(o => !o.IsDeleted);
-        b.Entity<Order>().Property(o => o.CreatedAt).HasColumnType("timestamp without time zone");
+        var order = b.Entity<Order>();
+        order.HasQueryFilter(o => !o.IsDeleted);
+
+        // Колонка остаётся timestamp without time zone, но в ней хранится UTC.
+        // Npgsql 6+ не даёт писать DateTime с Kind=Utc в "without time zone", поэтому
+        // на запись приводим к UTC и снимаем Kind, на чтении помечаем как Utc.
+        order.Property(o => o.CreatedAt)
+            .HasColumnType("timestamp without time zone")
+            .HasConversion(
+                v => DateTime.SpecifyKind(v.Kind == DateTimeKind.Local ? v.ToUniversalTime() : v, DateTimeKind.Unspecified),
+                v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+
+        order.Property(o => o.Complexity)
+            .HasDefaultValue(Order.MinComplexity); // для уже существующих строк при миграции
+        order.ToTable(t => t.HasCheckConstraint("CK_Orders_Complexity",
+            $"\"Complexity\" BETWEEN {Order.MinComplexity} AND {Order.MaxComplexity}"));
+
+        // Удаление заказов мягкое (IsDeleted), физический DELETE заказа не ожидается.
+        // Позиции - часть заказа: каскад и удаление "сирот" (нужно для ClearItems).
+        order.HasMany(o => o.Items)
+            .WithOne()
+            .HasForeignKey(i => i.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Cascade);
+
+        // Платежи - финансовые записи: никогда не удаляем каскадом.
+        order.HasMany(o => o.Payments)
+            .WithOne()
+            .HasForeignKey(p => p.OrderId)
+            .IsRequired()
+            .OnDelete(DeleteBehavior.Restrict);
     }
 }
