+import { afterEach, beforeEach, describe, expect, it, vi, type MockInstance } from 'vitest';
+import { inventory, TemporaryInventoryError } from '../src/clients/inventory.js';
+import type { OrderItem } from '../src/domain/order.js';
+import { logger } from '../src/logger.js';
+import {
+  holdUntil,
+  isHoldExpired,
+  ReservationFailedError,
+  reserveWithRetry,
+} from '../src/services/reservation.js';
+
+const items: OrderItem[] = [{ productId: 'p-1', title: 'Кружка', quantity: 2, priceKopecks: 50000 }];
+
+describe('reserveWithRetry', () => {
+  let reserve: MockInstance<typeof inventory.reserve>;
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    reserve = vi.spyOn(inventory, 'reserve');
+    vi.spyOn(logger, 'warn').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.restoreAllMocks();
+  });
+
+  it('резервирует с первой попытки', async () => {
+    reserve.mockResolvedValueOnce({ reservationId: 'r-1' });
+
+    const result = await reserveWithRetry('o-1', items);
+
+    expect(result).toEqual({ reservationId: 'r-1', attempts: 1 });
+  });
+
+  it('повторяет после временного сбоя склада и завершается успехом', async () => {
+    reserve
+      .mockRejectedValueOnce(new TemporaryInventoryError('503'))
+      .mockRejectedValueOnce(new TemporaryInventoryError('503'))
+      .mockResolvedValueOnce({ reservationId: 'r-2' });
+
+    const promise = reserveWithRetry('o-2', items);
+    await vi.runAllTimersAsync();
+
+    expect(await promise).toEqual({ reservationId: 'r-2', attempts: 3 });
+  });
+
+  it('бросает ReservationFailedError, когда попытки исчерпаны', async () => {
+    reserve.mockRejectedValue(new TemporaryInventoryError('503'));
+
+    const promise = reserveWithRetry('o-3', items);
+    const assertion = expect(promise).rejects.toMatchObject({
+      name: 'ReservationFailedError',
+      orderId: 'o-3',
+      attempts: 3,
+    });
+    await vi.runAllTimersAsync();
+    await assertion;
+    await expect(promise).rejects.toBeInstanceOf(ReservationFailedError);
+    expect(reserve).toHaveBeenCalledTimes(3);
+  });
+
+  it('не повторяет при ошибке склада, не являющейся временной', async () => {
+    const failure = new Error('inventory responded with 400');
+    reserve.mockRejectedValue(failure);
+
+    await expect(reserveWithRetry('o-4', items)).rejects.toBe(failure);
+    expect(reserve).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe('holdUntil / isHoldExpired', () => {
+  it('удержание заканчивается через 15 минут', () => {
+    expect(holdUntil(1_000)).toBe(1_000 + 15 * 60 * 1000);
+  });
+
+  it('удержание не истекло до и в момент границы', () => {
+    expect(isHoldExpired(10_000, 9_999)).toBe(false);
+    expect(isHoldExpired(10_000, 10_000)).toBe(false);
+  });
+
+  it('удержание истекло после границы', () => {
+    expect(isHoldExpired(10_000, 10_001)).toBe(true);
+  });
+
+  it('по умолчанию сравнивает с текущим временем', () => {
+    vi.useFakeTimers();
+    try {
+      vi.setSystemTime(5_000);
+      expect(isHoldExpired(4_000)).toBe(true);
+      expect(isHoldExpired(6_000)).toBe(false);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
