+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { delivery, DeliveryUnavailableError } from '../src/clients/delivery.js';
+import type { OrderItem } from '../src/domain/order.js';
+import { logger } from '../src/logger.js';
+import { MAX_ATTEMPTS_PER_CUSTOMER, quoteOrder, registerAttempt } from '../src/services/checkout.js';
+
+const items: OrderItem[] = [
+  { productId: 'p1', title: 'Кружка', quantity: 2, priceKopecks: 60_000 },
+  { productId: 'p2', title: 'Блокнот', quantity: 1, priceKopecks: 30_000 },
+];
+const SUBTOTAL = 150_000;
+const FLAT_DELIVERY = 29_900;
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+function mockDelivery(price = 20_000) {
+  return vi.spyOn(delivery, 'quote').mockResolvedValue({ priceKopecks: price, days: 3 });
+}
+
+describe('quoteOrder', () => {
+  it('складывает позиции и доставку без промокода', async () => {
+    const quote = mockDelivery();
+    const warn = vi.spyOn(logger, 'warn').mockImplementation(() => {});
+
+    const result = await quoteOrder(items, { city: 'Москва' });
+
+    expect(result).toEqual({
+      subtotalKopecks: SUBTOTAL,
+      discountKopecks: 0,
+      deliveryKopecks: 20_000,
+      totalKopecks: SUBTOTAL + 20_000,
+      promoApplied: false,
+      deliveryEstimated: false,
+    });
+    expect(quote).toHaveBeenCalledWith('Москва', 3 * 500);
+    expect(warn).not.toHaveBeenCalled();
+  });
+
+  it('вычитает скидку промокода из суммы позиций', async () => {
+    mockDelivery();
+    const warn = vi.spyOn(logger, 'warn').mockImplementation(() => {});
+
+    const result = await quoteOrder(items, { city: 'Москва', promoCode: 'welcome10' });
+
+    expect(result.promoApplied).toBe(true);
+    expect(result.discountKopecks).toBe(15_000);
+    expect(result.totalKopecks).toBe(SUBTOTAL - 15_000 + 20_000);
+    expect(warn).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    ['неизвестный промокод', 'NOSUCH'],
+    ['не хватает суммы', 'FLAT500'],
+  ])('промокод не подошёл (%s): скидки нет, есть предупреждение', async (_name, promoCode) => {
+    mockDelivery();
+    const warn = vi.spyOn(logger, 'warn').mockImplementation(() => {});
+
+    const result = await quoteOrder(items, { city: 'Москва', promoCode });
+
+    expect(result.promoApplied).toBe(false);
+    expect(result.discountKopecks).toBe(0);
+    expect(result.totalKopecks).toBe(SUBTOTAL + 20_000);
+    expect(warn).toHaveBeenCalledTimes(1);
+    expect(warn.mock.calls[0]![0]).toContain(promoCode);
+  });
+
+  it('при недоступной службе доставки берёт фиксированный тариф и помечает ответ оценочным', async () => {
+    vi.spyOn(delivery, 'quote').mockRejectedValue(new DeliveryUnavailableError('down'));
+    const warn = vi.spyOn(logger, 'warn').mockImplementation(() => {});
+
+    const result = await quoteOrder(items, { city: 'Казань' });
+
+    expect(result.deliveryKopecks).toBe(FLAT_DELIVERY);
+    expect(result.deliveryEstimated).toBe(true);
+    expect(result.totalKopecks).toBe(SUBTOTAL + FLAT_DELIVERY);
+    expect(warn).toHaveBeenCalledTimes(1);
+  });
+
+  it('пробрасывает остальные ошибки службы доставки без подмены', async () => {
+    const error = new Error('delivery responded with 500');
+    vi.spyOn(delivery, 'quote').mockRejectedValue(error);
+
+    await expect(quoteOrder(items, { city: 'Москва' })).rejects.toBe(error);
+  });
+});
+
+describe('registerAttempt', () => {
+  it('разрешает три попытки и отказывает после третьей', () => {
+    const id = 'customer-limit';
+    const results = Array.from({ length: MAX_ATTEMPTS_PER_CUSTOMER + 1 }, () => registerAttempt(id));
+
+    expect(results).toEqual([
+      { allowed: true, remaining: 2 },
+      { allowed: true, remaining: 1 },
+      { allowed: true, remaining: 0 },
+      { allowed: false, remaining: 0 },
+    ]);
+  });
+
+  it('считает попытки покупателей независимо', () => {
+    for (let i = 0; i < MAX_ATTEMPTS_PER_CUSTOMER + 1; i++) registerAttempt('customer-a');
+
+    expect(registerAttempt('customer-b')).toEqual({ allowed: true, remaining: 2 });
+  });
+});
