+import { describe, expect, it } from 'vitest';
+import { formatKopecks, splitEvenly } from '../src/services/price-format.js';
+
+const NBSP = ' ';
+
+describe('formatKopecks', () => {
+  it('форматирует целые рубли с нулевыми копейками', () => {
+    expect(formatKopecks(500)).toBe(`5,00${NBSP}₽`);
+  });
+
+  it('форматирует рубли с копейками', () => {
+    expect(formatKopecks(1250)).toBe(`12,50${NBSP}₽`);
+  });
+
+  it('дополняет копейки нулём слева', () => {
+    expect(formatKopecks(1205)).toBe(`12,05${NBSP}₽`);
+    expect(formatKopecks(7)).toBe(`0,07${NBSP}₽`);
+  });
+
+  it('разделяет тысячи неразрывным пробелом', () => {
+    expect(formatKopecks(123456789)).toBe(`1${NBSP}234${NBSP}567,89${NBSP}₽`);
+    expect(formatKopecks(100000)).toBe(`1${NBSP}000,00${NBSP}₽`);
+  });
+
+  it('форматирует ноль', () => {
+    expect(formatKopecks(0)).toBe(`0,00${NBSP}₽`);
+  });
+
+  it('ставит минус перед отрицательной суммой', () => {
+    expect(formatKopecks(-123450)).toBe(`-1${NBSP}234,50${NBSP}₽`);
+  });
+});
+
+describe('splitEvenly', () => {
+  it('делит ровно, когда остатка нет', () => {
+    expect(splitEvenly(900, 3)).toEqual([300, 300, 300]);
+  });
+
+  it('отдаёт остаток по копейке первым частям', () => {
+    expect(splitEvenly(1000, 3)).toEqual([334, 333, 333]);
+    expect(splitEvenly(1001, 3)).toEqual([334, 334, 333]);
+  });
+
+  it('сумма частей равна исходной сумме', () => {
+    const parts = splitEvenly(99999, 7);
+    expect(parts.reduce((a, b) => a + b, 0)).toBe(99999);
+  });
+
+  it('возвращает одну часть целиком при parts = 1', () => {
+    expect(splitEvenly(12345, 1)).toEqual([12345]);
+  });
+
+  it('раздаёт по копейке, когда частей больше суммы', () => {
+    expect(splitEvenly(2, 4)).toEqual([1, 1, 0, 0]);
+  });
+
+  it.each([0, -1, 1.5, NaN, Infinity])('бросает RangeError при parts = %s', (parts) => {
+    expect(() => splitEvenly(1000, parts)).toThrow(RangeError);
+  });
+});
