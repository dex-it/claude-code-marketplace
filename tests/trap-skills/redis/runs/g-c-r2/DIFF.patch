index 0000000..2a479ba
--- /dev/null
+++ b/src/Fulfil/Jobs/StockRecalculationService.cs
@@ -0,0 +1,135 @@
+using System.Diagnostics;
+using Fulfil.Ports;
+using StackExchange.Redis;
+
+namespace Fulfil.Jobs;
+
+// Раз в минуту запускает пересчёт остатков под распределённым локом: одновременно - одна реплика.
+// Лок с TTL продлевается в ходе работы; если продлить не удалось, пересчёт отменяется. Но между
+// потерей лока и отменой возможна запись «зависшей» репликой, поэтому каждому проходу выдаётся
+// возрастающий fencing-токен: запись в MongoDB обязана отвергать токен меньше уже виденного.
+public sealed class StockRecalculationService(
+    IConnectionMultiplexer redis, IStockRecalculator recalculator, ILogger<StockRecalculationService> log)
+    : BackgroundService
+{
+    private const string LockKey = "lock:stock-recalc";
+    private const string FenceKey = "fence:stock-recalc";
+    private static readonly TimeSpan Interval = TimeSpan.FromMinutes(1);
+    private static readonly TimeSpan LockTtl = TimeSpan.FromSeconds(30);
+    private static readonly TimeSpan RenewEvery = TimeSpan.FromSeconds(10);
+
+    private const string RenewScript = """
+        if redis.call('GET', KEYS[1]) == ARGV[1] then
+          return redis.call('PEXPIRE', KEYS[1], ARGV[2])
+        end
+        return 0
+        """;
+
+    private const string ReleaseScript = """
+        if redis.call('GET', KEYS[1]) == ARGV[1] then
+          return redis.call('DEL', KEYS[1])
+        end
+        return 0
+        """;
+
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        using var timer = new PeriodicTimer(Interval);
+        try
+        {
+            do
+            {
+                try
+                {
+                    await RunOnceAsync(ct);
+                }
+                catch (Exception ex) when (ex is not OperationCanceledException)
+                {
+                    log.LogError(ex, "Пересчёт остатков завершился ошибкой");
+                }
+            }
+            while (await timer.WaitForNextTickAsync(ct));
+        }
+        catch (OperationCanceledException)
+        {
+        }
+    }
+
+    private async Task RunOnceAsync(CancellationToken ct)
+    {
+        var db = redis.GetDatabase();
+        var token = Guid.NewGuid().ToString("N");
+
+        long fence;
+        try
+        {
+            if (!await db.StringSetAsync(LockKey, token, LockTtl, When.NotExists))
+                return;
+            fence = await db.StringIncrementAsync(FenceKey);
+        }
+        catch (RedisException ex)
+        {
+            // Без Redis лок взять нельзя - пропускаем проход, а не запускаем без защиты.
+            log.LogWarning(ex, "Redis недоступен, пересчёт остатков пропущен");
+            return;
+        }
+
+        using var lost = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        var renewer = RenewLoopAsync(db, token, lost);
+        try
+        {
+            await recalculator.RecalculateAsync(fence, lost.Token);
+        }
+        finally
+        {
+            await lost.CancelAsync();
+            await renewer;
+            try
+            {
+                await db.ScriptEvaluateAsync(ReleaseScript, new RedisKey[] { LockKey }, new RedisValue[] { token });
+            }
+            catch (RedisException ex)
+            {
+                log.LogWarning(ex, "Не удалось освободить лок, он истечёт по TTL");
+            }
+        }
+    }
+
+    private async Task RenewLoopAsync(IDatabase db, string token, CancellationTokenSource lost)
+    {
+        var sinceRenewed = Stopwatch.StartNew();
+        try
+        {
+            while (true)
+            {
+                await Task.Delay(RenewEvery, lost.Token);
+                try
+                {
+                    var renewed = (long)await db.ScriptEvaluateAsync(RenewScript,
+                        new RedisKey[] { LockKey },
+                        new RedisValue[] { token, (long)LockTtl.TotalMilliseconds }) == 1;
+                    if (!renewed)
+                    {
+                        log.LogError("Лок пересчёта остатков потерян, проход отменяется");
+                        await lost.CancelAsync();
+                        return;
+                    }
+                    sinceRenewed.Restart();
+                }
+                catch (RedisException ex)
+                {
+                    log.LogWarning(ex, "Не удалось продлить лок");
+                    // Ещё немного - и лок истечёт, считаем его потерянным заранее.
+                    if (sinceRenewed.Elapsed >= LockTtl - RenewEvery)
+                    {
+                        await lost.CancelAsync();
+                        return;
+                    }
+                }
+            }
+        }
+        catch (OperationCanceledException)
+        {
+        }
+    }
+}
