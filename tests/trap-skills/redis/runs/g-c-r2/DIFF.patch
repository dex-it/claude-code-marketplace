+++ b/src/Fulfil/Redis/RateLimiter.cs
@@ -0,0 +1,74 @@
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+// Скользящее окно (журнал в sorted set): в любом интервале длиной окно не больше limit запросов,
+// всплеска на границе фиксированных окон нет. Время берётся с сервера Redis.
+public sealed class RateLimiter(IConnectionMultiplexer redis)
+{
+    private const string Script = """
+        local t = redis.call('TIME')
+        local now = tonumber(t[1]) * 1000 + math.floor(tonumber(t[2]) / 1000)
+        local window = tonumber(ARGV[1])
+        local limit = tonumber(ARGV[2])
+        redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', now - window)
+        if redis.call('ZCARD', KEYS[1]) < limit then
+          redis.call('ZADD', KEYS[1], now, ARGV[3])
+          redis.call('PEXPIRE', KEYS[1], window)
+          return 0
+        end
+        local oldest = redis.call('ZRANGE', KEYS[1], 0, 0, 'WITHSCORES')
+        return math.max(1, tonumber(oldest[2]) + window - now)
+        """;
+
+    // Возвращает null, если запрос разрешён, иначе - через сколько миллисекунд повторить.
+    public async Task<long?> TryAcquireAsync(string clientKey, int limit, TimeSpan window)
+    {
+        var result = (long)await redis.GetDatabase().ScriptEvaluateAsync(Script,
+            new RedisKey[] { $"ratelimit:{clientKey}" },
+            new RedisValue[] { (long)window.TotalMilliseconds, limit, Guid.NewGuid().ToString("N") });
+        return result == 0 ? null : result;
+    }
+}
+
+public sealed class ApiRateLimitMiddleware(RequestDelegate next, RateLimiter limiter, ILogger<ApiRateLimitMiddleware> log)
+{
+    private const int Limit = 100;
+    private static readonly TimeSpan Window = TimeSpan.FromMinutes(1);
+
+    public async Task InvokeAsync(HttpContext ctx)
+    {
+        if (!ctx.Request.Path.StartsWithSegments("/api"))
+        {
+            await next(ctx);
+            return;
+        }
+
+        var key = ctx.Request.Headers["X-Api-Key"].ToString();
+        if (key.Length is 0 or > 128)
+        {
+            ctx.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+
+        long? retryAfterMs = null;
+        try
+        {
+            retryAfterMs = await limiter.TryAcquireAsync(key, Limit, Window);
+        }
+        catch (RedisException ex)
+        {
+            // Недоступность Redis не должна останавливать публичный API.
+            log.LogWarning(ex, "Redis недоступен, лимит запросов не применён");
+        }
+
+        if (retryAfterMs is { } ms)
+        {
+            ctx.Response.StatusCode = StatusCodes.Status429TooManyRequests;
+            ctx.Response.Headers.RetryAfter = ((ms + 999) / 1000).ToString();
+            return;
+        }
+
+        await next(ctx);
+    }
+}
