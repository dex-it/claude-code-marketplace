@@ -0,0 +1,33 @@
+using Fulfil.Ports;
+using Fulfil.Redis;
+using StackExchange.Redis;
+
+namespace Fulfil.Jobs;
+
+// Раз в минуту каждая реплика пытается взять блокировку; пересчёт выполняет только владелец.
+// Если аренда потеряна, проход отменяется; запись в MongoDB обязана проверять fencing-токен.
+public sealed class StockRecalcJob(IConnectionMultiplexer redis, IStockRecalculator recalculator, ILogger<StockRecalcJob> log)
+    : BackgroundService
+{
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
+        do
+        {
+            try
+            {
+                await using var l = await RedisLock.TryAcquireAsync(redis, "stock-recalc");
+                if (l is null) continue;
+
+                using var cts = CancellationTokenSource.CreateLinkedTokenSource(stoppingToken, l.LostToken);
+                await recalculator.RunAsync(l.FencingToken, cts.Token);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested) { }
+            catch (Exception ex)
+            {
+                log.LogError(ex, "Пересчёт остатков завершился ошибкой");
+            }
+        }
+        while (await timer.WaitForNextTickAsync(stoppingToken));
+    }
+}
