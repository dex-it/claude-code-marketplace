+using Fulfil.Contracts;
+using Fulfil.Ports;
+using MassTransit;
+
+namespace Fulfil.Mail;
+
+// Очередь писем - RabbitMQ через MassTransit (ADR-0001), а не Redis: задание подтверждается
+// только после отправки, поэтому перезапуск воркера при деплое его не теряет.
+public sealed class SendEmailConsumer(IEmailSender sender) : IConsumer<SendEmail>
+{
+    public Task Consume(ConsumeContext<SendEmail> context) =>
+        sender.SendAsync(context.Message.To, context.Message.Subject, context.Message.Body, context.CancellationToken);
+}
