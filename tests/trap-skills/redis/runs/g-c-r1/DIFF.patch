index 0000000..720caf6
--- /dev/null
+++ b/src/Fulfil/RateLimiting/ApiRateLimitMiddleware.cs
@@ -0,0 +1,61 @@
+using System.Security.Cryptography;
+using System.Text;
+using StackExchange.Redis;
+
+namespace Fulfil.RateLimiting;
+
+// Скользящее окно (журнал в sorted set): не больше Limit запросов за любые Window,
+// без всплеска на границе фиксированных окон. Время берётся из Redis (TIME), а не от реплик.
+// Отклонённые запросы окно не занимают. При сбое Redis запросы пропускаются (fail-open).
+public sealed class ApiRateLimitMiddleware(RequestDelegate next, IConnectionMultiplexer redis, ILogger<ApiRateLimitMiddleware> logger)
+{
+    private const int Limit = 100;
+    private static readonly TimeSpan Window = TimeSpan.FromMinutes(1);
+
+    private const string Script = """
+        local t = redis.call('TIME')
+        local now = tonumber(t[1]) * 1000 + math.floor(tonumber(t[2]) / 1000)
+        local window = tonumber(ARGV[1])
+        redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', now - window)
+        if redis.call('ZCARD', KEYS[1]) >= tonumber(ARGV[2]) then
+            local oldest = redis.call('ZRANGE', KEYS[1], 0, 0, 'WITHSCORES')
+            return {0, tonumber(oldest[2]) + window - now}
+        end
+        redis.call('ZADD', KEYS[1], now, ARGV[3])
+        redis.call('PEXPIRE', KEYS[1], window)
+        return {1, 0}
+        """;
+
+    public async Task InvokeAsync(HttpContext context)
+    {
+        var apiKey = context.Request.Headers["X-Api-Key"].ToString();
+        if (string.IsNullOrEmpty(apiKey))
+        {
+            context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+
+        var key = "ratelimit:" + Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(apiKey)));
+        try
+        {
+            var result = (RedisResult[])(await redis.GetDatabase().ScriptEvaluateAsync(
+                Script,
+                [(RedisKey)key],
+                [(long)Window.TotalMilliseconds, Limit, Guid.NewGuid().ToString("N")]))!;
+
+            if ((long)result[0] == 0)
+            {
+                var retryAfter = Math.Max(1, (long)Math.Ceiling((long)result[1] / 1000.0));
+                context.Response.Headers.RetryAfter = retryAfter.ToString();
+                context.Response.StatusCode = StatusCodes.Status429TooManyRequests;
+                return;
+            }
+        }
+        catch (RedisException ex)
+        {
+            logger.LogWarning(ex, "Redis недоступен, ограничение запросов пропущено");
+        }
+
+        await next(context);
+    }
+}
diff --git a/src/Fulfil/Redis/RedisLock.cs b/src/Fulfil/Redis/RedisLock.cs
new file mode 100644
index 0000000..8a9308a
--- /dev/null
+++ b/src/Fulfil/Redis/RedisLock.cs
@@ -0,0 +1,115 @@
+using System.Diagnostics;
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+// Распределённый лок с продлением и токеном ограждения.
+// Лок может быть потерян до конца работы (пауза процесса, сбой Redis, сетевой разрыв), поэтому:
+//  - пока лок держится, он продлевается; при потере срабатывает LostToken;
+//  - каждое получение лока выдаёт монотонный FencingToken: запись в общий ресурс обязана
+//    отвергаться, если ресурс уже видел больший токен.
+public sealed class RedisLock(IConnectionMultiplexer redis, string key, string fenceKey)
+{
+    private const string AcquireScript = """
+        if redis.call('SET', KEYS[1], ARGV[1], 'NX', 'PX', ARGV[2]) then
+            return redis.call('INCR', KEYS[2])
+        end
+        return 0
+        """;
+
+    private const string RenewScript = """
+        if redis.call('GET', KEYS[1]) == ARGV[1] then
+            return redis.call('PEXPIRE', KEYS[1], ARGV[2])
+        end
+        return 0
+        """;
+
+    private const string ReleaseScript = """
+        if redis.call('GET', KEYS[1]) == ARGV[1] then
+            return redis.call('DEL', KEYS[1])
+        end
+        return 0
+        """;
+
+    public async Task<Handle?> TryAcquireAsync(TimeSpan ttl, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        var db = redis.GetDatabase();
+        var token = Guid.NewGuid().ToString("N");
+        var fence = (long)await db.ScriptEvaluateAsync(AcquireScript, [(RedisKey)key, fenceKey], [token, (long)ttl.TotalMilliseconds]);
+        return fence == 0 ? null : new Handle(db, key, token, ttl, fence);
+    }
+
+    public sealed class Handle : IAsyncDisposable
+    {
+        private readonly IDatabase _db;
+        private readonly string _key;
+        private readonly string _token;
+        private readonly CancellationTokenSource _lost = new();
+        private readonly CancellationTokenSource _stop = new();
+        private readonly Task _renewal;
+
+        public long FencingToken { get; }
+        public CancellationToken LostToken => _lost.Token;
+
+        internal Handle(IDatabase db, string key, string token, TimeSpan ttl, long fence)
+        {
+            _db = db;
+            _key = key;
+            _token = token;
+            FencingToken = fence;
+            _renewal = RenewLoopAsync(ttl);
+        }
+
+        private async Task RenewLoopAsync(TimeSpan ttl)
+        {
+            var lastOk = Stopwatch.StartNew();
+            var interval = ttl / 3;
+            try
+            {
+                while (true)
+                {
+                    await Task.Delay(interval, _stop.Token);
+                    try
+                    {
+                        var renewed = (long)await _db.ScriptEvaluateAsync(RenewScript, [(RedisKey)_key], [_token, (long)ttl.TotalMilliseconds]);
+                        if (renewed == 0)
+                        {
+                            _lost.Cancel();
+                            return;
+                        }
+                        lastOk.Restart();
+                    }
+                    catch (RedisException)
+                    {
+                        // Если продлить не удаётся почти столько, сколько живёт лок, считаем его потерянным.
+                        if (lastOk.Elapsed >= ttl * 0.8)
+                        {
+                            _lost.Cancel();
+                            return;
+                        }
+                    }
+                }
+            }
+            catch (OperationCanceledException)
+            {
+            }
+        }
+
+        public async ValueTask DisposeAsync()
+        {
+            _stop.Cancel();
+            await _renewal;
+            try
+            {
+                await _db.ScriptEvaluateAsync(ReleaseScript, [(RedisKey)_key], [_token]);
+            }
+            catch (RedisException)
+            {
+                // Лок истечёт по TTL.
+            }
+            _stop.Dispose();
+            _lost.Dispose();
+        }
+    }
+}
