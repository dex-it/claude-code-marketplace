diff --git a/src/Fulfil/Prices/PriceCache.cs b/src/Fulfil/Prices/PriceCache.cs
new file mode 100644
index 0000000..6e08036
--- /dev/null
+++ b/src/Fulfil/Prices/PriceCache.cs
@@ -0,0 +1,116 @@
+using System.Collections.Concurrent;
+using System.Globalization;
+using Fulfil.Ports;
+using StackExchange.Redis;
+
+namespace Fulfil.Prices;
+
+// Кэш цен (cache-aside) в Redis.
+// - Конкурентные промахи одного sku в реплике схлопываются в один запрос к источнику.
+// - Инвалидация увеличивает версию sku; запись в кэш принимается, только если версия не изменилась
+//   с момента начала чтения. Так запоздавший ответ источника не затирает свежую инвалидацию.
+// - Сбой Redis не ломает чтение: цена берётся из источника.
+public sealed class PriceCache(IConnectionMultiplexer redis, IPriceSource source, ILogger<PriceCache> logger)
+{
+    private static readonly TimeSpan Ttl = TimeSpan.FromMinutes(5);
+    private static readonly TimeSpan VersionTtl = TimeSpan.FromHours(1);
+    private static readonly TimeSpan SourceTimeout = TimeSpan.FromSeconds(5);
+
+    private const string SetIfVersionScript = """
+        local v = redis.call('GET', KEYS[2])
+        if not v then v = '0' end
+        if v == ARGV[1] then
+            redis.call('SET', KEYS[1], ARGV[2], 'PX', ARGV[3])
+            return 1
+        end
+        return 0
+        """;
+
+    private const string InvalidateScript = """
+        redis.call('INCR', KEYS[2])
+        redis.call('PEXPIRE', KEYS[2], ARGV[1])
+        redis.call('DEL', KEYS[1])
+        return 1
+        """;
+
+    private readonly ConcurrentDictionary<string, Lazy<Task<decimal>>> _inflight = new();
+
+    private static RedisKey PriceKey(string sku) => $"price:{sku}";
+    private static RedisKey VersionKey(string sku) => $"price:ver:{sku}";
+
+    public async Task<decimal> GetAsync(string sku, CancellationToken ct)
+    {
+        var db = redis.GetDatabase();
+        try
+        {
+            var cached = await db.StringGetAsync(PriceKey(sku));
+            if (cached.HasValue && decimal.TryParse((string?)cached, NumberStyles.Number, CultureInfo.InvariantCulture, out var price))
+                return price;
+        }
+        catch (RedisException ex)
+        {
+            logger.LogWarning(ex, "Redis недоступен при чтении цены, читаем из источника");
+        }
+
+        var lazy = _inflight.GetOrAdd(sku, s => new Lazy<Task<decimal>>(() => LoadAsync(s)));
+        try
+        {
+            return await lazy.Value.WaitAsync(ct);
+        }
+        finally
+        {
+            // Удаляем именно эту запись: за время ожидания её могла заменить инвалидация.
+            _inflight.TryRemove(new KeyValuePair<string, Lazy<Task<decimal>>>(sku, lazy));
+        }
+    }
+
+    public async Task InvalidateAsync(string sku)
+    {
+        _inflight.TryRemove(sku, out _);
+        await redis.GetDatabase().ScriptEvaluateAsync(
+            InvalidateScript,
+            [PriceKey(sku), VersionKey(sku)],
+            [(long)VersionTtl.TotalMilliseconds]);
+    }
+
+    private async Task<decimal> LoadAsync(string sku)
+    {
+        // Общая загрузка не привязана к токену одного вызывающего.
+        using var cts = new CancellationTokenSource(SourceTimeout);
+        var db = redis.GetDatabase();
+
+        string version = "0";
+        var versionKnown = false;
+        try
+        {
+            var v = await db.StringGetAsync(VersionKey(sku));
+            version = v.HasValue ? v.ToString() : "0";
+            versionKnown = true;
+        }
+        catch (RedisException ex)
+        {
+            logger.LogWarning(ex, "Redis недоступен, цена не будет закэширована");
+        }
+
+        var price = await source.GetPriceAsync(sku, cts.Token);
+
+        if (versionKnown)
+        {
+            try
+            {
+                // Разброс TTL, чтобы популярные ключи не истекали одновременно.
+                var ttl = Ttl * (0.9 + Random.Shared.NextDouble() * 0.2);
+                await db.ScriptEvaluateAsync(
+                    SetIfVersionScript,
+                    [PriceKey(sku), VersionKey(sku)],
+                    [version, price.ToString(CultureInfo.InvariantCulture), (long)ttl.TotalMilliseconds]);
+            }
+            catch (RedisException ex)
+            {
+                logger.LogWarning(ex, "Не удалось записать цену в кэш");
+            }
+        }
+
+        return price;
+    }
+}
diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
