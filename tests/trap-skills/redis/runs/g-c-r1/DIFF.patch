@@ -0,0 +1,29 @@
+using StackExchange.Redis;
+
+namespace Fulfil.Mail;
+
+public sealed record EmailMessage(string To, string Subject, string Body);
+
+// Очередь писем на Redis Streams с группой потребителей. Задание остаётся в pending, пока воркер
+// не подтвердит отправку (XACK); при перезапуске воркера его неподтверждённые задания
+// перехватываются другими (XAUTOCLAIM). Доставка at-least-once: письмо при сбое может уйти повторно.
+public sealed class EmailQueue(IConnectionMultiplexer redis)
+{
+    public const string Stream = "mail:queue";
+    public const string DeadStream = "mail:dead";
+    public const string Group = "mail-workers";
+
+    public Task EnqueueAsync(EmailMessage message) =>
+        redis.GetDatabase().StreamAddAsync(Stream,
+        [
+            new NameValueEntry("to", message.To),
+            new NameValueEntry("subject", message.Subject),
+            new NameValueEntry("body", message.Body),
+        ]);
+
+    public static EmailMessage Parse(StreamEntry entry)
+    {
+        string Get(string name) => entry.Values.First(v => v.Name == name).Value.ToString();
+        return new EmailMessage(Get("to"), Get("subject"), Get("body"));
+    }
+}
diff --git a/src/Fulfil/Mail/EmailWorker.cs b/src/Fulfil/Mail/EmailWorker.cs
new file mode 100644
index 0000000..5138e71
--- /dev/null
+++ b/src/Fulfil/Mail/EmailWorker.cs
@@ -0,0 +1,98 @@
+using Fulfil.Ports;
+using StackExchange.Redis;
+
+namespace Fulfil.Mail;
+
+public sealed class EmailWorker(IConnectionMultiplexer redis, IEmailSender sender, ILogger<EmailWorker> logger) : BackgroundService
+{
+    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1);
+    private static readonly TimeSpan ClaimIdle = TimeSpan.FromMinutes(2);
+    private const int MaxDeliveries = 5;
+
+    private readonly string _consumer = $"{Environment.MachineName}-{Guid.NewGuid():N}";
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                var db = redis.GetDatabase();
+                await EnsureGroupAsync(db);
+
+                var work = 0;
+                // Задания, зависшие у упавших или перезапущенных воркеров.
+                var claimed = await db.StreamAutoClaimAsync(EmailQueue.Stream, EmailQueue.Group, _consumer,
+                    (long)ClaimIdle.TotalMilliseconds, "0-0", count: 10);
+                foreach (var entry in claimed.ClaimedEntries)
+                    work += await ProcessAsync(db, entry, stoppingToken);
+
+                var fresh = await db.StreamReadGroupAsync(EmailQueue.Stream, EmailQueue.Group, _consumer, ">", count: 10);
+                foreach (var entry in fresh)
+                    work += await ProcessAsync(db, entry, stoppingToken);
+
+                if (work == 0)
+                    await Task.Delay(PollInterval, stoppingToken);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+            {
+                return;
+            }
+            catch (Exception ex)
+            {
+                logger.LogWarning(ex, "Сбой цикла почтового воркера");
+                try { await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken); }
+                catch (OperationCanceledException) { return; }
+            }
+        }
+    }
+
+    private static async Task EnsureGroupAsync(IDatabase db)
+    {
+        try
+        {
+            await db.StreamCreateConsumerGroupAsync(EmailQueue.Stream, EmailQueue.Group, "0-0", createStream: true);
+        }
+        catch (RedisServerException ex) when (ex.Message.StartsWith("BUSYGROUP", StringComparison.Ordinal))
+        {
+        }
+    }
+
+    private async Task<int> ProcessAsync(IDatabase db, StreamEntry entry, CancellationToken ct)
+    {
+        if (entry.IsNull)
+            return 0;
+
+        // Задание, которое не удаётся отправить, уходит в mail:dead после MaxDeliveries попыток.
+        var pending = await db.StreamPendingMessagesAsync(EmailQueue.Stream, EmailQueue.Group, 1, _consumer, entry.Id, entry.Id);
+        if (pending.Length > 0 && pending[0].DeliveryCount > MaxDeliveries)
+        {
+            await db.StreamAddAsync(EmailQueue.DeadStream, entry.Values);
+            await AckAsync(db, entry.Id);
+            logger.LogError("Письмо {Id} перенесено в {Dead}", entry.Id, EmailQueue.DeadStream);
+            return 1;
+        }
+
+        try
+        {
+            await sender.SendAsync(EmailQueue.Parse(entry), ct);
+            await AckAsync(db, entry.Id);
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested)
+        {
+            throw; // не подтверждаем: задание подберёт другой воркер
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex, "Не удалось отправить письмо {Id}, будет повтор", entry.Id);
+        }
+        return 1;
+    }
+
+    // Подтверждённое задание удаляется из потока, иначе поток растёт без предела (maxmemory не задан).
+    private static async Task AckAsync(IDatabase db, RedisValue id)
+    {
+        await db.StreamAcknowledgeAsync(EmailQueue.Stream, EmailQueue.Group, id);
+        await db.StreamDeleteAsync(EmailQueue.Stream, [id]);
+    }
+}
