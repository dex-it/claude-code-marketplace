+using Fulfil.Carts;
+using Fulfil.Mail;
 using Fulfil.Options;
+using Fulfil.Prices;
+using Fulfil.RateLimiting;
+using Fulfil.Redis;
+using Fulfil.Stock;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+builder.Services.AddRedis();
+builder.Services.AddSingleton<PriceCache>();
+builder.Services.AddSingleton<CartStore>();
+builder.Services.AddSingleton<EmailQueue>();
+builder.Services.AddHostedService<StockRecalculationService>();
+builder.Services.AddHostedService<EmailWorker>();
 
 var app = builder.Build();
+app.UseWhen(ctx => ctx.Request.Path.StartsWithSegments("/api"), branch => branch.UseMiddleware<ApiRateLimitMiddleware>());
+
 app.MapGet("/health", () => Results.Ok());
+app.MapGet("/products/{sku}/price", async (string sku, PriceCache cache, CancellationToken ct) =>
+    Results.Ok(new { sku, price = await cache.GetAsync(sku, ct) }));
+app.MapPost("/internal/price-changed", async (PriceChanged body, PriceCache cache) =>
+{
+    if (string.IsNullOrWhiteSpace(body.Sku))
+        return Results.BadRequest();
+    try
+    {
+        await cache.InvalidateAsync(body.Sku);
+        return Results.NoContent();
+    }
+    catch (StackExchange.Redis.RedisException)
+    {
+        // Инвалидация не выполнена: пусть ценовой сервис повторит вызов.
+        return Results.StatusCode(StatusCodes.Status503ServiceUnavailable);
+    }
+});
 app.Run();
+
+public sealed record PriceChanged(string Sku);
