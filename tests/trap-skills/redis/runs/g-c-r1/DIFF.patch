diff --git a/src/Fulfil/Carts/CartStore.cs b/src/Fulfil/Carts/CartStore.cs
new file mode 100644
index 0000000..e89d439
--- /dev/null
+++ b/src/Fulfil/Carts/CartStore.cs
@@ -0,0 +1,58 @@
+using StackExchange.Redis;
+
+namespace Fulfil.Carts;
+
+public sealed record Cart(Dictionary<string, int> Items, string? PromoCode);
+
+// Корзина - hash cart:{id}: поле "i:{sku}" - количество, поле "promo" - промокод.
+// Позиции и промокод меняются независимо отдельными HSET/HDEL, без чтения-изменения-записи;
+// чтение целиком - один HGETALL. TTL продлевается при каждой записи, чтобы брошенные корзины не копились.
+public sealed class CartStore(IConnectionMultiplexer redis)
+{
+    private const string ItemPrefix = "i:";
+    private const string PromoField = "promo";
+    private static readonly TimeSpan Ttl = TimeSpan.FromDays(30);
+
+    private static RedisKey Key(string cartId) => $"cart:{cartId}";
+
+    public Task SetItemAsync(string cartId, string sku, int quantity) =>
+        quantity <= 0
+            ? RemoveItemAsync(cartId, sku)
+            : WriteAsync(cartId, (t, k) => t.HashSetAsync(k, ItemPrefix + sku, quantity));
+
+    public Task RemoveItemAsync(string cartId, string sku) =>
+        WriteAsync(cartId, (t, k) => t.HashDeleteAsync(k, ItemPrefix + sku));
+
+    public Task SetPromoCodeAsync(string cartId, string? code) =>
+        string.IsNullOrEmpty(code)
+            ? WriteAsync(cartId, (t, k) => t.HashDeleteAsync(k, PromoField))
+            : WriteAsync(cartId, (t, k) => t.HashSetAsync(k, PromoField, code));
+
+    public async Task<Cart> GetAsync(string cartId)
+    {
+        var entries = await redis.GetDatabase().HashGetAllAsync(Key(cartId));
+        var items = new Dictionary<string, int>();
+        string? promo = null;
+        foreach (var e in entries)
+        {
+            var name = e.Name.ToString();
+            if (name == PromoField)
+                promo = e.Value.ToString();
+            else if (name.StartsWith(ItemPrefix, StringComparison.Ordinal))
+                items[name[ItemPrefix.Length..]] = (int)e.Value;
+        }
+        return new Cart(items, promo);
+    }
+
+    private async Task WriteAsync(string cartId, Func<ITransaction, RedisKey, Task> write)
+    {
+        var tran = redis.GetDatabase().CreateTransaction();
+        var key = Key(cartId);
+        var op = write(tran, key);
+        var expire = tran.KeyExpireAsync(key, Ttl);
+        if (!await tran.ExecuteAsync())
+            throw new InvalidOperationException("Транзакция корзины не выполнена");
+        await op;
+        await expire;
+    }
+}
