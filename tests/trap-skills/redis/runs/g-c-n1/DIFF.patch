+using Fulfil.Ports;
+
+namespace Fulfil.Redis;
+
+// Запускается на всех репликах; пересчёт выполняет та, что взяла лок. Остальные пропускают тик.
+public sealed class StockRecalculationJob(
+    DistributedLock locks, IStockRecalculator recalculator, ILogger<StockRecalculationJob> log) : BackgroundService
+{
+    private static readonly TimeSpan Interval = TimeSpan.FromMinutes(1);
+    // Короткий TTL + продление: упавший владелец освобождает лок за 30 с, а не за время пересчёта.
+    private static readonly TimeSpan LockTtl = TimeSpan.FromSeconds(30);
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        using var timer = new PeriodicTimer(Interval);
+        do
+        {
+            try
+            {
+                await RunOnceAsync(stoppingToken);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested) { }
+            catch (Exception ex)
+            {
+                // Недоступный Redis или сбой пересчёта не должны останавливать таймер.
+                log.LogError(ex, "Stock recalculation tick failed");
+            }
+        }
+        while (await WaitAsync(timer, stoppingToken));
+    }
+
+    private static async Task<bool> WaitAsync(PeriodicTimer timer, CancellationToken ct)
+    {
+        try { return await timer.WaitForNextTickAsync(ct); }
+        catch (OperationCanceledException) { return false; }
+    }
+
+    private async Task RunOnceAsync(CancellationToken ct)
+    {
+        await using var handle = await locks.TryAcquireAsync("stock-recalc", LockTtl, ct);
+        if (handle is null)
+            return;
+
+        log.LogInformation("Stock recalculation started, fence {Fence}", handle.FencingToken);
+        try
+        {
+            await recalculator.RecalculateAsync(handle.FencingToken, handle.LostToken);
+            log.LogInformation("Stock recalculation finished");
+        }
+        catch (OperationCanceledException) when (handle.LostToken.IsCancellationRequested && !ct.IsCancellationRequested)
+        {
+            log.LogWarning("Stock recalculation aborted: lock lost");
+        }
+    }
+}
