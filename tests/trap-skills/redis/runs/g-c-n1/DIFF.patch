 using Fulfil.Options;
+using Fulfil.Redis;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+builder.Services.AddFulfilRedis();
 
 var app = builder.Build();
+
+app.UseWhen(ctx => ctx.Request.Path.StartsWithSegments("/api"),
+    branch => branch.UseMiddleware<RateLimitMiddleware>());
+
 app.MapGet("/health", () => Results.Ok());
+app.MapGet("/products/{sku}/price", async (string sku, PriceCache cache, CancellationToken ct) =>
+    Results.Ok(new { sku, price = await cache.GetAsync(sku, ct) }));
+app.MapPost("/internal/price-changed", async (PriceChanged body, PriceCache cache) =>
+{
+    if (string.IsNullOrWhiteSpace(body.Sku))
+        return Results.BadRequest();
+    await cache.InvalidateAsync(body.Sku);
+    return Results.NoContent();
+});
 app.Run();
+
+public sealed record PriceChanged(string Sku);
diff --git a/src/Fulfil/Redis/CartStore.cs b/src/Fulfil/Redis/CartStore.cs
new file mode 100644
index 0000000..b779bf1
--- /dev/null
+++ b/src/Fulfil/Redis/CartStore.cs
@@ -0,0 +1,57 @@
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+public sealed record Cart(IReadOnlyDictionary<string, int> Items, string? PromoCode);
+
+// Корзина - один hash: поле "item:{sku}" на позицию и поле "promo". Позиции и промокод меняются
+// независимо (HSET/HDEL по полю, без чтения-изменения-записи), читается всё одним HGETALL.
+// У ключа всегда есть TTL, иначе брошенные корзины копились бы без границы (maxmemory ограничен).
+public sealed class CartStore(IConnectionMultiplexer redis)
+{
+    private static readonly TimeSpan Ttl = TimeSpan.FromDays(30);
+    private const string ItemPrefix = "item:";
+    private const string PromoField = "promo";
+
+    private static RedisKey Key(string cartId) => $"cart:{cartId}";
+
+    public Task SetItemAsync(string cartId, string sku, int quantity) =>
+        quantity <= 0
+            ? RemoveItemAsync(cartId, sku)
+            : WriteAsync(cartId, (t, k) => t.HashSetAsync(k, ItemPrefix + sku, quantity));
+
+    public Task RemoveItemAsync(string cartId, string sku) =>
+        WriteAsync(cartId, (t, k) => t.HashDeleteAsync(k, ItemPrefix + sku));
+
+    public Task SetPromoAsync(string cartId, string promoCode) =>
+        WriteAsync(cartId, (t, k) => t.HashSetAsync(k, PromoField, promoCode));
+
+    public Task RemovePromoAsync(string cartId) =>
+        WriteAsync(cartId, (t, k) => t.HashDeleteAsync(k, PromoField));
+
+    public async Task<Cart> GetAsync(string cartId)
+    {
+        var entries = await redis.GetDatabase().HashGetAllAsync(Key(cartId));
+        var items = new Dictionary<string, int>();
+        string? promo = null;
+        foreach (var e in entries)
+        {
+            var name = (string)e.Name!;
+            if (name == PromoField) promo = e.Value;
+            else if (name.StartsWith(ItemPrefix, StringComparison.Ordinal)) items[name[ItemPrefix.Length..]] = (int)e.Value;
+        }
+        return new Cart(items, promo);
+    }
+
+    // MULTI: изменение и продление TTL применяются вместе.
+    private async Task WriteAsync(string cartId, Func<ITransaction, RedisKey, Task> op)
+    {
+        var tx = redis.GetDatabase().CreateTransaction();
+        var key = Key(cartId);
+        var write = op(tx, key);
+        _ = tx.KeyExpireAsync(key, Ttl);
+        if (!await tx.ExecuteAsync())
+            throw new InvalidOperationException("Cart transaction was not committed");
+        await write;
+    }
+}
diff --git a/src/Fulfil/Redis/DistributedLock.cs b/src/Fulfil/Redis/DistributedLock.cs
new file mode 100644
index 0000000..627dcea
--- /dev/null
+++ b/src/Fulfil/Redis/DistributedLock.cs
@@ -0,0 +1,112 @@
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+// Лок с продлением и fencing-токеном. Redis-лок не даёт гарантии исключительности (пауза процесса,
+// потеря ключа при рестарте/failover), поэтому владелец получает LostToken - его отмена означает
+// "лок потерян, прекращай писать", а FencingToken позволяет хранилищу отвергнуть запись устаревшего владельца.
+public sealed class DistributedLock(IConnectionMultiplexer redis, ILogger<DistributedLock> log)
+{
+    private const string RenewScript =
+        "if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('PEXPIRE', KEYS[1], ARGV[2]) else return 0 end";
+    private const string ReleaseScript =
+        "if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('DEL', KEYS[1]) else return 0 end";
+
+    public async Task<LockHandle?> TryAcquireAsync(string name, TimeSpan ttl, CancellationToken ct)
+    {
+        var db = redis.GetDatabase();
+        var token = Guid.NewGuid().ToString("N");
+        var key = $"lock:{name}";
+
+        if (!await db.StringSetAsync(key, token, ttl, When.NotExists).WaitAsync(ct))
+            return null;
+
+        long fence;
+        try
+        {
+            fence = await db.StringIncrementAsync($"lock:{name}:fence");
+        }
+        catch
+        {
+            await TryReleaseAsync(db, key, token);
+            throw;
+        }
+        return new LockHandle(this, db, key, token, ttl, fence, log, ct);
+    }
+
+    internal static Task TryReleaseAsync(IDatabase db, string key, string token) =>
+        db.ScriptEvaluateAsync(ReleaseScript, [(RedisKey)key], [(RedisValue)token]);
+
+    public sealed class LockHandle : IAsyncDisposable
+    {
+        private readonly IDatabase _db;
+        private readonly string _key;
+        private readonly string _token;
+        private readonly CancellationTokenSource _lost;
+        private readonly CancellationTokenSource _stop = new();
+        private readonly Task _renewal;
+
+        internal LockHandle(DistributedLock owner, IDatabase db, string key, string token, TimeSpan ttl,
+            long fencingToken, ILogger log, CancellationToken ct)
+        {
+            _db = db;
+            _key = key;
+            _token = token;
+            FencingToken = fencingToken;
+            _lost = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            _renewal = RenewAsync(ttl, log);
+        }
+
+        public long FencingToken { get; }
+
+        // Отменяется при потере лока или остановке сервиса.
+        public CancellationToken LostToken => _lost.Token;
+
+        private async Task RenewAsync(TimeSpan ttl, ILogger log)
+        {
+            var interval = ttl / 3;
+            var lastOk = DateTime.UtcNow;
+            using var timer = new PeriodicTimer(interval);
+            try
+            {
+                while (await timer.WaitForNextTickAsync(_stop.Token))
+                {
+                    try
+                    {
+                        var ok = (long)await _db.ScriptEvaluateAsync(RenewScript, [(RedisKey)_key],
+                            [(RedisValue)_token, (RedisValue)(long)ttl.TotalMilliseconds]);
+                        if (ok == 0)
+                        {
+                            log.LogError("Lock {Key} lost: key expired or taken over", _key);
+                            _lost.Cancel();
+                            return;
+                        }
+                        lastOk = DateTime.UtcNow;
+                    }
+                    catch (RedisException ex)
+                    {
+                        log.LogWarning(ex, "Lock {Key} renewal failed", _key);
+                        // Не смогли продлить дольше, чем TTL: считаем, что лок уже истёк.
+                        if (DateTime.UtcNow - lastOk >= ttl - interval)
+                        {
+                            log.LogError("Lock {Key} considered lost: no renewal within TTL", _key);
+                            _lost.Cancel();
+                            return;
+                        }
+                    }
+                }
+            }
+            catch (OperationCanceledException) { }
+        }
+
+        public async ValueTask DisposeAsync()
+        {
+            _stop.Cancel();
+            await _renewal;
+            try { await TryReleaseAsync(_db, _key, _token); }
+            catch (RedisException) { /* истечёт по TTL */ }
+            _stop.Dispose();
+            _lost.Dispose();
+        }
+    }
+}
diff --git a/src/Fulfil/Redis/MailQueue.cs b/src/Fulfil/Redis/MailQueue.cs
new file mode 100644
index 0000000..5dcc078
--- /dev/null
+++ b/src/Fulfil/Redis/MailQueue.cs
@@ -0,0 +1,124 @@
+using Fulfil.Contracts;
+using Fulfil.Ports;
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+// Очередь писем на Redis Stream с consumer group: прочитанное, но не подтверждённое (XACK) письмо
+// остаётся в pending и после рестарта воркера (деплой) забирается заново через XAUTOCLAIM.
+// Список с BRPOP терял бы письмо, снятое воркером перед остановкой. Доставка at-least-once.
+public sealed class MailQueue(IConnectionMultiplexer redis)
+{
+    public const string Stream = "mail:outbox";
+    public const string DeadStream = "mail:dead";
+    public const string Group = "mail-workers";
+
+    public Task EnqueueAsync(MailMessage m) =>
+        redis.GetDatabase().StreamAddAsync(Stream,
+        [
+            new NameValueEntry("id", m.Id.ToString()),
+            new NameValueEntry("to", m.To),
+            new NameValueEntry("subject", m.Subject),
+            new NameValueEntry("body", m.Body),
+        ]);
+
+    internal static MailMessage? Parse(StreamEntry e)
+    {
+        var f = e.Values.ToDictionary(v => (string)v.Name!, v => (string?)v.Value);
+        return Guid.TryParse(f.GetValueOrDefault("id"), out var id)
+            ? new MailMessage(id, f.GetValueOrDefault("to") ?? "", f.GetValueOrDefault("subject") ?? "", f.GetValueOrDefault("body") ?? "")
+            : null;
+    }
+}
+
+public sealed class MailWorker(IConnectionMultiplexer redis, IMailSender sender, ILogger<MailWorker> log) : BackgroundService
+{
+    private const int MaxDeliveries = 5;
+    private const int BatchSize = 10;
+    // Письмо, не подтверждённое дольше этого, считается брошенным упавшим/остановленным воркером.
+    private const long ClaimIdleMs = 60_000;
+
+    private readonly string _consumer = $"{Environment.MachineName}-{Guid.NewGuid():N}";
+
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        while (!ct.IsCancellationRequested)
+        {
+            try
+            {
+                await EnsureGroupAsync();
+                while (!ct.IsCancellationRequested)
+                {
+                    var db = redis.GetDatabase();
+                    var claimed = await db.StreamAutoClaimAsync(MailQueue.Stream, MailQueue.Group, _consumer, ClaimIdleMs, "0-0", BatchSize);
+                    var fresh = await db.StreamReadGroupAsync(MailQueue.Stream, MailQueue.Group, _consumer, ">", BatchSize);
+
+                    foreach (var e in claimed.ClaimedEntries.Where(e => !e.IsNull))
+                        await HandleAsync(db, e, redelivered: true, ct);
+                    foreach (var e in fresh)
+                        await HandleAsync(db, e, redelivered: false, ct);
+
+                    if (claimed.ClaimedEntries.Length == 0 && fresh.Length == 0)
+                        await Task.Delay(TimeSpan.FromSeconds(1), ct);
+                }
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
+            catch (Exception ex)
+            {
+                // Redis недоступен при старте или упал позже - ждём и пробуем снова.
+                log.LogWarning(ex, "Mail worker loop failed, retrying");
+                try { await Task.Delay(TimeSpan.FromSeconds(5), ct); } catch (OperationCanceledException) { }
+            }
+        }
+    }
+
+    private async Task EnsureGroupAsync()
+    {
+        try
+        {
+            await redis.GetDatabase().StreamCreateConsumerGroupAsync(MailQueue.Stream, MailQueue.Group, "0", createStream: true);
+        }
+        catch (RedisServerException ex) when (ex.Message.Contains("BUSYGROUP")) { }
+    }
+
+    private async Task HandleAsync(IDatabase db, StreamEntry entry, bool redelivered, CancellationToken ct)
+    {
+        if (redelivered)
+        {
+            var pending = await db.StreamPendingMessagesAsync(MailQueue.Stream, MailQueue.Group, 1, _consumer, entry.Id, entry.Id);
+            if (pending.Length > 0 && pending[0].DeliveryCount > MaxDeliveries)
+            {
+                log.LogError("Mail entry {Entry} moved to dead stream after {Count} deliveries", entry.Id, pending[0].DeliveryCount);
+                await db.StreamAddAsync(MailQueue.DeadStream, entry.Values);
+                await AckAsync(db, entry.Id);
+                return;
+            }
+        }
+
+        var message = MailQueue.Parse(entry);
+        if (message is null)
+        {
+            log.LogError("Mail entry {Entry} is malformed, dropped", entry.Id);
+            await AckAsync(db, entry.Id);
+            return;
+        }
+
+        try
+        {
+            await sender.SendAsync(message, ct);
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException)
+        {
+            // Без XACK: письмо вернётся через XAUTOCLAIM.
+            log.LogWarning(ex, "Mail {MailId} send failed, will be retried", message.Id);
+            return;
+        }
+        await AckAsync(db, entry.Id);
+    }
+
+    private static async Task AckAsync(IDatabase db, RedisValue id)
+    {
+        await db.StreamAcknowledgeAsync(MailQueue.Stream, MailQueue.Group, id);
+        await db.StreamDeleteAsync(MailQueue.Stream, [id]);
+    }
+}
diff --git a/src/Fulfil/Redis/PriceCache.cs b/src/Fulfil/Redis/PriceCache.cs
new file mode 100644
index 0000000..cc2a49e
--- /dev/null
+++ b/src/Fulfil/Redis/PriceCache.cs
@@ -0,0 +1,71 @@
+using System.Collections.Concurrent;
+using System.Globalization;
+using Fulfil.Ports;
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+// Кэш цен. Горячая сотня товаров при 500 rps: по истечении TTL на одном ключе мог бы встать
+// шквал обращений к источнику (300 мс), поэтому промах схлопывается в один запрос на sku в
+// пределах реплики. TTL с разбросом, чтобы ключи не истекали одновременно.
+public sealed class PriceCache(IConnectionMultiplexer redis, IPriceSource source, ILogger<PriceCache> log)
+{
+    private static readonly TimeSpan BaseTtl = TimeSpan.FromMinutes(5);
+    private static readonly TimeSpan SourceTimeout = TimeSpan.FromSeconds(5);
+
+    private readonly ConcurrentDictionary<string, Lazy<Task<decimal>>> _inflight = new();
+
+    private static string Key(string sku) => $"price:{sku}";
+
+    public async Task<decimal> GetAsync(string sku, CancellationToken ct)
+    {
+        try
+        {
+            var cached = await redis.GetDatabase().StringGetAsync(Key(sku)).WaitAsync(ct);
+            if (cached.HasValue
+                && decimal.TryParse((string?)cached, NumberStyles.Number, CultureInfo.InvariantCulture, out var price))
+                return price;
+        }
+        catch (RedisException ex)
+        {
+            // Redis недоступен - идём в источник, кэш не обязателен для корректности.
+            log.LogWarning(ex, "Price cache read failed");
+        }
+
+        var flight = _inflight.GetOrAdd(sku, s => new Lazy<Task<decimal>>(() => LoadAsync(s)));
+        return await flight.Value.WaitAsync(ct);
+    }
+
+    // Вызывается при POST /internal/price-changed. Если Redis недоступен, бросает исключение:
+    // ценовой сервис получит ошибку и повторит уведомление.
+    public async Task InvalidateAsync(string sku)
+    {
+        await redis.GetDatabase().KeyDeleteAsync(Key(sku));
+        // Уже летящий запрос мог прочитать старую цену; его результат не должен стать общим.
+        _inflight.TryRemove(sku, out _);
+    }
+
+    private async Task<decimal> LoadAsync(string sku)
+    {
+        try
+        {
+            // Токен запроса не используем: отмена одного клиента не должна ронять остальных.
+            using var cts = new CancellationTokenSource(SourceTimeout);
+            var price = await source.GetPriceAsync(sku, cts.Token);
+            try
+            {
+                var ttl = BaseTtl * (0.9 + Random.Shared.NextDouble() * 0.2);
+                await redis.GetDatabase().StringSetAsync(Key(sku), price.ToString(CultureInfo.InvariantCulture), ttl);
+            }
+            catch (RedisException ex)
+            {
+                log.LogWarning(ex, "Price cache write failed");
+            }
+            return price;
+        }
+        finally
+        {
+            _inflight.TryRemove(sku, out _);
+        }
+    }
+}
diff --git a/src/Fulfil/Redis/RateLimiter.cs b/src/Fulfil/Redis/RateLimiter.cs
new file mode 100644
index 0000000..b828d24
--- /dev/null
+++ b/src/Fulfil/Redis/RateLimiter.cs
@@ -0,0 +1,69 @@
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+// Скользящее окно на sorted set: фиксированные окна пропустили бы до 2*limit запросов на стыке.
+// Время берётся с сервера Redis (TIME), чтобы расхождение часов реплик не искажало окно.
+// В set не больше limit записей на ключ, ключ истекает вместе с окном.
+public sealed class RateLimiter(IConnectionMultiplexer redis, ILogger<RateLimiter> log)
+{
+    public const int Limit = 100;
+    public static readonly TimeSpan Window = TimeSpan.FromMinutes(1);
+
+    private const string Script = """
+        local t = redis.call('TIME')
+        local now = t[1] * 1000 + math.floor(t[2] / 1000)
+        local window = tonumber(ARGV[1])
+        redis.call('ZREMRANGEBYSCORE', KEYS[1], 0, now - window)
+        if redis.call('ZCARD', KEYS[1]) >= tonumber(ARGV[2]) then
+            local oldest = redis.call('ZRANGE', KEYS[1], 0, 0, 'WITHSCORES')
+            return {0, tonumber(oldest[2]) + window - now}
+        end
+        redis.call('ZADD', KEYS[1], now, ARGV[3])
+        redis.call('PEXPIRE', KEYS[1], window)
+        return {1, 0}
+        """;
+
+    // Возвращает null, если запрос разрешён, иначе - через сколько повторить.
+    public async Task<TimeSpan?> TryAcquireAsync(string apiKey)
+    {
+        try
+        {
+            var result = (long[])(await redis.GetDatabase().ScriptEvaluateAsync(
+                Script,
+                [(RedisKey)$"rl:{apiKey}"],
+                [(RedisValue)(long)Window.TotalMilliseconds, (RedisValue)Limit, (RedisValue)Guid.NewGuid().ToString("N")]))!;
+            return result[0] == 1 ? null : TimeSpan.FromMilliseconds(Math.Max(result[1], 1));
+        }
+        catch (RedisException ex)
+        {
+            // Fail-open: недоступность Redis не должна класть публичный API.
+            log.LogWarning(ex, "Rate limiter unavailable, request allowed");
+            return null;
+        }
+    }
+}
+
+public sealed class RateLimitMiddleware(RequestDelegate next, RateLimiter limiter)
+{
+    private const int MaxKeyLength = 128;
+
+    public async Task InvokeAsync(HttpContext ctx)
+    {
+        var key = ctx.Request.Headers["X-Api-Key"].ToString();
+        if (string.IsNullOrEmpty(key) || key.Length > MaxKeyLength)
+        {
+            ctx.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+
+        var retryAfter = await limiter.TryAcquireAsync(key);
+        if (retryAfter is { } wait)
+        {
+            ctx.Response.StatusCode = StatusCodes.Status429TooManyRequests;
+            ctx.Response.Headers.RetryAfter = ((int)Math.Ceiling(wait.TotalSeconds)).ToString();
+            return;
+        }
+        await next(ctx);
+    }
+}
