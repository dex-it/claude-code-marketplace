@@ -0,0 +1,36 @@
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+public static class RedisServiceCollectionExtensions
+{
+    public static IServiceCollection AddFulfilRedis(this IServiceCollection services)
+    {
+        // Connect с AbortOnConnectFail=false не бросает при недоступном Redis: сервис стартует,
+        // мультиплексор подключается в фоне. FailFast - команды при разрыве падают сразу,
+        // а не копятся в очереди до таймаута.
+        services.AddSingleton<IConnectionMultiplexer>(sp =>
+        {
+            var options = sp.GetRequiredService<IOptions<FulfilOptions>>().Value;
+            var config = ConfigurationOptions.Parse(options.RedisConfiguration);
+            config.AbortOnConnectFail = false;
+            config.BacklogPolicy = BacklogPolicy.FailFast;
+            config.ConnectTimeout = 3000;
+            config.SyncTimeout = 1000;
+            config.AsyncTimeout = 1000;
+            return ConnectionMultiplexer.Connect(config);
+        });
+
+        services.AddSingleton<PriceCache>();
+        services.AddSingleton<RedisLeaseLock>();
+        services.AddSingleton<SlidingWindowRateLimiter>();
+        services.AddSingleton<ICartStore, RedisCartStore>();
+        services.AddSingleton<IMailQueue, RedisMailQueue>();
+
+        services.AddHostedService<StockRecalculationWorker>();
+        services.AddHostedService<MailWorker>();
+        return services;
+    }
+}
diff --git a/src/Fulfil/Redis/SlidingWindowRateLimiter.cs b/src/Fulfil/Redis/SlidingWindowRateLimiter.cs
new file mode 100644
index 0000000..754e446
--- /dev/null
+++ b/src/Fulfil/Redis/SlidingWindowRateLimiter.cs
@@ -0,0 +1,74 @@
+using System.Security.Cryptography;
+using System.Text;
+using StackExchange.Redis;
+
+namespace Fulfil.Redis;
+
+public readonly record struct RateLimitResult(bool Allowed, TimeSpan RetryAfter);
+
+// Скользящее окно на sorted set: фиксированные окна пропускают до 2x лимита на стыке окон.
+// Время берётся из Redis (TIME), а не от реплики, поэтому расхождение часов реплик не влияет.
+public sealed class SlidingWindowRateLimiter(IConnectionMultiplexer redis, ILogger<SlidingWindowRateLimiter> log)
+{
+    public const int Limit = 100;
+    public static readonly TimeSpan Window = TimeSpan.FromMinutes(1);
+
+    private const string Script = """
+        local t = redis.call('TIME')
+        local now = t[1] * 1000 + math.floor(t[2] / 1000)
+        local window = tonumber(ARGV[1])
+        redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', now - window)
+        if redis.call('ZCARD', KEYS[1]) >= tonumber(ARGV[2]) then
+            local oldest = redis.call('ZRANGE', KEYS[1], 0, 0, 'WITHSCORES')
+            return {0, tonumber(oldest[2]) + window - now}
+        end
+        redis.call('ZADD', KEYS[1], now, ARGV[3])
+        redis.call('PEXPIRE', KEYS[1], window)
+        return {1, 0}
+        """;
+
+    public async Task<RateLimitResult> CheckAsync(string apiKey)
+    {
+        // В Redis не кладём сам ключ клиента.
+        var hash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(apiKey)));
+        try
+        {
+            var result = (long[])(await redis.GetDatabase().ScriptEvaluateAsync(
+                Script,
+                [$"rl:{hash}"],
+                [(long)Window.TotalMilliseconds, Limit, Guid.NewGuid().ToString("N")]))!;
+            return new RateLimitResult(result[0] == 1, TimeSpan.FromMilliseconds(result[1]));
+        }
+        catch (RedisException ex)
+        {
+            // Fail-open: недоступность Redis не должна ронять публичный API.
+            log.LogWarning(ex, "Redis недоступен, ограничение запросов пропущено");
+            return new RateLimitResult(true, TimeSpan.Zero);
+        }
+    }
+}
+
+public sealed class RateLimitMiddleware(RequestDelegate next, SlidingWindowRateLimiter limiter)
+{
+    private const int MaxKeyLength = 128;
+
+    public async Task InvokeAsync(HttpContext context)
+    {
+        var apiKey = context.Request.Headers["X-Api-Key"].ToString();
+        if (apiKey.Length == 0 || apiKey.Length > MaxKeyLength)
+        {
+            context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+
+        var result = await limiter.CheckAsync(apiKey);
+        if (!result.Allowed)
+        {
+            context.Response.StatusCode = StatusCodes.Status429TooManyRequests;
+            context.Response.Headers.RetryAfter = Math.Max(1, (int)Math.Ceiling(result.RetryAfter.TotalSeconds)).ToString();
+            return;
+        }
+
+        await next(context);
+    }
+}
