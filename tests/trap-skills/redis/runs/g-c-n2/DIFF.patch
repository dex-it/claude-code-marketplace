+++ b/src/Fulfil/Redis/StockRecalculationWorker.cs
@@ -0,0 +1,64 @@
+using Fulfil.Ports;
+
+namespace Fulfil.Redis;
+
+// Запускается на всех репликах; пересчёт выполняет та, что взяла лок.
+public sealed class StockRecalculationWorker(
+    RedisLeaseLock locks,
+    IEnumerable<IStockRecalculator> recalculators,
+    ILogger<StockRecalculationWorker> log) : BackgroundService
+{
+    private static readonly TimeSpan Period = TimeSpan.FromMinutes(1);
+
+    // Проход длится до 40 с; TTL короче прохода допустим, т.к. лок продлевается.
+    private static readonly TimeSpan LockTtl = TimeSpan.FromSeconds(30);
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        var recalculator = recalculators.FirstOrDefault();
+        if (recalculator is null)
+        {
+            log.LogWarning("IStockRecalculator не зарегистрирован, пересчёт остатков отключён");
+            return;
+        }
+
+        using var timer = new PeriodicTimer(Period);
+        try
+        {
+            while (await timer.WaitForNextTickAsync(stoppingToken))
+            {
+                await RunOnceAsync(recalculator, stoppingToken);
+            }
+        }
+        catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+        {
+        }
+    }
+
+    private async Task RunOnceAsync(IStockRecalculator recalculator, CancellationToken stoppingToken)
+    {
+        await using var lease = await locks.TryAcquireAsync("stock-recalculation", LockTtl);
+        if (lease is null)
+        {
+            return;
+        }
+
+        using var cts = CancellationTokenSource.CreateLinkedTokenSource(stoppingToken, lease.LeaseLost);
+        try
+        {
+            await recalculator.RecalculateAsync(lease.FencingToken, cts.Token);
+        }
+        catch (OperationCanceledException) when (lease.LeaseLost.IsCancellationRequested)
+        {
+            log.LogWarning("Пересчёт остатков прерван: лок потерян");
+        }
+        catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            log.LogError(ex, "Пересчёт остатков завершился ошибкой");
+        }
+    }
+}
