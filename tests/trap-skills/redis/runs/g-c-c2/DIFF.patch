--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,90 @@
+using Fulfil.Caching;
+using Fulfil.Carts;
+using Fulfil.Locking;
+using Fulfil.Mail;
 using Fulfil.Options;
+using Fulfil.Ports;
+using Fulfil.RateLimiting;
+using MassTransit;
+using StackExchange.Redis;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IConnectionMultiplexer>(_ =>
+{
+    var options = ConfigurationOptions.Parse(fulfil.RedisConfiguration);
+    options.AbortOnConnectFail = false; // сервис стартует и без Redis, подключение восстановится само
+    return ConnectionMultiplexer.Connect(options);
+});
+builder.Services.AddSingleton<PriceCache>();
+builder.Services.AddSingleton<RedisLock>();
+builder.Services.AddSingleton<CartStore>();
+builder.Services.AddHostedService<StockRecalculationJob>();
+
+builder.Services.AddSingleton<IEmailSender, LoggingEmailSender>();
+builder.Services.AddMassTransit(x =>
+{
+    x.AddConsumer<SendEmailConsumer>();
+    x.UsingRabbitMq((ctx, cfg) =>
+    {
+        cfg.Host(fulfil.RabbitMqHost, "/", _ => { });
+        cfg.UseMessageRetry(r => r.Exponential(5, TimeSpan.FromSeconds(1), TimeSpan.FromMinutes(1), TimeSpan.FromSeconds(5)));
+        cfg.ConfigureEndpoints(ctx);
+    });
+});
 
 var app = builder.Build();
+
+app.UseWhen(c => c.Request.Path.StartsWithSegments("/api"),
+    branch => branch.UseMiddleware<ApiRateLimitMiddleware>());
+
 app.MapGet("/health", () => Results.Ok());
+
+app.MapGet("/products/{sku}/price", async (string sku, PriceCache cache, CancellationToken ct) =>
+    Results.Ok(new { sku, price = await cache.GetAsync(sku, ct) }));
+
+app.MapPost("/internal/price-changed", async (PriceChanged body, PriceCache cache) =>
+{
+    if (string.IsNullOrWhiteSpace(body.Sku)) return Results.BadRequest();
+    await cache.InvalidateAsync(body.Sku);
+    return Results.NoContent();
+});
+
+app.MapPost("/api/emails", async (EmailRequest body, IPublishEndpoint bus, CancellationToken ct) =>
+{
+    var id = Guid.NewGuid();
+    await bus.Publish(new SendEmail(id, body.To, body.Subject, body.Body), ct);
+    return Results.Accepted(value: new { id });
+});
+
+var carts = app.MapGroup("/carts/{cartId}");
+carts.MapGet("", async (string cartId, CartStore store) => Results.Ok(await store.GetAsync(cartId)));
+carts.MapPut("/items/{sku}", async (string cartId, string sku, QuantityBody body, CartStore store) =>
+{
+    await store.SetItemAsync(cartId, sku, body.Quantity);
+    return Results.NoContent();
+});
+carts.MapDelete("/items/{sku}", async (string cartId, string sku, CartStore store) =>
+{
+    await store.RemoveItemAsync(cartId, sku);
+    return Results.NoContent();
+});
+carts.MapPut("/promo", async (string cartId, PromoBody body, CartStore store) =>
+{
+    await store.SetPromoAsync(cartId, body.Code);
+    return Results.NoContent();
+});
+carts.MapDelete("/promo", async (string cartId, CartStore store) =>
+{
+    await store.RemovePromoAsync(cartId);
+    return Results.NoContent();
+});
+
 app.Run();
+
+internal sealed record PriceChanged(string Sku);
+internal sealed record EmailRequest(string To, string Subject, string Body);
+internal sealed record QuantityBody(int Quantity);
+internal sealed record PromoBody(string Code);
diff --git a/src/Fulfil/RateLimiting/ApiRateLimitMiddleware.cs b/src/Fulfil/RateLimiting/ApiRateLimitMiddleware.cs
new file mode 100644
index 0000000..dc42be2
--- /dev/null
+++ b/src/Fulfil/RateLimiting/ApiRateLimitMiddleware.cs
@@ -0,0 +1,53 @@
+using System.Security.Cryptography;
+using System.Text;
+using StackExchange.Redis;
+
+namespace Fulfil.RateLimiting;
+
+// Скользящее окно в ZSET, проверка и запись атомарны (Lua). Время берётся с Redis, а не с реплик.
+public sealed class ApiRateLimitMiddleware(RequestDelegate next, IConnectionMultiplexer redis, ILogger<ApiRateLimitMiddleware> log)
+{
+    private const int Limit = 100;
+    private const int WindowMs = 60_000;
+
+    private const string Script = """
+        local t = redis.call('TIME')
+        local now = t[1] * 1000 + math.floor(t[2] / 1000)
+        redis.call('ZREMRANGEBYSCORE', KEYS[1], 0, now - tonumber(ARGV[2]))
+        if redis.call('ZCARD', KEYS[1]) >= tonumber(ARGV[1]) then return 0 end
+        redis.call('ZADD', KEYS[1], now, ARGV[3])
+        redis.call('PEXPIRE', KEYS[1], ARGV[2])
+        return 1
+        """;
+
+    public async Task InvokeAsync(HttpContext context)
+    {
+        var apiKey = context.Request.Headers["X-Api-Key"].ToString();
+        if (string.IsNullOrEmpty(apiKey))
+        {
+            context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            return;
+        }
+
+        var key = "rl:" + Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(apiKey)));
+        try
+        {
+            var allowed = (long)await redis.GetDatabase().ScriptEvaluateAsync(Script,
+                new RedisKey[] { key },
+                new RedisValue[] { Limit, WindowMs, Guid.NewGuid().ToString("N") });
+            if (allowed == 0)
+            {
+                context.Response.Headers.RetryAfter = "60";
+                context.Response.StatusCode = StatusCodes.Status429TooManyRequests;
+                return;
+            }
+        }
+        catch (RedisException ex)
+        {
+            // Недоступность Redis не должна класть публичный API.
+            log.LogWarning(ex, "Ограничитель запросов недоступен, пропускаем запрос");
+        }
+
+        await next(context);
+    }
+}
