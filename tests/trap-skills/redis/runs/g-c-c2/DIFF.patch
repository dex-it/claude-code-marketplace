@@ -0,0 +1,61 @@
+using System.Collections.Concurrent;
+using System.Globalization;
+using Fulfil.Ports;
+using StackExchange.Redis;
+
+namespace Fulfil.Caching;
+
+// Cache-aside для цен. TTL ограничивает устаревание, если инвалидация не дошла или обогнала загрузку.
+// Загрузки одного SKU в пределах реплики схлопываются в одну (защита от шторма при истечении TTL).
+public sealed class PriceCache(IConnectionMultiplexer redis, IPriceSource source, ILogger<PriceCache> log)
+{
+    private static readonly TimeSpan Ttl = TimeSpan.FromSeconds(60);
+    private readonly ConcurrentDictionary<string, Lazy<Task<decimal>>> _inflight = new();
+
+    private static string Key(string sku) => $"price:{sku}";
+
+    public async Task<decimal> GetAsync(string sku, CancellationToken ct)
+    {
+        try
+        {
+            var cached = await redis.GetDatabase().StringGetAsync(Key(sku));
+            if (cached.HasValue && decimal.TryParse((string?)cached, NumberStyles.Number, CultureInfo.InvariantCulture, out var price))
+                return price;
+        }
+        catch (RedisException ex)
+        {
+            log.LogWarning(ex, "Redis недоступен при чтении цены, идём в источник");
+        }
+
+        var load = _inflight.GetOrAdd(sku, s => new Lazy<Task<decimal>>(() => LoadAsync(s)));
+        return await load.Value.WaitAsync(ct);
+    }
+
+    // Загрузка общая для ожидающих, поэтому не привязана к токену конкретного запроса.
+    private async Task<decimal> LoadAsync(string sku)
+    {
+        try
+        {
+            var price = await source.GetPriceAsync(sku, CancellationToken.None);
+            try
+            {
+                await redis.GetDatabase().StringSetAsync(Key(sku), price.ToString(CultureInfo.InvariantCulture), Ttl);
+            }
+            catch (RedisException ex)
+            {
+                log.LogWarning(ex, "Не удалось записать цену в Redis");
+            }
+            return price;
+        }
+        finally
+        {
+            _inflight.TryRemove(sku, out _);
+        }
+    }
+
+    public async Task InvalidateAsync(string sku)
+    {
+        _inflight.TryRemove(sku, out _);
+        await redis.GetDatabase().KeyDeleteAsync(Key(sku));
+    }
+}
diff --git a/src/Fulfil/Carts/CartStore.cs b/src/Fulfil/Carts/CartStore.cs
new file mode 100644
index 0000000..464ddf1
--- /dev/null
+++ b/src/Fulfil/Carts/CartStore.cs
@@ -0,0 +1,51 @@
+using StackExchange.Redis;
+
+namespace Fulfil.Carts;
+
+public sealed record Cart(IReadOnlyDictionary<string, int> Items, string? PromoCode);
+
+// Корзина - один hash: поля "i:{sku}" - количество, поле "promo" - промокод.
+// Позиции и промокод меняются независимо (HSET/HDEL), читается всё одним HGETALL.
+public sealed class CartStore(IConnectionMultiplexer redis)
+{
+    private static readonly TimeSpan Ttl = TimeSpan.FromDays(30);
+    private const string ItemPrefix = "i:";
+    private const string PromoField = "promo";
+
+    private static string Key(string cartId) => $"cart:{cartId}";
+
+    public async Task<Cart> GetAsync(string cartId)
+    {
+        var entries = await redis.GetDatabase().HashGetAllAsync(Key(cartId));
+        var items = new Dictionary<string, int>();
+        string? promo = null;
+        foreach (var e in entries)
+        {
+            var name = (string)e.Name!;
+            if (name == PromoField) promo = e.Value;
+            else if (name.StartsWith(ItemPrefix, StringComparison.Ordinal)) items[name[ItemPrefix.Length..]] = (int)e.Value;
+        }
+        return new Cart(items, promo);
+    }
+
+    public Task SetItemAsync(string cartId, string sku, int quantity) =>
+        quantity <= 0
+            ? RemoveItemAsync(cartId, sku)
+            : WriteAsync(cartId, db => db.HashSetAsync(Key(cartId), ItemPrefix + sku, quantity));
+
+    public Task RemoveItemAsync(string cartId, string sku) =>
+        redis.GetDatabase().HashDeleteAsync(Key(cartId), ItemPrefix + sku);
+
+    public Task SetPromoAsync(string cartId, string code) =>
+        WriteAsync(cartId, db => db.HashSetAsync(Key(cartId), PromoField, code));
+
+    public Task RemovePromoAsync(string cartId) =>
+        redis.GetDatabase().HashDeleteAsync(Key(cartId), PromoField);
+
+    private async Task WriteAsync(string cartId, Func<IDatabase, Task> write)
+    {
+        var db = redis.GetDatabase();
+        await write(db);
+        await db.KeyExpireAsync(Key(cartId), Ttl);
+    }
+}
diff --git a/src/Fulfil/Locking/RedisLock.cs b/src/Fulfil/Locking/RedisLock.cs
new file mode 100644
index 0000000..dc0fd93
--- /dev/null
+++ b/src/Fulfil/Locking/RedisLock.cs
@@ -0,0 +1,95 @@
+using System.Diagnostics;
+using StackExchange.Redis;
+
+namespace Fulfil.Locking;
+
+// Аренда с владельцем-токеном и продлением. Если продлить не удалось, Token отменяется:
+// работа под арендой должна остановиться, пока другая реплика не взяла замок.
+public sealed class RedisLock(IConnectionMultiplexer redis, ILogger<RedisLock> log)
+{
+    internal const string ReleaseScript =
+        "if redis.call('GET',KEYS[1])==ARGV[1] then return redis.call('DEL',KEYS[1]) end return 0";
+    internal const string RenewScript =
+        "if redis.call('GET',KEYS[1])==ARGV[1] then return redis.call('PEXPIRE',KEYS[1],ARGV[2]) end return 0";
+
+    public async Task<Lease?> TryAcquireAsync(string key, TimeSpan ttl)
+    {
+        var db = redis.GetDatabase();
+        var token = Guid.NewGuid().ToString("N");
+        if (!await db.StringSetAsync(key, token, ttl, When.NotExists))
+            return null;
+        return new Lease(db, key, token, ttl, log);
+    }
+
+    public sealed class Lease : IAsyncDisposable
+    {
+        private readonly IDatabase _db;
+        private readonly string _key;
+        private readonly string _token;
+        private readonly TimeSpan _ttl;
+        private readonly ILogger _log;
+        private readonly CancellationTokenSource _lost = new();
+        private readonly CancellationTokenSource _stop = new();
+        private readonly Task _renewLoop;
+
+        internal Lease(IDatabase db, string key, string token, TimeSpan ttl, ILogger log)
+        {
+            (_db, _key, _token, _ttl, _log) = (db, key, token, ttl, log);
+            _renewLoop = RenewAsync();
+        }
+
+        public CancellationToken Token => _lost.Token;
+
+        private async Task RenewAsync()
+        {
+            var sinceRenew = Stopwatch.StartNew();
+            using var timer = new PeriodicTimer(_ttl / 3);
+            try
+            {
+                while (await timer.WaitForNextTickAsync(_stop.Token))
+                {
+                    try
+                    {
+                        var ok = (long)await _db.ScriptEvaluateAsync(RenewScript,
+                            new RedisKey[] { _key }, new RedisValue[] { _token, (long)_ttl.TotalMilliseconds });
+                        if (ok == 0)
+                        {
+                            _log.LogWarning("Замок {Key} потерян", _key);
+                            _lost.Cancel();
+                            return;
+                        }
+                        sinceRenew.Restart();
+                    }
+                    catch (RedisException ex)
+                    {
+                        _log.LogWarning(ex, "Не удалось продлить замок {Key}", _key);
+                        if (sinceRenew.Elapsed > _ttl * 2 / 3)
+                        {
+                            _lost.Cancel();
+                            return;
+                        }
+                    }
+                }
+            }
+            catch (OperationCanceledException)
+            {
+            }
+        }
+
+        public async ValueTask DisposeAsync()
+        {
+            _stop.Cancel();
+            await _renewLoop;
+            try
+            {
+                await _db.ScriptEvaluateAsync(ReleaseScript, new RedisKey[] { _key }, new RedisValue[] { _token });
+            }
+            catch (RedisException ex)
+            {
+                _log.LogWarning(ex, "Не удалось освободить замок {Key}; истечёт по TTL", _key);
+            }
+            _stop.Dispose();
+            _lost.Dispose();
+        }
+    }
+}
diff --git a/src/Fulfil/Locking/StockRecalculationJob.cs b/src/Fulfil/Locking/StockRecalculationJob.cs
new file mode 100644
index 0000000..79de4cb
