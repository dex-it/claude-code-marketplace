+using Fulfil.Ports;
+using MassTransit;
+
+namespace Fulfil.Mail;
+
+// Задание на отправку письма. Очередь - RabbitMQ (durable): задания переживают перезапуск воркеров.
+public sealed record SendEmail(Guid MessageId, string To, string Subject, string Body);
+
+public sealed class SendEmailConsumer(IEmailSender sender) : IConsumer<SendEmail>
+{
+    public Task Consume(ConsumeContext<SendEmail> context) =>
+        sender.SendAsync(context.Message, context.CancellationToken);
+}
+
+// Заглушка до появления SMTP-реализации; в лог идёт только идентификатор.
+public sealed class LoggingEmailSender(ILogger<LoggingEmailSender> log) : IEmailSender
+{
+    public Task SendAsync(SendEmail message, CancellationToken ct)
+    {
+        log.LogInformation("Письмо {MessageId} отправлено", message.MessageId);
+        return Task.CompletedTask;
+    }
+}
