+++ b/src/Fulfil/Locking/StockRecalculationJob.cs
@@ -0,0 +1,49 @@
+using Fulfil.Ports;
+
+namespace Fulfil.Locking;
+
+// Запускается по таймеру на каждой реплике; пересчёт выполняет та, что взяла замок.
+public sealed class StockRecalculationJob(
+    RedisLock locks, IServiceScopeFactory scopes, ILogger<StockRecalculationJob> log) : BackgroundService
+{
+    private static readonly TimeSpan Period = TimeSpan.FromMinutes(1);
+    private static readonly TimeSpan LockTtl = TimeSpan.FromSeconds(30);
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        using var timer = new PeriodicTimer(Period);
+        try
+        {
+            do
+            {
+                await RunOnceAsync(stoppingToken);
+            } while (await timer.WaitForNextTickAsync(stoppingToken));
+        }
+        catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+        {
+        }
+    }
+
+    private async Task RunOnceAsync(CancellationToken stoppingToken)
+    {
+        try
+        {
+            await using var lease = await locks.TryAcquireAsync("lock:stock-recalc", LockTtl);
+            if (lease is null)
+                return;
+
+            // Потеря замка отменяет проход: запись в MongoDB не должна идти параллельно с другой репликой.
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(stoppingToken, lease.Token);
+            await using var scope = scopes.CreateAsyncScope();
+            await scope.ServiceProvider.GetRequiredService<IStockRecalculator>().RecalculateAsync(cts.Token);
+        }
+        catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            log.LogError(ex, "Пересчёт остатков не выполнен");
+        }
+    }
+}
