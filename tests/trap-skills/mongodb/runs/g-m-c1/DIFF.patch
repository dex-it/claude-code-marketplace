index 0000000..96e1141
--- /dev/null
+++ b/src/Fulfil/Storage/StockTransfer.cs
@@ -0,0 +1,31 @@
+using MongoDB.Driver;
+
+namespace Fulfil.Storage;
+
+public sealed class StockTransfer(MongoContext db)
+{
+    // Два изменения в одной транзакции; нехватка остатка откатывает всё.
+    public async Task<bool> TransferAsync(string fromWarehouse, string toWarehouse, string sku, int qty, CancellationToken ct)
+    {
+        var fromId = $"{fromWarehouse}:{sku}";
+        var toId = $"{toWarehouse}:{sku}";
+        using var session = await db.Client.StartSessionAsync(cancellationToken: ct);
+        return await session.WithTransactionAsync(async (s, token) =>
+        {
+            var dec = await db.WarehouseStock.UpdateOneAsync(s,
+                x => x.Id == fromId && x.Stock >= qty,
+                Builders<WarehouseStockDocument>.Update.Inc(x => x.Stock, -qty),
+                cancellationToken: token);
+            if (dec.ModifiedCount == 0) return false;
+
+            await db.WarehouseStock.UpdateOneAsync(s,
+                x => x.Id == toId,
+                Builders<WarehouseStockDocument>.Update
+                    .Inc(x => x.Stock, qty)
+                    .SetOnInsert(x => x.WarehouseId, toWarehouse)
+                    .SetOnInsert(x => x.Sku, sku),
+                new UpdateOptions { IsUpsert = true }, token);
+            return true;
+        }, cancellationToken: ct);
+    }
+}
