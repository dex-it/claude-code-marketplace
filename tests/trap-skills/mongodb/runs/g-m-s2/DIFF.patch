index 0000000..2ea0c3b
--- /dev/null
+++ b/src/Fulfil/Storage/StockTransfer.cs
@@ -0,0 +1,39 @@
+using MongoDB.Driver;
+
+namespace Fulfil.Storage;
+
+public sealed class StockTransfer(MongoContext mongo)
+{
+    // MongoDB здесь - одиночный mongod без replica set, многодокументные транзакции недоступны.
+    // Вместо них: условное атомарное списание (не уйдёт в минус), затем зачисление; если зачисление
+    // не удалось - списание компенсируется возвратом. Каждая отдельная запись атомарна.
+    // Остаточный риск: падение процесса между списанием и зачислением оставит остаток списанным.
+    public async Task<bool> TransferAsync(string sku, string fromWarehouse, string toWarehouse, int quantity, CancellationToken ct)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(quantity);
+        var f = Builders<WarehouseStockDocument>.Filter;
+        var u = Builders<WarehouseStockDocument>.Update;
+
+        var debited = await mongo.WarehouseStock.UpdateOneAsync(
+            f.Eq(x => x.WarehouseId, fromWarehouse) & f.Eq(x => x.Sku, sku) & f.Gte(x => x.Stock, quantity),
+            u.Inc(x => x.Stock, -quantity), cancellationToken: ct);
+        if (debited.ModifiedCount == 0) return false;
+
+        try
+        {
+            var credited = await mongo.WarehouseStock.UpdateOneAsync(
+                f.Eq(x => x.WarehouseId, toWarehouse) & f.Eq(x => x.Sku, sku),
+                u.Inc(x => x.Stock, quantity), new UpdateOptions { IsUpsert = true }, ct);
+            if (credited.MatchedCount == 0 && credited.UpsertedId is null)
+                throw new InvalidOperationException("Зачисление на склад-приёмник не выполнено");
+            return true;
+        }
+        catch
+        {
+            await mongo.WarehouseStock.UpdateOneAsync(
+                f.Eq(x => x.WarehouseId, fromWarehouse) & f.Eq(x => x.Sku, sku),
+                u.Inc(x => x.Stock, quantity), cancellationToken: CancellationToken.None);
+            throw;
+        }
+    }
+}
