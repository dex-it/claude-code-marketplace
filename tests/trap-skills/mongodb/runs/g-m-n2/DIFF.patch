@@ -0,0 +1,28 @@
+using MongoDB.Driver;
+
+namespace Fulfil.Storage;
+
+public sealed class StockTransfer(IMongoClient client, IMongoDatabase db)
+{
+    // Оба изменения - в одной транзакции (нужен реплика-сет, см. docker-compose.yml).
+    // Условие Stock >= quantity не даёт уйти в минус; при нехватке транзакция откатывается.
+    public async Task MoveAsync(string sku, string fromWarehouse, string toWarehouse, int quantity, CancellationToken ct)
+    {
+        var stock = db.GetCollection<WarehouseStockDocument>("warehouse_stock");
+        var f = Builders<WarehouseStockDocument>.Filter;
+        using var session = await client.StartSessionAsync(cancellationToken: ct);
+        await session.WithTransactionAsync(async (s, token) =>
+        {
+            var dec = await stock.UpdateOneAsync(s,
+                f.Eq(x => x.WarehouseId, fromWarehouse) & f.Eq(x => x.Sku, sku) & f.Gte(x => x.Stock, quantity),
+                Builders<WarehouseStockDocument>.Update.Inc(x => x.Stock, -quantity), cancellationToken: token);
+            if (dec.ModifiedCount != 1) throw new InvalidOperationException("Недостаточно остатка на складе-источнике.");
+
+            await stock.UpdateOneAsync(s,
+                f.Eq(x => x.WarehouseId, toWarehouse) & f.Eq(x => x.Sku, sku),
+                Builders<WarehouseStockDocument>.Update.Inc(x => x.Stock, quantity),
+                new UpdateOptions { IsUpsert = true }, token);
+            return true;
+        }, cancellationToken: ct);
+    }
+}
