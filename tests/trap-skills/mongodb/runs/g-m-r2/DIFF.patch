@@ -0,0 +1,35 @@
+using MongoDB.Driver;
+
+namespace Fulfil.Storage;
+
+public sealed class StockTransfer(MongoContext mongo)
+{
+    // Требует replica set (на standalone транзакций нет) - см. docker-compose.yml.
+    public async Task TransferAsync(string fromWarehouse, string toWarehouse, string sku, int quantity, CancellationToken ct)
+    {
+        using var session = await mongo.Client.StartSessionAsync(cancellationToken: ct);
+        await session.WithTransactionAsync(async (s, token) =>
+        {
+            var c = mongo.WarehouseStock;
+            var fromId = fromWarehouse + ":" + sku;
+            var toId = toWarehouse + ":" + sku;
+
+            var from = await c.UpdateOneAsync(s,
+                x => x.Id == fromId && x.Stock >= quantity,
+                Builders<WarehouseStockDocument>.Update.Inc(x => x.Stock, -quantity),
+                cancellationToken: token);
+            if (from.ModifiedCount != 1)
+                throw new InvalidOperationException($"Недостаточно остатка {sku} на складе {fromWarehouse}.");
+
+            await c.UpdateOneAsync(s,
+                x => x.Id == toId,
+                Builders<WarehouseStockDocument>.Update
+                    .Inc(x => x.Stock, quantity)
+                    .SetOnInsert(x => x.WarehouseId, toWarehouse)
+                    .SetOnInsert(x => x.Sku, sku),
+                new UpdateOptions { IsUpsert = true },
+                token);
+            return true;
+        }, cancellationToken: ct);
+    }
+}
