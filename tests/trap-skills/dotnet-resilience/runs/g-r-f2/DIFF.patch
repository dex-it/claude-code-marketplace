+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Reservations;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class ReservationServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierReservations> _suppliers = new();
+
+    public ReservationServiceTests() =>
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>()))
+            .ReturnsAsync(new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 100m, "sup-1"));
+
+    [Fact]
+    public async Task Reserve_returns_reservation_id_per_line()
+    {
+        _suppliers.Setup(s => s.ReserveAsync("sup-1", "o-1", "SKU-1", 3, It.IsAny<string>(), It.IsAny<CancellationToken>()))
+            .ReturnsAsync("r-42");
+
+        var result = await new ReservationService(_products.Object, _suppliers.Object)
+            .ReserveAsync("o-1", [new ReservationLine("SKU-1", 3)], default);
+
+        var line = Assert.Single(result);
+        Assert.Equal("r-42", line.ReservationId);
+    }
+
+    [Fact]
+    public async Task Repeated_call_uses_same_idempotency_keys()
+    {
+        var keys = new List<string>();
+        _suppliers.Setup(s => s.ReserveAsync(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<int>(), It.IsAny<string>(), It.IsAny<CancellationToken>()))
+            .Callback<string, string, string, int, string, CancellationToken>((_, _, _, _, key, _) => keys.Add(key))
+            .ReturnsAsync("r-1");
+        var service = new ReservationService(_products.Object, _suppliers.Object);
+        ReservationLine[] lines = [new("SKU-1", 1), new("SKU-1", 2)];
+
+        await service.ReserveAsync("o-1", lines, default);
+        await service.ReserveAsync("o-1", lines, default);
+
+        Assert.Equal(2, keys.Distinct().Count());
+        Assert.Equal(keys.Take(2), keys.Skip(2));
+    }
+
+    [Fact]
+    public async Task Reserve_rejects_non_positive_quantity()
+    {
+        var ex = await Assert.ThrowsAsync<DomainException>(() =>
+            new ReservationService(_products.Object, _suppliers.Object).ReserveAsync("o-1", [new ReservationLine("SKU-1", 0)], default));
+
+        Assert.Equal("reservation.quantity_positive", ex.Code);
+    }
+}
