+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _catalog = new();
+    private readonly Mock<ISupplierStock> _stock = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private QuoteService CreateService()
+    {
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>()))
+            .ReturnsAsync(new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 100m, "sup-1"));
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync([]);
+        return new QuoteService(_products.Object, _catalog.Object, _stock.Object, new PromotionService(_promotions.Object));
+    }
+
+    [Fact]
+    public async Task Quote_line_carries_supplier_availability()
+    {
+        _stock.Setup(s => s.GetAvailableAsync("sup-1", "SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(12);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(12, Assert.Single(quote.Lines).Available);
+    }
+
+    [Fact]
+    public async Task Quote_is_returned_with_null_availability_when_stock_unknown()
+    {
+        _stock.Setup(s => s.GetAvailableAsync(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<CancellationToken>()))
+            .ReturnsAsync((int?)null);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        var line = Assert.Single(quote.Lines);
+        Assert.Null(line.Available);
+        Assert.Equal(200m, quote.Total);
+    }
+}
