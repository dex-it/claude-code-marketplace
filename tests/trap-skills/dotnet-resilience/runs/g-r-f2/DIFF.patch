+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.Reservations;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api/orders/{orderId}/reservations")]
+public sealed class ReservationsController(ReservationService reservations) : ControllerBase
+{
+    [HttpPost]
+    [ProducesResponseType<ReservationsDto>(StatusCodes.Status201Created)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status409Conflict)]
+    public async Task<ActionResult<ReservationsDto>> Create(
+        string orderId, CreateReservationsRequest request, CancellationToken ct)
+    {
+        var result = await reservations.ReserveAsync(
+            orderId, request.Lines.Select(l => new ReservationLine(l.Sku, l.Quantity)).ToList(), ct);
+        var dto = new ReservationsDto(orderId, result.Select(r => new LineReservationDto(r.Sku, r.ReservationId)).ToList());
+        return Created(Request.Path, dto);
+    }
+}
