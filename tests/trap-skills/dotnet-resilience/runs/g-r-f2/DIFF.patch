+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Application.Reservations;
+
+public sealed record ReservationLine(string Sku, int Quantity);
+
+public sealed record LineReservation(string Sku, string ReservationId);
+
+public sealed class ReservationService(IProductRepository products, ISupplierReservations suppliers)
+{
+    public async Task<IReadOnlyList<LineReservation>> ReserveAsync(
+        string orderId, IReadOnlyList<ReservationLine> lines, CancellationToken ct)
+    {
+        if (string.IsNullOrWhiteSpace(orderId))
+            throw new DomainException("reservation.order_required", "Номер заказа обязателен");
+        if (lines.Count == 0)
+            throw new DomainException("reservation.lines_required", "Нет строк для резерва");
+        if (lines.Any(l => l.Quantity <= 0))
+            throw new DomainException("reservation.quantity_positive", "Количество должно быть больше нуля");
+
+        var result = new List<LineReservation>();
+        for (var i = 0; i < lines.Count; i++)
+        {
+            var line = lines[i];
+            var product = await products.GetBySkuAsync(line.Sku, ct)
+                ?? throw new NotFoundException("product.not_found", $"SKU {line.Sku} не найден");
+            // Ключ стабилен для (заказ, позиция строки): повтор вызова не создаёт второй резерв.
+            var key = $"{orderId}:{i}:{line.Sku}";
+            var id = await suppliers.ReserveAsync(product.SupplierId, orderId, line.Sku, line.Quantity, key, ct);
+            result.Add(new LineReservation(line.Sku, id));
+        }
+        return result;
+    }
+}
