+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.Reservations;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api/orders/{orderId}/reservations")]
+public sealed class ReservationsController(ReservationService reservations) : ControllerBase
+{
+    [HttpPost]
+    [ProducesResponseType<ReservationResponseDto>(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<ActionResult<ReservationResponseDto>> Create(
+        string orderId, CreateReservationRequest request, CancellationToken ct)
+    {
+        var reserved = await reservations.ReserveAsync(
+            orderId, request.Lines.Select(l => new ReservationLine(l.Sku, l.Quantity)).ToList(), ct);
+        return new ReservationResponseDto(
+            orderId, reserved.Select(r => new ReservationLineDto(r.Sku, r.Quantity, r.ReservationId)).ToList());
+    }
+}
