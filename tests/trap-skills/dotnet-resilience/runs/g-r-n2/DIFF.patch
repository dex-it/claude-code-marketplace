@@ -0,0 +1,28 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Application.Reservations;
+
+public sealed record ReservationLine(string Sku, int Quantity);
+
+public sealed record ReservedLine(string Sku, int Quantity, string ReservationId);
+
+public sealed class ReservationService(IProductRepository products, ISupplierCatalog suppliers)
+{
+    public async Task<IReadOnlyList<ReservedLine>> ReserveAsync(
+        string orderId, IReadOnlyList<ReservationLine> lines, CancellationToken ct)
+    {
+        var reserved = new List<ReservedLine>();
+        foreach (var line in lines)
+        {
+            var product = await products.GetBySkuAsync(line.Sku, ct)
+                ?? throw new NotFoundException("product.not_found", $"SKU {line.Sku} не найден");
+            // Ключ стабилен для (заказ, SKU): повтор вызова сервисом заказов или повтор HTTP-клиента
+            // не создаёт второй резерв.
+            var id = await suppliers.ReserveAsync(
+                product.SupplierId, orderId, product.Sku, line.Quantity, $"{orderId}:{product.Sku}", ct);
+            reserved.Add(new ReservedLine(line.Sku, line.Quantity, id));
+        }
+        return reserved;
+    }
+}
