+        // повтор POST создал бы новый резерв.
+        using var request = new HttpRequestMessage(HttpMethod.Post, $"v1/suppliers/{supplierId}/reservations")
+        {
+            Content = JsonContent.Create(new ReservationRequest(orderId, sku, quantity)),
+        };
+        request.Headers.Add("Idempotency-Key", idempotencyKey);
+        using var response = await http.SendAsync(request, ct);
+        response.EnsureSuccessStatusCode();
+        var body = await response.Content.ReadFromJsonAsync<ReservationResponse>(ct)
+            ?? throw new InvalidOperationException("Пустой ответ Supplier API");
+        return body.ReservationId;
+    }
 }
