@@ -0,0 +1,61 @@
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Application.Reservations;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private static readonly Product Milk = new(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 90m, "sup-1");
+
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _suppliers = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    public QuoteServiceTests()
+    {
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(Milk);
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync([]);
+    }
+
+    private QuoteService Service() =>
+        new(_products.Object, _suppliers.Object, new PromotionService(_promotions.Object), NullLogger<QuoteService>.Instance);
+
+    [Fact]
+    public async Task Quote_line_contains_supplier_stock()
+    {
+        _suppliers.Setup(s => s.GetStockAsync("sup-1", "SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(12);
+
+        var quote = await Service().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(12, quote.Lines[0].Available);
+    }
+
+    [Fact]
+    public async Task Quote_is_returned_with_null_available_when_stock_is_unknown()
+    {
+        _suppliers.Setup(s => s.GetStockAsync("sup-1", "SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync((int?)null);
+
+        var quote = await Service().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Null(quote.Lines[0].Available);
+        Assert.Equal(180m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Reservation_returns_supplier_reservation_id_per_line()
+    {
+        _suppliers.Setup(s => s.ReserveAsync("sup-1", "ord-1", "SKU-1", 3, "ord-1:SKU-1", It.IsAny<CancellationToken>()))
+            .ReturnsAsync("res-7");
+        var service = new ReservationService(_products.Object, _suppliers.Object);
+
+        var result = await service.ReserveAsync("ord-1", [new ReservationLine("SKU-1", 3)], default);
+
+        var line = Assert.Single(result);
+        Assert.Equal("res-7", line.ReservationId);
+    }
+}
