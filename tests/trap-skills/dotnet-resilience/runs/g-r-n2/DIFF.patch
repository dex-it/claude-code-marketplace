+using Microsoft.Extensions.Logging;
 using Pricing.Application.Abstractions;
 using Pricing.Application.Promotions;
 using Pricing.Domain;
@@ -6,25 +7,62 @@ namespace Pricing.Application.Quotes;
 
 public sealed record QuoteLine(string Sku, int Quantity);
 
-public sealed record QuotedLine(string Sku, int Quantity, decimal UnitPrice, decimal Total);
+public sealed record QuotedLine(string Sku, int Quantity, decimal UnitPrice, decimal Total, int? Available = null);
 
 public sealed record Quote(IReadOnlyList<QuotedLine> Lines, decimal Total, string Currency);
 
-public sealed class QuoteService(IProductRepository products, ISupplierCatalog suppliers, PromotionService promotions)
+public sealed class QuoteService(
+    IProductRepository products, ISupplierCatalog suppliers, PromotionService promotions, ILogger<QuoteService> logger)
 {
+    // Витрина ждёт ответ не дольше 3 с, наличие - необязательная часть, поэтому на неё свой бюджет.
+    private static readonly TimeSpan StockBudget = TimeSpan.FromMilliseconds(1200);
+    // Лимит поставщика - 20 запросов в секунду на ключ.
+    private const int StockConcurrency = 4;
+
     public async Task<Quote> QuoteAsync(IReadOnlyList<QuoteLine> lines, CancellationToken ct)
     {
         var quoted = new List<QuotedLine>();
+        var items = new List<(Product Product, QuoteLine Line)>();
         foreach (var line in lines)
         {
             var product = await products.GetBySkuAsync(line.Sku, ct)
                 ?? throw new NotFoundException("product.not_found", $"SKU {line.Sku} не найден");
+            items.Add((product, line));
+        }
+
+        var stock = await GetStockAsync(items.Select(i => i.Product).DistinctBy(p => p.Sku).ToList(), ct);
+
+        foreach (var (product, line) in items)
+        {
             var supplier = await suppliers.GetPriceAsync(product.SupplierId, product.Sku, ct);
             var unit = Math.Max(product.BasePrice, supplier?.Price ?? 0m);
             var discount = await promotions.CurrentDiscountAsync(product.Category, ct);
             unit = Math.Round(unit * (1 - discount / 100m), 2);
-            quoted.Add(new QuotedLine(line.Sku, line.Quantity, unit, unit * line.Quantity));
+            quoted.Add(new QuotedLine(line.Sku, line.Quantity, unit, unit * line.Quantity, stock.GetValueOrDefault(product.Sku)));
         }
         return new Quote(quoted, quoted.Sum(l => l.Total), "RUB");
     }
+
+    private async Task<Dictionary<string, int?>> GetStockAsync(IReadOnlyList<Product> items, CancellationToken ct)
+    {
+        var result = new Dictionary<string, int?>();
+        using var budget = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        budget.CancelAfter(StockBudget);
+        try
+        {
+            await Parallel.ForEachAsync(
+                items,
+                new ParallelOptions { MaxDegreeOfParallelism = StockConcurrency, CancellationToken = budget.Token },
+                async (product, token) =>
+                {
+                    var available = await suppliers.GetStockAsync(product.SupplierId, product.Sku, token);
+                    lock (result) result[product.Sku] = available;
+                });
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            logger.LogWarning("Наличие у поставщика не получено за {Budget}: часть строк котировки без available", StockBudget);
+        }
+        return result;
+    }
 }
