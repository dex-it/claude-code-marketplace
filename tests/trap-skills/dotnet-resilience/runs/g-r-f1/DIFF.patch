     }
+
+    private async Task<Dictionary<(string SupplierId, string Sku), int?>> GetAvailabilityAsync(
+        IEnumerable<Product> items, CancellationToken ct)
+    {
+        var result = new Dictionary<(string SupplierId, string Sku), int?>();
+        var distinct = items.DistinctBy(p => (p.SupplierId, p.Sku)).ToList();
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        deadline.CancelAfter(StockDeadline);
+        try
+        {
+            await Parallel.ForEachAsync(distinct,
+                new ParallelOptions { MaxDegreeOfParallelism = StockParallelism, CancellationToken = deadline.Token },
+                async (p, token) =>
+                {
+                    var value = await stock.GetAvailableAsync(p.SupplierId, p.Sku, token);
+                    lock (result) result[(p.SupplierId, p.Sku)] = value;
+                });
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            // Срок вышел: у строк без ответа available = null.
+        }
+        lock (result) return new Dictionary<(string SupplierId, string Sku), int?>(result);
+    }
