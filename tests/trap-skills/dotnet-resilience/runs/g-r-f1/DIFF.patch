+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Application.Reservations;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteAndReservationTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private static readonly Product Milk = new(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 90m, "sup-1");
+
+    private sealed class FakeStock(Func<string, int?> answer) : ISupplierStock
+    {
+        public Task<int?> GetAvailableAsync(string supplierId, string sku, CancellationToken ct) =>
+            Task.FromResult(answer(sku));
+    }
+
+    private sealed class HangingStock : ISupplierStock
+    {
+        public async Task<int?> GetAvailableAsync(string supplierId, string sku, CancellationToken ct)
+        {
+            await Task.Delay(Timeout.Infinite, ct);
+            return null;
+        }
+    }
+
+    private sealed class FakeReservations : ISupplierReservations
+    {
+        public List<string> Keys { get; } = [];
+
+        public Task<string> ReserveAsync(string supplierId, string orderId, string sku, int quantity, string idempotencyKey, CancellationToken ct)
+        {
+            Keys.Add(idempotencyKey);
+            return Task.FromResult($"res-{idempotencyKey}");
+        }
+    }
+
+    private sealed class NoPromotions : IPromotionRepository
+    {
+        public Task<IReadOnlyList<Promotion>> ListAsync(CancellationToken ct) =>
+            Task.FromResult<IReadOnlyList<Promotion>>([]);
+    }
+
+    private sealed class NoSupplierPrice : ISupplierCatalog
+    {
+        public Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct) =>
+            Task.FromResult<SupplierPrice?>(null);
+    }
+
+    private QuoteService Quotes(ISupplierStock stock)
+    {
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(Milk);
+        return new QuoteService(_products.Object, new NoSupplierPrice(), stock, new PromotionService(new NoPromotions()));
+    }
+
+    [Fact]
+    public async Task Quote_line_shows_supplier_availability()
+    {
+        var quote = await Quotes(new FakeStock(_ => 12)).QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(12, quote.Lines[0].Available);
+    }
+
+    [Fact]
+    public async Task Quote_is_returned_with_null_availability_when_stock_unknown()
+    {
+        var quote = await Quotes(new FakeStock(_ => null)).QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Null(quote.Lines[0].Available);
+        Assert.Equal(180m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Quote_is_returned_when_stock_does_not_answer_in_time()
+    {
+        var quote = await Quotes(new HangingStock()).QuoteAsync([new QuoteLine("SKU-1", 1)], default);
+
+        Assert.Null(quote.Lines[0].Available);
+        Assert.Equal(90m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Reserve_returns_reservation_per_line_with_stable_idempotency_keys()
+    {
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(Milk);
+        var supplier = new FakeReservations();
+        var service = new ReservationService(_products.Object, supplier);
+        var lines = new[] { new ReserveLine("SKU-1", 3), new ReserveLine("SKU-1", 1) };
+
+        var first = await service.ReserveAsync("ord-1", lines, default);
+        var second = await service.ReserveAsync("ord-1", lines, default);
+
+        Assert.Equal(2, first.Count);
+        Assert.NotEqual(first[0].ReservationId, first[1].ReservationId);
+        Assert.Equal(first, second);
+    }
+
+    [Fact]
+    public async Task Reserve_unknown_sku_reserves_nothing()
+    {
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(Milk);
+        var supplier = new FakeReservations();
+        var service = new ReservationService(_products.Object, supplier);
+
+        await Assert.ThrowsAsync<NotFoundException>(() =>
+            service.ReserveAsync("ord-1", [new ReserveLine("SKU-1", 1), new ReserveLine("NOPE", 1)], default));
