@@ -0,0 +1,40 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Application.Reservations;
+
+public sealed record ReserveLine(string Sku, int Quantity);
+
+public sealed record LineReservation(string Sku, string ReservationId);
+
+public sealed class ReservationService(IProductRepository products, ISupplierReservations reservations)
+{
+    public async Task<IReadOnlyList<LineReservation>> ReserveAsync(
+        string orderId, IReadOnlyList<ReserveLine> lines, CancellationToken ct)
+    {
+        if (string.IsNullOrWhiteSpace(orderId)) throw new DomainException("reservation.order_required", "orderId обязателен");
+        if (lines.Count == 0) throw new DomainException("reservation.lines_required", "Нужна хотя бы одна строка");
+        if (lines.Any(l => l.Quantity <= 0)) throw new DomainException("reservation.quantity_positive", "Количество должно быть больше нуля");
+
+        // Сначала все товары: неизвестный SKU не должен оставить частичный резерв.
+        var resolved = new List<(Product Product, ReserveLine Line)>();
+        foreach (var line in lines)
+        {
+            var product = await products.GetBySkuAsync(line.Sku, ct)
+                ?? throw new NotFoundException("product.not_found", $"SKU {line.Sku} не найден");
+            resolved.Add((product, line));
+        }
+
+        // Ключ стабилен для (заказ, позиция): повтор вызова сервисом заказов или повтор HTTP-клиента
+        // после таймаута получает тот же резерв, а не создаёт второй.
+        var result = new List<LineReservation>();
+        for (var i = 0; i < resolved.Count; i++)
+        {
+            var (product, line) = resolved[i];
+            var id = await reservations.ReserveAsync(
+                product.SupplierId, orderId, line.Sku, line.Quantity, $"{orderId}:{i}:{line.Sku}", ct);
+            result.Add(new LineReservation(line.Sku, id));
+        }
+        return result;
+    }
+}
