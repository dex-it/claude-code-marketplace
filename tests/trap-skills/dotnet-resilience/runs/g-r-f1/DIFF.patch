@@ -0,0 +1,50 @@
+using System.Diagnostics.Metrics;
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.Extensions.Logging;
+using Polly.CircuitBreaker;
+using Polly.Timeout;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class SupplierStockClient : ISupplierStock
+{
+    public const string MeterName = "Pricing.Suppliers";
+
+    private sealed record StockResponse(string Sku, int Available);
+
+    private readonly HttpClient _http;
+    private readonly ILogger<SupplierStockClient> _logger;
+    private readonly Counter<long> _fallbacks;
+
+    public SupplierStockClient(HttpClient http, ILogger<SupplierStockClient> logger, IMeterFactory meters)
+    {
+        _http = http;
+        _logger = logger;
+        _fallbacks = meters.Create(MeterName).CreateCounter<long>("pricing.supplier.stock.fallbacks");
+    }
+
+    public async Task<int?> GetAvailableAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        try
+        {
+            using var response = await _http.GetAsync(
+                $"v1/suppliers/{Uri.EscapeDataString(supplierId)}/stock/{Uri.EscapeDataString(sku)}", ct);
+            if (response.StatusCode == HttpStatusCode.NotFound) return null;
+            response.EnsureSuccessStatusCode();
+            var body = await response.Content.ReadFromJsonAsync<StockResponse>(ct);
+            return body?.Available;
+        }
+        catch (Exception ex) when (ex is HttpRequestException or TimeoutRejectedException
+                                       or BrokenCircuitException or JsonException
+                                       or OperationCanceledException && !ct.IsCancellationRequested)
+        {
+            // Наличие необязательно для котировки: отдаём null, но сбой виден в логе и метрике.
+            _fallbacks.Add(1, new KeyValuePair<string, object?>("reason", ex.GetType().Name));
+            _logger.LogWarning(ex, "Наличие {Sku} у поставщика {SupplierId} не получено, available = null", sku, supplierId);
+            return null;
+        }
+    }
+}
