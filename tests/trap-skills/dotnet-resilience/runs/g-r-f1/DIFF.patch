@@ -0,0 +1,39 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using Polly.CircuitBreaker;
+using Polly.Timeout;
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class SupplierReservationClient(HttpClient http) : ISupplierReservations
+{
+    private sealed record ReservationRequest(string OrderId, string Sku, int Quantity);
+
+    private sealed record ReservationResponse(string ReservationId);
+
+    public async Task<string> ReserveAsync(
+        string supplierId, string orderId, string sku, int quantity, string idempotencyKey, CancellationToken ct)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, $"v1/suppliers/{Uri.EscapeDataString(supplierId)}/reservations")
+        {
+            Content = JsonContent.Create(new ReservationRequest(orderId, sku, quantity)),
+        };
+        // Без ключа каждый повтор (наш или клиента resilience) создал бы ещё один резерв.
+        request.Headers.Add("Idempotency-Key", idempotencyKey);
+        try
+        {
+            using var response = await http.SendAsync(request, ct);
+            response.EnsureSuccessStatusCode();
+            var body = await response.Content.ReadFromJsonAsync<ReservationResponse>(ct);
+            return body?.ReservationId ?? throw new SupplierUnavailableException("Пустой ответ Supplier API");
+        }
+        catch (Exception ex) when (ex is HttpRequestException or TimeoutRejectedException
+                                       or BrokenCircuitException or JsonException
+                                       or OperationCanceledException && !ct.IsCancellationRequested)
+        {
+            throw new SupplierUnavailableException($"Поставщик {supplierId} не принял резерв: {ex.Message}");
+        }
+    }
+}
