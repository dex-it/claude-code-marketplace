diff --git a/src/Pricing.Infrastructure/Suppliers/SupplierReservationClient.cs b/src/Pricing.Infrastructure/Suppliers/SupplierReservationClient.cs
new file mode 100644
index 0000000..eae1c73
--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/SupplierReservationClient.cs
@@ -0,0 +1,26 @@
+using System.Net.Http.Json;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class SupplierReservationClient(HttpClient http) : ISupplierReservations
+{
+    private sealed record ReserveRequest(string OrderId, string Sku, int Quantity);
+
+    private sealed record ReserveResponse(string ReservationId);
+
+    public async Task<string> ReserveAsync(string supplierId, string orderId, string sku, int quantity, CancellationToken ct)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, $"v1/suppliers/{supplierId}/reservations")
+        {
+            Content = JsonContent.Create(new ReserveRequest(orderId, sku, quantity))
+        };
+        // Ключ детерминирован: повторы resilience-handler и повторный вызов заказов не плодят резервы.
+        request.Headers.Add("Idempotency-Key", $"reserve:{supplierId}:{orderId}:{sku}");
+        using var response = await http.SendAsync(request, ct);
+        response.EnsureSuccessStatusCode();
+        var body = await response.Content.ReadFromJsonAsync<ReserveResponse>(ct)
+            ?? throw new InvalidOperationException("Пустой ответ Supplier API");
+        return body.ReservationId;
+    }
+}
