@@ -0,0 +1,43 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Application.Reservations;
+
+public sealed record ReservationLine(string Sku, int Quantity);
+
+public sealed record ReservedLine(string Sku, int Quantity, string ReservationId);
+
+public sealed class ReservationService(IProductRepository products, ISupplierReservations reservations)
+{
+    /// <summary>
+    /// Резервирует строки заказа. Повтор вызова с тем же заказом безопасен: у поставщика резерв
+    /// идемпотентен по (orderId, sku), поэтому SKU в заказе должны быть уникальны.
+    /// </summary>
+    public async Task<IReadOnlyList<ReservedLine>> ReserveAsync(string orderId, IReadOnlyList<ReservationLine> lines, CancellationToken ct)
+    {
+        if (string.IsNullOrWhiteSpace(orderId))
+            throw new DomainException("reservation.invalid", "Не указан orderId");
+        if (lines.Count == 0)
+            throw new DomainException("reservation.invalid", "Нет строк для резерва");
+        if (lines.Any(l => l.Quantity <= 0))
+            throw new DomainException("reservation.invalid", "Количество должно быть положительным");
+        if (lines.Select(l => l.Sku).Distinct().Count() != lines.Count)
+            throw new DomainException("reservation.invalid", "SKU в заказе должны быть уникальны");
+
+        var supplierBySku = new Dictionary<string, string>();
+        foreach (var line in lines)
+        {
+            var product = await products.GetBySkuAsync(line.Sku, ct)
+                ?? throw new NotFoundException("product.not_found", $"SKU {line.Sku} не найден");
+            supplierBySku[line.Sku] = product.SupplierId;
+        }
+
+        var result = new List<ReservedLine>();
+        foreach (var line in lines)
+        {
+            var id = await reservations.ReserveAsync(supplierBySku[line.Sku], orderId, line.Sku, line.Quantity, ct);
+            result.Add(new ReservedLine(line.Sku, line.Quantity, id));
+        }
+        return result;
+    }
+}
