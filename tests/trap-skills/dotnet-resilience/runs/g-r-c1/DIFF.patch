     }
+
+    private const int MaxParallelStockRequests = 5;
+
+    /// <summary>Наличие не критично для котировки: любая ошибка поставщика даёт null.</summary>
+    private async Task<int?> GetAvailableOrNullAsync(SemaphoreSlim limiter, string supplierId, string sku, CancellationToken ct)
