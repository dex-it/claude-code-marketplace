+        try
+        {
+            return await stock.GetAvailableAsync(supplierId, sku, ct);
+        }
+        catch (Exception) when (!ct.IsCancellationRequested)
+        {
+            return null;
+        }
+        finally
+        {
+            limiter.Release();
+        }
