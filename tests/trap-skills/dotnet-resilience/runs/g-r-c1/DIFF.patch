+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.Reservations;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api/reservations")]
+public sealed class ReservationsController(ReservationService reservations) : ControllerBase
+{
+    /// <summary>Резерв строк заказа у поставщика. Повтор с тем же заказом возвращает те же резервы.</summary>
+    [HttpPost]
+    public async Task<ActionResult<ReserveOrderResponse>> Reserve(ReserveOrderRequest request, CancellationToken ct)
+    {
+        var lines = request.Lines.Select(l => new ReservationLine(l.Sku, l.Quantity)).ToList();
+        var reserved = await reservations.ReserveAsync(request.OrderId, lines, ct);
+        return new ReserveOrderResponse(request.OrderId,
+            reserved.Select(r => new ReservedLineResponse(r.Sku, r.Quantity, r.ReservationId)).ToList());
+    }
+}
