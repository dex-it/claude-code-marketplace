diff --git a/src/Pricing.Application/Quotes/ReservationService.cs b/src/Pricing.Application/Quotes/ReservationService.cs
new file mode 100644
index 0000000..16e5d45
--- /dev/null
+++ b/src/Pricing.Application/Quotes/ReservationService.cs
@@ -0,0 +1,33 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Application.Quotes;
+
+public sealed record ReservationLine(string Sku, int Quantity);
+
+public sealed record ReservedLine(string Sku, int Quantity, string ReservationId);
+
+public sealed class ReservationService(IProductRepository products, ISupplierCatalog suppliers)
+{
+    public async Task<IReadOnlyList<ReservedLine>> ReserveAsync(string orderId, IReadOnlyList<ReservationLine> lines, CancellationToken ct)
+    {
+        if (string.IsNullOrWhiteSpace(orderId))
+            throw new DomainException("reservation.invalid", "Не указан orderId");
+        if (lines.Any(l => l.Quantity <= 0))
+            throw new DomainException("reservation.invalid", "Количество должно быть положительным");
+        if (lines.GroupBy(l => l.Sku).Any(g => g.Count() > 1))
+            throw new DomainException("reservation.duplicate_sku", "SKU повторяется в строках заказа");
+
+        var reserved = new List<ReservedLine>();
+        foreach (var line in lines)
+        {
+            var product = await products.GetBySkuAsync(line.Sku, ct)
+                ?? throw new NotFoundException("product.not_found", $"SKU {line.Sku} не найден");
+            // Ключ детерминирован: повтор вызова сервиса заказов вернёт тот же резерв, а не создаст новый.
+            var key = $"{orderId}:{line.Sku}:{line.Quantity}";
+            var id = await suppliers.ReserveAsync(product.SupplierId, orderId, line.Sku, line.Quantity, key, ct);
+            reserved.Add(new ReservedLine(line.Sku, line.Quantity, id));
+        }
+        return reserved;
+    }
+}
