+namespace Pricing.Api.Controllers;
+
+public sealed record ReserveRequest(string OrderId, IReadOnlyList<ReservationLine> Lines);
+
+public sealed record ReserveResponse(IReadOnlyList<ReservedLine> Lines);
+
+[ApiController]
+[Route("api/reservations")]
+public sealed class ReservationsController(ReservationService reservations) : ControllerBase
+{
+    [HttpPost]
+    public async Task<ActionResult<ReserveResponse>> Create(ReserveRequest request, CancellationToken ct) =>
+        new ReserveResponse(await reservations.ReserveAsync(request.OrderId, request.Lines, ct));
+}
