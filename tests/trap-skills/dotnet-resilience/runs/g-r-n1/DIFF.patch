@@ -0,0 +1,31 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Application.Reservations;
+
+public sealed record ReserveLine(string Sku, int Quantity);
+
+public sealed record ReservedLine(string Sku, string ReservationId);
+
+public sealed class ReservationService(IProductRepository products, ISupplierReservations reservations)
+{
+    public async Task<IReadOnlyList<ReservedLine>> ReserveAsync(string orderId, IReadOnlyList<ReserveLine> lines, CancellationToken ct)
+    {
+        if (lines.Count == 0)
+            throw new DomainException("reservation.empty", "В заказе нет строк");
+        if (lines.Any(l => l.Quantity <= 0))
+            throw new DomainException("reservation.bad_quantity", "Количество должно быть больше нуля");
+        if (lines.Select(l => l.Sku).Distinct().Count() != lines.Count)
+            throw new DomainException("reservation.duplicate_sku", "SKU в строках заказа должны быть уникальны");
+
+        var result = new List<ReservedLine>();
+        foreach (var line in lines)
+        {
+            var product = await products.GetBySkuAsync(line.Sku, ct)
+                ?? throw new NotFoundException("product.not_found", $"SKU {line.Sku} не найден");
+            var id = await reservations.ReserveAsync(product.SupplierId, orderId, product.Sku, line.Quantity, ct);
+            result.Add(new ReservedLine(line.Sku, id));
+        }
+        return result;
+    }
+}
