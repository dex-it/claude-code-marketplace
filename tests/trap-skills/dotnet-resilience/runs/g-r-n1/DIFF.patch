+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Reservations;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class ReservationServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierReservations> _supplier = new();
+
+    private ReservationService CreateService()
+    {
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>()))
+            .ReturnsAsync(new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 89.9m, "sup-1"));
+        _supplier.Setup(s => s.ReserveAsync("sup-1", "ord-1", "SKU-1", 3, It.IsAny<CancellationToken>()))
+            .ReturnsAsync("res-1");
+        return new ReservationService(_products.Object, _supplier.Object);
+    }
+
+    [Fact]
+    public async Task Reserve_returns_reservation_id_per_line()
+    {
+        var result = await CreateService().ReserveAsync("ord-1", [new ReserveLine("SKU-1", 3)], default);
+
+        var line = Assert.Single(result);
+        Assert.Equal("SKU-1", line.Sku);
+        Assert.Equal("res-1", line.ReservationId);
+    }
+
+    [Fact]
+    public async Task Reserve_rejects_duplicate_sku()
+    {
+        var ex = await Assert.ThrowsAsync<DomainException>(() =>
+            CreateService().ReserveAsync("ord-1", [new ReserveLine("SKU-1", 1), new ReserveLine("SKU-1", 2)], default));
+
+        Assert.Equal("reservation.duplicate_sku", ex.Code);
+    }
+
+    [Fact]
+    public async Task Reserve_rejects_non_positive_quantity()
+    {
+        var ex = await Assert.ThrowsAsync<DomainException>(() =>
+            CreateService().ReserveAsync("ord-1", [new ReserveLine("SKU-1", 0)], default));
+
+        Assert.Equal("reservation.bad_quantity", ex.Code);
+    }
+}
