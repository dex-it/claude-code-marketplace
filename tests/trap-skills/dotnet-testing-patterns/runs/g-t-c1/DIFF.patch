+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _suppliers = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private sealed class AlwaysNoon : TimeProvider
+    {
+        public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.Utc;
+        public override DateTimeOffset GetUtcNow() => new(2026, 1, 1, 12, 0, 0, TimeSpan.Zero);
+    }
+
+    private QuoteService Create(params Promotion[] promos)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(promos);
+        return new QuoteService(_products.Object, _suppliers.Object,
+            new PromotionService(_promotions.Object, new AlwaysNoon()));
+    }
+
+    private void Setup(decimal basePrice, decimal? supplierPrice)
+    {
+        var product = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, basePrice, "sup-1");
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(product);
+        _suppliers.Setup(s => s.GetPriceAsync("sup-1", "SKU-1", It.IsAny<CancellationToken>()))
+            .ReturnsAsync(supplierPrice is null ? null : new SupplierPrice("SKU-1", supplierPrice.Value, "RUB"));
+    }
+
+    [Theory]
+    [InlineData(100, 120, 120)]
+    [InlineData(100, 80, 100)]
+    public async Task Unit_price_is_max_of_base_and_supplier(decimal basePrice, decimal supplier, decimal expected)
+    {
+        Setup(basePrice, supplier);
+        var quote = await Create().QuoteAsync([new QuoteLine("SKU-1", 3)], default);
+
+        Assert.Equal(expected, quote.Lines[0].UnitPrice);
+        Assert.Equal(expected * 3, quote.Total);
+        Assert.Equal("RUB", quote.Currency);
+    }
+
+    [Fact]
+    public async Task Applies_promo_discount()
+    {
+        Setup(200, 150);
+        var promo = new Promotion(Guid.NewGuid(), Category.Grocery, 15, new TimeOnly(0, 0), new TimeOnly(23, 59));
+
+        var quote = await Create(promo).QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(170m, quote.Lines[0].UnitPrice);
+        Assert.Equal(340m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Supplier_does_not_know_sku_uses_base_price()
+    {
+        Setup(100, null);
+        var quote = await Create().QuoteAsync([new QuoteLine("SKU-1", 1)], default);
+        Assert.Equal(100m, quote.Lines[0].UnitPrice);
+    }
+
+    [Fact]
+    public async Task Unknown_sku_throws_not_found()
+    {
+        var service = Create();
+        var ex = await Assert.ThrowsAsync<NotFoundException>(() =>
+            service.QuoteAsync([new QuoteLine("NOPE", 1)], default));
+        Assert.Equal("product.not_found", ex.Code);
+    }
+}
