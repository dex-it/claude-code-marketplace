+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PromotionServiceTests
+{
+    private sealed class FixedClock(TimeOnly time) : TimeProvider
+    {
+        public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.Utc;
+        public override DateTimeOffset GetUtcNow() => new(2026, 1, 1, time.Hour, time.Minute, 0, TimeSpan.Zero);
+    }
+
+    private static Promotion Promo(Category c, decimal d, string from, string to) =>
+        new(Guid.NewGuid(), c, d, TimeOnly.Parse(from), TimeOnly.Parse(to));
+
+    private static PromotionService Create(string now, params Promotion[] promos)
+    {
+        var repo = new Mock<IPromotionRepository>();
+        repo.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(promos);
+        return new PromotionService(repo.Object, new FixedClock(TimeOnly.Parse(now)));
+    }
+
+    [Theory]
+    [InlineData("12:00", 10)]
+    [InlineData("09:00", 10)]
+    [InlineData("08:59", 0)]
+    [InlineData("18:00", 0)]
+    public async Task Daytime_window(string now, int expected)
+    {
+        var service = Create(now, Promo(Category.Grocery, 10, "09:00", "18:00"));
+        Assert.Equal(expected, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Theory]
+    [InlineData("23:00", 15)]
+    [InlineData("22:00", 15)]
+    [InlineData("01:00", 15)]
+    [InlineData("02:00", 0)]
+    [InlineData("12:00", 0)]
+    public async Task Window_across_midnight(string now, int expected)
+    {
+        var service = Create(now, Promo(Category.Grocery, 15, "22:00", "02:00"));
+        Assert.Equal(expected, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Picks_largest_discount_of_category()
+    {
+        var service = Create("12:00",
+            Promo(Category.Grocery, 5, "09:00", "18:00"),
+            Promo(Category.Grocery, 20, "10:00", "14:00"),
+            Promo(Category.Grocery, 50, "15:00", "18:00"),
+            Promo(Category.Electronics, 70, "09:00", "18:00"));
+        Assert.Equal(20, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Category_without_promotions_has_no_discount()
+    {
+        var service = Create("12:00", Promo(Category.Grocery, 10, "09:00", "18:00"));
+        Assert.Equal(0, await service.CurrentDiscountAsync(Category.Household, default));
+    }
+}
