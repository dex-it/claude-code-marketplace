@@ -0,0 +1,94 @@
+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PromotionServiceTests
+{
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private PromotionService CreateService(Promotion[] items, int hour, int minute = 0)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(items);
+        return new PromotionService(_promotions.Object, new FixedTimeProvider(new DateTime(2026, 1, 1, hour, minute, 0, DateTimeKind.Utc)));
+    }
+
+    private static Promotion Promo(Category category, decimal percent, int fromHour, int toHour) =>
+        new(Guid.NewGuid(), category, percent, new TimeOnly(fromHour, 0), new TimeOnly(toHour, 0));
+
+    [Fact]
+    public async Task Discount_applies_inside_window()
+    {
+        var service = CreateService([Promo(Category.Grocery, 10, 9, 18)], hour: 12);
+
+        Assert.Equal(10m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Theory]
+    [InlineData(8, 59)]
+    [InlineData(18, 0)]
+    public async Task Discount_is_zero_outside_window(int hour, int minute)
+    {
+        var service = CreateService([Promo(Category.Grocery, 10, 9, 18)], hour, minute);
+
+        Assert.Equal(0m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Window_start_is_inclusive()
+    {
+        var service = CreateService([Promo(Category.Grocery, 10, 9, 18)], hour: 9);
+
+        Assert.Equal(10m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Theory]
+    [InlineData(22, true)]
+    [InlineData(23, true)]
+    [InlineData(1, true)]
+    [InlineData(2, false)]
+    [InlineData(12, false)]
+    public async Task Window_across_midnight(int hour, bool active)
+    {
+        var service = CreateService([Promo(Category.Grocery, 15, 22, 2)], hour);
+
+        Assert.Equal(active ? 15m : 0m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Picks_largest_discount_among_active()
+    {
+        var service = CreateService(
+        [
+            Promo(Category.Grocery, 5, 9, 18),
+            Promo(Category.Grocery, 20, 10, 14),
+            Promo(Category.Grocery, 50, 15, 18),
+        ], hour: 12);
+
+        Assert.Equal(20m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Ignores_other_categories()
+    {
+        var service = CreateService([Promo(Category.Electronics, 30, 0, 23)], hour: 12);
+
+        Assert.Equal(0m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Category_without_promotions_has_zero_discount()
+    {
+        var service = CreateService([], hour: 12);
+
+        Assert.Equal(0m, await service.CurrentDiscountAsync(Category.Household, default));
+    }
+}
+
+internal sealed class FixedTimeProvider(DateTime utc) : TimeProvider
+{
+    public override DateTimeOffset GetUtcNow() => new(DateTime.SpecifyKind(utc, DateTimeKind.Utc));
+    public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.Utc;
+}
