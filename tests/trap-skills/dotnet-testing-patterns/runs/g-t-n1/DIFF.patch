+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceChangeWorkerTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly PriceChangeQueue _queue = new();
+
+    private Product GivenProduct(decimal price)
+    {
+        var product = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, price, "sup-1");
+        _products.Setup(r => r.GetAsync(product.Id, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+        return product;
+    }
+
+    private async Task<List<(PriceChange Change, Exception Error)>> RunAsync(params PriceChange[] changes)
+    {
+        var worker = new PriceChangeWorker(_queue, _products.Object);
+        var failures = new List<(PriceChange, Exception)>();
+        worker.Failed += (c, e) => failures.Add((c, e));
+        foreach (var change in changes) await _queue.EnqueueAsync(change, default);
+        _queue.Complete();
+        await worker.RunAsync(default);
+        return failures;
+    }
+
+    [Fact]
+    public async Task Change_is_applied_to_product()
+    {
+        var product = GivenProduct(100m);
+
+        var failures = await RunAsync(new PriceChange(product.Id, 150m));
+
+        Assert.Equal(150m, product.BasePrice);
+        Assert.Empty(failures);
+    }
+
+    [Fact]
+    public async Task Unknown_product_does_not_stop_next_changes()
+    {
+        var product = GivenProduct(100m);
+        var unknown = new PriceChange(Guid.NewGuid(), 10m);
+
+        var failures = await RunAsync(unknown, new PriceChange(product.Id, 120m));
+
+        Assert.Equal(120m, product.BasePrice);
+        var failure = Assert.Single(failures);
+        Assert.Equal(unknown, failure.Change);
+    }
+}
