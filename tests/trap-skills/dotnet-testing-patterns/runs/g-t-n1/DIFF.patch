+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _suppliers = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private QuoteService CreateService(params Promotion[] active)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(active);
+        var clock = new FixedTimeProvider(new DateTime(2026, 1, 1, 12, 0, 0, DateTimeKind.Utc));
+        return new QuoteService(_products.Object, _suppliers.Object, new PromotionService(_promotions.Object, clock));
+    }
+
+    private void GivenProduct(string sku, decimal basePrice, Category category = Category.Grocery) =>
+        _products.Setup(r => r.GetBySkuAsync(sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(new Product(Guid.NewGuid(), sku, "Товар", category, basePrice, "sup-1"));
+
+    private void GivenSupplierPrice(string sku, decimal? price) =>
+        _suppliers.Setup(s => s.GetPriceAsync("sup-1", sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(price is null ? null : new SupplierPrice(sku, price.Value, "RUB"));
+
+    [Theory]
+    [InlineData(100, 120, 120)]
+    [InlineData(100, 80, 100)]
+    public async Task Unit_price_is_max_of_base_and_supplier(decimal basePrice, decimal supplierPrice, decimal expected)
+    {
+        GivenProduct("SKU-1", basePrice);
+        GivenSupplierPrice("SKU-1", supplierPrice);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 3)], default);
+
+        var line = Assert.Single(quote.Lines);
+        Assert.Equal(expected, line.UnitPrice);
+        Assert.Equal(expected * 3, line.Total);
+        Assert.Equal(expected * 3, quote.Total);
+        Assert.Equal("RUB", quote.Currency);
+    }
+
+    [Fact]
+    public async Task Sku_unknown_to_supplier_uses_base_price()
+    {
+        GivenProduct("SKU-1", 100m);
+        GivenSupplierPrice("SKU-1", null);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 1)], default);
+
+        Assert.Equal(100m, Assert.Single(quote.Lines).UnitPrice);
+    }
+
+    [Fact]
+    public async Task Promo_discount_is_applied_to_unit_price()
+    {
+        GivenProduct("SKU-1", 99.99m);
+        GivenSupplierPrice("SKU-1", null);
+        var promo = new Promotion(Guid.NewGuid(), Category.Grocery, 10m, new TimeOnly(9, 0), new TimeOnly(18, 0));
+
+        var quote = await CreateService(promo).QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        var line = Assert.Single(quote.Lines);
+        Assert.Equal(89.99m, line.UnitPrice); // 89.991 -> 89.99
+        Assert.Equal(179.98m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Unknown_sku_throws_not_found()
+    {
+        _products.Setup(r => r.GetBySkuAsync("NOPE", It.IsAny<CancellationToken>())).ReturnsAsync((Product?)null);
+
+        var ex = await Assert.ThrowsAsync<NotFoundException>(() =>
+            CreateService().QuoteAsync([new QuoteLine("NOPE", 1)], default));
+
+        Assert.Equal("product.not_found", ex.Code);
+    }
+
+    [Fact]
+    public async Task Total_sums_all_lines()
+    {
+        GivenProduct("A", 10m);
+        GivenSupplierPrice("A", null);
+        GivenProduct("B", 25m);
+        GivenSupplierPrice("B", null);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("A", 2), new QuoteLine("B", 1)], default);
+
+        Assert.Equal(2, quote.Lines.Count);
+        Assert.Equal(45m, quote.Total);
+    }
+}
