+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class VolumeDiscountTests
+{
+    [Theory]
+    [InlineData(1, 0)]
+    [InlineData(9, 0)]
+    [InlineData(10, 3)]
+    [InlineData(49, 3)]
+    [InlineData(50, 5)]
+    [InlineData(1000, 5)]
+    public void Percent_depends_on_quantity_tier(int quantity, decimal expected)
+    {
+        Assert.Equal(expected, VolumeDiscount.PercentFor(quantity));
+    }
+
+    [Theory]
+    [InlineData(100.00, 9, 100.00)]
+    [InlineData(100.00, 10, 97.00)]
+    [InlineData(100.00, 50, 95.00)]
+    public void Apply_reduces_unit_price_by_tier(double price, int quantity, double expected)
+    {
+        Assert.Equal((decimal)expected, VolumeDiscount.Apply((decimal)price, quantity));
+    }
+
+    [Fact]
+    public void Apply_rounds_unit_price_to_kopecks()
+    {
+        // 89.90 * 0.97 = 87.203
+        Assert.Equal(87.20m, VolumeDiscount.Apply(89.90m, 10));
+    }
+}
