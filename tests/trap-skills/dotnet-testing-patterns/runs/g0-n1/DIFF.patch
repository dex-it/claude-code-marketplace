--- /dev/null
+++ b/src/Pricing.Domain/VolumeDiscount.cs
@@ -0,0 +1,16 @@
+namespace Pricing.Domain;
+
+/// <summary>Скидка за объём по количеству единиц в строке: 1-9 - 0%, 10-49 - 3%, 50 и больше - 5%.</summary>
+public static class VolumeDiscount
+{
+    public static decimal PercentFor(int quantity) => quantity switch
+    {
+        >= 50 => 5m,
+        >= 10 => 3m,
+        _ => 0m,
+    };
+
+    /// <summary>Применяет скидку за объём к цене единицы (уже с промо-скидкой), округляя до копеек.</summary>
+    public static decimal Apply(decimal unitPrice, int quantity) =>
+        Math.Round(unitPrice * (1 - PercentFor(quantity) / 100m), 2);
+}
