+namespace Pricing.Tests;
+
+internal sealed class FixedTimeProvider(TimeOnly localTime) : TimeProvider
+{
+    public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.Utc;
+
+    public override DateTimeOffset GetUtcNow() =>
+        new(new DateTime(2026, 1, 15).Add(localTime.ToTimeSpan()), TimeSpan.Zero);
+}
