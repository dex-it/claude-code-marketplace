+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PromotionServiceTests
+{
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private PromotionService CreateService(string now, params Promotion[] existing)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(existing);
+        return new PromotionService(_promotions.Object, new FixedTimeProvider(TimeOnly.Parse(now)));
+    }
+
+    private static Promotion Promo(Category category, decimal percent, string from, string to) =>
+        new(Guid.NewGuid(), category, percent, TimeOnly.Parse(from), TimeOnly.Parse(to));
+
+    [Theory]
+    [InlineData("12:00", 10)]
+    [InlineData("09:00", 10)]
+    [InlineData("08:59", 0)]
+    [InlineData("18:00", 0)]
+    public async Task Discount_respects_daytime_window(string now, int expected)
+    {
+        var service = CreateService(now, Promo(Category.Grocery, 10, "09:00", "18:00"));
+
+        var discount = await service.CurrentDiscountAsync(Category.Grocery, default);
+
+        Assert.Equal(expected, discount);
+    }
+
+    [Theory]
+    [InlineData("23:30", 15)]
+    [InlineData("01:00", 15)]
+    [InlineData("02:00", 0)]
+    [InlineData("12:00", 0)]
+    [InlineData("21:59", 0)]
+    public async Task Discount_respects_window_crossing_midnight(string now, int expected)
+    {
+        var service = CreateService(now, Promo(Category.Grocery, 15, "22:00", "02:00"));
+
+        var discount = await service.CurrentDiscountAsync(Category.Grocery, default);
+
+        Assert.Equal(expected, discount);
+    }
+
+    [Fact]
+    public async Task Discount_picks_largest_active_for_category()
+    {
+        var service = CreateService("12:00",
+            Promo(Category.Grocery, 5, "09:00", "18:00"),
+            Promo(Category.Grocery, 20, "10:00", "14:00"),
+            Promo(Category.Grocery, 50, "15:00", "18:00"),
+            Promo(Category.Electronics, 70, "09:00", "18:00"));
+
+        var discount = await service.CurrentDiscountAsync(Category.Grocery, default);
+
+        Assert.Equal(20, discount);
+    }
+
+    [Fact]
+    public async Task Discount_is_zero_for_category_without_promotions()
+    {
+        var service = CreateService("12:00", Promo(Category.Electronics, 30, "09:00", "18:00"));
+
+        var discount = await service.CurrentDiscountAsync(Category.Household, default);
+
+        Assert.Equal(0m, discount);
+    }
+}
