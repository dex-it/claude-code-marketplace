+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _suppliers = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    public QuoteServiceTests()
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(Array.Empty<Promotion>());
+    }
+
+    private QuoteService CreateService() =>
+        new(_products.Object, _suppliers.Object,
+            new PromotionService(_promotions.Object, new FixedTimeProvider(new TimeOnly(12, 0))));
+
+    private void AddProduct(string sku, decimal basePrice, Category category = Category.Grocery) =>
+        _products.Setup(r => r.GetBySkuAsync(sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(new Product(Guid.NewGuid(), sku, "Товар", category, basePrice, "sup-1"));
+
+    private void SetSupplierPrice(string sku, decimal? price) =>
+        _suppliers.Setup(s => s.GetPriceAsync("sup-1", sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(price is null ? null : new SupplierPrice(sku, price.Value, "RUB"));
+
+    [Theory]
+    [InlineData(100, 120, 120)]
+    [InlineData(100, 80, 100)]
+    public async Task Unit_price_is_greater_of_base_and_supplier(decimal basePrice, decimal supplier, decimal expected)
+    {
+        AddProduct("SKU-1", basePrice);
+        SetSupplierPrice("SKU-1", supplier);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 3)], default);
+
+        Assert.Equal(expected, quote.Lines[0].UnitPrice);
+        Assert.Equal(expected * 3, quote.Total);
+        Assert.Equal("RUB", quote.Currency);
+    }
+
+    [Fact]
+    public async Task Unknown_supplier_sku_falls_back_to_base_price()
+    {
+        AddProduct("SKU-1", 100m);
+        SetSupplierPrice("SKU-1", null);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(100m, quote.Lines[0].UnitPrice);
+        Assert.Equal(200m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Promo_discount_is_applied_to_unit_price()
+    {
+        AddProduct("SKU-1", 99.99m);
+        SetSupplierPrice("SKU-1", null);
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(
+            [new Promotion(Guid.NewGuid(), Category.Grocery, 10m, new TimeOnly(9, 0), new TimeOnly(18, 0))]);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(89.99m, quote.Lines[0].UnitPrice);
+        Assert.Equal(179.98m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Unknown_sku_in_cart_throws_not_found()
+    {
+        AddProduct("SKU-1", 100m);
+        SetSupplierPrice("SKU-1", null);
+
+        var ex = await Assert.ThrowsAsync<NotFoundException>(() =>
+            CreateService().QuoteAsync([new QuoteLine("SKU-1", 1), new QuoteLine("NOPE", 1)], default));
+
+        Assert.Equal("product.not_found", ex.Code);
+    }
+}
