+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceChangeWorkerTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly PriceChangeQueue _queue = new();
+
+    [Fact]
+    public async Task Change_is_applied_to_product()
+    {
+        var product = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 100m, "sup-1");
+        _products.Setup(r => r.GetAsync(product.Id, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+        await _queue.EnqueueAsync(new PriceChange(product.Id, 120m), default);
+        _queue.Complete();
+
+        await new PriceChangeWorker(_queue, _products.Object).RunAsync(default);
+
+        Assert.Equal(120m, product.BasePrice);
+    }
+
+    [Fact]
+    public async Task Unknown_product_does_not_stop_following_changes()
+    {
+        var missingId = Guid.NewGuid();
+        var product = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 100m, "sup-1");
+        _products.Setup(r => r.GetAsync(product.Id, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+        await _queue.EnqueueAsync(new PriceChange(missingId, 50m), default);
+        await _queue.EnqueueAsync(new PriceChange(product.Id, 130m), default);
+        _queue.Complete();
+        var worker = new PriceChangeWorker(_queue, _products.Object);
+        var failed = new List<PriceChange>();
+        worker.Failed += (change, _) => failed.Add(change);
+
+        await worker.RunAsync(default);
+
+        Assert.Equal(130m, product.BasePrice);
+        Assert.Equal(missingId, Assert.Single(failed).ProductId);
+    }
+}
