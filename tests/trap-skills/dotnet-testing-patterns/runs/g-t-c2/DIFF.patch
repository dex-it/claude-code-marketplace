+namespace Pricing.Tests;
+
+/// <summary>Часы с фиксированным местным временем (часовой пояс - UTC).</summary>
+internal sealed class TestClock(TimeOnly time) : TimeProvider
+{
+    public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.Utc;
+
+    public override DateTimeOffset GetUtcNow() =>
+        new(new DateOnly(2026, 1, 15), time, TimeSpan.Zero);
+}
