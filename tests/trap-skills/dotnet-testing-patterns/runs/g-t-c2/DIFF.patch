+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _suppliers = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private QuoteService CreateService(params Promotion[] promos)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(promos);
+        var promotionService = new PromotionService(_promotions.Object, new TestClock(new TimeOnly(12, 0)));
+        return new QuoteService(_products.Object, _suppliers.Object, promotionService);
+    }
+
+    private void GivenProduct(string sku, decimal basePrice, Category category = Category.Grocery)
+    {
+        var product = new Product(Guid.NewGuid(), sku, "Товар", category, basePrice, "sup-1");
+        _products.Setup(r => r.GetBySkuAsync(sku, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+    }
+
+    private void GivenSupplierPrice(string sku, decimal? price) =>
+        _suppliers.Setup(s => s.GetPriceAsync("sup-1", sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(price is null ? null : new SupplierPrice(sku, price.Value, "RUB"));
+
+    [Theory]
+    [InlineData(100, 120, 120)]
+    [InlineData(100, 80, 100)]
+    public async Task Unit_price_is_max_of_base_and_supplier_price(decimal basePrice, decimal supplierPrice, decimal expected)
+    {
+        GivenProduct("SKU-1", basePrice);
+        GivenSupplierPrice("SKU-1", supplierPrice);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 1)], default);
+
+        Assert.Equal(expected, quote.Lines[0].UnitPrice);
+    }
+
+    [Fact]
+    public async Task Applies_promo_discount_and_totals()
+    {
+        GivenProduct("SKU-1", 100m);
+        GivenSupplierPrice("SKU-1", null);
+        var promo = new Promotion(Guid.NewGuid(), Category.Grocery, 10, new TimeOnly(10, 0), new TimeOnly(14, 0));
+
+        var quote = await CreateService(promo).QuoteAsync([new QuoteLine("SKU-1", 3)], default);
+
+        Assert.Equal(90m, quote.Lines[0].UnitPrice);
+        Assert.Equal(270m, quote.Lines[0].Total);
+        Assert.Equal(270m, quote.Total);
+        Assert.Equal("RUB", quote.Currency);
+    }
+
+    [Fact]
+    public async Task Promo_of_other_category_is_not_applied()
+    {
+        GivenProduct("SKU-1", 100m);
+        GivenSupplierPrice("SKU-1", null);
+        var promo = new Promotion(Guid.NewGuid(), Category.Electronics, 50, new TimeOnly(10, 0), new TimeOnly(14, 0));
+
+        var quote = await CreateService(promo).QuoteAsync([new QuoteLine("SKU-1", 1)], default);
+
+        Assert.Equal(100m, quote.Lines[0].UnitPrice);
+    }
+
+    [Fact]
+    public async Task Supplier_not_knowing_sku_falls_back_to_base_price()
+    {
+        GivenProduct("SKU-1", 100m);
+        GivenSupplierPrice("SKU-1", null);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(100m, quote.Lines[0].UnitPrice);
+        Assert.Equal(200m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Unknown_sku_throws_not_found()
+    {
+        _products.Setup(r => r.GetBySkuAsync("NOPE", It.IsAny<CancellationToken>())).ReturnsAsync((Product?)null);
+
+        var ex = await Assert.ThrowsAsync<NotFoundException>(() =>
+            CreateService().QuoteAsync([new QuoteLine("NOPE", 1)], default));
+
+        Assert.Equal("product.not_found", ex.Code);
+    }
+}
