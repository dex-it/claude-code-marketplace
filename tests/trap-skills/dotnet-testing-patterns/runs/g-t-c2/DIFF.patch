+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PromotionServiceTests
+{
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private PromotionService CreateService(string now, params Promotion[] promos)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(promos);
+        return new PromotionService(_promotions.Object, new TestClock(TimeOnly.Parse(now)));
+    }
+
+    private static Promotion Promo(Category category, decimal percent, string from, string to) =>
+        new(Guid.NewGuid(), category, percent, TimeOnly.Parse(from), TimeOnly.Parse(to));
+
+    [Theory]
+    [InlineData("09:59", 0)]
+    [InlineData("10:00", 15)]
+    [InlineData("13:59", 15)]
+    [InlineData("14:00", 0)]
+    public async Task Daytime_window_includes_start_and_excludes_end(string now, int expected)
+    {
+        var service = CreateService(now, Promo(Category.Grocery, 15, "10:00", "14:00"));
+
+        Assert.Equal(expected, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Theory]
+    [InlineData("21:59", 0)]
+    [InlineData("22:00", 20)]
+    [InlineData("23:30", 20)]
+    [InlineData("00:00", 20)]
+    [InlineData("01:59", 20)]
+    [InlineData("02:00", 0)]
+    [InlineData("12:00", 0)]
+    public async Task Window_across_midnight(string now, int expected)
+    {
+        var service = CreateService(now, Promo(Category.Grocery, 20, "22:00", "02:00"));
+
+        Assert.Equal(expected, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Picks_largest_discount_among_active_promotions_of_category()
+    {
+        var service = CreateService("12:00",
+            Promo(Category.Grocery, 10, "10:00", "14:00"),
+            Promo(Category.Grocery, 25, "11:00", "13:00"),
+            Promo(Category.Grocery, 40, "15:00", "18:00"),
+            Promo(Category.Electronics, 50, "10:00", "14:00"));
+
+        Assert.Equal(25m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Category_without_promotions_has_no_discount()
+    {
+        var service = CreateService("12:00", Promo(Category.Electronics, 50, "10:00", "14:00"));
+
+        Assert.Equal(0m, await service.CurrentDiscountAsync(Category.Household, default));
+    }
+}
