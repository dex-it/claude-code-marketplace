+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceChangeWorkerTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly PriceChangeQueue _queue = new();
+
+    [Fact]
+    public async Task Applies_price_change_to_product()
+    {
+        var product = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 100m, "sup-1");
+        _products.Setup(r => r.GetAsync(product.Id, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+        var worker = new PriceChangeWorker(_queue, _products.Object);
+        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+
+        await _queue.EnqueueAsync(new PriceChange(product.Id, 150m), default);
+        var run = worker.RunAsync(cts.Token);
+        await WaitUntil(() => product.BasePrice == 150m);
+        cts.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => run);
+
+        Assert.Equal(150m, product.BasePrice);
+    }
+
+    [Fact]
+    public async Task Unknown_product_does_not_stop_processing_of_next_changes()
+    {
+        var known = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 100m, "sup-1");
+        var unknownId = Guid.NewGuid();
+        _products.Setup(r => r.GetAsync(known.Id, It.IsAny<CancellationToken>())).ReturnsAsync(known);
+        _products.Setup(r => r.GetAsync(unknownId, It.IsAny<CancellationToken>())).ReturnsAsync((Product?)null);
+        var worker = new PriceChangeWorker(_queue, _products.Object);
+        var failures = new List<PriceChange>();
+        worker.Failed += (change, _) => failures.Add(change);
+        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+
+        var missing = new PriceChange(unknownId, 50m);
+        await _queue.EnqueueAsync(missing, default);
+        await _queue.EnqueueAsync(new PriceChange(known.Id, 150m), default);
+        var run = worker.RunAsync(cts.Token);
+        await WaitUntil(() => known.BasePrice == 150m);
+        cts.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => run);
+
+        Assert.Equal(150m, known.BasePrice);
+        Assert.Equal([missing], failures);
+    }
+
+    private static async Task WaitUntil(Func<bool> condition)
+    {
+        var deadline = DateTime.UtcNow.AddSeconds(5);
+        while (!condition())
+        {
+            if (DateTime.UtcNow > deadline) throw new TimeoutException("Условие не выполнено");
+            await Task.Delay(10);
+        }
+    }
+}
