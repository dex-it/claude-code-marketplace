+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class VolumeDiscountTests
+{
+    [Theory]
+    [InlineData(1, 0)]
+    [InlineData(9, 0)]
+    [InlineData(10, 3)]
+    [InlineData(49, 3)]
+    [InlineData(50, 5)]
+    [InlineData(1000, 5)]
+    public void PercentFor_returns_tier_percent(int quantity, int expected) =>
+        Assert.Equal(expected, VolumeDiscount.PercentFor(quantity));
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-1)]
+    public void PercentFor_rejects_non_positive_quantity(int quantity) =>
+        Assert.Throws<ArgumentOutOfRangeException>(() => VolumeDiscount.PercentFor(quantity));
+
+    [Theory]
+    [InlineData(100, 9, 100)]
+    [InlineData(100, 10, 97)]
+    [InlineData(100, 50, 95)]
+    [InlineData(89.99, 10, 87.29)]
+    public void Apply_discounts_and_rounds_to_kopecks(double price, int quantity, double expected) =>
+        Assert.Equal((decimal)expected, VolumeDiscount.Apply((decimal)price, quantity));
+}
