@@ -0,0 +1,17 @@
+namespace Pricing.Domain;
+
+/// <summary>Скидка за объём: процент зависит от количества единиц в строке.</summary>
+public static class VolumeDiscount
+{
+    public static decimal PercentFor(int quantity) => quantity switch
+    {
+        < 1 => throw new ArgumentOutOfRangeException(nameof(quantity), quantity, "Количество должно быть положительным"),
+        < 10 => 0m,
+        < 50 => 3m,
+        _ => 5m,
+    };
+
+    /// <summary>Применяет скидку за объём к цене единицы и округляет до копеек.</summary>
+    public static decimal Apply(decimal unitPrice, int quantity) =>
+        Math.Round(unitPrice * (1 - PercentFor(quantity) / 100m), 2);
+}
