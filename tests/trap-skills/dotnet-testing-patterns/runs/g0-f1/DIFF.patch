+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class VolumeDiscountTests
+{
+    [Theory]
+    [InlineData(1, 0)]
+    [InlineData(9, 0)]
+    [InlineData(10, 3)]
+    [InlineData(49, 3)]
+    [InlineData(50, 5)]
+    [InlineData(500, 5)]
+    public void Percent_depends_on_quantity_bracket(int quantity, decimal expected)
+    {
+        Assert.Equal(expected, VolumeDiscount.PercentFor(quantity));
+    }
+
+    [Theory]
+    [InlineData(100, 9, 100)]
+    [InlineData(100, 10, 97)]
+    [InlineData(100, 50, 95)]
+    public void Apply_reduces_unit_price_by_bracket(decimal price, int quantity, decimal expected)
+    {
+        Assert.Equal(expected, VolumeDiscount.Apply(price, quantity));
+    }
+
+    [Fact]
+    public void Apply_rounds_unit_price_to_kopecks()
+    {
+        // 89.99 * 0.97 = 87.2903
+        Assert.Equal(87.29m, VolumeDiscount.Apply(89.99m, 10));
+    }
+}
