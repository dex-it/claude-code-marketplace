+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceChangeWorkerTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly PriceChangeQueue _queue = new();
+
+    private static Product NewProduct(decimal price = 100m) =>
+        new(Guid.NewGuid(), $"SKU-{Guid.NewGuid()}", "Товар", Category.Grocery, price, "sup-1");
+
+    private void Has(Product product) =>
+        _products.Setup(r => r.GetAsync(product.Id, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+
+    /// <summary>Кладёт изменения в очередь, ждёт их обработки и останавливает воркер; возвращает сбои.</summary>
+    private async Task<List<(PriceChange Change, Exception Error)>> ProcessAsync(params PriceChange[] changes)
+    {
+        var worker = new PriceChangeWorker(_queue, _products.Object);
+        var failures = new List<(PriceChange, Exception)>();
+        worker.Failed += (c, e) => failures.Add((c, e));
+
+        // Маркер в конце очереди: когда он прочитан, все предыдущие изменения уже обработаны.
+        var processed = new TaskCompletionSource();
+        var marker = NewProduct();
+        _products.Setup(r => r.GetAsync(marker.Id, It.IsAny<CancellationToken>()))
+            .Returns(() =>
+            {
+                processed.TrySetResult();
+                return Task.FromResult<Product?>(marker);
+            });
+
+        using var cts = new CancellationTokenSource();
+        var run = worker.RunAsync(cts.Token);
+        foreach (var change in changes)
+            await _queue.EnqueueAsync(change, default);
+        await _queue.EnqueueAsync(new PriceChange(marker.Id, 1m), default);
+
+        await processed.Task.WaitAsync(TimeSpan.FromSeconds(5));
+        cts.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => run);
+        return failures;
+    }
+
+    [Fact]
+    public async Task Price_change_is_applied_to_product()
+    {
+        var product = NewProduct(100m);
+        Has(product);
+
+        var failures = await ProcessAsync(new PriceChange(product.Id, 150m));
+
+        Assert.Equal(150m, product.BasePrice);
+        Assert.Empty(failures);
+    }
+
+    [Fact]
+    public async Task Unknown_product_is_reported_and_does_not_stop_next_changes()
+    {
+        var product = NewProduct(100m);
+        Has(product);
+        var unknown = new PriceChange(Guid.NewGuid(), 10m);
+        _products.Setup(r => r.GetAsync(unknown.ProductId, It.IsAny<CancellationToken>()))
+            .ReturnsAsync((Product?)null);
+
+        var failures = await ProcessAsync(unknown, new PriceChange(product.Id, 175m));
+
+        Assert.Equal(175m, product.BasePrice);
+        var failure = Assert.Single(failures);
+        Assert.Equal(unknown, failure.Change);
+    }
+}
