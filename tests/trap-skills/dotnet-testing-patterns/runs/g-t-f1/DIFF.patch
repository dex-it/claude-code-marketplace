+namespace Pricing.Tests;
+
+/// <summary>Часы с заданным местным временем суток (часовой пояс UTC).</summary>
+internal sealed class FixedClock(TimeOnly timeOfDay) : TimeProvider
+{
+    public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.Utc;
+
+    public override DateTimeOffset GetUtcNow() =>
+        new(new DateTime(2026, 1, 15).Add(timeOfDay.ToTimeSpan()), TimeSpan.Zero);
+}
