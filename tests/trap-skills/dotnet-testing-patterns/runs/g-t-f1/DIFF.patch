+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PromotionServiceTests
+{
+    private readonly Mock<IPromotionRepository> _repo = new();
+
+    private static Promotion Promo(Category category, decimal percent, string from, string to) =>
+        new(Guid.NewGuid(), category, percent, TimeOnly.Parse(from), TimeOnly.Parse(to));
+
+    private Task<decimal> DiscountAt(string time, Category category, params Promotion[] promos)
+    {
+        _repo.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(promos);
+        var service = new PromotionService(_repo.Object, new FixedClock(TimeOnly.Parse(time)));
+        return service.CurrentDiscountAsync(category, default);
+    }
+
+    [Theory]
+    [InlineData("09:59", 0)]
+    [InlineData("10:00", 15)]
+    [InlineData("13:00", 15)]
+    [InlineData("13:59", 15)]
+    [InlineData("14:00", 0)]
+    public async Task Same_day_window_is_inclusive_at_start_and_exclusive_at_end(string time, int expected)
+    {
+        var discount = await DiscountAt(time, Category.Grocery, Promo(Category.Grocery, 15, "10:00", "14:00"));
+
+        Assert.Equal(expected, discount);
+    }
+
+    [Theory]
+    [InlineData("21:59", 0)]
+    [InlineData("22:00", 20)]
+    [InlineData("23:30", 20)]
+    [InlineData("00:00", 20)]
+    [InlineData("01:59", 20)]
+    [InlineData("02:00", 0)]
+    [InlineData("12:00", 0)]
+    public async Task Window_crossing_midnight_is_active_on_both_sides_of_midnight(string time, int expected)
+    {
+        var discount = await DiscountAt(time, Category.Grocery, Promo(Category.Grocery, 20, "22:00", "02:00"));
+
+        Assert.Equal(expected, discount);
+    }
+
+    [Fact]
+    public async Task Returns_largest_discount_among_active_promotions_of_category()
+    {
+        var discount = await DiscountAt("12:00", Category.Grocery,
+            Promo(Category.Grocery, 10, "10:00", "14:00"),
+            Promo(Category.Grocery, 25, "11:00", "13:00"),
+            Promo(Category.Grocery, 40, "15:00", "18:00"),
+            Promo(Category.Electronics, 50, "10:00", "14:00"));
+
+        Assert.Equal(25, discount);
+    }
+
+    [Fact]
+    public async Task Category_without_promotions_has_no_discount()
+    {
+        var discount = await DiscountAt("12:00", Category.Household, Promo(Category.Grocery, 10, "10:00", "14:00"));
+
+        Assert.Equal(0, discount);
+    }
+}
