+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _suppliers = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    public QuoteServiceTests() =>
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync([]);
+
+    private QuoteService CreateService()
+    {
+        var promotionService = new PromotionService(_promotions.Object, new FixedClock(new TimeOnly(12, 0)));
+        return new QuoteService(_products.Object, _suppliers.Object, promotionService);
+    }
+
+    private void HasProduct(string sku, decimal basePrice, Category category = Category.Grocery)
+    {
+        var product = new Product(Guid.NewGuid(), sku, "Товар", category, basePrice, "sup-1");
+        _products.Setup(r => r.GetBySkuAsync(sku, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+    }
+
+    private void SupplierPrices(string sku, decimal? price) =>
+        _suppliers.Setup(s => s.GetPriceAsync("sup-1", sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(price is null ? null : new SupplierPrice(sku, price.Value, "RUB"));
+
+    private void ActivePromotion(Category category, decimal percent) =>
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>()))
+            .ReturnsAsync([new Promotion(Guid.NewGuid(), category, percent, new TimeOnly(0, 0), new TimeOnly(23, 59))]);
+
+    [Fact]
+    public async Task Unit_price_is_supplier_price_when_it_exceeds_base()
+    {
+        HasProduct("SKU-1", 100m);
+        SupplierPrices("SKU-1", 120m);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        var line = Assert.Single(quote.Lines);
+        Assert.Equal(120m, line.UnitPrice);
+        Assert.Equal(240m, line.Total);
+        Assert.Equal(240m, quote.Total);
+        Assert.Equal("RUB", quote.Currency);
+    }
+
+    [Fact]
+    public async Task Unit_price_is_base_when_it_exceeds_supplier_price()
+    {
+        HasProduct("SKU-1", 100m);
+        SupplierPrices("SKU-1", 80m);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 1)], default);
+
+        Assert.Equal(100m, quote.Lines[0].UnitPrice);
+    }
+
+    [Fact]
+    public async Task Unit_price_is_base_when_supplier_does_not_know_sku()
+    {
+        HasProduct("SKU-1", 100m);
+        SupplierPrices("SKU-1", null);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 3)], default);
+
+        Assert.Equal(100m, quote.Lines[0].UnitPrice);
+        Assert.Equal(300m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Promotion_discount_is_applied_to_unit_price_and_rounded()
+    {
+        HasProduct("SKU-1", 99.99m);
+        SupplierPrices("SKU-1", null);
+        ActivePromotion(Category.Grocery, 15m);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 2)], default);
+
+        Assert.Equal(84.99m, quote.Lines[0].UnitPrice); // 99.99 * 0.85 = 84.9915
+        Assert.Equal(169.98m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Promotion_of_other_category_does_not_apply()
+    {
+        HasProduct("SKU-1", 100m);
+        SupplierPrices("SKU-1", null);
+        ActivePromotion(Category.Electronics, 50m);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("SKU-1", 1)], default);
+
+        Assert.Equal(100m, quote.Lines[0].UnitPrice);
+    }
+
+    [Fact]
+    public async Task Unknown_sku_in_cart_is_rejected()
+    {
+        HasProduct("SKU-1", 100m);
+        SupplierPrices("SKU-1", null);
+
+        var ex = await Assert.ThrowsAsync<NotFoundException>(() =>
+            CreateService().QuoteAsync([new QuoteLine("SKU-1", 1), new QuoteLine("NOPE", 1)], default));
+
+        Assert.Equal("product.not_found", ex.Code);
+    }
+}
