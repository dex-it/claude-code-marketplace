+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PromotionServiceTests
+{
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private PromotionService CreateService(int hour, int minute, params Promotion[] items)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(items);
+        return new PromotionService(_promotions.Object, new LocalClock(hour, minute));
+    }
+
+    private static Promotion Promo(Category category, decimal percent, string from, string to) =>
+        new(Guid.NewGuid(), category, percent, TimeOnly.Parse(from), TimeOnly.Parse(to));
+
+    [Fact]
+    public async Task Discount_applies_inside_window()
+    {
+        var service = CreateService(12, 0, Promo(Category.Grocery, 10, "10:00", "14:00"));
+
+        Assert.Equal(10m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Theory]
+    [InlineData(9, 59)]
+    [InlineData(14, 0)]
+    public async Task Discount_is_zero_outside_window(int hour, int minute)
+    {
+        var service = CreateService(hour, minute, Promo(Category.Grocery, 10, "10:00", "14:00"));
+
+        Assert.Equal(0m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Theory]
+    [InlineData(23, 0, 15)]
+    [InlineData(1, 0, 15)]
+    [InlineData(12, 0, 0)]
+    [InlineData(2, 0, 0)]
+    public async Task Window_across_midnight(int hour, int minute, int expected)
+    {
+        var service = CreateService(hour, minute, Promo(Category.Grocery, 15, "22:00", "02:00"));
+
+        Assert.Equal(expected, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Largest_discount_of_category_wins()
+    {
+        var service = CreateService(12, 0,
+            Promo(Category.Grocery, 5, "10:00", "14:00"),
+            Promo(Category.Grocery, 20, "11:00", "13:00"),
+            Promo(Category.Grocery, 50, "15:00", "16:00"),
+            Promo(Category.Household, 70, "10:00", "14:00"));
+
+        Assert.Equal(20m, await service.CurrentDiscountAsync(Category.Grocery, default));
+    }
+
+    [Fact]
+    public async Task Category_without_promotions_has_no_discount()
+    {
+        var service = CreateService(12, 0, Promo(Category.Household, 30, "10:00", "14:00"));
+
+        Assert.Equal(0m, await service.CurrentDiscountAsync(Category.Electronics, default));
+    }
+}
+
+/// <summary>Часы с фиксированным местным временем (местная зона - UTC).</summary>
+internal sealed class LocalClock(int hour, int minute) : TimeProvider
+{
+    public override TimeZoneInfo LocalTimeZone => TimeZoneInfo.Utc;
+    public override DateTimeOffset GetUtcNow() => new(2026, 1, 1, hour, minute, 0, TimeSpan.Zero);
+}
