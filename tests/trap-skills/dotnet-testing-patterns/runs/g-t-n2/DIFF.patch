+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceChangeWorkerTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly PriceChangeQueue _queue = new();
+
+    private Product HasProduct(decimal price)
+    {
+        var product = new Product(Guid.NewGuid(), "SKU", "Товар", Category.Grocery, price, "sup-1");
+        _products.Setup(r => r.GetAsync(product.Id, It.IsAny<CancellationToken>())).ReturnsAsync(product);
+        return product;
+    }
+
+    private async Task<List<PriceChange>> RunAsync(params PriceChange[] changes)
+    {
+        var worker = new PriceChangeWorker(_queue, _products.Object);
+        var failed = new List<PriceChange>();
+        worker.Failed += (change, _) => failed.Add(change);
+        foreach (var change in changes) await _queue.EnqueueAsync(change, default);
+        _queue.Complete();
+        await worker.RunAsync(default);
+        return failed;
+    }
+
+    [Fact]
+    public async Task Change_is_applied_to_product()
+    {
+        var product = HasProduct(100m);
+
+        var failed = await RunAsync(new PriceChange(product.Id, 150m));
+
+        Assert.Equal(150m, product.BasePrice);
+        Assert.Empty(failed);
+    }
+
+    [Fact]
+    public async Task Unknown_product_does_not_stop_processing()
+    {
+        var product = HasProduct(100m);
+        var unknown = new PriceChange(Guid.NewGuid(), 50m);
+
+        var failed = await RunAsync(unknown, new PriceChange(product.Id, 175m));
+
+        Assert.Equal(175m, product.BasePrice);
+        Assert.Equal(unknown, Assert.Single(failed));
+    }
+}
