+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.Promotions;
+using Pricing.Application.Quotes;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class QuoteServiceTests
+{
+    private readonly Mock<IProductRepository> _products = new();
+    private readonly Mock<ISupplierCatalog> _suppliers = new();
+    private readonly Mock<IPromotionRepository> _promotions = new();
+
+    private QuoteService CreateService(params Promotion[] active)
+    {
+        _promotions.Setup(r => r.ListAsync(It.IsAny<CancellationToken>())).ReturnsAsync(active);
+        var promotions = new PromotionService(_promotions.Object, new LocalClock(12, 0));
+        return new QuoteService(_products.Object, _suppliers.Object, promotions);
+    }
+
+    private void HasProduct(string sku, decimal basePrice, Category category = Category.Grocery) =>
+        _products.Setup(r => r.GetBySkuAsync(sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(new Product(Guid.NewGuid(), sku, "Товар", category, basePrice, "sup-1"));
+
+    private void SupplierKnows(string sku, decimal? price) =>
+        _suppliers.Setup(s => s.GetPriceAsync("sup-1", sku, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(price is null ? null : new SupplierPrice(sku, price.Value, "RUB"));
+
+    private static Promotion AllDayPromo(Category category, decimal percent) =>
+        new(Guid.NewGuid(), category, percent, new TimeOnly(0, 0), new TimeOnly(23, 59));
+
+    [Theory]
+    [InlineData(100, 120, 120)]
+    [InlineData(100, 80, 100)]
+    public async Task Unit_price_is_max_of_base_and_supplier(decimal basePrice, decimal supplierPrice, decimal expected)
+    {
+        HasProduct("A", basePrice);
+        SupplierKnows("A", supplierPrice);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("A", 2)], default);
+
+        Assert.Equal(expected, quote.Lines[0].UnitPrice);
+        Assert.Equal(expected * 2, quote.Total);
+        Assert.Equal("RUB", quote.Currency);
+    }
+
+    [Fact]
+    public async Task Promo_discount_is_applied_to_unit_price()
+    {
+        HasProduct("A", 200m);
+        SupplierKnows("A", null);
+
+        var quote = await CreateService(AllDayPromo(Category.Grocery, 15)).QuoteAsync([new QuoteLine("A", 3)], default);
+
+        Assert.Equal(170m, quote.Lines[0].UnitPrice);
+        Assert.Equal(510m, quote.Total);
+    }
+
+    [Fact]
+    public async Task Sku_unknown_to_supplier_uses_base_price()
+    {
+        HasProduct("A", 99.5m);
+        SupplierKnows("A", null);
+
+        var quote = await CreateService().QuoteAsync([new QuoteLine("A", 1)], default);
+
+        Assert.Equal(99.5m, quote.Lines[0].UnitPrice);
+    }
+
+    [Fact]
+    public async Task Unknown_sku_in_cart_is_not_found()
+    {
+        HasProduct("A", 100m);
+        SupplierKnows("A", null);
+
+        var ex = await Assert.ThrowsAsync<NotFoundException>(() =>
+            CreateService().QuoteAsync([new QuoteLine("A", 1), new QuoteLine("MISSING", 1)], default));
+
+        Assert.Equal("product.not_found", ex.Code);
+    }
+}
