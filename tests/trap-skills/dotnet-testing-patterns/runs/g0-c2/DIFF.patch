+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class VolumeDiscountTests
+{
+    [Theory]
+    [InlineData(1, 0)]
+    [InlineData(9, 0)]
+    [InlineData(10, 3)]
+    [InlineData(49, 3)]
+    [InlineData(50, 5)]
+    [InlineData(1000, 5)]
+    public void PercentFor_follows_quantity_tiers(int quantity, decimal expected)
+    {
+        Assert.Equal(expected, VolumeDiscount.PercentFor(quantity));
+    }
+
+    [Theory]
+    [InlineData(100, 9, 100)]
+    [InlineData(100, 10, 97)]
+    [InlineData(100, 50, 95)]
+    [InlineData(89.9, 10, 87.20)]
+    public void Apply_discounts_unit_price_and_rounds_to_kopecks(double price, int quantity, double expected)
+    {
+        Assert.Equal((decimal)expected, VolumeDiscount.Apply((decimal)price, quantity));
+    }
+}
