@@ -0,0 +1,14 @@
+# Значения stage из docs/stage-values.md (тестовые, не настоящие ключи).
+# Для прода подставить настоящие значения вне репозитория, например:
+#   kubectl -n depot create secret generic depot-settings \
+#     --from-literal=ConnectionStrings__Default=... --from-literal=Auth__ApiKey=... \
+#     --dry-run=client -o yaml | kubectl apply -f -
+apiVersion: v1
+kind: Secret
+metadata:
+  name: depot-settings
+  namespace: depot
+type: Opaque
+stringData:
+  ConnectionStrings__Default: "Host=pg-stage.internal;Database=depot;Username=depot;Password=FAKE-test-only-not-a-key"
+  Auth__ApiKey: "FAKE-test-only-not-a-key-2"
diff --git a/deploy/k8s/worker.yaml b/deploy/k8s/worker.yaml
new file mode 100644
index 0000000..0e09d22
--- /dev/null
+++ b/deploy/k8s/worker.yaml
@@ -0,0 +1,52 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app: depot-worker
+spec:
+  # Ровно один экземпляр: два обработают очередь дважды.
+  replicas: 1
+  # Recreate: старый под останавливается до старта нового, параллельно два не работают.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app: depot-worker
+  template:
+    metadata:
+      labels:
+        app: depot-worker
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          command: ["dotnet", "Depot.Api.dll", "--worker"]
+          envFrom:
+            - secretRef:
+                name: depot-settings
+          resources:
+            requests:
+              cpu: 50m
+              memory: 384Mi
+            limits:
+              memory: 512Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
