diff --git a/deploy/k8s/api.yaml b/deploy/k8s/api.yaml
new file mode 100644
index 0000000..d9e44be
--- /dev/null
+++ b/deploy/k8s/api.yaml
@@ -0,0 +1,136 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app: depot-api
+spec:
+  replicas: 3
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxSurge: 1
+      maxUnavailable: 0
+  selector:
+    matchLabels:
+      app: depot-api
+  template:
+    metadata:
+      labels:
+        app: depot-api
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app: depot-api
+      terminationGracePeriodSeconds: 30
+      containers:
+        - name: api
+          image: registry.example.com/depot/api:1.4.0
+          ports:
+            - name: http
+              containerPort: 8080
+          env:
+            - name: ASPNETCORE_URLS
+              value: http://+:8080
+          envFrom:
+            - secretRef:
+                name: depot-settings
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              memory: 512Mi
+          # Холодный старт (с миграциями) до 35 с; запас до 120 с.
+          startupProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 5
+            failureThreshold: 24
+          # /health зависит от БД: при её сбое снимаем трафик, но не перезапускаем поды.
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 10
+            timeoutSeconds: 3
+            failureThreshold: 3
+          livenessProbe:
+            tcpSocket:
+              port: http
+            periodSeconds: 20
+            failureThreshold: 3
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app: depot-api
+spec:
+  selector:
+    app: depot-api
+  ports:
+    - name: http
+      port: 80
+      targetPort: http
+---
+# Еженедельный drain нод не должен снимать больше одной реплики разом.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  minAvailable: 2
+  selector:
+    matchLabels:
+      app: depot-api
+---
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  ingressClassName: nginx
+  tls:
+    - hosts:
+        - depot.example.com
+      secretName: depot-tls
+  rules:
+    - host: depot.example.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: depot-api
+                port:
+                  name: http
