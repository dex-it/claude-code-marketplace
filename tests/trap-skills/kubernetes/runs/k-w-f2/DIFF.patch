@@ -0,0 +1,17 @@
+# Манифесты Kubernetes для Depot
+
+Применение: `kubectl apply -f deploy/k8s/`
+
+Предусловия в namespace `depot` (значений секретов в репозитории нет):
+
+- `regcred` - pull-secret реестра, `depot-tls` - TLS-secret для `depot.example.com` (уже созданы);
+- `depot-env` - настройки приложения. Создаётся вручную после namespace (значения - из хранилища секретов,
+  для stage - `docs/stage-values.md`):
+
+```
+kubectl -n depot create secret generic depot-env \
+  --from-literal=ConnectionStrings__Default='<строка подключения>' \
+  --from-literal=Auth__ApiKey='<ключ API>'
+```
+
+Без `depot-env` поды остаются в `CreateContainerConfigError`.
diff --git a/deploy/k8s/api-deployment.yaml b/deploy/k8s/api-deployment.yaml
new file mode 100644
index 0000000..12f8fb7
--- /dev/null
+++ b/deploy/k8s/api-deployment.yaml
@@ -0,0 +1,114 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-api
+    app.kubernetes.io/part-of: depot
+spec:
+  replicas: 3
+  revisionHistoryLimit: 5
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0
+      maxSurge: 1
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: depot-api
+        app.kubernetes.io/part-of: depot
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      automountServiceAccountToken: false
+      terminationGracePeriodSeconds: 45
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app.kubernetes.io/name: depot-api
+      containers:
+        - name: api
+          image: registry.example.com/depot/api:1.4.0
+          ports:
+            - name: http
+              containerPort: 8080
+          env:
+            - name: ASPNETCORE_URLS
+              value: http://+:8080
+            - name: ConnectionStrings__Default
+              valueFrom:
+                secretKeyRef:
+                  name: depot-env
+                  key: ConnectionStrings__Default
+            - name: Auth__ApiKey
+              valueFrom:
+                secretKeyRef:
+                  name: depot-env
+                  key: Auth__ApiKey
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              cpu: 500m
+              memory: 512Mi
+          # Процесс не слушает порт, пока не применены миграции (холодный старт до 35 с, p95).
+          startupProbe:
+            tcpSocket:
+              port: http
+            periodSeconds: 5
+            failureThreshold: 30
+          # Liveness не ходит в БД: недоступность Postgres не должна перезапускать поды.
+          livenessProbe:
+            tcpSocket:
+              port: http
+            periodSeconds: 10
+            timeoutSeconds: 2
+            failureThreshold: 3
+          # /health проверяет БД: при её недоступности под выводится из Service, но не перезапускается.
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 5
+            timeoutSeconds: 3
+            failureThreshold: 3
+          lifecycle:
+            preStop:
+              exec:
+                command: ["sleep", "10"]
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
+---
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  minAvailable: 2
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
diff --git a/deploy/k8s/api-ingress.yaml b/deploy/k8s/api-ingress.yaml
new file mode 100644
index 0000000..a228bdd
--- /dev/null
+++ b/deploy/k8s/api-ingress.yaml
@@ -0,0 +1,22 @@
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  ingressClassName: nginx
+  tls:
+    - hosts:
+        - depot.example.com
+      secretName: depot-tls
+  rules:
+    - host: depot.example.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: depot-api
+                port:
+                  name: http
