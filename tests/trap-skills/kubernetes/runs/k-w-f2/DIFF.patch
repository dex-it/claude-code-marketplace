--- /dev/null
+++ b/deploy/k8s/worker-deployment.yaml
@@ -0,0 +1,65 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-worker
+    app.kubernetes.io/part-of: depot
+spec:
+  # Ровно один экземпляр: два обработают очередь дважды.
+  replicas: 1
+  revisionHistoryLimit: 5
+  # Recreate: старый под останавливается до старта нового, экземпляры не работают одновременно.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-worker
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: depot-worker
+        app.kubernetes.io/part-of: depot
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          args: ["--worker"]
+          env:
+            - name: ConnectionStrings__Default
+              valueFrom:
+                secretKeyRef:
+                  name: depot-env
+                  key: ConnectionStrings__Default
+            - name: Auth__ApiKey
+              valueFrom:
+                secretKeyRef:
+                  name: depot-env
+                  key: Auth__ApiKey
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              cpu: 500m
+              memory: 512Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
