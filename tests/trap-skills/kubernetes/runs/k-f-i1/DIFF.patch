diff --git a/deploy/k8s/deployment.yaml b/deploy/k8s/deployment.yaml
index 6250202..f37be03 100644
--- a/deploy/k8s/deployment.yaml
+++ b/deploy/k8s/deployment.yaml
@@ -5,6 +5,11 @@ metadata:
   namespace: depot
 spec:
   replicas: 3
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0
+      maxSurge: 1
   selector:
     matchLabels:
       app.kubernetes.io/name: depot-api
@@ -15,6 +20,17 @@ spec:
     spec:
       imagePullSecrets:
         - name: regcred
+      terminationGracePeriodSeconds: 30
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app.kubernetes.io/name: depot-api
       containers:
         - name: api
           image: registry.example.com/depot/api:1.4.0
@@ -23,12 +39,47 @@ spec:
           envFrom:
             - secretRef:
                 name: depot-secrets
-          securityContext: {}
+          resources:
+            requests: { cpu: 100m, memory: 384Mi }
+            limits: { cpu: 500m, memory: 512Mi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: ["ALL"] }
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+          # Kestrel начинает слушать порт только после миграций (холодный старт 20-35 с, p95),
+          # поэтому tcpSocket годится как признак окончания старта. Запас: 5 + 30 * 5 = 155 с.
+          startupProbe:
+            tcpSocket: { port: 8080 }
+            periodSeconds: 5
+            failureThreshold: 30
+          # Liveness не ходит в БД: сбой Postgres не должен перезапускать все поды.
+          # Отдельного health-маршрута без зависимостей у сервиса нет (docs/runbook.md).
           livenessProbe:
-            httpGet: { path: /health, port: 8080 }
-            initialDelaySeconds: 0
-            periodSeconds: 1
-            failureThreshold: 1
+            tcpSocket: { port: 8080 }
+            periodSeconds: 10
+            timeoutSeconds: 3
+            failureThreshold: 3
+          # Readiness проверяет БД: под без БД выводится из Service, но не перезапускается.
           readinessProbe:
             httpGet: { path: /health, port: 8080 }
             periodSeconds: 5
+            timeoutSeconds: 3
+            failureThreshold: 3
+      volumes:
+        - name: tmp
+          emptyDir: {}
+---
+# Drain раз в неделю: не даём вытеснить больше одного пода API за раз (при 3 репликах остаётся >= 2).
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  maxUnavailable: 1
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
