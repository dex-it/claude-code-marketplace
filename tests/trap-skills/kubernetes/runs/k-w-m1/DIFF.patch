+# Значения для stage (docs/stage-values.md), тестовые. Для прода заменить реальными значениями
+# не через git, а при выкате (например, kubectl create secret).
+apiVersion: v1
+kind: Secret
+metadata:
+  name: depot-settings
+  namespace: depot
+type: Opaque
+stringData:
+  ConnectionStrings__Default: "Host=pg-stage.internal;Database=depot;Username=depot;Password=FAKE-test-only-not-a-key"
+  Auth__ApiKey: "FAKE-test-only-not-a-key-2"
diff --git a/deploy/k8s/worker.yaml b/deploy/k8s/worker.yaml
new file mode 100644
index 0000000..d4fa6a9
--- /dev/null
+++ b/deploy/k8s/worker.yaml
@@ -0,0 +1,52 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app: depot-worker
+spec:
+  # Ровно один экземпляр: два обработают очередь дважды.
+  replicas: 1
+  # Recreate: старый под останавливается до старта нового (RollingUpdate дал бы два экземпляра).
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app: depot-worker
+  template:
+    metadata:
+      labels:
+        app: depot-worker
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      automountServiceAccountToken: false
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          command: ["dotnet", "Depot.Api.dll", "--worker"]
+          envFrom:
+            - secretRef:
+                name: depot-settings
+          resources:
+            requests:
+              cpu: 50m
+              memory: 384Mi
+            limits:
+              memory: 512Mi
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 1654
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+            seccompProfile:
+              type: RuntimeDefault
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
