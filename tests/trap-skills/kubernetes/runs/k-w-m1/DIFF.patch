diff --git a/deploy/k8s/api.yaml b/deploy/k8s/api.yaml
new file mode 100644
index 0000000..d4d0e19
--- /dev/null
+++ b/deploy/k8s/api.yaml
@@ -0,0 +1,139 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app: depot-api
+spec:
+  replicas: 3
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0
+      maxSurge: 1
+  selector:
+    matchLabels:
+      app: depot-api
+  template:
+    metadata:
+      labels:
+        app: depot-api
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      automountServiceAccountToken: false
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app: depot-api
+      containers:
+        - name: api
+          image: registry.example.com/depot/api:1.4.0
+          ports:
+            - name: http
+              containerPort: 8080
+          env:
+            - name: ASPNETCORE_URLS
+              value: http://+:8080
+          envFrom:
+            - secretRef:
+                name: depot-settings
+          # Холодный старт до 35 с (p95, включая миграции): ждём до 150 с.
+          startupProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 5
+            failureThreshold: 30
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 10
+            timeoutSeconds: 3
+            failureThreshold: 3
+          # Liveness намеренно без проверки БД: при недоступной БД перезапуск подов не поможет.
+          livenessProbe:
+            tcpSocket:
+              port: http
+            periodSeconds: 20
+            failureThreshold: 3
+          lifecycle:
+            preStop:
+              exec:
+                command: ["sleep", "5"]
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              memory: 512Mi
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 1654
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+            seccompProfile:
+              type: RuntimeDefault
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app: depot-api
+spec:
+  selector:
+    app: depot-api
+  ports:
+    - name: http
+      port: 80
+      targetPort: http
+---
+# Еженедельный drain нод: всегда остаются минимум 2 из 3 реплик.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  minAvailable: 2
+  selector:
+    matchLabels:
+      app: depot-api
+---
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  ingressClassName: nginx
+  tls:
+    - hosts:
+        - depot.example.com
+      secretName: depot-tls
+  rules:
+    - host: depot.example.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: depot-api
+                port:
+                  name: http
