@@ -0,0 +1,13 @@
+# ВНИМАНИЕ: значения ниже - тестовые значения stage из docs/stage-values.md (FAKE).
+# Оператора секретов в кластере нет, поэтому секрет лежит в манифестах, чтобы `kubectl apply -f deploy/k8s/` работал как есть.
+# Для прода значения нужно заменить до выката (например, создать секрет depot-env вне git),
+# реальные секреты в git не коммитить.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: depot-env
+  namespace: depot
+type: Opaque
+stringData:
+  ConnectionStrings__Default: "Host=pg-stage.internal;Database=depot;Username=depot;Password=FAKE-test-only-not-a-key"
+  Auth__ApiKey: "FAKE-test-only-not-a-key-2"
diff --git a/deploy/k8s/worker-deployment.yaml b/deploy/k8s/worker-deployment.yaml
new file mode 100644
index 0000000..6983525
--- /dev/null
+++ b/deploy/k8s/worker-deployment.yaml
@@ -0,0 +1,57 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-worker
+    app.kubernetes.io/part-of: depot
+spec:
+  # Ровно один экземпляр: два обработают очередь дважды.
+  replicas: 1
+  revisionHistoryLimit: 5
+  # Recreate: старый под останавливается до старта нового, иначе на время выката работали бы два экземпляра.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-worker
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: depot-worker
+        app.kubernetes.io/part-of: depot
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      terminationGracePeriodSeconds: 30
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          args: ["--worker"]
+          envFrom:
+            - secretRef:
+                name: depot-env
+          resources:
+            requests:
+              cpu: 50m
+              memory: 384Mi
+            limits:
+              cpu: 500m
+              memory: 512Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
