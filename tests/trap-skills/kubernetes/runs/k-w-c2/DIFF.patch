+# ТОЛЬКО stage: значения из docs/stage-values.md (тестовые, FAKE).
+# Для прода Secret depot-env создаётся отдельно, реальные значения в git не кладём.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: depot-env
+  namespace: depot
+type: Opaque
+stringData:
+  ConnectionStrings__Default: "Host=pg-stage.internal;Database=depot;Username=depot;Password=FAKE-test-only-not-a-key"
+  Auth__ApiKey: "FAKE-test-only-not-a-key-2"
diff --git a/deploy/k8s/20-api.yaml b/deploy/k8s/20-api.yaml
new file mode 100644
index 0000000..56a896b
--- /dev/null
+++ b/deploy/k8s/20-api.yaml
@@ -0,0 +1,136 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-api
+spec:
+  replicas: 3
+  revisionHistoryLimit: 5
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0
+      maxSurge: 1
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: depot-api
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      terminationGracePeriodSeconds: 30
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app.kubernetes.io/name: depot-api
+      containers:
+        - name: api
+          image: registry.example.com/depot/api:1.4.0
+          ports:
+            - name: http
+              containerPort: 8080
+          env:
+            - name: ASPNETCORE_URLS
+              value: http://+:8080
+          envFrom:
+            - secretRef:
+                name: depot-env
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              memory: 512Mi
+          # Миграции идут до приёма трафика: холодный старт до ~35 с (p95), запас до 150 с.
+          startupProbe:
+            tcpSocket:
+              port: http
+            periodSeconds: 5
+            failureThreshold: 30
+          # /health зависит от БД: недоступность БД не должна перезапускать поды, поэтому liveness - по TCP.
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 10
+            timeoutSeconds: 3
+            failureThreshold: 3
+          livenessProbe:
+            tcpSocket:
+              port: http
+            periodSeconds: 20
+            failureThreshold: 3
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-api
+spec:
+  selector:
+    app.kubernetes.io/name: depot-api
+  ports:
+    - name: http
+      port: 80
+      targetPort: http
+---
+# Еженедельный drain нод не должен оставить меньше 2 готовых реплик.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  minAvailable: 2
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
+---
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: depot-api
+  namespace: depot
+spec:
+  ingressClassName: nginx
+  tls:
+    - hosts:
+        - depot.example.com
+      secretName: depot-tls
+  rules:
+    - host: depot.example.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: depot-api
+                port:
+                  name: http
diff --git a/deploy/k8s/30-worker.yaml b/deploy/k8s/30-worker.yaml
new file mode 100644
index 0000000..18dab8a
--- /dev/null
+++ b/deploy/k8s/30-worker.yaml
@@ -0,0 +1,54 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-worker
+spec:
+  # Ровно один экземпляр: два обработают очередь дважды.
+  replicas: 1
+  revisionHistoryLimit: 5
+  # Recreate: старый под останавливается до старта нового (без параллельных экземпляров).
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-worker
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: depot-worker
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      terminationGracePeriodSeconds: 30
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          args: ["--worker"]
+          envFrom:
+            - secretRef:
+                name: depot-env
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              memory: 512Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
