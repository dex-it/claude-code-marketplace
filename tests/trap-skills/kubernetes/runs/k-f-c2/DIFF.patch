diff --git a/deploy/k8s/deployment.yaml b/deploy/k8s/deployment.yaml
index 6250202..5aa1135 100644
--- a/deploy/k8s/deployment.yaml
+++ b/deploy/k8s/deployment.yaml
@@ -5,6 +5,11 @@ metadata:
   namespace: depot
 spec:
   replicas: 3
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0
+      maxSurge: 1
   selector:
     matchLabels:
       app.kubernetes.io/name: depot-api
@@ -15,6 +20,18 @@ spec:
     spec:
       imagePullSecrets:
         - name: regcred
+      terminationGracePeriodSeconds: 45
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile: { type: RuntimeDefault }
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app.kubernetes.io/name: depot-api
       containers:
         - name: api
           image: registry.example.com/depot/api:1.4.0
@@ -23,12 +40,35 @@ spec:
           envFrom:
             - secretRef:
                 name: depot-secrets
-          securityContext: {}
+          resources:
+            requests: { cpu: 100m, memory: 384Mi }
+            limits: { cpu: 500m, memory: 512Mi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: ["ALL"] }
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+          lifecycle:
+            preStop:
+              exec:
+                command: ["sleep", "5"]
+          # Холодный старт (миграции) 20-35 с p95: даём до 120 с.
+          startupProbe:
+            httpGet: { path: /health, port: 8080 }
+            periodSeconds: 5
+            failureThreshold: 24
           livenessProbe:
             httpGet: { path: /health, port: 8080 }
-            initialDelaySeconds: 0
-            periodSeconds: 1
-            failureThreshold: 1
+            periodSeconds: 10
+            timeoutSeconds: 3
+            failureThreshold: 6
           readinessProbe:
             httpGet: { path: /health, port: 8080 }
             periodSeconds: 5
+            timeoutSeconds: 3
+            failureThreshold: 3
+      volumes:
+        - name: tmp
+          emptyDir: {}
