diff --git a/deploy/k8s/deployment.yaml b/deploy/k8s/deployment.yaml
index 6250202..476d042 100644
--- a/deploy/k8s/deployment.yaml
+++ b/deploy/k8s/deployment.yaml
@@ -5,6 +5,11 @@ metadata:
   namespace: depot
 spec:
   replicas: 3
+  strategy:
+    type: RollingUpdate
+    rollingUpdate:
+      maxUnavailable: 0
+      maxSurge: 1
   selector:
     matchLabels:
       app.kubernetes.io/name: depot-api
@@ -15,20 +20,58 @@ spec:
     spec:
       imagePullSecrets:
         - name: regcred
+      terminationGracePeriodSeconds: 30
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: ScheduleAnyway
+          labelSelector:
+            matchLabels:
+              app.kubernetes.io/name: depot-api
       containers:
         - name: api
           image: registry.example.com/depot/api:1.4.0
           ports:
-            - containerPort: 8080
+            - name: http
+              containerPort: 8080
           envFrom:
             - secretRef:
                 name: depot-secrets
-          securityContext: {}
+          resources:
+            requests: { cpu: 100m, memory: 384Mi }
+            limits: { cpu: 500m, memory: 512Mi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: ["ALL"] }
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+          lifecycle:
+            preStop:
+              exec:
+                command: ["sleep", "5"]
+          # Порт открывается после миграций (холодный старт 20-35 с, p95): ждём до 150 с.
+          startupProbe:
+            tcpSocket: { port: 8080 }
+            periodSeconds: 5
+            failureThreshold: 30
+          # Liveness не ходит в БД: единственный /health проверяет Postgres,
+          # и при недоступной БД перезапускались бы все поды сразу.
           livenessProbe:
-            httpGet: { path: /health, port: 8080 }
-            initialDelaySeconds: 0
-            periodSeconds: 1
-            failureThreshold: 1
+            tcpSocket: { port: 8080 }
+            periodSeconds: 10
+            timeoutSeconds: 2
+            failureThreshold: 3
+          # Readiness проверяет БД: под без БД выводится из Service, но не перезапускается.
           readinessProbe:
             httpGet: { path: /health, port: 8080 }
             periodSeconds: 5
+            timeoutSeconds: 3
+            failureThreshold: 3
+      volumes:
+        - name: tmp
+          emptyDir: {}
