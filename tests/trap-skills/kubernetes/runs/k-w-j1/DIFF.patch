diff --git a/deploy/k8s/worker-deployment.yaml b/deploy/k8s/worker-deployment.yaml
new file mode 100644
index 0000000..341b35e
--- /dev/null
+++ b/deploy/k8s/worker-deployment.yaml
@@ -0,0 +1,66 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: depot-worker
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-worker
+    app.kubernetes.io/part-of: depot
+spec:
+  # Ровно один экземпляр: два обработают очередь дважды.
+  replicas: 1
+  revisionHistoryLimit: 5
+  # Recreate: при RollingUpdate старый и новый поды работали бы одновременно.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-worker
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: depot-worker
+        app.kubernetes.io/part-of: depot
+    spec:
+      imagePullSecrets:
+        - name: regcred
+      automountServiceAccountToken: false
+      terminationGracePeriodSeconds: 30
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: worker
+          image: registry.example.com/depot/api:1.4.0
+          args: ["--worker"]
+          env:
+            - name: ConnectionStrings__Default
+              valueFrom:
+                secretKeyRef:
+                  name: depot-secrets
+                  key: ConnectionStrings__Default
+            - name: Auth__ApiKey
+              valueFrom:
+                secretKeyRef:
+                  name: depot-secrets
+                  key: Auth__ApiKey
+          resources:
+            requests:
+              cpu: 100m
+              memory: 384Mi
+            limits:
+              cpu: "1"
+              memory: 768Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
