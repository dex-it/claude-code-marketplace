--- /dev/null
+++ b/deploy/k8s/api-pdb.yaml
@@ -0,0 +1,14 @@
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: depot-api
+  namespace: depot
+  labels:
+    app.kubernetes.io/name: depot-api
+    app.kubernetes.io/part-of: depot
+spec:
+  # Еженедельный drain нод не должен оставлять меньше двух из трёх реплик.
+  minAvailable: 2
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: depot-api
