 namespace Meridian.Shipping.Api;
 
@@ -26,6 +29,32 @@ public static class ShipmentEndpoints
             return info is null ? Results.NotFound() : Results.Ok(info);
         });
 
+        group.MapPost("/{id:guid}/quote", async (Guid id, QuoteShipmentHandler handler, CancellationToken ct) =>
+        {
+            try
+            {
+                var result = await handler.HandleAsync(new QuoteShipmentCommand(id), ct);
+                return result.IsSuccess ? Results.Ok(result.Value) : ToProblem(result.Error!);
+            }
+            catch (DbUpdateConcurrencyException)
+            {
+                return ToProblem(new ConcurrentShipmentUpdateError(id));
+            }
+        });
+
         return app;
     }
+
+    private static IResult ToProblem(MeridianError error)
+    {
+        var status = error switch
+        {
+            ShipmentNotFoundError => StatusCodes.Status404NotFound,
+            QuoteNotAllowedError or ConcurrentShipmentUpdateError => StatusCodes.Status409Conflict,
+            CarrierUnavailableError or CarrierBadResponseError => StatusCodes.Status502BadGateway,
+            _ => StatusCodes.Status500InternalServerError,
+        };
+        return Results.Problem(detail: error.Message, statusCode: status,
+            extensions: new Dictionary<string, object?> { ["code"] = error.Code });
+    }
 }
