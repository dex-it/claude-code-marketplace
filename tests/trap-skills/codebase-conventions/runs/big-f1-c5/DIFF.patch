@@ -0,0 +1,11 @@
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+// Множитель перевода единицы валюты в минорную (ISO 4217); для валют вне списков - 100.
+internal static class CurrencyMinorUnits
+{
+    private static readonly HashSet<string> ZeroDecimals = new() { "JPY", "KRW", "VND", "CLP", "ISK", "UGX", "XAF", "XOF" };
+    private static readonly HashSet<string> ThreeDecimals = new() { "BHD", "JOD", "KWD", "OMR", "TND" };
+
+    public static decimal Factor(string currency) =>
+        ZeroDecimals.Contains(currency) ? 1m : ThreeDecimals.Contains(currency) ? 1000m : 100m;
+}
