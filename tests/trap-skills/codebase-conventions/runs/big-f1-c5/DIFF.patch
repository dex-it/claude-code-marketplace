@@ -0,0 +1,64 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using Meridian.Common;
+using Meridian.Shipping.Domain;
+using Microsoft.Extensions.Logging;
+using Polly.CircuitBreaker;
+using Polly.Timeout;
+
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+public sealed record CarrierRate(Money Price, int EtaDays);
+
+// Повторы, таймауты и предохранитель - в стандартном обработчике при регистрации клиента (ADR-0026).
+public sealed class CarrierRatesClient(HttpClient http, ILogger<CarrierRatesClient> logger)
+{
+    // Цена у перевозчика - decimal в единицах валюты; дальше по коду она живёт только как Money.
+    private sealed record RateResponse(decimal Price, string? Currency, int EtaDays);
+
+    public async Task<Result<CarrierRate>> GetRateAsync(Address from, Address to, int weightGrams, CancellationToken ct)
+    {
+        var url = $"rates?from={Uri.EscapeDataString(from.PostalCode)}&to={Uri.EscapeDataString(to.PostalCode)}&weightGrams={weightGrams}";
+        try
+        {
+            using var response = await http.GetAsync(url, ct);
+            if (!response.IsSuccessStatusCode)
+            {
+                logger.LogWarning("Carrier rates request failed with status {StatusCode}", (int)response.StatusCode);
+                return new CarrierUnavailableError();
+            }
+
+            var body = await response.Content.ReadFromJsonAsync<RateResponse>(cancellationToken: ct);
+            return ToRate(body);
+        }
+        catch (Exception ex) when (!ct.IsCancellationRequested &&
+                                   ex is HttpRequestException or TimeoutRejectedException or BrokenCircuitException or OperationCanceledException)
+        {
+            logger.LogWarning(ex, "Carrier rates request failed");
+            return new CarrierUnavailableError();
+        }
+        catch (JsonException ex)
+        {
+            logger.LogWarning(ex, "Carrier rates response is not valid JSON");
+            return new CarrierBadResponseError("invalid JSON");
+        }
+    }
+
+    private static Result<CarrierRate> ToRate(RateResponse? body)
+    {
+        if (body is null)
+            return new CarrierBadResponseError("empty body");
+        if (string.IsNullOrWhiteSpace(body.Currency) || body.Currency.Length != 3)
+            return new CarrierBadResponseError("currency is missing");
+        if (body.Price < 0)
+            return new CarrierBadResponseError("negative price");
+        if (body.EtaDays < 0)
+            return new CarrierBadResponseError("negative etaDays");
+
+        var currency = body.Currency.ToUpperInvariant();
+        var minor = Math.Round(body.Price * CurrencyMinorUnits.Factor(currency), MidpointRounding.AwayFromZero);
+        if (minor > long.MaxValue)
+            return new CarrierBadResponseError("price is out of range");
+        return new CarrierRate(new Money((long)minor, currency), body.EtaDays);
+    }
+}
