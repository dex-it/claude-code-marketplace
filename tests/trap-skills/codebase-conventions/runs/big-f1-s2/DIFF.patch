@@ -0,0 +1,39 @@
+using System.Net.Http.Json;
+using Meridian.Common;
+using Meridian.Shipping.Domain;
+
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+public sealed record CarrierRate(Money Price, int EtaDays);
+
+// Повторы и таймауты - стандартным обработчиком при регистрации (ADR-0026), цикла здесь нет.
+public sealed class CarrierRatesClient(HttpClient http)
+{
+    public async Task<CarrierRate> GetRateAsync(Address from, Address to, int weightGrams, CancellationToken ct)
+    {
+        var url = $"rates?from={Uri.EscapeDataString(from.PostalCode)}&to={Uri.EscapeDataString(to.PostalCode)}&weightGrams={weightGrams}";
+        using var response = await http.GetAsync(url, ct);
+        response.EnsureSuccessStatusCode();
+
+        var body = await response.Content.ReadFromJsonAsync<RatesResponse>(cancellationToken: ct)
+            ?? throw new InvalidOperationException("Carrier returned an empty rates response");
+        if (body.Price < 0 || body.EtaDays < 0 || string.IsNullOrWhiteSpace(body.Currency))
+            throw new InvalidOperationException("Carrier returned an invalid rates response");
+
+        return new CarrierRate(new Money(ToMinor(body.Price, body.Currency), body.Currency), body.EtaDays);
+    }
+
+    // Внешний API отдаёт цену десятичной; в минорные единицы переводим на границе (RUL-0009).
+    private static long ToMinor(decimal price, string currency)
+    {
+        var digits = currency switch
+        {
+            "JPY" or "KRW" or "VND" or "CLP" or "ISK" => 0,
+            "BHD" or "KWD" or "OMR" or "JOD" or "TND" => 3,
+            _ => 2,
+        };
+        return (long)Math.Round(price * (decimal)Math.Pow(10, digits), MidpointRounding.AwayFromZero);
+    }
+
+    private sealed record RatesResponse(decimal Price, string Currency, int EtaDays);
+}
