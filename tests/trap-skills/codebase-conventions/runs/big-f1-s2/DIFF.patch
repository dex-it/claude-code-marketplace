+using Meridian.Common;
+using Meridian.Common.Messaging;
+using Meridian.Common.Persistence;
+using Meridian.Contracts;
+using Meridian.Shipping.Application.Abstractions;
+using Meridian.Shipping.Domain;
+using Meridian.Shipping.Infrastructure.Carriers;
+
+namespace Meridian.Shipping.Application.Shipments;
+
+public sealed record QuoteShipmentCommand(ShipmentId ShipmentId);
+
+public sealed record QuoteShipmentResponse(long PriceMinor, string Currency, int EtaDays, DateTimeOffset ExpiresAt);
+
+public sealed class QuoteShipmentHandler(
+    IShipmentRepository shipments, CarrierRatesClient carrier, IOutbox outbox, IUnitOfWork uow, TimeProvider clock)
+{
+    public async Task<Result<QuoteShipmentResponse>> HandleAsync(QuoteShipmentCommand command, CancellationToken ct)
+    {
+        var shipment = await shipments.FindAsync(command.ShipmentId.Value, ct);
+        if (shipment is null)
+            return new ShipmentNotFoundError(command.ShipmentId);
+        if (shipment.Status != ShipmentStatus.Created)
+            return new ShipmentNotQuotableError(command.ShipmentId, shipment.Status);
+
+        var rate = await carrier.GetRateAsync(shipment.From, shipment.To, shipment.WeightGrams, ct);
+
+        var quote = shipment.ApplyQuote(rate.Price, rate.EtaDays, clock.GetUtcNow());
+        await outbox.EnqueueAsync(new ShipmentQuotedIntegrationEvent(shipment.Id, shipment.OrderId,
+            quote.PriceMinor, quote.Currency, quote.EtaDays, quote.ExpiresAt) { OccurredAt = quote.QuotedAt }, ct);
+        await uow.CommitAsync(ct);
+
+        return new QuoteShipmentResponse(quote.PriceMinor, quote.Currency, quote.EtaDays, quote.ExpiresAt);
+    }
+}
