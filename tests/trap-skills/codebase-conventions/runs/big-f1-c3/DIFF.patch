+using System.Net.Http.Json;
+using System.Text.Json;
+using Meridian.Common;
+using Meridian.Shipping.Domain;
+using Microsoft.Extensions.Logging;
+using Polly.CircuitBreaker;
+using Polly.Timeout;
+
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+public sealed record CarrierRate(Money Price, int EtaDays);
+
+public sealed record CarrierRateResponse(decimal Price, string? Currency, int EtaDays);
+
+// Повторы, таймауты и предохранитель - стандартный обработчик при регистрации (ADR-0026).
+public sealed class CarrierRatesClient(HttpClient http, ILogger<CarrierRatesClient> logger)
+{
+    public async Task<Result<CarrierRate>> GetRateAsync(Shipment shipment, CancellationToken ct)
+    {
+        var url = $"rates?from={Uri.EscapeDataString(shipment.From.PostalCode)}" +
+                  $"&to={Uri.EscapeDataString(shipment.To.PostalCode)}&weightGrams={shipment.WeightGrams}";
+        try
+        {
+            using var response = await http.GetAsync(url, ct);
+            if (!response.IsSuccessStatusCode)
+            {
+                logger.LogWarning("Carrier rates request for {ShipmentId} failed with {StatusCode}",
+                    shipment.Id, (int)response.StatusCode);
+                return new CarrierUnavailableError($"status {(int)response.StatusCode}");
+            }
+
+            var body = await response.Content.ReadFromJsonAsync<CarrierRateResponse>(cancellationToken: ct);
+            return ToRate(body);
+        }
+        catch (Exception ex) when (ex is HttpRequestException or JsonException or TimeoutRejectedException
+                                       or BrokenCircuitException
+                                   || (ex is TaskCanceledException && !ct.IsCancellationRequested))
+        {
+            logger.LogWarning(ex, "Carrier rates request for {ShipmentId} failed", shipment.Id);
+            return new CarrierUnavailableError("request failed");
+        }
+    }
+
+    private static Result<CarrierRate> ToRate(CarrierRateResponse? body)
+    {
+        if (body is null || body.Price < 0 || body.EtaDays < 0 || body.Currency is not { Length: 3 } currency)
+            return new CarrierUnavailableError("malformed response");
+
+        // Перевозчик отдаёт decimal в единицах валюты; в наших контрактах - long в минорных (RUL-0009).
+        var minor = decimal.Round(body.Price * MinorUnitFactor(currency), 0, MidpointRounding.AwayFromZero);
+        if (minor > long.MaxValue)
+            return new CarrierUnavailableError("price out of range");
+
+        return new CarrierRate(new Money((long)minor, currency.ToUpperInvariant()), body.EtaDays);
+    }
+
+    // Валюты без дробной части и с тремя знаками по ISO 4217; остальные считаем с двумя.
+    private static decimal MinorUnitFactor(string currency) =>
+        currency.ToUpperInvariant() switch
+        {
+            "JPY" or "KRW" or "VND" or "CLP" or "ISK" or "UGX" or "XAF" or "XOF" => 1m,
+            "BHD" or "KWD" or "OMR" or "JOD" or "TND" => 1000m,
+            _ => 100m,
+        };
+}
