+using Meridian.Common;
+using Meridian.Common.Messaging;
+using Meridian.Common.Persistence;
+using Meridian.Contracts;
+using Meridian.Shipping.Application.Abstractions;
+using Meridian.Shipping.Domain;
+using Meridian.Shipping.Infrastructure.Carriers;
+
+namespace Meridian.Shipping.Application.Shipments;
+
+public sealed record QuoteShipmentCommand(Guid ShipmentId);
+
+public sealed class QuoteShipmentHandler(
+    IShipmentRepository shipments, CarrierRatesClient carrier, IOutbox outbox, IUnitOfWork uow, TimeProvider time)
+{
+    public async Task<Result<ShipmentQuote>> HandleAsync(QuoteShipmentCommand command, CancellationToken ct)
+    {
+        var shipment = await shipments.FindAsync(command.ShipmentId, ct);
+        if (shipment is null)
+            return new ShipmentNotFoundError(command.ShipmentId);
+        if (!shipment.CanBeQuoted)
+            return new QuoteNotAllowedError(shipment.Id, shipment.Status);
+
+        var rate = await carrier.GetRateAsync(shipment, ct);
+        if (!rate.IsSuccess)
+            return rate.Error!;
+
+        var now = time.GetUtcNow();
+        var quote = new ShipmentQuote(rate.Value!.Price.AmountMinor, rate.Value.Price.Currency, rate.Value.EtaDays,
+            now + ShipmentQuote.Lifetime);
+        shipment.ApplyQuote(quote);
+
+        await outbox.EnqueueAsync(new ShipmentQuotedIntegrationEvent(shipment.Id, shipment.OrderId,
+            quote.PriceMinor, quote.Currency, quote.EtaDays, quote.ExpiresAt) { OccurredAt = now }, ct);
+        await uow.CommitAsync(ct);
+        return quote;
+    }
+}
