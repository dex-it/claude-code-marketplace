@@ -12,6 +14,31 @@ public sealed class Invoice
     public InvoiceStatus Status { get; private set; } = InvoiceStatus.Draft;
     public DateTimeOffset? PaidAt { get; private set; }
 
+    private readonly object refundLock = new();
+    private readonly List<Refund> refunds = [];
+
+    public IReadOnlyList<Refund> Refunds
+    {
+        get { lock (refundLock) return refunds.ToList(); }
+    }
+
+    public Money Refunded
+    {
+        get { lock (refundLock) return Amount with { Minor = refunds.Sum(r => r.Amount.Minor) }; }
+    }
+
+    public Refund? TryRefund(long amountMinor, DateTimeOffset at)
+    {
+        lock (refundLock)
+        {
+            if (refunds.Sum(r => r.Amount.Minor) + amountMinor > Amount.Minor)
+                return null;
+            var refund = new Refund(RefundId.New(), Amount with { Minor = amountMinor }, at);
+            refunds.Add(refund);
+            return refund;
+        }
+    }
+
     public void Issue() => Status = InvoiceStatus.Issued;
 
     public void MarkPaid(DateTimeOffset at)
