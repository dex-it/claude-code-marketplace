@@ -12,6 +12,31 @@ public sealed class Invoice
     public InvoiceStatus Status { get; private set; } = InvoiceStatus.Draft;
     public DateTimeOffset? PaidAt { get; private set; }
 
+    private readonly object _refundsLock = new();
+    private readonly List<Refund> _refunds = [];
+
+    public IReadOnlyList<Refund> Refunds
+    {
+        get { lock (_refundsLock) return _refunds.ToArray(); }
+    }
+
+    public long RefundedMinor
+    {
+        get { lock (_refundsLock) return _refunds.Sum(r => r.Amount.Minor); }
+    }
+
+    // Проверка остатка и добавление под одним замком: параллельные возвраты не должны вместе превысить сумму счёта.
+    public bool TryAddRefund(Refund refund)
+    {
+        lock (_refundsLock)
+        {
+            if (_refunds.Sum(r => r.Amount.Minor) + refund.Amount.Minor > Amount.Minor)
+                return false;
+            _refunds.Add(refund);
+            return true;
+        }
+    }
+
     public void Issue() => Status = InvoiceStatus.Issued;
 
     public void MarkPaid(DateTimeOffset at)
@@ -22,3 +47,5 @@ public sealed class Invoice
 
