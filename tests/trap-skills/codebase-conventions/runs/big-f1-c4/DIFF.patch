@@ -0,0 +1,63 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using Meridian.Common;
+using Meridian.Shipping.Domain;
+using Microsoft.Extensions.Logging;
+using Polly.CircuitBreaker;
+using Polly.Timeout;
+
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+public sealed record CarrierRate(Money Price, int EtaDays);
+
+// Повторы, таймауты и предохранитель - стандартный обработчик при регистрации (ADR-0026).
+public sealed class CarrierRatesClient(HttpClient http, ILogger<CarrierRatesClient> logger)
+{
+    private sealed record RateResponse(decimal? Price, string? Currency, int? EtaDays);
+
+    public async Task<Result<CarrierRate>> GetRateAsync(Address from, Address to, int weightGrams, CancellationToken ct)
+    {
+        var url = $"rates?from={Uri.EscapeDataString(from.PostalCode)}&to={Uri.EscapeDataString(to.PostalCode)}&weightGrams={weightGrams}";
+        try
+        {
+            using var response = await http.GetAsync(url, ct);
+            if (!response.IsSuccessStatusCode)
+            {
+                logger.LogWarning("Carrier rates returned {StatusCode}", (int)response.StatusCode);
+                return new CarrierUnavailableError();
+            }
+
+            var body = await response.Content.ReadFromJsonAsync<RateResponse>(
+                new JsonSerializerOptions(JsonSerializerDefaults.Web), ct);
+            if (body is not { Price: >= 0, EtaDays: >= 0 } || string.IsNullOrWhiteSpace(body.Currency))
+            {
+                logger.LogWarning("Carrier rates response is incomplete or invalid");
+                return new CarrierUnavailableError();
+            }
+
+            return new CarrierRate(ToMoney(body.Price.Value, body.Currency), body.EtaDays.Value);
+        }
+        catch (Exception ex) when (!ct.IsCancellationRequested &&
+            ex is HttpRequestException or TaskCanceledException or TimeoutRejectedException
+                or BrokenCircuitException or JsonException or NotSupportedException)
+        {
+            logger.LogWarning(ex, "Carrier rates request failed");
+            return new CarrierUnavailableError();
+        }
+    }
+
+    // Перевозчик отдаёт цену десятичной в единицах валюты; наружу и в хранилище - минорные единицы (RUL-0009).
+    private static Money ToMoney(decimal price, string currency)
+    {
+        var code = currency.Trim().ToUpperInvariant();
+        var minor = decimal.Round(price * Scale(code), 0, MidpointRounding.AwayFromZero);
+        return new Money((long)minor, code);
+    }
+
+    private static decimal Scale(string currency) => currency switch
+    {
+        "JPY" or "KRW" or "VND" or "CLP" or "ISK" or "HUF" => 1m,
+        "BHD" or "JOD" or "KWD" or "OMR" or "TND" => 1000m,
+        _ => 100m,
+    };
+}
