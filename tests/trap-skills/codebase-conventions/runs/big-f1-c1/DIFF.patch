@@ -0,0 +1,27 @@
+using Meridian.Common;
+
+namespace Meridian.Shipping.Domain;
+
+public sealed class ShipmentQuote
+{
+    public static readonly TimeSpan Lifetime = TimeSpan.FromHours(24);
+
+    private ShipmentQuote() { }
+
+    public long PriceMinor { get; private set; }
+    public string Currency { get; private set; } = "";
+    public int EtaDays { get; private set; }
+    public DateTimeOffset QuotedAt { get; private set; }
+    public DateTimeOffset ExpiresAt { get; private set; }
+
+    public Money Price => new(PriceMinor, Currency);
+
+    public static ShipmentQuote Create(Money price, int etaDays, DateTimeOffset now) => new()
+    {
+        PriceMinor = price.AmountMinor,
+        Currency = price.Currency,
+        EtaDays = etaDays,
+        QuotedAt = now,
+        ExpiresAt = now + Lifetime,
+    };
+}
diff --git a/services/shipping/src/Meridian.Shipping/Infrastructure/Carriers/CarrierRatesClient.cs b/services/shipping/src/Meridian.Shipping/Infrastructure/Carriers/CarrierRatesClient.cs
new file mode 100644
index 0000000..7bacfaa
--- /dev/null
+++ b/services/shipping/src/Meridian.Shipping/Infrastructure/Carriers/CarrierRatesClient.cs
@@ -0,0 +1,60 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using Meridian.Common;
+using Microsoft.Extensions.Logging;
+using Polly;
+
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+public sealed record CarrierRate(Money Price, int EtaDays);
+
+// Устойчивость (повторы, таймаут, предохранитель) - стандартным обработчиком при регистрации (ADR-0026).
+public sealed class CarrierRatesClient(HttpClient http, ILogger<CarrierRatesClient> logger)
+{
+    private sealed record RateResponse(decimal? Price, string? Currency, int? EtaDays);
+
+    // null - перевозчик недоступен или вернул ответ, из которого нельзя собрать котировку.
+    public async Task<CarrierRate?> GetRateAsync(string from, string to, int weightGrams, CancellationToken ct)
+    {
+        var url = $"rates?from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}&weightGrams={weightGrams}";
+        try
+        {
+            using var response = await http.GetAsync(url, ct);
+            if (!response.IsSuccessStatusCode)
+            {
+                logger.LogWarning("Carrier rates returned {StatusCode}", (int)response.StatusCode);
+                return null;
+            }
+            var body = await response.Content.ReadFromJsonAsync<RateResponse>(cancellationToken: ct);
+            return ToRate(body);
+        }
+        catch (Exception ex) when (ex is HttpRequestException or ExecutionRejectedException or JsonException)
+        {
+            logger.LogWarning(ex, "Carrier rates request failed");
+            return null;
+        }
+    }
+
+    private CarrierRate? ToRate(RateResponse? body)
+    {
+        if (body is not { Price: >= 0, EtaDays: >= 0, Currency.Length: 3 })
+        {
+            logger.LogWarning("Carrier rates response is incomplete or out of range");
+            return null;
+        }
+        var currency = body.Currency.ToUpperInvariant();
+        // Единственное место, где цена - decimal: дальше только минорные единицы (RUL-0009).
+        var minor = decimal.Round(body.Price.Value * MinorFactor(currency), 0, MidpointRounding.AwayFromZero);
+        if (minor > long.MaxValue)
+            return null;
+        return new CarrierRate(new Money((long)minor, currency), body.EtaDays.Value);
+    }
+
+    // Число знаков после запятой по ISO 4217; прочие валюты - два.
+    private static decimal MinorFactor(string currency) => currency switch
+    {
+        "JPY" or "KRW" or "VND" or "CLP" or "ISK" or "UGX" => 1m,
+        "BHD" or "JOD" or "KWD" or "OMR" or "TND" => 1000m,
+        _ => 100m,
+    };
+}
