+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public sealed class ListCustomerInvoicesValidator : BillingValidator<ListCustomerInvoicesQuery>
+{
+    public ListCustomerInvoicesValidator()
+    {
+        RuleFor(x => x.Limit).InclusiveBetween(1, 100).OverridePropertyName("limit");
+    }
+}
diff --git a/src/Billing.Api/Infrastructure/Persistence/InMemoryInvoiceRepository.cs b/src/Billing.Api/Infrastructure/Persistence/InMemoryInvoiceRepository.cs
index 73697c6..7f5d7bb 100644
--- a/src/Billing.Api/Infrastructure/Persistence/InMemoryInvoiceRepository.cs
+++ b/src/Billing.Api/Infrastructure/Persistence/InMemoryInvoiceRepository.cs
@@ -11,6 +11,22 @@ public sealed class InMemoryInvoiceRepository(InMemoryStore store) : IInvoiceRep
     public Task<IReadOnlyList<Invoice>> ListByStatusAsync(InvoiceStatus status, CancellationToken ct) =>
         Task.FromResult<IReadOnlyList<Invoice>>(store.Invoices.Values.Where(i => i.Status == status).ToList());
 
+    public Task<IReadOnlyList<Invoice>> ListByCustomerAsync(
+        CustomerId customerId, InvoiceCursor? after, int take, CancellationToken ct)
+    {
+        var query = store.Invoices.Values.Where(i => i.CustomerId == customerId);
+        if (after is not null)
+            query = query.Where(i =>
+                i.CreatedAt < after.CreatedAt
+                || (i.CreatedAt == after.CreatedAt && i.Id.Value.CompareTo(after.Id.Value) < 0));
+
+        return Task.FromResult<IReadOnlyList<Invoice>>(query
+            .OrderByDescending(i => i.CreatedAt)
+            .ThenByDescending(i => i.Id.Value)
+            .Take(take)
+            .ToList());
+    }
+
     public Task AddAsync(Invoice invoice, CancellationToken ct)
     {
         store.Invoices[invoice.Id] = invoice;
