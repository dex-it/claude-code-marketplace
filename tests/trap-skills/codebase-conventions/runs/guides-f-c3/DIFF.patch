diff --git a/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs
new file mode 100644
index 0000000..428aaf0
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs
@@ -0,0 +1,68 @@
+using System.Globalization;
+using System.Text;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+using Microsoft.AspNetCore.WebUtilities;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public sealed record ListCustomerInvoicesQuery(CustomerId CustomerId, int Limit, string? Cursor);
+
+public sealed record InvoiceListItem(
+    Guid Id,
+    long AmountMinor,
+    string Currency,
+    DateOnly DueDate,
+    DateTimeOffset CreatedAt,
+    InvoiceStatus Status,
+    DateTimeOffset? PaidAt);
+
+public sealed record InvoicePage(IReadOnlyList<InvoiceListItem> Items, string? NextCursor);
+
+public sealed class ListCustomerInvoicesHandler(IInvoiceRepository invoices, ListCustomerInvoicesValidator validator)
+{
+    public async Task<Result<InvoicePage>> HandleAsync(ListCustomerInvoicesQuery query, CancellationToken ct)
+    {
+        if (validator.Check(query) is { } error)
+            return error;
+
+        InvoiceCursor? after = null;
+        if (query.Cursor is not null)
+        {
+            after = DecodeCursor(query.Cursor);
+            if (after is null)
+                return new ValidationError("cursor", "invalid cursor");
+        }
+
+        // Берём на одну запись больше, чтобы узнать, есть ли следующая страница.
+        var found = await invoices.ListByCustomerAsync(query.CustomerId, after, query.Limit + 1, ct);
+        var hasMore = found.Count > query.Limit;
+        var page = hasMore ? found.Take(query.Limit).ToList() : found;
+
+        var items = page
+            .Select(i => new InvoiceListItem(
+                i.Id.Value, i.Amount.Minor, i.Amount.Currency, i.DueDate, i.CreatedAt, i.Status, i.PaidAt))
+            .ToList();
+        return new InvoicePage(items, hasMore ? EncodeCursor(page[^1]) : null);
+    }
+
+    private static string EncodeCursor(Invoice last) =>
+        WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(
+            $"{last.CreatedAt.ToString("O", CultureInfo.InvariantCulture)}|{last.Id.Value}"));
+
+    private static InvoiceCursor? DecodeCursor(string cursor)
+    {
+        try
+        {
+            var parts = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(cursor)).Split('|');
+            if (parts.Length == 2
+                && DateTimeOffset.TryParseExact(parts[0], "O", CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var createdAt)
+                && Guid.TryParse(parts[1], out var id))
+                return new InvoiceCursor(createdAt, new InvoiceId(id));
+        }
+        catch (Exception e) when (e is FormatException or ArgumentException)
+        {
+        }
+        return null;
+    }
+}
