diff --git a/src/Billing.Api/Application/Handlers/Invoices/RefundInvoiceHandler.cs b/src/Billing.Api/Application/Handlers/Invoices/RefundInvoiceHandler.cs
new file mode 100644
index 0000000..460795c
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Invoices/RefundInvoiceHandler.cs
@@ -0,0 +1,32 @@
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Messages;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public sealed record RefundInvoiceCommand(InvoiceId InvoiceId, long AmountMinor);
+
+public sealed class RefundInvoiceHandler(IInvoiceRepository invoices, RefundInvoiceValidator validator, IOutbox outbox)
+{
+    public async Task<Result<Guid>> HandleAsync(RefundInvoiceCommand command, CancellationToken ct)
+    {
+        if (validator.Check(command) is { } error)
+            return error;
+
+        var invoice = await invoices.FindAsync(command.InvoiceId, ct);
+        if (invoice is null)
+            return new InvoiceNotFoundError(command.InvoiceId);
+        if (invoice.Status != InvoiceStatus.Paid)
+            return new InvoiceInvalidStateError(invoice.Id, invoice.Status, "refund");
+        if (command.AmountMinor > invoice.RefundableMinor)
+            return new RefundExceedsInvoiceError(invoice.Id, command.AmountMinor, invoice.RefundableMinor);
+
+        var refundId = Guid.NewGuid();
+        var posting = invoice.Amount with { Minor = -command.AmountMinor };
+        await outbox.EnqueueAsync(new LedgerPostingRequested($"refund-{invoice.Id}-{refundId}", posting, "Invoice refund"), ct);
+
+        invoice.Refund(command.AmountMinor);
+        await invoices.SaveAsync(invoice, ct);
+        return refundId;
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Invoices/RefundInvoiceValidator.cs b/src/Billing.Api/Application/Handlers/Invoices/RefundInvoiceValidator.cs
