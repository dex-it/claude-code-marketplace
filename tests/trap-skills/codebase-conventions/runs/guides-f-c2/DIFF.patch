diff --git a/src/Billing.Api/Application/Handlers/Invoices/InvoiceCursor.cs b/src/Billing.Api/Application/Handlers/Invoices/InvoiceCursor.cs
new file mode 100644
index 0000000..ed69386
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Invoices/InvoiceCursor.cs
@@ -0,0 +1,33 @@
+using System.Buffers.Text;
+using System.Globalization;
+using System.Text;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public readonly record struct InvoiceCursor(DateTimeOffset CreatedAt, InvoiceId Id)
+{
+    public static InvoiceCursor For(Invoice invoice) => new(invoice.CreatedAt, invoice.Id);
+
+    public string Encode() =>
+        Base64Url.EncodeToString(Encoding.UTF8.GetBytes($"{CreatedAt.ToString("O", CultureInfo.InvariantCulture)}|{Id.Value}"));
+
+    public static bool TryParse(string value, out InvoiceCursor cursor)
+    {
+        cursor = default;
+        try
+        {
+            var parts = Encoding.UTF8.GetString(Base64Url.DecodeFromChars(value)).Split('|');
+            if (parts.Length != 2
+                || !DateTimeOffset.TryParseExact(parts[0], "O", CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var createdAt)
+                || !Guid.TryParse(parts[1], out var id))
+                return false;
+            cursor = new InvoiceCursor(createdAt, new InvoiceId(id));
+            return true;
+        }
+        catch (FormatException)
+        {
+            return false;
+        }
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs
new file mode 100644
index 0000000..c71d13d
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs
@@ -0,0 +1,28 @@
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public sealed record ListCustomerInvoicesQuery(CustomerId CustomerId, int Limit, string? Cursor);
+
+public sealed record InvoicePage(IReadOnlyList<Invoice> Items, string? NextCursor);
+
+public sealed class ListCustomerInvoicesHandler(IInvoiceRepository invoices, ListCustomerInvoicesValidator validator)
+{
+    public async Task<Result<InvoicePage>> HandleAsync(ListCustomerInvoicesQuery query, CancellationToken ct)
+    {
+        if (validator.Check(query) is { } error)
+            return error;
+
+        InvoiceCursor? after = null;
+        if (query.Cursor is not null && InvoiceCursor.TryParse(query.Cursor, out var parsed))
+            after = parsed;
+
+        var found = await invoices.ListByCustomerAsync(query.CustomerId, after, query.Limit + 1, ct);
+        if (found.Count <= query.Limit)
+            return new InvoicePage(found, null);
+
+        var items = found.Take(query.Limit).ToList();
+        return new InvoicePage(items, InvoiceCursor.For(items[^1]).Encode());
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesValidator.cs b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesValidator.cs
new file mode 100644
index 0000000..2c96fb8
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesValidator.cs
@@ -0,0 +1,17 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public sealed class ListCustomerInvoicesValidator : BillingValidator<ListCustomerInvoicesQuery>
+{
+    public ListCustomerInvoicesValidator()
+    {
+        RuleFor(x => x.Limit).InclusiveBetween(1, 100).OverridePropertyName("limit");
+        RuleFor(x => x.Cursor)
+            .Must(c => InvoiceCursor.TryParse(c!, out _))
+            .When(x => x.Cursor is not null)
+            .WithMessage("invalid cursor")
+            .OverridePropertyName("cursor");
+    }
+}
