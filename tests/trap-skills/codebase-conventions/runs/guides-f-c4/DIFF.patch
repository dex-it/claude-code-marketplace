diff --git a/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs
new file mode 100644
index 0000000..36703ee
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Invoices/ListCustomerInvoicesHandler.cs
@@ -0,0 +1,66 @@
+using System.Buffers.Text;
+using System.Globalization;
+using System.Text;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public sealed record ListCustomerInvoicesQuery(CustomerId CustomerId, int? Limit, string? Cursor);
+
+public sealed record InvoicePage(IReadOnlyList<Invoice> Items, string? NextCursor);
+
+public sealed class ListCustomerInvoicesHandler(
+    IInvoiceRepository invoices,
+    ListCustomerInvoicesValidator validator)
+{
+    public const int DefaultLimit = 20;
+
+    public async Task<Result<InvoicePage>> HandleAsync(ListCustomerInvoicesQuery query, CancellationToken ct)
+    {
+        if (validator.Check(query) is { } error)
+            return error;
+
+        InvoiceCursor? after = null;
+        if (query.Cursor is not null)
+        {
+            after = InvoiceCursor.Parse(query.Cursor);
+            if (after is null)
+                return new ValidationError("cursor", "Invalid cursor");
+        }
+
+        var limit = query.Limit ?? DefaultLimit;
+        var found = await invoices.ListByCustomerAsync(query.CustomerId, after, limit + 1, ct);
+
+        if (found.Count <= limit)
+            return new InvoicePage(found, null);
+
+        var items = found.Take(limit).ToList();
+        return new InvoicePage(items, InvoiceCursor.From(items[^1]).Encode());
+    }
+}
+
+public sealed record InvoiceCursor(DateTimeOffset CreatedAt, InvoiceId Id)
+{
+    public static InvoiceCursor From(Invoice invoice) => new(invoice.CreatedAt, invoice.Id);
+
+    public string Encode() =>
+        Base64Url.EncodeToString(Encoding.UTF8.GetBytes($"{CreatedAt:O}|{Id}"));
+
+    public static InvoiceCursor? Parse(string cursor)
+    {
+        try
+        {
+            var parts = Encoding.UTF8.GetString(Base64Url.DecodeFromChars(cursor)).Split('|');
+            if (parts.Length == 2
+                && DateTimeOffset.TryParseExact(parts[0], "O", CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var createdAt)
+                && Guid.TryParse(parts[1], out var id))
+                return new InvoiceCursor(createdAt, new InvoiceId(id));
+        }
+        catch (Exception e) when (e is FormatException or ArgumentException)
+        {
+        }
+
+        return null;
+    }
+}
