@@ -0,0 +1,65 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using Meridian.Common;
+using Meridian.Shipping.Domain;
+using Microsoft.Extensions.Logging;
+
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+public sealed record CarrierRate(Money Price, int EtaDays);
+
+// Повторы, таймауты и предохранитель - стандартный обработчик при регистрации (ADR-0026).
+public sealed class CarrierRatesClient(HttpClient http, ILogger<CarrierRatesClient> logger)
+{
+    // Ответ перевозчика (docs/specs/carrier-api.md): цена десятичная, в единицах валюты.
+    private sealed record RateDto(decimal Price, string Currency, int EtaDays);
+
+    public async Task<Result<CarrierRate>> GetRateAsync(Address from, Address to, int weightGrams, CancellationToken ct)
+    {
+        var url = $"rates?from={Uri.EscapeDataString(from.PostalCode)}&to={Uri.EscapeDataString(to.PostalCode)}&weightGrams={weightGrams}";
+        try
+        {
+            using var response = await http.GetAsync(url, ct);
+            if (!response.IsSuccessStatusCode)
+            {
+                logger.LogWarning("Carrier rates request failed with status {StatusCode}", (int)response.StatusCode);
+                return new CarrierUnavailableError($"status {(int)response.StatusCode}");
+            }
+
+            var dto = await response.Content.ReadFromJsonAsync<RateDto>(
+                new JsonSerializerOptions(JsonSerializerDefaults.Web), ct);
+            return ToRate(dto);
+        }
+        catch (Exception ex) when (ex is HttpRequestException or TimeoutException or JsonException
+                                   || (ex is TaskCanceledException && !ct.IsCancellationRequested))
+        {
+            logger.LogWarning(ex, "Carrier rates request failed");
+            return new CarrierUnavailableError("request failed");
+        }
+    }
+
+    private Result<CarrierRate> ToRate(RateDto? dto)
+    {
+        if (dto is null || dto.Price < 0 || dto.EtaDays < 0 || dto.Currency is not { Length: 3 })
+        {
+            logger.LogWarning("Carrier rates response is invalid");
+            return new CarrierUnavailableError("invalid response");
+        }
+
+        var minor = decimal.Round(dto.Price * MinorUnitFactor(dto.Currency), 0, MidpointRounding.AwayFromZero);
+        if (minor > long.MaxValue)
+        {
+            logger.LogWarning("Carrier rate price is out of range");
+            return new CarrierUnavailableError("invalid response");
+        }
+        return new CarrierRate(new Money((long)minor, dto.Currency.ToUpperInvariant()), dto.EtaDays);
+    }
+
+    // Число знаков после запятой по ISO 4217; для прочих валют - 2.
+    private static decimal MinorUnitFactor(string currency) => currency.ToUpperInvariant() switch
+    {
+        "JPY" or "KRW" or "VND" or "CLP" or "ISK" or "HUF" => 1m,
+        "BHD" or "KWD" or "OMR" or "JOD" or "TND" => 1000m,
+        _ => 100m,
+    };
+}
