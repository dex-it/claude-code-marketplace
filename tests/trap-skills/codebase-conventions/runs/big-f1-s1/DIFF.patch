+using Meridian.Common;
+using Meridian.Shipping.Domain;
+
+namespace Meridian.Shipping.Api;
+
+public static class ShippingProblems
+{
+    public static IResult From(MeridianError error) => Results.Problem(
+        title: error.Message,
+        statusCode: error switch
+        {
+            ShipmentNotFoundError => StatusCodes.Status404NotFound,
+            ShipmentNotQuotableError => StatusCodes.Status409Conflict,
+            _ => StatusCodes.Status400BadRequest,
+        },
+        extensions: new Dictionary<string, object?> { ["code"] = error.Code });
+}
