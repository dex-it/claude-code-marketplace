@@ -0,0 +1,38 @@
+using System.Net.Http.Json;
+using Meridian.Common;
+
+namespace Meridian.Shipping.Infrastructure.Carriers;
+
+public sealed record CarrierRate(Money Price, int EtaDays);
+
+// Повторы и таймауты - стандартный обработчик устойчивости (ADR-0026).
+public sealed class CarrierRatesClient(HttpClient http)
+{
+    public async Task<CarrierRate> GetRateAsync(string from, string to, int weightGrams, CancellationToken ct)
+    {
+        var url = $"rates?from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}&weightGrams={weightGrams}";
+        var response = await http.GetFromJsonAsync<RateResponse>(url, ct)
+            ?? throw new InvalidOperationException("Carrier returned an empty rate");
+
+        if (response.Price < 0 || response.EtaDays < 0 || response.Currency is not { Length: 3 })
+            throw new InvalidOperationException("Carrier returned an invalid rate");
+
+        return new CarrierRate(new Money(ToMinor(response.Price, response.Currency), response.Currency), response.EtaDays);
+    }
+
+    // Цена перевозчика - decimal в единицах валюты; дальше по системе это Money в минорных единицах (RUL-0009).
+    private static long ToMinor(decimal price, string currency)
+    {
+        var scale = (decimal)Math.Pow(10, MinorUnitDigits(currency));
+        return checked((long)Math.Round(price * scale, MidpointRounding.AwayFromZero));
+    }
+
+    private static int MinorUnitDigits(string currency) => currency switch
+    {
+        "JPY" or "KRW" or "VND" or "CLP" or "ISK" => 0,
+        "BHD" or "JOD" or "KWD" or "OMR" or "TND" => 3,
+        _ => 2,
+    };
+
+    private sealed record RateResponse(decimal Price, string? Currency, int EtaDays);
+}
