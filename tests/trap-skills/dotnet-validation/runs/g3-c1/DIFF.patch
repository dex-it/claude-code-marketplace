@@ -0,0 +1,22 @@
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record UpdatePricePlanCommand(PricePlanId Id, PricePlanDraft Draft);
+
+public sealed class UpdatePricePlanHandler(IPricePlanRepository plans, PricePlanValidator validator)
+{
+    public async Task<Result<PricePlanId>> HandleAsync(UpdatePricePlanCommand command, CancellationToken ct)
+    {
+        if (validator.Check(command.Draft) is { } error)
+            return error;
+
+        if (await plans.FindAsync(command.Id, ct) is null)
+            return new PricePlanNotFoundError(command.Id);
+
+        var plan = command.Draft.ToPlan(command.Id);
+        await plans.SaveAsync(plan, ct);
+        return plan.Id;
+    }
+}
