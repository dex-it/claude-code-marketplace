+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record PricePlanDraft(
+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid? OwnerTeamId,
+    PricePlanKind? Kind,
+    IReadOnlyList<NotificationChannel>? Channels,
+    long? MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
+    DateTimeOffset? ValidTo,
+    decimal? DiscountRatio,
+    string? WebhookUrl,
+    IReadOnlyList<PriceRule?>? Rules)
+{
+    // Вызывать только после успешной валидации.
+    internal PricePlan ToPlan(PricePlanId id) => new()
+    {
+        Id = id,
+        Name = Name!.Trim(),
+        Description = Description,
+        ExternalCode = ExternalCode!.Trim(),
+        OwnerTeamId = new TeamId(OwnerTeamId!.Value),
+        Kind = Kind!.Value,
+        Channels = Channels!.Distinct().ToList(),
+        MonthlyFee = new Money(MonthlyFeeMinor!.Value, Currency!),
+        TrialDays = TrialDays!.Value,
+        ValidFrom = ValidFrom!.Value,
+        ValidTo = ValidTo,
+        DiscountRatio = DiscountRatio,
+        WebhookUrl = new Uri(WebhookUrl!),
+        Rules = Rules!.Select(r => r!).ToList(),
+    };
+}
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanValidator.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanValidator.cs
new file mode 100644
index 0000000..f96abbc
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanValidator.cs
@@ -0,0 +1,101 @@
+using System.Net;
+using System.Net.Sockets;
+using Billing.Api.Application.Validation;
+using Billing.Api.Domain;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed class PricePlanValidator : BillingValidator<PricePlanDraft>
+{
+    public PricePlanValidator()
+    {
+        RuleFor(x => x.Name).NotEmpty().MaximumLength(200);
+        RuleFor(x => x.Description).MaximumLength(2000);
+        RuleFor(x => x.ExternalCode).NotEmpty();
+        RuleFor(x => x.OwnerTeamId).NotNull().NotEqual(Guid.Empty);
+        RuleFor(x => x.Kind).NotNull().IsInEnum();
+        RuleFor(x => x.Channels).NotEmpty();
+        RuleForEach(x => x.Channels).IsInEnum();
+        RuleFor(x => x.MonthlyFeeMinor).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.Currency).NotNull().Length(3);
+        RuleFor(x => x.TrialDays).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.ValidFrom).NotNull();
+        RuleFor(x => x.ValidTo)
+            .Must((x, to) => to is null || x.ValidFrom is null || to > x.ValidFrom)
+            .WithMessage("must be later than ValidFrom");
+        RuleFor(x => x.DiscountRatio).InclusiveBetween(0m, 1m);
+        RuleFor(x => x.WebhookUrl).NotEmpty().Must(IsPublicHttpsUrl)
+            .WithMessage("must be an absolute public https URL");
+        RuleFor(x => x.Rules).NotNull();
+        RuleForEach(x => x.Rules).Custom((rule, ctx) =>
+        {
+            if (RuleProblem(rule) is { } problem)
+                ctx.AddFailure(problem);
+        });
+    }
+
+    private static string? RuleProblem(PriceRule? rule) => rule switch
+    {
+        null => "rule must not be null",
+        FlatRule f => f.AmountMinor < 0 ? "amountMinor must not be negative" : null,
+        UsageRule u => string.IsNullOrWhiteSpace(u.Meter) ? "meter is required"
+            : u.UnitPriceMinor < 0 ? "unitPriceMinor must not be negative" : null,
+        TieredRule t => TiersProblem(t.Tiers),
+        _ => "unknown rule type",
+    };
+
+    private static string? TiersProblem(IReadOnlyList<PriceTier?>? tiers)
+    {
+        if (tiers is not { Count: > 0 })
+            return "tiers must not be empty";
+        long previous = 0;
+        foreach (var tier in tiers)
+        {
+            if (tier is null)
+                return "tier must not be null";
+            if (tier.UpTo <= previous)
+                return "tiers upTo must be positive and strictly increasing";
+            if (tier.PriceMinor < 0)
+                return "tier priceMinor must not be negative";
+            previous = tier.UpTo;
+        }
+        return null;
+    }
+
+    // Billing сам обращается по этому адресу: только https и не во внутреннюю сеть (SSRF).
+    private static bool IsPublicHttpsUrl(string? value)
+    {
+        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri)
+            || uri.Scheme != Uri.UriSchemeHttps
+            || !string.IsNullOrEmpty(uri.UserInfo))
+            return false;
+
+        var host = uri.DnsSafeHost;
+        if (host.Equals("localhost", StringComparison.OrdinalIgnoreCase)
+            || host.EndsWith(".localhost", StringComparison.OrdinalIgnoreCase)
+            || host.EndsWith(".local", StringComparison.OrdinalIgnoreCase)
+            || host.EndsWith(".internal", StringComparison.OrdinalIgnoreCase))
+            return false;
+
+        return !IPAddress.TryParse(host, out var ip) || IsPublic(ip);
+    }
+
+    private static bool IsPublic(IPAddress ip)
+    {
+        if (ip.IsIPv4MappedToIPv6)
+            ip = ip.MapToIPv4();
+        if (IPAddress.IsLoopback(ip) || ip.Equals(IPAddress.Any) || ip.Equals(IPAddress.IPv6Any))
+            return false;
+        var b = ip.GetAddressBytes();
+        if (ip.AddressFamily == AddressFamily.InterNetworkV6)
+            return !(ip.IsIPv6LinkLocal || ip.IsIPv6SiteLocal || ip.IsIPv6Multicast || (b[0] & 0xFE) == 0xFC);
+        return !(b[0] == 10
+                 || b[0] == 0
+                 || (b[0] == 172 && b[1] is >= 16 and <= 31)
+                 || (b[0] == 192 && b[1] == 168)
+                 || (b[0] == 169 && b[1] == 254)
+                 || (b[0] == 100 && b[1] is >= 64 and <= 127)
+                 || b[0] >= 224);
+    }
+}
