+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Billing.Api.Application.Handlers.PricePlans;
+using Billing.Api.Domain;
+using Microsoft.AspNetCore.Http.Json;
+using Microsoft.Extensions.Options;
+
+namespace Billing.Api.Api;
+
+public sealed record PriceTierDto(long UpTo, long PriceMinor);
+
+[JsonPolymorphic(TypeDiscriminatorPropertyName = "type")]
+[JsonDerivedType(typeof(FlatRuleDto), "flat")]
+[JsonDerivedType(typeof(TieredRuleDto), "tiered")]
+[JsonDerivedType(typeof(UsageRuleDto), "usage")]
+public abstract record PriceRuleDto;
+
+public sealed record FlatRuleDto(long AmountMinor) : PriceRuleDto;
+
+public sealed record TieredRuleDto(List<PriceTierDto?>? Tiers) : PriceRuleDto;
+
+public sealed record UsageRuleDto(string? Meter, long UnitPriceMinor) : PriceRuleDto;
+
+public sealed record PricePlanRequest(
+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid? OwnerTeamId,
+    PricePlanKind? Kind,
+    List<NotificationChannel>? Channels,
+    long? MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
+    DateTimeOffset? ValidTo,
+    decimal? DiscountRatio,
+    string? WebhookUrl,
+    List<PriceRuleDto?>? Rules)
+{
+    public PricePlanDraft ToDraft() => new(
+        Name, Description, ExternalCode, OwnerTeamId, Kind, Channels, MonthlyFeeMinor, Currency, TrialDays,
+        ValidFrom, ValidTo, DiscountRatio, WebhookUrl, Rules?.Select(ToRule).ToList());
+
+    private static PriceRule? ToRule(PriceRuleDto? dto) => dto switch
+    {
+        FlatRuleDto f => new FlatRule(f.AmountMinor),
+        TieredRuleDto t => new TieredRule(
+            t.Tiers?.Select(x => x is null ? null : new PriceTier(x.UpTo, x.PriceMinor)).ToList()),
+        UsageRuleDto u => new UsageRule(u.Meter, u.UnitPriceMinor),
+        _ => null,
+    };
+}
+
+public static class PricePlanEndpoints
+{
+    public static IEndpointRouteBuilder MapPricePlanEndpoints(this IEndpointRouteBuilder app)
+    {
+        var plans = app.MapGroup("/price-plans");
+
+        plans.MapPost("/", async (HttpContext http, CreatePricePlanHandler handler, CancellationToken ct) =>
+        {
+            var body = await ReadBodyAsync(http, ct);
+            if (!body.IsSuccess)
+                return body.Error!.ToHttp();
+            return (await handler.HandleAsync(new CreatePricePlanCommand(body.Value!.ToDraft()), ct))
+                .ToHttp(id => Results.Created($"/price-plans/{id}", new { id = id.Value }));
+        });
+
+        plans.MapPut("/{id:guid}", async (Guid id, HttpContext http, UpdatePricePlanHandler handler, CancellationToken ct) =>
+        {
+            var body = await ReadBodyAsync(http, ct);
+            if (!body.IsSuccess)
+                return body.Error!.ToHttp();
+            return (await handler.HandleAsync(new UpdatePricePlanCommand(new PricePlanId(id), body.Value!.ToDraft()), ct))
+                .ToHttp(_ => Results.NoContent());
+        });
+
+        return app;
+    }
+
+    // Нечитаемое тело (неверный JSON, неизвестный type или kind) - тоже 400 с кодом, как у остальных ошибок запроса.
+    private static async Task<Result<PricePlanRequest>> ReadBodyAsync(HttpContext http, CancellationToken ct)
+    {
+        var options = http.RequestServices.GetRequiredService<IOptions<JsonOptions>>().Value.SerializerOptions;
+        try
+        {
+            var request = await http.Request.ReadFromJsonAsync<PricePlanRequest>(options, ct);
+            return request is null ? new ValidationError("body", "is required") : request;
+        }
+        catch (JsonException e)
+        {
+            return new ValidationError(e.Path ?? "body", "is malformed");
+        }
+        catch (InvalidOperationException)
+        {
+            return new ValidationError("body", "must be application/json");
+        }
+    }
+}
