@@ -0,0 +1,32 @@
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+internal static class PricePlanMapping
+{
+    // Вызывается только после успешной проверки PricePlanDraftValidator.
+    public static void ApplyTo(this PricePlanDraft d, PricePlan plan)
+    {
+        plan.Name = d.Name!;
+        plan.Description = d.Description;
+        plan.ExternalCode = d.ExternalCode!;
+        plan.OwnerTeamId = new TeamId(d.OwnerTeamId!.Value);
+        plan.Kind = d.Kind!.Value;
+        plan.Channels = d.Channels!.ToList();
+        plan.MonthlyFee = new Money(d.MonthlyFeeMinor!.Value, d.Currency!);
+        plan.TrialDays = d.TrialDays!.Value;
+        plan.ValidFrom = d.ValidFrom!.Value;
+        plan.ValidTo = d.ValidTo;
+        plan.DiscountRatio = d.DiscountRatio;
+        plan.WebhookUrl = new Uri(d.WebhookUrl!);
+        plan.Rules = d.Rules!.Select(r => ToRule(r!)).ToList();
+    }
+
+    private static PricingRule ToRule(PricingRuleInput input) => input switch
+    {
+        FlatRuleInput f => new FlatRule(f.AmountMinor!.Value),
+        TieredRuleInput t => new TieredRule(t.Tiers!.Select(x => new PriceTier(x!.UpTo!.Value, x.PriceMinor!.Value)).ToList()),
+        UsageRuleInput u => new UsageRule(u.Meter!, u.UnitPriceMinor!.Value),
+        _ => throw new ArgumentOutOfRangeException(nameof(input), input.GetType().Name, "Unknown pricing rule"),
+    };
+}
