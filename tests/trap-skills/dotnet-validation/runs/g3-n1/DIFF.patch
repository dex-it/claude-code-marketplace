+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record CreatePricePlanCommand(PricePlanDraft Draft);
+
+public sealed class CreatePricePlanHandler(IPricePlanRepository plans, PricePlanDraftValidator validator)
+{
+    public async Task<Result<PricePlanId>> HandleAsync(CreatePricePlanCommand command, CancellationToken ct)
+    {
+        if (validator.Check(command.Draft) is { } error)
+            return error;
+
+        var plan = new PricePlan
+        {
+            Id = PricePlanId.New(),
+            Name = default!,
+            ExternalCode = default!,
+            OwnerTeamId = default,
+            Kind = default,
+            Channels = default!,
+            MonthlyFee = default,
+            TrialDays = default,
+            ValidFrom = default,
+            WebhookUrl = default!,
+            Rules = default!,
+        };
+        command.Draft.ApplyTo(plan);
+        await plans.AddAsync(plan, ct);
+        return plan.Id;
+    }
+}
