diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
new file mode 100644
index 0000000..7bbc866
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
@@ -0,0 +1,84 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed class PricePlanDraftValidator : BillingValidator<PricePlanDraft>
+{
+    public PricePlanDraftValidator()
+    {
+        RuleFor(x => x.Name).NotEmpty().MaximumLength(FieldLimits.NameMaxLength);
+        RuleFor(x => x.Description).MaximumLength(FieldLimits.DescriptionMaxLength);
+        RuleFor(x => x.ExternalCode).NotEmpty().MaximumLength(FieldLimits.ExternalCodeMaxLength);
+        RuleFor(x => x.OwnerTeamId).NotNull().NotEqual(Guid.Empty);
+        RuleFor(x => x.Kind).NotNull().IsInEnum();
+
+        RuleFor(x => x.Channels).NotEmpty()
+            .Must(c => c!.Distinct().Count() == c!.Count).WithMessage("channels must not contain duplicates");
+        RuleForEach(x => x.Channels).IsInEnum();
+
+        RuleFor(x => x.MonthlyFeeMinor).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.Currency).NotEmpty().Length(FieldLimits.CurrencyLength)
+            .Matches("^[A-Z]{3}$").WithMessage("currency must be a 3-letter upper-case code");
+        RuleFor(x => x.TrialDays).NotNull().InclusiveBetween(0, FieldLimits.MaxTrialDays);
+
+        RuleFor(x => x.ValidFrom).NotNull();
+        RuleFor(x => x.ValidTo).GreaterThan(x => x.ValidFrom)
+            .When(x => x.ValidTo is not null && x.ValidFrom is not null);
+        RuleFor(x => x.DiscountRatio).InclusiveBetween(0m, 1m).When(x => x.DiscountRatio is not null);
+
+        RuleFor(x => x.WebhookUrl).NotEmpty().MaximumLength(FieldLimits.WebhookUrlMaxLength)
+            .Must(WebhookUrlPolicy.IsAllowed).WithMessage("webhookUrl must be an absolute public https URL");
+
+        RuleFor(x => x.Rules).NotNull()
+            .Must(r => r!.Count <= FieldLimits.MaxRules).WithMessage($"rules must contain at most {FieldLimits.MaxRules} items");
+        RuleForEach(x => x.Rules).NotNull().SetInheritanceValidator(v =>
+        {
+            v.Add(new FlatRuleValidator());
+            v.Add(new TieredRuleValidator());
+            v.Add(new UsageRuleValidator());
+        });
+    }
+
+    private sealed class FlatRuleValidator : AbstractValidator<FlatRuleInput>
+    {
+        public FlatRuleValidator() => RuleFor(x => x.AmountMinor).NotNull().GreaterThanOrEqualTo(0);
+    }
+
+    private sealed class TieredRuleValidator : AbstractValidator<TieredRuleInput>
+    {
+        public TieredRuleValidator()
+        {
+            RuleFor(x => x.Tiers).NotEmpty()
+                .Must(t => t!.Count <= FieldLimits.MaxTiers).WithMessage($"tiers must contain at most {FieldLimits.MaxTiers} items")
+                .Must(IsStrictlyIncreasing).WithMessage("tiers must have strictly increasing upTo");
+            RuleForEach(x => x.Tiers).NotNull().ChildRules(t =>
+            {
+                t.RuleFor(x => x!.UpTo).NotNull().GreaterThan(0);
+                t.RuleFor(x => x!.PriceMinor).NotNull().GreaterThanOrEqualTo(0);
+            });
+        }
+
+        // Отсутствующие значения ловят правила элементов.
+        private static bool IsStrictlyIncreasing(IReadOnlyList<TierInput?>? tiers)
+        {
+            long? previous = null;
+            foreach (var upTo in tiers!.Select(t => t?.UpTo).Where(u => u is not null))
+            {
+                if (previous is not null && upTo <= previous)
+                    return false;
+                previous = upTo;
+            }
+            return true;
+        }
+    }
+
+    private sealed class UsageRuleValidator : AbstractValidator<UsageRuleInput>
+    {
+        public UsageRuleValidator()
+        {
+            RuleFor(x => x.Meter).NotEmpty().MaximumLength(FieldLimits.MeterMaxLength);
+            RuleFor(x => x.UnitPriceMinor).NotNull().GreaterThanOrEqualTo(0);
+        }
+    }
+}
