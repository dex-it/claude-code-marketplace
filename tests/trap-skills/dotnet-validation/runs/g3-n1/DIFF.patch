diff --git a/src/Billing.Api/Application/Validation/WebhookUrlPolicy.cs b/src/Billing.Api/Application/Validation/WebhookUrlPolicy.cs
new file mode 100644
index 0000000..5f81b54
--- /dev/null
+++ b/src/Billing.Api/Application/Validation/WebhookUrlPolicy.cs
@@ -0,0 +1,43 @@
+using System.Net;
+using System.Net.Sockets;
+
+namespace Billing.Api.Application.Validation;
+
+// Billing сам ходит по адресу клиента, поэтому внутренние адреса не допускаются.
+public static class WebhookUrlPolicy
+{
+    public static bool IsAllowed(string? value)
+    {
+        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri)
+            || uri.Scheme != Uri.UriSchemeHttps
+            || uri.UserInfo.Length > 0)
+            return false;
+
+        if (uri.HostNameType == UriHostNameType.Dns)
+            return uri.IdnHost != "localhost"
+                && !uri.IdnHost.EndsWith(".localhost", StringComparison.OrdinalIgnoreCase)
+                && !uri.IdnHost.EndsWith(".internal", StringComparison.OrdinalIgnoreCase)
+                && !uri.IdnHost.EndsWith(".local", StringComparison.OrdinalIgnoreCase);
+
+        return IPAddress.TryParse(uri.IdnHost, out var ip) && IsPublic(ip);
+    }
+
+    private static bool IsPublic(IPAddress ip)
+    {
+        if (ip.IsIPv4MappedToIPv6)
+            ip = ip.MapToIPv4();
+        if (IPAddress.IsLoopback(ip) || ip.Equals(IPAddress.Any) || ip.Equals(IPAddress.IPv6Any))
+            return false;
+
+        var b = ip.GetAddressBytes();
+        if (ip.AddressFamily == AddressFamily.InterNetwork)
+            return !(b[0] == 10
+                || (b[0] == 172 && b[1] is >= 16 and <= 31)
+                || (b[0] == 192 && b[1] == 168)
+                || (b[0] == 169 && b[1] == 254)
+                || (b[0] == 100 && b[1] is >= 64 and <= 127)
+                || b[0] == 0);
+
+        return !(ip.IsIPv6LinkLocal || ip.IsIPv6SiteLocal || ip.IsIPv6UniqueLocal || ip.IsIPv6Multicast);
+    }
+}
