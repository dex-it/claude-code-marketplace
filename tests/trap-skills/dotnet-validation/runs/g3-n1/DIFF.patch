+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid? OwnerTeamId,
+    PlanKind? Kind,
+    IReadOnlyList<NotificationChannel>? Channels,
+    long? MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
