+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record PricePlanDraft(
+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid? OwnerTeamId,
+    PlanKind? Kind,
+    IReadOnlyList<NotificationChannel>? Channels,
+    long MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
+    DateTimeOffset? ValidTo,
+    decimal? DiscountRatio,
+    string? WebhookUrl,
+    IReadOnlyList<PricingRule?>? Rules);
+
+public static class PricePlanDraftExtensions
+{
+    public static void ApplyTo(this PricePlanDraft d, PricePlan plan)
+    {
+        plan.Name = d.Name!;
+        plan.Description = d.Description;
+        plan.ExternalCode = d.ExternalCode!;
+        plan.OwnerTeamId = d.OwnerTeamId!.Value;
+        plan.Kind = d.Kind!.Value;
+        plan.Channels = d.Channels!.Distinct().ToList();
+        plan.MonthlyFee = new Money(d.MonthlyFeeMinor, d.Currency!);
+        plan.TrialDays = d.TrialDays!.Value;
+        plan.ValidFrom = d.ValidFrom!.Value;
+        plan.ValidTo = d.ValidTo;
+        plan.DiscountRatio = d.DiscountRatio;
+        plan.WebhookUrl = new Uri(d.WebhookUrl!);
+        plan.Rules = d.Rules!.Select(r => r!).ToList();
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
new file mode 100644
index 0000000..9969eb7
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
@@ -0,0 +1,48 @@
+using Billing.Api.Application.Validation;
+using Billing.Api.Domain;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed class PricePlanDraftValidator : BillingValidator<PricePlanDraft>
+{
+    public PricePlanDraftValidator()
+    {
+        RuleFor(x => x.Name).NotEmpty().MaximumLength(200);
+        RuleFor(x => x.Description).MaximumLength(2000);
+        RuleFor(x => x.ExternalCode).NotEmpty();
+        RuleFor(x => x.OwnerTeamId).NotNull().NotEqual(Guid.Empty);
+        RuleFor(x => x.Kind).NotNull().IsInEnum();
+        RuleFor(x => x.Channels).NotEmpty();
+        RuleForEach(x => x.Channels).IsInEnum();
+        RuleFor(x => x.MonthlyFeeMinor).GreaterThanOrEqualTo(0);
+        RuleFor(x => x.Currency).NotNull().Length(3);
+        RuleFor(x => x.TrialDays).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.ValidFrom).NotNull();
+        RuleFor(x => x.ValidTo)
+            .GreaterThan(x => x.ValidFrom)
+            .When(x => x.ValidTo is not null && x.ValidFrom is not null);
+        RuleFor(x => x.DiscountRatio).InclusiveBetween(0m, 1m).When(x => x.DiscountRatio is not null);
+        RuleFor(x => x.WebhookUrl).NotEmpty()
+            .Must(u => Uri.TryCreate(u, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps)
+            .WithMessage("must be an absolute https URL");
+        RuleFor(x => x.Rules).NotNull();
+        RuleForEach(x => x.Rules).Custom((rule, ctx) =>
+        {
+            if (RuleError(rule) is { } message)
+                ctx.AddFailure(message);
+        });
+    }
+
+    private static string? RuleError(PricingRule? rule) => rule switch
+    {
+        FlatRule r => r.AmountMinor < 0 ? "flat amountMinor must not be negative" : null,
+        TieredRule r => r.Tiers.Count == 0 ? "tiered rule needs tiers"
+            : r.Tiers.Any(t => t.UpTo <= 0 || t.PriceMinor < 0) ? "tier upTo must be positive and priceMinor not negative"
+            : null,
+        UsageRule r => string.IsNullOrWhiteSpace(r.Meter) ? "usage meter is required"
+            : r.UnitPriceMinor < 0 ? "usage unitPriceMinor must not be negative"
+            : null,
+        _ => "rule is required",
+    };
+}
