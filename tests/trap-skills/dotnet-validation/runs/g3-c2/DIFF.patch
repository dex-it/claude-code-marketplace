@@ -0,0 +1,66 @@
+using System.Text.Json.Serialization;
+using Billing.Api.Application.Handlers.PricePlans;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Api;
+
+[JsonPolymorphic(TypeDiscriminatorPropertyName = "type")]
+[JsonDerivedType(typeof(FlatRuleDto), "flat")]
+[JsonDerivedType(typeof(TieredRuleDto), "tiered")]
+[JsonDerivedType(typeof(UsageRuleDto), "usage")]
+public abstract record PricingRuleDto;
+
+public sealed record FlatRuleDto(long AmountMinor) : PricingRuleDto;
+
+public sealed record PriceTierDto(long UpTo, long PriceMinor);
+
+public sealed record TieredRuleDto(List<PriceTierDto>? Tiers) : PricingRuleDto;
+
+public sealed record UsageRuleDto(string? Meter, long UnitPriceMinor) : PricingRuleDto;
+
+public sealed record PricePlanRequest(
+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid? OwnerTeamId,
+    PlanKind? Kind,
+    List<NotificationChannel>? Channels,
+    long MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
+    DateTimeOffset? ValidTo,
+    decimal? DiscountRatio,
+    string? WebhookUrl,
+    List<PricingRuleDto?>? Rules)
+{
+    public PricePlanDraft ToDraft() => new(
+        Name, Description, ExternalCode, OwnerTeamId, Kind, Channels, MonthlyFeeMinor, Currency, TrialDays,
+        ValidFrom, ValidTo, DiscountRatio, WebhookUrl, Rules?.Select(ToRule).ToList());
+
+    private static PricingRule? ToRule(PricingRuleDto? dto) => dto switch
+    {
+        FlatRuleDto r => new FlatRule(r.AmountMinor),
+        TieredRuleDto r => new TieredRule((r.Tiers ?? []).Select(t => new PriceTier(t.UpTo, t.PriceMinor)).ToList()),
+        UsageRuleDto r => new UsageRule(r.Meter ?? "", r.UnitPriceMinor),
+        _ => null,
+    };
+}
+
+public static class PricePlanEndpoints
+{
+    public static IEndpointRouteBuilder MapPricePlanEndpoints(this IEndpointRouteBuilder app)
+    {
+        var plans = app.MapGroup("/price-plans");
+
+        plans.MapPost("/", async (PricePlanRequest body, CreatePricePlanHandler handler, CancellationToken ct) =>
+            (await handler.HandleAsync(new CreatePricePlanCommand(body.ToDraft()), ct))
+            .ToHttp(id => Results.Created($"/price-plans/{id}", new { id = id.Value })));
+
+        plans.MapPut("/{id:guid}", async (Guid id, PricePlanRequest body, UpdatePricePlanHandler handler, CancellationToken ct) =>
+            (await handler.HandleAsync(new UpdatePricePlanCommand(new PricePlanId(id), body.ToDraft()), ct))
+            .ToHttp(planId => Results.Ok(new { id = planId.Value })));
+
+        return app;
+    }
+}
