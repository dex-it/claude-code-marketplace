--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/UpdatePricePlanHandler.cs
@@ -0,0 +1,22 @@
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record UpdatePricePlanCommand(PricePlanId Id, PricePlanInput Input);
+
+public sealed class UpdatePricePlanHandler(IPricePlanRepository plans, PricePlanInputValidator validator)
+{
+    public async Task<Result<PricePlanId>> HandleAsync(UpdatePricePlanCommand command, CancellationToken ct)
+    {
+        if (validator.Check(command.Input) is { } error)
+            return error;
+
+        var existing = await plans.FindAsync(command.Id, ct);
+        if (existing is null)
+            return new PricePlanNotFoundError(command.Id);
+
+        await plans.SaveAsync(PricePlanMapper.ToPlan(existing.Id, command.Input, existing.CreatedAt), ct);
+        return existing.Id;
+    }
+}
