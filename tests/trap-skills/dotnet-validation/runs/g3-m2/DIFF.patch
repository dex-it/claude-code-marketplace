@@ -0,0 +1,22 @@
+using Billing.Api.Application.Handlers.PricePlans;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Api;
+
+public static class PricePlanEndpoints
+{
+    public static IEndpointRouteBuilder MapPricePlanEndpoints(this IEndpointRouteBuilder app)
+    {
+        var plans = app.MapGroup("/price-plans");
+
+        plans.MapPost("/", async (PricePlanInput body, CreatePricePlanHandler handler, CancellationToken ct) =>
+            (await handler.HandleAsync(new CreatePricePlanCommand(body), ct))
+            .ToHttp(id => Results.Created($"/price-plans/{id}", new { id = id.Value })));
+
+        plans.MapPut("/{id:guid}", async (Guid id, PricePlanInput body, UpdatePricePlanHandler handler, CancellationToken ct) =>
+            (await handler.HandleAsync(new UpdatePricePlanCommand(new PricePlanId(id), body), ct))
+            .ToHttp(_ => Results.NoContent()));
+
+        return app;
+    }
+}
