+namespace Billing.Api.Domain;
+
+public enum PlanKind { Standard, Promo, Internal }
+
+public enum NotificationChannel { Email, Sms, Push }
+
+public sealed record PricePlan
+{
+    public required PricePlanId Id { get; init; }
+    public required string Name { get; init; }
+    public string? Description { get; init; }
+    public required string ExternalCode { get; init; }
+    public required TeamId OwnerTeamId { get; init; }
+    public required PlanKind Kind { get; init; }
+    public required IReadOnlyList<NotificationChannel> Channels { get; init; }
+    public required Money MonthlyFee { get; init; }
+    public required int TrialDays { get; init; }
+    public required DateTimeOffset ValidFrom { get; init; }
+    public DateTimeOffset? ValidTo { get; init; }
+    public decimal? DiscountRatio { get; init; }
+    public required Uri WebhookUrl { get; init; }
+    public required IReadOnlyList<PricingRule> Rules { get; init; }
+}
