+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+internal static class PricePlanMapping
+{
+    // Вызывается только после успешной валидации входа.
+    public static PricePlan ToPlan(this PricePlanInput input, PricePlanId id) => new()
+    {
+        Id = id,
+        Name = input.Name!,
+        Description = input.Description,
+        ExternalCode = input.ExternalCode!,
+        OwnerTeamId = new TeamId(input.OwnerTeamId),
+        Kind = input.Kind!.Value,
+        Channels = input.Channels!.ToList(),
+        MonthlyFee = new Money(input.MonthlyFeeMinor!.Value, input.Currency!),
+        TrialDays = input.TrialDays!.Value,
+        ValidFrom = input.ValidFrom!.Value,
+        ValidTo = input.ValidTo,
+        DiscountRatio = input.DiscountRatio,
+        WebhookUrl = new Uri(input.WebhookUrl!),
+        Rules = input.Rules!.Select(r => r!).ToList(),
+    };
+}
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanValidator.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanValidator.cs
new file mode 100644
index 0000000..ea46502
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanValidator.cs
@@ -0,0 +1,82 @@
+using Billing.Api.Application.Validation;
+using Billing.Api.Domain;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed class PricePlanValidator : BillingValidator<PricePlanInput>
+{
+    private const int MaxChannels = 3;
+    private const int MaxRules = 50;
+
+    public PricePlanValidator()
+    {
+        RuleFor(x => x.Name).NotEmpty().MaximumLength(200);
+        RuleFor(x => x.Description).MaximumLength(2000);
+        RuleFor(x => x.ExternalCode).NotEmpty().MaximumLength(100);
+        RuleFor(x => x.OwnerTeamId).NotEmpty();
+        RuleFor(x => x.Kind).NotNull().IsInEnum();
+        RuleFor(x => x.Channels).NotEmpty()
+            .Must(c => c!.Count <= MaxChannels && c.Distinct().Count() == c.Count)
+            .WithMessage("must not contain duplicates");
+        RuleForEach(x => x.Channels).IsInEnum();
+        RuleFor(x => x.MonthlyFeeMinor).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.Currency).NotEmpty().Length(3);
+        RuleFor(x => x.TrialDays).NotNull().GreaterThanOrEqualTo(0).LessThanOrEqualTo(3650);
+        RuleFor(x => x.ValidFrom).NotNull();
+        RuleFor(x => x.ValidTo).Must((x, validTo) => validTo > x.ValidFrom)
+            .When(x => x.ValidTo is not null && x.ValidFrom is not null)
+            .WithMessage("must be later than validFrom");
+        RuleFor(x => x.DiscountRatio).InclusiveBetween(0m, 1m);
+        RuleFor(x => x.WebhookUrl).NotEmpty().MaximumLength(2000)
+            .Must(u => Uri.TryCreate(u, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps)
+            .WithMessage("must be an absolute https URL");
+        RuleFor(x => x.Rules).NotNull().Must(r => r!.Count <= MaxRules)
+            .WithMessage($"must contain at most {MaxRules} rules");
+        RuleForEach(x => x.Rules).NotNull().SetInheritanceValidator(v =>
+        {
+            v.Add<FlatRule>(new FlatRuleValidator());
+            v.Add<TieredRule>(new TieredRuleValidator());
+            v.Add<UsageRule>(new UsageRuleValidator());
+        });
+    }
+
+    private sealed class FlatRuleValidator : AbstractValidator<FlatRule>
+    {
+        public FlatRuleValidator() => RuleFor(x => x.AmountMinor).NotNull().GreaterThanOrEqualTo(0);
+    }
+
+    private sealed class TieredRuleValidator : AbstractValidator<TieredRule>
+    {
+        private const int MaxTiers = 50;
+
+        public TieredRuleValidator()
+        {
+            RuleFor(x => x.Tiers).NotEmpty().Must(t => t!.Count <= MaxTiers)
+                .WithMessage($"must contain at most {MaxTiers} tiers");
+            RuleForEach(x => x.Tiers).NotNull().SetValidator(new PriceTierValidator()!);
+            RuleFor(x => x.Tiers)
+                .Must(t => t!.Zip(t!.Skip(1)).All(p => p.First?.UpTo < p.Second?.UpTo))
+                .When(x => x.Tiers is not null)
+                .WithMessage("upTo must be strictly ascending");
+        }
+    }
+
+    private sealed class PriceTierValidator : AbstractValidator<PriceTier>
+    {
+        public PriceTierValidator()
+        {
+            RuleFor(x => x.UpTo).NotNull().GreaterThan(0);
+            RuleFor(x => x.PriceMinor).NotNull().GreaterThanOrEqualTo(0);
+        }
+    }
+
+    private sealed class UsageRuleValidator : AbstractValidator<UsageRule>
+    {
+        public UsageRuleValidator()
+        {
+            RuleFor(x => x.Meter).NotEmpty().MaximumLength(100);
+            RuleFor(x => x.UnitPriceMinor).NotNull().GreaterThanOrEqualTo(0);
+        }
+    }
+}
