@@ -0,0 +1,35 @@
+using System.Text.Json.Serialization;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+// Поля nullable: не присланное поле должно отличаться от нулевого значения и ловиться валидатором.
+public sealed record PricePlanDraft(
+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid? OwnerTeamId,
+    PlanKind? Kind,
+    IReadOnlyList<NotificationChannel>? Channels,
+    long? MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
+    DateTimeOffset? ValidTo,
+    decimal? DiscountRatio,
+    string? WebhookUrl,
+    IReadOnlyList<RuleDraft?>? Rules);
+
+[JsonPolymorphic(TypeDiscriminatorPropertyName = "type")]
+[JsonDerivedType(typeof(FlatRuleDraft), "flat")]
+[JsonDerivedType(typeof(TieredRuleDraft), "tiered")]
+[JsonDerivedType(typeof(UsageRuleDraft), "usage")]
+public abstract record RuleDraft;
+
+public sealed record FlatRuleDraft(long? AmountMinor) : RuleDraft;
+
+public sealed record TierDraft(long? UpTo, long? PriceMinor);
+
+public sealed record TieredRuleDraft(IReadOnlyList<TierDraft?>? Tiers) : RuleDraft;
+
+public sealed record UsageRuleDraft(string? Meter, long? UnitPriceMinor) : RuleDraft;
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
new file mode 100644
index 0000000..32eba5c
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
@@ -0,0 +1,66 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed class PricePlanDraftValidator : BillingValidator<PricePlanDraft>
+{
+    public PricePlanDraftValidator()
+    {
+        RuleFor(x => x.Name).NotEmpty().MaximumLength(ValidationLimits.NameMaxLength);
+        RuleFor(x => x.Description).MaximumLength(ValidationLimits.DescriptionMaxLength);
+        RuleFor(x => x.ExternalCode).NotEmpty().MaximumLength(ValidationLimits.ExternalCodeMaxLength);
+        RuleFor(x => x.OwnerTeamId).NotNull().NotEqual(Guid.Empty);
+        RuleFor(x => x.Kind).NotNull().IsInEnum();
+        RuleFor(x => x.Channels).NotEmpty()
+            .Must(c => c!.Distinct().Count() == c!.Count).WithMessage("must not contain duplicates");
+        RuleForEach(x => x.Channels).IsInEnum();
+        RuleFor(x => x.MonthlyFeeMinor).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.Currency).NotEmpty().Length(ValidationLimits.CurrencyCodeLength);
+        RuleFor(x => x.TrialDays).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.ValidFrom).NotNull();
+        RuleFor(x => x.ValidTo).GreaterThan(x => x.ValidFrom)
+            .When(x => x.ValidTo is not null && x.ValidFrom is not null);
+        RuleFor(x => x.DiscountRatio).InclusiveBetween(0m, 1m).When(x => x.DiscountRatio is not null);
+        RuleFor(x => x.WebhookUrl).NotEmpty().MaximumLength(ValidationLimits.UrlMaxLength)
+            .Must(u => Uri.TryCreate(u, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps)
+            .WithMessage("must be an absolute https URL");
+        RuleFor(x => x.Rules).NotNull().Must(r => r!.Count <= ValidationLimits.MaxRules)
+            .WithMessage($"must contain at most {ValidationLimits.MaxRules} rules");
+        RuleForEach(x => x.Rules).NotNull().SetInheritanceValidator(v =>
+        {
+            v.Add<FlatRuleDraft>(new FlatRuleValidator());
+            v.Add<TieredRuleDraft>(new TieredRuleValidator());
+            v.Add<UsageRuleDraft>(new UsageRuleValidator());
+        });
+    }
+
+    private sealed class FlatRuleValidator : AbstractValidator<FlatRuleDraft>
+    {
+        public FlatRuleValidator() =>
+            RuleFor(x => x.AmountMinor).NotNull().GreaterThanOrEqualTo(0);
+    }
+
+    private sealed class TieredRuleValidator : AbstractValidator<TieredRuleDraft>
+    {
+        public TieredRuleValidator()
+        {
+            RuleFor(x => x.Tiers).NotEmpty().Must(t => t!.Count <= ValidationLimits.MaxTiers)
+                .WithMessage($"must contain at most {ValidationLimits.MaxTiers} tiers");
+            RuleForEach(x => x.Tiers).NotNull().ChildRules(t =>
+            {
+                t.RuleFor(x => x!.UpTo).NotNull().GreaterThan(0);
+                t.RuleFor(x => x!.PriceMinor).NotNull().GreaterThanOrEqualTo(0);
+            });
+        }
+    }
+
+    private sealed class UsageRuleValidator : AbstractValidator<UsageRuleDraft>
+    {
+        public UsageRuleValidator()
+        {
+            RuleFor(x => x.Meter).NotEmpty().MaximumLength(ValidationLimits.MeterMaxLength);
+            RuleFor(x => x.UnitPriceMinor).NotNull().GreaterThanOrEqualTo(0);
+        }
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanMapper.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanMapper.cs
