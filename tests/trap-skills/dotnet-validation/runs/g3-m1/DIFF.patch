@@ -0,0 +1,52 @@
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+internal static class PricePlanMapper
+{
+    // Вызывается только после успешной валидации черновика.
+    public static PricePlan ToPlan(PricePlanDraft d) => new()
+    {
+        Id = PricePlanId.New(),
+        Name = d.Name!,
+        Description = d.Description,
+        ExternalCode = d.ExternalCode!,
+        OwnerTeamId = new TeamId(d.OwnerTeamId!.Value),
+        Kind = d.Kind!.Value,
+        Channels = d.Channels!.ToList(),
+        MonthlyFee = new Money(d.MonthlyFeeMinor!.Value, d.Currency!),
+        TrialDays = d.TrialDays!.Value,
+        ValidFrom = d.ValidFrom!.Value,
+        ValidTo = d.ValidTo,
+        DiscountRatio = d.DiscountRatio,
+        WebhookUrl = d.WebhookUrl!,
+        Rules = d.Rules!.Select(ToRule).ToList(),
+    };
+
+    public static void Apply(PricePlanDraft d, PricePlan plan)
+    {
+        var next = ToPlan(d);
+        plan.Name = next.Name;
+        plan.Description = next.Description;
+        plan.ExternalCode = next.ExternalCode;
+        plan.OwnerTeamId = next.OwnerTeamId;
+        plan.Kind = next.Kind;
+        plan.Channels = next.Channels;
+        plan.MonthlyFee = next.MonthlyFee;
+        plan.TrialDays = next.TrialDays;
+        plan.ValidFrom = next.ValidFrom;
+        plan.ValidTo = next.ValidTo;
+        plan.DiscountRatio = next.DiscountRatio;
+        plan.WebhookUrl = next.WebhookUrl;
+        plan.Rules = next.Rules;
+    }
+
+    private static PricingRule ToRule(RuleDraft? rule) => rule switch
+    {
+        FlatRuleDraft f => new FlatRule(f.AmountMinor!.Value),
+        TieredRuleDraft t => new TieredRule(
+            t.Tiers!.Select(x => new PricingTier(x!.UpTo!.Value, x.PriceMinor!.Value)).ToList()),
+        UsageRuleDraft u => new UsageRule(u.Meter!, u.UnitPriceMinor!.Value),
+        _ => throw new InvalidOperationException($"Unknown rule draft {rule?.GetType().Name}"),
+    };
+}
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/UpdatePricePlanHandler.cs b/src/Billing.Api/Application/Handlers/PricePlans/UpdatePricePlanHandler.cs
