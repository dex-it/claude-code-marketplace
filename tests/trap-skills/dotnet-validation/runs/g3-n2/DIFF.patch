@@ -0,0 +1,18 @@
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record UpdatePricePlanCommand(PricePlanId Id, PricePlanInput Input);
+
+public sealed class UpdatePricePlanHandler(IPricePlanRepository plans)
+{
+    public async Task<Result<PricePlanId>> HandleAsync(UpdatePricePlanCommand command, CancellationToken ct)
+    {
+        if (await plans.FindAsync(command.Id, ct) is null)
+            return new PricePlanNotFoundError(command.Id);
+
+        await plans.SaveAsync(PricePlanMapper.ToPlan(command.Id, command.Input), ct);
+        return command.Id;
+    }
+}
