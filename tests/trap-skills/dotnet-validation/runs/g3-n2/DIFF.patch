+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+internal static class PricePlanMapper
+{
+    // Вход уже прошёл PricePlanInputValidator, обязательные поля не null.
+    public static PricePlan ToPlan(PricePlanId id, PricePlanInput input) => new()
+    {
+        Id = id,
+        Name = input.Name!.Trim(),
+        Description = input.Description,
+        ExternalCode = input.ExternalCode!.Trim(),
+        OwnerTeamId = new TeamId(input.OwnerTeamId!.Value),
+        Kind = input.Kind!.Value,
+        Channels = input.Channels!.ToList(),
+        MonthlyFee = new Money(input.MonthlyFeeMinor!.Value, input.Currency!),
+        TrialDays = input.TrialDays!.Value,
+        ValidFrom = input.ValidFrom!.Value,
+        ValidTo = input.ValidTo,
+        DiscountRatio = input.DiscountRatio,
+        WebhookUrl = new Uri(input.WebhookUrl!),
+        Rules = input.Rules!.Select(r => ToRule(r!)).ToList(),
+    };
+
+    private static PricingRule ToRule(PricingRuleInput rule) => rule switch
+    {
+        FlatRuleInput f => new FlatRule(f.AmountMinor!.Value),
+        TieredRuleInput t => new TieredRule(t.Tiers!.Select(x => new PriceTier(x!.UpTo!.Value, x.PriceMinor!.Value)).ToList()),
+        UsageRuleInput u => new UsageRule(u.Meter!, u.UnitPriceMinor!.Value),
+        _ => throw new ArgumentOutOfRangeException(nameof(rule), rule.GetType().Name, "Unknown pricing rule"),
+    };
+}
