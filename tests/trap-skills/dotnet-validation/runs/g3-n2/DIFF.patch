+using Billing.Api.Application.Validation;
+
+namespace Billing.Api.Api;
+
+public sealed class ValidationFilter<TBody>(BillingValidator<TBody> validator) : IEndpointFilter
+{
+    public ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        var body = context.Arguments.OfType<TBody>().FirstOrDefault();
+        if (body is not null && validator.Check(body) is { } error)
+            return ValueTask.FromResult<object?>(error.ToProblem());
+        return next(context);
+    }
+}
