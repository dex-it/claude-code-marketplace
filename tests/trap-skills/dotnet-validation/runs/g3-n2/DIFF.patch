+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Handlers.PricePlans;
+using Billing.Api.Application.Validation;
+using Billing.Api.Infrastructure.Persistence;
+
+namespace Billing.Api.Modules;
+
+public static class PricePlansModule
+{
+    public static IServiceCollection AddPricePlansModule(this IServiceCollection services)
+    {
+        services.AddScoped<IPricePlanRepository, InMemoryPricePlanRepository>();
+        services.AddScoped<BillingValidator<PricePlanInput>, PricePlanInputValidator>();
+        services.AddScoped<CreatePricePlanHandler>();
+        services.AddScoped<UpdatePricePlanHandler>();
+        return services;
+    }
+}
