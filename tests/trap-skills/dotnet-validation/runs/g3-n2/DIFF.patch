@@ -0,0 +1,34 @@
+using System.Text.Json.Serialization;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record PricePlanInput(
+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid? OwnerTeamId,
+    PlanKind? Kind,
+    List<NotificationChannel>? Channels,
+    long? MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
+    DateTimeOffset? ValidTo,
+    decimal? DiscountRatio,
+    string? WebhookUrl,
+    List<PricingRuleInput?>? Rules);
+
+[JsonPolymorphic(TypeDiscriminatorPropertyName = "type")]
+[JsonDerivedType(typeof(FlatRuleInput), "flat")]
+[JsonDerivedType(typeof(TieredRuleInput), "tiered")]
+[JsonDerivedType(typeof(UsageRuleInput), "usage")]
+public abstract record PricingRuleInput;
+
+public sealed record FlatRuleInput(long? AmountMinor) : PricingRuleInput;
+
+public sealed record PriceTierInput(long? UpTo, long? PriceMinor);
+
+public sealed record TieredRuleInput(List<PriceTierInput?>? Tiers) : PricingRuleInput;
+
+public sealed record UsageRuleInput(string? Meter, long? UnitPriceMinor) : PricingRuleInput;
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanInputValidator.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanInputValidator.cs
new file mode 100644
index 0000000..3c4bf46
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanInputValidator.cs
@@ -0,0 +1,84 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed class PricePlanInputValidator : BillingValidator<PricePlanInput>
+{
+    public PricePlanInputValidator()
+    {
+        RuleFor(x => x.Name).NotEmpty().MaximumLength(FieldLimits.NameMaxLength);
+        RuleFor(x => x.Description).MaximumLength(FieldLimits.DescriptionMaxLength);
+        RuleFor(x => x.ExternalCode).NotEmpty().MaximumLength(FieldLimits.ExternalCodeMaxLength);
+        RuleFor(x => x.OwnerTeamId).NotNull().NotEqual(Guid.Empty);
+        RuleFor(x => x.Kind).NotNull().IsInEnum();
+
+        RuleFor(x => x.Channels).NotEmpty().Must(c => c!.Distinct().Count() == c!.Count)
+            .WithMessage("channels must not repeat");
+        RuleForEach(x => x.Channels).IsInEnum();
+
+        RuleFor(x => x.MonthlyFeeMinor).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.Currency).NotEmpty().Length(FieldLimits.CurrencyLength).Matches("^[A-Z]+$");
+        RuleFor(x => x.TrialDays).NotNull().InclusiveBetween(0, FieldLimits.MaxTrialDays);
+
+        RuleFor(x => x.ValidFrom).NotNull();
+        RuleFor(x => x.ValidTo).GreaterThan(x => x.ValidFrom)
+            .When(x => x.ValidTo is not null && x.ValidFrom is not null);
+        RuleFor(x => x.DiscountRatio).InclusiveBetween(0m, 1m);
+
+        RuleFor(x => x.WebhookUrl).NotEmpty().MaximumLength(FieldLimits.UrlMaxLength)
+            .Must(BeHttpsUrl).WithMessage("must be an absolute https URL without credentials");
+
+        RuleFor(x => x.Rules).NotNull().Must(r => r!.Count <= FieldLimits.MaxRules)
+            .WithMessage($"must contain at most {FieldLimits.MaxRules} rules");
+        RuleForEach(x => x.Rules).NotNull().SetInheritanceValidator(v =>
+        {
+            v.Add(new FlatRuleValidator());
+            v.Add(new TieredRuleValidator());
+            v.Add(new UsageRuleValidator());
+        });
+    }
+
+    private static bool BeHttpsUrl(string? value) =>
+        Uri.TryCreate(value, UriKind.Absolute, out var uri)
+        && uri.Scheme == Uri.UriSchemeHttps
+        && string.IsNullOrEmpty(uri.UserInfo);
+
+    private sealed class FlatRuleValidator : AbstractValidator<FlatRuleInput>
+    {
+        public FlatRuleValidator() => RuleFor(x => x.AmountMinor).NotNull().GreaterThanOrEqualTo(0);
+    }
+
+    private sealed class TieredRuleValidator : AbstractValidator<TieredRuleInput>
+    {
+        public TieredRuleValidator()
+        {
+            RuleFor(x => x.Tiers).NotEmpty().Must(t => t!.Count <= FieldLimits.MaxTiers)
+                .WithMessage($"must contain at most {FieldLimits.MaxTiers} tiers");
+            RuleForEach(x => x.Tiers).NotNull().SetValidator(new TierValidator()!);
+            RuleFor(x => x.Tiers).Must(BeAscending).WithMessage("upTo must strictly increase")
+                .When(x => x.Tiers is { Count: <= FieldLimits.MaxTiers } && x.Tiers.All(t => t?.UpTo is not null));
+        }
+
+        private static bool BeAscending(List<PriceTierInput?>? tiers) =>
+            tiers!.Zip(tiers!.Skip(1)).All(p => p.First!.UpTo < p.Second!.UpTo);
+    }
+
+    private sealed class TierValidator : AbstractValidator<PriceTierInput>
+    {
+        public TierValidator()
+        {
+            RuleFor(x => x.UpTo).NotNull().GreaterThan(0);
+            RuleFor(x => x.PriceMinor).NotNull().GreaterThanOrEqualTo(0);
+        }
+    }
+
+    private sealed class UsageRuleValidator : AbstractValidator<UsageRuleInput>
+    {
+        public UsageRuleValidator()
+        {
+            RuleFor(x => x.Meter).NotEmpty().MaximumLength(FieldLimits.MeterMaxLength);
+            RuleFor(x => x.UnitPriceMinor).NotNull().GreaterThanOrEqualTo(0);
+        }
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanMapper.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanMapper.cs
