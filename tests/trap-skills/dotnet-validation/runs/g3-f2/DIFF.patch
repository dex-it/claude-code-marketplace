@@ -0,0 +1,51 @@
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+// Вызывается только после успешной валидации черновика.
+internal static class PricePlanMapper
+{
+    public static PricePlan Create(PricePlanId id, DateTimeOffset createdAt, PricePlanDraft d) => new()
+    {
+        Id = id,
+        CreatedAt = createdAt,
+        Name = d.Name!,
+        Description = d.Description,
+        ExternalCode = d.ExternalCode!,
+        OwnerTeamId = d.OwnerTeamId,
+        Kind = d.Kind!.Value,
+        Channels = d.Channels!.ToList(),
+        MonthlyFee = new Money(d.MonthlyFeeMinor, d.Currency!),
+        TrialDays = d.TrialDays!.Value,
+        ValidFrom = d.ValidFrom!.Value,
+        ValidTo = d.ValidTo,
+        DiscountRatio = d.DiscountRatio,
+        WebhookUrl = d.WebhookUrl is null ? null : new Uri(d.WebhookUrl),
+        Rules = d.Rules!.Select(ToRule).ToList(),
+    };
+
+    public static void Apply(PricePlan plan, PricePlanDraft d)
+    {
+        plan.Name = d.Name!;
+        plan.Description = d.Description;
+        plan.ExternalCode = d.ExternalCode!;
+        plan.OwnerTeamId = d.OwnerTeamId;
+        plan.Kind = d.Kind!.Value;
+        plan.Channels = d.Channels!.ToList();
+        plan.MonthlyFee = new Money(d.MonthlyFeeMinor, d.Currency!);
+        plan.TrialDays = d.TrialDays!.Value;
+        plan.ValidFrom = d.ValidFrom!.Value;
+        plan.ValidTo = d.ValidTo;
+        plan.DiscountRatio = d.DiscountRatio;
+        plan.WebhookUrl = d.WebhookUrl is null ? null : new Uri(d.WebhookUrl);
+        plan.Rules = d.Rules!.Select(ToRule).ToList();
+    }
+
+    private static PricingRule ToRule(PricingRuleInput? input) => input switch
+    {
+        FlatRuleInput f => new FlatRule(f.AmountMinor),
+        TieredRuleInput t => new TieredRule(t.Tiers!.Select(x => new Tier(x!.UpTo, x.PriceMinor)).ToList()),
+        UsageRuleInput u => new UsageRule(u.Meter!, u.UnitPriceMinor),
+        _ => throw new InvalidOperationException($"Unknown rule input {input?.GetType().Name}"),
+    };
+}
