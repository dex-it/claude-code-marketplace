+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed record CreatePricePlanCommand(PricePlanDraft Draft);
+
+public sealed class CreatePricePlanHandler(
+    IPricePlanRepository plans,
+    PricePlanDraftValidator validator,
+    TimeProvider clock)
+{
+    public async Task<Result<PricePlanId>> HandleAsync(CreatePricePlanCommand command, CancellationToken ct)
+    {
+        if (validator.Check(command.Draft) is { } error)
+            return error;
+
+        var plan = PricePlanMapper.Create(PricePlanId.New(), clock.GetUtcNow(), command.Draft);
+        await plans.AddAsync(plan, ct);
+        return plan.Id;
+    }
+}
