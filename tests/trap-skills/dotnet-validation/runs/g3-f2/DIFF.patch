diff --git a/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
new file mode 100644
index 0000000..4026edd
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/PricePlans/PricePlanDraftValidator.cs
@@ -0,0 +1,79 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.PricePlans;
+
+public sealed class PricePlanDraftValidator : BillingValidator<PricePlanDraft>
+{
+    private const int MaxChannels = 3;
+    private const int MaxRules = 50;
+
+    public PricePlanDraftValidator()
+    {
+        RuleFor(x => x.Name).NotEmpty().MaximumLength(200);
+        RuleFor(x => x.Description).MaximumLength(2000);
+        RuleFor(x => x.ExternalCode).NotEmpty().MaximumLength(100);
+        RuleFor(x => x.OwnerTeamId).NotEmpty();
+        RuleFor(x => x.Kind).NotNull().IsInEnum();
+
+        RuleFor(x => x.Channels).NotEmpty()
+            .Must(c => c!.Count <= MaxChannels && c.Distinct().Count() == c.Count)
+            .WithMessage("must contain each channel at most once");
+        RuleForEach(x => x.Channels).IsInEnum();
+
+        RuleFor(x => x.MonthlyFeeMinor).GreaterThanOrEqualTo(0);
+        RuleFor(x => x.Currency).NotEmpty().Length(3);
+        RuleFor(x => x.TrialDays).NotNull().GreaterThanOrEqualTo(0);
+        RuleFor(x => x.ValidFrom).NotNull();
+        RuleFor(x => x.ValidTo).GreaterThan(x => x.ValidFrom)
+            .When(x => x.ValidTo is not null && x.ValidFrom is not null);
+        RuleFor(x => x.DiscountRatio).InclusiveBetween(0m, 1m).When(x => x.DiscountRatio is not null);
+        RuleFor(x => x.WebhookUrl).MaximumLength(2000)
+            .Must(u => Uri.TryCreate(u, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps)
+            .WithMessage("must be an absolute https URL")
+            .When(x => x.WebhookUrl is not null);
+
+        RuleFor(x => x.Rules).NotNull()
+            .Must(r => r!.Count <= MaxRules).WithMessage($"must contain at most {MaxRules} rules");
+        RuleForEach(x => x.Rules).NotNull().SetInheritanceValidator(v =>
+        {
+            v.Add<FlatRuleInput>(new FlatRuleValidator());
+            v.Add<TieredRuleInput>(new TieredRuleValidator());
+            v.Add<UsageRuleInput>(new UsageRuleValidator());
+        });
+    }
+}
+
+public sealed class FlatRuleValidator : AbstractValidator<FlatRuleInput>
+{
+    public FlatRuleValidator() => RuleFor(x => x.AmountMinor).GreaterThanOrEqualTo(0);
+}
+
+public sealed class TieredRuleValidator : AbstractValidator<TieredRuleInput>
+{
+    private const int MaxTiers = 100;
+
+    public TieredRuleValidator()
+    {
+        RuleFor(x => x.Tiers).NotEmpty()
+            .Must(t => t!.Count <= MaxTiers).WithMessage($"must contain at most {MaxTiers} tiers");
+        RuleForEach(x => x.Tiers).NotNull().ChildRules(t =>
+        {
+            t.RuleFor(x => x!.UpTo).GreaterThan(0);
+            t.RuleFor(x => x!.PriceMinor).GreaterThanOrEqualTo(0);
+        });
+        RuleFor(x => x.Tiers)
+            .Must(t => t!.Zip(t!.Skip(1)).All(p => p.First!.UpTo < p.Second!.UpTo))
+            .WithMessage("upTo must be strictly ascending")
+            .When(x => x.Tiers is { Count: > 0 and <= MaxTiers } && x.Tiers.All(t => t is not null));
+    }
+}
+
+public sealed class UsageRuleValidator : AbstractValidator<UsageRuleInput>
+{
+    public UsageRuleValidator()
+    {
+        RuleFor(x => x.Meter).NotEmpty().MaximumLength(100);
+        RuleFor(x => x.UnitPriceMinor).GreaterThanOrEqualTo(0);
+    }
+}
