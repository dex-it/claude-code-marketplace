@@ -0,0 +1,18 @@
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Infrastructure.Persistence;
+
+public sealed class InMemoryPricePlanRepository(InMemoryStore store) : IPricePlanRepository
+{
+    public Task<PricePlan?> FindAsync(PricePlanId id, CancellationToken ct) =>
+        Task.FromResult(store.PricePlans.GetValueOrDefault(id));
+
+    public Task AddAsync(PricePlan plan, CancellationToken ct)
+    {
+        store.PricePlans[plan.Id] = plan;
+        return Task.CompletedTask;
+    }
+
+    public Task SaveAsync(PricePlan plan, CancellationToken ct) => AddAsync(plan, ct);
+}
