+using System.Text.Json.Serialization;
+using Billing.Api.Application.Handlers.PricePlans;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Api;
+
+[JsonPolymorphic(TypeDiscriminatorPropertyName = "type")]
+[JsonDerivedType(typeof(FlatRuleRequest), "flat")]
+[JsonDerivedType(typeof(TieredRuleRequest), "tiered")]
+[JsonDerivedType(typeof(UsageRuleRequest), "usage")]
+public abstract record PricingRuleRequest;
+
+public sealed record FlatRuleRequest(long AmountMinor) : PricingRuleRequest;
+
+public sealed record TierRequest(long UpTo, long PriceMinor);
+
+public sealed record TieredRuleRequest(List<TierRequest?>? Tiers) : PricingRuleRequest;
+
+public sealed record UsageRuleRequest(string? Meter, long UnitPriceMinor) : PricingRuleRequest;
+
+public sealed record PricePlanRequest(
+    string? Name,
+    string? Description,
+    string? ExternalCode,
+    Guid OwnerTeamId,
+    PricePlanKind? Kind,
+    List<NotificationChannel>? Channels,
+    long MonthlyFeeMinor,
+    string? Currency,
+    int? TrialDays,
+    DateTimeOffset? ValidFrom,
+    DateTimeOffset? ValidTo,
+    decimal? DiscountRatio,
+    string? WebhookUrl,
+    List<PricingRuleRequest?>? Rules)
+{
+    public PricePlanDraft ToDraft() => new(
+        Name, Description, ExternalCode, OwnerTeamId, Kind, Channels, MonthlyFeeMinor, Currency, TrialDays,
+        ValidFrom, ValidTo, DiscountRatio, WebhookUrl, Rules?.Select(ToInput).ToList());
+
+    private static PricingRuleInput? ToInput(PricingRuleRequest? rule) => rule switch
+    {
+        null => null,
+        FlatRuleRequest f => new FlatRuleInput(f.AmountMinor),
+        TieredRuleRequest t => new TieredRuleInput(
+            t.Tiers?.Select(x => x is null ? null : new TierInput(x.UpTo, x.PriceMinor)).ToList()),
+        UsageRuleRequest u => new UsageRuleInput(u.Meter, u.UnitPriceMinor),
+        _ => throw new InvalidOperationException($"Unknown rule {rule.GetType().Name}"),
+    };
+}
+
+public static class PricePlanEndpoints
+{
+    public static IEndpointRouteBuilder MapPricePlanEndpoints(this IEndpointRouteBuilder app)
+    {
+        var plans = app.MapGroup("/price-plans");
+
+        plans.MapPost("/", async (PricePlanRequest body, CreatePricePlanHandler handler, CancellationToken ct) =>
+            (await handler.HandleAsync(new CreatePricePlanCommand(body.ToDraft()), ct))
+            .ToHttp(id => Results.Created($"/price-plans/{id}", new { id = id.Value })));
+
+        plans.MapPut("/{id:guid}", async (Guid id, PricePlanRequest body, UpdatePricePlanHandler handler, CancellationToken ct) =>
+            (await handler.HandleAsync(new UpdatePricePlanCommand(new PricePlanId(id), body.ToDraft()), ct))
+            .ToHttp(planId => Results.Ok(new { id = planId.Value })));
+
+        return plans;
+    }
+}
