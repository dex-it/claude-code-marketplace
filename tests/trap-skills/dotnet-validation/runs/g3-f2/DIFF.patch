+namespace Billing.Api.Domain;
+
+public enum PricePlanKind { Standard, Promo, Internal }
+
+public enum NotificationChannel { Email, Sms, Push }
+
+public abstract record PricingRule;
+
+public sealed record FlatRule(long AmountMinor) : PricingRule;
+
+public sealed record Tier(long UpTo, long PriceMinor);
+
+public sealed record TieredRule(IReadOnlyList<Tier> Tiers) : PricingRule;
+
+public sealed record UsageRule(string Meter, long UnitPriceMinor) : PricingRule;
+
+public sealed class PricePlan
+{
+    public required PricePlanId Id { get; init; }
+    public required DateTimeOffset CreatedAt { get; init; }
+    public required string Name { get; set; }
+    public string? Description { get; set; }
+    public required string ExternalCode { get; set; }
+    public required Guid OwnerTeamId { get; set; }
+    public required PricePlanKind Kind { get; set; }
+    public required IReadOnlyList<NotificationChannel> Channels { get; set; }
+    public required Money MonthlyFee { get; set; }
+    public required int TrialDays { get; set; }
+    public required DateTimeOffset ValidFrom { get; set; }
+    public DateTimeOffset? ValidTo { get; set; }
+    public decimal? DiscountRatio { get; set; }
+    public Uri? WebhookUrl { get; set; }
+    public required IReadOnlyList<PricingRule> Rules { get; set; }
+}
