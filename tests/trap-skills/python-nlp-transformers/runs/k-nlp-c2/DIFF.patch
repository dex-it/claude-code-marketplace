@@ -0,0 +1,79 @@
+import ast
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from shelfwatch import sentiment_train as st
+
+
+class FakeTok:
+    eos_token = "<eos>"
+
+    def encode(self, text: str, add_special_tokens: bool = False) -> list[int]:
+        return [ord(c) for c in text]
+
+    def decode(self, ids: list[int]) -> str:
+        return "".join(chr(i) for i in ids)
+
+    def apply_chat_template(self, messages, add_generation_prompt, tokenize):
+        return "".join(f"[{m['role']}]{m['content']}" for m in messages) + "[assistant]"
+
+    def __call__(self, text: str, add_special_tokens: bool = False) -> dict[str, list[int]]:
+        return {"input_ids": self.encode(text)}
+
+
+def test_split_frame_uses_existing_split() -> None:
+    df = pd.DataFrame({"text": list("abcd"), "split": ["train", "train", "val", "train"]})
+    train, val = st.split_frame(df)
+    assert len(train) == 3 and len(val) == 1
+
+
+def test_split_frame_requires_column() -> None:
+    with pytest.raises(ValueError):
+        st.split_frame(pd.DataFrame({"text": ["a"]}))
+
+
+def test_encode_example_masks_prompt() -> None:
+    tok = FakeTok()
+    ex = st.encode_example(tok, "отзыв", "сводка")
+    n_answer = len(tok.encode("сводка" + tok.eos_token))
+    assert len(ex["input_ids"]) == len(ex["labels"]) == len(ex["attention_mask"])
+    assert all(x == -100 for x in ex["labels"][:-n_answer])
+    assert ex["labels"][-n_answer:] == ex["input_ids"][-n_answer:]
+
+
+def test_encode_example_respects_max_len_and_keeps_answer_end() -> None:
+    tok = FakeTok()
+    ex = st.encode_example(tok, "а" * 5000, "ответ", max_len=300)
+    assert len(ex["input_ids"]) <= 300
+    assert tok.decode(ex["input_ids"]).endswith("ответ" + tok.eos_token)
+
+
+def test_truncate_review() -> None:
+    assert st.truncate_review(FakeTok(), "abc", max_tokens=5) == "abc"
+    assert st.truncate_review(FakeTok(), "abcdef", max_tokens=3) == "abc"
+
+
+def test_empty_batches_do_not_load_models() -> None:
+    assert st.classify([]) == []
+    assert st.summarize([]) == []
+
+
+def test_module_level_imports_do_not_pull_peft() -> None:
+    tree = ast.parse(Path(st.__file__).read_text())
+    top = {
+        (n.module or "").split(".")[0] if isinstance(n, ast.ImportFrom) else a.name.split(".")[0]
+        for n in tree.body if isinstance(n, (ast.Import, ast.ImportFrom))
+        for a in (n.names if isinstance(n, ast.Import) else [None])
+    }
+    assert not top & {"peft", "torch", "transformers", "bitsandbytes"}
+
+
+def test_inference_functions_do_not_use_peft() -> None:
+    tree = ast.parse(Path(st.__file__).read_text())
+    for fn in tree.body:
+        if isinstance(fn, ast.FunctionDef) and fn.name in {
+            "classify", "summarize", "_load_sentiment", "_load_summarizer"
+        }:
+            assert "peft" not in ast.unparse(fn)
