@@ -0,0 +1,56 @@
+import pandas as pd
+import pytest
+
+from shelfwatch import sentiment_train as st
+
+
+class FakeTokenizer:
+    eos_token = "<eos>"
+    pad_token_id = 0
+
+    def apply_chat_template(self, messages, tokenize, add_generation_prompt):
+        assert not tokenize and add_generation_prompt
+        return "|".join(m["content"] for m in messages) + "|assistant:"
+
+    def __call__(self, texts, add_special_tokens=True, **kwargs):
+        return {"input_ids": [[ord(c) for c in t] for t in texts]}
+
+
+def test_split_frame() -> None:
+    df = pd.DataFrame({"text": list("abc"), "split": ["train", "val", "train"]})
+    train, val = st.split_frame(df)
+    assert len(train) == 2 and len(val) == 1
+
+
+def test_split_frame_requires_val() -> None:
+    with pytest.raises(ValueError):
+        st.split_frame(pd.DataFrame({"split": ["train", "train"]}))
+
+
+def test_build_prompt_contains_review() -> None:
+    prompt = st.build_prompt(FakeTokenizer(), "отзыв")
+    assert "отзыв" in prompt and prompt.endswith("assistant:")
+
+
+def test_summary_data_masks_prompt() -> None:
+    tok = FakeTokenizer()
+    data = st._SummaryData(tok, ["ab"], ["x"])
+    row = data[0]
+    prompt_len = len(st.build_prompt(tok, "ab"))
+    assert row["labels"][:prompt_len] == [-100] * prompt_len
+    assert row["labels"][prompt_len:] == row["input_ids"][prompt_len:]
+    assert len(row["input_ids"]) == len(row["labels"])
+
+
+def test_empty_input_needs_no_model() -> None:
+    assert st.classify([]) == []
+    assert st.summarize([]) == []
+
+
+def test_no_removed_warmup_ratio_and_no_module_level_peft() -> None:
+    import inspect
+
+    src = inspect.getsource(st)
+    assert "warmup_ratio" not in src
+    top = src.split("def ", 1)[0]
+    assert "peft" not in top.replace("`peft`", "")
