+"""Тональность отзывов (BERT) и сводчик отзывов (Qwen + LoRA). SW-261.
+
+`peft` нужен только для обучения сводчика и импортируется внутри `train_summarizer`:
+сервис разметки импортирует модуль, `classify` и `summarize` без `peft`. Для этого
+адаптер после обучения вливается в базовую модель, и `summarize` грузит обычную
+модель из `artifacts/summarizer/`.
+"""
+
+from functools import lru_cache
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import torch
+from transformers import (
+    AutoModelForCausalLM,
+    AutoModelForSequenceClassification,
+    AutoTokenizer,
+    BitsAndBytesConfig,
+    DataCollatorForSeq2Seq,
+    DataCollatorWithPadding,
+    Trainer,
+    TrainingArguments,
+)
+
+from shelfwatch.metrics import macro_f1
+from shelfwatch.paths import DATA_DIR, artifact
+
+BERT_NAME = "DeepPavlov/rubert-base-cased"
+QWEN_NAME = "Qwen/Qwen2.5-7B-Instruct"
+BERT_MAX_LEN = 512  # у BERT 512 позиций, отзывы до 600 токенов обрезаются
+SUMMARY_MAX_LEN = 1024
+CLASSIFY_BATCH = 32
+SUMMARIZE_BATCH = 4
+IGNORE_INDEX = -100
+SYSTEM_PROMPT = "Кратко перескажи отзыв о магазине одним-двумя предложениями."
+
+
+def sentiment_dir() -> Path:
+    return artifact("sentiment")
+
+
+def summarizer_dir() -> Path:
+    return artifact("summarizer")
+
+
+class EncodedDataset(torch.utils.data.Dataset):
+    """Список уже токенизированных примеров без паддинга; паддинг делает collator."""
+
+    def __init__(self, features: list[dict[str, Any]]) -> None:
+        self.features = features
+
+    def __len__(self) -> int:
+        return len(self.features)
+
+    def __getitem__(self, index: int) -> dict[str, Any]:
+        return self.features[index]
+
+
+def encode_reviews(tokenizer: Any, texts: list[str], labels: list[int]) -> EncodedDataset:
+    # токенизация одним вызовом на всю пачку, без паддинга (динамический паддинг в collator)
+    enc = tokenizer(texts, truncation=True, max_length=BERT_MAX_LEN)
+    features = [
+        {"input_ids": enc["input_ids"][i], "attention_mask": enc["attention_mask"][i], "labels": labels[i]}
+        for i in range(len(texts))
+    ]
+    return EncodedDataset(features)
+
+
+def sentiment_training_args(output_dir: Path) -> TrainingArguments:
+    return TrainingArguments(
+        output_dir=str(output_dir),
+        num_train_epochs=3,
+        per_device_train_batch_size=16,
+        per_device_eval_batch_size=32,
+        learning_rate=2e-5,
+        weight_decay=0.01,
+        warmup_steps=0.1,  # доля от всех шагов; в transformers 5 поля warmup_ratio нет
+        eval_strategy="epoch",
+        save_strategy="epoch",
+        save_total_limit=1,
+        load_best_model_at_end=True,
+        metric_for_best_model="macro_f1",
+        report_to="none",
+        seed=42,
+    )
+
+
+def compute_metrics(eval_pred: Any) -> dict[str, float]:
+    logits, labels = eval_pred
+    preds = np.argmax(logits, axis=-1)
+    return {"macro_f1": macro_f1(labels.tolist(), preds.tolist())}
+
+
+def train_sentiment() -> Path:
+    df = pd.read_parquet(DATA_DIR / "reviews.parquet")
+    train_df = df[df["split"] == "train"]
+    val_df = df[df["split"] != "train"]
+
+    tokenizer = AutoTokenizer.from_pretrained(BERT_NAME)
+    model = AutoModelForSequenceClassification.from_pretrained(BERT_NAME, num_labels=3)
+    out = sentiment_dir()
+
+    trainer = Trainer(
+        model=model,
+        args=sentiment_training_args(out / "checkpoints"),
+        train_dataset=encode_reviews(tokenizer, train_df["text"].tolist(), train_df["label"].tolist()),
+        eval_dataset=encode_reviews(tokenizer, val_df["text"].tolist(), val_df["label"].tolist()),
+        data_collator=DataCollatorWithPadding(tokenizer),
+        compute_metrics=compute_metrics,
+    )
+    trainer.train()
+    trainer.save_model(str(out))
+    tokenizer.save_pretrained(str(out))
+    return out
+
+
+@lru_cache(maxsize=1)
+def _load_classifier() -> tuple[Any, Any]:
+    path = str(sentiment_dir())
+    tokenizer = AutoTokenizer.from_pretrained(path, local_files_only=True)
+    model = AutoModelForSequenceClassification.from_pretrained(path, local_files_only=True)
+    model.eval()
+    # CPU и бюджет задержки: веса nn.Linear в int8
+    model = torch.quantization.quantize_dynamic(model, {torch.nn.Linear}, dtype=torch.qint8)
+    return tokenizer, model
+
+
+def classify(texts: list[str]) -> list[int]:
+    if not texts:
+        return []
+    tokenizer, model = _load_classifier()
+    preds: list[int] = []
+    for start in range(0, len(texts), CLASSIFY_BATCH):
+        batch = tokenizer(
+            texts[start : start + CLASSIFY_BATCH],
+            truncation=True,
+            max_length=BERT_MAX_LEN,
+            padding=True,
+            return_tensors="pt",
+        )
+        with torch.inference_mode():
+            logits = model(**batch).logits
+        preds.extend(logits.argmax(dim=-1).tolist())
+    return preds
+
+
+def summary_prompt(tokenizer: Any, review: str) -> str:
+    messages = [
+        {"role": "system", "content": SYSTEM_PROMPT},
+        {"role": "user", "content": review},
+    ]
+    return tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
+
+
+def encode_summaries(tokenizer: Any, reviews: list[str], summaries: list[str]) -> EncodedDataset:
+    prompts = [summary_prompt(tokenizer, r) for r in reviews]
+    fulls = [p + s + tokenizer.eos_token for p, s in zip(prompts, summaries)]
+    prompt_ids = tokenizer(prompts, add_special_tokens=False)["input_ids"]
+    full_ids = tokenizer(fulls, truncation=True, max_length=SUMMARY_MAX_LEN, add_special_tokens=False)["input_ids"]
+    features = []
+    for p_ids, ids in zip(prompt_ids, full_ids):
+        # лосс считается только по токенам сводки
+        labels = [IGNORE_INDEX] * len(p_ids) + ids[len(p_ids) :]
+        features.append({"input_ids": ids, "attention_mask": [1] * len(ids), "labels": labels[: len(ids)]})
+    return EncodedDataset(features)
+
+
+def summarizer_training_args(output_dir: Path) -> TrainingArguments:
+    return TrainingArguments(
+        output_dir=str(output_dir),
+        num_train_epochs=2,
+        per_device_train_batch_size=1,
+        gradient_accumulation_steps=16,
+        learning_rate=2e-4,
+        warmup_steps=0.05,  # доля от всех шагов
+        lr_scheduler_type="cosine",
+        bf16=True,
+        gradient_checkpointing=True,
+        logging_steps=20,
+        save_strategy="epoch",
+        save_total_limit=1,
+        report_to="none",
+        seed=42,
+    )
+
+
+def train_summarizer() -> Path:
+    from peft import LoraConfig, PeftModel, get_peft_model, prepare_model_for_kbit_training
+
+    df = pd.read_parquet(DATA_DIR / "summaries.parquet")
+    tokenizer = AutoTokenizer.from_pretrained(QWEN_NAME)
+
+    # 7B в bf16 не помещается в 24 ГБ: база в 4 бита (QLoRA), обучается только адаптер
+    quant = BitsAndBytesConfig(
+        load_in_4bit=True,
+        bnb_4bit_quant_type="nf4",
+        bnb_4bit_compute_dtype=torch.bfloat16,
+        bnb_4bit_use_double_quant=True,
+    )
+    base = AutoModelForCausalLM.from_pretrained(QWEN_NAME, quantization_config=quant, device_map={"": 0})
+    base = prepare_model_for_kbit_training(base, use_gradient_checkpointing=True)
+    lora = LoraConfig(
+        r=16,
+        lora_alpha=32,
+        lora_dropout=0.05,
+        target_modules=["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
+        task_type="CAUSAL_LM",
+    )
+    model = get_peft_model(base, lora)
+
+    out = summarizer_dir()
+    adapter_dir = out.with_name(out.name + "_adapter")
+    trainer = Trainer(
+        model=model,
+        args=summarizer_training_args(adapter_dir / "checkpoints"),
+        train_dataset=encode_summaries(tokenizer, df["review"].tolist(), df["summary"].tolist()),
+        data_collator=DataCollatorForSeq2Seq(tokenizer, padding=True, label_pad_token_id=IGNORE_INDEX),
+    )
+    trainer.train()
+    model.save_pretrained(str(adapter_dir))
+
+    # вливаем адаптер в базу в bf16 (на CPU), чтобы сервису не нужен был peft
+    del trainer, model, base
+    torch.cuda.empty_cache()
+    full = AutoModelForCausalLM.from_pretrained(QWEN_NAME, dtype=torch.bfloat16)
+    merged = PeftModel.from_pretrained(full, str(adapter_dir)).merge_and_unload()
+    merged.save_pretrained(str(out))
+    tokenizer.save_pretrained(str(out))
+    return out
+
+
+@lru_cache(maxsize=1)
+def _load_summarizer() -> tuple[Any, Any]:
+    path = str(summarizer_dir())
+    tokenizer = AutoTokenizer.from_pretrained(path, local_files_only=True, padding_side="left")
+    model = AutoModelForCausalLM.from_pretrained(path, local_files_only=True, dtype=torch.bfloat16)
+    if torch.cuda.is_available():
+        model = model.to("cuda")
+    model.eval()
+    return tokenizer, model
+
+
+def summarize(reviews: list[str]) -> list[str]:
+    if not reviews:
+        return []
+    tokenizer, model = _load_summarizer()
+    summaries: list[str] = []
+    for start in range(0, len(reviews), SUMMARIZE_BATCH):
+        prompts = [summary_prompt(tokenizer, r) for r in reviews[start : start + SUMMARIZE_BATCH]]
+        batch = tokenizer(prompts, return_tensors="pt", padding=True, add_special_tokens=False).to(model.device)
+        with torch.inference_mode():
+            generated = model.generate(
+                **batch,
+                do_sample=False,
+                max_new_tokens=128,
+                repetition_penalty=1.1,
+                no_repeat_ngram_size=4,
+                pad_token_id=tokenizer.pad_token_id,
+            )
+        new_tokens = generated[:, batch["input_ids"].shape[1] :]
+        summaries.extend(s.strip() for s in tokenizer.batch_decode(new_tokens, skip_special_tokens=True))
+    return summaries
+
+
+if __name__ == "__main__":
+    train_sentiment()
+    train_summarizer()
diff --git a/tests/test_sentiment_train.py b/tests/test_sentiment_train.py
new file mode 100644
index 0000000..c7393fe
--- /dev/null
+++ b/tests/test_sentiment_train.py
@@ -0,0 +1,51 @@
+import sys
+from pathlib import Path
+
+from shelfwatch import sentiment_train as st
+
+
+class FakeTokenizer:
+    eos_token = "<eos>"
+
+    def apply_chat_template(self, messages, tokenize, add_generation_prompt):
+        assert not tokenize and add_generation_prompt
+        return "".join(m["content"] + "|" for m in messages)
+
+    def __call__(self, texts, **kwargs):
+        # один токен на символ
+        return {
+            "input_ids": [[ord(c) for c in t] for t in texts],
+            "attention_mask": [[1] * len(t) for t in texts],
+        }
+
+
+def test_service_imports_without_peft() -> None:
+    assert "peft" not in sys.modules
+
+
+def test_warmup_is_fraction_of_steps() -> None:
+    for args in (st.sentiment_training_args(Path("out")), st.summarizer_training_args(Path("out"))):
+        assert 0 <= args.warmup_steps < 1
+
+
+def test_encode_reviews_batches_and_keeps_labels() -> None:
+    ds = st.encode_reviews(FakeTokenizer(), ["ab", "cde"], [2, 0])
+    assert len(ds) == 2
+    assert ds[1]["labels"] == 0
+    assert len(ds[1]["input_ids"]) == 3
+
+
+def test_summary_loss_only_on_summary_tokens() -> None:
+    tok = FakeTokenizer()
+    prompt = st.summary_prompt(tok, "отзыв")
+    ds = st.encode_summaries(tok, ["отзыв"], ["ок"])
+    item = ds[0]
+    n_prompt = len(prompt)
+    assert item["labels"][:n_prompt] == [st.IGNORE_INDEX] * n_prompt
+    assert item["labels"][n_prompt:] == item["input_ids"][n_prompt:]
+    assert len(item["labels"]) == len(item["input_ids"])
+
+
+def test_empty_input() -> None:
+    assert st.classify([]) == []
+    assert st.summarize([]) == []
