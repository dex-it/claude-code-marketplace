+++ b/tests/test_sentiment_train.py
@@ -0,0 +1,47 @@
+import pandas as pd
+import pytest
+import torch
+from torch import nn
+
+from shelfwatch import sentiment_train as st
+
+
+def test_quantize_replaces_all_linear_and_stays_close() -> None:
+    torch.manual_seed(0)
+    model = nn.Sequential(nn.Linear(16, 32), nn.ReLU(), nn.Sequential(nn.Linear(32, 4)))
+    x = torch.randn(5, 16)
+    expected = model(x)
+    st.quantize_linear_int8(model)
+    assert not any(type(m) is nn.Linear for m in model.modules())
+    assert sum(isinstance(m, st.Int8Linear) for m in model.modules()) == 2
+    assert model[0].weight_q.dtype == torch.int8
+    assert torch.allclose(model(x), expected, atol=0.1)
+
+
+def test_mask_prompt_hides_prompt_tokens() -> None:
+    assert st.mask_prompt([5, 6, 7, 8], 2) == [-100, -100, 7, 8]
+
+
+def test_build_messages_roles() -> None:
+    msgs = st.build_messages("Отличный магазин")
+    assert [m["role"] for m in msgs] == ["system", "user"]
+    assert msgs[1]["content"] == "Отличный магазин"
+
+
+def test_empty_batches_do_not_load_models() -> None:
+    assert st.classify([]) == []
+    assert st.summarize([]) == []
+
+
+def test_load_reviews_requires_columns(tmp_path) -> None:
+    path = tmp_path / "reviews.parquet"
+    pd.DataFrame({"text": ["a"], "label": [0]}).to_parquet(path)
+    with pytest.raises(ValueError, match="split"):
+        st.load_reviews(path)
+
+
+def test_load_summaries_requires_columns(tmp_path) -> None:
+    path = tmp_path / "summaries.parquet"
+    pd.DataFrame({"review": ["a"]}).to_parquet(path)
+    with pytest.raises(ValueError, match="summary"):
+        st.load_summaries(path)
