+++ b/tests/test_sentiment_train.py
@@ -0,0 +1,64 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from shelfwatch import sentiment_train as st
+
+
+class FakeTokenizer:
+    eos_token = "<eos>"
+
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def __call__(self, texts, add_special_tokens=True, **kwargs):
+        assert isinstance(texts, list)
+        self.calls += 1
+        return {"input_ids": [[ord(c) % 50 for c in t] for t in texts]}
+
+    def apply_chat_template(self, messages, tokenize, add_generation_prompt):
+        return "P:" + messages[-1]["content"] + ":"
+
+
+def test_split_reviews() -> None:
+    df = pd.DataFrame({"text": ["a", "b", "c"], "label": [0, 1, 2], "split": ["train", "val", "train"]})
+    train, val = st.split_reviews(df)
+    assert len(train) == 2 and len(val) == 1
+
+
+def test_split_reviews_needs_both_parts() -> None:
+    df = pd.DataFrame({"text": ["a"], "label": [0], "split": ["train"]})
+    with pytest.raises(ValueError):
+        st.split_reviews(df)
+
+
+def test_encode_texts_single_batch_call() -> None:
+    tok = FakeTokenizer()
+    enc = st.encode_texts(tok, ["аб", "в"])
+    assert tok.calls == 1 and len(enc["input_ids"]) == 2
+
+
+def test_warmup_is_steps_not_ratio() -> None:
+    args = st.sentiment_args("/tmp/x")
+    assert args.warmup_steps > 0
+    assert not hasattr(args, "warmup_ratio")
+
+
+def test_encode_pairs_masks_prompt() -> None:
+    tok = FakeTokenizer()
+    enc = st.encode_pairs(tok, ["ab"], ["xyz"])
+    prompt_len = len("P:ab:")
+    labels = enc["labels"][0]
+    assert labels[:prompt_len] == [-100] * prompt_len
+    assert all(x != -100 for x in labels[prompt_len:])
+    assert len(labels) == len(enc["input_ids"][0]) == len(enc["attention_mask"][0])
+
+
+def test_compute_metrics() -> None:
+    logits = np.array([[2.0, 0, 0], [0, 2.0, 0]])
+    assert st.compute_metrics((logits, np.array([0, 1])))["macro_f1"] == 1.0
+
+
+def test_peft_not_imported_at_module_level() -> None:
+    src = open(st.__file__, encoding="utf-8").read().split("def train_summarizer")[0]
+    assert "import peft" not in src and "from peft" not in src
