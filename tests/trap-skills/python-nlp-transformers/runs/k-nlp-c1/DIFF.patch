@@ -0,0 +1,66 @@
+import ast
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from shelfwatch import sentiment_train as st
+
+
+class FakeTok:
+    """Токенизатор-заглушка: токен = символ, шаблон чата с метками ролей."""
+
+    def apply_chat_template(self, messages, tokenize=True, add_generation_prompt=False):
+        text = "".join(f"<{m['role']}>{m['content']}</>" for m in messages)
+        if add_generation_prompt:
+            text += "<assistant>"
+        return [ord(c) for c in text] if tokenize else text
+
+
+def test_split_frame() -> None:
+    df = pd.DataFrame({"text": list("abcd"), "split": ["train", "train", "val", "val"]})
+    train, val = st.split_frame(df)
+    assert len(train) == 2 and len(val) == 2
+
+
+def test_split_frame_requires_both() -> None:
+    with pytest.raises(ValueError):
+        st.split_frame(pd.DataFrame({"split": ["train", "train"]}))
+
+
+def test_length_order() -> None:
+    assert st.length_order(["ccc", "a", "bb"]) == [1, 2, 0]
+
+
+def test_classify_and_summarize_empty() -> None:
+    assert st.classify([]) == []
+    assert st.summarize([]) == []
+
+
+def test_encode_example_masks_prompt() -> None:
+    ex = st.encode_example(FakeTok(), "хороший товар", "кратко")
+    n_prompt = len(FakeTok().apply_chat_template(st.build_messages("хороший товар"), add_generation_prompt=True))
+    assert len(ex["input_ids"]) == len(ex["labels"]) == len(ex["attention_mask"])
+    assert set(ex["labels"][:n_prompt]) == {st.IGNORE_INDEX}
+    assert ex["labels"][n_prompt:] == ex["input_ids"][n_prompt:]
+    assert any(label != st.IGNORE_INDEX for label in ex["labels"])
+
+
+def test_encode_example_truncates() -> None:
+    ex = st.encode_example(FakeTok(), "x" * 500, "y" * 500, max_len=100)
+    assert len(ex["input_ids"]) == len(ex["labels"]) == 100
+
+
+def test_review_is_truncated_in_prompt() -> None:
+    msg = st.build_messages("x" * (st.REVIEW_MAX_CHARS + 500))[1]["content"]
+    assert len(msg) < st.REVIEW_MAX_CHARS + 100
+
+
+def test_service_path_does_not_import_peft_at_module_level() -> None:
+    src = Path(st.__file__).read_text(encoding="utf-8")
+    top_level = [
+        n for n in ast.parse(src).body if isinstance(n, (ast.Import, ast.ImportFrom))
+    ]
+    names = {a.name.split(".")[0] for n in top_level for a in n.names}
+    names |= {n.module.split(".")[0] for n in top_level if isinstance(n, ast.ImportFrom) and n.module}
+    assert not names & {"peft", "bitsandbytes", "torch", "transformers"}
