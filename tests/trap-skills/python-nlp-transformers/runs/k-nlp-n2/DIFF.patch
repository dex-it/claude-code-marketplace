+++ b/tests/test_sentiment_train.py
@@ -0,0 +1,37 @@
+from shelfwatch import sentiment_train as st
+
+
+class FakeTokenizer:
+    eos_token = "<eos>"
+
+    def apply_chat_template(self, messages, tokenize, add_generation_prompt):
+        return "".join(m["content"] + "|" for m in messages) + "A:"
+
+    def __call__(self, texts, truncation=True, max_length=None):
+        # «токен» - символ
+        return {"input_ids": [[ord(c) for c in t] for t in texts]}
+
+
+def test_warmup_steps() -> None:
+    # 100 примеров, батч 10, 3 эпохи -> 30 шагов, 10% = 3
+    assert st.warmup_steps(100, 10, 3) == 3
+    assert st.warmup_steps(1, 8, 1) == 1
+
+
+def test_length_order() -> None:
+    assert st._length_order(["ccc", "a", "bb"]) == [1, 2, 0]
+
+
+def test_encode_pairs_masks_prompt() -> None:
+    tok = FakeTokenizer()
+    (row,) = st.encode_pairs(tok, ["отзыв"], ["итог"])
+    n_prompt = len(st.build_prompt(tok, "отзыв"))
+    assert len(row["input_ids"]) == len(row["labels"])
+    assert row["labels"][:n_prompt] == [-100] * n_prompt
+    assert row["labels"][n_prompt:] == row["input_ids"][n_prompt:]
+    assert row["labels"][n_prompt:] != []
+
+
+def test_empty_batches_do_not_load_models() -> None:
+    assert st.classify([]) == []
+    assert st.summarize([]) == []
