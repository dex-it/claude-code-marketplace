index 0000000..357b149
--- /dev/null
+++ b/src/shelfwatch/sentiment_train.py
@@ -0,0 +1,130 @@
+"""Тональность отзывов: дообучение rubert-base-cased и classify() для сервиса разметки."""
+
+from functools import lru_cache
+from typing import Any
+
+from shelfwatch.metrics import macro_f1
+from shelfwatch.paths import DATA_DIR, ARTIFACTS_DIR
+
+BASE_MODEL = "DeepPavlov/rubert-base-cased"
+NUM_LABELS = 3
+MAX_LENGTH = 512  # предел позиций BERT; отзывы длиннее 600 токенов усекаются
+WARMUP_STEPS = 0.1  # доля шагов обучения (transformers 5: warmup_steps, не warmup_ratio)
+BATCH_SIZE = 32
+
+
+def model_dir():
+    return ARTIFACTS_DIR / "sentiment"
+
+
+class ReviewDataset:
+    """Токенизированные отзывы; padding делает коллатор по пачке."""
+
+    def __init__(self, encodings: dict[str, list[list[int]]], labels: list[int]) -> None:
+        self.encodings = encodings
+        self.labels = labels
+
+    def __len__(self) -> int:
+        return len(self.labels)
+
+    def __getitem__(self, i: int) -> dict[str, Any]:
+        item = {k: v[i] for k, v in self.encodings.items()}
+        item["labels"] = self.labels[i]
+        return item
+
+
+def make_dataset(tokenizer: Any, texts: list[str], labels: list[int]) -> ReviewDataset:
+    # одна токенизация пачкой, а не по тексту в цикле
+    enc = tokenizer(texts, truncation=True, max_length=MAX_LENGTH)
+    return ReviewDataset({k: enc[k] for k in enc.keys()}, labels)
+
+
+def compute_metrics(eval_pred: Any) -> dict[str, float]:
+    logits, labels = eval_pred
+    preds = logits.argmax(axis=-1)
+    return {"macro_f1": macro_f1(list(labels), list(preds))}
+
+
+def train() -> None:
+    import pandas as pd
+    from transformers import (
+        AutoModelForSequenceClassification,
+        AutoTokenizer,
+        DataCollatorWithPadding,
+        Trainer,
+        TrainingArguments,
+    )
+
+    df = pd.read_parquet(DATA_DIR / "reviews.parquet")
+    parts = {s: df[df["split"] == s] for s in ("train", "val")}
+
+    tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)
+    model = AutoModelForSequenceClassification.from_pretrained(BASE_MODEL, num_labels=NUM_LABELS)
+    datasets = {
+        s: make_dataset(tokenizer, p["text"].tolist(), p["label"].astype(int).tolist())
+        for s, p in parts.items()
+    }
+
+    args = TrainingArguments(
+        output_dir=str(ARTIFACTS_DIR / "sentiment_runs"),
+        num_train_epochs=3,
+        per_device_train_batch_size=16,
+        per_device_eval_batch_size=64,
+        learning_rate=2e-5,
+        weight_decay=0.01,
+        warmup_steps=WARMUP_STEPS,
+        eval_strategy="epoch",
+        save_strategy="epoch",
+        save_total_limit=1,
+        load_best_model_at_end=True,
+        metric_for_best_model="macro_f1",
+        report_to="none",
+    )
+    trainer = Trainer(
+        model=model,
+        args=args,
+        train_dataset=datasets["train"],
+        eval_dataset=datasets["val"],
+        data_collator=DataCollatorWithPadding(tokenizer),
+        compute_metrics=compute_metrics,
+    )
+    trainer.train()
+    trainer.save_model(str(model_dir()))
+    tokenizer.save_pretrained(str(model_dir()))
+
+
+@lru_cache(maxsize=1)
+def _load() -> tuple[Any, Any]:
+    import torch
+    from transformers import AutoModelForSequenceClassification, AutoTokenizer
+
+    path = str(model_dir())
+    tokenizer = AutoTokenizer.from_pretrained(path, local_files_only=True)
+    model = AutoModelForSequenceClassification.from_pretrained(path, local_files_only=True).eval()
+    # CPU: веса nn.Linear в int8, ускоряет инференс при том же формате ответа
+    model = torch.quantization.quantize_dynamic(model, {torch.nn.Linear}, dtype=torch.qint8)
+    return tokenizer, model
+
+
+def classify(texts: list[str]) -> list[int]:
+    """Класс тональности (0/1/2) для каждого отзыва, порядок сохраняется."""
+    import torch
+
+    tokenizer, model = _load()
+    out: list[int] = []
+    for i in range(0, len(texts), BATCH_SIZE):
+        batch = tokenizer(
+            texts[i : i + BATCH_SIZE],
+            truncation=True,
+            max_length=MAX_LENGTH,
+            padding=True,
+            return_tensors="pt",
+        )
+        with torch.inference_mode():
+            logits = model(**batch).logits
+        out.extend(logits.argmax(dim=-1).tolist())
+    return out
+
+
+if __name__ == "__main__":
+    train()
diff --git a/src/shelfwatch/summarizer_train.py b/src/shelfwatch/summarizer_train.py
new file mode 100644
index 0000000..e24cb96
--- /dev/null
+++ b/src/shelfwatch/summarizer_train.py
@@ -0,0 +1,178 @@
+"""Сводчик отзывов: QLoRA-дообучение Qwen2.5-7B-Instruct и summarize().
+
+`peft` импортируется только внутри train(); summarize() работает со слитыми весами
+из `artifacts/summarizer/` и peft не требует (его нет в образе сервиса).
+"""
+
+from functools import lru_cache
+from typing import Any
+
+from shelfwatch.paths import ARTIFACTS_DIR, DATA_DIR
+
+BASE_MODEL = "Qwen/Qwen2.5-7B-Instruct"
+SYSTEM_PROMPT = "Кратко перескажи отзыв покупателя одной сводкой."
+MAX_PROMPT_TOKENS = 1024
+MAX_SUMMARY_TOKENS = 128
+IGNORE_INDEX = -100
+BATCH_SIZE = 4
+WARMUP_STEPS = 0.05
+
+
+def summarizer_dir():
+    return ARTIFACTS_DIR / "summarizer"
+
+
+def messages(review: str) -> list[dict[str, str]]:
+    return [
+        {"role": "system", "content": SYSTEM_PROMPT},
+        {"role": "user", "content": review},
+    ]
+
+
+def build_example(prompt_ids: list[int], summary_ids: list[int]) -> dict[str, list[int]]:
+    """Лосс считается только по токенам сводки, промпт маскируется."""
+    prompt_ids = prompt_ids[:MAX_PROMPT_TOKENS]
+    input_ids = prompt_ids + summary_ids
+    return {
+        "input_ids": input_ids,
+        "attention_mask": [1] * len(input_ids),
+        "labels": [IGNORE_INDEX] * len(prompt_ids) + summary_ids,
+    }
+
+
+def pad_batch(examples: list[dict[str, list[int]]], pad_id: int) -> dict[str, list[list[int]]]:
+    width = max(len(e["input_ids"]) for e in examples)
+    batch: dict[str, list[list[int]]] = {"input_ids": [], "attention_mask": [], "labels": []}
+    for e in examples:
+        gap = width - len(e["input_ids"])
+        batch["input_ids"].append(e["input_ids"] + [pad_id] * gap)
+        batch["attention_mask"].append(e["attention_mask"] + [0] * gap)
+        batch["labels"].append(e["labels"] + [IGNORE_INDEX] * gap)
+    return batch
+
+
+def train() -> None:
+    import pandas as pd
+    import torch
+    from peft import LoraConfig, PeftModel, get_peft_model, prepare_model_for_kbit_training
+    from transformers import (
+        AutoModelForCausalLM,
+        AutoTokenizer,
+        BitsAndBytesConfig,
+        Trainer,
+        TrainingArguments,
+    )
+
+    # колонки summaries.parquet: review, summary
+    df = pd.read_parquet(DATA_DIR / "summaries.parquet")
+    tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)
+
+    # токенизация пачкой: промпты и сводки целиком по одному вызову
+    prompts = [
+        tokenizer.apply_chat_template(messages(r), add_generation_prompt=True, tokenize=False)
+        for r in df["review"]
+    ]
+    prompt_ids = tokenizer(prompts, add_special_tokens=False)["input_ids"]
+    summaries = [s + tokenizer.eos_token for s in df["summary"]]
+    summary_ids = tokenizer(summaries, add_special_tokens=False)["input_ids"]
+    train_data = [build_example(p, s) for p, s in zip(prompt_ids, summary_ids)]
+
+    # 7B не помещается в 24 ГБ в полной точности: база в 4 бита (NF4), обучается только LoRA
+    quant = BitsAndBytesConfig(
+        load_in_4bit=True,
+        bnb_4bit_quant_type="nf4",
+        bnb_4bit_use_double_quant=True,
+        bnb_4bit_compute_dtype=torch.bfloat16,
+    )
+    model = AutoModelForCausalLM.from_pretrained(
+        BASE_MODEL, quantization_config=quant, device_map={"": 0}
+    )
+    model = prepare_model_for_kbit_training(model)
+    lora = LoraConfig(
+        r=16,
+        lora_alpha=32,
+        lora_dropout=0.05,
+        target_modules=["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
+        task_type="CAUSAL_LM",
+    )
+    model = get_peft_model(model, lora)
+
+    adapter_dir = ARTIFACTS_DIR / "summarizer_adapter"
+    args = TrainingArguments(
+        output_dir=str(ARTIFACTS_DIR / "summarizer_runs"),
+        num_train_epochs=2,
+        per_device_train_batch_size=2,
+        gradient_accumulation_steps=8,
+        learning_rate=2e-4,
+        warmup_steps=WARMUP_STEPS,
+        bf16=True,
+        gradient_checkpointing=True,
+        logging_steps=20,
+        save_strategy="no",
+        remove_unused_columns=False,
+        report_to="none",
+    )
+
+    def collate(examples: list[dict[str, list[int]]]) -> dict[str, Any]:
+        batch = pad_batch(examples, tokenizer.pad_token_id)
+        return {k: torch.tensor(v) for k, v in batch.items()}
+
+    Trainer(model=model, args=args, train_dataset=train_data, data_collator=collate).train()
+    model.save_pretrained(str(adapter_dir))
+    del model
+    torch.cuda.empty_cache()
+
+    # сервис без peft: сливаем адаптер в базу в bf16 и сохраняем обычную модель
+    base = AutoModelForCausalLM.from_pretrained(BASE_MODEL, torch_dtype=torch.bfloat16)
+    merged = PeftModel.from_pretrained(base, str(adapter_dir)).merge_and_unload()
+    merged.save_pretrained(str(summarizer_dir()))
+    tokenizer.save_pretrained(str(summarizer_dir()))
+
+
+@lru_cache(maxsize=1)
+def _load() -> tuple[Any, Any]:
+    import torch
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+
+    path = str(summarizer_dir())
+    tokenizer = AutoTokenizer.from_pretrained(path, local_files_only=True, padding_side="left")
+    model = AutoModelForCausalLM.from_pretrained(
+        path, torch_dtype=torch.bfloat16, device_map="auto", local_files_only=True
+    ).eval()
+    return tokenizer, model
+
+
+def summarize(reviews: list[str]) -> list[str]:
+    """Одна сводка на каждый отзыв, порядок сохраняется."""
+    import torch
+
+    tokenizer, model = _load()
+    out: list[str] = []
+    for i in range(0, len(reviews), BATCH_SIZE):
+        prompts = [
+            tokenizer.apply_chat_template(messages(r), add_generation_prompt=True, tokenize=False)
+            for r in reviews[i : i + BATCH_SIZE]
+        ]
+        batch = tokenizer(
+            prompts,
+            add_special_tokens=False,
+            truncation=True,
+            max_length=MAX_PROMPT_TOKENS,
+            padding=True,
+            return_tensors="pt",
+        ).to(model.device)
+        with torch.inference_mode():
+            gen = model.generate(
+                **batch,
+                max_new_tokens=MAX_SUMMARY_TOKENS,
+                do_sample=False,
+                repetition_penalty=1.1,
+                no_repeat_ngram_size=4,
+            )
+        new_tokens = gen[:, batch["input_ids"].shape[1] :]
+        out.extend(t.strip() for t in tokenizer.batch_decode(new_tokens, skip_special_tokens=True))
+    return out
+
+
+if __name__ == "__main__":
+    train()
diff --git a/tests/test_sentiment_train.py b/tests/test_sentiment_train.py
new file mode 100644
index 0000000..6810247
--- /dev/null
+++ b/tests/test_sentiment_train.py
@@ -0,0 +1,60 @@
+import ast
+from pathlib import Path
+
+from shelfwatch import sentiment_train, summarizer_train
+from shelfwatch.summarizer_train import IGNORE_INDEX, build_example, pad_batch
+
+SRC = Path(sentiment_train.__file__).parent
+
+
+class FakeTokenizer:
+    def __init__(self) -> None:
+        self.calls: list[list[str]] = []
+
+    def __call__(self, texts, **kwargs):
+        assert isinstance(texts, list)  # пачкой, не по одному тексту
+        self.calls.append(texts)
+        return {"input_ids": [[1, 2] for _ in texts], "attention_mask": [[1, 1] for _ in texts]}
+
+
+def test_make_dataset_tokenizes_in_one_call() -> None:
+    tok = FakeTokenizer()
+    ds = sentiment_train.make_dataset(tok, ["а", "б", "в"], [0, 1, 2])
+    assert len(tok.calls) == 1
+    assert len(ds) == 3
+    assert ds[1]["labels"] == 1
+
+
+def test_warmup_is_fraction() -> None:
+    assert 0 <= sentiment_train.WARMUP_STEPS < 1
+    assert 0 <= summarizer_train.WARMUP_STEPS < 1
+
+
+def test_no_warmup_ratio_in_sources() -> None:
+    for name in ("sentiment_train.py", "summarizer_train.py"):
+        assert "warmup_ratio" not in (SRC / name).read_text()
+
+
+def test_build_example_masks_prompt() -> None:
+    ex = build_example([1, 2, 3], [7, 8])
+    assert ex["input_ids"] == [1, 2, 3, 7, 8]
+    assert ex["labels"] == [IGNORE_INDEX] * 3 + [7, 8]
+
+
+def test_pad_batch_aligns_lengths() -> None:
+    a = build_example([1], [2])
+    b = build_example([1, 2], [3, 4])
+    batch = pad_batch([a, b], pad_id=0)
+    assert {len(x) for k in batch for x in batch[k]} == {4}
+    assert batch["attention_mask"][0] == [1, 1, 0, 0]
+    assert batch["labels"][0][-2:] == [IGNORE_INDEX] * 2
+
+
+def test_service_modules_do_not_import_peft_at_top_level() -> None:
+    for name in ("sentiment_train.py", "summarizer_train.py"):
+        tree = ast.parse((SRC / name).read_text())
+        for node in tree.body:
+            if isinstance(node, ast.Import):
+                assert all(a.name.split(".")[0] != "peft" for a in node.names)
+            if isinstance(node, ast.ImportFrom):
+                assert (node.module or "").split(".")[0] != "peft"
