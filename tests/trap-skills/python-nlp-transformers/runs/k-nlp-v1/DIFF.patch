@@ -0,0 +1,43 @@
+import sys
+
+from shelfwatch import sentiment_train
+from shelfwatch.sentiment_train import _batches, build_sft_example
+
+
+class FakeTokenizer:
+    eos_token = "<eos>"
+
+    def apply_chat_template(self, messages, tokenize, add_generation_prompt):
+        return "|".join(m["content"] for m in messages) + ">"
+
+    def __call__(self, text, add_special_tokens=False):
+        return {"input_ids": [ord(c) for c in text]}
+
+
+def test_batches_cover_all_items() -> None:
+    chunks = list(_batches(["a", "b", "c", "d", "e"], 2))
+    assert chunks == [["a", "b"], ["c", "d"], ["e"]]
+
+
+def test_sft_loss_only_on_summary() -> None:
+    ex = build_sft_example(FakeTokenizer(), "отзыв", "сводка")
+    n_answer = len("сводка<eos>")
+    assert len(ex["input_ids"]) == len(ex["labels"]) == len(ex["attention_mask"])
+    assert all(x == -100 for x in ex["labels"][:-n_answer])
+    assert ex["labels"][-n_answer:] == ex["input_ids"][-n_answer:]
+
+
+def test_sft_truncates_prompt_not_summary() -> None:
+    ex = build_sft_example(FakeTokenizer(), "о" * 500, "сводка", max_len=40)
+    assert len(ex["input_ids"]) == 40
+    assert ex["labels"][-len("сводка<eos>") :] == ex["input_ids"][-len("сводка<eos>") :]
+
+
+def test_service_import_does_not_pull_peft() -> None:
+    assert sentiment_train.classify and sentiment_train.summarize
+    assert "peft" not in sys.modules
+
+
+def test_empty_input() -> None:
+    assert sentiment_train.classify([]) == []
+    assert sentiment_train.summarize([]) == []
