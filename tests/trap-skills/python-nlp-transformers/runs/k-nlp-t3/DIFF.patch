+++ b/tests/test_sentiment_train.py
@@ -0,0 +1,53 @@
+import subprocess
+import sys
+
+import pytest
+
+from shelfwatch import sentiment_train as st
+
+
+class FakeTokenizer:
+    eos_token = "<eos>"
+
+    def apply_chat_template(self, messages, tokenize=False, add_generation_prompt=False):
+        text = "".join(f"[{m['role']}]{m['content']}" for m in messages)
+        return text + ("[assistant]" if add_generation_prompt else "")
+
+    def __call__(self, text, add_special_tokens=False):
+        return {"input_ids": [ord(c) for c in text]}
+
+
+def test_build_messages_roles() -> None:
+    roles = [m["role"] for m in st.build_messages("отзыв", "сводка")]
+    assert roles == ["system", "user", "assistant"]
+    assert [m["role"] for m in st.build_messages("отзыв")] == ["system", "user"]
+
+
+def test_encode_pair_masks_prompt() -> None:
+    enc = st.encode_pair(FakeTokenizer(), "отзыв", "ок")
+    n_answer = len("ок<eos>")
+    assert len(enc["input_ids"]) == len(enc["labels"]) == len(enc["attention_mask"])
+    assert all(x == -100 for x in enc["labels"][:-n_answer])
+    assert enc["labels"][-n_answer:] == enc["input_ids"][-n_answer:]
+
+
+def test_encode_pair_truncates_review_not_summary() -> None:
+    enc = st.encode_pair(FakeTokenizer(), "а" * 5000, "ок")
+    assert len(enc["input_ids"]) == st.SUMMARY_MAX_LEN
+    assert enc["labels"][-len("ок<eos>") :] == enc["input_ids"][-len("ок<eos>") :]
+
+
+def test_sentiment_args_use_warmup_steps() -> None:
+    pytest.importorskip("transformers")
+    args = st.sentiment_training_args("out")
+    assert 0 <= args.warmup_steps < 1
+
+
+def test_import_does_not_pull_peft() -> None:
+    code = "import sys, shelfwatch.sentiment_train; sys.exit('peft' in sys.modules)"
+    assert subprocess.run([sys.executable, "-c", code]).returncode == 0
+
+
+def test_empty_input() -> None:
+    assert st.classify([]) == []
+    assert st.summarize([]) == []
