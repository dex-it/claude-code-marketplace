diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 0000000..54661b8
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,151 @@
+stages:
+  - build
+  - test
+  - image
+  - deploy
+
+# Пайплайны: MR (в том числе из форков) и ветки main/develop. Ветка с открытым MR отдельно не запускается.
+workflow:
+  rules:
+    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
+    - if: $CI_COMMIT_BRANCH == "main" || $CI_COMMIT_BRANCH == "develop"
+
+variables:
+  DOTNET_CLI_TELEMETRY_OPTOUT: "1"
+  DOTNET_NOLOGO: "1"
+  NUGET_PACKAGES: $CI_PROJECT_DIR/.nuget/packages
+  # Postgres живёт только внутри джобы тестов; пароль одноразовый, не секрет.
+  POSTGRES_DB: depot
+  POSTGRES_USER: depot
+  POSTGRES_PASSWORD: ci-throwaway-db
+
+default:
+  image: mcr.microsoft.com/dotnet/sdk:8.0.404
+  interruptible: true
+  timeout: 15m
+  cache:
+    key:
+      files:
+        - Directory.Packages.props
+    paths:
+      - .nuget/packages
+
+build:
+  stage: build
+  script:
+    - dotnet restore --locked-mode
+    - dotnet build --no-restore -c Release
+  artifacts:
+    paths:
+      - "**/bin/Release/"
+      - "**/obj/"
+    expire_in: 1 day
+
+test:
+  stage: test
+  needs: [build]
+  services:
+    - name: postgres:16.4
+      alias: postgres
+  variables:
+    ConnectionStrings__Default: "Host=postgres;Database=$POSTGRES_DB;Username=$POSTGRES_USER;Password=$POSTGRES_PASSWORD"
+    Auth__ApiKey: ci-test-api-key
+  script:
+    - dotnet tool restore
+    - dotnet test --no-build -c Release --collect:"XPlat Code Coverage" --results-directory TestResults
+    - dotnet tool run reportgenerator -reports:"TestResults/**/coverage.cobertura.xml" -targetdir:coverage "-reporttypes:TextSummary;Cobertura"
+    # В лог попадает строка "Line coverage: NN.N%", из неё берётся покрытие для MR.
+    - cat coverage/Summary.txt
+  coverage: '/Line coverage: (\d+(?:\.\d+)?)%/'
+  artifacts:
+    when: always
+    paths:
+      - TestResults/
+    reports:
+      junit: TestResults/**/*.xml
+      coverage_report:
+        coverage_format: cobertura
+        path: coverage/Cobertura.xml
+    expire_in: 1 week
+
+# Статический анализ: типы и анализаторы проверяются сборкой (TreatWarningsAsErrors), стиль - dotnet format.
+lint:
+  stage: test
+  needs: []
+  script:
+    - dotnet restore --locked-mode
+    - dotnet build --no-restore -c Release
+    - dotnet format --no-restore --verify-no-changes
+
+# Аудит зависимостей: dotnet list всегда выходит с кодом 0, поэтому валим джобу по тексту отчёта.
+audit:
+  stage: test
+  needs: []
+  script:
+    - dotnet restore --locked-mode
+    - dotnet list package --vulnerable --include-transitive 2>&1 | tee audit.log
+    - '! grep -q "has the following vulnerable packages" audit.log'
+
+image:
+  stage: image
+  needs: [test, lint, audit]
+  image: docker:27.3.1
+  services:
+    - docker:27.3.1-dind
+  variables:
+    DOCKER_HOST: tcp://docker:2376
+    DOCKER_TLS_CERTDIR: /certs
+    DOCKER_TLS_VERIFY: "1"
+    DOCKER_CERT_PATH: /certs/client
+    IMAGE: $CI_REGISTRY_IMAGE:$CI_COMMIT_SHA
+  cache: []
+  rules:
+    - if: $CI_COMMIT_BRANCH == "main"
+  script:
+    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
+    - docker build --pull -t "$IMAGE" .
+    - docker push "$IMAGE"
+
+.deploy:
+  image:
+    name: alpine/k8s:1.31.2
+    entrypoint: [""]
+  tags: [depot-deploy]
+  interruptible: false
+  cache: []
+  variables:
+    IMAGE: $CI_REGISTRY_IMAGE:$CI_COMMIT_SHA
+  script:
+    # Секреты (KUBECONFIG_B64, DB_MIGRATION_PASSWORD) в лог не выводим; печатаем только несекретные параметры.
+    - echo "deploy image=$IMAGE namespace=$NAMESPACE deployment=depot-api container=api commit=$CI_COMMIT_SHORT_SHA"
+    - echo "$KUBECONFIG_B64" | base64 -d > "$CI_PROJECT_DIR/.kubeconfig"
+    - export KUBECONFIG="$CI_PROJECT_DIR/.kubeconfig"
+    - kubectl set image deployment/depot-api api="$IMAGE" -n "$NAMESPACE"
+    - kubectl rollout status deployment/depot-api -n "$NAMESPACE" --timeout=300s
+  after_script:
+    - rm -f "$CI_PROJECT_DIR/.kubeconfig"
+
+deploy-stage:
+  extends: .deploy
+  stage: deploy
+  needs: [image]
+  variables:
+    NAMESPACE: depot-stage
+  environment:
+    name: stage
+  resource_group: stage
+  rules:
+    - if: $CI_COMMIT_BRANCH == "main"
+
+deploy-prod:
+  extends: .deploy
+  stage: deploy
+  needs: [deploy-stage]
+  variables:
+    NAMESPACE: depot
+  environment:
+    name: production
+  resource_group: production
+  rules:
+    - if: $CI_COMMIT_BRANCH == "main"
+      when: manual
