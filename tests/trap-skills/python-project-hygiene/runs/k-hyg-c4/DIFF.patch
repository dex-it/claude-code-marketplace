diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 0000000..070fd8e
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,38 @@
+image: python:3.12-slim
+
+stages:
+  - quality
+
+variables:
+  UV_CACHE_DIR: "$CI_PROJECT_DIR/.uv-cache"
+  UV_PROJECT_ENVIRONMENT: "$CI_PROJECT_DIR/.venv"
+
+default:
+  cache:
+    key: uv-$CI_COMMIT_REF_SLUG
+    paths:
+      - .uv-cache
+  before_script:
+    # только группа dev: тяжёлые зависимости проекта (torch, tensorflow) для проверок не нужны
+    - pip install --quiet uv
+    - uv sync --only-group dev --no-install-project
+
+ruff-check:
+  stage: quality
+  script:
+    - uv run --no-sync ruff check
+
+ruff-format:
+  stage: quality
+  script:
+    - uv run --no-sync ruff format --check
+
+mypy:
+  stage: quality
+  script:
+    - uv run --no-sync mypy
+
+pytest:
+  stage: quality
+  script:
+    - uv run --no-sync pytest
diff --git a/pyproject.toml b/pyproject.toml
index f5a748c..57c1dba 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -37,3 +37,23 @@ build-backend = "setuptools.build_meta"
 
 [tool.setuptools.packages.find]
 where = ["src"]
+
+[tool.ruff]
+line-length = 100
+target-version = "py312"
+src = ["src", "tests"]
+
+[tool.ruff.lint]
+select = ["E", "F", "I", "UP"]
+
+[tool.mypy]
+python_version = "3.12"
+files = ["src", "tests"]
+mypy_path = "src"
+strict = true
+warn_unreachable = true
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+pythonpath = ["src"]
+addopts = "-ra --strict-markers --strict-config --cov=shelfwatch --cov-report=term-missing"
