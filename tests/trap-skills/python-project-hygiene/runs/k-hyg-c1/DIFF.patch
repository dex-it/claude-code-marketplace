diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 0000000..07d41ce
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,37 @@
+stages:
+  - quality
+
+default:
+  image: python:3.12-slim
+  before_script:
+    - pip install --quiet uv
+    # только dev-группа: тяжёлые зависимости (torch, tensorflow) для проверок не нужны
+    - uv sync --only-group dev
+    - export PATH="$CI_PROJECT_DIR/.venv/bin:$PATH"
+  cache:
+    key: uv-$CI_COMMIT_REF_SLUG
+    paths:
+      - .cache/uv
+
+variables:
+  UV_CACHE_DIR: $CI_PROJECT_DIR/.cache/uv
+
+ruff-check:
+  stage: quality
+  script:
+    - ruff check
+
+ruff-format:
+  stage: quality
+  script:
+    - ruff format --check
+
+mypy:
+  stage: quality
+  script:
+    - mypy
+
+pytest:
+  stage: quality
+  script:
+    - pytest
diff --git a/pyproject.toml b/pyproject.toml
index f5a748c..3b1e4bb 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -37,3 +37,23 @@ build-backend = "setuptools.build_meta"
 
 [tool.setuptools.packages.find]
 where = ["src"]
+
+[tool.ruff]
+target-version = "py312"
+line-length = 100
+src = ["src", "tests"]
+
+[tool.ruff.lint]
+select = ["E", "F", "W", "I", "B", "UP"]
+
+[tool.mypy]
+python_version = "3.12"
+files = ["src", "tests"]
+mypy_path = "src"
+explicit_package_bases = true
+strict = true
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+pythonpath = ["src"]
+addopts = "-ra --strict-markers --strict-config"
