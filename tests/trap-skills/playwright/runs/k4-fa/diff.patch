+import { expect, test } from './fixtures';
+
+test('вход под alice открывает список её заказов', async ({ page }) => {
+  await page.goto('/');
+  await page.getByLabel('Email').fill('alice@shopdesk.example');
+  await page.getByLabel('Пароль').fill('alice-demo');
+  await page.getByRole('button', { name: 'Войти' }).click();
+
+  await expect(page.getByRole('heading', { name: 'Мои заказы' })).toBeVisible();
+  await expect(page.getByText('Заказ #1001')).toBeVisible();
+  await expect(page.getByText('Заказ #1002')).toBeVisible();
+  await expect(page.getByText('Заказ #1003')).toBeVisible();
+  await expect(page.getByText('Заказ #1004')).toBeHidden();
+});
+
+test('отмена нового заказа меняет статус и убирает кнопку', async ({ alicePage: page, aliceToken, request }) => {
+  // Свежий заказ: демо-заказы не расходуются, тест повторяем на переиспользуемом сервере.
+  const created = await request.post('/api/orders', {
+    headers: { Authorization: `Bearer ${aliceToken}` },
+    data: { items: [{ productId: 'p-spoon', quantity: 1 }] },
+  });
+  expect(created.ok()).toBeTruthy();
+  const { number } = (await created.json()) as { number: number };
+
+  await page.goto('/');
+  const order = page.getByRole('listitem').filter({ hasText: `Заказ #${number}` });
+  await order.getByRole('button', { name: 'Отменить' }).click();
+
+  await expect(order.getByText('Отменён')).toBeVisible();
+  await expect(order.getByRole('button', { name: 'Отменить' })).toHaveCount(0);
+});
+
+test('ошибка сервера при загрузке заказов показывает сообщение', async ({ alicePage: page }) => {
+  await page.route('**/api/orders', (route) => route.fulfill({ status: 500, json: { error: { code: 'internal', message: 'boom' } } }));
+
+  await page.goto('/');
+
+  await expect(page.getByRole('alert')).toHaveText('Не удалось загрузить заказы');
+});
