+import { test as base, expect, type APIRequestContext, type Page } from '@playwright/test';
+
+const TOKEN_KEY = 'shopdesk.token';
+
+export const alice = { email: 'alice@shopdesk.example', password: 'alice-demo' };
+
+async function login(request: APIRequestContext, user: { email: string; password: string }): Promise<string> {
+  const response = await request.post('/api/login', { data: user });
+  expect(response.ok()).toBeTruthy();
+  const { token } = (await response.json()) as { token: string };
+  return token;
+}
+
+async function putToken(page: Page, token: string): Promise<void> {
+  await page.addInitScript(([key, value]) => localStorage.setItem(key, value), [TOKEN_KEY, token]);
+}
+
+interface Fixtures {
+  /** Страница с уже выполненным входом alice: токен получен через API, форма не нужна. */
+  alicePage: Page;
+  aliceToken: string;
+}
+
+export const test = base.extend<Fixtures>({
+  aliceToken: async ({ request }, use) => {
+    await use(await login(request, alice));
+  },
+  alicePage: async ({ page, aliceToken }, use) => {
+    await putToken(page, aliceToken);
+    await use(page);
+  },
+});
+
+export { expect };
