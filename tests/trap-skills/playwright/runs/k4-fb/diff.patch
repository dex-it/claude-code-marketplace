+import { expect, test as setup } from '@playwright/test';
+
+// Единственный вход через форму: токен сохраняется в storageState и переиспользуется остальными тестами.
+setup('вход под alice', async ({ page }) => {
+  await page.goto('/');
+  await page.getByLabel('Email').fill('alice@shopdesk.example');
+  await page.getByLabel('Пароль').fill('alice-demo');
+  await page.getByRole('button', { name: 'Войти' }).click();
+  await expect(page.getByRole('heading', { name: 'Мои заказы' })).toBeVisible();
+  await page.context().storageState({ path: 'playwright/.auth/alice.json' });
+});
