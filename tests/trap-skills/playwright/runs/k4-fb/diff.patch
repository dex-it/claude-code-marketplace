@@ -0,0 +1,31 @@
+import { expect, test } from '@playwright/test';
+
+// Заказ ищем по номеру, а не по позиции: тесты не зависят от порядка в списке.
+function orderRow(page: import('@playwright/test').Page, number: number) {
+  return page.getByRole('listitem').filter({ hasText: `Заказ #${number}` });
+}
+
+test('alice видит список своих заказов', async ({ page }) => {
+  await page.goto('/');
+  await expect(page.getByRole('heading', { name: 'Мои заказы' })).toBeVisible();
+  await expect(orderRow(page, 1001)).toBeVisible();
+  await expect(orderRow(page, 1002)).toBeVisible();
+  await expect(orderRow(page, 1003)).toContainText('Оплачен');
+  await expect(page.getByText('Заказ #1004')).toHaveCount(0);
+});
+
+test('отмена нового заказа', async ({ page }) => {
+  await page.goto('/');
+  const row = orderRow(page, 1001);
+  await row.getByRole('button', { name: 'Отменить' }).click();
+  await expect(row).toContainText('Отменён');
+  await expect(row.getByRole('button', { name: 'Отменить' })).toHaveCount(0);
+});
+
+test('ошибка сервера при загрузке заказов', async ({ page }) => {
+  await page.route('**/api/orders', (route) =>
+    route.fulfill({ status: 500, contentType: 'application/json', body: JSON.stringify({ error: { code: 'internal', message: 'boom' } }) }),
+  );
+  await page.goto('/');
+  await expect(page.getByRole('alert')).toHaveText('Не удалось загрузить заказы');
+});
