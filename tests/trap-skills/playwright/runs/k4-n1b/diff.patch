+import { test as base } from '@playwright/test';
+
+const TOKEN_KEY = 'shopdesk.token';
+
+export const alice = { email: 'alice@shopdesk.example', password: 'alice-demo' };
+
+interface Fixtures {
+  // Страница с уже выполненным входом под alice: токен получаем через API, а не через форму.
+  alicePage: import('@playwright/test').Page;
+}
+
+export const test = base.extend<Fixtures>({
+  alicePage: async ({ page, request }, use) => {
+    const response = await request.post('/api/login', { data: alice });
+    const { token } = (await response.json()) as { token: string };
+    await page.addInitScript(([key, value]) => localStorage.setItem(key, value), [TOKEN_KEY, token]);
+    await use(page);
+  },
+});
+
+export { expect } from '@playwright/test';
diff --git a/e2e/tests/orders.spec.ts b/e2e/tests/orders.spec.ts
