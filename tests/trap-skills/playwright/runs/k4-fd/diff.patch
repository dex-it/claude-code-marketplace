+import { test as base, expect, type APIRequestContext } from '@playwright/test';
+
+export const alice = { email: 'alice@shopdesk.example', password: 'alice-demo' };
+
+const TOKEN_KEY = 'shopdesk.token';
+
+interface Session {
+  token: string;
+  api: APIRequestContext;
+}
+
+async function apiLogin(request: APIRequestContext, user: typeof alice): Promise<string> {
+  const res = await request.post('/api/login', { data: user });
+  expect(res.ok()).toBeTruthy();
+  return (await res.json()).token;
+}
+
+// Вход без формы: токен получаем через API и кладём в localStorage до загрузки страницы.
+export const test = base.extend<{ aliceSession: Session }>({
+  aliceSession: async ({ page, request }, use) => {
+    const token = await apiLogin(request, alice);
+    await page.addInitScript(([key, value]) => localStorage.setItem(key, value), [TOKEN_KEY, token]);
+    await use({ token, api: request });
+  },
+});
+
+export { expect };
+
+// Новый заказ создаём через API, чтобы тест отмены не зависел от состояния демо-данных и повторных запусков.
+export async function createOrder(session: Session): Promise<{ id: string; number: number }> {
+  const res = await session.api.post('/api/orders', {
+    data: { items: [{ productId: 'p-spoon', quantity: 1 }] },
+    headers: { Authorization: `Bearer ${session.token}` },
+  });
+  expect(res.status()).toBe(201);
+  return res.json();
+}
