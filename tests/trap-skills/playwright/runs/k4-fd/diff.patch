+import { alice, createOrder, expect, test } from './fixtures';
+
+test('alice входит и видит свои заказы', async ({ page }) => {
+  await page.goto('/');
+  await page.getByLabel('Email').fill(alice.email);
+  await page.getByLabel('Пароль').fill(alice.password);
+  await page.getByRole('button', { name: 'Войти' }).click();
+
+  await expect(page.getByRole('heading', { name: 'Мои заказы' })).toBeVisible();
+  await expect(page.getByRole('listitem').filter({ hasText: 'Заказ #1001' })).toContainText('Новый');
+  await expect(page.getByRole('listitem').filter({ hasText: 'Заказ #1002' })).toContainText('Новый');
+  await expect(page.getByRole('listitem').filter({ hasText: 'Заказ #1003' })).toContainText('Оплачен');
+  // заказ bob не показывается
+  await expect(page.getByText('Заказ #1004')).toHaveCount(0);
+});
+
+test('отмена нового заказа', async ({ page, aliceSession }) => {
+  const { number } = await createOrder(aliceSession);
+
+  await page.goto('/');
+  const order = page.getByRole('listitem').filter({ hasText: `Заказ #${number}` });
+  await expect(order).toContainText('Новый');
+  await order.getByRole('button', { name: 'Отменить' }).click();
+
+  await expect(order).toContainText('Отменён');
+  await expect(order.getByRole('button', { name: 'Отменить' })).toHaveCount(0);
+});
+
+test('ошибка сервера при загрузке заказов', async ({ page, aliceSession }) => {
+  void aliceSession;
+  await page.route('**/api/orders', (route) =>
+    route.fulfill({ status: 500, json: { error: { code: 'internal', message: 'Internal error' } } }),
+  );
+
+  await page.goto('/');
+  await expect(page.getByRole('alert')).toHaveText('Не удалось загрузить заказы');
+});
