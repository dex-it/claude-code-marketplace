@@ -0,0 +1,50 @@
+import { alice, expect, loginAs, test } from './fixtures';
+
+test('alice входит и видит список своих заказов', async ({ page }) => {
+  await page.goto('/');
+  await page.getByLabel('Email').fill(alice.email);
+  await page.getByLabel('Пароль').fill(alice.password);
+  await page.getByRole('button', { name: 'Войти' }).click();
+
+  await expect(page.getByRole('heading', { name: 'Мои заказы' })).toBeVisible();
+  await expect(page.getByText('Заказ #1001')).toBeVisible();
+  await expect(page.getByText('Заказ #1002')).toBeVisible();
+  const paid = page.getByRole('listitem').filter({ hasText: 'Заказ #1003' });
+  await expect(paid.getByText('Оплачен')).toBeVisible();
+  // заказ bob не показывается
+  await expect(page.getByText('Заказ #1004')).toHaveCount(0);
+});
+
+test('отмена нового заказа', async ({ page, request, aliceToken }) => {
+  // Свой заказ на каждый прогон: отмена необратима, а стенд может переиспользоваться.
+  const created = await request.post('/api/orders', {
+    headers: { Authorization: `Bearer ${aliceToken}` },
+    data: { items: [{ productId: 'p-spoon', quantity: 1 }] },
+  });
+  expect(created.status()).toBe(201);
+  const { number } = await created.json();
+
+  await loginAs(page, aliceToken);
+  await page.goto('/');
+
+  const order = page.getByRole('listitem').filter({ hasText: `Заказ #${number}` });
+  await expect(order.getByText('Новый')).toBeVisible();
+  await order.getByRole('button', { name: 'Отменить' }).click();
+
+  await expect(order.getByText('Отменён')).toBeVisible();
+  await expect(order.getByRole('button', { name: 'Отменить' })).toHaveCount(0);
+});
+
+test('ошибка сервера при загрузке списка заказов', async ({ page, aliceToken }) => {
+  await page.route('**/api/orders', (route) =>
+    route.fulfill({
+      status: 500,
+      contentType: 'application/json',
+      body: JSON.stringify({ error: { code: 'internal', message: 'boom' } }),
+    }),
+  );
+  await loginAs(page, aliceToken);
+  await page.goto('/');
+
+  await expect(page.getByRole('alert')).toHaveText('Не удалось загрузить заказы');
+});
