+import { expect, test as base, type APIRequestContext, type Page } from '@playwright/test';
+
+// Учётки из api/src/seed.ts (демо-стенд, SEED_DEMO=1).
+export const alice = { email: 'alice@shopdesk.example', password: 'alice-demo' };
+
+const TOKEN_KEY = 'shopdesk.token';
+
+export async function apiLogin(request: APIRequestContext, user = alice): Promise<string> {
+  const res = await request.post('/api/login', { data: user });
+  expect(res.ok()).toBeTruthy();
+  return (await res.json()).token;
+}
+
+// Вход без формы: токен кладётся в localStorage до загрузки приложения.
+export async function loginAs(page: Page, token: string): Promise<void> {
+  await page.addInitScript(([key, value]) => localStorage.setItem(key, value), [TOKEN_KEY, token]);
+}
+
+export const test = base.extend<{ aliceToken: string }>({
+  aliceToken: async ({ request }, use) => {
+    await use(await apiLogin(request));
+  },
+});
+
+export { expect };
