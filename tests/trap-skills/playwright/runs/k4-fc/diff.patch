+import type { APIRequestContext, Page } from '@playwright/test';
+
+const TOKEN_KEY = 'shopdesk.token';
+
+export const alice = { email: 'alice@shopdesk.example', password: 'alice-demo' };
+
+export async function apiLogin(request: APIRequestContext, user: typeof alice): Promise<string> {
+  const res = await request.post('/api/login', { data: user });
+  if (!res.ok()) throw new Error(`login failed: ${res.status()}`);
+  return (await res.json()).token;
+}
+
+// Вход без формы: кладём токен в localStorage до загрузки приложения.
+export async function loginAs(page: Page, user: typeof alice): Promise<string> {
+  const token = await apiLogin(page.request, user);
+  await page.addInitScript(([key, value]) => localStorage.setItem(key, value), [TOKEN_KEY, token]);
+  return token;
+}
+
+// Свежий заказ в статусе «Новый», чтобы отмена не зависела от состояния демо-данных.
+export async function createOrder(page: Page, token: string, productId: string): Promise<number> {
+  const res = await page.request.post('/api/orders', {
+    headers: { Authorization: `Bearer ${token}` },
+    data: { items: [{ productId, quantity: 1 }] },
+  });
+  if (!res.ok()) throw new Error(`create order failed: ${res.status()}`);
+  return (await res.json()).number;
+}
