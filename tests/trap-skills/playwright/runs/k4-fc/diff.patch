+import { expect, test } from '@playwright/test';
+import { alice, createOrder, loginAs } from './helpers';
+
+test('вход под alice и список её заказов', async ({ page }) => {
+  await page.goto('/');
+  await page.getByLabel('Email').fill(alice.email);
+  await page.getByLabel('Пароль').fill(alice.password);
+  await page.getByRole('button', { name: 'Войти' }).click();
+
+  await expect(page.getByRole('heading', { name: 'Мои заказы' })).toBeVisible();
+  for (const number of [1001, 1002, 1003]) {
+    await expect(page.getByText(`Заказ #${number}`)).toBeVisible();
+  }
+  // заказ другого покупателя не показывается
+  await expect(page.getByText('Заказ #1004')).toBeHidden();
+});
+
+test('отмена нового заказа', async ({ page }) => {
+  const token = await loginAs(page, alice);
+  const number = await createOrder(page, token, 'p-spoon');
+
+  await page.goto('/');
+  const order = page.getByRole('listitem').filter({ hasText: `Заказ #${number}` });
+  await expect(order).toContainText('Новый');
+
+  await order.getByRole('button', { name: 'Отменить' }).click();
+
+  await expect(order).toContainText('Отменён');
+  await expect(order.getByRole('button', { name: 'Отменить' })).toHaveCount(0);
+});
+
+test('ошибка сервера при загрузке списка заказов', async ({ page }) => {
+  await loginAs(page, alice);
+  await page.route('**/api/orders', (route) => route.fulfill({ status: 500, json: { error: { code: 'internal', message: 'boom' } } }));
+
+  await page.goto('/');
+
+  await expect(page.getByRole('alert')).toHaveText('Не удалось загрузить заказы');
+});
