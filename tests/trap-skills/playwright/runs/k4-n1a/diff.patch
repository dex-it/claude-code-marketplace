+import { expect, test as base, type APIRequestContext } from '@playwright/test';
+
+const TOKEN_KEY = 'shopdesk.token';
+
+// Учётка из api/src/seed.ts
+const alice = { email: 'alice@shopdesk.example', password: 'alice-demo' };
+
+interface ApiOrder {
+  id: string;
+  number: number;
+}
+
+interface Fixtures {
+  token: string;
+  /** Новый заказ alice, созданный через API: тест не зависит от состояния демо-данных и повторных запусков. */
+  newOrder: ApiOrder;
+}
+
+async function loginApi(request: APIRequestContext): Promise<string> {
+  const res = await request.post('/api/login', { data: alice });
+  expect(res.ok()).toBeTruthy();
+  return (await res.json()).token;
+}
+
+export const test = base.extend<Fixtures>({
+  token: async ({ request }, use) => {
+    await use(await loginApi(request));
+  },
+
+  // Страница открывается уже авторизованной: токен кладём в localStorage, а не входим через UI.
+  page: async ({ page, token }, use) => {
+    await page.addInitScript(([key, value]) => localStorage.setItem(key, value), [TOKEN_KEY, token]);
+    await use(page);
+  },
+
+  newOrder: async ({ request, token }, use) => {
+    const res = await request.post('/api/orders', {
+      headers: { Authorization: `Bearer ${token}` },
+      data: { items: [{ productId: 'p-spoon', quantity: 1 }] },
+    });
+    expect(res.status()).toBe(201);
+    await use(await res.json());
+  },
+});
+
+export { expect };
