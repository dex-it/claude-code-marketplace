--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,71 @@
+import { logger } from '../logger.js';
+import { PaymentUnavailableError, type ChargeRequest, type ChargeResult, type PaymentGateway } from './gateway.js';
+
+const MAX_ATTEMPTS = 3;
+const RETRY_DELAYS_MS = [500, 1500];
+const REQUEST_TIMEOUT_MS = 10_000;
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+interface ChargeResponse {
+  status?: string;
+  transaction_id?: string;
+  decline_reason?: string;
+}
+
+export class HttpPaymentGateway implements PaymentGateway {
+  constructor(
+    private readonly baseUrl: string,
+    private readonly apiKey: string,
+    private readonly retryDelaysMs: number[] = RETRY_DELAYS_MS,
+  ) {}
+
+  // Шлюз идемпотентен по order_id, поэтому сетевые сбои, 409 и 5xx безопасно повторяем тем же запросом.
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt += 1) {
+      try {
+        const result = await this.send(req);
+        if (result) return result;
+      } catch (err) {
+        if (!(err instanceof PaymentUnavailableError)) throw err;
+        logger.warn(`payment gateway failed for order ${req.orderId} (attempt ${attempt} of ${MAX_ATTEMPTS})`);
+      }
+      if (attempt < MAX_ATTEMPTS) await pause(this.retryDelaysMs[attempt - 1] ?? 0);
+    }
+    throw new PaymentUnavailableError(`Charge for order ${req.orderId} failed after ${MAX_ATTEMPTS} attempts`);
+  }
+
+  // undefined - временный отказ шлюза (409), нужно повторить.
+  private async send(req: ChargeRequest): Promise<ChargeResult | undefined> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+    } catch (err) {
+      throw new PaymentUnavailableError('payment gateway is unreachable', { cause: err });
+    }
+    if (res.status === 409) return undefined;
+    if (res.status >= 500) throw new PaymentUnavailableError(`payment gateway responded with ${res.status}`);
+    if (!res.ok) throw new Error(`payment gateway responded with ${res.status}`);
+
+    let body: ChargeResponse;
+    try {
+      body = (await res.json()) as ChargeResponse;
+    } catch (err) {
+      throw new PaymentUnavailableError('payment gateway returned an invalid body', { cause: err });
+    }
+    if (body.status === 'approved' && body.transaction_id) {
+      return { status: 'approved', transactionId: body.transaction_id };
+    }
+    if (body.status === 'declined') {
+      return { status: 'declined', reason: body.decline_reason ?? 'unknown' };
+    }
+    throw new Error('payment gateway returned an unexpected response');
+  }
+}
