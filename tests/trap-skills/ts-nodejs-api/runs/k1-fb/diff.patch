+
+describe('order payment', () => {
+  function withGateway(charge: PaymentGateway['charge']) {
+    const store = new Store();
+    seedDemo(store);
+    const calls: string[] = [];
+    const app = createApp({
+      store,
+      payments: { charge },
+      notifier: { async orderPaid(o) { calls.push(`mail:${o.number}`); } },
+      analytics: { async track(e, p) { calls.push(`${e}:${p.orderNumber}:${p.amountKopecks}`); } },
+    });
+    return { store, app, calls };
+  }
+
+  it('pays a new order', async () => {
+    const c = withGateway(async () => ({ status: 'approved', transactionId: 'tx-1' }));
+    const auth = await login(c.app, 'alice');
+    const res = await request(c.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    expect(res.body).toMatchObject({ status: 'paid', transactionId: 'tx-1' });
+    expect(c.store.getOrder('ord-1001')?.status).toBe('paid');
+    expect(c.calls).toEqual([`mail:1001`, `order_paid:1001:${res.body.totalKopecks}`]);
+  });
+
+  it('answers 402 when the bank declines', async () => {
+    const c = withGateway(async () => ({ status: 'declined', reason: 'insufficient_funds' }));
+    const auth = await login(c.app, 'alice');
+    const res = await request(c.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(402);
+    expect(res.body).toEqual({ error: { code: 'payment_declined', message: 'insufficient_funds' } });
+    expect(c.store.getOrder('ord-1001')?.status).toBe('new');
+    expect(c.calls).toEqual([]);
+  });
+
+  it('hides orders of other customers', async () => {
+    const c = withGateway(async () => ({ status: 'approved', transactionId: 'tx-1' }));
+    const auth = await login(c.app, 'alice');
+    const res = await request(c.app).post('/api/orders/ord-1004/pay').set('Authorization', auth);
+    expect(res.status).toBe(404);
+    expect(c.store.getOrder('ord-1004')?.status).toBe('new');
+  });
+
+  it('refuses to pay an already paid order', async () => {
+    let charges = 0;
+    const c = withGateway(async () => {
+      charges += 1;
+      return { status: 'approved', transactionId: 'tx-1' };
+    });
+    const auth = await login(c.app, 'alice');
+    const res = await request(c.app).post('/api/orders/ord-1003/pay').set('Authorization', auth);
+    expect(res.status).toBe(409);
+    expect(charges).toBe(0);
+  });
+});
