--- /dev/null
+++ b/api/test/payment.test.ts
@@ -0,0 +1,128 @@
+import request from 'supertest';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { Analytics } from '../src/analytics/analytics.js';
+import { createApp } from '../src/app.js';
+import type { Notifier } from '../src/notifications/notifier.js';
+import type { ChargeResult, PaymentGateway } from '../src/payments/gateway.js';
+import { HttpPaymentGateway } from '../src/payments/http-gateway.js';
+import { demoUsers, seedDemo } from '../src/seed.js';
+import { Store } from '../src/store.js';
+
+function setup(result: ChargeResult = { status: 'approved', transactionId: 'tx_1' }) {
+  const store = new Store();
+  seedDemo(store);
+  const payments: PaymentGateway = { charge: vi.fn(async () => result) };
+  const notifier: Notifier = { orderPaid: vi.fn(async () => {}) };
+  const analytics: Analytics = { track: vi.fn(async () => {}) };
+  const app = createApp({ store, payments, notifier, analytics });
+  return { store, app, payments, notifier, analytics };
+}
+
+async function login(app: ReturnType<typeof setup>['app'], who: keyof typeof demoUsers) {
+  const { email, password } = demoUsers[who];
+  const res = await request(app).post('/api/login').send({ email, password }).expect(200);
+  return `Bearer ${res.body.token}`;
+}
+
+describe('POST /api/orders/:id/pay', () => {
+  it('pays a new order, stores transactionId, notifies and tracks', async () => {
+    const ctx = setup();
+    const auth = await login(ctx.app, 'alice');
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ id: 'ord-1001', status: 'paid', transactionId: 'tx_1' });
+    expect(ctx.payments.charge).toHaveBeenCalledWith({ orderId: 'ord-1001', amountKopecks: 129000, currency: 'RUB' });
+    expect(ctx.notifier.orderPaid).toHaveBeenCalledOnce();
+    expect(ctx.analytics.track).toHaveBeenCalledWith('order_paid', { orderNumber: 1001, amountKopecks: 129000 });
+  });
+
+  it('still answers 200 when notifier fails after the charge', async () => {
+    const ctx = setup();
+    vi.mocked(ctx.notifier.orderPaid).mockRejectedValue(new Error('down'));
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    const auth = await login(ctx.app, 'alice');
+    await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe('paid');
+  });
+
+  it('answers 402 on decline and keeps the status', async () => {
+    const ctx = setup({ status: 'declined', reason: 'insufficient_funds' });
+    const auth = await login(ctx.app, 'alice');
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(402);
+    expect(res.body).toEqual({ error: { code: 'payment_declined', message: 'insufficient_funds' } });
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe('new');
+    expect(ctx.notifier.orderPaid).not.toHaveBeenCalled();
+    expect(ctx.analytics.track).not.toHaveBeenCalled();
+  });
+
+  it('answers 404 for foreign and missing orders without charging', async () => {
+    const ctx = setup();
+    const auth = await login(ctx.app, 'alice');
+    await request(ctx.app).post('/api/orders/ord-1004/pay').set('Authorization', auth).expect(404);
+    await request(ctx.app).post('/api/orders/nope/pay').set('Authorization', auth).expect(404);
+    expect(ctx.payments.charge).not.toHaveBeenCalled();
+  });
+
+  it('answers 409 for an already paid order without charging', async () => {
+    const ctx = setup();
+    const auth = await login(ctx.app, 'alice');
+    await request(ctx.app).post('/api/orders/ord-1003/pay').set('Authorization', auth).expect(409);
+    expect(ctx.payments.charge).not.toHaveBeenCalled();
+  });
+
+  it('requires authentication', async () => {
+    const ctx = setup();
+    await request(ctx.app).post('/api/orders/ord-1001/pay').expect(401);
+  });
+});
+
+describe('HttpPaymentGateway', () => {
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+  });
+
+  const req = { orderId: 'ord-1', amountKopecks: 100, currency: 'RUB' } as const;
+  const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+
+  it('sends the charge with api key and maps approved/declined', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_9' }))
+      .mockResolvedValueOnce(json(200, { status: 'declined', decline_reason: 'card_expired' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const gateway = new HttpPaymentGateway('https://pay.example', 'key');
+    expect(await gateway.charge(req)).toEqual({ status: 'approved', transactionId: 'tx_9' });
+    expect(await gateway.charge(req)).toEqual({ status: 'declined', reason: 'card_expired' });
+    const [url, init] = fetchMock.mock.calls[0];
+    expect(String(url)).toBe('https://pay.example/v1/charges');
+    expect(init.headers['X-Api-Key']).toBe('key');
+    expect(JSON.parse(init.body)).toEqual({ order_id: 'ord-1', amount: 100, currency: 'RUB' });
+  });
+
+  it('retries network errors and 5xx with the same order_id', async () => {
+    vi.useFakeTimers();
+    vi.spyOn(console, 'warn').mockImplementation(() => {});
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(json(503, { error: 'x' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const promise = new HttpPaymentGateway('https://pay.example', 'key').charge(req);
+    await vi.runAllTimersAsync();
+    expect(await promise).toEqual({ status: 'approved', transactionId: 'tx_2' });
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('gives up with PaymentUnavailableError after repeated failures', async () => {
+    vi.useFakeTimers();
+    vi.spyOn(console, 'warn').mockImplementation(() => {});
+    vi.stubGlobal('fetch', vi.fn().mockRejectedValue(new TypeError('fetch failed')));
+    const promise = new HttpPaymentGateway('https://pay.example', 'key').charge(req);
+    const assertion = expect(promise).rejects.toThrow('not confirmed');
+    await vi.runAllTimersAsync();
+    await assertion;
+  });
+});
