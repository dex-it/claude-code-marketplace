diff --git a/api/test/http-gateway.test.ts b/api/test/http-gateway.test.ts
new file mode 100644
index 0000000..9ba54b5
--- /dev/null
+++ b/api/test/http-gateway.test.ts
@@ -0,0 +1,48 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpPaymentGateway, PaymentUnavailableError } from '../src/payments/http-gateway.js';
+
+const req = { orderId: 'ord-1', amountKopecks: 1000, currency: 'RUB' as const };
+const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+const gateway = () => new HttpPaymentGateway('https://pay.test', 'key', { retryDelaysMs: [0], maxAttempts: 3 });
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('HttpPaymentGateway', () => {
+  it('sends the contract request and maps approval', async () => {
+    const fetchMock = vi.fn(async () => json(200, { status: 'approved', transaction_id: 'tx_1' }));
+    vi.stubGlobal('fetch', fetchMock);
+    expect(await gateway().charge(req)).toEqual({ status: 'approved', transactionId: 'tx_1' });
+    const [url, init] = fetchMock.mock.calls[0] as unknown as [URL, RequestInit];
+    expect(url.href).toBe('https://pay.test/v1/charges');
+    expect((init.headers as Record<string, string>)['X-Api-Key']).toBe('key');
+    expect(JSON.parse(init.body as string)).toEqual({ order_id: 'ord-1', amount: 1000, currency: 'RUB' });
+  });
+
+  it('maps decline', async () => {
+    vi.stubGlobal('fetch', vi.fn(async () => json(200, { status: 'declined', decline_reason: 'card_expired' })));
+    expect(await gateway().charge(req)).toEqual({ status: 'declined', reason: 'card_expired' });
+  });
+
+  it('retries with the same order_id after network failure, 5xx and 409', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(json(409, { error: 'busy' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    expect(await gateway().charge(req)).toEqual({ status: 'approved', transactionId: 'tx_2' });
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('gives up with PaymentUnavailableError', async () => {
+    vi.stubGlobal('fetch', vi.fn(async () => json(503, { error: 'down' })));
+    await expect(gateway().charge(req)).rejects.toBeInstanceOf(PaymentUnavailableError);
+  });
+
+  it('does not retry on 401', async () => {
+    const fetchMock = vi.fn(async () => json(401, { error: 'bad key' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).rejects.toThrow('401');
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+});
