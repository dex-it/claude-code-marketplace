index 0000000..4862bc1
--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,89 @@
+import { logger } from '../logger.js';
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+export class PaymentUnavailableError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PaymentUnavailableError';
+  }
+}
+
+export interface HttpPaymentGatewayOptions {
+  maxAttempts?: number;
+  retryDelaysMs?: number[];
+  timeoutMs?: number;
+}
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// Шлюз идемпотентен по order_id (сутки), поэтому при неизвестном исходе (сеть, таймаут, 5xx, 409)
+// безопасно повторять запрос с тем же order_id.
+export class HttpPaymentGateway implements PaymentGateway {
+  private readonly maxAttempts: number;
+  private readonly retryDelaysMs: number[];
+  private readonly timeoutMs: number;
+
+  constructor(
+    private readonly baseUrl: string,
+    private readonly apiKey: string,
+    options: HttpPaymentGatewayOptions = {},
+  ) {
+    this.maxAttempts = options.maxAttempts ?? 4;
+    this.retryDelaysMs = options.retryDelaysMs ?? [500, 1000, 2000];
+    this.timeoutMs = options.timeoutMs ?? 10_000;
+  }
+
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    for (let attempt = 1; ; attempt += 1) {
+      try {
+        return await this.send(req);
+      } catch (err) {
+        if (!(err instanceof RetryableError)) throw err;
+        logger.warn(`payment for order ${req.orderId} is not confirmed (attempt ${attempt} of ${this.maxAttempts}): ${err.message}`);
+        if (attempt >= this.maxAttempts) {
+          throw new PaymentUnavailableError(`Payment gateway did not confirm the charge for order ${req.orderId}`, {
+            cause: err,
+          });
+        }
+        await pause(this.retryDelaysMs[attempt - 1] ?? this.retryDelaysMs.at(-1) ?? 0);
+      }
+    }
+  }
+
+  private async send(req: ChargeRequest): Promise<ChargeResult> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(this.timeoutMs),
+      });
+    } catch (err) {
+      throw new RetryableError('gateway is unreachable', { cause: err });
+    }
+    if (res.status === 409 || res.status >= 500) {
+      throw new RetryableError(`gateway responded with ${res.status}`);
+    }
+    if (!res.ok) {
+      throw new Error(`payment gateway responded with ${res.status}`);
+    }
+    let body: { status?: string; transaction_id?: string; decline_reason?: string };
+    try {
+      body = (await res.json()) as typeof body;
+    } catch (err) {
+      throw new RetryableError('gateway response is not valid JSON', { cause: err });
+    }
+    if (body.status === 'approved' && body.transaction_id) {
+      return { status: 'approved', transactionId: body.transaction_id };
+    }
+    if (body.status === 'declined') {
+      return { status: 'declined', reason: body.decline_reason ?? 'unknown' };
+    }
+    throw new Error('payment gateway returned an unexpected response');
+  }
+}
+
+class RetryableError extends Error {}
