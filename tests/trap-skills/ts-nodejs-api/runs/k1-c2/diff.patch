index 0000000..4d5b338
--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,82 @@
+import { logger } from '../logger.js';
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+export class PaymentUnavailableError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PaymentUnavailableError';
+  }
+}
+
+export interface HttpPaymentGatewayOptions {
+  baseUrl: string;
+  apiKey: string;
+  maxAttempts?: number;
+  retryDelaysMs?: number[];
+  timeoutMs?: number;
+}
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+// Сбой, после которого результат списания неизвестен или шлюз просит повторить: сеть, таймаут, 409, 5xx.
+// Повтор с тем же order_id безопасен - шлюз возвращает результат первого списания.
+class RetryableError extends Error {}
+
+export class HttpPaymentGateway implements PaymentGateway {
+  private readonly maxAttempts: number;
+  private readonly retryDelaysMs: number[];
+  private readonly timeoutMs: number;
+
+  constructor(private readonly options: HttpPaymentGatewayOptions) {
+    this.maxAttempts = options.maxAttempts ?? 3;
+    this.retryDelaysMs = options.retryDelaysMs ?? [500, 1500];
+    this.timeoutMs = options.timeoutMs ?? 10_000;
+  }
+
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    let lastError: unknown;
+    for (let attempt = 1; attempt <= this.maxAttempts; attempt += 1) {
+      try {
+        return await this.send(req);
+      } catch (err) {
+        if (!(err instanceof RetryableError)) throw err;
+        lastError = err;
+        logger.warn(`payment gateway failed for order ${req.orderId} (attempt ${attempt} of ${this.maxAttempts}): ${err.message}`);
+        if (attempt < this.maxAttempts) await pause(this.retryDelaysMs[attempt - 1] ?? 0);
+      }
+    }
+    throw new PaymentUnavailableError(`Payment gateway is unavailable for order ${req.orderId}`, { cause: lastError });
+  }
+
+  private async send(req: ChargeRequest): Promise<ChargeResult> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.options.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.options.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(this.timeoutMs),
+      });
+    } catch (err) {
+      throw new RetryableError(err instanceof Error ? err.message : 'network error');
+    }
+    if (res.status === 409 || res.status >= 500) throw new RetryableError(`gateway responded with ${res.status}`);
+    if (!res.ok) throw new Error(`payment gateway responded with ${res.status}`);
+
+    let body: { status?: string; transaction_id?: string; decline_reason?: string };
+    try {
+      body = (await res.json()) as typeof body;
+    } catch {
+      throw new RetryableError('gateway returned an unreadable body');
+    }
+    if (body.status === 'approved' && body.transaction_id) {
+      return { status: 'approved', transactionId: body.transaction_id };
+    }
+    if (body.status === 'declined') {
+      return { status: 'declined', reason: body.decline_reason ?? 'declined' };
+    }
+    throw new Error('payment gateway returned an unexpected response');
+  }
+}
