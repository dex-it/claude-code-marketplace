diff --git a/api/test/payment.test.ts b/api/test/payment.test.ts
new file mode 100644
index 0000000..25a9e22
--- /dev/null
+++ b/api/test/payment.test.ts
@@ -0,0 +1,162 @@
+import request from 'supertest';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { Analytics } from '../src/analytics/analytics.js';
+import { createApp } from '../src/app.js';
+import type { Notifier } from '../src/notifications/notifier.js';
+import type { ChargeResult, PaymentGateway } from '../src/payments/gateway.js';
+import { HttpPaymentGateway, PaymentUnavailableError } from '../src/payments/http-gateway.js';
+import { demoUsers, seedDemo } from '../src/seed.js';
+import { Store } from '../src/store.js';
+
+function setup(charge: PaymentGateway['charge']) {
+  const store = new Store();
+  seedDemo(store);
+  const payments = { charge: vi.fn(charge) };
+  const notifier = { orderPaid: vi.fn(async () => {}) } satisfies Notifier;
+  const analytics = { track: vi.fn(async () => {}) } satisfies Analytics;
+  const app = createApp({ store, payments, notifier, analytics });
+  return { store, app, payments, notifier, analytics };
+}
+
+async function login(app: ReturnType<typeof setup>['app'], who: keyof typeof demoUsers) {
+  const { email, password } = demoUsers[who];
+  const res = await request(app).post('/api/login').send({ email, password }).expect(200);
+  return `Bearer ${res.body.token}`;
+}
+
+const approve = async (): Promise<ChargeResult> => ({ status: 'approved', transactionId: 'tx_1' });
+
+describe('POST /api/orders/:id/pay', () => {
+  it('pays a new order, stores transactionId, notifies and tracks', async () => {
+    const ctx = setup(approve);
+    const auth = await login(ctx.app, 'alice');
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ id: 'ord-1001', status: 'paid', transactionId: 'tx_1' });
+    expect(ctx.store.getOrder('ord-1001')).toMatchObject({ status: 'paid', transactionId: 'tx_1' });
+    expect(ctx.payments.charge).toHaveBeenCalledWith({
+      orderId: 'ord-1001',
+      amountKopecks: res.body.totalKopecks,
+      currency: 'RUB',
+    });
+    expect(ctx.notifier.orderPaid).toHaveBeenCalledTimes(1);
+    expect(ctx.analytics.track).toHaveBeenCalledWith('order_paid', {
+      orderNumber: 1001,
+      amountKopecks: res.body.totalKopecks,
+    });
+  });
+
+  it('answers 402 and keeps the order new when the bank declines', async () => {
+    const ctx = setup(async () => ({ status: 'declined', reason: 'insufficient_funds' }));
+    const auth = await login(ctx.app, 'alice');
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(402);
+    expect(res.body).toEqual({ error: { code: 'payment_declined', message: 'insufficient_funds' } });
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe('new');
+    expect(ctx.notifier.orderPaid).not.toHaveBeenCalled();
+    expect(ctx.analytics.track).not.toHaveBeenCalled();
+  });
+
+  it('answers 404 for a foreign or missing order without charging', async () => {
+    const ctx = setup(approve);
+    const auth = await login(ctx.app, 'alice');
+    expect((await request(ctx.app).post('/api/orders/ord-1004/pay').set('Authorization', auth)).status).toBe(404);
+    expect((await request(ctx.app).post('/api/orders/nope/pay').set('Authorization', auth)).status).toBe(404);
+    expect(ctx.payments.charge).not.toHaveBeenCalled();
+    expect(ctx.store.getOrder('ord-1004')?.status).toBe('new');
+  });
+
+  it('answers 409 for an already paid order without charging again', async () => {
+    const ctx = setup(approve);
+    const auth = await login(ctx.app, 'alice');
+    const res = await request(ctx.app).post('/api/orders/ord-1003/pay').set('Authorization', auth);
+    expect(res.status).toBe(409);
+    await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(409);
+    expect(ctx.payments.charge).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not charge twice for concurrent requests', async () => {
+    let release!: () => void;
+    const gate = new Promise<void>((resolve) => (release = resolve));
+    const ctx = setup(async () => {
+      await gate;
+      return { status: 'approved', transactionId: 'tx_1' };
+    });
+    const auth = await login(ctx.app, 'alice');
+    const first = request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).then((r) => r);
+    await vi.waitFor(() => expect(ctx.payments.charge).toHaveBeenCalledTimes(1));
+    const second = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(second.status).toBe(409);
+    release();
+    expect((await first).status).toBe(200);
+    expect(ctx.payments.charge).toHaveBeenCalledTimes(1);
+  });
+
+  it('answers 502 and keeps the order new when the gateway is unavailable', async () => {
+    const ctx = setup(async () => {
+      throw new PaymentUnavailableError('down');
+    });
+    const auth = await login(ctx.app, 'alice');
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(502);
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe('new');
+  });
+
+  it('still answers 200 when the notifier fails after payment', async () => {
+    const ctx = setup(approve);
+    ctx.notifier.orderPaid.mockRejectedValue(new Error('smtp down'));
+    const auth = await login(ctx.app, 'alice');
+    await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe('paid');
+  });
+});
+
+describe('HttpPaymentGateway', () => {
+  afterEach(() => vi.unstubAllGlobals());
+
+  const req = { orderId: 'ord-1', amountKopecks: 129000, currency: 'RUB' } as const;
+  const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+  const make = () =>
+    new HttpPaymentGateway({ baseUrl: 'https://pay.test', apiKey: 'k', retryDelaysMs: [0, 0] });
+
+  it('sends the charge in the documented format and maps approval', async () => {
+    const fetchMock = vi.fn(async () => json(200, { status: 'approved', transaction_id: 'tx_9' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(make().charge(req)).resolves.toEqual({ status: 'approved', transactionId: 'tx_9' });
+    const [url, init] = fetchMock.mock.calls[0] as unknown as [URL, RequestInit];
+    expect(String(url)).toBe('https://pay.test/v1/charges');
+    expect((init.headers as Record<string, string>)['X-Api-Key']).toBe('k');
+    expect(JSON.parse(init.body as string)).toEqual({ order_id: 'ord-1', amount: 129000, currency: 'RUB' });
+  });
+
+  it('maps a decline to its reason', async () => {
+    vi.stubGlobal('fetch', vi.fn(async () => json(200, { status: 'declined', decline_reason: 'card_expired' })));
+    await expect(make().charge(req)).resolves.toEqual({ status: 'declined', reason: 'card_expired' });
+  });
+
+  it('retries network failures, 409 and 5xx with the same order_id', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(json(409, { error: 'busy' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(make().charge(req)).resolves.toMatchObject({ status: 'approved' });
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('gives up with PaymentUnavailableError after the last attempt', async () => {
+    const fetchMock = vi.fn(async () => json(503, { error: 'x' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(make().charge(req)).rejects.toBeInstanceOf(PaymentUnavailableError);
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('does not retry client errors', async () => {
+    const fetchMock = vi.fn(async () => json(401, { error: 'bad key' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(make().charge(req)).rejects.toThrow('401');
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+});
