diff --git a/api/test/http-gateway.test.ts b/api/test/http-gateway.test.ts
new file mode 100644
index 0000000..f3b0c2a
--- /dev/null
+++ b/api/test/http-gateway.test.ts
@@ -0,0 +1,50 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpPaymentGateway, PaymentUnavailableError } from '../src/payments/http-gateway.js';
+
+const req = { orderId: 'ord-1', amountKopecks: 1000, currency: 'RUB' } as const;
+const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+const gateway = () => new HttpPaymentGateway('https://pay.test', 'key', { retryDelaysMs: [0, 0] });
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('HttpPaymentGateway', () => {
+  it('sends the charge per contract and maps approval', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(json(200, { status: 'approved', transaction_id: 'tx_1' }));
+    vi.stubGlobal('fetch', fetchMock);
+    expect(await gateway().charge(req)).toEqual({ status: 'approved', transactionId: 'tx_1' });
+    const [url, init] = fetchMock.mock.calls[0];
+    expect(String(url)).toBe('https://pay.test/v1/charges');
+    expect(init.headers['X-Api-Key']).toBe('key');
+    expect(JSON.parse(init.body)).toEqual({ order_id: 'ord-1', amount: 1000, currency: 'RUB' });
+  });
+
+  it('maps a decline', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(json(200, { status: 'declined', decline_reason: 'card_expired' })));
+    expect(await gateway().charge(req)).toEqual({ status: 'declined', reason: 'card_expired' });
+  });
+
+  it('retries network failures, 409 and 5xx with the same order_id', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(json(409, { error: 'busy' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    expect(await gateway().charge(req)).toEqual({ status: 'approved', transactionId: 'tx_2' });
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('gives up after three attempts', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(json(503, { error: 'x' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).rejects.toBeInstanceOf(PaymentUnavailableError);
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('does not retry client errors', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(json(401, { error: 'bad key' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).rejects.not.toBeInstanceOf(PaymentUnavailableError);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+});
