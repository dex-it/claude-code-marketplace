diff --git a/api/test/http-gateway.test.ts b/api/test/http-gateway.test.ts
new file mode 100644
index 0000000..56141e0
--- /dev/null
+++ b/api/test/http-gateway.test.ts
@@ -0,0 +1,46 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpPaymentGateway, PaymentUnavailableError } from '../src/payments/http-gateway.js';
+
+const req = { orderId: 'ord-1', amountKopecks: 1000, currency: 'RUB' } as const;
+const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('HttpPaymentGateway', () => {
+  it('maps approved and declined responses and sends the contract body', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_1' }))
+      .mockResolvedValueOnce(json(200, { status: 'declined', decline_reason: 'card_expired' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const gw = new HttpPaymentGateway('http://pay.test', 'key', [0, 0]);
+    expect(await gw.charge(req)).toEqual({ status: 'approved', transactionId: 'tx_1' });
+    expect(await gw.charge(req)).toEqual({ status: 'declined', reason: 'card_expired' });
+    const [url, init] = fetchMock.mock.calls[0];
+    expect(String(url)).toBe('http://pay.test/v1/charges');
+    expect(init.headers['X-Api-Key']).toBe('key');
+    expect(JSON.parse(init.body)).toEqual({ order_id: 'ord-1', amount: 1000, currency: 'RUB' });
+  });
+
+  it('retries the same request after network failure, 409 and 5xx', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new Error('reset'))
+      .mockResolvedValueOnce(json(409, { error: 'busy' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const gw = new HttpPaymentGateway('http://pay.test', 'key', [0, 0]);
+    expect(await gw.charge(req)).toEqual({ status: 'approved', transactionId: 'tx_2' });
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('gives up with PaymentUnavailableError and does not retry 401', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(json(503, { error: 'x' })));
+    const gw = new HttpPaymentGateway('http://pay.test', 'key', [0, 0]);
+    await expect(gw.charge(req)).rejects.toBeInstanceOf(PaymentUnavailableError);
+    const unauthorized = vi.fn().mockResolvedValue(json(401, { error: 'key' }));
+    vi.stubGlobal('fetch', unauthorized);
+    await expect(gw.charge(req)).rejects.toThrow('401');
+    expect(unauthorized).toHaveBeenCalledTimes(1);
+  });
+});
