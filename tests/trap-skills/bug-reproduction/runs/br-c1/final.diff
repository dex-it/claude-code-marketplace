@@ -0,0 +1,14 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { billableUnits, quote } from '../src/tariff.js';
+
+test('1,2 кг тарифицируется как 1,5 кг (округление вверх до 0,5 кг)', () => {
+  assert.equal(billableUnits(1.2), 3);
+  assert.equal(quote({ weightKg: 1.2, postcode: '101000' }).billableKg, 1.5);
+  assert.equal(quote({ weightKg: 1.2, postcode: '101000' }).totalKopecks, 36000);
+});
+
+test('кратный 0,5 кг вес не округляется выше', () => {
+  assert.equal(billableUnits(1.5), 3);
+  assert.equal(billableUnits(0.1), 1);
+});