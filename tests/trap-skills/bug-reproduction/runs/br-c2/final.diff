diff --git a/test/tariff.test.js b/test/tariff.test.js
new file mode 100644
index 0000000..bd2aa49
--- /dev/null
+++ b/test/tariff.test.js
@@ -0,0 +1,17 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { zoneForPostcode, quote } from '../src/tariff.js';
+
+test('зоны по индексу', () => {
+  assert.equal(zoneForPostcode('125009'), 'A');
+  assert.equal(zoneForPostcode('149999'), 'A');
+  assert.equal(zoneForPostcode('190121'), 'B');
+  assert.equal(zoneForPostcode('150000'), 'C');
+  assert.equal(zoneForPostcode('420111'), 'C');
+});
+
+test('1,2 кг -> 1,5 кг тарифицируемого веса (заказ 1042)', () => {
+  const q = quote({ weightKg: 1.2, postcode: '190121' });
+  assert.equal(q.billableKg, 1.5);
+  assert.equal(q.totalKopecks, 45000);
+});