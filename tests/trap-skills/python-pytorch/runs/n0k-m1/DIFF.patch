diff --git a/src/shelfwatch/metrics.py b/src/shelfwatch/metrics.py
index a8520ec..c1e85b2 100644
--- a/src/shelfwatch/metrics.py
+++ b/src/shelfwatch/metrics.py
@@ -13,3 +13,45 @@ def macro_f1(y_true: Sequence[int], y_pred: Sequence[int]) -> float:
         denom = 2 * tp + fp + fn
         scores.append(2 * tp / denom if denom else 0.0)
     return sum(scores) / len(scores)
+
+
+def weighted_f1(y_true: Sequence[int], y_pred: Sequence[int]) -> float:
+    """F1 по классам, усреднённый с весами - долей класса в `y_true`.
+
+    Классы, которых нет в `y_true`, имеют нулевой вес и в сумму не входят.
+    """
+    if len(y_true) != len(y_pred):
+        raise ValueError("y_true и y_pred должны быть одной длины")
+    if not y_true:
+        raise ValueError("y_true пуст")
+    total = 0.0
+    for label in set(y_true):
+        tp = sum(1 for t, p in zip(y_true, y_pred) if t == label and p == label)
+        fp = sum(1 for t, p in zip(y_true, y_pred) if t != label and p == label)
+        fn = sum(1 for t, p in zip(y_true, y_pred) if t == label and p != label)
+        support = tp + fn
+        total += support * 2 * tp / (2 * tp + fp + fn)
+    return total / len(y_true)
+
+
+def top_k_accuracy(
+    y_true: Sequence[int], scores: Sequence[Sequence[float]], k: int
+) -> float:
+    """Доля объектов, у которых истинный класс входит в `k` лучших по оценке.
+
+    `scores[i][c]` - оценка класса `c` для объекта `i`, `y_true[i]` - индекс столбца.
+    При равных оценках раньше стоит класс с меньшим индексом.
+    """
+    if len(y_true) != len(scores):
+        raise ValueError("y_true и scores должны быть одной длины")
+    if not y_true:
+        raise ValueError("y_true пуст")
+    if k < 1:
+        raise ValueError("k должно быть не меньше 1")
+    hits = 0
+    for label, row in zip(y_true, scores):
+        if not 0 <= label < len(row):
+            raise ValueError(f"класс {label} вне диапазона столбцов scores")
+        top = sorted(range(len(row)), key=lambda c: (-row[c], c))[:k]
+        hits += label in top
+    return hits / len(y_true)
diff --git a/tests/test_metrics.py b/tests/test_metrics.py
