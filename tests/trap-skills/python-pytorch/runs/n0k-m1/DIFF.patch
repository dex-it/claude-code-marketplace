-from shelfwatch.metrics import macro_f1
+import pytest
+
+from shelfwatch.metrics import macro_f1, top_k_accuracy, weighted_f1
 
 
 def test_macro_f1_perfect() -> None:
@@ -7,3 +9,66 @@ def test_macro_f1_perfect() -> None:
 
 def test_macro_f1_all_wrong() -> None:
     assert macro_f1([0, 0, 1], [1, 1, 0]) == 0.0
+
+
+def test_weighted_f1_perfect() -> None:
+    assert weighted_f1([0, 1, 2], [0, 1, 2]) == 1.0
+
+
+def test_weighted_f1_all_wrong() -> None:
+    assert weighted_f1([0, 0, 1], [1, 1, 0]) == 0.0
+
+
+def test_weighted_f1_weights_by_support() -> None:
+    # класс 0: tp=2, fp=1, fn=0 -> F1=0.8, вес 2/3; класс 1: tp=0, fn=1 -> F1=0, вес 1/3
+    assert weighted_f1([0, 0, 1], [0, 0, 0]) == pytest.approx(2 / 3 * 0.8)
+
+
+def test_weighted_f1_ignores_class_absent_in_y_true() -> None:
+    # класс 1 встречается только в предсказаниях: вес 0
+    assert weighted_f1([0, 0], [0, 1]) == pytest.approx(2 / 3)
+
+
+def test_weighted_f1_differs_from_macro() -> None:
+    y_true = [0, 0, 0, 1]
+    y_pred = [0, 0, 0, 0]
+    assert weighted_f1(y_true, y_pred) > macro_f1(y_true, y_pred)
+
+
+def test_weighted_f1_validates_input() -> None:
+    with pytest.raises(ValueError):
+        weighted_f1([], [])
+    with pytest.raises(ValueError):
+        weighted_f1([0, 1], [0])
+
+
+def test_top_k_accuracy_k1_is_accuracy() -> None:
+    scores = [[0.9, 0.1], [0.2, 0.8], [0.6, 0.4]]
+    assert top_k_accuracy([0, 1, 1], scores, 1) == pytest.approx(2 / 3)
+
+
+def test_top_k_accuracy_k2() -> None:
+    scores = [[0.5, 0.3, 0.2], [0.1, 0.3, 0.6]]
+    assert top_k_accuracy([1, 0], scores, 2) == 0.5
+
+
+def test_top_k_accuracy_k_covers_all_classes() -> None:
+    scores = [[0.5, 0.3, 0.2], [0.1, 0.3, 0.6]]
+    assert top_k_accuracy([2, 0], scores, 3) == 1.0
+    assert top_k_accuracy([2, 0], scores, 10) == 1.0
+
+
+def test_top_k_accuracy_ties_prefer_lower_index() -> None:
+    assert top_k_accuracy([1], [[0.5, 0.5]], 1) == 0.0
+    assert top_k_accuracy([0], [[0.5, 0.5]], 1) == 1.0
+
+
+def test_top_k_accuracy_validates_input() -> None:
+    with pytest.raises(ValueError):
+        top_k_accuracy([0], [[1.0]], 0)
+    with pytest.raises(ValueError):
+        top_k_accuracy([], [], 1)
+    with pytest.raises(ValueError):
+        top_k_accuracy([0, 1], [[1.0]], 1)
+    with pytest.raises(ValueError):
+        top_k_accuracy([2], [[0.5, 0.5]], 1)
