 from collections.abc import Sequence
 
 
+def _class_f1(y_true: Sequence[int], y_pred: Sequence[int], label: int) -> float:
+    tp = sum(1 for t, p in zip(y_true, y_pred) if t == label and p == label)
+    fp = sum(1 for t, p in zip(y_true, y_pred) if t != label and p == label)
+    fn = sum(1 for t, p in zip(y_true, y_pred) if t == label and p != label)
+    denom = 2 * tp + fp + fn
+    return 2 * tp / denom if denom else 0.0
+
+
 def macro_f1(y_true: Sequence[int], y_pred: Sequence[int]) -> float:
     labels = sorted(set(y_true) | set(y_pred))
-    scores = []
-    for label in labels:
-        tp = sum(1 for t, p in zip(y_true, y_pred) if t == label and p == label)
-        fp = sum(1 for t, p in zip(y_true, y_pred) if t != label and p == label)
-        fn = sum(1 for t, p in zip(y_true, y_pred) if t == label and p != label)
-        denom = 2 * tp + fp + fn
-        scores.append(2 * tp / denom if denom else 0.0)
+    scores = [_class_f1(y_true, y_pred, label) for label in labels]
     return sum(scores) / len(scores)
+
+
+def weighted_f1(y_true: Sequence[int], y_pred: Sequence[int]) -> float:
+    """F1 по классам, взвешенный числом объектов класса в y_true.
+
+    Классы, которых нет в y_true, имеют нулевой вес.
+    """
+    if len(y_true) != len(y_pred):
+        raise ValueError("y_true и y_pred должны быть одной длины")
+    if not y_true:
+        raise ValueError("y_true не должен быть пустым")
+    total = 0.0
+    for label in set(y_true):
+        support = sum(1 for t in y_true if t == label)
+        total += support * _class_f1(y_true, y_pred, label)
+    return total / len(y_true)
+
+
+def top_k_accuracy(
+    y_true: Sequence[int], scores: Sequence[Sequence[float]], k: int
+) -> float:
+    """Доля объектов, у которых истинный класс входит в k классов с наибольшей оценкой.
+
+    scores[i][c] - оценка класса c для объекта i. При равных оценках
+    предпочитается класс с меньшим индексом.
+    """
+    if len(y_true) != len(scores):
+        raise ValueError("y_true и scores должны быть одной длины")
+    if not y_true:
+        raise ValueError("y_true не должен быть пустым")
+    if k < 1:
+        raise ValueError("k должно быть не меньше 1")
+    hits = 0
+    for t, row in zip(y_true, scores):
+        top = sorted(range(len(row)), key=lambda c: -row[c])[:k]
+        hits += t in top
+    return hits / len(y_true)
