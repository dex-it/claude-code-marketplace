@@ -0,0 +1,22 @@
+using System.Text.Json.Nodes;
+using Elastic.Clients.Elasticsearch;
+using Elastic.Transport;
+using EsMethod = Elastic.Transport.HttpMethod;
+
+namespace Fulfil.Search;
+
+// Тонкая обёртка над транспортом клиента ADR-0001: запросы собираются как JSON, ответы разбираются как JsonNode.
+public sealed class EsHttp(ElasticsearchClient client)
+{
+    public async Task<JsonNode> SendAsync(EsMethod method, string path, string? body, CancellationToken ct)
+    {
+        var response = await client.Transport.RequestAsync<StringResponse>(
+            method, path, body is null ? null : PostData.String(body), cancellationToken: ct);
+
+        if (!response.ApiCallDetails.HasSuccessfulStatusCode)
+            throw new InvalidOperationException(
+                $"Elasticsearch {method} {path}: HTTP {response.ApiCallDetails.HttpStatusCode}: {response.Body}");
+
+        return string.IsNullOrEmpty(response.Body) ? new JsonObject() : JsonNode.Parse(response.Body)!;
+    }
+}
