@@ -0,0 +1,48 @@
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using EsMethod = Elastic.Transport.HttpMethod;
+
+namespace Fulfil.Search;
+
+// Ночная пересборка в заданный час UTC; при первом запуске без алиаса строит индекс сразу.
+public sealed class ProductIndexHostedService(
+    ProductIndexer indexer, EsHttp es, IOptions<FulfilOptions> options, ILogger<ProductIndexHostedService> log)
+    : BackgroundService
+{
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        try
+        {
+            if (!await AliasExistsAsync(ct)) await RunAsync(ct);
+
+            while (!ct.IsCancellationRequested)
+            {
+                var now = DateTime.UtcNow;
+                var next = now.Date.AddHours(options.Value.SearchReindexHourUtc);
+                if (next <= now) next = next.AddDays(1);
+                await Task.Delay(next - now, ct);
+                await RunAsync(ct);
+            }
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
+    }
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        try { await indexer.RebuildAsync(ct); }
+        catch (Exception ex) when (ex is not OperationCanceledException)
+        {
+            log.LogError(ex, "Пересборка поискового индекса не удалась");
+        }
+    }
+
+    private async Task<bool> AliasExistsAsync(CancellationToken ct)
+    {
+        try
+        {
+            await es.SendAsync(EsMethod.GET, "_alias/" + ProductIndexSchema.Alias, null, ct);
+            return true;
+        }
+        catch (InvalidOperationException) { return false; }
+    }
+}
diff --git a/src/Fulfil/Search/ProductIndexSchema.cs b/src/Fulfil/Search/ProductIndexSchema.cs
