+namespace Fulfil.Search;
+
+public sealed class ProductDocument
+{
+    public string Sku { get; set; } = "";
+    public string Name { get; set; } = "";
+    public string Description { get; set; } = "";
+    public string Category { get; set; } = "";
+    public decimal Price { get; set; }
+    public int Stock { get; set; }
+
+    public static ProductDocument From(Domain.Product p) => new()
+    {
+        Sku = p.Sku,
+        Name = p.Name,
+        Description = p.Description,
+        Category = p.Category,
+        Price = p.Price,
+        Stock = p.Stock
+    };
+}
+
+public sealed record CategoryCount(string Category, long Count);
+
+public sealed record SearchResult(
+    long Total,
+    int Page,
+    IReadOnlyList<ProductDocument> Items,
+    IReadOnlyList<CategoryCount> Categories);
+
+public sealed record SearchQuery(
+    string? Q,
+    string? Category,
+    decimal? MinPrice,
+    decimal? MaxPrice,
+    string? Sort,
+    int Page);
diff --git a/src/Fulfil/Search/ProductSearch.cs b/src/Fulfil/Search/ProductSearch.cs
new file mode 100644
index 0000000..cae065c
--- /dev/null
+++ b/src/Fulfil/Search/ProductSearch.cs
@@ -0,0 +1,130 @@
+using Elastic.Clients.Elasticsearch;
+using Elastic.Clients.Elasticsearch.QueryDsl;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Search;
+
+public sealed class ProductSearch(ElasticsearchClient client, IOptions<FulfilOptions> options)
+{
+    public const int PageSize = 20;
+    public const int ExportLimit = 200_000;
+    private const int ExportPageSize = 2000;
+    private const int MaxWindow = 10_000; // index.max_result_window
+
+    private static readonly string[] TextFields =
+        ["name.ru^3", "name.en^3", "description.ru", "description.en"];
+
+    private string Alias => options.Value.ProductsAlias;
+
+    public async Task<SearchResult> SearchAsync(SearchQuery q, CancellationToken ct)
+    {
+        var page = Math.Max(1, q.Page);
+        var from = (page - 1) * PageSize;
+        if (from + PageSize > MaxWindow)
+            throw new ArgumentOutOfRangeException(nameof(q), "Слишком глубокая страница, используйте /search/export");
+
+        var resp = await client.SearchAsync<ProductDocument>(s => s
+            .Indices(Alias)
+            .From(from)
+            .Size(PageSize)
+            .Query(Build(q.Q, q.MinPrice, q.MaxPrice))
+            // Категория - в post_filter, чтобы список категорий считался по запросу и цене,
+            // а не схлопывался до выбранной категории.
+            .PostFilter(CategoryFilter(q.Category))
+            .Aggregations(a => a.Add("categories", agg => agg.Terms(t => t.Field(x => x.Category).Size(100))))
+            .Sort(Sorting(q.Sort, !string.IsNullOrWhiteSpace(q.Q)))
+            .TrackTotalHits(new TrackHits(true)), ct);
+        if (!resp.IsValidResponse)
+            throw new InvalidOperationException($"Поиск не выполнен: {resp.DebugInformation}");
+
+        var cats = resp.Aggregations?.GetStringTerms("categories")?.Buckets
+            .Select(b => new CategoryCount(b.Key.ToString() ?? "", b.DocCount))
+            .ToList() ?? [];
+        return new SearchResult(
+            resp.Total,
+            page,
+            resp.Documents.ToList(),
+            cats);
+    }
+
+    // Выгрузка: point-in-time + search_after, глубокая пагинация без from/size; отдаётся потоком.
+    public async IAsyncEnumerable<ProductDocument> ExportAsync(
+        string? text, [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken ct)
+    {
+        var pit = await client.OpenPointInTimeAsync(Alias, d => d.KeepAlive("2m"), ct);
+        if (!pit.IsValidResponse)
+            throw new InvalidOperationException($"PIT не открыт: {pit.DebugInformation}");
+        var pitId = pit.Id;
+        try
+        {
+            ICollection<FieldValue>? after = null;
+            var sent = 0;
+            while (sent < ExportLimit)
+            {
+                var size = Math.Min(ExportPageSize, ExportLimit - sent);
+                var resp = await client.SearchAsync<ProductDocument>(s =>
+                {
+                    s.Size(size)
+                     .Query(Build(text, null, null))
+                     .Pit(new PointInTimeReference { Id = pitId, KeepAlive = "2m" })
+                     .Sort(SortOptions.Field(new Field("sku"), new FieldSort { Order = SortOrder.Asc }))
+                     .TrackTotalHits(new TrackHits(false));
+                    if (after is not null) s.SearchAfter(after);
+                }, ct);
+                if (!resp.IsValidResponse)
+                    throw new InvalidOperationException($"Выгрузка прервана: {resp.DebugInformation}");
+                if (resp.Hits.Count == 0) yield break;
+
+                foreach (var hit in resp.Hits)
+                {
+                    if (hit.Source is null) continue;
+                    yield return hit.Source;
+                    sent++;
+                }
+                after = resp.Hits.Last().Sort?.ToList();
+                if (after is null) yield break;
+                pitId = resp.PitId ?? pitId;
+            }
+        }
+        finally
+        {
+            await client.ClosePointInTimeAsync(d => d.Id(pitId), CancellationToken.None);
+        }
+    }
+
+    private static Query Build(string? text, decimal? min, decimal? max)
+    {
+        var must = new List<Query>();
+        var filter = new List<Query>();
+        if (!string.IsNullOrWhiteSpace(text))
+            must.Add(new MultiMatchQuery { Query = text, Fields = TextFields, Type = TextQueryType.BestFields });
+        else
+            must.Add(new MatchAllQuery());
+        if (min is not null || max is not null)
+            filter.Add(new NumberRangeQuery(new Field("price"))
+            {
+                Gte = min is null ? null : (double)min,
+                Lte = max is null ? null : (double)max
+            });
+        return new BoolQuery { Must = must, Filter = filter };
+    }
+
+    private static Query? CategoryFilter(string? category) =>
+        string.IsNullOrWhiteSpace(category)
+            ? null
+            : new TermQuery(new Field("category")) { Value = category };
+
+    private static ICollection<SortOptions> Sorting(string? sort, bool hasText)
+    {
+        var tie = SortOptions.Field(new Field("sku"), new FieldSort { Order = SortOrder.Asc });
+        return sort?.ToLowerInvariant() switch
+        {
+            "price" or "price_asc" => [SortOptions.Field(new Field("price"), new FieldSort { Order = SortOrder.Asc }), tie],
+            "price_desc" => [SortOptions.Field(new Field("price"), new FieldSort { Order = SortOrder.Desc }), tie],
+            "name" => [SortOptions.Field(new Field("name.sort"), new FieldSort { Order = SortOrder.Asc }), tie],
+            _ when hasText => [SortOptions.Score(new ScoreSort { Order = SortOrder.Desc }), tie],
+            _ => [tie]
+        };
+    }
+}
