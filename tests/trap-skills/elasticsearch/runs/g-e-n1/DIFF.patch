diff --git a/src/Fulfil/Search/CatalogIndexer.cs b/src/Fulfil/Search/CatalogIndexer.cs
new file mode 100644
index 0000000..4aca3d6
--- /dev/null
+++ b/src/Fulfil/Search/CatalogIndexer.cs
@@ -0,0 +1,160 @@
+using Elastic.Clients.Elasticsearch;
+using Elastic.Clients.Elasticsearch.IndexManagement;
+using Elastic.Clients.Elasticsearch.Mapping;
+using Fulfil.Options;
+using Fulfil.Ports;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Search;
+
+// Пересборка: новый индекс с версией в имени -> параллельная заливка -> атомарная перекладка алиаса.
+// Поиск и выгрузка всё время работают через алиас, поэтому витрина не останавливается,
+// а смена схемы (маппинг ниже) раскатывается обычной пересборкой.
+public sealed class CatalogIndexer(
+    ElasticsearchClient client,
+    ICatalogSource catalog,
+    IOptions<FulfilOptions> options,
+    ILogger<CatalogIndexer> log)
+{
+    private static readonly SemaphoreSlim Gate = new(1, 1);
+    private readonly FulfilOptions _o = options.Value;
+
+    public async Task<string> RebuildAsync(CancellationToken ct)
+    {
+        if (!await Gate.WaitAsync(0, ct))
+            throw new InvalidOperationException("Пересборка уже идёт");
+        try
+        {
+            var index = $"{_o.ProductsAlias}-{DateTime.UtcNow:yyyyMMddHHmmss}";
+            await CreateIndexAsync(index, ct);
+            try
+            {
+                var total = await LoadAsync(index, ct);
+                await FinishAsync(index, ct);
+                await SwapAliasAsync(index, ct);
+                log.LogInformation("Индекс {Index} собран, документов: {Count}", index, total);
+            }
+            catch
+            {
+                await client.Indices.DeleteAsync(index, CancellationToken.None);
+                throw;
+            }
+            return index;
+        }
+        finally
+        {
+            Gate.Release();
+        }
+    }
+
+    private async Task CreateIndexAsync(string index, CancellationToken ct)
+    {
+        // На время заливки: без реплик и без refresh (один узел, реплики всё равно не размещаются).
+        var resp = await client.Indices.CreateAsync(index, c => c
+            .Settings(s => s
+                .NumberOfShards(1)
+                .NumberOfReplicas(0)
+                .RefreshInterval(new Duration("-1"))
+                .Analysis(a => a.Normalizers(n => n.Custom("lowercase_norm", cn => cn.Filter(new[] { "lowercase" })))))
+            .Mappings(m => m.Properties<ProductDocument>(p => p
+                .Keyword(x => x.Sku)
+                .Text(x => x.Name, t => t
+                    .Analyzer("standard")
+                    .Fields(f => f
+                        .Text("ru", tt => tt.Analyzer("russian"))
+                        .Text("en", tt => tt.Analyzer("english"))
+                        .Keyword("sort", k => k.Normalizer("lowercase_norm"))))
+                .Text(x => x.Description, t => t
+                    .Analyzer("standard")
+                    .Fields(f => f
+                        .Text("ru", tt => tt.Analyzer("russian"))
+                        .Text("en", tt => tt.Analyzer("english"))))
+                .Keyword(x => x.Category)
+                .ScaledFloat(x => x.Price, s => s.ScalingFactor(100))
+                .IntegerNumber(x => x.Stock))), ct);
+        if (!resp.IsValidResponse)
+            throw new InvalidOperationException($"Не создан индекс {index}: {resp.DebugInformation}");
+    }
+
+    private async Task<long> LoadAsync(string index, CancellationToken ct)
+    {
+        long total = 0;
+        // Несколько потоков bulk: один поток на 3 млн документов в час не укладывается с запасом.
+        await Parallel.ForEachAsync(
+            Batches(catalog.ReadAllAsync(ct), _o.IndexBatchSize, ct),
+            new ParallelOptions { MaxDegreeOfParallelism = _o.IndexParallelism, CancellationToken = ct },
+            async (batch, token) =>
+            {
+                await BulkWithRetryAsync(index, batch, token);
+                var done = Interlocked.Add(ref total, batch.Count);
+                if (done % 500_000 < batch.Count)
+                    log.LogInformation("Проиндексировано {Count}", done);
+            });
+        return total;
+    }
+
+    private async Task BulkWithRetryAsync(string index, List<ProductDocument> batch, CancellationToken ct)
+    {
+        for (var attempt = 1; ; attempt++)
+        {
+            var resp = await client.BulkAsync(b => b.Index(index).IndexMany(batch, (d, doc) => d.Id(doc.Sku)), ct);
+            if (resp.IsValidResponse && !resp.Errors)
+                return;
+            if (attempt == 5)
+                throw new InvalidOperationException($"Bulk не прошёл: {resp.DebugInformation}");
+            log.LogWarning("Bulk попытка {Attempt} неудачна, повтор", attempt);
+            await Task.Delay(TimeSpan.FromSeconds(2 * attempt), ct);
+        }
+    }
+
+    private async Task FinishAsync(string index, CancellationToken ct)
+    {
+        await client.Indices.PutSettingsAsync(new PutIndicesSettingsRequest(index)
+        {
+            Settings = new IndexSettings { RefreshInterval = new Duration("1s") }
+        }, ct);
+        await client.Indices.RefreshAsync(index, ct);
+    }
+
+    private async Task SwapAliasAsync(string index, CancellationToken ct)
+    {
+        var alias = _o.ProductsAlias;
+        var old = new List<string>();
+        if ((await client.Indices.ExistsAliasAsync(alias, ct)).Exists)
+        {
+            var cur = await client.Indices.GetAliasAsync(new GetAliasRequest(Names.Parse(alias)), ct);
+            if (cur.Aliases is not null)
+                old.AddRange(cur.Aliases.Keys.Select(k => k.ToString()));
+        }
+
+        var resp = await client.Indices.UpdateAliasesAsync(u =>
+        {
+            u.Actions(a =>
+            {
+                foreach (var o in old)
+                    a.Remove(r => r.Index(o).Alias(alias));
+                a.Add(x => x.Index(index).Alias(alias));
+            });
+        }, ct);
+        if (!resp.IsValidResponse)
+            throw new InvalidOperationException($"Алиас не переключён: {resp.DebugInformation}");
+
+        foreach (var o in old)
+            await client.Indices.DeleteAsync(o, ct);
+    }
+
+    private static async IAsyncEnumerable<List<ProductDocument>> Batches(
+        IAsyncEnumerable<Domain.Product> source, int size,
+        [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken ct)
+    {
+        var batch = new List<ProductDocument>(size);
+        await foreach (var p in source.WithCancellation(ct))
+        {
+            batch.Add(ProductDocument.From(p));
+            if (batch.Count < size) continue;
+            yield return batch;
+            batch = new List<ProductDocument>(size);
+        }
+        if (batch.Count > 0) yield return batch;
+    }
+}
