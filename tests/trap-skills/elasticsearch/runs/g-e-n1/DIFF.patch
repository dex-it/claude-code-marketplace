 using Fulfil.Options;
+using Fulfil.Search;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
 
+var elasticUri = builder.Configuration["Fulfil:ElasticUri"] ?? new FulfilOptions().ElasticUri;
+builder.Services.AddSingleton(new ElasticsearchClient(new Uri(elasticUri)));
