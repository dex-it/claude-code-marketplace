@@ -0,0 +1,37 @@
+namespace Fulfil.Search;
+
+public static class SearchEndpoints
+{
+    public static void MapSearch(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/search", async (string? q, string? category, decimal? minPrice, decimal? maxPrice,
+            string? sort, int? page, ProductSearch search, CancellationToken ct) =>
+        {
+            try
+            {
+                return Results.Ok(await search.SearchAsync(
+                    new SearchQuery(q, category, minPrice, maxPrice, sort, page ?? 1), ct));
+            }
+            catch (ArgumentOutOfRangeException e)
+            {
+                return Results.BadRequest(e.Message);
+            }
+        });
+
+        app.MapGet("/search/export", (string? q, ProductSearch search, CancellationToken ct) =>
+            search.ExportAsync(q, ct));
+
+        // Ночной запуск - CronJob в Kubernetes, дергает один раз; реплики равноправны.
+        app.MapPost("/search/reindex", async (CatalogIndexer indexer, CancellationToken ct) =>
+        {
+            try
+            {
+                return Results.Ok(new { index = await indexer.RebuildAsync(ct) });
+            }
+            catch (InvalidOperationException e)
+            {
+                return Results.Conflict(e.Message);
+            }
+        });
+    }
+}
