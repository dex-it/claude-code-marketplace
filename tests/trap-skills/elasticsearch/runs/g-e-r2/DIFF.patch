+++ b/src/Fulfil/Search/ElasticJson.cs
@@ -0,0 +1,22 @@
+using System.Text.Json;
+using Elastic.Clients.Elasticsearch;
+using Elastic.Transport;
+
+namespace Fulfil.Search;
+
+// Тонкая обёртка над транспортом клиента: тела запросов - JSON (DSL), ответы - JsonDocument.
+public sealed class ElasticJson(ElasticsearchClient client)
+{
+    public async Task<JsonDocument> SendAsync(Elastic.Transport.HttpMethod method, string path, string? body, CancellationToken ct, bool allowNotFound = false)
+    {
+        var response = await client.Transport.RequestAsync<StringResponse>(
+            method, path, body is null ? null : PostData.String(body), cancellationToken: ct);
+
+        var status = response.ApiCallDetails.HttpStatusCode;
+        if (allowNotFound && status == 404)
+            return JsonDocument.Parse("{}");
+        if (!response.ApiCallDetails.HasSuccessfulStatusCode)
+            throw new InvalidOperationException($"Elasticsearch {method} {path} -> {status}: {response.Body}");
+        return JsonDocument.Parse(string.IsNullOrEmpty(response.Body) ? "{}" : response.Body);
+    }
+}
diff --git a/src/Fulfil/Search/IndexDefinition.cs b/src/Fulfil/Search/IndexDefinition.cs
