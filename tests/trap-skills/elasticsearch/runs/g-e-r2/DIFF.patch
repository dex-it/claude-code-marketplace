+++ b/src/Fulfil/Search/NightlyReindexService.cs
@@ -0,0 +1,51 @@
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using StackExchange.Redis;
+
+namespace Fulfil.Search;
+
+// Ночная пересборка. Реплик три, поэтому запуск берётся под Redis-замком: пересобирает одна.
+public sealed class NightlyReindexService(
+    IServiceProvider services,
+    IOptions<FulfilOptions> options,
+    ILogger<NightlyReindexService> log) : BackgroundService
+{
+    private static readonly TimeSpan LockTtl = TimeSpan.FromHours(3);
+
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        while (!ct.IsCancellationRequested)
+        {
+            var now = DateTime.UtcNow;
+            var next = now.Date.AddHours(options.Value.ReindexHourUtc);
+            if (next <= now) next = next.AddDays(1);
+            await Task.Delay(next - now, ct);
+
+            try { await RunOnceAsync(next, ct); }
+            catch (Exception e) when (!ct.IsCancellationRequested)
+            {
+                log.LogError(e, "Ночная пересборка каталога не удалась");
+            }
+        }
+    }
+
+    private async Task RunOnceAsync(DateTime slot, CancellationToken ct)
+    {
+        using var scope = services.CreateScope();
+        if (scope.ServiceProvider.GetService<Fulfil.Ports.ICatalogSource>() is null)
+        {
+            log.LogWarning("ICatalogSource не зарегистрирован, пересборка пропущена");
+            return;
+        }
+        var indexer = scope.ServiceProvider.GetRequiredService<CatalogIndexer>();
+
+        var redis = scope.ServiceProvider.GetRequiredService<IConnectionMultiplexer>().GetDatabase();
+        var key = $"fulfil:reindex:{slot:yyyyMMdd}";
+        if (!await redis.StringSetAsync(key, Environment.MachineName, LockTtl, When.NotExists))
+        {
+            log.LogInformation("Пересборку {Slot:yyyy-MM-dd} выполняет другая реплика", slot);
+            return;
+        }
+        await indexer.RebuildAsync(ct);
+    }
+}
