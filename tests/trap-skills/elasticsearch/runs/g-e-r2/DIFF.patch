@@ -0,0 +1,45 @@
+namespace Fulfil.Search;
+
+public static class IndexDefinition
+{
+    // Приложение читает и ищет только через алиас; физические индексы - products-{метка времени}.
+    public const string Alias = "products";
+    public const string Prefix = "products-";
+
+    // Название и описание - на русском и английском: основное поле разбирается russian-анализатором
+    // (морфология), подполе .en - english-анализатором. Для сортировки по названию - подполе .raw.
+    // Схема меняется только здесь: новая версия строится в новом индексе и подменяется алиасом.
+    // Во время загрузки refresh отключён, реплик нет (узел один); после загрузки refresh возвращается.
+    public static string Create() => """
+    {
+      "settings": {
+        "number_of_shards": 1,
+        "number_of_replicas": 0,
+        "refresh_interval": "-1",
+        "analysis": {
+          "normalizer": { "lowercase_norm": { "type": "custom", "filter": ["lowercase"] } }
+        }
+      },
+      "mappings": {
+        "dynamic": "strict",
+        "properties": {
+          "sku": { "type": "keyword" },
+          "name": {
+            "type": "text", "analyzer": "russian",
+            "fields": {
+              "en": { "type": "text", "analyzer": "english" },
+              "raw": { "type": "keyword", "ignore_above": 256, "normalizer": "lowercase_norm" }
+            }
+          },
+          "description": {
+            "type": "text", "analyzer": "russian",
+            "fields": { "en": { "type": "text", "analyzer": "english" } }
+          },
+          "category": { "type": "keyword" },
+          "price": { "type": "double" },
+          "stock": { "type": "integer" }
+        }
+      }
+    }
+    """;
+}
