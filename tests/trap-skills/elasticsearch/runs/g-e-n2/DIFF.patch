+++ b/src/Fulfil/Search/SearchEndpoints.cs
@@ -0,0 +1,46 @@
+using Elastic.Clients.Elasticsearch;
+using Elastic.Transport;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Search;
+
+public static class SearchEndpoints
+{
+    public static IServiceCollection AddProductSearch(this IServiceCollection services)
+    {
+        services.AddSingleton(sp =>
+        {
+            var uri = sp.GetRequiredService<IOptions<FulfilOptions>>().Value.ElasticUri;
+            return new ElasticsearchClient(new ElasticsearchClientSettings(new Uri(uri)));
+        });
+        services.AddSingleton<ProductIndexer>();
+        services.AddSingleton<ProductSearchService>();
+        services.AddHostedService<CatalogReindexService>();
+        return services;
+    }
+
+    public static IEndpointRouteBuilder MapProductSearch(this IEndpointRouteBuilder app)
+    {
+        app.MapGet("/search", async (
+            string? q, string? category, decimal? minPrice, decimal? maxPrice, string? sort, int? page,
+            ProductSearchService search, CancellationToken ct) =>
+        {
+            try
+            {
+                return Results.Ok(await search.SearchAsync(
+                    new SearchQuery(q, category, minPrice, maxPrice, sort, page ?? 1), ct));
+            }
+            catch (ArgumentException e)
+            {
+                return Results.BadRequest(new { error = e.Message });
+            }
+        });
+
+        // Отдаётся потоком: массив пишется по мере чтения страниц из ES.
+        app.MapGet("/search/export", (string? q, ProductSearchService search, CancellationToken ct) =>
+            search.ExportAsync(q, ct));
+
+        return app;
+    }
+}
