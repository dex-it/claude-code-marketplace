diff --git a/src/Fulfil/Search/CatalogReindexService.cs b/src/Fulfil/Search/CatalogReindexService.cs
new file mode 100644
index 0000000..8ed34ff
--- /dev/null
+++ b/src/Fulfil/Search/CatalogReindexService.cs
@@ -0,0 +1,64 @@
+using Elastic.Clients.Elasticsearch;
+
+namespace Fulfil.Search;
+
+// Ночная пересборка. Реплик сервиса три, поэтому исполнитель выбирается блокировкой-документом в ES.
+public sealed class CatalogReindexService(
+    ProductIndexer indexer, ElasticsearchClient client, ILogger<CatalogReindexService> log) : BackgroundService
+{
+    private const string LockIndex = "fulfil-locks";
+    private const string LockId = "catalog-rebuild";
+    private static readonly TimeSpan LockTtl = TimeSpan.FromHours(3);
+    private static readonly TimeSpan RunAt = TimeSpan.FromHours(2); // 02:00 UTC
+
+    private sealed class LockDoc { public DateTime AcquiredAt { get; set; } }
+
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        // Первый запуск или новая версия схемы: собрать индекс сразу, не дожидаясь ночи.
+        await TryRunAsync(onlyIfStale: true, ct);
+
+        while (!ct.IsCancellationRequested)
+        {
+            var now = DateTime.UtcNow;
+            var next = now.Date + RunAt;
+            if (next <= now) next = next.AddDays(1);
+            try { await Task.Delay(next - now, ct); }
+            catch (OperationCanceledException) { return; }
+            await TryRunAsync(onlyIfStale: false, ct);
+        }
+    }
+
+    private async Task TryRunAsync(bool onlyIfStale, CancellationToken ct)
+    {
+        try
+        {
+            if (onlyIfStale && await indexer.IsCurrentAsync(ct)) return;
+            if (!await TryAcquireAsync(ct)) return;
+            try { await indexer.RebuildAsync(ct); }
+            finally { await client.DeleteAsync(LockIndex, LockId, CancellationToken.None); }
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
+        catch (Exception e)
+        {
+            log.LogError(e, "Catalog rebuild failed; the previous index keeps serving");
+        }
+    }
+
+    private async Task<bool> TryAcquireAsync(CancellationToken ct)
+    {
+        for (var attempt = 0; attempt < 2; attempt++)
+        {
+            var created = await client.CreateAsync(new LockDoc { AcquiredAt = DateTime.UtcNow }, LockIndex, LockId, ct);
+            if (created.IsValidResponse) return true;
+            if (created.ApiCallDetails.HttpStatusCode != 409)
+                throw new InvalidOperationException($"Lock failed: {created.DebugInformation}");
+
+            // Блокировка занята; протухшую (упавший исполнитель) снимаем и пробуем ещё раз.
+            var existing = await client.GetAsync<LockDoc>(LockIndex, LockId, ct);
+            if (existing.Source is { } doc && DateTime.UtcNow - doc.AcquiredAt < LockTtl) return false;
+            await client.DeleteAsync(LockIndex, LockId, ct);
+        }
+        return false;
+    }
+}
diff --git a/src/Fulfil/Search/ProductDoc.cs b/src/Fulfil/Search/ProductDoc.cs
