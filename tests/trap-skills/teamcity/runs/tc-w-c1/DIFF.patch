+++ b/.teamcity/settings.kts
@@ -0,0 +1,23 @@
+import ci.ServiceSpec
+import ci.servicePipeline
+import jetbrains.buildServer.configs.kotlin.*
+
+version = "2024.12"
+
+// Depot - образец: у остальных сервисов отличается только ServiceSpec.
+project(
+    servicePipeline(
+        ServiceSpec(
+            name = "Depot",
+            vcsUrl = "https://git.example.com/depot/depot.git", // TODO: реальный адрес репозитория
+            solution = "Depot.sln",
+            unitTestProject = "tests/Depot.Api.Tests",
+            integrationTestProject = "tests/Depot.Api.Tests",
+            unitTestFilter = "Category=Contracts",
+            integrationTestFilter = "Category=Integration",
+            imageRepository = "registry.example.com/depot/depot-api", // TODO: реальный реестр и путь образа
+            helmChart = "oci://registry.example.com/charts/dotnet-service", // TODO: реальный чарт
+            helmRelease = "depot",
+        )
+    )
+)
