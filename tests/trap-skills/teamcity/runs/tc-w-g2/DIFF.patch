@@ -0,0 +1,16 @@
+import jetbrains.buildServer.configs.kotlin.*
+
+version = "2024.12"
+
+project(
+    dotnetServiceProject(
+        ServiceSpec(
+            id = "Depot",
+            name = "Depot",
+            solution = "Depot.sln",
+            apiProject = "src/Depot.Api/Depot.Api.csproj",
+            testProject = "tests/Depot.Api.Tests/Depot.Api.Tests.csproj",
+            imageName = "depot",
+        )
+    )
+)
