+++ b/.teamcity/settings.kts
@@ -0,0 +1,17 @@
+import jetbrains.buildServer.configs.kotlin.*
+
+version = "2024.12"
+
+// Depot - образец: остальные сервисы с такой же схемой подключают ту же функцию со своим ServiceSpec.
+project(
+    dotnetServicePipeline(
+        ServiceSpec(
+            id = "Depot",
+            name = "Depot",
+            solution = "Depot.sln",
+            image = "depot",
+            unitTestFilter = "Category=Contracts",
+            integrationTestFilter = "Category=Integration",
+        )
+    )
+)
