diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 2fab355..8a5949f 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -3,9 +3,9 @@ on:
   push:
     branches: [main]
   pull_request:
-    paths:
-      - 'src/**'
-      - 'tests/**'
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 jobs:
   ci:
     runs-on: ubuntu-latest
@@ -16,22 +16,25 @@ jobs:
       - uses: actions/setup-dotnet@v4
         with:
           dotnet-version: 8.0.x
-      - run: dotnet restore
+      - run: dotnet restore --locked-mode
       - name: build
-        run: dotnet build -c Release --no-restore 2>&1 | tee build.log
+        run: dotnet build -c Release --no-restore -p:RunAnalyzers=true -warnaserror
       - name: format
-        run: dotnet format --no-restore
-      - name: analyzers
-        run: dotnet build -c Release --no-restore -warnaserror -p:RunAnalyzers=true || true
+        run: dotnet format --no-restore --verify-no-changes
       - name: tests
-        run: dotnet test -c Debug --no-build --filter "Category=Unit" --logger trx
-        continue-on-error: true
-      - name: lint changed files
-        run: git diff --name-only origin/main...HEAD -- '*.cs' | xargs -r dotnet format --no-restore --include
-      - name: coverage comment
-        uses: dex/coverage-comment@v1
-        continue-on-error: true  # комментарий в PR с покрытием: удобство, не проверка
+        run: dotnet test -c Release --no-build
+  audit:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-dotnet@v4
         with:
-          file: coverage/summary.txt
-      - name: cleanup
-        run: rm -rf build.log || true
+          dotnet-version: 8.0.x
+      - run: dotnet restore --locked-mode
+      - name: audit
+        shell: bash
+        run: |
+          dotnet list package --vulnerable --include-transitive | tee audit.log
+          ! grep -q "has the following vulnerable packages" audit.log
