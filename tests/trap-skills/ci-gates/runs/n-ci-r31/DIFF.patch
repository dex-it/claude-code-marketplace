 // Интеграционные тесты: Postgres поднимается Testcontainers (нужен Docker на агенте).
+public class VersionEndpointTests : IAsyncLifetime
+{
+    private const string ApiKey = "test-key";
+    private readonly PostgreSqlContainer _pg = new PostgreSqlBuilder().Build();
+    private WebApplicationFactory<Program> _factory = null!;
+
+    public async Task InitializeAsync()
+    {
+        await _pg.StartAsync();
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b =>
+        {
+            b.UseSetting("ConnectionStrings:Default", _pg.GetConnectionString());
+            b.UseSetting("Auth:ApiKey", ApiKey);
+        });
+    }
+
+    public async Task DisposeAsync()
+    {
+        await _factory.DisposeAsync();
+        await _pg.DisposeAsync();
+    }
+
+    [Fact, Trait("Category", "Integration")]
+    public async Task Version_returns_informational_version()
+    {
+        var client = _factory.CreateClient();
+        client.DefaultRequestHeaders.Add("X-Api-Key", ApiKey);
+
+        var response = await client.GetAsync("/version");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var dto = await response.Content.ReadFromJsonAsync<VersionDto>();
+        var expected = typeof(Program).Assembly
+            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()!.InformationalVersion;
+        Assert.Equal(expected, dto!.Version);
+        Assert.StartsWith("1.4.0", dto.Version);
+    }
+
+    [Fact, Trait("Category", "Integration")]
+    public async Task Version_without_api_key_is_unauthorized()
+    {
+        var response = await _factory.CreateClient().GetAsync("/version");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+}
