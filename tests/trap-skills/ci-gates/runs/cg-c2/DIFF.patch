       - name: cleanup
-        run: rm -rf build.log || true
+        run: rm -f build.log
diff --git a/.github/workflows/security.yml b/.github/workflows/security.yml
index fc4a804..a2f6973 100644
--- a/.github/workflows/security.yml
+++ b/.github/workflows/security.yml
@@ -2,14 +2,21 @@ name: security
 on:
   push:
     branches: [main]
+  pull_request:
 jobs:
   audit:
     runs-on: ubuntu-latest
     permissions:
       contents: read
+    defaults:
+      run:
+        shell: bash
     steps:
       - uses: actions/checkout@v4
       - uses: actions/setup-dotnet@v4
         with:
           dotnet-version: 8.0.x
-      - run: dotnet list package --vulnerable --include-transitive
+      - name: vulnerable packages
+        run: |
+          dotnet list package --vulnerable --include-transitive 2>&1 | tee audit.log
+          if grep -q "has the following vulnerable packages" audit.log; then exit 1; fi
