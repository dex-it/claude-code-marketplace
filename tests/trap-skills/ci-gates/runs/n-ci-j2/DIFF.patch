diff --git a/src/Depot.Api/VersionInfo.cs b/src/Depot.Api/VersionInfo.cs
new file mode 100644
index 0000000..8197b32
--- /dev/null
+++ b/src/Depot.Api/VersionInfo.cs
@@ -0,0 +1,12 @@
+using System.Reflection;
+
+namespace Depot.Api;
+
+public static class VersionInfo
+{
+    // Версия из сборки: AssemblyInformationalVersion (в Directory.Build.props задаётся через <Version>).
+    public static string Current { get; } =
+        typeof(VersionInfo).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
+        ?? typeof(VersionInfo).Assembly.GetName().Version?.ToString()
+        ?? "unknown";
+}
