+using Fulfil.Contracts;
+using Fulfil.Infrastructure;
+using MassTransit;
+using MassTransit.MongoDbIntegration;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed class ShipOrderConsumer : IConsumer<ShipOrder>
+{
+    // Отгрузочной системы в задаче нет: шаг подтверждает отгрузку. Сбой здесь запускает откат процесса.
+    public Task Consume(ConsumeContext<ShipOrder> context) =>
+        context.Publish(new OrderShipped(context.Message.OrderId));
+}
+
+// Проекция статуса заказа в коллекцию orders по событиям процесса.
+public sealed class OrderStatusChangedConsumer(MongoDbContext db) : IConsumer<OrderStatusChanged>
+{
+    public Task Consume(ConsumeContext<OrderStatusChanged> context) =>
+        db.Database.GetCollection<OrderDocument>(Collections.Orders).UpdateOneAsync(
+            db.Session,
+            o => o.Id == context.Message.OrderId,
+            Builders<OrderDocument>.Update.Set(o => o.Status, context.Message.Status),
+            cancellationToken: context.CancellationToken);
+}
diff --git a/src/Fulfil/Consumers/PaymentConsumers.cs b/src/Fulfil/Consumers/PaymentConsumers.cs
new file mode 100644
index 0000000..54c90cd
--- /dev/null
+++ b/src/Fulfil/Consumers/PaymentConsumers.cs
@@ -0,0 +1,64 @@
+using Fulfil.Contracts;
+using Fulfil.Infrastructure;
+using Fulfil.Ports;
+using MassTransit;
+using MassTransit.MongoDbIntegration;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, MongoDbContext db) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var message = context.Message;
+        var payments = db.Database.GetCollection<PaymentDocument>(Collections.Payments);
+
+        // Повторная доставка после успешного списания: второй раз деньги не списываем.
+        var captured = await payments.Find(p => p.OrderId == message.OrderId && p.Captured).AnyAsync(context.CancellationToken);
+        if (captured)
+        {
+            await context.Publish(new PaymentCaptured(message.OrderId));
+            return;
+        }
+
+        try
+        {
+            await gateway.ChargeAsync(message.OrderId, message.Amount, context.CancellationToken);
+        }
+        catch (PaymentDeclinedException e)
+        {
+            await context.Publish(new PaymentFailed(message.OrderId, e.Message));
+            return;
+        }
+        // Прочие исключения - сбой шлюза: повтор политикой эндпоинта, затем Fault<CapturePayment> для процесса.
+
+        await payments.ReplaceOneAsync(
+            db.Session,
+            p => p.OrderId == message.OrderId,
+            new PaymentDocument { OrderId = message.OrderId, Amount = message.Amount, Captured = true },
+            new ReplaceOptions { IsUpsert = true },
+            context.CancellationToken);
+        await context.Publish(new PaymentCaptured(message.OrderId));
+    }
+}
+
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway, MongoDbContext db) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var message = context.Message;
+        var payments = db.Database.GetCollection<PaymentDocument>(Collections.Payments);
+
+        var payment = await payments.Find(p => p.OrderId == message.OrderId).FirstOrDefaultAsync(context.CancellationToken);
+        if (payment is not { Captured: true, Refunded: false })
+            return;
+
+        await gateway.RefundAsync(message.OrderId, message.Amount, context.CancellationToken);
+        await payments.UpdateOneAsync(
+            db.Session,
+            p => p.OrderId == message.OrderId,
+            Builders<PaymentDocument>.Update.Set(p => p.Refunded, true),
+            cancellationToken: context.CancellationToken);
+    }
+}
diff --git a/src/Fulfil/Consumers/StockConsumers.cs b/src/Fulfil/Consumers/StockConsumers.cs
new file mode 100644
index 0000000..3d5f1e9
--- /dev/null
+++ b/src/Fulfil/Consumers/StockConsumers.cs
@@ -0,0 +1,94 @@
+using Fulfil.Contracts;
+using Fulfil.Infrastructure;
+using MassTransit;
+using MassTransit.MongoDbIntegration;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+// Консьюмеры работают внутри транзакции Mongo outbox: изменение склада и публикация результата
+// фиксируются вместе или не фиксируются вовсе.
+public sealed class ReserveStockConsumer(MongoDbContext db) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var message = context.Message;
+        var reservations = db.Database.GetCollection<ReservationDocument>(Collections.Reservations);
+        var products = db.Database.GetCollection<BsonDocument>(Collections.Products);
+
+        // Повторная доставка: резерв уже сделан - только повторяем ответ.
+        var existing = await reservations.Find(r => r.OrderId == message.OrderId).AnyAsync(context.CancellationToken);
+        if (existing)
+        {
+            await context.Publish(new StockReserved(message.OrderId));
+            return;
+        }
+
+        var done = new List<Domain.OrderLine>();
+        foreach (var line in message.Lines)
+        {
+            var result = await products.UpdateOneAsync(
+                db.Session,
+                Builders<BsonDocument>.Filter.Eq("sku", line.Sku) & Builders<BsonDocument>.Filter.Gte("stock", line.Quantity),
+                Builders<BsonDocument>.Update.Inc("stock", -line.Quantity),
+                cancellationToken: context.CancellationToken);
+
+            if (result.ModifiedCount == 1)
+            {
+                done.Add(line);
+                continue;
+            }
+
+            // Товара не хватает: возвращаем уже списанные позиции в рамках той же транзакции.
+            foreach (var undo in done)
+            {
+                await products.UpdateOneAsync(
+                    db.Session,
+                    Builders<BsonDocument>.Filter.Eq("sku", undo.Sku),
+                    Builders<BsonDocument>.Update.Inc("stock", undo.Quantity),
+                    cancellationToken: context.CancellationToken);
+            }
+
+            await context.Publish(new StockReservationFailed(message.OrderId, $"Недостаточно товара {line.Sku}"));
+            return;
+        }
+
+        await reservations.InsertOneAsync(
+            db.Session,
+            new ReservationDocument
+            {
+                OrderId = message.OrderId,
+                Lines = message.Lines.Select(l => new LineDocument { Sku = l.Sku, Quantity = l.Quantity, UnitPrice = l.UnitPrice }).ToList(),
+            },
+            cancellationToken: context.CancellationToken);
+        await context.Publish(new StockReserved(message.OrderId));
+    }
+}
+
+public sealed class ReleaseStockConsumer(MongoDbContext db) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var reservations = db.Database.GetCollection<ReservationDocument>(Collections.Reservations);
+        var products = db.Database.GetCollection<BsonDocument>(Collections.Products);
+
+        // Флаг снимается атомарно: повторная доставка не вернёт товар дважды.
+        var reservation = await reservations.FindOneAndUpdateAsync(
+            db.Session,
+            r => r.OrderId == context.Message.OrderId && !r.Released,
+            Builders<ReservationDocument>.Update.Set(r => r.Released, true),
+            cancellationToken: context.CancellationToken);
+        if (reservation is null)
+            return;
+
+        foreach (var line in reservation.Lines)
+        {
+            await products.UpdateOneAsync(
+                db.Session,
+                Builders<BsonDocument>.Filter.Eq("sku", line.Sku),
+                Builders<BsonDocument>.Update.Inc("stock", line.Quantity),
+                cancellationToken: context.CancellationToken);
+        }
+    }
+}
