diff --git a/src/Fulfil/Infrastructure/Documents.cs b/src/Fulfil/Infrastructure/Documents.cs
new file mode 100644
index 0000000..467b04b
--- /dev/null
+++ b/src/Fulfil/Infrastructure/Documents.cs
@@ -0,0 +1,55 @@
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Infrastructure;
+
+public static class Collections
+{
+    public const string Orders = "orders";
+    public const string Products = "products";
+    public const string Reservations = "reservations";
+    public const string Payments = "payments";
+    public const string WarehouseConfirmations = "warehouse_confirmations";
+}
+
+public sealed class OrderDocument
+{
+    [BsonId] public Guid Id { get; set; }
+    public Guid CustomerId { get; set; }
+    [BsonRepresentation(BsonType.String)]
+    public Domain.OrderStatus Status { get; set; }
+    public List<LineDocument> Lines { get; set; } = [];
+    public DateTimeOffset PlacedAt { get; set; }
+}
+
+public sealed class LineDocument
+{
+    public string Sku { get; set; } = "";
+    public int Quantity { get; set; }
+    public decimal UnitPrice { get; set; }
+}
+
+public sealed class ReservationDocument
+{
+    [BsonId] public Guid OrderId { get; set; }
+    public List<LineDocument> Lines { get; set; } = [];
+    public bool Released { get; set; }
+}
+
+public sealed class PaymentDocument
+{
+    [BsonId] public Guid OrderId { get; set; }
+    public decimal Amount { get; set; }
+    public bool Captured { get; set; }
+    public bool Refunded { get; set; }
+}
+
+// Подтверждение складу пишется в той же транзакции, что и приход; _id = messageId входящего
+// сообщения, поэтому запись же служит отметкой обработки (дедупликация).
+public sealed class WarehouseConfirmationDocument
+{
+    [BsonId] public string MessageId { get; set; } = "";
+    public string Sku { get; set; } = "";
+    public int Qty { get; set; }
+    public DateTimeOffset? PublishedAt { get; set; }
+}
diff --git a/src/Fulfil/Infrastructure/WarehouseConfirmationRelay.cs b/src/Fulfil/Infrastructure/WarehouseConfirmationRelay.cs
new file mode 100644
index 0000000..10faf87
--- /dev/null
+++ b/src/Fulfil/Infrastructure/WarehouseConfirmationRelay.cs
@@ -0,0 +1,93 @@
+using System.Text.Json;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+
+namespace Fulfil.Infrastructure;
+
+// Отправляет подтверждения прихода в обменник warehouse.outbound с publisher confirms:
+// запись помечается отправленной только после подтверждения брокером. При нескольких репликах
+// возможна повторная отправка - у подтверждения есть messageId для дедупликации на стороне склада.
+public sealed class WarehouseConfirmationRelay(
+    IMongoDatabase database,
+    IOptions<FulfilOptions> options,
+    ILogger<WarehouseConfirmationRelay> logger) : BackgroundService
+{
+    public const string Exchange = "warehouse.outbound";
+    public const string RoutingKey = "inbound.confirmed";
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        var confirmations = database.GetCollection<WarehouseConfirmationDocument>(Collections.WarehouseConfirmations);
+        var factory = new ConnectionFactory
+        {
+            HostName = options.Value.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+        };
+
+        IConnection? connection = null;
+        IChannel? channel = null;
+        try
+        {
+            while (!stoppingToken.IsCancellationRequested)
+            {
+                try
+                {
+                    if (channel is not { IsOpen: true })
+                    {
+                        if (connection is null || !connection.IsOpen)
+                            connection = await factory.CreateConnectionAsync(stoppingToken);
+                        channel = await connection.CreateChannelAsync(
+                            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true),
+                            stoppingToken);
+                        await channel.ExchangeDeclareAsync(Exchange, ExchangeType.Direct, durable: true, cancellationToken: stoppingToken);
+                    }
+
+                    var pending = await confirmations
+                        .Find(c => c.PublishedAt == null)
+                        .Limit(100)
+                        .ToListAsync(stoppingToken);
+
+                    foreach (var item in pending)
+                    {
+                        var body = JsonSerializer.SerializeToUtf8Bytes(
+                            new { sku = item.Sku, qty = item.Qty, messageId = item.MessageId },
+                            new JsonSerializerOptions(JsonSerializerDefaults.Web));
+                        var props = new BasicProperties
+                        {
+                            DeliveryMode = DeliveryModes.Persistent,
+                            ContentType = "application/json",
+                            MessageId = item.MessageId,
+                        };
+
+                        // С включённым tracking метод ждёт подтверждения брокера и бросает при nack.
+                        await channel.BasicPublishAsync(Exchange, RoutingKey, mandatory: false, props, body, stoppingToken);
+                        await confirmations.UpdateOneAsync(
+                            c => c.MessageId == item.MessageId,
+                            Builders<WarehouseConfirmationDocument>.Update.Set(c => c.PublishedAt, DateTimeOffset.UtcNow),
+                            cancellationToken: stoppingToken);
+                    }
+
+                    if (pending.Count < 100)
+                        await Task.Delay(TimeSpan.FromSeconds(1), stoppingToken);
+                }
+                catch (Exception e) when (e is not OperationCanceledException)
+                {
+                    logger.LogWarning(e, "Не удалось отправить подтверждения складу, повтор через 5 с");
+                    channel = null;
+                    await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+                }
+            }
+        }
+        catch (OperationCanceledException)
+        {
+        }
+        finally
+        {
+            if (connection is not null)
+                await connection.DisposeAsync();
+        }
+    }
+}
diff --git a/src/Fulfil/Infrastructure/WarehouseInboundConsumer.cs b/src/Fulfil/Infrastructure/WarehouseInboundConsumer.cs
new file mode 100644
index 0000000..716baf1
--- /dev/null
+++ b/src/Fulfil/Infrastructure/WarehouseInboundConsumer.cs
@@ -0,0 +1,146 @@
+using System.Text.Json;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Infrastructure;
+
+public sealed record WarehouseInbound(string Sku, int Qty, string MessageId);
+
+// Чужая очередь warehouse.inbound (не MassTransit) - читаем напрямую. Prefetch ограничен,
+// ack ручной и только после фиксации прихода и подтверждения в Mongo.
+public sealed class WarehouseInboundConsumer(
+    IMongoClient mongoClient,
+    IMongoDatabase database,
+    IOptions<FulfilOptions> options,
+    ILogger<WarehouseInboundConsumer> logger) : BackgroundService
+{
+    public const string Queue = "warehouse.inbound";
+
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        var o = options.Value;
+        var factory = new ConnectionFactory
+        {
+            HostName = o.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+        };
+
+        // Брокер может перезапускаться вместе со стендом, в том числе при старте сервиса.
+        IConnection connection;
+        while (true)
+        {
+            try
+            {
+                connection = await factory.CreateConnectionAsync(stoppingToken);
+                break;
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                logger.LogWarning(e, "RabbitMQ недоступен, повтор через 5 с");
+                await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+            }
+        }
+
+        await using (connection)
+        await using (var channel = await connection.CreateChannelAsync(cancellationToken: stoppingToken))
+        {
+            await channel.BasicQosAsync(0, (ushort)o.WarehouseInboundPrefetch, false, stoppingToken);
+            await channel.QueueDeclareAsync(Queue, durable: true, exclusive: false, autoDelete: false, arguments: null, cancellationToken: stoppingToken);
+
+            var consumer = new AsyncEventingBasicConsumer(channel);
+            consumer.ReceivedAsync += (_, ea) => HandleAsync(channel, ea, stoppingToken);
+            await channel.BasicConsumeAsync(Queue, autoAck: false, consumer, stoppingToken);
+
+            try
+            {
+                await Task.Delay(Timeout.Infinite, stoppingToken);
+            }
+            catch (OperationCanceledException)
+            {
+            }
+        }
+    }
+
+    private async Task HandleAsync(IChannel channel, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        WarehouseInbound? message;
+        try
+        {
+            message = JsonSerializer.Deserialize<WarehouseInbound>(ea.Body.Span, Json);
+        }
+        catch (JsonException)
+        {
+            message = null;
+        }
+
+        if (message is null || string.IsNullOrEmpty(message.Sku) || string.IsNullOrEmpty(message.MessageId) || message.Qty <= 0)
+        {
+            logger.LogError("Некорректное сообщение прихода в {Queue}, отклонено", Queue);
+            await channel.BasicNackAsync(ea.DeliveryTag, false, requeue: false, ct);
+            return;
+        }
+
+        try
+        {
+            var applied = await ApplyAsync(message, ct);
+            if (!applied)
+                logger.LogError("Неизвестный товар {Sku} в сообщении {MessageId}, отклонено", message.Sku, message.MessageId);
+            if (applied)
+                await channel.BasicAckAsync(ea.DeliveryTag, false, ct);
+            else
+                await channel.BasicNackAsync(ea.DeliveryTag, false, requeue: false, ct);
+        }
+        catch (Exception e) when (e is not OperationCanceledException)
+        {
+            logger.LogWarning(e, "Не удалось обработать приход {MessageId}, вернём в очередь", message.MessageId);
+            await Task.Delay(TimeSpan.FromSeconds(1), ct); // не крутим одно сообщение вхолостую
+            await channel.BasicNackAsync(ea.DeliveryTag, false, requeue: true, ct);
+        }
+    }
+
+    // Приход и запись подтверждения - одна транзакция. Подтверждение уходит складу отдельным
+    // процессом (WarehouseConfirmationRelay), поэтому падение между шагами его не теряет.
+    // Возвращает false, если товара нет в каталоге.
+    private async Task<bool> ApplyAsync(WarehouseInbound message, CancellationToken ct)
+    {
+        var confirmations = database.GetCollection<WarehouseConfirmationDocument>(Collections.WarehouseConfirmations);
+        var products = database.GetCollection<BsonDocument>(Collections.Products);
+
+        using var session = await mongoClient.StartSessionAsync(cancellationToken: ct);
+        session.StartTransaction();
+        try
+        {
+            await confirmations.InsertOneAsync(
+                session,
+                new WarehouseConfirmationDocument { MessageId = message.MessageId, Sku = message.Sku, Qty = message.Qty },
+                cancellationToken: ct);
+
+            var result = await products.UpdateOneAsync(
+                session,
+                Builders<BsonDocument>.Filter.Eq("sku", message.Sku),
+                Builders<BsonDocument>.Update.Inc("stock", message.Qty),
+                cancellationToken: ct);
+            if (result.MatchedCount == 0)
+            {
+                await session.AbortTransactionAsync(ct);
+                return false;
+            }
+
+            await session.CommitTransactionAsync(ct);
+            return true;
+        }
+        catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            // Повторная доставка уже обработанного messageId: приход второй раз не применяем.
+            logger.LogInformation("Приход {MessageId} уже обработан", message.MessageId);
+            return true;
+        }
+    }
+}
