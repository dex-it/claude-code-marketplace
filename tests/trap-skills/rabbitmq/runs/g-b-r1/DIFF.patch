diff --git a/src/Fulfil/Processes/OrderProcessStateMachine.cs b/src/Fulfil/Processes/OrderProcessStateMachine.cs
new file mode 100644
index 0000000..59af737
--- /dev/null
+++ b/src/Fulfil/Processes/OrderProcessStateMachine.cs
@@ -0,0 +1,97 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+
+namespace Fulfil.Processes;
+
+// Резерв -> списание -> отгрузка. Сбой шага откатывает выполненные до него шаги:
+// платёж не прошёл - снимаем резерв; отгрузка не удалась - возвращаем деньги и снимаем резерв.
+public sealed class OrderProcessStateMachine : MassTransitStateMachine<OrderProcess>
+{
+    private static readonly Uri ReserveStockQueue = new("queue:reserve-stock");
+    private static readonly Uri CapturePaymentQueue = new("queue:capture-payment");
+    private static readonly Uri ShipOrderQueue = new("queue:ship-order");
+    private static readonly Uri ReleaseStockQueue = new("queue:release-stock");
+    private static readonly Uri RefundPaymentQueue = new("queue:refund-payment");
+
+    public State Reserving { get; private set; } = null!;
+    public State Capturing { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> Reserved { get; private set; } = null!;
+    public Event<StockReservationFailed> ReservationFailed { get; private set; } = null!;
+    public Event<Fault<ReserveStock>> ReserveFaulted { get; private set; } = null!;
+    public Event<PaymentCaptured> Captured { get; private set; } = null!;
+    public Event<PaymentFailed> CaptureFailed { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CaptureFaulted { get; private set; } = null!;
+    public Event<OrderShipped> Shipped { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipFaulted { get; private set; } = null!;
+
+    public OrderProcessStateMachine()
+    {
+        InstanceState(x => x.CurrentState, Reserving, Capturing, Shipping);
+
+        Event(() => Submitted, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => Reserved, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => ReservationFailed, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => ReserveFaulted, e => e.CorrelateById(m => m.Message.Message.OrderId));
+        Event(() => Captured, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => CaptureFailed, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => CaptureFaulted, e => e.CorrelateById(m => m.Message.Message.OrderId));
+        Event(() => Shipped, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => ShipFaulted, e => e.CorrelateById(m => m.Message.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(ctx =>
+                {
+                    ctx.Saga.Total = ctx.Message.Total;
+                    ctx.Saga.Lines = ctx.Message.Lines.ToList();
+                })
+                .Send(ReserveStockQueue, ctx => new ReserveStock(ctx.Message.OrderId, ctx.Message.Lines))
+                .TransitionTo(Reserving));
+
+        During(Reserving,
+            When(Reserved)
+                .Send(CapturePaymentQueue, ctx => new CapturePayment(ctx.Saga.CorrelationId, ctx.Saga.Total))
+                .TransitionTo(Capturing),
+            // Склад откатил частичное списание сам (одна транзакция) - откатывать нечего.
+            When(ReservationFailed)
+                .Publish(ctx => Status(ctx.Saga, OrderStatus.Cancelled))
+                .Finalize(),
+            When(ReserveFaulted)
+                .Publish(ctx => Status(ctx.Saga, OrderStatus.Cancelled))
+                .Finalize());
+
+        During(Capturing,
+            When(Captured)
+                .Publish(ctx => Status(ctx.Saga, OrderStatus.Paid))
+                .Send(ShipOrderQueue, ctx => new ShipOrder(ctx.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(CaptureFailed)
+                .Send(ReleaseStockQueue, ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .Publish(ctx => Status(ctx.Saga, OrderStatus.Cancelled))
+                .Finalize(),
+            // Шлюз упал и повторы исчерпаны: заказ отменяем, резерв снимаем.
+            When(CaptureFaulted)
+                .Send(ReleaseStockQueue, ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .Publish(ctx => Status(ctx.Saga, OrderStatus.Cancelled))
+                .Finalize());
+
+        During(Shipping,
+            When(Shipped)
+                .Publish(ctx => Status(ctx.Saga, OrderStatus.Shipped))
+                .Finalize(),
+            When(ShipFaulted)
+                .Send(RefundPaymentQueue, ctx => new RefundPayment(ctx.Saga.CorrelationId, ctx.Saga.Total))
+                .Send(ReleaseStockQueue, ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .Publish(ctx => Status(ctx.Saga, OrderStatus.Cancelled))
+                .Finalize());
+
+        SetCompletedWhenFinalized();
+    }
+
+    private static OrderStatusChanged Status(OrderProcess saga, OrderStatus status) =>
+        new(saga.CorrelationId, status, DateTimeOffset.UtcNow);
+}
diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..c9d3bb1 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,121 @@
+using Fulfil.Consumers;
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Infrastructure;
 using Fulfil.Options;
+using Fulfil.Processes;
+using MassTransit;
+using MassTransit.MongoDbIntegration;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization;
+using MongoDB.Bson.Serialization.Serializers;
+using MongoDB.Driver;
+
+BsonSerializer.TryRegisterSerializer(new GuidSerializer(GuidRepresentation.Standard));
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
 
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(fulfil.MongoConnectionString));
+builder.Services.AddSingleton(sp => sp.GetRequiredService<IMongoClient>().GetDatabase(fulfil.MongoDatabase));
+
+builder.Services.AddMassTransit(x =>
+{
+    x.SetKebabCaseEndpointNameFormatter();
+
+    // Outbox в Mongo: сохранение данных и публикация/отправка сообщений - одна транзакция;
+    // сообщения уходят в брокер отдельным доставщиком, падение между шагами их не теряет.
+    x.AddMongoDbOutbox(o =>
+    {
+        o.QueryDelay = TimeSpan.FromSeconds(1);
+        o.ClientFactory(sp => sp.GetRequiredService<IMongoClient>());
+        o.DatabaseFactory(sp => sp.GetRequiredService<IMongoDatabase>());
+        o.UseBusOutbox();
+    });
+
+    x.AddConsumer<ReserveStockConsumer, ReserveStockDefinition>();
+    x.AddConsumer<ReleaseStockConsumer, ReleaseStockDefinition>();
+    x.AddConsumer<CapturePaymentConsumer, CapturePaymentDefinition>();
+    x.AddConsumer<RefundPaymentConsumer, RefundPaymentDefinition>();
+    x.AddConsumer<ShipOrderConsumer, ShipOrderDefinition>();
+    x.AddConsumer<OrderStatusChangedConsumer>();
+
+    x.AddSagaStateMachine<OrderProcessStateMachine, OrderProcess>()
+        .MongoDbRepository(r =>
+        {
+            r.Connection = fulfil.MongoConnectionString;
+            r.DatabaseName = fulfil.MongoDatabase;
+            r.CollectionName = "order_processes";
+        });
+
+    x.UsingRabbitMq((context, cfg) =>
+    {
+        cfg.Host(fulfil.RabbitMqHost, "/", h => { });
+
+        // Сбои шлюза и Mongo повторяем с ростом интервала; после исчерпания уходит Fault<T>,
+        // по которому процесс откатывает выполненные шаги.
+        cfg.UseMessageRetry(r => r.Exponential(5, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(2))
+            .Ignore<MongoDB.Driver.MongoWriteException>(e => e.WriteError.Category == ServerErrorCategory.DuplicateKey));
+        cfg.UseMongoDbOutbox(context);
+
+        cfg.ConfigureEndpoints(context);
+    });
+});
+
+builder.Services.AddHostedService<WarehouseInboundConsumer>();
+builder.Services.AddHostedService<WarehouseConfirmationRelay>();
+
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+
+app.MapPost("/orders/{id:guid}/submit", async (
+    Guid id,
+    SubmitOrderRequest request,
+    MongoDbContext db,
+    IPublishEndpoint publish,
+    CancellationToken ct) =>
+{
+    if (request.Lines is not { Count: > 0 })
+        return Results.BadRequest("Заказ без позиций");
+
+    var lines = request.Lines.Select(l => new OrderLine(l.Sku, l.Quantity, l.UnitPrice)).ToList();
+    var now = DateTimeOffset.UtcNow;
+    var order = new OrderDocument
+    {
+        Id = id,
+        CustomerId = request.CustomerId,
+        Status = OrderStatus.Placed,
+        Lines = lines.Select(l => new LineDocument { Sku = l.Sku, Quantity = l.Quantity, UnitPrice = l.UnitPrice }).ToList(),
+        PlacedAt = now,
+    };
+
+    // Заказ и OrderSubmitted фиксируются одной транзакцией: либо оба, либо ни один.
+    await db.BeginTransaction(ct);
+    try
+    {
+        await db.Database.GetCollection<OrderDocument>(Collections.Orders).InsertOneAsync(db.Session, order, cancellationToken: ct);
+        await publish.Publish(new OrderSubmitted(id, request.CustomerId, lines, lines.Sum(l => l.Quantity * l.UnitPrice), now), ct);
+        await db.CommitTransaction(ct);
+    }
+    catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+    {
+        await db.AbortTransaction(ct);
+        return Results.Conflict("Заказ уже отправлен");
+    }
+    catch
+    {
+        await db.AbortTransaction(ct);
+        throw;
+    }
+
+    return Results.Accepted($"/orders/{id}");
+});
+
 app.Run();
+
+public sealed record SubmitOrderLine(string Sku, int Quantity, decimal UnitPrice);
+
+public sealed record SubmitOrderRequest(Guid CustomerId, List<SubmitOrderLine> Lines);
