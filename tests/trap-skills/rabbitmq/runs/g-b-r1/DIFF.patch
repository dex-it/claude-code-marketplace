diff --git a/src/Fulfil/Consumers/ConsumerDefinitions.cs b/src/Fulfil/Consumers/ConsumerDefinitions.cs
new file mode 100644
index 0000000..b295149
--- /dev/null
+++ b/src/Fulfil/Consumers/ConsumerDefinitions.cs
@@ -0,0 +1,47 @@
+using MassTransit;
+
+namespace Fulfil.Consumers;
+
+// Имена очередей зафиксированы: на них отправляет команды процесс (queue:...).
+public sealed class ReserveStockDefinition : ConsumerDefinition<ReserveStockConsumer>
+{
+    public ReserveStockDefinition() => EndpointName = "reserve-stock";
+}
+
+public sealed class ReleaseStockDefinition : ConsumerDefinition<ReleaseStockConsumer>
+{
+    public ReleaseStockDefinition() => EndpointName = "release-stock";
+}
+
+public sealed class RefundPaymentDefinition : ConsumerDefinition<RefundPaymentConsumer>
+{
+    public RefundPaymentDefinition() => EndpointName = "refund-payment";
+}
+
+public sealed class ShipOrderDefinition : ConsumerDefinition<ShipOrderConsumer>
+{
+    public ShipOrderDefinition() => EndpointName = "ship-order";
+}
+
+// Пик 10 000 команд/мин (~170/с) при ответе шлюза 0.3-2 с: по закону Литтла нужно до ~340 одновременных
+// вызовов в худшем случае, берём 300. Prefetch ограничен и немного выше конкурентности, чтобы
+// backlog очереди не оказался в памяти пода (3 реплики - суммарно втрое больше).
+public sealed class CapturePaymentDefinition : ConsumerDefinition<CapturePaymentConsumer>
+{
+    public const int Concurrency = 300;
+
+    public CapturePaymentDefinition()
+    {
+        EndpointName = "capture-payment";
+        ConcurrentMessageLimit = Concurrency;
+    }
+
+    protected override void ConfigureConsumer(
+        IReceiveEndpointConfigurator endpointConfigurator,
+        IConsumerConfigurator<CapturePaymentConsumer> consumerConfigurator,
+        IRegistrationContext context)
+    {
+        if (endpointConfigurator is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.PrefetchCount = Concurrency + 100;
+    }
+}
