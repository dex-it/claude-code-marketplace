+namespace Fulfil.Contracts;
+
+// Старт процесса исполнения заказа.
+public sealed record OrderSubmitted(Guid OrderId, Guid CustomerId, IReadOnlyList<Domain.OrderLine> Lines, decimal Total, DateTimeOffset SubmittedAt);
+
+// Команды шагов процесса.
+public sealed record ReserveStock(Guid OrderId, IReadOnlyList<Domain.OrderLine> Lines);
+public sealed record CapturePayment(Guid OrderId, decimal Amount);
+public sealed record ShipOrder(Guid OrderId);
+
+// Компенсации: откат уже выполненных шагов.
+public sealed record ReleaseStock(Guid OrderId);
+public sealed record RefundPayment(Guid OrderId, decimal Amount);
+
+// Результаты шагов.
+public sealed record StockReserved(Guid OrderId);
+public sealed record StockReservationFailed(Guid OrderId, string Reason);
+public sealed record PaymentCaptured(Guid OrderId);
+public sealed record PaymentDeclined(Guid OrderId, string Reason);
+public sealed record OrderShipped(Guid OrderId);
diff --git a/src/Fulfil/Flow/CapturePaymentConsumer.cs b/src/Fulfil/Flow/CapturePaymentConsumer.cs
new file mode 100644
index 0000000..b49a46d
--- /dev/null
+++ b/src/Fulfil/Flow/CapturePaymentConsumer.cs
@@ -0,0 +1,102 @@
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Fulfil.Ports;
+using MassTransit;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Flow;
+
+// Платёж по заказу - не более одного раза: запись payments/{orderId} фиксирует состояние
+// до обращения к шлюзу, поэтому повторная доставка не списывает второй раз.
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, IMongoDatabase db, ILogger<CapturePaymentConsumer> log)
+    : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var (orderId, amount) = (context.Message.OrderId, context.Message.Amount);
+        var payments = db.GetCollection<BsonDocument>("payments");
+
+        try
+        {
+            await payments.InsertOneAsync(
+                new BsonDocument { { "_id", new BsonBinaryData(orderId, GuidRepresentation.Standard) }, { "status", "Charging" } },
+                cancellationToken: context.CancellationToken);
+        }
+        catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            var status = (await payments.Find(PaymentFlow.ById(orderId)).FirstAsync(context.CancellationToken))["status"].AsString;
+            switch (status)
+            {
+                case "Charged" or "Refunding" or "Refunded":
+                    await context.Publish(new PaymentCaptured(orderId));
+                    return;
+                case "Declined":
+                    await context.Publish(new PaymentDeclined(orderId, "declined"));
+                    return;
+            }
+            // "Charging": прошлая попытка оборвалась на обращении к шлюзу - итог неизвестен, повторяем вызов.
+            log.LogWarning("Повторная попытка списания по заказу {OrderId} после прерванной", orderId);
+        }
+
+        try
+        {
+            await gateway.ChargeAsync(orderId, amount, context.CancellationToken);
+        }
+        catch (PaymentDeclinedException e)
+        {
+            await payments.UpdateOneAsync(PaymentFlow.ById(orderId), Builders<BsonDocument>.Update.Set("status", "Declined"));
+            await context.Publish(new PaymentDeclined(orderId, e.Message));
+            return;
+        }
+
+        await payments.UpdateOneAsync(PaymentFlow.ById(orderId), Builders<BsonDocument>.Update.Set("status", "Charged"));
+        await context.Publish(new PaymentCaptured(orderId));
+    }
+}
+
+public sealed class CapturePaymentConsumerDefinition : ConsumerDefinition<CapturePaymentConsumer>
+{
+    readonly FulfilOptions _options;
+
+    public CapturePaymentConsumerDefinition(IOptions<FulfilOptions> options)
+    {
+        _options = options.Value;
+        EndpointName = "capture-payment";
+        ConcurrentMessageLimit = _options.CapturePaymentConcurrency;
+    }
+
+    protected override void ConfigureConsumer(IReceiveEndpointConfigurator endpoint,
+        IConsumerConfigurator<CapturePaymentConsumer> consumer, IRegistrationContext context)
+    {
+        if (endpoint is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.PrefetchCount = _options.CapturePaymentPrefetch;
+    }
+}
+
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var orderId = context.Message.OrderId;
+        var payments = db.GetCollection<BsonDocument>("payments");
+
+        // Переход Charged -> Refunding занимает возврат; Refunding после обрыва допускает повтор вызова.
+        var claimed = await payments.FindOneAndUpdateAsync(
+            Builders<BsonDocument>.Filter.And(PaymentFlow.ById(orderId),
+                Builders<BsonDocument>.Filter.In("status", new[] { "Charged", "Refunding" })),
+            Builders<BsonDocument>.Update.Set("status", "Refunding"),
+            cancellationToken: context.CancellationToken);
+        if (claimed is null) return; // не списывали либо уже вернули
+
+        await gateway.RefundAsync(orderId, context.Message.Amount, context.CancellationToken);
+        await payments.UpdateOneAsync(PaymentFlow.ById(orderId), Builders<BsonDocument>.Update.Set("status", "Refunded"));
+    }
+}
+
+static class PaymentFlow
+{
+    public static FilterDefinition<BsonDocument> ById(Guid id) =>
+        Builders<BsonDocument>.Filter.Eq("_id", new BsonBinaryData(id, GuidRepresentation.Standard));
+}
diff --git a/src/Fulfil/Flow/MessagingExtensions.cs b/src/Fulfil/Flow/MessagingExtensions.cs
new file mode 100644
index 0000000..8346c7c
--- /dev/null
+++ b/src/Fulfil/Flow/MessagingExtensions.cs
@@ -0,0 +1,64 @@
+using Fulfil.Options;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Flow;
+
+public static class MessagingExtensions
+{
+    public static IServiceCollection AddFulfilMessaging(this IServiceCollection services, FulfilOptions o)
+    {
+        services.AddMassTransit(x =>
+        {
+            x.SetKebabCaseEndpointNameFormatter();
+
+            // Outbox/inbox в MongoDB: событие публикуется из той же транзакции, что и запись данных;
+            // inbox отбрасывает повторную доставку уже обработанного сообщения.
+            x.AddMongoDbOutbox(b =>
+            {
+                b.ClientFactory(p => p.GetRequiredService<IMongoClient>());
+                b.DatabaseFactory(p => p.GetRequiredService<IMongoDatabase>());
+                b.QueryDelay = TimeSpan.FromSeconds(1);
+                b.UseBusOutbox();
+            });
+
+            x.AddConsumer<CapturePaymentConsumer, CapturePaymentConsumerDefinition>();
+            x.AddConsumer<RefundPaymentConsumer>();
+            x.AddConsumer<ReserveStockConsumer>();
+            x.AddConsumer<ReleaseStockConsumer>();
+            x.AddConsumer<ShipOrderConsumer>();
+            x.AddConsumer<OrderStatusProjector>();
+
+            x.AddSagaStateMachine<OrderFlowStateMachine, OrderFlowState>()
+                .MongoDbRepository(r =>
+                {
+                    r.Connection = o.MongoConnectionString;
+                    r.DatabaseName = o.MongoDatabase;
+                    r.CollectionName = "order_flow";
+                });
+
+            x.AddConfigureEndpointsCallback((context, name, cfg) =>
+            {
+                // Сбой шлюза - повтор с нарастающей паузой; отказ платежа - бизнес-исход, не повторяется.
+                // Retry стоит перед outbox: каждая попытка получает новую транзакцию.
+                cfg.UseMessageRetry(r => r
+                    .Exponential(6, TimeSpan.FromSeconds(1), TimeSpan.FromMinutes(1), TimeSpan.FromSeconds(5))
+                    .Ignore<PaymentDeclinedException>());
+                cfg.UseMongoDbOutbox(context);
+            });
+
+            x.UsingRabbitMq((context, cfg) =>
+            {
+                cfg.Host(o.RabbitMqHost, "/", h =>
+                {
+                    h.Username(o.RabbitMqUser);
+                    h.Password(o.RabbitMqPassword);
+                });
+                cfg.PrefetchCount = o.DefaultPrefetch;
+                cfg.ConfigureEndpoints(context);
+            });
+        });
+        return services;
+    }
+}
diff --git a/src/Fulfil/Flow/OrderFlowStateMachine.cs b/src/Fulfil/Flow/OrderFlowStateMachine.cs
new file mode 100644
index 0000000..d3864eb
--- /dev/null
+++ b/src/Fulfil/Flow/OrderFlowStateMachine.cs
@@ -0,0 +1,105 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Flow;
+
+public class OrderFlowState : SagaStateMachineInstance, ISagaVersion
+{
+    [BsonId]
+    public Guid CorrelationId { get; set; }
+    public string CurrentState { get; set; } = "";
+    [BsonRepresentation(BsonType.Decimal128)]
+    public decimal Total { get; set; }
+    public int Version { get; set; }
+}
+
+// Резерв -> списание -> отгрузка. Сбой шага откатывает выполненные до него шаги:
+// отказ платежа снимает резерв; сбой отгрузки возвращает деньги и снимает резерв.
+// Очереди команд - по имени потребителя (kebab-case): reserve-stock, capture-payment, ...
+public sealed class OrderFlowStateMachine : MassTransitStateMachine<OrderFlowState>
+{
+    static readonly Uri ReserveStockQueue = new("queue:reserve-stock");
+    static readonly Uri CapturePaymentQueue = new("queue:capture-payment");
+    static readonly Uri ShipOrderQueue = new("queue:ship-order");
+    static readonly Uri ReleaseStockQueue = new("queue:release-stock");
+    static readonly Uri RefundPaymentQueue = new("queue:refund-payment");
+
+    public State Reserving { get; private set; } = null!;
+    public State Capturing { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> Reserved { get; private set; } = null!;
+    public Event<StockReservationFailed> ReservationFailed { get; private set; } = null!;
+    public Event<Fault<ReserveStock>> ReserveFaulted { get; private set; } = null!;
+    public Event<PaymentCaptured> Captured { get; private set; } = null!;
+    public Event<PaymentDeclined> Declined { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CaptureFaulted { get; private set; } = null!;
+    public Event<OrderShipped> Shipped { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipFaulted { get; private set; } = null!;
+
+    public OrderFlowStateMachine()
+    {
+        InstanceState(x => x.CurrentState, Reserving, Capturing, Shipping);
+
+        Event(() => Submitted, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Reserved, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ReservationFailed, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ReserveFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => Captured, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Declined, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => CaptureFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => Shipped, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ShipFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(c => c.Saga.Total = c.Message.Total)
+                .Send(ReserveStockQueue, c => new ReserveStock(c.Message.OrderId, c.Message.Lines))
+                .TransitionTo(Reserving));
+
+        // Ничего не выполнено - откатывать нечего.
+        During(Reserving,
+            When(Reserved)
+                .Send(CapturePaymentQueue, c => new CapturePayment(c.Saga.CorrelationId, c.Saga.Total))
+                .TransitionTo(Capturing),
+            When(ReservationFailed).Status(OrderStatus.Cancelled).Finalize(),
+            When(ReserveFaulted).Status(OrderStatus.Cancelled).Finalize());
+
+        // Выполнен резерв.
+        During(Capturing,
+            When(Captured)
+                .Status(OrderStatus.Paid)
+                .Send(ShipOrderQueue, c => new ShipOrder(c.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(Declined)
+                .Send(ReleaseStockQueue, c => new ReleaseStock(c.Saga.CorrelationId))
+                .Status(OrderStatus.Cancelled)
+                .Finalize(),
+            When(CaptureFaulted)
+                .Send(ReleaseStockQueue, c => new ReleaseStock(c.Saga.CorrelationId))
+                .Status(OrderStatus.Cancelled)
+                .Finalize());
+
+        // Выполнены резерв и списание.
+        During(Shipping,
+            When(Shipped).Status(OrderStatus.Shipped).Finalize(),
+            When(ShipFaulted)
+                .Send(RefundPaymentQueue, c => new RefundPayment(c.Saga.CorrelationId, c.Saga.Total))
+                .Send(ReleaseStockQueue, c => new ReleaseStock(c.Saga.CorrelationId))
+                .Status(OrderStatus.Cancelled)
+                .Finalize());
+
+        SetCompletedWhenFinished();
+    }
+}
+
+static class OrderFlowExtensions
+{
+    public static EventActivityBinder<OrderFlowState, T> Status<T>(this EventActivityBinder<OrderFlowState, T> binder, OrderStatus status)
+        where T : class =>
+        binder.Publish(c => new OrderStatusChanged(c.Saga.CorrelationId, status, DateTimeOffset.UtcNow));
+}
diff --git a/src/Fulfil/Flow/StockConsumers.cs b/src/Fulfil/Flow/StockConsumers.cs
new file mode 100644
index 0000000..a47f8df
--- /dev/null
+++ b/src/Fulfil/Flow/StockConsumers.cs
@@ -0,0 +1,105 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Flow;
+
+// Остатки и резервы меняются в транзакции outbox (dbContext.Session): списание остатка, запись резерва
+// и публикация результата фиксируются вместе либо откатываются вместе.
+public sealed class ReserveStockConsumer(MongoDbContext dbContext, IMongoDatabase db) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var (orderId, lines) = (context.Message.OrderId, context.Message.Lines);
+        var session = dbContext.Session;
+        var ct = context.CancellationToken;
+        var products = db.GetCollection<BsonDocument>("products");
+        var reservations = db.GetCollection<BsonDocument>("reservations");
+
+        // Резерв по заказу уже есть (повтор команды) - остаток второй раз не списываем.
+        if (await reservations.Find(session, StockFlow.ById(orderId)).AnyAsync(ct))
+        {
+            await context.Publish(new StockReserved(orderId));
+            return;
+        }
+
+        for (var i = 0; i < lines.Count; i++)
+        {
+            var line = lines[i];
+            var taken = await products.UpdateOneAsync(session,
+                Builders<BsonDocument>.Filter.And(
+                    Builders<BsonDocument>.Filter.Eq("_id", line.Sku),
+                    Builders<BsonDocument>.Filter.Gte("stock", line.Quantity)),
+                Builders<BsonDocument>.Update.Inc("stock", -line.Quantity), cancellationToken: ct);
+            if (taken.ModifiedCount == 0)
+            {
+                // Откат строк, уже списанных этой командой, и отрицательный результат шага.
+                await StockFlow.ReturnAsync(products, session, lines.Take(i), ct);
+                await context.Publish(new StockReservationFailed(orderId, $"Недостаточно товара {line.Sku}"));
+                return;
+            }
+        }
+
+        await reservations.InsertOneAsync(session, new BsonDocument
+        {
+            { "_id", new BsonBinaryData(orderId, GuidRepresentation.Standard) },
+            { "lines", new BsonArray(lines.Select(l => new BsonDocument { { "sku", l.Sku }, { "qty", l.Quantity } })) },
+            { "status", "Reserved" },
+        }, cancellationToken: ct);
+        await context.Publish(new StockReserved(orderId));
+    }
+}
+
+public sealed class ReleaseStockConsumer(MongoDbContext dbContext, IMongoDatabase db) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var session = dbContext.Session;
+        var ct = context.CancellationToken;
+        var reservations = db.GetCollection<BsonDocument>("reservations");
+
+        // Переход Reserved -> Released выполняется один раз: повтор команды остаток не возвращает.
+        var reservation = await reservations.FindOneAndUpdateAsync(session,
+            Builders<BsonDocument>.Filter.And(StockFlow.ById(context.Message.OrderId),
+                Builders<BsonDocument>.Filter.Eq("status", "Reserved")),
+            Builders<BsonDocument>.Update.Set("status", "Released"), cancellationToken: ct);
+        if (reservation is null) return;
+
+        var lines = reservation["lines"].AsBsonArray
+            .Select(l => new OrderLine(l["sku"].AsString, l["qty"].ToInt32(), 0));
+        await StockFlow.ReturnAsync(db.GetCollection<BsonDocument>("products"), session, lines, ct);
+    }
+}
+
+// Склад и перевозчик не входят в задачу: шаг фиксирует отгрузку; сбой доходит до саги как Fault<ShipOrder>.
+public sealed class ShipOrderConsumer : IConsumer<ShipOrder>
+{
+    public Task Consume(ConsumeContext<ShipOrder> context) =>
+        context.Publish(new OrderShipped(context.Message.OrderId));
+}
+
+// Статус заказа - проекция событий саги; запись идемпотентна.
+public sealed class OrderStatusProjector(IMongoDatabase db) : IConsumer<OrderStatusChanged>
+{
+    public Task Consume(ConsumeContext<OrderStatusChanged> context) =>
+        db.GetCollection<BsonDocument>("orders").UpdateOneAsync(
+            StockFlow.ById(context.Message.OrderId),
+            Builders<BsonDocument>.Update.Set("Status", context.Message.Status.ToString()),
+            cancellationToken: context.CancellationToken);
+}
+
+static class StockFlow
+{
+    public static FilterDefinition<BsonDocument> ById(Guid id) =>
+        Builders<BsonDocument>.Filter.Eq("_id", new BsonBinaryData(id, GuidRepresentation.Standard));
+
+    public static async Task ReturnAsync(IMongoCollection<BsonDocument> products, IClientSessionHandle session,
+        IEnumerable<OrderLine> lines, CancellationToken ct)
+    {
+        foreach (var line in lines)
+            await products.UpdateOneAsync(session, Builders<BsonDocument>.Filter.Eq("_id", line.Sku),
+                Builders<BsonDocument>.Update.Inc("stock", line.Quantity), cancellationToken: ct);
+    }
+}
