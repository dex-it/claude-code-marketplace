@@ -1,8 +1,58 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Flow;
 using Fulfil.Options;
+using Fulfil.Warehouse;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization;
+using MongoDB.Bson.Serialization.Conventions;
+using MongoDB.Bson.Serialization.Serializers;
+using MongoDB.Driver;
+
+BsonSerializer.RegisterSerializer(new DecimalSerializer(BsonType.Decimal128));
+ConventionRegistry.Register("fulfil", new ConventionPack { new EnumRepresentationConvention(BsonType.String) }, _ => true);
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+var options = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(options.MongoConnectionString));
+builder.Services.AddSingleton(p => p.GetRequiredService<IMongoClient>().GetDatabase(options.MongoDatabase));
+builder.Services.AddFulfilMessaging(options);
+builder.Services.AddHostedService<WarehouseInboundWorker>();
 
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+
+// Заказ и событие OrderSubmitted фиксируются одной транзакцией (bus outbox): падение между
+// сохранением и публикацией не теряет событие, а не сохранённый заказ не порождает событие.
+app.MapPost("/orders/{id:guid}/submit", async (Guid id, SubmitOrderRequest request,
+    MongoDbContext dbContext, IMongoDatabase db, IPublishEndpoint publish, CancellationToken ct) =>
+{
+    if (request.Lines is not { Count: > 0 }) return Results.BadRequest("Заказ без позиций");
+
+    var order = new Order(id, request.CustomerId, OrderStatus.Placed, request.Lines, DateTimeOffset.UtcNow);
+    await dbContext.BeginTransaction(ct);
+    try
+    {
+        await db.GetCollection<Order>("orders").InsertOneAsync(dbContext.Session, order, cancellationToken: ct);
+        await publish.Publish(new OrderSubmitted(order.Id, order.CustomerId, order.Lines, order.Total, order.PlacedAt), ct);
+        await dbContext.Commit(ct);
+    }
+    catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+    {
+        await dbContext.Rollback(ct);
+        return Results.Conflict("Заказ уже отправлен");
+    }
+    catch
+    {
+        await dbContext.Rollback(ct);
+        throw;
+    }
+    return Results.Accepted($"/orders/{id}");
+});
+
 app.Run();
+
+public sealed record SubmitOrderRequest(Guid CustomerId, IReadOnlyList<OrderLine> Lines);
diff --git a/src/Fulfil/Warehouse/WarehouseInboundWorker.cs b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
new file mode 100644
index 0000000..660a7e2
--- /dev/null
+++ b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
@@ -0,0 +1,136 @@
+using System.Text;
+using System.Text.Json;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+public sealed record InboundMessage(string? Sku, int Qty, string? MessageId);
+
+// Очередь warehouse.inbound принадлежит чужой системе: не объявляем её (чтобы не разойтись по аргументам),
+// читаем напрямую. Ack - только после записи остатка и подтверждённой брокером публикации ответа.
+public sealed class WarehouseInboundWorker(IOptions<FulfilOptions> options, IMongoDatabase db, ILogger<WarehouseInboundWorker> log)
+    : BackgroundService
+{
+    // В product.applied хранятся последние идентификаторы применённых приходов (защита от повторной доставки).
+    const int AppliedWindow = 1000;
+
+    readonly FulfilOptions _o = options.Value;
+
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        while (!ct.IsCancellationRequested)
+        {
+            try
+            {
+                await RunAsync(ct);
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
+            catch (Exception e)
+            {
+                log.LogError(e, "Чтение {Queue} прервано, переподключение", _o.WarehouseInboundQueue);
+                await Task.Delay(TimeSpan.FromSeconds(5), ct);
+            }
+        }
+    }
+
+    async Task RunAsync(CancellationToken ct)
+    {
+        var factory = new ConnectionFactory
+        {
+            HostName = _o.RabbitMqHost,
+            UserName = _o.RabbitMqUser,
+            Password = _o.RabbitMqPassword,
+            AutomaticRecoveryEnabled = true,
+        };
+        await using var connection = await factory.CreateConnectionAsync("fulfil-warehouse", ct);
+        await using var consumeChannel = await connection.CreateChannelAsync(cancellationToken: ct);
+        // Канал публикации с подтверждениями: BasicPublishAsync возвращается после confirm брокера.
+        await using var publishChannel = await connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true),
+            ct);
+
+        // Без лимита брокер отдал бы весь backlog очереди в память пода.
+        await consumeChannel.BasicQosAsync(0, _o.WarehousePrefetch, false, ct);
+
+        var consumer = new AsyncEventingBasicConsumer(consumeChannel);
+        consumer.ReceivedAsync += async (_, ea) =>
+        {
+            try
+            {
+                await HandleAsync(ea, consumeChannel, publishChannel, ct);
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                log.LogError(e, "Сбой обработки прихода, сообщение вернётся в очередь");
+                await consumeChannel.BasicNackAsync(ea.DeliveryTag, false, true, CancellationToken.None);
+            }
+        };
+        await consumeChannel.BasicConsumeAsync(_o.WarehouseInboundQueue, autoAck: false, consumer, ct);
+
+        var closed = new TaskCompletionSource();
+        connection.ConnectionShutdownAsync += (_, args) =>
+        {
+            // Автовосстановление берёт на себя клиент; выходим только при необратимом закрытии.
+            if (args.Initiator == ShutdownInitiator.Application) closed.TrySetResult();
+            return Task.CompletedTask;
+        };
+        await using (ct.Register(() => closed.TrySetResult()))
+            await closed.Task;
+    }
+
+    async Task HandleAsync(BasicDeliverEventArgs ea, IChannel consumeChannel, IChannel publishChannel, CancellationToken ct)
+    {
+        InboundMessage? msg;
+        try
+        {
+            msg = JsonSerializer.Deserialize<InboundMessage>(Encoding.UTF8.GetString(ea.Body.Span),
+                new JsonSerializerOptions(JsonSerializerDefaults.Web));
+        }
+        catch (JsonException)
+        {
+            msg = null;
+        }
+
+        if (msg is not { Sku: { Length: > 0 } sku, MessageId: { Length: > 0 } messageId, Qty: > 0 })
+        {
+            // Повтор не поможет; сообщение уходит в dead-letter очереди (если он настроен), а не по кругу.
+            log.LogWarning("Некорректный приход отклонён");
+            await consumeChannel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+            return;
+        }
+
+        var products = db.GetCollection<BsonDocument>("products");
+        // Одна атомарная операция над документом: приращение и отметка messageId не расходятся.
+        var applied = await products.UpdateOneAsync(
+            Builders<BsonDocument>.Filter.And(
+                Builders<BsonDocument>.Filter.Eq("_id", sku),
+                Builders<BsonDocument>.Filter.Ne("applied", messageId)),
+            Builders<BsonDocument>.Update
+                .Inc("stock", msg.Qty)
+                .PushEach("applied", new[] { messageId }, slice: -AppliedWindow),
+            cancellationToken: ct);
+
+        string status;
+        if (applied.ModifiedCount == 1) status = "applied";
+        else if (await products.Find(Builders<BsonDocument>.Filter.Eq("_id", sku)).AnyAsync(ct)) status = "duplicate";
+        else
+        {
+            log.LogWarning("Приход по неизвестному SKU {Sku} отклонён", sku);
+            await consumeChannel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+            return;
+        }
+
+        // Подтверждение отправляется и для дубликата: прошлый ответ мог не дойти.
+        var body = JsonSerializer.SerializeToUtf8Bytes(new { messageId, sku, qty = msg.Qty, status });
+        await publishChannel.BasicPublishAsync(_o.WarehouseOutboundExchange, routingKey: "", mandatory: false,
+            new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = messageId },
+            body, ct);
+
+        await consumeChannel.BasicAckAsync(ea.DeliveryTag, false, ct);
+    }
+}
