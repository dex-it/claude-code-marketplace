+namespace Fulfil.Contracts;
+
+// Событие старта процесса исполнения заказа.
+public sealed record OrderSubmitted(Guid OrderId, Guid CustomerId, IReadOnlyList<Domain.OrderLine> Lines, decimal Total);
+
+// Команды шагов процесса и компенсаций.
+public sealed record ReserveStock(Guid OrderId, IReadOnlyList<Domain.OrderLine> Lines);
+public sealed record CapturePayment(Guid OrderId, decimal Amount);
+public sealed record ShipOrder(Guid OrderId);
+public sealed record ReleaseStock(Guid OrderId, IReadOnlyList<Domain.OrderLine> Lines);
+public sealed record RefundPayment(Guid OrderId, decimal Amount);
+
+// Результаты шагов.
+public sealed record StockReserved(Guid OrderId);
+public sealed record StockReservationRejected(Guid OrderId, string Reason);
+public sealed record PaymentCaptured(Guid OrderId);
+public sealed record PaymentDeclined(Guid OrderId, string Reason);
+public sealed record OrderShipped(Guid OrderId);
diff --git a/src/Fulfil/Messaging/OrderConsumers.cs b/src/Fulfil/Messaging/OrderConsumers.cs
new file mode 100644
index 0000000..af0b69e
--- /dev/null
+++ b/src/Fulfil/Messaging/OrderConsumers.cs
@@ -0,0 +1,88 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Orders;
+using Fulfil.Ports;
+using Fulfil.Storage;
+using MassTransit;
+
+namespace Fulfil.Messaging;
+
+// Команда не подтверждается брокеру, пока результат не записан и не опубликован: падение посередине
+// приводит к повторной доставке, поэтому все обработчики идемпотентны.
+
+public sealed class ReserveStockConsumer(StockStore stock) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var m = context.Message;
+        foreach (var line in m.Lines)
+        {
+            var result = await stock.ApplyAsync(
+                line.Sku, -line.Quantity, StockStore.ReserveKey(m.OrderId), null, context.CancellationToken);
+            if (result is StockResult.NotFound or StockResult.Insufficient)
+            {
+                // Уже зарезервированные позиции снимает ReleaseStock, который процесс шлёт при любом сбое.
+                await context.Publish(new StockReservationRejected(m.OrderId, $"{line.Sku}: {result}"));
+                return;
+            }
+        }
+
+        await context.Publish(new StockReserved(m.OrderId));
+    }
+}
+
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, OrderStore orders) : IConsumer<CapturePayment>
+{
+    // Временные сбои шлюза (исключения) повторяются политикой retry шины; после исчерпания
+    // MassTransit публикует Fault<CapturePayment>, и процесс откатывается. orderId - ключ идемпотентности для шлюза.
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var m = context.Message;
+        try
+        {
+            await gateway.ChargeAsync(m.OrderId, m.Amount, context.CancellationToken);
+        }
+        catch (PaymentDeclinedException ex)
+        {
+            await context.Publish(new PaymentDeclined(m.OrderId, ex.Message));
+            return;
+        }
+
+        await orders.SetStatusAsync(m.OrderId, OrderStatus.Paid, [OrderStatus.Placed], context.CancellationToken);
+        await context.Publish(new PaymentCaptured(m.OrderId));
+    }
+}
+
+public sealed class ShipOrderConsumer(OrderStore orders) : IConsumer<ShipOrder>
+{
+    public async Task Consume(ConsumeContext<ShipOrder> context)
+    {
+        var id = context.Message.OrderId;
+        await orders.SetStatusAsync(id, OrderStatus.Shipped, [OrderStatus.Paid], context.CancellationToken);
+        await context.Publish(new OrderShipped(id));
+    }
+}
+
+public sealed class ReleaseStockConsumer(StockStore stock, OrderStore orders) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var m = context.Message;
+        foreach (var line in m.Lines)
+        {
+            // Возвращается только то, что реально было зарезервировано этим заказом.
+            await stock.ApplyAsync(
+                line.Sku, line.Quantity, StockStore.ReleaseKey(m.OrderId), StockStore.ReserveKey(m.OrderId),
+                context.CancellationToken);
+        }
+
+        await orders.SetStatusAsync(
+            m.OrderId, OrderStatus.Cancelled, [OrderStatus.Placed, OrderStatus.Paid], context.CancellationToken);
+    }
+}
+
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway) : IConsumer<RefundPayment>
+{
+    public Task Consume(ConsumeContext<RefundPayment> context) =>
+        gateway.RefundAsync(context.Message.OrderId, context.Message.Amount, context.CancellationToken);
+}
