diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..fe46783 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,55 @@
+using Fulfil.Messaging;
 using Fulfil.Options;
+using Fulfil.Orders;
+using Fulfil.Storage;
+using Fulfil.Warehouse;
+using MassTransit;
+using MongoDB.Driver;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+var options = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(options.MongoConnectionString));
+builder.Services.AddSingleton(sp => sp.GetRequiredService<IMongoClient>().GetDatabase(options.MongoDatabase));
+builder.Services.AddSingleton<OrderStore>();
+builder.Services.AddSingleton<StockStore>();
+builder.Services.AddHostedService<OrderOutboxRelay>();
+builder.Services.AddHostedService<WarehouseInboundWorker>();
+
+Queues.MapCommands();
+builder.Services.AddMassTransit(x =>
+{
+    x.AddConsumer<ReserveStockConsumer>().Endpoint(e => e.Name = Queues.ReserveStock);
+    x.AddConsumer<CapturePaymentConsumer>().Endpoint(e =>
+    {
+        e.Name = Queues.CapturePayment;
+        e.ConcurrentMessageLimit = options.PaymentConcurrentLimit;
+        e.PrefetchCount = options.PaymentPrefetch;
+    });
+    x.AddConsumer<ShipOrderConsumer>().Endpoint(e => e.Name = Queues.ShipOrder);
+    x.AddConsumer<ReleaseStockConsumer>().Endpoint(e => e.Name = Queues.ReleaseStock);
+    x.AddConsumer<RefundPaymentConsumer>().Endpoint(e => e.Name = Queues.RefundPayment);
+
+    x.AddSagaStateMachine<OrderProcessStateMachine, OrderProcessState>()
+        .MongoDbRepository(r =>
+        {
+            r.Connection = options.MongoConnectionString;
+            r.DatabaseName = options.MongoDatabase;
+            r.CollectionName = "order_process";
+        });
+
+    x.UsingRabbitMq((context, cfg) =>
+    {
+        cfg.Host(options.RabbitMqHost, "/", _ => { });
+        cfg.PrefetchCount = options.DefaultPrefetch;
+        // Временные сбои (шлюз, Mongo) повторяются; после исчерпания публикуется Fault<T>, на который реагирует процесс.
+        cfg.UseMessageRetry(r => r.Exponential(5, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(2)));
+        cfg.ConfigureEndpoints(context);
+    });
+});
 
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+app.MapSubmitOrder();
 app.Run();
diff --git a/src/Fulfil/Storage/StockStore.cs b/src/Fulfil/Storage/StockStore.cs
