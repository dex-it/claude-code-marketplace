--- /dev/null
+++ b/src/Fulfil/Orders/OrderOutboxRelay.cs
@@ -0,0 +1,56 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Orders;
+
+// Публикует OrderSubmitted для заказов с OutboxPending и снимает флаг после подтверждения брокером.
+// Падение до снятия флага даст повторную публикацию: MessageId = id заказа, а процесс
+// игнорирует повторный старт, так что дубликат безвреден. Реплики могут публиковать одновременно по той же причине.
+public sealed class OrderOutboxRelay(IBus bus, OrderStore store, ILogger<OrderOutboxRelay> logger) : BackgroundService
+{
+    private static readonly TimeSpan Poll = TimeSpan.FromSeconds(1);
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                var published = await PublishPendingAsync(stoppingToken);
+                if (published > 0)
+                    continue;
+            }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                logger.LogError(ex, "Не удалось опубликовать OrderSubmitted, повтор");
+            }
+
+            await Task.Delay(Poll, stoppingToken).ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);
+        }
+    }
+
+    private async Task<int> PublishPendingAsync(CancellationToken ct)
+    {
+        var pending = await store.Orders
+            .Find(o => o.OutboxPending)
+            .Limit(100)
+            .ToListAsync(ct);
+
+        foreach (var order in pending)
+        {
+            var lines = order.Lines.Select(l => new OrderLine(l.Sku, l.Quantity, l.UnitPrice)).ToList();
+            await bus.Publish(
+                new OrderSubmitted(order.Id, order.CustomerId, lines, order.Total),
+                c => c.MessageId = order.Id,
+                ct);
+            await store.Orders.UpdateOneAsync(
+                o => o.Id == order.Id,
+                Builders<OrderDocument>.Update.Set(o => o.OutboxPending, false),
+                cancellationToken: ct);
+        }
+
+        return pending.Count;
+    }
+}
diff --git a/src/Fulfil/Orders/OrderStore.cs b/src/Fulfil/Orders/OrderStore.cs
new file mode 100644
index 0000000..67839af
--- /dev/null
+++ b/src/Fulfil/Orders/OrderStore.cs
@@ -0,0 +1,57 @@
+using Fulfil.Domain;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization.Attributes;
+using MongoDB.Driver;
+
+namespace Fulfil.Orders;
+
+public sealed class OrderLineDocument
+{
+    public string Sku { get; set; } = "";
+    public int Quantity { get; set; }
+    [BsonRepresentation(BsonType.Decimal128)]
+    public decimal UnitPrice { get; set; }
+}
+
+// OutboxPending - событие OrderSubmitted ещё не опубликовано. Флаг лежит в том же документе,
+// что и заказ, поэтому заказ и намерение опубликовать сохраняются одной атомарной записью.
+public sealed class OrderDocument
+{
+    [BsonId]
+    public Guid Id { get; set; }
+    public Guid CustomerId { get; set; }
+    [BsonRepresentation(BsonType.String)]
+    public OrderStatus Status { get; set; }
+    public List<OrderLineDocument> Lines { get; set; } = [];
+    [BsonRepresentation(BsonType.Decimal128)]
+    public decimal Total { get; set; }
+    public DateTimeOffset PlacedAt { get; set; }
+    public bool OutboxPending { get; set; }
+}
+
+public sealed class OrderStore(IMongoDatabase db)
+{
+    public IMongoCollection<OrderDocument> Orders => db.GetCollection<OrderDocument>("orders");
+
+    // false - заказ с таким id уже есть (повторный submit).
+    public async Task<bool> TryInsertAsync(OrderDocument order, CancellationToken ct)
+    {
+        try
+        {
+            await Orders.InsertOneAsync(order, cancellationToken: ct);
+            return true;
+        }
+        catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            return false;
+        }
+    }
+
+    // Переход статуса идемпотентен и не откатывает статус назад: меняется только из перечисленных.
+    public Task SetStatusAsync(Guid orderId, OrderStatus to, OrderStatus[] from, CancellationToken ct) =>
+        Orders.UpdateOneAsync(
+            Builders<OrderDocument>.Filter.Eq(o => o.Id, orderId)
+                & Builders<OrderDocument>.Filter.In(o => o.Status, from),
+            Builders<OrderDocument>.Update.Set(o => o.Status, to),
+            cancellationToken: ct);
+}
