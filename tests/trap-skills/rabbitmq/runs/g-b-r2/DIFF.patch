+using Fulfil.Domain;
+
+namespace Fulfil.Orders;
+
+public sealed record SubmitOrderRequest(Guid CustomerId, IReadOnlyList<OrderLine> Lines);
+
+public static class SubmitOrderEndpoint
+{
+    public static void MapSubmitOrder(this IEndpointRouteBuilder app) =>
+        app.MapPost("/orders/{id:guid}/submit", async (
+            Guid id, SubmitOrderRequest request, OrderStore store, CancellationToken ct) =>
+        {
+            if (request.Lines is not { Count: > 0 } || request.Lines.Any(l => l.Quantity <= 0 || l.UnitPrice < 0))
+                return Results.BadRequest("Заказ должен содержать позиции с положительным количеством.");
+
+            var order = new OrderDocument
+            {
+                Id = id,
+                CustomerId = request.CustomerId,
+                Status = OrderStatus.Placed,
+                Lines = request.Lines.Select(l => new OrderLineDocument
+                {
+                    Sku = l.Sku, Quantity = l.Quantity, UnitPrice = l.UnitPrice
+                }).ToList(),
+                Total = request.Lines.Sum(l => l.Quantity * l.UnitPrice),
+                PlacedAt = DateTimeOffset.UtcNow,
+                OutboxPending = true,
+            };
+
+            // Публикует OrderSubmitted OrderOutboxRelay из флага OutboxPending, а не этот обработчик:
+            // падение между записью и публикацией не теряет событие. Повтор submit безопасен.
+            await store.TryInsertAsync(order, ct);
+            return Results.Accepted($"/orders/{id}");
+        });
+}
