+++ b/src/Fulfil/Storage/StockStore.cs
@@ -0,0 +1,53 @@
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Storage;
+
+public enum StockResult { Applied, AlreadyApplied, NotFound, Insufficient, NotReserved }
+
+// Изменение остатка товара одним атомарным обновлением документа: $inc stock и запись
+// ключа операции в ops. Повторная операция с тем же ключом не применяется, поэтому
+// повторная доставка сообщения не удваивает остаток и не требует транзакций.
+public sealed class StockStore(IMongoDatabase db)
+{
+    private const int OpsKept = 1000;
+
+    private IMongoCollection<BsonDocument> Products => db.GetCollection<BsonDocument>("products");
+
+    public static string ReserveKey(Guid orderId) => "reserve:" + orderId;
+    public static string ReleaseKey(Guid orderId) => "release:" + orderId;
+    public static string InboundKey(string messageId) => "inbound:" + messageId;
+
+    // requiredOpKey - операция, без которой эта не имеет смысла (снять можно только то, что зарезервировано).
+    public async Task<StockResult> ApplyAsync(
+        string sku, int delta, string opKey, string? requiredOpKey, CancellationToken ct)
+    {
+        var f = Builders<BsonDocument>.Filter;
+        var filter = f.Eq("sku", sku) & f.Not(f.AnyEq("ops", opKey));
+        if (delta < 0)
+            filter &= f.Gte("stock", -delta);
+        if (requiredOpKey is not null)
+            filter &= f.AnyEq("ops", requiredOpKey);
+
+        var update = Builders<BsonDocument>.Update
+            .Inc("stock", delta)
+            .PushEach("ops", new[] { opKey }, slice: -OpsKept);
+
+        var result = await Products.UpdateOneAsync(filter, update, cancellationToken: ct);
+        if (result.ModifiedCount == 1)
+            return StockResult.Applied;
+
+        var current = await Products.Find(f.Eq("sku", sku))
+            .Project(Builders<BsonDocument>.Projection.Include("ops"))
+            .FirstOrDefaultAsync(ct);
+        if (current is null)
+            return StockResult.NotFound;
+
+        var ops = current.GetValue("ops", new BsonArray()).AsBsonArray;
+        if (ops.Contains(opKey))
+            return StockResult.AlreadyApplied;
+        if (requiredOpKey is not null && !ops.Contains(requiredOpKey))
+            return StockResult.NotReserved;
+        return StockResult.Insufficient;
+    }
+}
diff --git a/src/Fulfil/Warehouse/WarehouseInboundWorker.cs b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
new file mode 100644
index 0000000..b97bfb9
--- /dev/null
+++ b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
@@ -0,0 +1,128 @@
+using System.Text.Json;
+using Fulfil.Messaging;
+using Fulfil.Options;
+using Fulfil.Storage;
+using Microsoft.Extensions.Options;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+public sealed record WarehouseInbound(string? Sku, int Qty, string? MessageId);
+
+// Прямой консьюмер очереди склада (не MassTransit). Prefetch ограничен, ack ручной: сообщение
+// подтверждается только после увеличения остатка и подтверждения брокером ответа на warehouse.outbound.
+// Дубликаты (повторная доставка после падения, повтор отправителя) отсекаются по messageId внутри
+// обновления остатка; на дубликат ответ отправляется снова - предыдущий мог не уйти.
+public sealed class WarehouseInboundWorker(
+    IOptions<FulfilOptions> options,
+    StockStore stock,
+    ILogger<WarehouseInboundWorker> logger) : BackgroundService
+{
+    private static readonly TimeSpan Reconnect = TimeSpan.FromSeconds(5);
+    private readonly FulfilOptions _options = options.Value;
+    private IConnection? _connection;
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                await StartAsync(stoppingToken);
+                await Task.Delay(Timeout.Infinite, stoppingToken);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+            {
+                return;
+            }
+            catch (Exception ex)
+            {
+                // Брокер недоступен при старте (в т.ч. перезапуск стенда): пробуем снова.
+                logger.LogError(ex, "Не удалось подключиться к {Queue}, повтор", Queues.WarehouseInbound);
+                await Task.Delay(Reconnect, stoppingToken).ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);
+            }
+        }
+    }
+
+    private async Task StartAsync(CancellationToken ct)
+    {
+        var factory = new ConnectionFactory
+        {
+            HostName = _options.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+            ConsumerDispatchConcurrency = 1,
+        };
+        _connection?.Dispose();
+        _connection = await factory.CreateConnectionAsync("fulfil-warehouse", ct);
+
+        var publishChannel = await _connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true),
+            ct);
+        var channel = await _connection.CreateChannelAsync(cancellationToken: ct);
+        await channel.BasicQosAsync(0, _options.WarehousePrefetch, false, ct);
+
+        var consumer = new AsyncEventingBasicConsumer(channel);
+        consumer.ReceivedAsync += (_, ea) => HandleAsync(channel, publishChannel, ea, ct);
+        await channel.BasicConsumeAsync(Queues.WarehouseInbound, autoAck: false, consumer, ct);
+        logger.LogInformation("Читаем {Queue}, prefetch {Prefetch}", Queues.WarehouseInbound, _options.WarehousePrefetch);
+    }
+
+    private async Task HandleAsync(IChannel channel, IChannel publishChannel, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        try
+        {
+            WarehouseInbound? message;
+            try
+            {
+                message = JsonSerializer.Deserialize<WarehouseInbound>(
+                    ea.Body.Span, new JsonSerializerOptions(JsonSerializerDefaults.Web));
+            }
+            catch (JsonException)
+            {
+                message = null;
+            }
+
+            if (message is not { Sku: { Length: > 0 } sku, Qty: > 0, MessageId: { Length: > 0 } messageId })
+            {
+                logger.LogWarning("Некорректное сообщение прихода, отклонено");
+                await channel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+                return;
+            }
+
+            var result = await stock.ApplyAsync(sku, message.Qty, StockStore.InboundKey(messageId), null, ct);
+            if (result == StockResult.NotFound)
+            {
+                logger.LogWarning("Приход неизвестного товара {Sku}, сообщение {MessageId} отклонено", sku, messageId);
+                await channel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+                return;
+            }
+
+            var confirmation = JsonSerializer.SerializeToUtf8Bytes(
+                new { sku, qty = message.Qty, messageId, status = "applied" });
+            await publishChannel.BasicPublishAsync(
+                Queues.WarehouseOutboundExchange,
+                routingKey: "",
+                mandatory: false,
+                basicProperties: new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = messageId },
+                body: confirmation,
+                cancellationToken: ct);
+
+            await channel.BasicAckAsync(ea.DeliveryTag, false, ct);
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException)
+        {
+            // Mongo или брокер временно недоступны: возвращаем в очередь, с паузой против горячего цикла.
+            logger.LogError(ex, "Ошибка обработки прихода, сообщение возвращено в очередь");
+            await Task.Delay(TimeSpan.FromSeconds(1), ct).ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);
+            await channel.BasicNackAsync(ea.DeliveryTag, false, true, ct);
+        }
+    }
+
+    public override void Dispose()
+    {
+        _connection?.Dispose();
+        base.Dispose();
+    }
+}
