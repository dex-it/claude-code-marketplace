diff --git a/src/Fulfil/Messaging/OrderProcessStateMachine.cs b/src/Fulfil/Messaging/OrderProcessStateMachine.cs
new file mode 100644
index 0000000..ad2af20
--- /dev/null
+++ b/src/Fulfil/Messaging/OrderProcessStateMachine.cs
@@ -0,0 +1,89 @@
+using Fulfil.Contracts;
+using MassTransit;
+
+namespace Fulfil.Messaging;
+
+// Резерв -> списание -> отгрузка. Сбой шага откатывает уже выполненные:
+// платёж отклонён - снимаем резерв; отгрузка не удалась - возврат денег и снятие резерва.
+// Все команды идемпотентны: при повторной доставке событий процесс шлёт их повторно.
+public sealed class OrderProcessStateMachine : MassTransitStateMachine<OrderProcessState>
+{
+    public State Reserving { get; private set; } = null!;
+    public State Capturing { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+    public State Completed { get; private set; } = null!;
+    public State Cancelled { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> Reserved { get; private set; } = null!;
+    public Event<StockReservationRejected> ReserveRejected { get; private set; } = null!;
+    public Event<Fault<ReserveStock>> ReserveFaulted { get; private set; } = null!;
+    public Event<PaymentCaptured> Captured { get; private set; } = null!;
+    public Event<PaymentDeclined> Declined { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CaptureFaulted { get; private set; } = null!;
+    public Event<OrderShipped> Shipped { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipFaulted { get; private set; } = null!;
+
+    public OrderProcessStateMachine()
+    {
+        InstanceState(x => x.CurrentState);
+
+        Event(() => Submitted, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Reserved, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ReserveRejected, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ReserveFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => Captured, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Declined, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => CaptureFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => Shipped, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ShipFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+
+        // Дубликаты и запоздавшие события при доставке at-least-once не ломают процесс.
+        OnUnhandledEvent(x => x.Ignore());
+
+        Initially(
+            When(Submitted)
+                .Then(c =>
+                {
+                    c.Saga.Lines = c.Message.Lines.ToList();
+                    c.Saga.Total = c.Message.Total;
+                })
+                .Send(c => new ReserveStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .TransitionTo(Reserving));
+
+        During(Reserving,
+            When(Reserved)
+                .Send(c => new CapturePayment(c.Saga.CorrelationId, c.Saga.Total))
+                .TransitionTo(Capturing),
+            When(ReserveRejected)
+                .Then(c => c.Saga.FailureReason = c.Message.Reason)
+                .Send(c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .TransitionTo(Cancelled),
+            When(ReserveFaulted)
+                .Then(c => c.Saga.FailureReason = c.Message.Exceptions.FirstOrDefault()?.Message)
+                .Send(c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .TransitionTo(Cancelled));
+
+        During(Capturing,
+            When(Captured)
+                .Send(c => new ShipOrder(c.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(Declined)
+                .Then(c => c.Saga.FailureReason = c.Message.Reason)
+                .Send(c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .TransitionTo(Cancelled),
+            When(CaptureFaulted)
+                .Then(c => c.Saga.FailureReason = c.Message.Exceptions.FirstOrDefault()?.Message)
+                .Send(c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .TransitionTo(Cancelled));
+
+        During(Shipping,
+            When(Shipped)
+                .TransitionTo(Completed),
+            When(ShipFaulted)
+                .Then(c => c.Saga.FailureReason = c.Message.Exceptions.FirstOrDefault()?.Message)
+                .Send(c => new RefundPayment(c.Saga.CorrelationId, c.Saga.Total))
+                .Send(c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .TransitionTo(Cancelled));
+    }
+}
