diff --git a/src/Fulfil/Process/OrderProcessStateMachine.cs b/src/Fulfil/Process/OrderProcessStateMachine.cs
new file mode 100644
index 0000000..09734fd
--- /dev/null
+++ b/src/Fulfil/Process/OrderProcessStateMachine.cs
@@ -0,0 +1,90 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Storage;
+using MassTransit;
+
+namespace Fulfil.Process;
+
+// ReserveStock -> CapturePayment -> ShipOrder; при отказе шага - компенсации и отмена.
+public sealed class OrderProcessStateMachine : MassTransitStateMachine<OrderProcessState>
+{
+    public State Reserving { get; private set; } = null!;
+    public State CapturingPayment { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> StockReserved { get; private set; } = null!;
+    public Event<StockReservationFailed> StockReservationFailed { get; private set; } = null!;
+    public Event<PaymentCaptured> PaymentCaptured { get; private set; } = null!;
+    public Event<PaymentFailed> PaymentFailed { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CapturePaymentFaulted { get; private set; } = null!;
+    public Event<OrderShipped> OrderShipped { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipOrderFaulted { get; private set; } = null!;
+
+    public OrderProcessStateMachine()
+    {
+        InstanceState(x => x.CurrentState);
+
+        Event(() => Submitted, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => StockReserved, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => StockReservationFailed, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => PaymentCaptured, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => PaymentFailed, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => CapturePaymentFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => OrderShipped, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ShipOrderFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(c =>
+                {
+                    c.Saga.CustomerId = c.Message.CustomerId;
+                    c.Saga.Total = c.Message.Total;
+                    c.Saga.Lines = c.Message.Lines.ToList();
+                })
+                .Send(QueueUri(Queues.ReserveStock), c => new ReserveStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .TransitionTo(Reserving));
+
+        During(Reserving,
+            When(StockReserved)
+                .Send(QueueUri(Queues.CapturePayment), c => new CapturePayment(c.Saga.CorrelationId, c.Saga.Total))
+                .TransitionTo(CapturingPayment),
+            When(StockReservationFailed)
+                .Publish(c => Status(c.Saga, OrderStatus.Cancelled))
+                .Finalize());
+
+        During(CapturingPayment,
+            When(PaymentCaptured)
+                .Publish(c => Status(c.Saga, OrderStatus.Paid))
+                .Send(QueueUri(Queues.ShipOrder), c => new ShipOrder(c.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(PaymentFailed)
+                .Send(QueueUri(Queues.ReleaseStock), c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .Publish(c => Status(c.Saga, OrderStatus.Cancelled))
+                .Finalize(),
+            // Шлюз так и не ответил после всех повторов: снимаем резерв, деньги не списывались.
+            When(CapturePaymentFaulted)
+                .Send(QueueUri(Queues.ReleaseStock), c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .Publish(c => Status(c.Saga, OrderStatus.Cancelled))
+                .Finalize());
+
+        During(Shipping,
+            When(OrderShipped)
+                .Publish(c => Status(c.Saga, OrderStatus.Shipped))
+                .Finalize(),
+            When(ShipOrderFaulted)
+                .Send(QueueUri(Queues.RefundPayment), c => new RefundPayment(c.Saga.CorrelationId, c.Saga.Total))
+                .Send(QueueUri(Queues.ReleaseStock), c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.Lines))
+                .Publish(c => Status(c.Saga, OrderStatus.Cancelled))
+                .Finalize());
+
+        // Повторная публикация OrderSubmitted не должна ни падать, ни запускать процесс заново.
+        // Завершённые процессы намеренно не удаляются из хранилища - они и дают эту защиту.
+        During(Reserving, CapturingPayment, Shipping, Final, Ignore(Submitted));
+    }
+
+    private static Uri QueueUri(string queue) => new($"queue:{queue}");
+
+    private static OrderStatusChanged Status(OrderProcessState s, OrderStatus status) =>
+        new(s.CorrelationId, status, DateTimeOffset.UtcNow);
+}
diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..bf30a1f 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,81 @@
+using Fulfil.Consumers;
+using Fulfil.Contracts;
+using Fulfil.Domain;
 using Fulfil.Options;
+using Fulfil.Process;
+using Fulfil.Storage;
+using Fulfil.Warehouse;
+using MassTransit;
+using MongoDB.Driver;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(fulfil.MongoConnectionString));
+builder.Services.AddSingleton(sp => sp.GetRequiredService<IMongoClient>().GetDatabase(fulfil.MongoDatabase));
+
+builder.Services.AddMassTransit(x =>
+{
+    x.SetKebabCaseEndpointNameFormatter();
+
+    x.AddConsumer<ReserveStockConsumer>().Endpoint(e => e.Name = Queues.ReserveStock);
+    x.AddConsumer<CapturePaymentConsumer, CapturePaymentConsumerDefinition>();
+    x.AddConsumer<ShipOrderConsumer>().Endpoint(e => e.Name = Queues.ShipOrder);
+    x.AddConsumer<ReleaseStockConsumer>().Endpoint(e => e.Name = Queues.ReleaseStock);
+    x.AddConsumer<RefundPaymentConsumer>().Endpoint(e => e.Name = Queues.RefundPayment);
+    x.AddConsumer<OrderStatusChangedConsumer>();
+
+    x.AddSagaStateMachine<OrderProcessStateMachine, OrderProcessState, OrderProcessDefinition>()
+        .MongoDbRepository(r =>
+        {
+            r.Connection = fulfil.MongoConnectionString;
+            r.DatabaseName = fulfil.MongoDatabase;
+            r.CollectionName = "order-processes";
+        });
+
+    // Очереди MassTransit durable, сообщения persistent - переживают перезапуск единственного узла RabbitMQ.
+    x.UsingRabbitMq((context, cfg) =>
+    {
+        cfg.Host(fulfil.RabbitMqHost);
+        cfg.ConfigureEndpoints(context);
+    });
+});
+
+builder.Services.AddHostedService<WarehouseInboundWorker>();
 
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+
+app.MapPost("/orders/{id:guid}/submit", async (
+    Guid id,
+    SubmitOrderRequest request,
+    IMongoDatabase db,
+    IPublishEndpoint publish,
+    CancellationToken ct) =>
+{
+    if (request.Lines is not { Count: > 0 } || request.Lines.Any(l => string.IsNullOrWhiteSpace(l.Sku) || l.Quantity <= 0 || l.UnitPrice < 0))
+        return Results.BadRequest("Заказ должен содержать позиции с положительным количеством.");
+
+    var orders = db.GetCollection<Order>(Collections.Orders);
+    var order = new Order(id, request.CustomerId, OrderStatus.Placed, request.Lines, DateTimeOffset.UtcNow);
+    try
+    {
+        await orders.InsertOneAsync(order, cancellationToken: ct);
+    }
+    catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+    {
+        // Повторный запрос (в том числе после сбоя публикации): берём сохранённый заказ.
+        order = await orders.Find(o => o.Id == id).FirstAsync(ct);
+        if (order.Status != OrderStatus.Placed)
+            return Results.Ok();
+    }
+
+    // Повторная публикация безопасна: процесс игнорирует OrderSubmitted для уже существующего заказа.
+    await publish.Publish(new OrderSubmitted(order.Id, order.CustomerId, order.Lines, order.Total), ct);
+    return Results.Accepted($"/orders/{id}");
+});
+
 app.Run();
+
+public sealed record SubmitOrderRequest(Guid CustomerId, List<OrderLine> Lines);
