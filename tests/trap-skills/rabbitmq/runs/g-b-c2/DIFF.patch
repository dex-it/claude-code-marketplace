+using MassTransit;
+
+namespace Fulfil.Process;
+
+public sealed class OrderProcessDefinition : SagaDefinition<OrderProcessState>
+{
+    protected override void ConfigureSaga(
+        IReceiveEndpointConfigurator endpoint,
+        ISagaConfigurator<OrderProcessState> saga,
+        IRegistrationContext context)
+    {
+        // Реплики равноправны: конкурирующие обновления одного процесса ловятся по Version и повторяются.
+        endpoint.UseMessageRetry(r => r.Intervals(50, 100, 200, 500, 1000));
+        // Команды и события уходят только после успешного сохранения состояния процесса.
+        endpoint.UseInMemoryOutbox(context);
+    }
+}
