+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Storage;
+
+public static class Queues
+{
+    public const string ReserveStock = "reserve-stock";
+    public const string CapturePayment = "capture-payment";
+    public const string ShipOrder = "ship-order";
+    public const string ReleaseStock = "release-stock";
+    public const string RefundPayment = "refund-payment";
+}
+
+public static class Collections
+{
+    public const string Orders = "orders";
+    public const string Products = "products";
+    public const string Payments = "payments";
+    public const string Reservations = "reservations";
+}
+
+// Имена полей документа товара (по умолчанию драйвер называет поля как свойства Domain.Product).
+public static class ProductFields
+{
+    public const string Sku = "Sku";
+    public const string Stock = "Stock";
+    public const string InboundIds = "InboundIds";
+}
+
+// Списанный платёж: защита от повторного списания при повторной доставке команды.
+public sealed class PaymentRecord
+{
+    [BsonId] public Guid OrderId { get; set; }
+    public decimal Amount { get; set; }
+    public DateTimeOffset CapturedAt { get; set; }
+}
+
+// Резерв товара под заказ: защита от повторного резервирования.
+public sealed class ReservationRecord
+{
+    [BsonId] public Guid OrderId { get; set; }
+    public DateTimeOffset ReservedAt { get; set; }
+}
