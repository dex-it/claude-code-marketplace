@@ -0,0 +1,145 @@
+using System.Text.Json;
+using Fulfil.Options;
+using Fulfil.Storage;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+// Приход товара от склада: чужой формат (не MassTransit), поэтому читаем очередь напрямую.
+public sealed class WarehouseInboundWorker(
+    IMongoDatabase db,
+    IOptions<FulfilOptions> options,
+    ILogger<WarehouseInboundWorker> logger) : BackgroundService
+{
+    private const int MaxRememberedMessageIds = 10_000;
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    private readonly FulfilOptions _options = options.Value;
+    private readonly IMongoCollection<BsonDocument> _products = db.GetCollection<BsonDocument>(Collections.Products);
+
+    private enum Applied { Done, Duplicate, UnknownSku }
+
+    private sealed record InboundMessage(string? Sku, int Qty, string? MessageId);
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        // Брокер перезапускается при обновлении стенда: если соединения нет - ждём и пробуем снова.
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                await RunAsync(stoppingToken);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+            {
+                return;
+            }
+            catch (Exception e)
+            {
+                logger.LogError(e, "Потеряна связь с очередью {Queue}, повтор через 5 с", _options.WarehouseInboundQueue);
+                await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+            }
+        }
+    }
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        var factory = new ConnectionFactory
+        {
+            HostName = _options.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+        };
+        await using var connection = await factory.CreateConnectionAsync("fulfil-warehouse", ct);
+
+        // Подтверждения публикуем с publisher confirms, чтобы не потерять их при сбое брокера.
+        await using var publisher = await connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true),
+            ct);
+        await publisher.ExchangeDeclareAsync(_options.WarehouseOutboundExchange, ExchangeType.Topic, durable: true, cancellationToken: ct);
+
+        await using var channel = await connection.CreateChannelAsync(cancellationToken: ct);
+        await channel.QueueDeclareAsync(_options.WarehouseInboundQueue, durable: true, exclusive: false, autoDelete: false, cancellationToken: ct);
+        await channel.BasicQosAsync(0, 20, false, ct);
+
+        var consumer = new AsyncEventingBasicConsumer(channel);
+        consumer.ReceivedAsync += (_, ea) => HandleAsync(channel, publisher, ea, ct);
+        await channel.BasicConsumeAsync(_options.WarehouseInboundQueue, autoAck: false, consumer, ct);
+
+        logger.LogInformation("Читаю очередь {Queue}", _options.WarehouseInboundQueue);
+        await Task.Delay(Timeout.Infinite, ct);
+    }
+
+    private async Task HandleAsync(IChannel channel, IChannel publisher, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        try
+        {
+            InboundMessage? msg = null;
+            try
+            {
+                msg = JsonSerializer.Deserialize<InboundMessage>(ea.Body.Span, Json);
+            }
+            catch (JsonException)
+            {
+            }
+
+            if (msg is not { Sku: { Length: > 0 }, MessageId: { Length: > 0 }, Qty: > 0 })
+            {
+                logger.LogWarning("Некорректное сообщение прихода, отброшено (DeliveryTag {Tag})", ea.DeliveryTag);
+                await channel.BasicRejectAsync(ea.DeliveryTag, requeue: false, ct);
+                return;
+            }
+
+            var applied = await ApplyAsync(msg, ct);
+            if (applied == Applied.UnknownSku)
+            {
+                logger.LogError("Приход по неизвестному товару {Sku}, сообщение {MessageId} отброшено", msg.Sku, msg.MessageId);
+                await channel.BasicRejectAsync(ea.DeliveryTag, requeue: false, ct);
+                return;
+            }
+
+            // Сначала подтверждение складу, потом ack: при сбое между ними сообщение придёт снова,
+            // а повторное применение исключено дедупликацией по messageId.
+            var body = JsonSerializer.SerializeToUtf8Bytes(
+                new { messageId = msg.MessageId, sku = msg.Sku, qty = msg.Qty, status = applied == Applied.Done ? "applied" : "duplicate" },
+                Json);
+            await publisher.BasicPublishAsync(
+                _options.WarehouseOutboundExchange,
+                "stock.received",
+                mandatory: false,
+                new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = msg.MessageId },
+                body,
+                ct);
+
+            await channel.BasicAckAsync(ea.DeliveryTag, multiple: false, ct);
+        }
+        catch (Exception e) when (!ct.IsCancellationRequested)
+        {
+            logger.LogError(e, "Сбой обработки прихода (DeliveryTag {Tag}), вернул в очередь", ea.DeliveryTag);
+            await Task.Delay(TimeSpan.FromSeconds(1), CancellationToken.None);
+            await channel.BasicNackAsync(ea.DeliveryTag, multiple: false, requeue: true, CancellationToken.None);
+        }
+    }
+
+    // Одна атомарная операция: остаток растёт, только если messageId ещё не применялся.
+    private async Task<Applied> ApplyAsync(InboundMessage msg, CancellationToken ct)
+    {
+        var f = Builders<BsonDocument>.Filter;
+        var result = await _products.UpdateOneAsync(
+            f.Eq(ProductFields.Sku, msg.Sku) & f.Ne(ProductFields.InboundIds, msg.MessageId),
+            Builders<BsonDocument>.Update
+                .Inc(ProductFields.Stock, msg.Qty)
+                .PushEach(ProductFields.InboundIds, [msg.MessageId], slice: -MaxRememberedMessageIds),
+            cancellationToken: ct);
+
+        if (result.ModifiedCount == 1)
+            return Applied.Done;
+
+        var exists = await _products.Find(f.Eq(ProductFields.Sku, msg.Sku)).AnyAsync(ct);
+        return exists ? Applied.Duplicate : Applied.UnknownSku;
+    }
+}
