+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Ports;
+using Fulfil.Storage;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+// Интеграции с перевозчиком в задаче нет: отгрузка фиксируется как выполненный шаг.
+public sealed class ShipOrderConsumer : IConsumer<ShipOrder>
+{
+    public Task Consume(ConsumeContext<ShipOrder> context) =>
+        context.Publish(new OrderShipped(context.Message.OrderId), context.CancellationToken);
+}
+
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var m = context.Message;
+        var ct = context.CancellationToken;
+        var payments = db.GetCollection<PaymentRecord>(Collections.Payments);
+
+        // Возвращаем только реально списанное и только один раз.
+        if (!await payments.Find(p => p.OrderId == m.OrderId).AnyAsync(ct))
+            return;
+
+        await gateway.RefundAsync(m.OrderId, m.Amount, ct);
+        await payments.DeleteOneAsync(p => p.OrderId == m.OrderId, ct);
+    }
+}
+
+// Проекция статуса процесса в коллекцию orders.
+public sealed class OrderStatusChangedConsumer(IMongoDatabase db) : IConsumer<OrderStatusChanged>
+{
+    public Task Consume(ConsumeContext<OrderStatusChanged> context) =>
+        db.GetCollection<Order>(Collections.Orders).UpdateOneAsync(
+            o => o.Id == context.Message.OrderId,
+            Builders<Order>.Update.Set(o => o.Status, context.Message.Status),
+            cancellationToken: context.CancellationToken);
+}
