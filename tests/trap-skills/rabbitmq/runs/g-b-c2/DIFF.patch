@@ -0,0 +1,68 @@
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Fulfil.Ports;
+using Fulfil.Storage;
+using MassTransit;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var m = context.Message;
+        var ct = context.CancellationToken;
+        var payments = db.GetCollection<PaymentRecord>(Collections.Payments);
+
+        // Повторная доставка: деньги уже списаны, только сообщаем процессу.
+        if (await payments.Find(p => p.OrderId == m.OrderId).AnyAsync(ct))
+        {
+            await context.Publish(new PaymentCaptured(m.OrderId), ct);
+            return;
+        }
+
+        try
+        {
+            await gateway.ChargeAsync(m.OrderId, m.Amount, ct);
+        }
+        catch (PaymentDeclinedException e)
+        {
+            await context.Publish(new PaymentFailed(m.OrderId, e.Message), ct);
+            return;
+        }
+        // Сбой шлюза пробрасывается: ретрай эндпоинта, затем Fault<CapturePayment> для процесса.
+
+        await payments.ReplaceOneAsync(
+            p => p.OrderId == m.OrderId,
+            new PaymentRecord { OrderId = m.OrderId, Amount = m.Amount, CapturedAt = DateTimeOffset.UtcNow },
+            new ReplaceOptions { IsUpsert = true },
+            ct);
+        await context.Publish(new PaymentCaptured(m.OrderId), ct);
+    }
+}
+
+public sealed class CapturePaymentConsumerDefinition : ConsumerDefinition<CapturePaymentConsumer>
+{
+    private readonly int _concurrency;
+
+    public CapturePaymentConsumerDefinition(IOptions<FulfilOptions> options)
+    {
+        EndpointName = Queues.CapturePayment;
+        _concurrency = options.Value.PaymentConcurrency;
+        ConcurrentMessageLimit = _concurrency;
+    }
+
+    protected override void ConfigureConsumer(
+        IReceiveEndpointConfigurator endpoint,
+        IConsumerConfigurator<CapturePaymentConsumer> consumer,
+        IRegistrationContext context)
+    {
+        // Шлюз отвечает 0.3-2 с: 10 тыс/мин (~170/с) требуют сотен параллельных вызовов на все реплики.
+        if (endpoint is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.PrefetchCount = _concurrency * 2;
+
+        endpoint.UseMessageRetry(r => r.Exponential(5, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(2)));
+    }
+}
