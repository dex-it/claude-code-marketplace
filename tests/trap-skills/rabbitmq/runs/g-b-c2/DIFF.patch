@@ -0,0 +1,72 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Storage;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed class ReserveStockConsumer(IMongoDatabase db) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var m = context.Message;
+        var ct = context.CancellationToken;
+        var reservations = db.GetCollection<ReservationRecord>(Collections.Reservations);
+
+        if (await reservations.Find(r => r.OrderId == m.OrderId).AnyAsync(ct))
+        {
+            await context.Publish(new StockReserved(m.OrderId), ct);
+            return;
+        }
+
+        var products = db.GetCollection<BsonDocument>(Collections.Products);
+        var taken = new List<OrderLine>();
+        foreach (var line in m.Lines)
+        {
+            // Условное атомарное списание: остаток не уходит в минус.
+            var result = await products.UpdateOneAsync(
+                Builders<BsonDocument>.Filter.Eq(ProductFields.Sku, line.Sku)
+                & Builders<BsonDocument>.Filter.Gte(ProductFields.Stock, line.Quantity),
+                Builders<BsonDocument>.Update.Inc(ProductFields.Stock, -line.Quantity),
+                cancellationToken: ct);
+
+            if (result.ModifiedCount == 1)
+            {
+                taken.Add(line);
+                continue;
+            }
+
+            await ReturnAsync(products, taken, ct);
+            await context.Publish(new StockReservationFailed(m.OrderId, $"Недостаточно товара {line.Sku}"), ct);
+            return;
+        }
+
+        await reservations.InsertOneAsync(
+            new ReservationRecord { OrderId = m.OrderId, ReservedAt = DateTimeOffset.UtcNow }, cancellationToken: ct);
+        await context.Publish(new StockReserved(m.OrderId), ct);
+    }
+
+    internal static Task ReturnAsync(IMongoCollection<BsonDocument> products, IEnumerable<OrderLine> lines, CancellationToken ct) =>
+        Task.WhenAll(lines.Select(l => products.UpdateOneAsync(
+            Builders<BsonDocument>.Filter.Eq(ProductFields.Sku, l.Sku),
+            Builders<BsonDocument>.Update.Inc(ProductFields.Stock, l.Quantity),
+            cancellationToken: ct)));
+}
+
+public sealed class ReleaseStockConsumer(IMongoDatabase db) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var ct = context.CancellationToken;
+        var reservations = db.GetCollection<ReservationRecord>(Collections.Reservations);
+
+        // Удаление резерва - маркер идемпотентности: возвращаем остаток только один раз.
+        var deleted = await reservations.DeleteOneAsync(r => r.OrderId == context.Message.OrderId, ct);
+        if (deleted.DeletedCount == 0)
+            return;
+
+        await ReserveStockConsumer.ReturnAsync(db.GetCollection<BsonDocument>(Collections.Products), context.Message.Lines, ct);
+    }
+}
