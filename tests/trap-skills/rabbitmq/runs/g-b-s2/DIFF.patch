+namespace Fulfil.Contracts;
+
+// Старт процесса исполнения заказа.
+public sealed record OrderSubmitted(Guid OrderId, Guid CustomerId, IReadOnlyList<Domain.OrderLine> Lines, decimal Amount, DateTimeOffset SubmittedAt);
