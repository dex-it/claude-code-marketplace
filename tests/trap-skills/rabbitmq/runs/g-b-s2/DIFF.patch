+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public static class OrderStatusUpdater
+{
+    public static Task SetAsync(IMongoDatabase db, Guid orderId, OrderStatus status, CancellationToken ct) =>
+        db.GetCollection<Order>("orders").UpdateOneAsync(o => o.Id == orderId,
+            Builders<Order>.Update.Set(o => o.Status, status), cancellationToken: ct);
+}
+
+// Интеграции с перевозчиком в задаче нет: шаг фиксирует отгрузку в заказе.
+public sealed class ShipOrderConsumer(IMongoDatabase db) : IConsumer<ShipOrder>
+{
+    public async Task Consume(ConsumeContext<ShipOrder> context)
+    {
+        await OrderStatusUpdater.SetAsync(db, context.Message.OrderId, OrderStatus.Shipped, context.CancellationToken);
+        await context.Publish(new OrderShipped(context.Message.OrderId), context.CancellationToken);
+    }
+}
+
+public sealed class CancelOrderConsumer(IMongoDatabase db) : IConsumer<CancelOrder>
+{
+    public Task Consume(ConsumeContext<CancelOrder> context) =>
+        OrderStatusUpdater.SetAsync(db, context.Message.OrderId, OrderStatus.Cancelled, context.CancellationToken);
+}
diff --git a/src/Fulfil/Consumers/PaymentConsumers.cs b/src/Fulfil/Consumers/PaymentConsumers.cs
new file mode 100644
index 0000000..bf53729
--- /dev/null
+++ b/src/Fulfil/Consumers/PaymentConsumers.cs
@@ -0,0 +1,61 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed record PaymentRecord(Guid Id, decimal Amount, string Status);
+
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var m = context.Message;
+        var ct = context.CancellationToken;
+        var payments = db.GetCollection<PaymentRecord>("payments");
+
+        // Повторная доставка не должна списать деньги второй раз: исход фиксируется по заказу.
+        // Шлюз получает orderId как ключ; окно между списанием и записью закрывает только
+        // идемпотентность шлюза по orderId.
+        var existing = await payments.Find(p => p.Id == m.OrderId).FirstOrDefaultAsync(ct);
+        if (existing is null)
+        {
+            try
+            {
+                await gateway.ChargeAsync(m.OrderId, m.Amount, ct);
+            }
+            catch (PaymentDeclinedException ex)
+            {
+                await context.Publish(new PaymentFailed(m.OrderId, ex.Message), ct);
+                return;
+            }
+
+            await payments.ReplaceOneAsync(p => p.Id == m.OrderId,
+                new PaymentRecord(m.OrderId, m.Amount, "Captured"),
+                new ReplaceOptions { IsUpsert = true }, ct);
+        }
+
+        await OrderStatusUpdater.SetAsync(db, m.OrderId, OrderStatus.Paid, ct);
+        await context.Publish(new PaymentCaptured(m.OrderId), ct);
+    }
+}
+
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var m = context.Message;
+        var ct = context.CancellationToken;
+        var payments = db.GetCollection<PaymentRecord>("payments");
+
+        var existing = await payments.Find(p => p.Id == m.OrderId).FirstOrDefaultAsync(ct);
+        if (existing is null || existing.Status != "Captured")
+            return; // списания не было или возврат уже сделан
+
+        await gateway.RefundAsync(m.OrderId, m.Amount, ct);
+        await payments.UpdateOneAsync(p => p.Id == m.OrderId,
+            Builders<PaymentRecord>.Update.Set(p => p.Status, "Refunded"), cancellationToken: ct);
+    }
+}
diff --git a/src/Fulfil/Consumers/StockConsumers.cs b/src/Fulfil/Consumers/StockConsumers.cs
new file mode 100644
index 0000000..0dd9a34
--- /dev/null
+++ b/src/Fulfil/Consumers/StockConsumers.cs
@@ -0,0 +1,82 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed record StockReservation(Guid Id, IReadOnlyList<OrderLine> Lines, string Status);
+
+sealed class StockShortageException(string sku) : Exception($"Недостаточно товара {sku}");
+
+// Резерв и его освобождение - транзакции MongoDB с записью по заказу: повторная доставка
+// не уменьшает и не возвращает остаток второй раз.
+public sealed class ReserveStockConsumer(IMongoClient client, IMongoDatabase db) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var m = context.Message;
+        var ct = context.CancellationToken;
+        var reservations = db.GetCollection<StockReservation>("stock_reservations");
+        var products = db.GetCollection<BsonDocument>("products");
+
+        using var session = await client.StartSessionAsync(cancellationToken: ct);
+        try
+        {
+            await session.WithTransactionAsync(async (s, token) =>
+            {
+                var exists = await reservations.Find(s, r => r.Id == m.OrderId).AnyAsync(token);
+                if (exists)
+                    return true;
+
+                foreach (var line in m.Lines)
+                {
+                    var result = await products.UpdateOneAsync(s,
+                        Builders<BsonDocument>.Filter.Eq("sku", line.Sku) & Builders<BsonDocument>.Filter.Gte("stock", line.Quantity),
+                        Builders<BsonDocument>.Update.Inc("stock", -line.Quantity),
+                        cancellationToken: token);
+                    if (result.ModifiedCount == 0)
+                        throw new StockShortageException(line.Sku);
+                }
+
+                await reservations.InsertOneAsync(s, new StockReservation(m.OrderId, m.Lines, "Reserved"), cancellationToken: token);
+                return true;
+            }, cancellationToken: ct);
+        }
+        catch (StockShortageException ex)
+        {
+            await context.Publish(new StockReservationFailed(m.OrderId, ex.Message), ct);
+            return;
+        }
+
+        await context.Publish(new StockReserved(m.OrderId), ct);
+    }
+}
+
+public sealed class ReleaseStockConsumer(IMongoClient client, IMongoDatabase db) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var orderId = context.Message.OrderId;
+        var ct = context.CancellationToken;
+        var reservations = db.GetCollection<StockReservation>("stock_reservations");
+        var products = db.GetCollection<BsonDocument>("products");
+
+        using var session = await client.StartSessionAsync(cancellationToken: ct);
+        await session.WithTransactionAsync(async (s, token) =>
+        {
+            var reservation = await reservations.Find(s, r => r.Id == orderId && r.Status == "Reserved").FirstOrDefaultAsync(token);
+            if (reservation is null)
+                return true;
+
+            foreach (var line in reservation.Lines)
+                await products.UpdateOneAsync(s, Builders<BsonDocument>.Filter.Eq("sku", line.Sku),
+                    Builders<BsonDocument>.Update.Inc("stock", line.Quantity), cancellationToken: token);
+
+            await reservations.UpdateOneAsync(s, r => r.Id == orderId,
+                Builders<StockReservation>.Update.Set(r => r.Status, "Released"), cancellationToken: token);
+            return true;
+        }, cancellationToken: ct);
+    }
+}
