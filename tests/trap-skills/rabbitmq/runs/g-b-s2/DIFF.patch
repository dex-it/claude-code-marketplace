@@ -0,0 +1,47 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MassTransit.MongoDbIntegration;
+using MongoDB.Driver;
+
+namespace Fulfil.Orders;
+
+public sealed record SubmitOrderRequest(Guid CustomerId, IReadOnlyList<OrderLine> Lines);
+
+public static class OrderEndpoints
+{
+    public static IEndpointRouteBuilder MapOrders(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/orders/{id:guid}/submit", async (Guid id, SubmitOrderRequest request, IMongoDatabase db,
+            MongoDbContext dbContext, IPublishEndpoint publish, CancellationToken ct) =>
+        {
+            if (request.Lines is not { Count: > 0 } || request.Lines.Any(l => l.Quantity <= 0))
+                return Results.BadRequest("Заказ должен содержать позиции с положительным количеством");
+
+            var now = DateTimeOffset.UtcNow;
+            var order = new Order(id, request.CustomerId, OrderStatus.Placed, request.Lines, now);
+
+            // Заказ и OrderSubmitted фиксируются одной транзакцией: событие уходит в брокер из outbox.
+            await dbContext.BeginTransaction(ct);
+            try
+            {
+                await db.GetCollection<Order>("orders").InsertOneAsync(dbContext.Session, order, cancellationToken: ct);
+                await publish.Publish(new OrderSubmitted(id, order.CustomerId, order.Lines, order.Total, now), ct);
+                await dbContext.CommitTransaction(ct);
+            }
+            catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
+            {
+                await dbContext.AbortTransaction(ct);
+                return Results.Conflict("Заказ уже отправлен");
+            }
+            catch
+            {
+                await dbContext.AbortTransaction(ct);
+                throw;
+            }
+
+            return Results.Accepted($"/orders/{id}");
+        });
+        return app;
+    }
+}
