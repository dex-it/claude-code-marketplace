diff --git a/src/Fulfil/Saga/OrderFulfilmentStateMachine.cs b/src/Fulfil/Saga/OrderFulfilmentStateMachine.cs
new file mode 100644
index 0000000..6069228
--- /dev/null
+++ b/src/Fulfil/Saga/OrderFulfilmentStateMachine.cs
@@ -0,0 +1,86 @@
+using Fulfil.Contracts;
+using Fulfil.Messaging;
+using MassTransit;
+
+namespace Fulfil.Saga;
+
+// Резерв -> списание -> отгрузка. Сбой шага откатывает выполненные до него шаги.
+public sealed class OrderFulfilmentStateMachine : MassTransitStateMachine<OrderFulfilmentState>
+{
+    public State Reserving { get; private set; } = null!;
+    public State Charging { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> StockReservedEvent { get; private set; } = null!;
+    public Event<StockReservationFailed> StockReservationFailedEvent { get; private set; } = null!;
+    public Event<PaymentCaptured> PaymentCapturedEvent { get; private set; } = null!;
+    public Event<PaymentFailed> PaymentFailedEvent { get; private set; } = null!;
+    public Event<OrderShipped> OrderShippedEvent { get; private set; } = null!;
+    public Event<Fault<ReserveStock>> ReserveStockFaulted { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CapturePaymentFaulted { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipOrderFaulted { get; private set; } = null!;
+
+    public OrderFulfilmentStateMachine()
+    {
+        InstanceState(x => x.CurrentState);
+
+        Event(() => Submitted, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => StockReservedEvent, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => StockReservationFailedEvent, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => PaymentCapturedEvent, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => PaymentFailedEvent, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => OrderShippedEvent, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ReserveStockFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => CapturePaymentFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => ShipOrderFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(c =>
+                {
+                    c.Saga.Amount = c.Message.Amount;
+                    c.Saga.SubmittedAt = c.Message.SubmittedAt;
+                })
+                .Send(Queues.ReserveStockUri, c => new ReserveStock(c.Message.OrderId, c.Message.Lines))
+                .TransitionTo(Reserving));
+
+        During(Reserving,
+            When(StockReservedEvent)
+                .Send(Queues.CapturePaymentUri, c => new CapturePayment(c.Saga.CorrelationId, c.Saga.Amount))
+                .TransitionTo(Charging),
+            // Резерв - одна транзакция: при отказе или сбое освобождать нечего.
+            When(StockReservationFailedEvent)
+                .Send(Queues.CancelOrderUri, c => new CancelOrder(c.Saga.CorrelationId))
+                .Finalize(),
+            When(ReserveStockFaulted)
+                .Send(Queues.CancelOrderUri, c => new CancelOrder(c.Saga.CorrelationId))
+                .Finalize());
+
+        During(Charging,
+            When(PaymentCapturedEvent)
+                .Send(Queues.ShipOrderUri, c => new ShipOrder(c.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(PaymentFailedEvent).ReleaseAndCancel(),
+            When(CapturePaymentFaulted).ReleaseAndCancel());
+
+        During(Shipping,
+            When(OrderShippedEvent).Finalize(),
+            When(ShipOrderFaulted)
+                .Send(Queues.RefundPaymentUri, c => new RefundPayment(c.Saga.CorrelationId, c.Saga.Amount))
+                .ReleaseAndCancel());
+
+        // Повторная доставка уже учтённого события не должна уходить в _error.
+        OnUnhandledEvent(x => x.Ignore());
+    }
+}
+
+static class OrderFulfilmentCompensation
+{
+    public static EventActivityBinder<OrderFulfilmentState, T> ReleaseAndCancel<T>(
+        this EventActivityBinder<OrderFulfilmentState, T> binder) where T : class =>
+        binder
+            .Send(Queues.ReleaseStockUri, c => new ReleaseStock(c.Saga.CorrelationId))
+            .Send(Queues.CancelOrderUri, c => new CancelOrder(c.Saga.CorrelationId))
+            .Finalize();
+}
