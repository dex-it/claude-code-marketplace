diff --git a/src/Fulfil/Messaging/MessagingSetup.cs b/src/Fulfil/Messaging/MessagingSetup.cs
new file mode 100644
index 0000000..8ac3686
--- /dev/null
+++ b/src/Fulfil/Messaging/MessagingSetup.cs
@@ -0,0 +1,58 @@
+using Fulfil.Consumers;
+using Fulfil.Options;
+using Fulfil.Saga;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Messaging;
+
+public static class MessagingSetup
+{
+    public static IServiceCollection AddFulfilMessaging(this IServiceCollection services, FulfilOptions options)
+    {
+        services.AddMassTransit(x =>
+        {
+            // 10 тыс. команд в минуту при ответе шлюза до 2 с: порядка 330 платежей одновременно
+            // на все реплики (3 реплики по 128). Prefetch ограничен, чтобы backlog не оседал в памяти пода.
+            x.AddConsumer<CapturePaymentConsumer>().Endpoint(e =>
+            {
+                e.Name = Queues.CapturePayment;
+                e.PrefetchCount = 256;
+                e.ConcurrentMessageLimit = 128;
+            });
+            x.AddConsumer<ReserveStockConsumer>().Endpoint(e => e.Name = Queues.ReserveStock);
+            x.AddConsumer<ReleaseStockConsumer>().Endpoint(e => e.Name = Queues.ReleaseStock);
+            x.AddConsumer<ShipOrderConsumer>().Endpoint(e => e.Name = Queues.ShipOrder);
+            x.AddConsumer<RefundPaymentConsumer>().Endpoint(e => e.Name = Queues.RefundPayment);
+            x.AddConsumer<CancelOrderConsumer>().Endpoint(e => e.Name = Queues.CancelOrder);
+
+            x.AddSagaStateMachine<OrderFulfilmentStateMachine, OrderFulfilmentState>()
+                .Endpoint(e => e.PrefetchCount = 64)
+                .MongoDbRepository(r =>
+                {
+                    r.Connection = options.MongoConnectionString;
+                    r.DatabaseName = options.MongoDatabase;
+                    r.CollectionName = "order-sagas";
+                });
+
+            // Исходящие сообщения пишутся в MongoDB в одной транзакции с данными и уходят в брокер
+            // отдельным процессом; на консьюмерах inbox отсекает повторную доставку.
+            x.AddMongoDbOutbox(o =>
+            {
+                o.QueryDelay = TimeSpan.FromSeconds(1);
+                o.ClientFactory(p => p.GetRequiredService<IMongoClient>());
+                o.DatabaseFactory(p => p.GetRequiredService<IMongoDatabase>());
+                o.UseBusOutbox();
+            });
+
+            x.UsingRabbitMq((ctx, cfg) =>
+            {
+                cfg.Host(options.RabbitMqHost, "/", _ => { });
+                cfg.PrefetchCount = 32;
+                cfg.UseMessageRetry(r => r.Exponential(5, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(2)));
+                cfg.ConfigureEndpoints(ctx);
+            });
+        });
+        return services;
+    }
+}
