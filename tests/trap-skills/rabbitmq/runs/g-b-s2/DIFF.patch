@@ -0,0 +1,162 @@
+using System.Text.Json;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+public sealed record InboundStock(string? Sku, int Qty, string? MessageId);
+
+sealed class UnknownSkuException(string sku) : Exception($"Неизвестный товар {sku}");
+
+// Прямой консьюмер чужой очереди warehouse.inbound (не MassTransit).
+public sealed class WarehouseInboundService(
+    IOptions<FulfilOptions> options, IMongoClient client, IMongoDatabase db, ILogger<WarehouseInboundService> log)
+    : BackgroundService
+{
+    const string InboundQueue = "warehouse.inbound";
+    const string OutboundExchange = "warehouse.outbound";
+    static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    readonly FulfilOptions _options = options.Value;
+
+    protected override async Task ExecuteAsync(CancellationToken ct)
+    {
+        // Брокер может быть недоступен при старте (перезапуск стенда); после установления
+        // соединения его переподключение берёт на себя клиент.
+        while (!ct.IsCancellationRequested)
+        {
+            try
+            {
+                await RunAsync(ct);
+                return;
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested)
+            {
+                return;
+            }
+            catch (Exception ex)
+            {
+                log.LogError(ex, "Подключение к {Queue} не удалось, повтор через 5 с", InboundQueue);
+                await Task.Delay(TimeSpan.FromSeconds(5), ct);
+            }
+        }
+    }
+
+    async Task RunAsync(CancellationToken ct)
+    {
+        var factory = new ConnectionFactory
+        {
+            HostName = _options.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+            ConsumerDispatchConcurrency = 4,
+        };
+        await using var connection = await factory.CreateConnectionAsync("fulfil-warehouse", ct);
+        await using var consumeChannel = await connection.CreateChannelAsync(cancellationToken: ct);
+        // Подтверждения брокера: ack входящего сообщения только после того, как брокер принял ответ.
+        await using var publishChannel = await connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true), ct);
+
+        // Не более 32 неподтверждённых сообщений на реплику: backlog остаётся в очереди, а не в памяти.
+        await consumeChannel.BasicQosAsync(0, 32, false, ct);
+
+        var consumer = new AsyncEventingBasicConsumer(consumeChannel);
+        consumer.ReceivedAsync += (_, ea) => HandleAsync(consumeChannel, publishChannel, ea, ct);
+        await consumeChannel.BasicConsumeAsync(InboundQueue, autoAck: false, consumer, ct);
+        log.LogInformation("Читаю очередь {Queue}", InboundQueue);
+
+        await Task.Delay(Timeout.Infinite, ct);
+    }
+
+    async Task HandleAsync(IChannel consumeChannel, IChannel publishChannel, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        var tag = ea.DeliveryTag;
+        try
+        {
+            var message = Parse(ea.Body.Span);
+            if (message is null)
+            {
+                // Битое сообщение повторной доставкой не лечится: без requeue (в DLX, если он настроен).
+                log.LogWarning("Сообщение {Tag} в {Queue} не разобрано, отклонено", tag, InboundQueue);
+                await consumeChannel.BasicNackAsync(tag, false, false, ct);
+                return;
+            }
+
+            await ApplyAsync(message, ct);
+            // Подтверждение отправляется и для дубликата: прошлая попытка могла упасть до публикации.
+            await PublishConfirmationAsync(publishChannel, message, ct);
+            await consumeChannel.BasicAckAsync(tag, false, ct);
+        }
+        catch (UnknownSkuException ex)
+        {
+            log.LogWarning(ex, "Сообщение {Tag} отклонено", tag);
+            await consumeChannel.BasicNackAsync(tag, false, false, ct);
+        }
+        catch (Exception ex) when (!ct.IsCancellationRequested)
+        {
+            log.LogError(ex, "Сообщение {Tag} не обработано, вернётся в очередь", tag);
+            await Task.Delay(TimeSpan.FromSeconds(1), ct);
+            await consumeChannel.BasicNackAsync(tag, false, true, ct);
+        }
+    }
+
+    static InboundStock? Parse(ReadOnlySpan<byte> body)
+    {
+        try
+        {
+            var m = JsonSerializer.Deserialize<InboundStock>(body, Json);
+            return m is { Sku.Length: > 0, MessageId.Length: > 0, Qty: > 0 } ? m : null;
+        }
+        catch (JsonException)
+        {
+            return null;
+        }
+    }
+
+    // Запись о messageId и приращение остатка - одна транзакция: повторная доставка
+    // того же сообщения не увеличит остаток второй раз.
+    async Task ApplyAsync(InboundStock message, CancellationToken ct)
+    {
+        var inbox = db.GetCollection<BsonDocument>("warehouse_inbox");
+        var products = db.GetCollection<BsonDocument>("products");
+
+        using var session = await client.StartSessionAsync(cancellationToken: ct);
+        await session.WithTransactionAsync(async (s, token) =>
+        {
+            var processed = await inbox.Find(s, Builders<BsonDocument>.Filter.Eq("_id", message.MessageId)).AnyAsync(token);
+            if (processed)
+                return true;
+
+            var result = await products.UpdateOneAsync(s,
+                Builders<BsonDocument>.Filter.Eq("sku", message.Sku),
+                Builders<BsonDocument>.Update.Inc("stock", message.Qty), cancellationToken: token);
+            if (result.MatchedCount == 0)
+                throw new UnknownSkuException(message.Sku!);
+
+            await inbox.InsertOneAsync(s, new BsonDocument
+            {
+                { "_id", message.MessageId },
+                { "sku", message.Sku },
+                { "qty", message.Qty },
+                { "at", DateTime.UtcNow },
+            }, cancellationToken: token);
+            return true;
+        }, cancellationToken: ct);
+    }
+
+    static async Task PublishConfirmationAsync(IChannel channel, InboundStock message, CancellationToken ct)
+    {
+        var body = JsonSerializer.SerializeToUtf8Bytes(new { message.MessageId, message.Sku, message.Qty, status = "applied" }, Json);
+        var props = new BasicProperties
+        {
+            ContentType = "application/json",
+            DeliveryMode = DeliveryModes.Persistent,
+            MessageId = message.MessageId,
+        };
+        await channel.BasicPublishAsync(OutboundExchange, string.Empty, false, props, body, ct);
+    }
+}
