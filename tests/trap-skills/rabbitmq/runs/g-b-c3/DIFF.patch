+using MassTransit;
+
+namespace Fulfil.Saga;
+
+public sealed class OrderStateDefinition : SagaDefinition<OrderState>
+{
+    public OrderStateDefinition()
+    {
+        EndpointName = "order-state";
+    }
+
+    protected override void ConfigureSaga(
+        IReceiveEndpointConfigurator endpointConfigurator,
+        ISagaConfigurator<OrderState> sagaConfigurator,
+        IRegistrationContext context)
+    {
+        if (endpointConfigurator is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.SetQuorumQueue();
+
+        // Конфликт версий при конкурентной обработке событий одного заказа разными репликами лечится повтором.
+        endpointConfigurator.UseMessageRetry(r => r.Intervals(50, 100, 250, 500, 1000));
+        endpointConfigurator.UseInMemoryOutbox(context);
+    }
+}
diff --git a/src/Fulfil/Saga/OrderStateMachine.cs b/src/Fulfil/Saga/OrderStateMachine.cs
new file mode 100644
index 0000000..9e8b165
--- /dev/null
+++ b/src/Fulfil/Saga/OrderStateMachine.cs
@@ -0,0 +1,97 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+
+namespace Fulfil.Saga;
+
+// Резерв товара -> списание денег -> отгрузка. Неудача шага запускает компенсации и отмену.
+// Завершённые экземпляры не удаляются: повторный OrderSubmitted не должен запускать процесс заново.
+public sealed class OrderStateMachine : MassTransitStateMachine<OrderState>
+{
+    public State ReservingStock { get; private set; } = null!;
+    public State CapturingPayment { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+    public State Completed { get; private set; } = null!;
+    public State Cancelled { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> Reserved { get; private set; } = null!;
+    public Event<StockReservationFailed> ReserveFailed { get; private set; } = null!;
+    public Event<PaymentCaptured> Captured { get; private set; } = null!;
+    public Event<PaymentDeclined> Declined { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CaptureFaulted { get; private set; } = null!;
+    public Event<OrderShipped> Shipped { get; private set; } = null!;
+    public Event<ShipmentFailed> ShipFailed { get; private set; } = null!;
+
+    public OrderStateMachine()
+    {
+        InstanceState(x => x.CurrentState);
+
+        Event(() => Submitted, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => Reserved, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => ReserveFailed, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => Captured, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => Declined, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => CaptureFaulted, e => e.CorrelateById(m => m.Message.Message.OrderId));
+        Event(() => Shipped, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => ShipFailed, e => e.CorrelateById(m => m.Message.OrderId));
+
+        // Дубликаты и запоздавшие события не должны ронять обработку.
+        OnUnhandledEvent(x => x.Ignore());
+
+        Initially(
+            When(Submitted)
+                .Then(ctx => ctx.Saga.Total = ctx.Message.Total)
+                .Send(Address(Queues.ReserveStock), ctx => new ReserveStock(ctx.Message.OrderId, ctx.Message.Lines))
+                .TransitionTo(ReservingStock));
+
+        During(ReservingStock,
+            When(Reserved)
+                .Send(Address(Queues.CapturePayment), ctx => new CapturePayment(ctx.Saga.CorrelationId, ctx.Saga.Total))
+                .TransitionTo(CapturingPayment),
+            When(ReserveFailed)
+                .Then(ctx => ctx.Saga.FailureReason = ctx.Message.Reason)
+                .PublishStatus(OrderStatus.Cancelled)
+                .TransitionTo(Cancelled));
+
+        During(CapturingPayment,
+            When(Captured)
+                .PublishStatus(OrderStatus.Paid)
+                .Send(Address(Queues.ShipOrder), ctx => new ShipOrder(ctx.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(Declined)
+                .Then(ctx => ctx.Saga.FailureReason = ctx.Message.Reason)
+                .Send(Address(Queues.ReleaseStock), ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .PublishStatus(OrderStatus.Cancelled)
+                .TransitionTo(Cancelled),
+            // Шлюз не ответил после всех повторов: считаем платёж не прошедшим.
+            // Если списание всё же было, RefundPayment вернёт деньги по записи о платеже.
+            When(CaptureFaulted)
+                .Then(ctx => ctx.Saga.FailureReason = "Платёжный шлюз недоступен")
+                .Send(Address(Queues.RefundPayment), ctx => new RefundPayment(ctx.Saga.CorrelationId, ctx.Saga.Total))
+                .Send(Address(Queues.ReleaseStock), ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .PublishStatus(OrderStatus.Cancelled)
+                .TransitionTo(Cancelled));
+
+        During(Shipping,
+            When(Shipped)
+                .PublishStatus(OrderStatus.Shipped)
+                .TransitionTo(Completed),
+            When(ShipFailed)
+                .Then(ctx => ctx.Saga.FailureReason = ctx.Message.Reason)
+                .Send(Address(Queues.RefundPayment), ctx => new RefundPayment(ctx.Saga.CorrelationId, ctx.Saga.Total))
+                .Send(Address(Queues.ReleaseStock), ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .PublishStatus(OrderStatus.Cancelled)
+                .TransitionTo(Cancelled));
+    }
+
+    private static Uri Address(string queue) => new($"queue:{queue}");
+}
+
+internal static class OrderStateMachineExtensions
+{
+    public static EventActivityBinder<OrderState, T> PublishStatus<T>(this EventActivityBinder<OrderState, T> binder, OrderStatus status)
+        where T : class =>
+        binder.PublishAsync(ctx => ctx.Init<OrderStatusChanged>(
+            new OrderStatusChanged(ctx.Saga.CorrelationId, status, DateTimeOffset.UtcNow)));
+}
