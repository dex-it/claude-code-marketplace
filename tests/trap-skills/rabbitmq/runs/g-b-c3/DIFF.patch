+namespace Fulfil.Contracts;
+
+// Событие, запускающее процесс исполнения заказа.
+public sealed record OrderSubmitted(Guid OrderId, Guid CustomerId, IReadOnlyList<Domain.OrderLine> Lines, decimal Total, DateTimeOffset SubmittedAt);
+
+// Команды шагов процесса.
+public sealed record ReserveStock(Guid OrderId, IReadOnlyList<Domain.OrderLine> Lines);
+public sealed record CapturePayment(Guid OrderId, decimal Amount);
+public sealed record ShipOrder(Guid OrderId);
+
+// Компенсации.
+public sealed record ReleaseStock(Guid OrderId);
+public sealed record RefundPayment(Guid OrderId, decimal Amount);
+
+// Результаты шагов.
+public sealed record StockReserved(Guid OrderId);
+public sealed record StockReservationFailed(Guid OrderId, string Reason);
+public sealed record PaymentCaptured(Guid OrderId);
+public sealed record PaymentDeclined(Guid OrderId, string Reason);
+public sealed record OrderShipped(Guid OrderId);
+public sealed record ShipmentFailed(Guid OrderId, string Reason);
+
+public static class Queues
+{
+    public const string ReserveStock = "reserve-stock";
+    public const string ReleaseStock = "release-stock";
+    public const string CapturePayment = "capture-payment";
+    public const string RefundPayment = "refund-payment";
+    public const string ShipOrder = "ship-order";
+}
diff --git a/src/Fulfil/Endpoints/OrderEndpoints.cs b/src/Fulfil/Endpoints/OrderEndpoints.cs
new file mode 100644
index 0000000..21d2316
--- /dev/null
+++ b/src/Fulfil/Endpoints/OrderEndpoints.cs
@@ -0,0 +1,61 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Endpoints;
+
+public sealed record SubmitLine(string Sku, int Quantity);
+public sealed record SubmitOrderRequest(Guid CustomerId, IReadOnlyList<SubmitLine> Lines);
+
+public static class OrderEndpoints
+{
+    public static void MapOrderEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/orders/{id:guid}/submit", SubmitAsync);
+    }
+
+    private static async Task<IResult> SubmitAsync(
+        Guid id,
+        SubmitOrderRequest request,
+        IMongoDatabase database,
+        IPriceSource prices,
+        IPublishEndpoint bus,
+        TimeProvider clock,
+        CancellationToken ct)
+    {
+        if (request.Lines is not { Count: > 0 } || request.Lines.Any(l => string.IsNullOrWhiteSpace(l.Sku) || l.Quantity <= 0))
+            return Results.BadRequest("Заказ должен содержать позиции с sku и положительным количеством");
+
+        var orders = database.GetCollection<Order>("orders");
+
+        // Цены берём из ценового сервиса, а не из запроса.
+        var skus = request.Lines.Select(l => l.Sku).Distinct().ToArray();
+        var priceList = await Task.WhenAll(skus.Select(s => prices.GetPriceAsync(s, ct)));
+        var priceBySku = skus.Zip(priceList).ToDictionary(p => p.First, p => p.Second);
+
+        var order = new Order(
+            id,
+            request.CustomerId,
+            OrderStatus.Placed,
+            request.Lines.Select(l => new OrderLine(l.Sku, l.Quantity, priceBySku[l.Sku])).ToList(),
+            clock.GetUtcNow());
+
+        try
+        {
+            await orders.InsertOneAsync(order, cancellationToken: ct);
+        }
+        catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            // Повтор запроса (например, после сбоя публикации): публикуем сохранённый заказ ещё раз.
+            // Процесс игнорирует дубликат OrderSubmitted.
+            order = await orders.Find(o => o.Id == id).FirstAsync(ct);
+            if (order.Status != OrderStatus.Placed)
+                return Results.Conflict($"Заказ уже в статусе {order.Status}");
+        }
+
+        await bus.Publish(new OrderSubmitted(order.Id, order.CustomerId, order.Lines, order.Total, order.PlacedAt), ct);
+        return Results.Accepted($"/orders/{id}");
+    }
+}
