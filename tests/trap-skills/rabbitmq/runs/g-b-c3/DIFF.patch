@@ -0,0 +1,156 @@
+using System.Text.Json;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+public sealed record InboundMessage(string? Sku, int Qty, string? MessageId);
+
+// Читает чужую очередь warehouse.inbound (не MassTransit), увеличивает stock и подтверждает в warehouse.outbound.
+// Обработка идемпотентна по messageId, поэтому повторная доставка (nack, перезапуск брокера, реплики) безопасна.
+public sealed class WarehouseInboundWorker(
+    IOptions<FulfilOptions> options,
+    IMongoDatabase database,
+    ILogger<WarehouseInboundWorker> logger) : BackgroundService
+{
+    public const string InboundQueue = "warehouse.inbound";
+    public const string OutboundExchange = "warehouse.outbound";
+    private const int RememberedIds = 1000;
+
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                await RunAsync(stoppingToken);
+                return;
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+            {
+                return;
+            }
+            catch (Exception ex)
+            {
+                // Брокер может быть недоступен при старте или перезапуске стенда.
+                logger.LogWarning(ex, "Интеграция со складом не запустилась, повтор через 5 с");
+                await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+            }
+        }
+    }
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        var o = options.Value;
+        var factory = new ConnectionFactory
+        {
+            HostName = o.RabbitMqHost,
+            UserName = o.RabbitMqUser,
+            Password = o.RabbitMqPassword,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+            NetworkRecoveryInterval = TimeSpan.FromSeconds(5),
+        };
+
+        await using var connection = await factory.CreateConnectionAsync(ct);
+
+        // Подтверждения публикуем на отдельном канале с publisher confirms.
+        await using var publishChannel = await connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true), ct);
+        await publishChannel.ExchangeDeclareAsync(OutboundExchange, ExchangeType.Topic, durable: true, cancellationToken: ct);
+
+        await using var channel = await connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: false, publisherConfirmationTrackingEnabled: false, consumerDispatchConcurrency: 8), ct);
+        // Очередь принадлежит складской системе: не объявляем, только проверяем (параметры не должны расходиться).
+        await channel.QueueDeclarePassiveAsync(InboundQueue, ct);
+        await channel.BasicQosAsync(0, 50, false, ct);
+
+        var consumer = new AsyncEventingBasicConsumer(channel);
+        consumer.ReceivedAsync += (_, ea) => HandleAsync(channel, publishChannel, ea, ct);
+        await channel.BasicConsumeAsync(InboundQueue, autoAck: false, consumer, ct);
+        logger.LogInformation("Читаю очередь {Queue}", InboundQueue);
+
+        var shutdown = new TaskCompletionSource();
+        connection.ConnectionShutdownAsync += (_, args) =>
+        {
+            // Авто-восстановление поднимет соединение само; завершаем цикл только при закрытии приложением.
+            if (args.Initiator == ShutdownInitiator.Application) shutdown.TrySetResult();
+            return Task.CompletedTask;
+        };
+        await using (ct.Register(() => shutdown.TrySetResult()))
+            await shutdown.Task;
+    }
+
+    private async Task HandleAsync(IChannel channel, IChannel publishChannel, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        try
+        {
+            var message = Parse(ea.Body);
+            if (message is null)
+            {
+                // Ядовитое сообщение: повтор не поможет. Без requeue (уйдёт в DLX, если он настроен складом).
+                logger.LogError("Некорректное сообщение в {Queue}, отклонено", InboundQueue);
+                await channel.BasicRejectAsync(ea.DeliveryTag, requeue: false, ct);
+                return;
+            }
+
+            var applied = await ApplyAsync(message, ct);
+            if (applied is null)
+            {
+                logger.LogError("Приход по неизвестному sku {Sku} (messageId {MessageId}), отклонён", message.Sku, message.MessageId);
+                await channel.BasicRejectAsync(ea.DeliveryTag, requeue: false, ct);
+                return;
+            }
+
+            var body = JsonSerializer.SerializeToUtf8Bytes(
+                new { messageId = message.MessageId, sku = message.Sku, qty = message.Qty, status = applied.Value ? "applied" : "duplicate" }, Json);
+            var props = new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = message.MessageId };
+            await publishChannel.BasicPublishAsync(OutboundExchange, "inbound.confirmed", mandatory: false, props, body, ct);
+
+            await channel.BasicAckAsync(ea.DeliveryTag, multiple: false, ct);
+        }
+        catch (Exception ex) when (!ct.IsCancellationRequested)
+        {
+            logger.LogError(ex, "Не удалось обработать приход товара, вернул в очередь");
+            await Task.Delay(TimeSpan.FromSeconds(1), CancellationToken.None); // без горячего цикла redelivery
+            await channel.BasicNackAsync(ea.DeliveryTag, multiple: false, requeue: true, CancellationToken.None);
+        }
+    }
+
+    private static InboundMessage? Parse(ReadOnlyMemory<byte> body)
+    {
+        try
+        {
+            var m = JsonSerializer.Deserialize<InboundMessage>(body.Span, Json);
+            return m is { Sku.Length: > 0, MessageId.Length: > 0, Qty: > 0 } ? m : null;
+        }
+        catch (JsonException)
+        {
+            return null;
+        }
+    }
+
+    // true - приход применён, false - уже был применён ранее, null - товар не найден.
+    // Инкремент и запись messageId - одна атомарная операция над документом товара.
+    private async Task<bool?> ApplyAsync(InboundMessage m, CancellationToken ct)
+    {
+        var products = database.GetCollection<BsonDocument>("products");
+        var f = Builders<BsonDocument>.Filter;
+        var u = Builders<BsonDocument>.Update;
+
+        var result = await products.UpdateOneAsync(
+            f.Eq("sku", m.Sku) & f.Ne("inboundIds", m.MessageId),
+            u.Inc("stock", m.Qty).PushEach("inboundIds", new[] { m.MessageId }, slice: -RememberedIds),
+            cancellationToken: ct);
+        if (result.MatchedCount > 0) return true;
+
+        var exists = await products.CountDocumentsAsync(f.Eq("sku", m.Sku), new CountOptions { Limit = 1 }, ct) > 0;
+        return exists ? false : null;
+    }
+}
