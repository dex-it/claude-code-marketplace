+using MongoDB.Bson;
+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Payments;
+
+public enum PaymentStatus { Captured, Declined, Refunded }
+
+// Итог платежа по заказу. Защищает от повторного списания при повторной доставке команды.
+public sealed class PaymentRecord
+{
+    [BsonId]
+    public Guid OrderId { get; set; }
+    public PaymentStatus Status { get; set; }
+    [BsonRepresentation(BsonType.Decimal128)]
+    public decimal Amount { get; set; }
+    public string? Reason { get; set; }
+    public DateTimeOffset UpdatedAt { get; set; }
+}
diff --git a/src/Fulfil/Payments/RefundPaymentConsumer.cs b/src/Fulfil/Payments/RefundPaymentConsumer.cs
new file mode 100644
index 0000000..9a3266e
--- /dev/null
+++ b/src/Fulfil/Payments/RefundPaymentConsumer.cs
@@ -0,0 +1,53 @@
+using Fulfil.Contracts;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Payments;
+
+public sealed class RefundPaymentConsumer(
+    IPaymentGateway gateway,
+    IMongoDatabase database,
+    ILogger<RefundPaymentConsumer> logger) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var orderId = context.Message.OrderId;
+        var ct = context.CancellationToken;
+        var payments = database.GetCollection<PaymentRecord>("payments");
+
+        var record = await payments.Find(p => p.OrderId == orderId).FirstOrDefaultAsync(ct);
+        if (record is not { Status: PaymentStatus.Captured })
+            return; // списания не было или возврат уже сделан
+
+        await gateway.RefundAsync(orderId, record.Amount, ct);
+        await payments.UpdateOneAsync(
+            p => p.OrderId == orderId && p.Status == PaymentStatus.Captured,
+            Builders<PaymentRecord>.Update
+                .Set(p => p.Status, PaymentStatus.Refunded)
+                .Set(p => p.UpdatedAt, DateTimeOffset.UtcNow),
+            cancellationToken: ct);
+        logger.LogInformation("Возврат по заказу {OrderId}", orderId);
+    }
+}
+
+public sealed class RefundPaymentDefinition : ConsumerDefinition<RefundPaymentConsumer>
+{
+    public RefundPaymentDefinition()
+    {
+        EndpointName = Queues.RefundPayment;
+        ConcurrentMessageLimit = 16;
+    }
+
+    protected override void ConfigureConsumer(
+        IReceiveEndpointConfigurator endpointConfigurator,
+        IConsumerConfigurator<RefundPaymentConsumer> consumerConfigurator,
+        IRegistrationContext context)
+    {
+        if (endpointConfigurator is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.SetQuorumQueue();
+
+        endpointConfigurator.UseMessageRetry(r =>
+            r.Exponential(8, TimeSpan.FromSeconds(1), TimeSpan.FromMinutes(1), TimeSpan.FromSeconds(1)));
+    }
+}
