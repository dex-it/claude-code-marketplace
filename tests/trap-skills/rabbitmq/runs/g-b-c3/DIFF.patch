diff --git a/src/Fulfil/Payments/CapturePaymentConsumer.cs b/src/Fulfil/Payments/CapturePaymentConsumer.cs
new file mode 100644
index 0000000..9a25d8a
--- /dev/null
+++ b/src/Fulfil/Payments/CapturePaymentConsumer.cs
@@ -0,0 +1,85 @@
+using Fulfil.Contracts;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Payments;
+
+public sealed class CapturePaymentConsumer(
+    IPaymentGateway gateway,
+    IMongoDatabase database,
+    ILogger<CapturePaymentConsumer> logger) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var (orderId, amount) = context.Message;
+        var ct = context.CancellationToken;
+        var payments = database.GetCollection<PaymentRecord>("payments");
+
+        // Повторная доставка: итог уже известен, деньги второй раз не списываем, только повторяем ответ.
+        var existing = await payments.Find(p => p.OrderId == orderId).FirstOrDefaultAsync(ct);
+        if (existing is not null)
+        {
+            await PublishResult(context, existing);
+            return;
+        }
+
+        PaymentRecord record;
+        try
+        {
+            await gateway.ChargeAsync(orderId, amount, ct);
+            record = new PaymentRecord { OrderId = orderId, Status = PaymentStatus.Captured, Amount = amount };
+        }
+        catch (PaymentDeclinedException ex)
+        {
+            record = new PaymentRecord { OrderId = orderId, Status = PaymentStatus.Declined, Amount = amount, Reason = ex.Message };
+        }
+        // Остальные сбои шлюза пробрасываем: повтор, затем автомат размыкания и _error.
+
+        record.UpdatedAt = DateTimeOffset.UtcNow;
+        await payments.ReplaceOneAsync(p => p.OrderId == orderId, record, new ReplaceOptions { IsUpsert = true }, ct);
+        logger.LogInformation("Платёж по заказу {OrderId}: {Status}", orderId, record.Status);
+
+        await PublishResult(context, record);
+    }
+
+    private static Task PublishResult(ConsumeContext<CapturePayment> context, PaymentRecord record) =>
+        record.Status == PaymentStatus.Declined
+            ? context.Publish(new PaymentDeclined(record.OrderId, record.Reason ?? "Платёж отклонён"))
+            : context.Publish(new PaymentCaptured(record.OrderId));
+}
+
+public sealed class CapturePaymentDefinition : ConsumerDefinition<CapturePaymentConsumer>
+{
+    public CapturePaymentDefinition()
+    {
+        EndpointName = Queues.CapturePayment;
+        // Пик 10 000/мин ~ 170/с при ответе шлюза до 2 с: ~340 одновременных вызовов на 3 реплики.
+        ConcurrentMessageLimit = 128;
+    }
+
+    protected override void ConfigureConsumer(
+        IReceiveEndpointConfigurator endpointConfigurator,
+        IConsumerConfigurator<CapturePaymentConsumer> consumerConfigurator,
+        IRegistrationContext context)
+    {
+        if (endpointConfigurator is IRabbitMqReceiveEndpointConfigurator rabbit)
+        {
+            rabbit.SetQuorumQueue();
+            rabbit.PrefetchCount = 256;
+        }
+
+        // При устойчивом падении шлюза потребитель приостанавливается, команды ждут в очереди.
+        endpointConfigurator.UseCircuitBreaker(cb =>
+        {
+            cb.TrackingPeriod = TimeSpan.FromMinutes(1);
+            cb.TripThreshold = 15;
+            cb.ActiveThreshold = 20;
+            cb.ResetInterval = TimeSpan.FromSeconds(30);
+        });
+        endpointConfigurator.UseMessageRetry(r =>
+            r.Exponential(5, TimeSpan.FromMilliseconds(200), TimeSpan.FromSeconds(10), TimeSpan.FromMilliseconds(500))
+                .Ignore<PaymentDeclinedException>());
+        endpointConfigurator.UseInMemoryOutbox(context);
+    }
+}
