+using Fulfil.Domain;
+
+namespace Fulfil.Contracts;
+
+// Старт процесса исполнения. Публикуется после сохранения заказа (см. OrderOutboxRelay).
+public sealed record OrderSubmitted(Guid OrderId, Guid CustomerId, IReadOnlyList<OrderLine> Lines, decimal Amount, DateTimeOffset SubmittedAt);
+
+// Команды шагов процесса.
+public sealed record ReserveStock(Guid OrderId, IReadOnlyList<OrderLine> Lines);
+public sealed record CapturePayment(Guid OrderId, decimal Amount);
+public sealed record ShipOrder(Guid OrderId);
+
+// Команды отката.
+public sealed record ReleaseStock(Guid OrderId, IReadOnlyList<OrderLine> Lines);
+public sealed record RefundPayment(Guid OrderId, decimal Amount);
+
+// Результаты шагов.
+public sealed record StockReserved(Guid OrderId);
+public sealed record StockReservationFailed(Guid OrderId, string Reason);
+public sealed record PaymentCaptured(Guid OrderId);
+public sealed record PaymentFailed(Guid OrderId, string Reason);
+public sealed record OrderShipped(Guid OrderId);
+public sealed record ShipmentFailed(Guid OrderId, string Reason);
+
+// Результаты отката.
+public sealed record StockReleased(Guid OrderId);
+public sealed record PaymentRefunded(Guid OrderId);
+
+// Итог процесса.
+public sealed record OrderCompleted(Guid OrderId);
+public sealed record OrderCancelled(Guid OrderId, string Reason);
diff --git a/src/Fulfil/Infrastructure/MongoStore.cs b/src/Fulfil/Infrastructure/MongoStore.cs
new file mode 100644
index 0000000..38f70e3
--- /dev/null
+++ b/src/Fulfil/Infrastructure/MongoStore.cs
@@ -0,0 +1,98 @@
+using Fulfil.Domain;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization.Attributes;
+using MongoDB.Driver;
+
+namespace Fulfil.Infrastructure;
+
+public static class Collections
+{
+    public const string Orders = "orders";
+    public const string Products = "products";
+    public const string Payments = "payments";
+}
+
+// Заказ и признак «событие OrderSubmitted ещё не опубликовано» лежат в одном документе:
+// запись атомарна, а публикацию доводит OrderOutboxRelay.
+public sealed class OrderDocument
+{
+    [BsonId] public Guid Id { get; set; }
+    public Guid CustomerId { get; set; }
+    [BsonRepresentation(BsonType.String)] public OrderStatus Status { get; set; }
+    public List<OrderLine> Lines { get; set; } = [];
+    public DateTimeOffset PlacedAt { get; set; }
+    public bool OutboxPending { get; set; }
+
+    public decimal Total => Lines.Sum(l => l.Quantity * l.UnitPrice);
+}
+
+// Операции над остатками. Каждая операция помечается идентификатором в массиве AppliedOps
+// того же документа товара, поэтому применяется атомарно и не более одного раза
+// (повторная доставка команды или сообщения безопасна). Хранится последние OpsWindow операций.
+public sealed class StockLedger(IMongoDatabase db)
+{
+    private const int OpsWindow = 500;
+    private const string Ops = "AppliedOps";
+
+    private IMongoCollection<BsonDocument> Products => db.GetCollection<BsonDocument>(Collections.Products);
+
+    private static string ReserveOp(Guid orderId) => $"reserve:{orderId:N}";
+    private static string ReleaseOp(Guid orderId) => $"release:{orderId:N}";
+
+    private static UpdateDefinition<BsonDocument> Push(UpdateDefinition<BsonDocument> inc, string op) =>
+        Builders<BsonDocument>.Update.Combine(
+            inc, Builders<BsonDocument>.Update.PushEach(Ops, new[] { op }, slice: -OpsWindow));
+
+    // false - товара не хватает; частично применённые строки откатываются.
+    public async Task<bool> ReserveAsync(Guid orderId, IReadOnlyList<OrderLine> lines, CancellationToken ct)
+    {
+        var f = Builders<BsonDocument>.Filter;
+        var op = ReserveOp(orderId);
+        foreach (var line in lines.OrderBy(l => l.Sku, StringComparer.Ordinal))
+        {
+            var applied = await Products.UpdateOneAsync(
+                f.Eq("Sku", line.Sku) & f.Gte("Stock", line.Quantity) & f.Ne(Ops, op),
+                Push(Builders<BsonDocument>.Update.Inc("Stock", -line.Quantity), op),
+                cancellationToken: ct);
+            if (applied.ModifiedCount == 1) continue;
+
+            // Не применили: либо уже применено ранее (повтор), либо не хватает.
+            var already = await Products.CountDocumentsAsync(f.Eq("Sku", line.Sku) & f.Eq(Ops, op), cancellationToken: ct);
+            if (already > 0) continue;
+
+            await ReleaseAsync(orderId, lines, ct);
+            return false;
+        }
+        return true;
+    }
+
+    public async Task ReleaseAsync(Guid orderId, IReadOnlyList<OrderLine> lines, CancellationToken ct)
+    {
+        var f = Builders<BsonDocument>.Filter;
+        var reserve = ReserveOp(orderId);
+        var release = ReleaseOp(orderId);
+        foreach (var line in lines)
+        {
+            await Products.UpdateOneAsync(
+                f.Eq("Sku", line.Sku) & f.Eq(Ops, reserve) & f.Ne(Ops, release),
+                Push(Builders<BsonDocument>.Update.Inc("Stock", line.Quantity), release),
+                cancellationToken: ct);
+        }
+    }
+
+    public enum ReceiveResult { Applied, Duplicate, UnknownSku }
+
+    public async Task<ReceiveResult> ReceiveAsync(string messageId, string sku, int qty, CancellationToken ct)
+    {
+        var f = Builders<BsonDocument>.Filter;
+        var op = $"inbound:{messageId}";
+        var res = await Products.UpdateOneAsync(
+            f.Eq("Sku", sku) & f.Ne(Ops, op),
+            Push(Builders<BsonDocument>.Update.Inc("Stock", qty), op),
+            cancellationToken: ct);
+        if (res.ModifiedCount == 1) return ReceiveResult.Applied;
+
+        var exists = await Products.CountDocumentsAsync(f.Eq("Sku", sku), cancellationToken: ct);
+        return exists > 0 ? ReceiveResult.Duplicate : ReceiveResult.UnknownSku;
+    }
+}
diff --git a/src/Fulfil/Infrastructure/OrderOutboxRelay.cs b/src/Fulfil/Infrastructure/OrderOutboxRelay.cs
new file mode 100644
index 0000000..5e3f438
--- /dev/null
+++ b/src/Fulfil/Infrastructure/OrderOutboxRelay.cs
@@ -0,0 +1,43 @@
+using Fulfil.Contracts;
+using Fulfil.Options;
+using MassTransit;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
+
+namespace Fulfil.Infrastructure;
+
+// Доводит до брокера события заказов, сохранённые с OutboxPending. Публикует минимум один раз:
+// если реплика упала между публикацией и сбросом флага (или флаг сбросила другая реплика
+// одновременно), OrderSubmitted уйдёт повторно; процесс заказа такие дубли игнорирует.
+public sealed class OrderOutboxRelay(
+    IMongoDatabase db, IBus bus, IOptions<FulfilOptions> options, ILogger<OrderOutboxRelay> log) : BackgroundService
+{
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        var orders = db.GetCollection<OrderDocument>(Collections.Orders);
+        var interval = TimeSpan.FromMilliseconds(options.Value.OutboxPollMilliseconds);
+
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                var pending = await orders.Find(o => o.OutboxPending).Limit(100).ToListAsync(stoppingToken);
+                foreach (var order in pending)
+                {
+                    await bus.Publish(
+                        new OrderSubmitted(order.Id, order.CustomerId, order.Lines, order.Total, order.PlacedAt),
+                        ctx => ctx.MessageId = order.Id,
+                        stoppingToken);
+                    await orders.UpdateOneAsync(o => o.Id == order.Id,
+                        Builders<OrderDocument>.Update.Set(o => o.OutboxPending, false), cancellationToken: stoppingToken);
+                }
+                if (pending.Count == 100) continue;
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                log.LogError(e, "Не удалось опубликовать события заказов, повтор");
+            }
+            await Task.Delay(interval, stoppingToken);
+        }
+    }
+}
diff --git a/src/Fulfil/Infrastructure/WarehouseInboundWorker.cs b/src/Fulfil/Infrastructure/WarehouseInboundWorker.cs
new file mode 100644
index 0000000..0cc46b5
--- /dev/null
+++ b/src/Fulfil/Infrastructure/WarehouseInboundWorker.cs
@@ -0,0 +1,113 @@
+using System.Text;
+using System.Text.Json;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Infrastructure;
+
+public sealed record WarehouseInbound(string Sku, int Qty, string MessageId);
+
+// Прямой консьюмер очереди warehouse.inbound (чужой формат, не MassTransit).
+// - prefetch ограничен: в памяти не больше WarehouseInboundPrefetch неподтверждённых сообщений;
+// - ack только после того, как остаток увеличен и подтверждение принято обменником warehouse.outbound
+//   (publisher confirms); до этого сообщение остаётся в очереди и переживёт сбой или рестарт;
+// - повторная доставка не удваивает остаток: приход применяется по messageId (см. StockLedger);
+// - соединение восстанавливается автоматически, начальное подключение повторяется до успеха.
+public sealed class WarehouseInboundWorker(
+    StockLedger ledger, IOptions<FulfilOptions> options, ILogger<WarehouseInboundWorker> log) : BackgroundService
+{
+    public const string InboundQueue = "warehouse.inbound";
+    public const string OutboundExchange = "warehouse.outbound";
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        var o = options.Value;
+        var factory = new ConnectionFactory
+        {
+            HostName = o.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+            NetworkRecoveryInterval = TimeSpan.FromSeconds(5),
+        };
+
+        IConnection connection;
+        IChannel channel;
+        while (true)
+        {
+            try
+            {
+                connection = await factory.CreateConnectionAsync("fulfil-warehouse-inbound", stoppingToken);
+                // Подтверждения публикации включены: ack входящего только после подтверждения брокером.
+                channel = await connection.CreateChannelAsync(
+                    new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true),
+                    stoppingToken);
+                // Очередь принадлежит чужой системе: только проверяем наличие, не переобъявляем.
+                await channel.QueueDeclarePassiveAsync(InboundQueue, stoppingToken);
+                break;
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                log.LogWarning(e, "RabbitMQ или очередь {Queue} недоступны, повтор через 5 с", InboundQueue);
+                await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+            }
+        }
+
+        await using var _c = connection;
+        await using var _ch = channel;
+
+        await channel.BasicQosAsync(0, o.WarehouseInboundPrefetch, false, stoppingToken);
+
+        var consumer = new AsyncEventingBasicConsumer(channel);
+        consumer.ReceivedAsync += (_, ea) => HandleAsync(channel, ea, stoppingToken);
+        await channel.BasicConsumeAsync(InboundQueue, autoAck: false, consumer, stoppingToken);
+
+        await Task.Delay(Timeout.Infinite, stoppingToken).ContinueWith(_ => { });
+    }
+
+    private async Task HandleAsync(IChannel channel, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        try
+        {
+            WarehouseInbound? msg = null;
+            try
+            {
+                msg = JsonSerializer.Deserialize<WarehouseInbound>(Encoding.UTF8.GetString(ea.Body.Span), JsonOptions);
+            }
+            catch (JsonException) { }
+
+            if (msg is null || string.IsNullOrWhiteSpace(msg.Sku) || string.IsNullOrWhiteSpace(msg.MessageId) || msg.Qty <= 0)
+            {
+                log.LogError("Некорректное сообщение прихода, отклонено без возврата в очередь");
+                await channel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+                return;
+            }
+
+            var result = await ledger.ReceiveAsync(msg.MessageId, msg.Sku, msg.Qty, ct);
+            if (result == StockLedger.ReceiveResult.UnknownSku)
+            {
+                log.LogError("Приход {MessageId}: неизвестный sku {Sku}, отклонён без возврата в очередь", msg.MessageId, msg.Sku);
+                await channel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+                return;
+            }
+
+            var body = JsonSerializer.SerializeToUtf8Bytes(new { messageId = msg.MessageId, sku = msg.Sku, qty = msg.Qty, status = "applied" });
+            await channel.BasicPublishAsync(
+                OutboundExchange, routingKey: "", mandatory: false,
+                new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = msg.MessageId },
+                body, ct);
+
+            await channel.BasicAckAsync(ea.DeliveryTag, false, ct);
+        }
+        catch (Exception e) when (e is not OperationCanceledException)
+        {
+            // Остаток и подтверждение идемпотентны - возвращаем сообщение в очередь.
+            log.LogError(e, "Сбой обработки прихода, сообщение возвращено в очередь");
+            try { await channel.BasicNackAsync(ea.DeliveryTag, false, true, ct); }
+            catch (Exception nackError) { log.LogWarning(nackError, "Nack не отправлен, сообщение вернётся при закрытии канала"); }
+        }
+    }
+
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
+}
