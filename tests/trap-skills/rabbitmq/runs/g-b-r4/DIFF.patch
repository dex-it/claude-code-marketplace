 namespace Fulfil.Ports;
 
+// Шлюз отклонил платёж (бизнес-отказ): повторять бессмысленно. Любое другое исключение - сбой шлюза.
+public sealed class PaymentDeclinedException(string message) : Exception(message);
+
 // Платёжный шлюз: внешний HTTP-сервис, отвечает за 0.3-2 с и иногда падает.
+// orderId служит ключом идемпотентности: шлюз не должен списывать дважды по одному заказу.
 public interface IPaymentGateway
 {
     Task ChargeAsync(Guid orderId, decimal amount, CancellationToken ct);
diff --git a/src/Fulfil/Processes/Consumers.cs b/src/Fulfil/Processes/Consumers.cs
new file mode 100644
index 0000000..a786545
--- /dev/null
+++ b/src/Fulfil/Processes/Consumers.cs
@@ -0,0 +1,115 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Infrastructure;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Processes;
+
+// Все обработчики идемпотентны: команды доставляются минимум один раз,
+// а сбой публикации результата приводит к повторной доставке команды.
+
+public sealed class ReserveStockConsumer(StockLedger ledger) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var cmd = context.Message;
+        if (await ledger.ReserveAsync(cmd.OrderId, cmd.Lines, context.CancellationToken))
+            await context.Publish(new StockReserved(cmd.OrderId));
+        else
+            await context.Publish(new StockReservationFailed(cmd.OrderId, "Недостаточно товара на складе"));
+    }
+}
+
+public sealed class ReleaseStockConsumer(StockLedger ledger) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var cmd = context.Message;
+        await ledger.ReleaseAsync(cmd.OrderId, cmd.Lines, context.CancellationToken);
+        await context.Publish(new StockReleased(cmd.OrderId));
+    }
+}
+
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var cmd = context.Message;
+        var ct = context.CancellationToken;
+        var payments = db.GetCollection<BsonDocument>(Collections.Payments);
+        var byId = Builders<BsonDocument>.Filter.Eq("_id", cmd.OrderId);
+
+        if (await payments.CountDocumentsAsync(byId, cancellationToken: ct) == 0)
+        {
+            try
+            {
+                await gateway.ChargeAsync(cmd.OrderId, cmd.Amount, ct);
+            }
+            catch (PaymentDeclinedException e)
+            {
+                await context.Publish(new PaymentFailed(cmd.OrderId, e.Message));
+                return;
+            }
+            // Сбой шлюза пробрасывается: ретрай, затем Fault, который обработает процесс.
+
+            await payments.ReplaceOneAsync(byId,
+                new BsonDocument { { "_id", new BsonBinaryData(cmd.OrderId, GuidRepresentation.Standard) }, { "Amount", cmd.Amount }, { "Refunded", false } },
+                new ReplaceOptions { IsUpsert = true }, ct);
+            await db.GetCollection<OrderDocument>(Collections.Orders).UpdateOneAsync(
+                o => o.Id == cmd.OrderId && o.Status == OrderStatus.Placed,
+                Builders<OrderDocument>.Update.Set(o => o.Status, OrderStatus.Paid), cancellationToken: ct);
+        }
+        await context.Publish(new PaymentCaptured(cmd.OrderId));
+    }
+}
+
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var cmd = context.Message;
+        var ct = context.CancellationToken;
+        var payments = db.GetCollection<BsonDocument>(Collections.Payments);
+        var f = Builders<BsonDocument>.Filter;
+        var open = f.Eq("_id", cmd.OrderId) & f.Eq("Refunded", false);
+
+        if (await payments.CountDocumentsAsync(open, cancellationToken: ct) > 0)
+        {
+            await gateway.RefundAsync(cmd.OrderId, cmd.Amount, ct);
+            await payments.UpdateOneAsync(open, Builders<BsonDocument>.Update.Set("Refunded", true), cancellationToken: ct);
+        }
+        await context.Publish(new PaymentRefunded(cmd.OrderId));
+    }
+}
+
+public sealed class ShipOrderConsumer(IMongoDatabase db) : IConsumer<ShipOrder>
+{
+    public async Task Consume(ConsumeContext<ShipOrder> context)
+    {
+        var id = context.Message.OrderId;
+        var orders = db.GetCollection<OrderDocument>(Collections.Orders);
+        if (await orders.CountDocumentsAsync(o => o.Id == id, cancellationToken: context.CancellationToken) == 0)
+        {
+            await context.Publish(new ShipmentFailed(id, "Заказ не найден"));
+            return;
+        }
+        await orders.UpdateOneAsync(o => o.Id == id,
+            Builders<OrderDocument>.Update.Set(o => o.Status, OrderStatus.Shipped), cancellationToken: context.CancellationToken);
+        await context.Publish(new OrderShipped(id));
+    }
+}
+
+// Итоговый статус заказа в коллекции orders.
+public sealed class OrderOutcomeConsumer(IMongoDatabase db) : IConsumer<OrderCompleted>, IConsumer<OrderCancelled>
+{
+    public Task Consume(ConsumeContext<OrderCompleted> context) => Set(context.Message.OrderId, OrderStatus.Shipped, context.CancellationToken);
+
+    public Task Consume(ConsumeContext<OrderCancelled> context) => Set(context.Message.OrderId, OrderStatus.Cancelled, context.CancellationToken);
+
+    private Task Set(Guid id, OrderStatus status, CancellationToken ct) =>
+        db.GetCollection<OrderDocument>(Collections.Orders).UpdateOneAsync(
+            o => o.Id == id, Builders<OrderDocument>.Update.Set(o => o.Status, status), cancellationToken: ct);
+}
diff --git a/src/Fulfil/Processes/OrderProcess.cs b/src/Fulfil/Processes/OrderProcess.cs
new file mode 100644
index 0000000..1bce870
--- /dev/null
+++ b/src/Fulfil/Processes/OrderProcess.cs
@@ -0,0 +1,153 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Processes;
+
+public static class Queues
+{
+    public const string ReserveStock = "reserve-stock";
+    public const string CapturePayment = "capture-payment";
+    public const string ShipOrder = "ship-order";
+    public const string ReleaseStock = "release-stock";
+    public const string RefundPayment = "refund-payment";
+
+    public static Uri Uri(string queue) => new($"queue:{queue}");
+}
+
+public sealed class OrderProcessState : SagaStateMachineInstance, ISagaVersion
+{
+    [BsonId] public Guid CorrelationId { get; set; }
+    public int Version { get; set; }
+    public string CurrentState { get; set; } = "";
+
+    public List<OrderLine> Lines { get; set; } = [];
+    public decimal Amount { get; set; }
+    public bool PaymentCaptured { get; set; }
+    public bool ReleasePending { get; set; }
+    public bool RefundPending { get; set; }
+    public string? FailureReason { get; set; }
+}
+
+// Резерв -> списание -> отгрузка. При сбое шага откатываются выполненные до него шаги:
+//   платёж не прошёл        -> снять резерв;
+//   отгрузка не удалась     -> вернуть деньги и снять резерв.
+// Запись состояния и отправка команд не атомарны: при сбое между ними событие приходит повторно
+// и команды уходят ещё раз - это безопасно, потому что все обработчики идемпотентны.
+public sealed class OrderProcessStateMachine : MassTransitStateMachine<OrderProcessState>
+{
+    public State Reserving { get; private set; } = null!;
+    public State Capturing { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+    public State Compensating { get; private set; } = null!;
+    public State Completed { get; private set; } = null!;
+    public State Cancelled { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> StockReservedEvent { get; private set; } = null!;
+    public Event<StockReservationFailed> StockReservationFailedEvent { get; private set; } = null!;
+    public Event<PaymentCaptured> PaymentCapturedEvent { get; private set; } = null!;
+    public Event<PaymentFailed> PaymentFailedEvent { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CapturePaymentFaulted { get; private set; } = null!;
+    public Event<OrderShipped> OrderShippedEvent { get; private set; } = null!;
+    public Event<ShipmentFailed> ShipmentFailedEvent { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipOrderFaulted { get; private set; } = null!;
+    public Event<StockReleased> StockReleasedEvent { get; private set; } = null!;
+    public Event<PaymentRefunded> PaymentRefundedEvent { get; private set; } = null!;
+
+    public OrderProcessStateMachine()
+    {
+        InstanceState(x => x.CurrentState, Reserving, Capturing, Shipping, Compensating, Completed, Cancelled);
+
+        Event(() => Submitted, x => x.CorrelateById(m => m.Message.OrderId).SelectId(m => m.Message.OrderId));
+        Event(() => StockReservedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+        Event(() => StockReservationFailedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+        Event(() => PaymentCapturedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+        Event(() => PaymentFailedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+        Event(() => CapturePaymentFaulted, x => x.CorrelateById(m => m.Message.Message.OrderId));
+        Event(() => OrderShippedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+        Event(() => ShipmentFailedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+        Event(() => ShipOrderFaulted, x => x.CorrelateById(m => m.Message.Message.OrderId));
+        Event(() => StockReleasedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+        Event(() => PaymentRefundedEvent, x => x.CorrelateById(m => m.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(ctx =>
+                {
+                    ctx.Saga.Lines = ctx.Message.Lines.ToList();
+                    ctx.Saga.Amount = ctx.Message.Amount;
+                })
+                .Send(Queues.Uri(Queues.ReserveStock), ctx => new ReserveStock(ctx.Saga.CorrelationId, ctx.Saga.Lines))
+                .TransitionTo(Reserving));
+
+        // Дубли и запоздалые события (relay и брокер доставляют минимум один раз) безвредны:
+        // в частности, повторный OrderSubmitted не перезапускает процесс.
+        OnUnhandledEvent(x => x.Ignore());
+
+        During(Reserving,
+            When(StockReservedEvent)
+                .Send(Queues.Uri(Queues.CapturePayment), ctx => new CapturePayment(ctx.Saga.CorrelationId, ctx.Saga.Amount))
+                .TransitionTo(Capturing),
+            When(StockReservationFailedEvent)
+                .Then(ctx => ctx.Saga.FailureReason = ctx.Message.Reason)
+                .Publish(ctx => new OrderCancelled(ctx.Saga.CorrelationId, ctx.Message.Reason))
+                .TransitionTo(Cancelled));
+
+        During(Capturing,
+            When(PaymentCapturedEvent)
+                .Then(ctx => ctx.Saga.PaymentCaptured = true)
+                .Send(Queues.Uri(Queues.ShipOrder), ctx => new ShipOrder(ctx.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(PaymentFailedEvent)
+                .Then(ctx => ctx.Saga.FailureReason = ctx.Message.Reason)
+                .ThenAsync(ctx => Compensate(ctx.Saga, ctx, refund: false))
+                .TransitionTo(Compensating),
+            When(CapturePaymentFaulted)
+                .Then(ctx => ctx.Saga.FailureReason = "Платёжный шлюз недоступен")
+                .ThenAsync(ctx => Compensate(ctx.Saga, ctx, refund: false))
+                .TransitionTo(Compensating));
+
+        During(Shipping,
+            When(OrderShippedEvent)
+                .Publish(ctx => new OrderCompleted(ctx.Saga.CorrelationId))
+                .TransitionTo(Completed),
+            When(ShipmentFailedEvent)
+                .Then(ctx => ctx.Saga.FailureReason = ctx.Message.Reason)
+                .ThenAsync(ctx => Compensate(ctx.Saga, ctx, refund: true))
+                .TransitionTo(Compensating),
+            When(ShipOrderFaulted)
+                .Then(ctx => ctx.Saga.FailureReason = "Отгрузка не удалась")
+                .ThenAsync(ctx => Compensate(ctx.Saga, ctx, refund: true))
+                .TransitionTo(Compensating));
+
+        During(Compensating,
+            When(StockReleasedEvent)
+                .Then(ctx => ctx.Saga.ReleasePending = false)
+                .If(Done, b => FinishCancelled(b)),
+            When(PaymentRefundedEvent)
+                .Then(ctx => ctx.Saga.RefundPending = false)
+                .If(Done, b => FinishCancelled(b)));
+    }
+
+    private static bool Done(BehaviorContext<OrderProcessState> ctx) => !ctx.Saga.ReleasePending && !ctx.Saga.RefundPending;
+
+    private EventActivityBinder<OrderProcessState, T> FinishCancelled<T>(EventActivityBinder<OrderProcessState, T> b)
+        where T : class =>
+        b.Publish(ctx => new OrderCancelled(ctx.Saga.CorrelationId, ctx.Saga.FailureReason ?? "Отменён"))
+         .TransitionTo(Cancelled);
+
+    private static async Task Compensate(OrderProcessState saga, BehaviorContext<OrderProcessState> ctx, bool refund)
+    {
+        saga.ReleasePending = true;
+        saga.RefundPending = refund;
+        var release = await ctx.GetSendEndpoint(Queues.Uri(Queues.ReleaseStock));
+        await release.Send(new ReleaseStock(saga.CorrelationId, saga.Lines));
+        if (refund)
+        {
+            var refunds = await ctx.GetSendEndpoint(Queues.Uri(Queues.RefundPayment));
+            await refunds.Send(new RefundPayment(saga.CorrelationId, saga.Amount));
+        }
+    }
+}
diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..62b9987 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,94 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Infrastructure;
 using Fulfil.Options;
+using Fulfil.Processes;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization;
+using MongoDB.Bson.Serialization.Serializers;
+using MongoDB.Driver;
+
+BsonSerializer.RegisterSerializer(new GuidSerializer(GuidRepresentation.Standard));
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(fulfil.MongoConnectionString));
+builder.Services.AddSingleton(sp => sp.GetRequiredService<IMongoClient>().GetDatabase(fulfil.MongoDatabase));
+builder.Services.AddSingleton<StockLedger>();
+
+builder.Services.AddMassTransit(x =>
+{
+    x.AddConsumer<ReserveStockConsumer>().Endpoint(e => e.Name = Queues.ReserveStock);
+    x.AddConsumer<ReleaseStockConsumer>().Endpoint(e => e.Name = Queues.ReleaseStock);
+    x.AddConsumer<RefundPaymentConsumer>().Endpoint(e => e.Name = Queues.RefundPayment);
+    x.AddConsumer<ShipOrderConsumer>().Endpoint(e => e.Name = Queues.ShipOrder);
+    x.AddConsumer<OrderOutcomeConsumer>().Endpoint(e => e.Name = "order-outcome");
+
+    // Пик 10 тыс. команд/мин, шлюз отвечает до 2 с: параллелизм и prefetch заданы явно и ограничены.
+    // Сбой шлюза - ретраи с задержкой; после них сообщение уходит в _error, а процесс получает Fault
+    // и откатывает шаги. Отказ платежа (PaymentDeclinedException) не ретраится.
+    x.AddConsumer<CapturePaymentConsumer>(c => c.UseMessageRetry(r => r.Exponential(5, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(2))))
+        .Endpoint(e =>
+        {
+            e.Name = Queues.CapturePayment;
+            e.ConcurrentMessageLimit = fulfil.PaymentConcurrency;
+            e.PrefetchCount = fulfil.PaymentPrefetch;
+        });
+
+    x.AddSagaStateMachine<OrderProcessStateMachine, OrderProcessState>(
+            (_, s) => s.UseMessageRetry(r => r.Interval(5, TimeSpan.FromMilliseconds(200))))
+        .Endpoint(e => e.Name = "order-process")
+        .MongoDbRepository(r =>
+        {
+            r.Connection = fulfil.MongoConnectionString;
+            r.DatabaseName = fulfil.MongoDatabase;
+            r.CollectionName = "order_processes";
+        });
+
+    x.UsingRabbitMq((ctx, cfg) =>
+    {
+        cfg.Host(fulfil.RabbitMqHost, "/", _ => { });
+        cfg.PrefetchCount = 32;
+        cfg.ConfigureEndpoints(ctx);
+    });
+});
+
+builder.Services.AddHostedService<OrderOutboxRelay>();
+builder.Services.AddHostedService<WarehouseInboundWorker>();
 
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+
+// Заказ и признак неопубликованного события пишутся одним документом; OrderSubmitted
+// публикует OrderOutboxRelay, поэтому падение после записи не теряет событие.
+app.MapPost("/orders/{id:guid}/submit", async (Guid id, SubmitOrderRequest request, IMongoDatabase db, CancellationToken ct) =>
+{
+    if (request.Lines is not { Count: > 0 } || request.Lines.Any(l => l.Quantity <= 0 || l.UnitPrice < 0))
+        return Results.BadRequest("Заказ должен содержать строки с положительным количеством");
+
+    var order = new OrderDocument
+    {
+        Id = id,
+        CustomerId = request.CustomerId,
+        Status = OrderStatus.Placed,
+        Lines = request.Lines,
+        PlacedAt = DateTimeOffset.UtcNow,
+        OutboxPending = true,
+    };
+    try
+    {
+        await db.GetCollection<OrderDocument>(Collections.Orders).InsertOneAsync(order, cancellationToken: ct);
+    }
+    catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+    {
+        // Повторный запрос клиента: заказ уже принят, событие доведёт relay.
+    }
+    return Results.Accepted($"/orders/{id}");
+});
+
 app.Run();
+
+public sealed record SubmitOrderRequest(Guid CustomerId, List<OrderLine> Lines);
