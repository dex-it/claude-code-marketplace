diff --git a/src/Fulfil/Consumers/CapturePaymentConsumer.cs b/src/Fulfil/Consumers/CapturePaymentConsumer.cs
new file mode 100644
index 0000000..66c8e0a
--- /dev/null
+++ b/src/Fulfil/Consumers/CapturePaymentConsumer.cs
@@ -0,0 +1,92 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Options;
+using Fulfil.Persistence;
+using Fulfil.Ports;
+using MassTransit;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, IMongoDatabase db, ILogger<CapturePaymentConsumer> logger)
+    : IConsumer<CapturePayment>
+{
+    private static readonly TimeSpan GatewayTimeout = TimeSpan.FromSeconds(15);
+
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var (orderId, amount) = (context.Message.OrderId, context.Message.Amount);
+        var ct = context.CancellationToken;
+        var orders = db.Orders();
+
+        var status = await orders.Find(o => o.Id == orderId).Project(o => (OrderStatus?)o.Status).FirstOrDefaultAsync(ct);
+        if (status is null or OrderStatus.Cancelled)
+        {
+            await context.Publish(new PaymentDeclined(orderId, "Заказ не найден или отменён"), ct);
+            return;
+        }
+
+        // Повторная доставка после успешного списания: деньги второй раз не берём.
+        if (status == OrderStatus.Placed)
+        {
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            timeout.CancelAfter(GatewayTimeout);
+            try
+            {
+                await gateway.ChargeAsync(orderId, amount, timeout.Token);
+            }
+            catch (PaymentDeclinedException ex)
+            {
+                await context.Publish(new PaymentDeclined(orderId, ex.Message), ct);
+                return;
+            }
+            catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+            {
+                // Таймаут шлюза - сбой, а не отказ; сообщение будет повторено.
+                throw new TimeoutException($"Платёжный шлюз не ответил за {GatewayTimeout.TotalSeconds} с, заказ {orderId}");
+            }
+
+            var updated = await orders.UpdateOneAsync(
+                o => o.Id == orderId && o.Status == OrderStatus.Placed,
+                Builders<Order>.Update.Set(o => o.Status, OrderStatus.Paid),
+                cancellationToken: ct);
+            if (updated.ModifiedCount > 0)
+                await context.Publish(new OrderStatusChanged(orderId, OrderStatus.Paid, DateTimeOffset.UtcNow), ct);
+            logger.LogInformation("Платёж по заказу {OrderId} списан", orderId);
+        }
+
+        await context.Publish(new PaymentCaptured(orderId), ct);
+    }
+}
+
+// Пик 10 000 команд/мин (~170/с) при ответе шлюза до 2 с даёт ~340 одновременных вызовов на всех репликах.
+// 3 реплики по PaymentConcurrencyPerReplica (по умолчанию 128) покрывают это с запасом.
+public sealed class CapturePaymentConsumerDefinition : ConsumerDefinition<CapturePaymentConsumer>
+{
+    private readonly int _concurrency;
+
+    public CapturePaymentConsumerDefinition(IOptions<FulfilOptions> options)
+    {
+        _concurrency = options.Value.PaymentConcurrencyPerReplica;
+        ConcurrentMessageLimit = _concurrency;
+    }
+
+    protected override void ConfigureConsumer(
+        IReceiveEndpointConfigurator endpointConfigurator,
+        IConsumerConfigurator<CapturePaymentConsumer> consumerConfigurator,
+        IRegistrationContext context)
+    {
+        if (endpointConfigurator is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.PrefetchCount = _concurrency * 2;
+
+        // Не добиваем лежащий шлюз; сообщения во время паузы ждут в повторах.
+        consumerConfigurator.UseCircuitBreaker(cb =>
+        {
+            cb.TrackingPeriod = TimeSpan.FromMinutes(1);
+            cb.TripThreshold = 15;
+            cb.ActiveThreshold = 10;
+            cb.ResetInterval = TimeSpan.FromSeconds(30);
+        });
+    }
+}
