@@ -0,0 +1,27 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Persistence;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed class ShipOrderConsumer(IMongoDatabase db) : IConsumer<ShipOrder>
+{
+    public async Task Consume(ConsumeContext<ShipOrder> context)
+    {
+        var orderId = context.Message.OrderId;
+        var ct = context.CancellationToken;
+
+        var result = await db.Orders().UpdateOneAsync(
+            o => o.Id == orderId && o.Status == OrderStatus.Paid,
+            Builders<Order>.Update.Set(o => o.Status, OrderStatus.Shipped),
+            cancellationToken: ct);
+
+        if (result.ModifiedCount > 0)
+            await context.Publish(new OrderStatusChanged(orderId, OrderStatus.Shipped, DateTimeOffset.UtcNow), ct);
+
+        // При повторной доставке статус уже Shipped - ответ тот же.
+        await context.Publish(new OrderShipped(orderId), ct);
+    }
+}
diff --git a/src/Fulfil/Consumers/StockConsumers.cs b/src/Fulfil/Consumers/StockConsumers.cs
new file mode 100644
index 0000000..f53855e
--- /dev/null
+++ b/src/Fulfil/Consumers/StockConsumers.cs
@@ -0,0 +1,91 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Persistence;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+public sealed class ReserveStockConsumer(IMongoClient client, IMongoDatabase db) : IConsumer<ReserveStock>
+{
+    private sealed class OutOfStockException(string sku) : Exception
+    {
+        public string Sku { get; } = sku;
+    }
+
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var (orderId, lines) = (context.Message.OrderId, context.Message.Lines);
+        var ct = context.CancellationToken;
+
+        try
+        {
+            using var session = await client.StartSessionAsync(cancellationToken: ct);
+            await session.WithTransactionAsync(async (s, token) =>
+            {
+                // Повторная доставка: резерв уже есть, ничего не списываем второй раз.
+                var existing = await db.Reservations().Find(s, r => r.Id == orderId).FirstOrDefaultAsync(token);
+                if (existing is not null)
+                    return true;
+
+                foreach (var line in lines)
+                {
+                    var filter = Collections.BySku(line.Sku) & Builders<MongoDB.Bson.BsonDocument>.Filter.Gte("Stock", line.Quantity);
+                    var result = await db.Products().UpdateOneAsync(s, filter, Collections.AddStock(-line.Quantity), cancellationToken: token);
+                    if (result.ModifiedCount == 0)
+                        throw new OutOfStockException(line.Sku);
+                }
+
+                await db.Reservations().InsertOneAsync(s, new StockReservation(orderId, lines, false), cancellationToken: token);
+                return true;
+            }, cancellationToken: ct);
+        }
+        catch (OutOfStockException ex)
+        {
+            // Транзакция откатилась целиком.
+            await context.Publish(new StockUnavailable(orderId, ex.Sku), ct);
+            return;
+        }
+
+        await context.Publish(new StockReserved(orderId), ct);
+    }
+}
+
+public sealed class OrderCompensationConsumer(IMongoClient client, IMongoDatabase db)
+    : IConsumer<ReleaseStock>, IConsumer<CancelOrder>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var orderId = context.Message.OrderId;
+        var ct = context.CancellationToken;
+
+        using var session = await client.StartSessionAsync(cancellationToken: ct);
+        await session.WithTransactionAsync(async (s, token) =>
+        {
+            // Released переключается один раз - остаток возвращается ровно один раз.
+            var reservation = await db.Reservations().FindOneAndUpdateAsync(
+                s,
+                r => r.Id == orderId && !r.Released,
+                Builders<StockReservation>.Update.Set(r => r.Released, true),
+                cancellationToken: token);
+            if (reservation is null)
+                return true;
+
+            foreach (var line in reservation.Lines)
+                await db.Products().UpdateOneAsync(s, Collections.BySku(line.Sku), Collections.AddStock(line.Quantity), cancellationToken: token);
+            return true;
+        }, cancellationToken: ct);
+    }
+
+    public async Task Consume(ConsumeContext<CancelOrder> context)
+    {
+        var ct = context.CancellationToken;
+        var result = await db.Orders().UpdateOneAsync(
+            o => o.Id == context.Message.OrderId && o.Status != OrderStatus.Shipped,
+            Builders<Order>.Update.Set(o => o.Status, OrderStatus.Cancelled),
+            cancellationToken: ct);
+
+        if (result.ModifiedCount > 0)
+            await context.Publish(new OrderStatusChanged(context.Message.OrderId, OrderStatus.Cancelled, DateTimeOffset.UtcNow), ct);
+    }
+}
