 namespace Fulfil.Ports;
 
+// Шлюз отклонил платёж (деловой отказ). Любое другое исключение - сбой шлюза, его повторяют.
+public sealed class PaymentDeclinedException(string reason) : Exception(reason);
+
 // Платёжный шлюз: внешний HTTP-сервис, отвечает за 0.3-2 с и иногда падает.
+// orderId служит ключом идемпотентности: реализация не должна списывать дважды за один заказ.
 public interface IPaymentGateway
 {
     Task ChargeAsync(Guid orderId, decimal amount, CancellationToken ct);
diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..99345f6 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,58 @@
+using Fulfil.Consumers;
+using Fulfil.Endpoints;
 using Fulfil.Options;
+using Fulfil.Ports;
+using Fulfil.Sagas;
+using Fulfil.Warehouse;
+using MassTransit;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
 
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(fulfil.MongoConnectionString));
+builder.Services.AddSingleton(sp => sp.GetRequiredService<IMongoClient>().GetDatabase(fulfil.MongoDatabase));
+
+builder.Services.AddMassTransit(x =>
+{
+    x.SetKebabCaseEndpointNameFormatter();
+
+    x.AddConsumer<ReserveStockConsumer>();
+    x.AddConsumer<CapturePaymentConsumer, CapturePaymentConsumerDefinition>();
+    x.AddConsumer<ShipOrderConsumer>();
+    x.AddConsumer<OrderCompensationConsumer>();
+
+    x.AddSagaStateMachine<OrderFulfilmentStateMachine, OrderFulfilmentState>()
+        .MongoDbRepository(r =>
+        {
+            r.Connection = fulfil.MongoConnectionString;
+            r.DatabaseName = fulfil.MongoDatabase;
+            r.CollectionName = "order_sagas";
+        });
+
+    x.UsingRabbitMq((context, cfg) =>
+    {
+        cfg.Host(fulfil.RabbitMqHost, "/", _ => { });
+
+        // Сбой шлюза и Mongo повторяем с нарастающей паузой; отказ платежа - деловой исход, его не повторяем.
+        cfg.UseMessageRetry(r =>
+        {
+            r.Exponential(8, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(2));
+            r.Ignore<PaymentDeclinedException>();
+        });
+        // Результаты уходят в брокер только если обработчик завершился без ошибки. Внутри retry.
+        cfg.UseInMemoryOutbox(context);
+
+        cfg.ConfigureEndpoints(context);
+    });
+});
+
+builder.Services.AddHostedService<WarehouseInboundWorker>();
+
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+app.MapOrderEndpoints();
 app.Run();
diff --git a/src/Fulfil/Sagas/OrderFulfilmentStateMachine.cs b/src/Fulfil/Sagas/OrderFulfilmentStateMachine.cs
new file mode 100644
index 0000000..450cbfe
--- /dev/null
+++ b/src/Fulfil/Sagas/OrderFulfilmentStateMachine.cs
@@ -0,0 +1,76 @@
+using Fulfil.Contracts;
+using MassTransit;
+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Sagas;
+
+public sealed class OrderFulfilmentState : SagaStateMachineInstance, ISagaVersion
+{
+    [BsonId]
+    public Guid CorrelationId { get; set; }
+    public string CurrentState { get; set; } = "";
+    public int Version { get; set; }
+    public decimal Total { get; set; }
+}
+
+// ReserveStock -> CapturePayment -> ShipOrder. Деловые отказы компенсируются; сбои инфраструктуры
+// после исчерпания повторов уходят в *_error очередь и разбираются вручную (исход шага неизвестен).
+public sealed class OrderFulfilmentStateMachine : MassTransitStateMachine<OrderFulfilmentState>
+{
+    public State Reserving { get; private set; } = null!;
+    public State Charging { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> Reserved { get; private set; } = null!;
+    public Event<StockUnavailable> Unavailable { get; private set; } = null!;
+    public Event<PaymentCaptured> Captured { get; private set; } = null!;
+    public Event<PaymentDeclined> Declined { get; private set; } = null!;
+    public Event<OrderShipped> Shipped { get; private set; } = null!;
+
+    public OrderFulfilmentStateMachine()
+    {
+        InstanceState(x => x.CurrentState, Reserving, Charging, Shipping);
+
+        Event(() => Submitted, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Reserved, e => { e.CorrelateById(c => c.Message.OrderId); e.OnMissingInstance(m => m.Discard()); });
+        Event(() => Unavailable, e => { e.CorrelateById(c => c.Message.OrderId); e.OnMissingInstance(m => m.Discard()); });
+        Event(() => Captured, e => { e.CorrelateById(c => c.Message.OrderId); e.OnMissingInstance(m => m.Discard()); });
+        Event(() => Declined, e => { e.CorrelateById(c => c.Message.OrderId); e.OnMissingInstance(m => m.Discard()); });
+        Event(() => Shipped, e => { e.CorrelateById(c => c.Message.OrderId); e.OnMissingInstance(m => m.Discard()); });
+
+        Initially(
+            When(Submitted)
+                .Then(c => c.Saga.Total = c.Message.Total)
+                .Publish(c => new ReserveStock(c.Message.OrderId, c.Message.Lines))
+                .TransitionTo(Reserving));
+
+        During(Reserving,
+            Ignore(Submitted),
+            When(Reserved)
+                .Publish(c => new CapturePayment(c.Saga.CorrelationId, c.Saga.Total))
+                .TransitionTo(Charging),
+            When(Unavailable)
+                .Publish(c => new CancelOrder(c.Saga.CorrelationId, $"Нет товара {c.Message.Sku}"))
+                .Finalize());
+
+        During(Charging,
+            Ignore(Submitted),
+            Ignore(Reserved),
+            When(Captured)
+                .Publish(c => new ShipOrder(c.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(Declined)
+                .Publish(c => new ReleaseStock(c.Saga.CorrelationId))
+                .Publish(c => new CancelOrder(c.Saga.CorrelationId, $"Платёж отклонён: {c.Message.Reason}"))
+                .Finalize());
+
+        During(Shipping,
+            Ignore(Submitted),
+            Ignore(Reserved),
+            Ignore(Captured),
+            When(Shipped).Finalize());
+
+        SetCompletedWhenFinalized();
+    }
+}
diff --git a/src/Fulfil/Warehouse/WarehouseInboundWorker.cs b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
new file mode 100644
index 0000000..31291a1
--- /dev/null
+++ b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
@@ -0,0 +1,159 @@
+using System.Text.Json;
+using Fulfil.Options;
+using Fulfil.Persistence;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+public sealed record WarehouseInboundMessage(string? Sku, int Qty, string? MessageId);
+
+// Читает очередь чужой системы напрямую (не MassTransit): приход товара -> stock в MongoDB,
+// подтверждение уходит в обменник warehouse.outbound. Очередь и обменник принадлежат складу,
+// поэтому объявляются пассивно; пока их нет, воркер повторяет попытки.
+public sealed class WarehouseInboundWorker(
+    IOptions<FulfilOptions> options,
+    IMongoClient client,
+    IMongoDatabase db,
+    ILogger<WarehouseInboundWorker> logger) : BackgroundService
+{
+    private const string InboundQueue = "warehouse.inbound";
+    private const string OutboundExchange = "warehouse.outbound";
+    private const ushort Prefetch = 50;
+
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    private enum Outcome { Applied, Duplicate, UnknownSku }
+
+    private sealed class UnknownSkuException : Exception;
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                await RunAsync(stoppingToken);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+            {
+                return;
+            }
+            catch (Exception ex)
+            {
+                logger.LogWarning(ex, "Подключение к {Queue} не удалось или оборвалось, повтор через 5 с", InboundQueue);
+            }
+
+            await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+        }
+    }
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        // Автовосстановление переживает рестарт брокера; цикл выше нужен, если брокер недоступен на старте.
+        var factory = new ConnectionFactory
+        {
+            HostName = options.Value.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+            ConsumerDispatchConcurrency = Prefetch,
+        };
+
+        await using var connection = await factory.CreateConnectionAsync(ct);
+        await using var consumeChannel = await connection.CreateChannelAsync(cancellationToken: ct);
+        await using var publishChannel = await connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true),
+            ct);
+
+        await consumeChannel.QueueDeclarePassiveAsync(InboundQueue, ct);
+        await publishChannel.ExchangeDeclarePassiveAsync(OutboundExchange, ct);
+        await consumeChannel.BasicQosAsync(0, Prefetch, false, ct);
+
+        var consumer = new AsyncEventingBasicConsumer(consumeChannel);
+        consumer.ReceivedAsync += (_, ea) => HandleAsync(consumeChannel, publishChannel, ea, ct);
+        await consumeChannel.BasicConsumeAsync(InboundQueue, autoAck: false, consumer, ct);
+
+        logger.LogInformation("Слушаю {Queue}", InboundQueue);
+        await Task.Delay(Timeout.Infinite, ct);
+    }
+
+    private async Task HandleAsync(IChannel consumeChannel, IChannel publishChannel, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        try
+        {
+            var message = JsonSerializer.Deserialize<WarehouseInboundMessage>(ea.Body.Span, Json);
+            if (message is not { Sku.Length: > 0, MessageId.Length: > 0, Qty: > 0 })
+            {
+                logger.LogWarning("Некорректное сообщение склада, отклонено");
+                await consumeChannel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+                return;
+            }
+
+            var outcome = await ApplyAsync(message, ct);
+            if (outcome == Outcome.UnknownSku)
+            {
+                logger.LogWarning("Приход по неизвестному sku {Sku}, сообщение {MessageId} отклонено", message.Sku, message.MessageId);
+                await consumeChannel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+                return;
+            }
+
+            // Подтверждение шлём и для дубля: прошлое могло потеряться после коммита. Ack - только после confirm брокера.
+            var body = JsonSerializer.SerializeToUtf8Bytes(new
+            {
+                messageId = message.MessageId,
+                sku = message.Sku,
+                qty = message.Qty,
+                status = outcome == Outcome.Applied ? "applied" : "duplicate",
+            }, Json);
+            await publishChannel.BasicPublishAsync(
+                OutboundExchange,
+                routingKey: "",
+                mandatory: false,
+                basicProperties: new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = message.MessageId },
+                body: body,
+                cancellationToken: ct);
+
+            await consumeChannel.BasicAckAsync(ea.DeliveryTag, false, ct);
+        }
+        catch (JsonException)
+        {
+            logger.LogWarning("Сообщение склада не разобрано как JSON, отклонено");
+            await consumeChannel.BasicNackAsync(ea.DeliveryTag, false, false, ct);
+        }
+        catch (Exception ex) when (!ct.IsCancellationRequested)
+        {
+            // Mongo или брокер недоступны: возвращаем в очередь после паузы, чтобы не крутить цикл.
+            logger.LogError(ex, "Сбой обработки прихода склада, сообщение вернётся в очередь");
+            await Task.Delay(TimeSpan.FromSeconds(1), ct);
+            await consumeChannel.BasicNackAsync(ea.DeliveryTag, false, true, ct);
+        }
+    }
+
+    // Отметка messageId и увеличение stock - одна транзакция: повтор не удвоит приход, сбой не потеряет его.
+    private async Task<Outcome> ApplyAsync(WarehouseInboundMessage message, CancellationToken ct)
+    {
+        try
+        {
+            using var session = await client.StartSessionAsync(cancellationToken: ct);
+            await session.WithTransactionAsync(async (s, token) =>
+            {
+                await db.WarehouseInbound().InsertOneAsync(s, new InboundMessage(message.MessageId!), cancellationToken: token);
+                var result = await db.Products().UpdateOneAsync(s, Collections.BySku(message.Sku!), Collections.AddStock(message.Qty), cancellationToken: token);
+                if (result.MatchedCount == 0)
+                    throw new UnknownSkuException();
+                return true;
+            }, cancellationToken: ct);
+            return Outcome.Applied;
+        }
+        catch (UnknownSkuException)
+        {
+            return Outcome.UnknownSku;
+        }
+        catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            return Outcome.Duplicate;
+        }
+    }
+}
