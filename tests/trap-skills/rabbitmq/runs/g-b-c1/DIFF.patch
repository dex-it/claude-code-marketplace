new file mode 100644
index 0000000..d75d295
--- /dev/null
+++ b/src/Fulfil/Persistence/Collections.cs
@@ -0,0 +1,26 @@
+using Fulfil.Domain;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Persistence;
+
+public sealed record StockReservation(Guid Id, IReadOnlyList<OrderLine> Lines, bool Released);
+
+public sealed record InboundMessage(string Id);
+
+public static class Collections
+{
+    public static IMongoCollection<Order> Orders(this IMongoDatabase db) => db.GetCollection<Order>("orders");
+
+    // Документы товаров читаются как BsonDocument: у Product нет _id, поля - Sku, Stock.
+    public static IMongoCollection<BsonDocument> Products(this IMongoDatabase db) => db.GetCollection<BsonDocument>("products");
+
+    public static IMongoCollection<StockReservation> Reservations(this IMongoDatabase db) => db.GetCollection<StockReservation>("stock_reservations");
+
+    // Обработанные сообщения склада; _id = messageId, защита от повторной доставки.
+    public static IMongoCollection<InboundMessage> WarehouseInbound(this IMongoDatabase db) => db.GetCollection<InboundMessage>("warehouse_inbound");
+
+    public static FilterDefinition<BsonDocument> BySku(string sku) => Builders<BsonDocument>.Filter.Eq("Sku", sku);
+
+    public static UpdateDefinition<BsonDocument> AddStock(int qty) => Builders<BsonDocument>.Update.Inc("Stock", qty);
+}
