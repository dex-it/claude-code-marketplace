diff --git a/src/Fulfil/Fulfilment/Consumers.cs b/src/Fulfil/Fulfilment/Consumers.cs
new file mode 100644
index 0000000..6782130
--- /dev/null
+++ b/src/Fulfil/Fulfilment/Consumers.cs
@@ -0,0 +1,167 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Fulfilment;
+
+public sealed record StockReservation(Guid Id, IReadOnlyList<OrderLine> Lines, bool Released);
+
+public sealed record PaymentRecord(Guid Id, decimal Amount, string Status);
+
+public sealed class InsufficientStockException(string sku) : Exception($"Недостаточно товара {sku}");
+
+// Резерв и возврат резерва идут в одной транзакции MongoDB: частичного резерва не бывает.
+// Повторная доставка ReserveStock находит запись резерва и ничего не списывает второй раз.
+public sealed class ReserveStockConsumer(IMongoClient client, IMongoDatabase db) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var ct = context.CancellationToken;
+        var message = context.Message;
+        var reservations = db.GetCollection<StockReservation>("stock_reservations");
+        var products = db.GetCollection<Product>("products");
+
+        using var session = await client.StartSessionAsync(cancellationToken: ct);
+        try
+        {
+            await session.WithTransactionAsync<bool>(async (s, token) =>
+            {
+                var exists = await reservations.Find(s, r => r.Id == message.OrderId).AnyAsync(token);
+                if (exists)
+                    return true;
+
+                foreach (var line in message.Lines)
+                {
+                    var updated = await products.UpdateOneAsync(
+                        s,
+                        Builders<Product>.Filter.Eq(p => p.Sku, line.Sku) & Builders<Product>.Filter.Gte(p => p.Stock, line.Quantity),
+                        Builders<Product>.Update.Inc(p => p.Stock, -line.Quantity),
+                        cancellationToken: token);
+                    if (updated.ModifiedCount == 0)
+                        throw new InsufficientStockException(line.Sku);
+                }
+
+                await reservations.InsertOneAsync(s, new StockReservation(message.OrderId, message.Lines, false), cancellationToken: token);
+                return true;
+            }, cancellationToken: ct);
+        }
+        catch (InsufficientStockException e)
+        {
+            await context.Publish(new StockReservationFailed(message.OrderId, e.Message), ct);
+            return;
+        }
+
+        await context.Publish(new StockReserved(message.OrderId), ct);
+    }
+}
+
+public sealed class ReleaseStockConsumer(IMongoClient client, IMongoDatabase db) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var ct = context.CancellationToken;
+        var orderId = context.Message.OrderId;
+        var reservations = db.GetCollection<StockReservation>("stock_reservations");
+        var products = db.GetCollection<Product>("products");
+
+        using var session = await client.StartSessionAsync(cancellationToken: ct);
+        await session.WithTransactionAsync<bool>(async (s, token) =>
+        {
+            // Released переключается один раз: повторный ReleaseStock ничего не вернёт дважды.
+            var reservation = await reservations.FindOneAndUpdateAsync(
+                s,
+                r => r.Id == orderId && !r.Released,
+                Builders<StockReservation>.Update.Set(r => r.Released, true),
+                cancellationToken: token);
+            if (reservation is null)
+                return true;
+
+            foreach (var line in reservation.Lines)
+            {
+                await products.UpdateOneAsync(
+                    s,
+                    Builders<Product>.Filter.Eq(p => p.Sku, line.Sku),
+                    Builders<Product>.Update.Inc(p => p.Stock, line.Quantity),
+                    cancellationToken: token);
+            }
+
+            return true;
+        }, cancellationToken: ct);
+    }
+}
+
+// Списание. PaymentDeclinedException - бизнес-отказ, остальные сбои шлюза повторяются политикой retry
+// эндпоинта; когда повторы кончились, сообщение уходит в _error, а сага получает Fault<CapturePayment>.
+// Успешное списание фиксируется в payments, поэтому повторная доставка не списывает деньги второй раз.
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var ct = context.CancellationToken;
+        var message = context.Message;
+        var payments = db.GetCollection<PaymentRecord>("payments");
+
+        var existing = await payments.Find(p => p.Id == message.OrderId).FirstOrDefaultAsync(ct);
+        if (existing?.Status == "Captured")
+        {
+            await context.Publish(new PaymentCaptured(message.OrderId), ct);
+            return;
+        }
+
+        try
+        {
+            await gateway.ChargeAsync(message.OrderId, message.Amount, ct);
+        }
+        catch (PaymentDeclinedException e)
+        {
+            await context.Publish(new PaymentDeclined(message.OrderId, e.Message), ct);
+            return;
+        }
+
+        await payments.ReplaceOneAsync(
+            p => p.Id == message.OrderId,
+            new PaymentRecord(message.OrderId, message.Amount, "Captured"),
+            new ReplaceOptions { IsUpsert = true },
+            ct);
+        await context.Publish(new PaymentCaptured(message.OrderId), ct);
+    }
+}
+
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var ct = context.CancellationToken;
+        var orderId = context.Message.OrderId;
+        var payments = db.GetCollection<PaymentRecord>("payments");
+
+        var payment = await payments.Find(p => p.Id == orderId && p.Status == "Captured").FirstOrDefaultAsync(ct);
+        if (payment is null)
+            return;
+
+        await gateway.RefundAsync(orderId, context.Message.Amount, ct);
+        await payments.UpdateOneAsync(
+            p => p.Id == orderId,
+            Builders<PaymentRecord>.Update.Set(p => p.Status, "Refunded"),
+            cancellationToken: ct);
+    }
+}
+
+// Отгрузка во внешнюю систему задачей не определена: фиксируем факт отгрузки.
+public sealed class ShipOrderConsumer : IConsumer<ShipOrder>
+{
+    public Task Consume(ConsumeContext<ShipOrder> context) =>
+        context.Publish(new OrderShipped(context.Message.OrderId), context.CancellationToken);
+}
+
+// Проекция статуса в коллекцию orders.
+public sealed class OrderStatusConsumer(IMongoDatabase db) : IConsumer<OrderStatusChanged>
+{
+    public Task Consume(ConsumeContext<OrderStatusChanged> context) =>
+        db.GetCollection<Order>("orders").UpdateOneAsync(
+            o => o.Id == context.Message.OrderId,
+            Builders<Order>.Update.Set(o => o.Status, context.Message.Status),
+            cancellationToken: context.CancellationToken);
+}
diff --git a/src/Fulfil/Fulfilment/MessagingSetup.cs b/src/Fulfil/Fulfilment/MessagingSetup.cs
new file mode 100644
index 0000000..58b4de9
--- /dev/null
+++ b/src/Fulfil/Fulfilment/MessagingSetup.cs
@@ -0,0 +1,71 @@
+using Fulfil.Contracts;
+using Fulfil.Options;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Fulfilment;
+
+public static class MessagingSetup
+{
+    public static IServiceCollection AddFulfilMessaging(this IServiceCollection services, FulfilOptions options)
+    {
+        var prefetch = options.DefaultPrefetch;
+
+        services.AddMassTransit(x =>
+        {
+            x.SetKebabCaseEndpointNameFormatter();
+
+            // Outbox/inbox в MongoDB: публикация из консьюмеров и саги атомарна с их записью в БД,
+            // повторная доставка уже обработанного сообщения отсекается.
+            x.AddMongoDbOutbox(o =>
+            {
+                o.ClientFactory(p => p.GetRequiredService<IMongoClient>());
+                o.DatabaseFactory(p => p.GetRequiredService<IMongoDatabase>());
+                o.QueryDelay = TimeSpan.FromSeconds(1);
+                o.UseBusOutbox();
+            });
+
+            x.AddConfigureEndpointsCallback((context, _, cfg) =>
+            {
+                cfg.UseMessageRetry(r => r.Exponential(6, TimeSpan.FromSeconds(1), TimeSpan.FromMinutes(1), TimeSpan.FromSeconds(2)));
+                cfg.UseMongoDbOutbox(context);
+            });
+
+            x.AddConsumer<ReserveStockConsumer>().Endpoint(e => { e.Name = Queues.ReserveStock; e.PrefetchCount = prefetch; });
+            x.AddConsumer<ReleaseStockConsumer>().Endpoint(e => { e.Name = Queues.ReleaseStock; e.PrefetchCount = prefetch; });
+            x.AddConsumer<RefundPaymentConsumer>().Endpoint(e => { e.Name = Queues.RefundPayment; e.PrefetchCount = prefetch; });
+            x.AddConsumer<ShipOrderConsumer>().Endpoint(e => { e.Name = Queues.ShipOrder; e.PrefetchCount = prefetch; });
+            x.AddConsumer<OrderStatusConsumer>().Endpoint(e => e.PrefetchCount = prefetch);
+
+            // Prefetch равен лимиту параллелизма: в памяти пода не больше обрабатываемых сообщений.
+            x.AddConsumer<CapturePaymentConsumer>().Endpoint(e =>
+            {
+                e.Name = Queues.CapturePayment;
+                e.ConcurrentMessageLimit = options.CapturePaymentConcurrency;
+                e.PrefetchCount = options.CapturePaymentConcurrency;
+            });
+
+            x.AddSagaStateMachine<OrderFulfilmentStateMachine, OrderFulfilmentState>()
+                .Endpoint(e => e.PrefetchCount = prefetch)
+                .MongoDbRepository(r =>
+                {
+                    r.Connection = options.MongoConnectionString;
+                    r.DatabaseName = options.MongoDatabase;
+                    r.CollectionName = "order_fulfilment";
+                });
+
+            x.UsingRabbitMq((context, cfg) =>
+            {
+                cfg.Host(options.RabbitMqHost, "/", h =>
+                {
+                    h.Username(options.RabbitMqUser);
+                    h.Password(options.RabbitMqPassword);
+                });
+                cfg.PrefetchCount = prefetch;
+                cfg.ConfigureEndpoints(context);
+            });
+        });
+
+        return services;
+    }
+}
diff --git a/src/Fulfil/Fulfilment/OrderFulfilmentStateMachine.cs b/src/Fulfil/Fulfilment/OrderFulfilmentStateMachine.cs
new file mode 100644
index 0000000..30905c2
--- /dev/null
+++ b/src/Fulfil/Fulfilment/OrderFulfilmentStateMachine.cs
@@ -0,0 +1,96 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Fulfilment;
+
+public sealed class OrderFulfilmentState : SagaStateMachineInstance, ISagaVersion
+{
+    [BsonId]
+    public Guid CorrelationId { get; set; }
+    public string CurrentState { get; set; } = "";
+    public decimal Amount { get; set; }
+    public int Version { get; set; }
+}
+
+// Сага: резерв -> списание -> отгрузка. Сбой шага откатывает выполненные до него шаги.
+public sealed class OrderFulfilmentStateMachine : MassTransitStateMachine<OrderFulfilmentState>
+{
+    public State Reserving { get; private set; } = null!;
+    public State Capturing { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> StockReservedEvent { get; private set; } = null!;
+    public Event<StockReservationFailed> StockReservationFailedEvent { get; private set; } = null!;
+    public Event<Fault<ReserveStock>> ReserveStockFaulted { get; private set; } = null!;
+    public Event<PaymentCaptured> PaymentCapturedEvent { get; private set; } = null!;
+    public Event<PaymentDeclined> PaymentDeclinedEvent { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CapturePaymentFaulted { get; private set; } = null!;
+    public Event<OrderShipped> OrderShippedEvent { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipOrderFaulted { get; private set; } = null!;
+
+    public OrderFulfilmentStateMachine()
+    {
+        InstanceState(x => x.CurrentState, Reserving, Capturing, Shipping);
+
+        Event(() => Submitted, e => e.CorrelateById(m => m.Message.OrderId).SelectId(m => m.Message.OrderId));
+        Event(() => StockReservedEvent, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => StockReservationFailedEvent, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => ReserveStockFaulted, e => e.CorrelateById(m => m.Message.Message.OrderId));
+        Event(() => PaymentCapturedEvent, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => PaymentDeclinedEvent, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => CapturePaymentFaulted, e => e.CorrelateById(m => m.Message.Message.OrderId));
+        Event(() => OrderShippedEvent, e => e.CorrelateById(m => m.Message.OrderId));
+        Event(() => ShipOrderFaulted, e => e.CorrelateById(m => m.Message.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(ctx => ctx.Saga.Amount = ctx.Message.Amount)
+                .Send(Queues.Address(Queues.ReserveStock), ctx => new ReserveStock(ctx.Message.OrderId, ctx.Message.Lines))
+                .TransitionTo(Reserving));
+
+        During(Reserving,
+            When(StockReservedEvent)
+                .Send(Queues.Address(Queues.CapturePayment), ctx => new CapturePayment(ctx.Saga.CorrelationId, ctx.Saga.Amount))
+                .TransitionTo(Capturing),
+            // Резерв атомарен: при отказе откатывать нечего.
+            When(StockReservationFailedEvent)
+                .Publish(ctx => Changed(ctx.Saga.CorrelationId, OrderStatus.Cancelled))
+                .Finalize(),
+            When(ReserveStockFaulted)
+                .Publish(ctx => Changed(ctx.Saga.CorrelationId, OrderStatus.Cancelled))
+                .Finalize());
+
+        During(Capturing,
+            When(PaymentCapturedEvent)
+                .Publish(ctx => Changed(ctx.Saga.CorrelationId, OrderStatus.Paid))
+                .Send(Queues.Address(Queues.ShipOrder), ctx => new ShipOrder(ctx.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(PaymentDeclinedEvent)
+                .Send(Queues.Address(Queues.ReleaseStock), ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .Publish(ctx => Changed(ctx.Saga.CorrelationId, OrderStatus.Cancelled))
+                .Finalize(),
+            // Шлюз так и не ответил после всех повторов: деньги не списаны, возвращаем резерв.
+            When(CapturePaymentFaulted)
+                .Send(Queues.Address(Queues.ReleaseStock), ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .Publish(ctx => Changed(ctx.Saga.CorrelationId, OrderStatus.Cancelled))
+                .Finalize());
+
+        During(Shipping,
+            When(OrderShippedEvent)
+                .Publish(ctx => Changed(ctx.Saga.CorrelationId, OrderStatus.Shipped))
+                .Finalize(),
+            When(ShipOrderFaulted)
+                .Send(Queues.Address(Queues.RefundPayment), ctx => new RefundPayment(ctx.Saga.CorrelationId, ctx.Saga.Amount))
+                .Send(Queues.Address(Queues.ReleaseStock), ctx => new ReleaseStock(ctx.Saga.CorrelationId))
+                .Publish(ctx => Changed(ctx.Saga.CorrelationId, OrderStatus.Cancelled))
+                .Finalize());
+
+        SetCompletedWhenFinalized();
+    }
+
+    private static OrderStatusChanged Changed(Guid orderId, OrderStatus status) =>
+        new(orderId, status, DateTimeOffset.UtcNow);
+}
