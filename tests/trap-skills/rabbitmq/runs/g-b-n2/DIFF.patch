@@ -0,0 +1,176 @@
+using System.Text;
+using System.Text.Json;
+using Fulfil.Domain;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+public sealed record InboundMessage(string? Sku, int Qty, string? MessageId);
+
+public sealed record ProcessedInbound(string Id, string Status);
+
+// Приход товара из чужой очереди warehouse.inbound (не MassTransit). Реплик несколько - это конкурирующие
+// консьюмеры; повторы отсекаются по messageId. Порядок: stock в MongoDB -> подтверждение в
+// warehouse.outbound (с publisher confirm) -> ack. Падение до ack даёт повторную доставку, а для
+// уже обработанного messageId подтверждение просто отправляется ещё раз.
+public sealed class WarehouseInboundService(
+    IOptions<FulfilOptions> options,
+    IMongoClient mongo,
+    IMongoDatabase db,
+    ILogger<WarehouseInboundService> logger) : BackgroundService
+{
+    private const string InboundQueue = "warehouse.inbound";
+    private const string OutboundExchange = "warehouse.outbound";
+
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    private IConnection? _connection;
+    private IChannel? _inbound;
+    private IChannel? _outbound;
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        var o = options.Value;
+        var factory = new ConnectionFactory
+        {
+            HostName = o.RabbitMqHost,
+            UserName = o.RabbitMqUser,
+            Password = o.RabbitMqPassword,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+            NetworkRecoveryInterval = TimeSpan.FromSeconds(5),
+        };
+
+        // Брокер может быть ещё недоступен (рестарт стенда): пробуем, пока не подключимся.
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                _connection = await factory.CreateConnectionAsync("fulfil-warehouse-inbound", stoppingToken);
+                _inbound = await _connection.CreateChannelAsync(cancellationToken: stoppingToken);
+                _outbound = await _connection.CreateChannelAsync(
+                    new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true),
+                    stoppingToken);
+
+                // Очередь и обменник принадлежат складской системе: не объявляем, а проверяем.
+                await _inbound.QueueDeclarePassiveAsync(InboundQueue, stoppingToken);
+                await _outbound.ExchangeDeclarePassiveAsync(OutboundExchange, stoppingToken);
+
+                await _inbound.BasicQosAsync(0, o.WarehouseInboundPrefetch, false, stoppingToken);
+
+                var consumer = new AsyncEventingBasicConsumer(_inbound);
+                consumer.ReceivedAsync += (_, ea) => HandleAsync(ea, stoppingToken);
+                await _inbound.BasicConsumeAsync(InboundQueue, autoAck: false, consumer: consumer, cancellationToken: stoppingToken);
+                logger.LogInformation("Подписка на {Queue} активна, prefetch {Prefetch}", InboundQueue, o.WarehouseInboundPrefetch);
+                break;
+            }
+            catch (Exception e) when (!stoppingToken.IsCancellationRequested)
+            {
+                logger.LogWarning(e, "Не удалось подписаться на {Queue}, повтор через 5 с", InboundQueue);
+                await DisposeChannelsAsync();
+                await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+            }
+        }
+
+        try
+        {
+            await Task.Delay(Timeout.Infinite, stoppingToken);
+        }
+        catch (OperationCanceledException)
+        {
+        }
+    }
+
+    private async Task HandleAsync(BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        var channel = _inbound!;
+        InboundMessage? message;
+        try
+        {
+            message = JsonSerializer.Deserialize<InboundMessage>(ea.Body.Span, Json);
+        }
+        catch (JsonException)
+        {
+            message = null;
+        }
+
+        if (message is not { Sku: { Length: > 0 }, MessageId: { Length: > 0 }, Qty: > 0 })
+        {
+            // Ядовитое сообщение: повтор не поможет. Без DLX на стороне склада оно будет потеряно, поэтому в лог.
+            logger.LogWarning("Некорректное сообщение в {Queue}, отклонено (тег {Tag})", InboundQueue, ea.DeliveryTag);
+            await channel.BasicRejectAsync(ea.DeliveryTag, requeue: false, ct);
+            return;
+        }
+
+        try
+        {
+            var status = await ApplyAsync(message, ct);
+            await ConfirmAsync(message, status, ct);
+            await channel.BasicAckAsync(ea.DeliveryTag, multiple: false, ct);
+        }
+        catch (Exception e) when (!ct.IsCancellationRequested)
+        {
+            logger.LogError(e, "Сбой обработки прихода {MessageId}, сообщение возвращено в очередь", message.MessageId);
+            await Task.Delay(TimeSpan.FromSeconds(2), CancellationToken.None);
+            await channel.BasicNackAsync(ea.DeliveryTag, multiple: false, requeue: true, CancellationToken.None);
+        }
+    }
+
+    // Возвращает итоговый статус; для уже обработанного messageId - статус первой обработки.
+    private async Task<string> ApplyAsync(InboundMessage message, CancellationToken ct)
+    {
+        var processed = db.GetCollection<ProcessedInbound>("warehouse_inbound_processed");
+        var products = db.GetCollection<Product>("products");
+
+        using var session = await mongo.StartSessionAsync(cancellationToken: ct);
+        return await session.WithTransactionAsync<string>(async (s, token) =>
+        {
+            var previous = await processed.Find(s, p => p.Id == message.MessageId).FirstOrDefaultAsync(token);
+            if (previous is not null)
+                return previous.Status;
+
+            var result = await products.UpdateOneAsync(
+                s,
+                Builders<Product>.Filter.Eq(p => p.Sku, message.Sku),
+                Builders<Product>.Update.Inc(p => p.Stock, message.Qty),
+                cancellationToken: token);
+            var status = result.MatchedCount == 0 ? "unknown-sku" : "applied";
+
+            await processed.InsertOneAsync(s, new ProcessedInbound(message.MessageId!, status), cancellationToken: token);
+            return status;
+        }, cancellationToken: ct);
+    }
+
+    private async Task ConfirmAsync(InboundMessage message, string status, CancellationToken ct)
+    {
+        var body = JsonSerializer.SerializeToUtf8Bytes(
+            new { messageId = message.MessageId, sku = message.Sku, qty = message.Qty, status }, Json);
+        var properties = new BasicProperties
+        {
+            ContentType = "application/json",
+            DeliveryMode = DeliveryModes.Persistent,
+            MessageId = Guid.NewGuid().ToString(),
+            CorrelationId = message.MessageId,
+        };
+        await _outbound!.BasicPublishAsync(OutboundExchange, routingKey: string.Empty, mandatory: false, properties, body, ct);
+    }
+
+    public override async Task StopAsync(CancellationToken cancellationToken)
+    {
+        await base.StopAsync(cancellationToken);
+        await DisposeChannelsAsync();
+    }
+
+    private async Task DisposeChannelsAsync()
+    {
+        if (_inbound is not null) await _inbound.DisposeAsync();
+        if (_outbound is not null) await _outbound.DisposeAsync();
+        if (_connection is not null) await _connection.DisposeAsync();
+        _inbound = _outbound = null;
+        _connection = null;
+    }
+}
