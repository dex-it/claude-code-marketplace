diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..06a1397 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,53 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Fulfilment;
 using Fulfil.Options;
+using Fulfil.Warehouse;
+using MassTransit.MongoDbIntegration;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization;
+using MongoDB.Bson.Serialization.Serializers;
+using MongoDB.Driver;
+
+BsonSerializer.RegisterSerializer(new GuidSerializer(GuidRepresentation.Standard));
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
 
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(fulfil.MongoConnectionString));
+builder.Services.AddSingleton(p => p.GetRequiredService<IMongoClient>().GetDatabase(fulfil.MongoDatabase));
+builder.Services.AddFulfilMessaging(fulfil);
+builder.Services.AddHostedService<WarehouseInboundService>();
+
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+
+// Смена статуса заказа и OrderSubmitted попадают в MongoDB одной транзакцией (outbox MassTransit);
+// брокер получает событие уже из outbox, поэтому падение между шагами событие не теряет.
+app.MapPost("/orders/{id:guid}/submit", async (
+    Guid id, MongoDbContext dbContext, IPublishEndpoint publish, CancellationToken ct) =>
+{
+    await dbContext.BeginTransaction(ct);
+
+    var order = await dbContext.Database.GetCollection<Order>("orders").FindOneAndUpdateAsync(
+        dbContext.Session,
+        o => o.Id == id && o.Status == OrderStatus.Placed,
+        Builders<Order>.Update.Set(o => o.Status, OrderStatus.Submitted),
+        new FindOneAndUpdateOptions<Order> { ReturnDocument = ReturnDocument.After },
+        ct);
+
+    if (order is null)
+    {
+        await dbContext.RollbackTransaction(ct);
+        var exists = await dbContext.Database.GetCollection<Order>("orders").Find(o => o.Id == id).AnyAsync(ct);
+        return exists ? Results.Conflict("Заказ уже передан в исполнение") : Results.NotFound();
+    }
+
+    await publish.Publish(new OrderSubmitted(order.Id, order.CustomerId, order.Lines, order.Total), ct);
+    await dbContext.CommitTransaction(ct);
+    return Results.Accepted($"/orders/{id}");
+});
+
 app.Run();
