     public string KafkaBootstrapServers { get; set; } = "localhost:9092";
     public string RabbitMqHost { get; set; } = "localhost";
     public string RedisConfiguration { get; set; } = "localhost:6379";
-    public string MongoConnectionString { get; set; } = "mongodb://localhost:27017";
+    // Транзакции MongoDB (outbox, приход товара) требуют replica set.
+    public string MongoConnectionString { get; set; } = "mongodb://localhost:27017/?replicaSet=rs0&directConnection=true";
     public string MongoDatabase { get; set; } = "fulfil";
     public string ElasticUri { get; set; } = "http://localhost:9200";
+
+    // Пик 10 000 команд/мин (~170/с) при ответе шлюза до 2 с даёт ~340 одновременных вызовов
+    // на все реплики (3 шт.): по 160 на под с запасом. Prefetch ограничивает backlog в памяти пода.
+    public int PaymentConcurrency { get; set; } = 160;
+    public ushort PaymentPrefetch { get; set; } = 200;
+
+    // Интеграция со складом (чужая очередь, не MassTransit).
+    public string WarehouseInboundQueue { get; set; } = "warehouse.inbound";
+    public string WarehouseInboundErrorQueue { get; set; } = "warehouse.inbound.error";
+    public string WarehouseOutboundExchange { get; set; } = "warehouse.outbound";
+    public string WarehouseOutboundRoutingKey { get; set; } = "inbound.confirmed";
+    public ushort WarehousePrefetch { get; set; } = 50;
 }
