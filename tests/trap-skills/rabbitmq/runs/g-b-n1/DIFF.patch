diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..e3ef830 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,95 @@
+using Fulfil.Consumers;
+using Fulfil.Contracts;
+using Fulfil.Domain;
 using Fulfil.Options;
+using Fulfil.Saga;
+using Fulfil.Warehouse;
+using MassTransit;
+using MassTransit.MongoDbIntegration;
+using MongoDB.Driver;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
 
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(fulfil.MongoConnectionString));
+builder.Services.AddSingleton(sp => sp.GetRequiredService<IMongoClient>().GetDatabase(fulfil.MongoDatabase));
+
+builder.Services.AddMassTransit(x =>
+{
+    // Сохранение заказа и публикация OrderSubmitted идут в одной транзакции MongoDB через outbox;
+    // тот же outbox/inbox защищает консьюмеры и сагу от потери и дублей сообщений.
+    x.AddMongoDbOutbox(o =>
+    {
+        o.QueryDelay = TimeSpan.FromSeconds(1);
+        o.ClientFactory(p => p.GetRequiredService<IMongoClient>());
+        o.DatabaseFactory(p => p.GetRequiredService<IMongoDatabase>());
+        o.DuplicateDetectionWindow = TimeSpan.FromMinutes(30);
+        o.UseBusOutbox();
+    });
+
+    x.AddConsumer<ReserveStockConsumer>().Endpoint(e => e.Name = Queues.ReserveStock);
+    x.AddConsumer<ReleaseStockConsumer>().Endpoint(e => e.Name = Queues.ReleaseStock);
+    x.AddConsumer<CapturePaymentConsumer, CapturePaymentConsumerDefinition>();
+    x.AddConsumer<RefundPaymentConsumer>().Endpoint(e => e.Name = Queues.RefundPayment);
+    x.AddConsumer<ShipOrderConsumer>().Endpoint(e => e.Name = Queues.ShipOrder);
+    x.AddConsumer<OrderStatusChangedConsumer>().Endpoint(e => e.Name = "fulfil.order-status");
+
+    x.AddSagaStateMachine<OrderFulfilmentStateMachine, OrderFulfilmentState>()
+        .MongoDbRepository(r =>
+        {
+            r.Connection = fulfil.MongoConnectionString;
+            r.DatabaseName = fulfil.MongoDatabase;
+            r.CollectionName = "order_fulfilment_sagas";
+        });
+
+    x.UsingRabbitMq((context, cfg) =>
+    {
+        cfg.Host(fulfil.RabbitMqHost);
+        // Сбой обработчика не должен терять сообщение: после повторов оно уходит в _error-очередь, а сага получает Fault<T>.
+        cfg.UseMessageRetry(r => r.Intervals(100, 500, 1000));
+        cfg.ConfigureEndpoints(context);
+    });
+});
+
+builder.Services.AddHostedService<WarehouseInboundWorker>();
+
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+
+app.MapPost("/orders/{id:guid}/submit", async (
+    Guid id,
+    SubmitOrderRequest request,
+    MongoDbContext dbContext,
+    IPublishEndpoint publish,
+    TimeProvider time,
+    CancellationToken ct) =>
+{
+    if (request.Lines is not { Count: > 0 } || request.Lines.Any(l => l.Quantity <= 0))
+        return Results.BadRequest("Заказ должен содержать позиции с положительным количеством");
+
+    var order = new Order(id, request.CustomerId, OrderStatus.Placed, request.Lines, time.GetUtcNow());
+
+    // Заказ и исходящее событие фиксируются одной транзакцией: публикация уходит в outbox,
+    // а брокеру её отправляет фоновая доставка. Падение посередине не теряет событие.
+    await dbContext.BeginTransaction(ct);
+    try
+    {
+        await dbContext.GetCollection<Order>("orders").InsertOneAsync(dbContext.Session, order, cancellationToken: ct);
+    }
+    catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
+    {
+        await dbContext.Session.AbortTransactionAsync(ct);
+        return Results.Conflict("Заказ уже отправлен");
+    }
+
+    await publish.Publish(new OrderSubmitted(order.Id, order.CustomerId, order.Lines, order.Total, order.PlacedAt), ct);
+    await dbContext.CommitTransaction(ct);
+
+    return Results.Accepted($"/orders/{id}");
+});
+
 app.Run();
+
+public sealed record SubmitOrderRequest(Guid CustomerId, List<OrderLine> Lines);
diff --git a/src/Fulfil/Saga/OrderFulfilmentStateMachine.cs b/src/Fulfil/Saga/OrderFulfilmentStateMachine.cs
new file mode 100644
index 0000000..7cad9c4
--- /dev/null
+++ b/src/Fulfil/Saga/OrderFulfilmentStateMachine.cs
@@ -0,0 +1,101 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+
+namespace Fulfil.Saga;
+
+public sealed class OrderFulfilmentState : SagaStateMachineInstance, ISagaVersion
+{
+    public Guid CorrelationId { get; set; }
+    public int Version { get; set; }
+    public string CurrentState { get; set; } = "";
+    public decimal Total { get; set; }
+    public bool PaymentCaptured { get; set; }
+}
+
+// Резерв -> списание -> отгрузка. Сбой шага откатывает уже выполненные:
+// отказ платежа снимает резерв; сбой отгрузки возвращает деньги и снимает резерв.
+public sealed class OrderFulfilmentStateMachine : MassTransitStateMachine<OrderFulfilmentState>
+{
+    public State ReservingStock { get; private set; } = null!;
+    public State CapturingPayment { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> Reserved { get; private set; } = null!;
+    public Event<StockReservationFailed> ReservationFailed { get; private set; } = null!;
+    public Event<PaymentCaptured> Captured { get; private set; } = null!;
+    public Event<PaymentDeclined> Declined { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CaptureFaulted { get; private set; } = null!;
+    public Event<OrderShipped> Shipped { get; private set; } = null!;
+    public Event<Fault<ShipOrder>> ShipFaulted { get; private set; } = null!;
+    public Event<Fault<ReserveStock>> ReserveFaulted { get; private set; } = null!;
+
+    public OrderFulfilmentStateMachine()
+    {
+        InstanceState(x => x.CurrentState);
+
+        Event(() => Submitted, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Reserved, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ReservationFailed, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Captured, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Declined, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => CaptureFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => Shipped, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ShipFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => ReserveFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(c => c.Saga.Total = c.Message.Total)
+                .Send(Queues.Address(Queues.ReserveStock), c => new ReserveStock(c.Message.OrderId, c.Message.Lines))
+                .TransitionTo(ReservingStock));
+
+        During(ReservingStock,
+            When(Reserved)
+                .Send(Queues.Address(Queues.CapturePayment), c => new CapturePayment(c.Saga.CorrelationId, c.Saga.Total))
+                .TransitionTo(CapturingPayment),
+            // Резерв транзакционный: при отказе или сбое ничего не осталось, откатывать нечего.
+            When(ReservationFailed)
+                .PublishAsync(c => c.Init<OrderStatusChanged>(Cancelled(c.Saga.CorrelationId)))
+                .Finalize(),
+            When(ReserveFaulted)
+                .PublishAsync(c => c.Init<OrderStatusChanged>(Cancelled(c.Saga.CorrelationId)))
+                .Finalize());
+
+        During(CapturingPayment,
+            When(Captured)
+                .Then(c => c.Saga.PaymentCaptured = true)
+                .PublishAsync(c => c.Init<OrderStatusChanged>(
+                    new { OrderId = c.Saga.CorrelationId, Status = OrderStatus.Paid, ChangedAt = DateTimeOffset.UtcNow }))
+                .Send(Queues.Address(Queues.ShipOrder), c => new ShipOrder(c.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            When(Declined)
+                .Send(Queues.Address(Queues.ReleaseStock), c => new ReleaseStock(c.Saga.CorrelationId))
+                .PublishAsync(c => c.Init<OrderStatusChanged>(Cancelled(c.Saga.CorrelationId)))
+                .Finalize(),
+            // Шлюз недоступен после всех повторов: исход списания неизвестен, поэтому
+            // возврат тоже отправляется (RefundPayment ничего не делает, если списания не было).
+            When(CaptureFaulted)
+                .Send(Queues.Address(Queues.RefundPayment), c => new RefundPayment(c.Saga.CorrelationId, c.Saga.Total))
+                .Send(Queues.Address(Queues.ReleaseStock), c => new ReleaseStock(c.Saga.CorrelationId))
+                .PublishAsync(c => c.Init<OrderStatusChanged>(Cancelled(c.Saga.CorrelationId)))
+                .Finalize());
+
+        During(Shipping,
+            When(Shipped)
+                .PublishAsync(c => c.Init<OrderStatusChanged>(
+                    new { OrderId = c.Saga.CorrelationId, Status = OrderStatus.Shipped, ChangedAt = DateTimeOffset.UtcNow }))
+                .Finalize(),
+            When(ShipFaulted)
+                .Send(Queues.Address(Queues.RefundPayment), c => new RefundPayment(c.Saga.CorrelationId, c.Saga.Total))
+                .Send(Queues.Address(Queues.ReleaseStock), c => new ReleaseStock(c.Saga.CorrelationId))
+                .PublishAsync(c => c.Init<OrderStatusChanged>(Cancelled(c.Saga.CorrelationId)))
+                .Finalize());
+
+        SetCompletedWhenFinalized();
+    }
+
+    private static object Cancelled(Guid orderId) =>
+        new { OrderId = orderId, Status = OrderStatus.Cancelled, ChangedAt = DateTimeOffset.UtcNow };
+}
diff --git a/src/Fulfil/Warehouse/WarehouseInboundWorker.cs b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
new file mode 100644
index 0000000..66a4046
--- /dev/null
+++ b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
@@ -0,0 +1,162 @@
+using System.Text;
+using System.Text.Json;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+public sealed record WarehouseInbound(string? Sku, int Qty, string? MessageId);
+
+// Читает приход товара из чужой очереди warehouse.inbound (не MassTransit).
+// Реплик несколько - они конкурируют за сообщения. Ack только после записи в MongoDB;
+// повторная доставка безопасна: приход применяется один раз по messageId (транзакция: маркер + $inc).
+public sealed class WarehouseInboundWorker(
+    IOptions<FulfilOptions> options,
+    IMongoClient mongo,
+    IMongoDatabase db,
+    ILogger<WarehouseInboundWorker> logger) : BackgroundService
+{
+    private static readonly JsonSerializerOptions Json = new() { PropertyNameCaseInsensitive = true };
+    private readonly FulfilOptions _o = options.Value;
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                await RunAsync(stoppingToken);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+            {
+                return;
+            }
+            catch (Exception ex)
+            {
+                // Брокер перезапускается при обновлении стенда: переподключаемся, а не падаем.
+                logger.LogWarning(ex, "Потеряно соединение со складской очередью, повтор через 5 с");
+                await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken);
+            }
+        }
+    }
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        var factory = new ConnectionFactory
+        {
+            HostName = _o.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+        };
+        await using var connection = await factory.CreateConnectionAsync("fulfil-warehouse-inbound", ct);
+        await using var channel = await connection.CreateChannelAsync(
+            new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true), ct);
+
+        // Очередь входящих принадлежит складу: не объявляем её, а только проверяем наличие.
+        await channel.QueueDeclarePassiveAsync(_o.WarehouseInboundQueue, ct);
+        // Своя очередь для нечитаемых сообщений, чтобы они не терялись и не крутились по кругу.
+        await channel.QueueDeclareAsync(_o.WarehouseInboundErrorQueue, durable: true, exclusive: false, autoDelete: false, cancellationToken: ct);
+        await channel.BasicQosAsync(0, _o.WarehousePrefetch, false, ct);
+
+        var consumer = new AsyncEventingBasicConsumer(channel);
+        consumer.ReceivedAsync += async (_, ea) =>
+        {
+            try
+            {
+                await HandleAsync(channel, ea, ct);
+            }
+            catch (Exception ex) when (!ct.IsCancellationRequested)
+            {
+                // Временный сбой (например, MongoDB): вернуть в очередь, не терять.
+                logger.LogWarning(ex, "Сбой обработки прихода, сообщение возвращено в очередь");
+                await channel.BasicNackAsync(ea.DeliveryTag, false, true, CancellationToken.None);
+                await Task.Delay(TimeSpan.FromSeconds(1), ct);
+            }
+        };
+
+        await channel.BasicConsumeAsync(_o.WarehouseInboundQueue, autoAck: false, consumer, ct);
+
+        // Обрывы связи переживает автовосстановление клиента; цикл в ExecuteAsync нужен при полном отказе.
+        var closed = new TaskCompletionSource();
+        using var reg = ct.Register(() => closed.TrySetResult());
+        await closed.Task;
+    }
+
+    private async Task HandleAsync(IChannel channel, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        WarehouseInbound? msg = null;
+        try
+        {
+            msg = JsonSerializer.Deserialize<WarehouseInbound>(ea.Body.Span, Json);
+        }
+        catch (JsonException)
+        {
+        }
+
+        if (msg is not { Sku: { Length: > 0 }, MessageId: { Length: > 0 }, Qty: > 0 })
+        {
+            await Park(channel, ea, "invalid", ct);
+            return;
+        }
+
+        var applied = await ApplyAsync(msg, ct);
+        if (applied is null)
+        {
+            await Park(channel, ea, "unknown-sku", ct);
+            return;
+        }
+
+        // Подтверждение складу публикуем до ack входящего: при падении между ними приход
+        // придёт повторно, дубль не применится, а подтверждение уйдёт ещё раз (at-least-once).
+        var confirm = JsonSerializer.SerializeToUtf8Bytes(new { messageId = msg.MessageId, sku = msg.Sku, qty = msg.Qty, status = "applied" });
+        await channel.BasicPublishAsync(_o.WarehouseOutboundExchange, _o.WarehouseOutboundRoutingKey, mandatory: false,
+            basicProperties: new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = msg.MessageId },
+            body: confirm, cancellationToken: ct);
+
+        await channel.BasicAckAsync(ea.DeliveryTag, false, ct);
+    }
+
+    // true - применено, false - дубликат, null - неизвестный sku.
+    private async Task<bool?> ApplyAsync(WarehouseInbound msg, CancellationToken ct)
+    {
+        var products = db.GetCollection<BsonDocument>("products");
+        var processed = db.GetCollection<BsonDocument>("warehouse_inbound_processed");
+
+        using var session = await mongo.StartSessionAsync(cancellationToken: ct);
+        return await session.WithTransactionAsync<bool?>(async (s, token) =>
+        {
+            try
+            {
+                await processed.InsertOneAsync(s, new BsonDocument { { "_id", msg.MessageId }, { "at", DateTime.UtcNow } }, cancellationToken: token);
+            }
+            catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
+            {
+                return false;
+            }
+
+            var res = await products.UpdateOneAsync(s,
+                new BsonDocument("_id", msg.Sku),
+                new BsonDocument("$inc", new BsonDocument("stock", msg.Qty)),
+                cancellationToken: token);
+            if (res.MatchedCount == 0)
+            {
+                await s.AbortTransactionAsync(token);
+                return null;
+            }
+            return true;
+        }, cancellationToken: ct);
+    }
+
+    private async Task Park(IChannel channel, BasicDeliverEventArgs ea, string reason, CancellationToken ct)
+    {
+        logger.LogWarning("Сообщение прихода отклонено ({Reason}), перенос в {Queue}", reason, _o.WarehouseInboundErrorQueue);
+        await channel.BasicPublishAsync(string.Empty, _o.WarehouseInboundErrorQueue, mandatory: true,
+            basicProperties: new BasicProperties { Persistent = true, Headers = new Dictionary<string, object?> { ["x-reason"] = reason } },
+            body: ea.Body, cancellationToken: ct);
+        await channel.BasicAckAsync(ea.DeliveryTag, false, ct);
+    }
+}
