@@ -0,0 +1,34 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MassTransit;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+// Отгрузка: внешнего порта отгрузки в задаче нет, шаг фиксирует статус заказа.
+public sealed class ShipOrderConsumer(IMongoDatabase db) : IConsumer<ShipOrder>
+{
+    public async Task Consume(ConsumeContext<ShipOrder> context)
+    {
+        var orderId = context.Message.OrderId;
+        await db.GetCollection<Order>("orders").UpdateOneAsync(
+            o => o.Id == orderId,
+            Builders<Order>.Update.Set(o => o.Status, OrderStatus.Shipped),
+            cancellationToken: context.CancellationToken);
+        await context.Publish(new OrderShipped(orderId));
+    }
+}
+
+// Проецирует статусы процесса на заказ. Статус только продвигается вперёд, терминальные не перезаписываются.
+public sealed class OrderStatusChangedConsumer(IMongoDatabase db) : IConsumer<OrderStatusChanged>
+{
+    public async Task Consume(ConsumeContext<OrderStatusChanged> context)
+    {
+        var msg = context.Message;
+        var orders = db.GetCollection<Order>("orders");
+        await orders.UpdateOneAsync(
+            o => o.Id == msg.OrderId && o.Status != OrderStatus.Cancelled && o.Status != OrderStatus.Shipped,
+            Builders<Order>.Update.Set(o => o.Status, msg.Status),
+            cancellationToken: context.CancellationToken);
+    }
+}
diff --git a/src/Fulfil/Consumers/PaymentConsumers.cs b/src/Fulfil/Consumers/PaymentConsumers.cs
new file mode 100644
index 0000000..621aa04
--- /dev/null
+++ b/src/Fulfil/Consumers/PaymentConsumers.cs
@@ -0,0 +1,107 @@
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Fulfil.Ports;
+using MassTransit;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+// Шлюз не принимает ключ идемпотентности, поэтому факт списания фиксируется в `payments`
+// сразу после ответа шлюза: повторная доставка (в т.ч. после сбоя публикации) деньги не спишет второй раз.
+// Остаётся окно между ответом шлюза и записью - процесс упал ровно там.
+public sealed class CapturePaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var msg = context.Message;
+        var payments = db.GetCollection<BsonDocument>("payments");
+
+        var existing = await payments.Find(new BsonDocument("_id", msg.OrderId)).FirstOrDefaultAsync(context.CancellationToken);
+        if (existing is null)
+        {
+            try
+            {
+                await gateway.ChargeAsync(msg.OrderId, msg.Amount, context.CancellationToken);
+            }
+            catch (PaymentDeclinedException ex)
+            {
+                await context.Publish(new PaymentDeclined(msg.OrderId, ex.Message));
+                return;
+            }
+
+            await payments.UpdateOneAsync(
+                new BsonDocument("_id", msg.OrderId),
+                new BsonDocument("$set", new BsonDocument { { "state", "Captured" }, { "amount", msg.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture) } }),
+                new UpdateOptions { IsUpsert = true },
+                context.CancellationToken);
+        }
+
+        await context.Publish(new PaymentCaptured(msg.OrderId));
+    }
+}
+
+public sealed class CapturePaymentConsumerDefinition : ConsumerDefinition<CapturePaymentConsumer>
+{
+    private readonly FulfilOptions _options;
+
+    public CapturePaymentConsumerDefinition(IOptions<FulfilOptions> options)
+    {
+        _options = options.Value;
+        EndpointName = Queues.CapturePayment;
+    }
+
+    protected override void ConfigureConsumer(IReceiveEndpointConfigurator endpoint,
+        IConsumerConfigurator<CapturePaymentConsumer> consumer, IRegistrationContext context)
+    {
+        // Ограничиваем и параллелизм, и prefetch: иначе backlog очереди целиком окажется в памяти пода.
+        if (endpoint is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.PrefetchCount = _options.PaymentPrefetch;
+        endpoint.ConcurrentMessageLimit = _options.PaymentConcurrency;
+
+        // Отказ платежа - не сбой: повторять не нужно. Остальное (шлюз упал) повторяем с нарастающей паузой,
+        // а при серии сбоев размыкаем цепь, чтобы не добивать шлюз.
+        endpoint.UseMessageRetry(r =>
+        {
+            r.Exponential(5, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(2));
+            r.Ignore<PaymentDeclinedException>();
+        });
+        endpoint.UseCircuitBreaker(cb =>
+        {
+            cb.TrackingPeriod = TimeSpan.FromMinutes(1);
+            cb.TripThreshold = 15;
+            cb.ActiveThreshold = 10;
+            cb.ResetInterval = TimeSpan.FromMinutes(1);
+        });
+    }
+}
+
+// Компенсация: возврат денег, если они были списаны. Идемпотентна по состоянию платежа.
+public sealed class RefundPaymentConsumer(IPaymentGateway gateway, IMongoDatabase db) : IConsumer<RefundPayment>
+{
+    public async Task Consume(ConsumeContext<RefundPayment> context)
+    {
+        var msg = context.Message;
+        var payments = db.GetCollection<BsonDocument>("payments");
+
+        var captured = await payments.FindOneAndUpdateAsync(
+            new BsonDocument { { "_id", msg.OrderId }, { "state", "Captured" } },
+            new BsonDocument("$set", new BsonDocument("state", "Refunding")),
+            cancellationToken: context.CancellationToken);
+        if (captured is null)
+        {
+            // Нет списания либо возврат уже начат; "Refunding" без завершения добирает повтор ниже.
+            var stuck = await payments.Find(new BsonDocument { { "_id", msg.OrderId }, { "state", "Refunding" } })
+                .AnyAsync(context.CancellationToken);
+            if (!stuck)
+                return;
+        }
+
+        await gateway.RefundAsync(msg.OrderId, msg.Amount, context.CancellationToken);
+        await payments.UpdateOneAsync(
+            new BsonDocument("_id", msg.OrderId),
+            new BsonDocument("$set", new BsonDocument("state", "Refunded")),
+            cancellationToken: context.CancellationToken);
+    }
+}
diff --git a/src/Fulfil/Consumers/StockConsumers.cs b/src/Fulfil/Consumers/StockConsumers.cs
new file mode 100644
index 0000000..ec0677a
--- /dev/null
+++ b/src/Fulfil/Consumers/StockConsumers.cs
@@ -0,0 +1,89 @@
+using Fulfil.Contracts;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Consumers;
+
+internal sealed class StockUnavailableException(string sku) : Exception($"Недостаточно товара: {sku}")
+{
+    public string Sku { get; } = sku;
+}
+
+// Резерв атомарен (транзакция MongoDB): либо списаны все позиции и записан резерв, либо ничего.
+// Повторная доставка команды видит готовый резерв и отвечает так же.
+public sealed class ReserveStockConsumer(IMongoClient client, IMongoDatabase db) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var msg = context.Message;
+        var products = db.GetCollection<BsonDocument>("products");
+        var reservations = db.GetCollection<BsonDocument>("reservations");
+
+        try
+        {
+            using var session = await client.StartSessionAsync(cancellationToken: context.CancellationToken);
+            await session.WithTransactionAsync(async (s, ct) =>
+            {
+                if (await reservations.Find(s, new BsonDocument("_id", msg.OrderId), cancellationToken: ct).AnyAsync(ct))
+                    return true;
+
+                foreach (var line in msg.Lines)
+                {
+                    var res = await products.UpdateOneAsync(s,
+                        new BsonDocument { { "_id", line.Sku }, { "stock", new BsonDocument("$gte", line.Quantity) } },
+                        new BsonDocument("$inc", new BsonDocument("stock", -line.Quantity)),
+                        cancellationToken: ct);
+                    if (res.ModifiedCount == 0)
+                        throw new StockUnavailableException(line.Sku);
+                }
+
+                await reservations.InsertOneAsync(s, new BsonDocument
+                {
+                    { "_id", msg.OrderId },
+                    { "state", "Reserved" },
+                    { "lines", new BsonArray(msg.Lines.Select(l => new BsonDocument { { "sku", l.Sku }, { "qty", l.Quantity } })) },
+                }, cancellationToken: ct);
+                return true;
+            }, cancellationToken: context.CancellationToken);
+        }
+        catch (StockUnavailableException ex)
+        {
+            await context.Publish(new StockReservationFailed(msg.OrderId, ex.Message));
+            return;
+        }
+
+        await context.Publish(new StockReserved(msg.OrderId));
+    }
+}
+
+// Компенсация: возвращает зарезервированное. Идемпотентна по состоянию резерва.
+public sealed class ReleaseStockConsumer(IMongoClient client, IMongoDatabase db) : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var products = db.GetCollection<BsonDocument>("products");
+        var reservations = db.GetCollection<BsonDocument>("reservations");
+        var orderId = context.Message.OrderId;
+
+        using var session = await client.StartSessionAsync(cancellationToken: context.CancellationToken);
+        await session.WithTransactionAsync(async (s, ct) =>
+        {
+            var taken = await reservations.FindOneAndUpdateAsync(s,
+                new BsonDocument { { "_id", orderId }, { "state", "Reserved" } },
+                new BsonDocument("$set", new BsonDocument("state", "Released")),
+                cancellationToken: ct);
+            if (taken is null)
+                return true;
+
+            foreach (var line in taken["lines"].AsBsonArray)
+            {
+                await products.UpdateOneAsync(s,
+                    new BsonDocument("_id", line["sku"]),
+                    new BsonDocument("$inc", new BsonDocument("stock", line["qty"])),
+                    cancellationToken: ct);
+            }
+            return true;
+        }, cancellationToken: context.CancellationToken);
+    }
+}
