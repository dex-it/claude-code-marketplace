diff --git a/src/Fulfil/Contracts/FulfilmentMessages.cs b/src/Fulfil/Contracts/FulfilmentMessages.cs
new file mode 100644
index 0000000..3902c04
--- /dev/null
+++ b/src/Fulfil/Contracts/FulfilmentMessages.cs
@@ -0,0 +1,21 @@
+using Fulfil.Domain;
+
+namespace Fulfil.Contracts;
+
+// Событие-старт процесса исполнения заказа.
+public sealed record OrderSubmitted(Guid OrderId, Guid CustomerId, IReadOnlyList<OrderLine> Lines, decimal Total, DateTimeOffset SubmittedAt);
+
+// Команды шагов процесса.
+public sealed record ReserveStock(Guid OrderId, IReadOnlyList<OrderLine> Lines);
+public sealed record CapturePayment(Guid OrderId, decimal Amount);
+public sealed record ShipOrder(Guid OrderId);
+
+// Компенсация: снять резерв и отменить заказ.
+public sealed record ReleaseStock(Guid OrderId, string Reason);
+
+// Результаты шагов.
+public sealed record StockReserved(Guid OrderId);
+public sealed record StockReservationFailed(Guid OrderId, string Reason);
+public sealed record PaymentCaptured(Guid OrderId);
+public sealed record PaymentFailed(Guid OrderId, string Reason);
+public sealed record OrderShipped(Guid OrderId, DateTimeOffset ShippedAt);
diff --git a/src/Fulfil/Fulfilment/Consumers.cs b/src/Fulfil/Fulfilment/Consumers.cs
new file mode 100644
index 0000000..be7062d
--- /dev/null
+++ b/src/Fulfil/Fulfilment/Consumers.cs
@@ -0,0 +1,146 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Persistence;
+using Fulfil.Ports;
+using MassTransit;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Fulfilment;
+
+public static class Queues
+{
+    public const string ReserveStock = "reserve-stock";
+    public const string CapturePayment = "capture-payment";
+    public const string ShipOrder = "ship-order";
+    public const string ReleaseStock = "release-stock";
+    public const string OrderFulfilment = "order-fulfilment";
+
+    public static Uri Address(string queue) => new($"queue:{queue}");
+}
+
+public sealed class ReserveStockConsumer(StockReservations stock) : IConsumer<ReserveStock>
+{
+    public async Task Consume(ConsumeContext<ReserveStock> context)
+    {
+        var m = context.Message;
+        var missing = await stock.ReserveAsync(m.OrderId, m.Lines, context.CancellationToken);
+        if (missing is null)
+        {
+            await context.Publish(new StockReserved(m.OrderId));
+            return;
+        }
+
+        // Частичный резерв не оставляем.
+        await stock.ReleaseAsync(m.OrderId, context.CancellationToken);
+        await context.Publish(new StockReservationFailed(m.OrderId, $"Недостаточно товара: {missing}"));
+    }
+}
+
+public sealed class CapturePaymentConsumer(
+    IMongoDatabase db, IPaymentGateway gateway, ILogger<CapturePaymentConsumer> log) : IConsumer<CapturePayment>
+{
+    public async Task Consume(ConsumeContext<CapturePayment> context)
+    {
+        var m = context.Message;
+        var ct = context.CancellationToken;
+        var payments = db.Payments();
+        var id = m.OrderId.ToString();
+
+        // Повторная доставка не должна списать деньги второй раз: сначала смотрим итог прошлой попытки.
+        var previous = await payments.Find(Builders<BsonDocument>.Filter.Eq("_id", id)).FirstOrDefaultAsync(ct);
+        switch (previous?["status"].AsString)
+        {
+            case "Captured":
+                await context.Publish(new PaymentCaptured(m.OrderId));
+                return;
+            case "Failed":
+                await context.Publish(new PaymentFailed(m.OrderId, previous["reason"].AsString));
+                return;
+        }
+
+        await SetStatusAsync(payments, id, "Pending", null, m.Amount, ct);
+
+        try
+        {
+            await gateway.ChargeAsync(m.OrderId, m.Amount, ct);
+        }
+        catch (PaymentDeclinedException e)
+        {
+            await SetStatusAsync(payments, id, "Failed", e.Message, m.Amount, ct);
+            await context.Publish(new PaymentFailed(m.OrderId, e.Message));
+            return;
+        }
+        // Остальные исключения - сбой шлюза: уходят в повтор политики эндпойнта.
+
+        await SetStatusAsync(payments, id, "Captured", null, m.Amount, ct);
+        await db.SetOrderStatusAsync(m.OrderId, OrderStatus.Paid, ct);
+        log.LogInformation("Платёж по заказу {OrderId} списан", m.OrderId);
+        await context.Publish(new PaymentCaptured(m.OrderId));
+    }
+
+    private static Task SetStatusAsync(
+        IMongoCollection<BsonDocument> payments, string id, string status, string? reason, decimal amount, CancellationToken ct)
+    {
+        var update = Builders<BsonDocument>.Update
+            .Set("status", status)
+            .Set("reason", reason is null ? BsonNull.Value : (BsonValue)reason)
+            .Set("amount", amount);
+        return payments.UpdateOneAsync(
+            Builders<BsonDocument>.Filter.Eq("_id", id), update, new UpdateOptions { IsUpsert = true }, ct);
+    }
+}
+
+// Пик 10 тыс. команд/мин (~170/с) при ответе шлюза 0.3-2 с требует ~200-350 одновременных вызовов;
+// 3 реплики по 128 слотов дают запас. Prefetch больше лимита, чтобы слоты не простаивали.
+public sealed class CapturePaymentConsumerDefinition : ConsumerDefinition<CapturePaymentConsumer>
+{
+    public CapturePaymentConsumerDefinition()
+    {
+        EndpointName = Queues.CapturePayment;
+        ConcurrentMessageLimit = 128;
+    }
+
+    protected override void ConfigureConsumer(
+        IReceiveEndpointConfigurator endpoint, IConsumerConfigurator<CapturePaymentConsumer> consumer, IRegistrationContext context)
+    {
+        if (endpoint is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.PrefetchCount = 256;
+
+        // Шлюз иногда падает: повторяем с нарастающей паузой (~8 мин суммарно), затем сообщение уйдёт в _error,
+        // а сага получит Fault<CapturePayment> и отменит заказ.
+        endpoint.UseMessageRetry(r => r.Exponential(10, TimeSpan.FromSeconds(1), TimeSpan.FromMinutes(5), TimeSpan.FromSeconds(2)));
+
+        // Не долбим лежащий шлюз сотнями параллельных вызовов.
+        endpoint.UseCircuitBreaker(cb =>
+        {
+            cb.TrackingPeriod = TimeSpan.FromMinutes(1);
+            cb.TripThreshold = 25;
+            cb.ActiveThreshold = 20;
+            cb.ResetInterval = TimeSpan.FromSeconds(30);
+        });
+    }
+}
+
+public sealed class ShipOrderConsumer(IMongoDatabase db, StockReservations stock) : IConsumer<ShipOrder>
+{
+    public async Task Consume(ConsumeContext<ShipOrder> context)
+    {
+        var id = context.Message.OrderId;
+        await stock.CommitAsync(id, context.CancellationToken);
+        await db.SetOrderStatusAsync(id, OrderStatus.Shipped, context.CancellationToken);
+        await context.Publish(new OrderShipped(id, DateTimeOffset.UtcNow));
+    }
+}
+
+public sealed class ReleaseStockConsumer(IMongoDatabase db, StockReservations stock, ILogger<ReleaseStockConsumer> log)
+    : IConsumer<ReleaseStock>
+{
+    public async Task Consume(ConsumeContext<ReleaseStock> context)
+    {
+        var m = context.Message;
+        await stock.ReleaseAsync(m.OrderId, context.CancellationToken);
+        await db.SetOrderStatusAsync(m.OrderId, OrderStatus.Cancelled, context.CancellationToken);
+        log.LogWarning("Заказ {OrderId} отменён: {Reason}", m.OrderId, m.Reason);
+    }
+}
diff --git a/src/Fulfil/Fulfilment/OrderFulfilmentStateMachine.cs b/src/Fulfil/Fulfilment/OrderFulfilmentStateMachine.cs
new file mode 100644
index 0000000..df8aa54
--- /dev/null
+++ b/src/Fulfil/Fulfilment/OrderFulfilmentStateMachine.cs
@@ -0,0 +1,111 @@
+using Fulfil.Contracts;
+using MassTransit;
+using MongoDB.Bson.Serialization.Attributes;
+
+namespace Fulfil.Fulfilment;
+
+public class OrderFulfilmentState : SagaStateMachineInstance, ISagaVersion
+{
+    [BsonId]
+    public Guid CorrelationId { get; set; }
+    public string CurrentState { get; set; } = null!;
+    public int Version { get; set; }
+    public decimal Total { get; set; }
+    public string? FailureReason { get; set; }
+}
+
+// OrderSubmitted -> ReserveStock -> CapturePayment -> ShipOrder. При отказе любого шага до отгрузки
+// отправляется ReleaseStock (снимает резерв и отменяет заказ). Завершённые экземпляры не удаляются,
+// чтобы повторный OrderSubmitted не запустил процесс заново.
+public sealed class OrderFulfilmentStateMachine : MassTransitStateMachine<OrderFulfilmentState>
+{
+    public State ReservingStock { get; private set; } = null!;
+    public State CapturingPayment { get; private set; } = null!;
+    public State Shipping { get; private set; } = null!;
+
+    public Event<OrderSubmitted> Submitted { get; private set; } = null!;
+    public Event<StockReserved> StockReserved { get; private set; } = null!;
+    public Event<StockReservationFailed> StockFailed { get; private set; } = null!;
+    public Event<PaymentCaptured> PaymentCaptured { get; private set; } = null!;
+    public Event<PaymentFailed> PaymentFailed { get; private set; } = null!;
+    public Event<OrderShipped> Shipped { get; private set; } = null!;
+    public Event<Fault<ReserveStock>> ReserveFaulted { get; private set; } = null!;
+    public Event<Fault<CapturePayment>> CaptureFaulted { get; private set; } = null!;
+
+    public OrderFulfilmentStateMachine()
+    {
+        InstanceState(x => x.CurrentState);
+
+        Event(() => Submitted, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => StockReserved, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => StockFailed, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => PaymentCaptured, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => PaymentFailed, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => Shipped, e => e.CorrelateById(c => c.Message.OrderId));
+        Event(() => ReserveFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+        Event(() => CaptureFaulted, e => e.CorrelateById(c => c.Message.Message.OrderId));
+
+        Initially(
+            When(Submitted)
+                .Then(c => c.Saga.Total = c.Message.Total)
+                .Send(Queues.Address(Queues.ReserveStock), c => new ReserveStock(c.Saga.CorrelationId, c.Message.Lines))
+                .TransitionTo(ReservingStock));
+
+        During(ReservingStock,
+            Ignore(Submitted),
+            When(StockReserved)
+                .Send(Queues.Address(Queues.CapturePayment), c => new CapturePayment(c.Saga.CorrelationId, c.Saga.Total))
+                .TransitionTo(CapturingPayment),
+            Cancel(When(StockFailed), c => c.Message.Reason),
+            Cancel(When(ReserveFaulted), c => FaultReason(c.Message)));
+
+        During(CapturingPayment,
+            Ignore(Submitted),
+            Ignore(StockReserved),
+            When(PaymentCaptured)
+                .Send(Queues.Address(Queues.ShipOrder), c => new ShipOrder(c.Saga.CorrelationId))
+                .TransitionTo(Shipping),
+            Cancel(When(PaymentFailed), c => c.Message.Reason),
+            Cancel(When(CaptureFaulted), c => FaultReason(c.Message)));
+
+        During(Shipping,
+            Ignore(Submitted),
+            Ignore(StockReserved),
+            Ignore(PaymentCaptured),
+            When(Shipped).Finalize());
+
+        // Повторные и запоздавшие сообщения после завершения игнорируем.
+        During(Final,
+            Ignore(Submitted),
+            Ignore(StockReserved),
+            Ignore(StockFailed),
+            Ignore(PaymentCaptured),
+            Ignore(PaymentFailed),
+            Ignore(Shipped),
+            Ignore(ReserveFaulted),
+            Ignore(CaptureFaulted));
+    }
+
+    private static EventActivityBinder<OrderFulfilmentState, T> Cancel<T>(
+        EventActivityBinder<OrderFulfilmentState, T> binder, Func<BehaviorContext<OrderFulfilmentState, T>, string> reason)
+        where T : class =>
+        binder
+            .Then(c => c.Saga.FailureReason = reason(c))
+            .Send(Queues.Address(Queues.ReleaseStock), c => new ReleaseStock(c.Saga.CorrelationId, c.Saga.FailureReason!))
+            .Finalize();
+
+    private static string FaultReason<T>(Fault<T> fault) where T : class =>
+        fault.Exceptions.FirstOrDefault()?.Message ?? "Сбой обработки команды";
+}
+
+public sealed class OrderFulfilmentSagaDefinition : SagaDefinition<OrderFulfilmentState>
+{
+    public OrderFulfilmentSagaDefinition() => EndpointName = Queues.OrderFulfilment;
+
+    protected override void ConfigureSaga(
+        IReceiveEndpointConfigurator endpoint, ISagaConfigurator<OrderFulfilmentState> saga, IRegistrationContext context)
+    {
+        // Конфликты версий при одновременных событиях одного заказа.
+        endpoint.UseMessageRetry(r => r.Intervals(50, 200, 500, 1000, 2000));
+    }
+}
diff --git a/src/Fulfil/Fulfilment/StockReservations.cs b/src/Fulfil/Fulfilment/StockReservations.cs
new file mode 100644
index 0000000..e23862a
--- /dev/null
+++ b/src/Fulfil/Fulfilment/StockReservations.cs
@@ -0,0 +1,67 @@
+using Fulfil.Domain;
+using Fulfil.Persistence;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Fulfilment;
+
+// Резерв товара. Каждая операция атомарна на одном документе товара и идемпотентна по orderId,
+// поэтому повторная доставка команды безопасна.
+public sealed class StockReservations(IMongoDatabase db)
+{
+    private static readonly FilterDefinitionBuilder<BsonDocument> F = Builders<BsonDocument>.Filter;
+    private static readonly UpdateDefinitionBuilder<BsonDocument> U = Builders<BsonDocument>.Update;
+
+    // Возвращает sku, которого не хватило, либо null, если зарезервировано всё.
+    public async Task<string?> ReserveAsync(Guid orderId, IReadOnlyList<OrderLine> lines, CancellationToken ct)
+    {
+        var key = orderId.ToString();
+        var products = db.Products();
+
+        foreach (var line in lines.GroupBy(l => l.Sku).Select(g => (Sku: g.Key, Qty: g.Sum(l => l.Quantity))))
+        {
+            var result = await products.UpdateOneAsync(
+                F.Eq("_id", line.Sku) & F.Gte("stock", line.Qty) & F.Ne("reservations.orderId", key),
+                U.Inc("stock", -line.Qty).Push("reservations", new BsonDocument { { "orderId", key }, { "qty", line.Qty } }),
+                cancellationToken: ct);
+
+            if (result.ModifiedCount == 1)
+                continue;
+
+            // Не изменили: либо уже зарезервировано этим заказом (повтор), либо не хватает товара.
+            var already = await products.CountDocumentsAsync(
+                F.Eq("_id", line.Sku) & F.Eq("reservations.orderId", key), cancellationToken: ct);
+            if (already == 0)
+                return line.Sku;
+        }
+
+        return null;
+    }
+
+    public async Task ReleaseAsync(Guid orderId, CancellationToken ct)
+    {
+        var key = orderId.ToString();
+        var products = db.Products();
+        var held = await products.Find(F.Eq("reservations.orderId", key)).ToListAsync(ct);
+
+        foreach (var product in held)
+        {
+            var qty = product["reservations"].AsBsonArray
+                .Select(r => r.AsBsonDocument)
+                .First(r => r["orderId"].AsString == key)["qty"].ToInt32();
+
+            // Фильтр по резерву не даёт вернуть остаток дважды при повторе.
+            await products.UpdateOneAsync(
+                F.Eq("_id", product["_id"]) & F.Eq("reservations.orderId", key),
+                U.Inc("stock", qty).PullFilter("reservations", F.Eq("orderId", key)),
+                cancellationToken: ct);
+        }
+    }
+
+    // Товар отгружен: остаток уже списан при резерве, снимаем только запись о резерве.
+    public Task CommitAsync(Guid orderId, CancellationToken ct) =>
+        db.Products().UpdateManyAsync(
+            F.Eq("reservations.orderId", orderId.ToString()),
+            U.PullFilter("reservations", F.Eq("orderId", orderId.ToString())),
+            cancellationToken: ct);
+}
