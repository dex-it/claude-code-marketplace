+using Fulfil.Domain;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Persistence;
+
+public static class MongoCollections
+{
+    public static IMongoCollection<Order> Orders(this IMongoDatabase db) => db.GetCollection<Order>("orders");
+
+    // Товары: _id = sku, stock, reservations [{ orderId, qty }], inboundIds [messageId] (окно дедупликации склада).
+    public static IMongoCollection<BsonDocument> Products(this IMongoDatabase db) => db.GetCollection<BsonDocument>("products");
+
+    // Платежи: _id = orderId, status = Pending | Captured | Failed.
+    public static IMongoCollection<BsonDocument> Payments(this IMongoDatabase db) => db.GetCollection<BsonDocument>("payments");
+
+    public static Task SetOrderStatusAsync(this IMongoDatabase db, Guid orderId, OrderStatus status, CancellationToken ct) =>
+        db.Orders().UpdateOneAsync(o => o.Id == orderId, Builders<Order>.Update.Set(o => o.Status, status), cancellationToken: ct);
+}
diff --git a/src/Fulfil/Ports/Ports.cs b/src/Fulfil/Ports/Ports.cs
index 877025b..9264153 100644
--- a/src/Fulfil/Ports/Ports.cs
+++ b/src/Fulfil/Ports/Ports.cs
@@ -7,6 +7,9 @@ public interface IPaymentGateway
     Task RefundAsync(Guid orderId, decimal amount, CancellationToken ct);
 }
 
+// Шлюз отказал в списании (бизнес-отказ). Любое другое исключение - сбой шлюза, операцию повторяют.
+public sealed class PaymentDeclinedException(string reason) : Exception(reason);
+
 // Ценовой сервис: источник цен, ответ около 300 мс.
 public interface IPriceSource
 {
diff --git a/src/Fulfil/Program.cs b/src/Fulfil/Program.cs
index 0c9a3bd..e62b02d 100644
--- a/src/Fulfil/Program.cs
+++ b/src/Fulfil/Program.cs
@@ -1,8 +1,94 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Fulfilment;
 using Fulfil.Options;
+using Fulfil.Persistence;
+using Fulfil.Ports;
+using Fulfil.Warehouse;
+using MassTransit;
+using MongoDB.Driver;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
+var fulfil = builder.Configuration.GetSection("Fulfil").Get<FulfilOptions>() ?? new FulfilOptions();
+
+builder.Services.AddSingleton<IMongoClient>(_ => new MongoClient(fulfil.MongoConnectionString));
+builder.Services.AddSingleton(sp => sp.GetRequiredService<IMongoClient>().GetDatabase(fulfil.MongoDatabase));
+builder.Services.AddSingleton<StockReservations>();
+
+builder.Services.AddMassTransit(x =>
+{
+    x.SetKebabCaseEndpointNameFormatter();
+
+    x.AddConsumer<ReserveStockConsumer>();
+    x.AddConsumer<CapturePaymentConsumer, CapturePaymentConsumerDefinition>();
+    x.AddConsumer<ShipOrderConsumer>();
+    x.AddConsumer<ReleaseStockConsumer>();
+
+    x.AddSagaStateMachine<OrderFulfilmentStateMachine, OrderFulfilmentState, OrderFulfilmentSagaDefinition>()
+        .MongoDbRepository(r =>
+        {
+            r.Connection = fulfil.MongoConnectionString;
+            r.DatabaseName = fulfil.MongoDatabase;
+            r.CollectionName = "order-sagas";
+        });
+
+    // Один узел RabbitMQ перезапускается: очереди долговечные и реплицируемые через Raft (quorum),
+    // сообщения MassTransit по умолчанию persistent.
+    x.AddConfigureEndpointsCallback((_, _, cfg) =>
+    {
+        if (cfg is IRabbitMqReceiveEndpointConfigurator rabbit)
+            rabbit.SetQuorumQueue();
+    });
+
+    x.UsingRabbitMq((context, cfg) =>
+    {
+        cfg.Host(fulfil.RabbitMqHost);
+        cfg.ConfigureEndpoints(context);
+    });
+});
+
+builder.Services.AddHostedService<WarehouseInboundWorker>();
 
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
+
+// Идемпотентно: повтор для заказа в статусе Placed заново публикует OrderSubmitted (сага дубликаты игнорирует),
+// для заказа, уже ушедшего дальше, ничего не делает.
+app.MapPost("/orders/{id:guid}/submit", async (
+    Guid id, SubmitOrderRequest request, IMongoDatabase db, IPriceSource prices, IPublishEndpoint publish, CancellationToken ct) =>
+{
+    var orders = db.Orders();
+    var order = await orders.Find(o => o.Id == id).FirstOrDefaultAsync(ct);
+
+    if (order is null)
+    {
+        if (request.Lines is not { Count: > 0 } || request.Lines.Any(l => string.IsNullOrWhiteSpace(l.Sku) || l.Quantity <= 0))
+            return Results.BadRequest("Нужна хотя бы одна позиция с sku и положительным количеством");
+
+        // Цены берём из источника цен, а не от клиента.
+        var lines = await Task.WhenAll(request.Lines
+            .GroupBy(l => l.Sku)
+            .Select(async g => new OrderLine(g.Key, g.Sum(l => l.Quantity), await prices.GetPriceAsync(g.Key, ct))));
+
+        order = new Order(id, request.CustomerId, OrderStatus.Placed, lines, DateTimeOffset.UtcNow);
+        try
+        {
+            await orders.InsertOneAsync(order, cancellationToken: ct);
+        }
+        catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            order = await orders.Find(o => o.Id == id).FirstAsync(ct); // параллельный запрос успел раньше
+        }
+    }
+
+    if (order.Status == OrderStatus.Placed)
+        await publish.Publish(new OrderSubmitted(order.Id, order.CustomerId, order.Lines, order.Total, DateTimeOffset.UtcNow), ct);
+
+    return Results.Accepted($"/orders/{id}");
+});
+
 app.Run();
+
+public sealed record SubmitOrderLine(string Sku, int Quantity);
+public sealed record SubmitOrderRequest(Guid CustomerId, IReadOnlyList<SubmitOrderLine> Lines);
diff --git a/src/Fulfil/Warehouse/WarehouseInboundWorker.cs b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
new file mode 100644
index 0000000..cfa8506
--- /dev/null
+++ b/src/Fulfil/Warehouse/WarehouseInboundWorker.cs
@@ -0,0 +1,178 @@
+using System.Text.Json;
+using Fulfil.Options;
+using Fulfil.Persistence;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+using RabbitMQ.Client;
+using RabbitMQ.Client.Events;
+
+namespace Fulfil.Warehouse;
+
+// Приход товара от складской системы: очередь не MassTransit, формат { sku, qty, messageId }.
+// Порядок для каждого сообщения: увеличить stock -> подтверждение в warehouse.outbound (с publisher confirm) -> ack.
+// Сбой в любой точке даёт повторную доставку; повтор не увеличивает stock второй раз (дедупликация по messageId).
+public sealed class WarehouseInboundWorker(
+    IMongoDatabase db, IOptions<FulfilOptions> options, ILogger<WarehouseInboundWorker> log) : BackgroundService
+{
+    private const int DedupWindow = 1000;
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+    private static readonly FilterDefinitionBuilder<BsonDocument> F = Builders<BsonDocument>.Filter;
+
+    private readonly FulfilOptions _options = options.Value;
+    private readonly SemaphoreSlim _publishLock = new(1, 1);
+
+    private sealed record InboundMessage(string? Sku, int Qty, string? MessageId);
+
+    private enum Outcome { Applied, Duplicate, UnknownSku }
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        // RabbitMQ может быть недоступен при старте (перезапуск стенда) - ждём, а не падаем.
+        // После подключения соединение и консьюмер восстанавливает клиент (automatic recovery).
+        IConnection? connection = null;
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            try
+            {
+                connection = await StartAsync(stoppingToken);
+                break;
+            }
+            catch (Exception e) when (!stoppingToken.IsCancellationRequested)
+            {
+                log.LogWarning(e, "Не удалось подключиться к {Queue}, повтор через 5 с", _options.WarehouseInboundQueue);
+                await Task.Delay(TimeSpan.FromSeconds(5), stoppingToken).ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);
+            }
+        }
+
+        if (connection is null)
+            return;
+
+        await Task.Delay(Timeout.Infinite, stoppingToken).ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);
+        await connection.DisposeAsync();
+    }
+
+    private async Task<IConnection> StartAsync(CancellationToken ct)
+    {
+        var factory = new ConnectionFactory
+        {
+            HostName = _options.RabbitMqHost,
+            AutomaticRecoveryEnabled = true,
+            TopologyRecoveryEnabled = true,
+        };
+
+        var connection = await factory.CreateConnectionAsync("fulfil-warehouse", ct);
+        try
+        {
+            var publisher = await connection.CreateChannelAsync(
+                new CreateChannelOptions(publisherConfirmationsEnabled: true, publisherConfirmationTrackingEnabled: true), ct);
+            await publisher.ExchangeDeclareAsync(_options.WarehouseOutboundExchange, ExchangeType.Fanout, durable: true, cancellationToken: ct);
+
+            var channel = await connection.CreateChannelAsync(new CreateChannelOptions(
+                publisherConfirmationsEnabled: false, publisherConfirmationTrackingEnabled: false, consumerDispatchConcurrency: 8), ct);
+            await channel.BasicQosAsync(0, 50, false, ct);
+            // Очередь принадлежит складской системе: не объявляем, а проверяем (чужие аргументы не меняем).
+            await channel.QueueDeclarePassiveAsync(_options.WarehouseInboundQueue, ct);
+
+            var consumer = new AsyncEventingBasicConsumer(channel);
+            consumer.ReceivedAsync += (_, ea) => HandleAsync(channel, publisher, ea, ct);
+            await channel.BasicConsumeAsync(_options.WarehouseInboundQueue, autoAck: false, consumer, ct);
+
+            log.LogInformation("Читаем очередь {Queue}", _options.WarehouseInboundQueue);
+            return connection;
+        }
+        catch
+        {
+            await connection.DisposeAsync();
+            throw;
+        }
+    }
+
+    private async Task HandleAsync(IChannel channel, IChannel publisher, BasicDeliverEventArgs ea, CancellationToken ct)
+    {
+        try
+        {
+            var message = Parse(ea.Body.Span);
+            if (message is null)
+            {
+                log.LogWarning("Некорректное сообщение прихода (тег {Tag}), отброшено", ea.DeliveryTag);
+                await channel.BasicNackAsync(ea.DeliveryTag, false, requeue: false, ct);
+                return;
+            }
+
+            var outcome = await ApplyAsync(message, ct);
+            if (outcome == Outcome.UnknownSku)
+            {
+                log.LogWarning("Неизвестный sku {Sku} в сообщении {MessageId}, отброшено", message.Sku, message.MessageId);
+                await channel.BasicNackAsync(ea.DeliveryTag, false, requeue: false, ct);
+                return;
+            }
+
+            await ConfirmAsync(publisher, message, outcome, ct);
+            await channel.BasicAckAsync(ea.DeliveryTag, false, ct);
+        }
+        catch (Exception e) when (!ct.IsCancellationRequested)
+        {
+            log.LogError(e, "Ошибка обработки прихода (тег {Tag}), вернём в очередь", ea.DeliveryTag);
+            try
+            {
+                await Task.Delay(TimeSpan.FromSeconds(1), ct); // не крутим отказ в горячем цикле
+                await channel.BasicNackAsync(ea.DeliveryTag, false, requeue: true, ct);
+            }
+            catch (Exception nackError)
+            {
+                log.LogWarning(nackError, "Не удалось вернуть сообщение; брокер вернёт его при закрытии канала");
+            }
+        }
+    }
+
+    private static InboundMessage? Parse(ReadOnlySpan<byte> body)
+    {
+        try
+        {
+            var m = JsonSerializer.Deserialize<InboundMessage>(body, Json);
+            return m is { Sku.Length: > 0, MessageId.Length: > 0, Qty: > 0 } ? m : null;
+        }
+        catch (JsonException)
+        {
+            return null;
+        }
+    }
+
+    private async Task<Outcome> ApplyAsync(InboundMessage m, CancellationToken ct)
+    {
+        var products = db.Products();
+
+        // Одна атомарная операция на документе: увеличение остатка и запись messageId в окно дедупликации.
+        var result = await products.UpdateOneAsync(
+            F.Eq("_id", m.Sku) & F.Ne("inboundIds", m.MessageId),
+            Builders<BsonDocument>.Update
+                .Inc("stock", m.Qty)
+                .PushEach("inboundIds", new[] { m.MessageId }, slice: -DedupWindow),
+            cancellationToken: ct);
+
+        if (result.ModifiedCount == 1)
+            return Outcome.Applied;
+
+        var exists = await products.CountDocumentsAsync(F.Eq("_id", m.Sku), cancellationToken: ct) > 0;
+        return exists ? Outcome.Duplicate : Outcome.UnknownSku;
+    }
+
+    private async Task ConfirmAsync(IChannel publisher, InboundMessage m, Outcome outcome, CancellationToken ct)
+    {
+        var body = JsonSerializer.SerializeToUtf8Bytes(
+            new { messageId = m.MessageId, sku = m.Sku, qty = m.Qty, status = outcome == Outcome.Applied ? "applied" : "duplicate" }, Json);
+        var props = new BasicProperties { Persistent = true, ContentType = "application/json", MessageId = m.MessageId };
+
+        await _publishLock.WaitAsync(ct);
+        try
+        {
+            // С включённым подтверждением вызов возвращается после confirm брокера и бросает исключение при nack.
+            await publisher.BasicPublishAsync(_options.WarehouseOutboundExchange, string.Empty, mandatory: false, props, body, ct);
+        }
+        finally
+        {
+            _publishLock.Release();
+        }
+    }
+}
