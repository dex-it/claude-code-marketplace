diff --git a/api/test/payments.test.ts b/api/test/payments.test.ts
new file mode 100644
index 0000000..ebbb0b3
--- /dev/null
+++ b/api/test/payments.test.ts
@@ -0,0 +1,53 @@
+import request from 'supertest';
+import { describe, expect, it, vi } from 'vitest';
+import { createApp } from '../src/app.js';
+import type { PaymentGateway } from '../src/payments/gateway.js';
+import { demoUsers, seedDemo } from '../src/seed.js';
+import { Store } from '../src/store.js';
+
+function setup(charge: PaymentGateway['charge']) {
+  const store = new Store();
+  seedDemo(store);
+  const notifier = { orderPaid: vi.fn(async () => {}) };
+  const analytics = { track: vi.fn(async () => {}) };
+  const app = createApp({ store, payments: { charge: vi.fn(charge) }, notifier, analytics });
+  return { store, app, notifier, analytics };
+}
+
+async function auth(app: ReturnType<typeof createApp>) {
+  const res = await request(app).post('/api/login').send(demoUsers.alice).expect(200);
+  return `Bearer ${res.body.token}`;
+}
+
+describe('POST /api/orders/:id/pay', () => {
+  it('marks the order paid', async () => {
+    const ctx = setup(async () => ({ status: 'approved', transactionId: 'tx-1' }));
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', await auth(ctx.app)).expect(200);
+    expect(res.body).toMatchObject({ status: 'paid', transactionId: 'tx-1' });
+    await vi.waitFor(() => expect(ctx.analytics.track).toHaveBeenCalledWith('order_paid', expect.any(Object)));
+    expect(ctx.notifier.orderPaid).toHaveBeenCalledTimes(1);
+  });
+
+  it('returns 402 when declined', async () => {
+    const ctx = setup(async () => ({ status: 'declined', reason: 'insufficient_funds' }));
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', await auth(ctx.app));
+    expect(res.status).toBe(402);
+    expect(res.body.error).toEqual({ code: 'payment_declined', message: 'insufficient_funds' });
+    expect(ctx.store.getOrder('ord-1001')?.status).toBe('new');
+  });
+
+  it('returns 502 when the gateway fails', async () => {
+    const ctx = setup(async () => {
+      throw new Error('ECONNRESET');
+    });
+    const res = await request(ctx.app).post('/api/orders/ord-1001/pay').set('Authorization', await auth(ctx.app));
+    expect(res.status).toBe(502);
+  });
+
+  it('rejects foreign and already paid orders', async () => {
+    const ctx = setup(async () => ({ status: 'approved', transactionId: 'tx-1' }));
+    const token = await auth(ctx.app);
+    expect((await request(ctx.app).post('/api/orders/ord-1004/pay').set('Authorization', token)).status).toBe(404);
+    expect((await request(ctx.app).post('/api/orders/ord-1003/pay').set('Authorization', token)).status).toBe(409);
+  });
+});
