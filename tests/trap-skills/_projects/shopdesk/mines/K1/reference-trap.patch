+      return;
+    }
+    const paid = store.saveOrder({ ...order, status: OrderStatus.Paid, transactionId: result.transactionId });
+    await deps.notifier.orderPaid(paid);
+    await deps.analytics.track('order_paid', { orderNumber: paid.number, amountKopecks: paid.totalKopecks });
+    res.json(paid);
+  });
