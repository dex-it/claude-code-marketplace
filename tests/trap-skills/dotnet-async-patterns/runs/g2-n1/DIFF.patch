+namespace Billing.Api.Application.Handlers.Statements;
+
+public static class StatementLimits
+{
+    public const long MaxBytes = 50L * 1024 * 1024;
+    public const int MaxRows = 200_000;
+    public const int MaxLineLength = 1_000;
+    public const int MaxPaymentRefLength = 64;
+    public const int MaxContentTypeLength = 100;
+    public const int MaxLevenshteinDistance = 2;
+    public const int StatusCheckParallelism = 100;
+    public const int CancellationCheckEvery = 256;
+    public static readonly TimeSpan ImportTimeout = TimeSpan.FromMinutes(2);
+}
