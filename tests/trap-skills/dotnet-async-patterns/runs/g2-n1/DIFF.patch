@@ -0,0 +1,86 @@
+using System.Text.RegularExpressions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed class InvoiceMatcher
+{
+    private static readonly Regex TokenSeparator = new(@"[^\p{L}\p{N}-]+", RegexOptions.Compiled);
+
+    private readonly Dictionary<(long Minor, string Currency), List<(Invoice Invoice, string Text)>> _byAmount = new();
+
+    public InvoiceMatcher(IEnumerable<Invoice> issued)
+    {
+        foreach (var invoice in issued)
+        {
+            var key = (invoice.Amount.Minor, invoice.Amount.Currency.ToUpperInvariant());
+            if (!_byAmount.TryGetValue(key, out var list))
+                _byAmount[key] = list = [];
+            list.Add((invoice, invoice.Id.ToString().ToLowerInvariant()));
+        }
+    }
+
+    public Invoice? Match(StatementRow row)
+    {
+        if (!_byAmount.TryGetValue((row.AmountMinor, row.Currency), out var candidates))
+            return null;
+
+        var tokens = TokenSeparator.Split(row.Purpose.ToLowerInvariant())
+            .Where(static t => t.Length > 0)
+            .ToArray();
+        if (tokens.Length == 0)
+            return null;
+
+        Invoice? best = null;
+        var bestDistance = int.MaxValue;
+        var ambiguous = false;
+        foreach (var (invoice, text) in candidates)
+        {
+            var distance = tokens.Min(t => Levenshtein.Bounded(t, text, StatementLimits.MaxLevenshteinDistance));
+            if (distance > StatementLimits.MaxLevenshteinDistance)
+                continue;
+            if (distance < bestDistance)
+            {
+                best = invoice;
+                bestDistance = distance;
+                ambiguous = false;
+            }
+            else if (distance == bestDistance)
+            {
+                ambiguous = true;
+            }
+        }
+        return ambiguous ? null : best;
+    }
+}
+
+public static class Levenshtein
+{
+    /// <summary>Расстояние Левенштейна; если оно больше max, возвращает max + 1.</summary>
+    public static int Bounded(string a, string b, int max)
+    {
+        if (Math.Abs(a.Length - b.Length) > max)
+            return max + 1;
+
+        var prev = new int[b.Length + 1];
+        var curr = new int[b.Length + 1];
+        for (var j = 0; j <= b.Length; j++)
+            prev[j] = j;
+
+        for (var i = 1; i <= a.Length; i++)
+        {
+            curr[0] = i;
+            var rowMin = curr[0];
+            for (var j = 1; j <= b.Length; j++)
+            {
+                var cost = a[i - 1] == b[j - 1] ? 0 : 1;
+                curr[j] = Math.Min(Math.Min(prev[j] + 1, curr[j - 1] + 1), prev[j - 1] + cost);
+                rowMin = Math.Min(rowMin, curr[j]);
+            }
+            if (rowMin > max)
+                return max + 1;
+            (prev, curr) = (curr, prev);
+        }
+        return Math.Min(prev[b.Length], max + 1);
+    }
+}
