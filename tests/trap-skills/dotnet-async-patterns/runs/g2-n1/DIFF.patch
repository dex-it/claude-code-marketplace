@@ -0,0 +1,24 @@
+using System.Globalization;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed record StatementRow(DateOnly Date, long AmountMinor, string Currency, string PaymentRef, string Purpose)
+{
+    public static StatementRow? TryParse(string line)
+    {
+        if (line.Length > StatementLimits.MaxLineLength)
+            return null;
+        var parts = line.Split(';', 5);
+        if (parts.Length != 5)
+            return null;
+        if (!DateOnly.TryParse(parts[0], CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
+            return null;
+        if (!long.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var amount) || amount <= 0)
+            return null;
+        var currency = parts[2].Trim();
+        var paymentRef = parts[3].Trim();
+        if (currency.Length != 3 || paymentRef.Length is 0 or > StatementLimits.MaxPaymentRefLength)
+            return null;
+        return new StatementRow(date, amount, currency.ToUpperInvariant(), paymentRef, parts[4]);
+    }
+}
