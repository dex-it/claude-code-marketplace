+++ b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
@@ -0,0 +1,108 @@
+using System.Collections.Concurrent;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Handlers.Invoices;
+using Billing.Api.Domain;
+using Microsoft.Extensions.Logging;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed record ImportStatementCommand(Stream Content, string? ContentType);
+
+public sealed record StatementSummary(int Rows, int Matched, int Paid, int Unmatched);
+
+public sealed record MatchedPayment(string PaymentRef, Invoice Invoice);
+
+public sealed class ImportStatementHandler(
+    ImportStatementValidator validator,
+    IStatementArchive archive,
+    IInvoiceRepository invoices,
+    IBankStatusGateway bank,
+    PayInvoiceHandler payInvoice,
+    TimeProvider clock,
+    ILogger<ImportStatementHandler> logger)
+{
+    public async Task<Result<StatementSummary>> HandleAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        if (validator.Check(command) is { } error)
+            return error;
+
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(StatementLimits.ImportTimeout);
+        try
+        {
+            return await ImportAsync(command.Content, timeout.Token);
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            logger.LogWarning("Statement import exceeded {Timeout} and was aborted", StatementLimits.ImportTimeout);
+            return new StatementImportTimeoutError(StatementLimits.ImportTimeout);
+        }
+    }
+
+    private async Task<Result<StatementSummary>> ImportAsync(Stream content, CancellationToken ct)
+    {
+        var fileName = $"statement-{clock.GetUtcNow():yyyyMMdd}-{Guid.NewGuid():N}.csv";
+        await archive.SaveAsync(fileName, content, ct);
+        content.Position = 0;
+
+        var issued = await invoices.ListByStatusAsync(InvoiceStatus.Issued, ct);
+        var matcher = new InvoiceMatcher(issued);
+
+        var matched = new List<MatchedPayment>();
+        var rows = await ParseAndMatchAsync(content, matcher, matched, ct);
+        if (rows is null)
+            return new ValidationError("rows", $"Statement has more than {StatementLimits.MaxRows} rows");
+
+        var settled = new ConcurrentBag<MatchedPayment>();
+        var options = new ParallelOptions
+        {
+            MaxDegreeOfParallelism = StatementLimits.StatusCheckParallelism,
+            CancellationToken = ct,
+        };
+        await Parallel.ForEachAsync(matched, options, async (payment, token) =>
+        {
+            if (await bank.IsSettledAsync(payment.PaymentRef, token))
+                settled.Add(payment);
+        });
+
+        var paid = 0;
+        foreach (var payment in settled)
+        {
+            var result = await payInvoice.HandleAsync(new PayInvoiceCommand(payment.Invoice.Id), ct);
+            if (result.IsSuccess)
+                paid++;
+        }
+
+        var summary = new StatementSummary(rows.Value, matched.Count, paid, rows.Value - matched.Count);
+        logger.LogInformation(
+            "Statement {FileName} imported: {Rows} rows, {Matched} matched, {Paid} paid, {Unmatched} unmatched",
+            fileName, summary.Rows, summary.Matched, summary.Paid, summary.Unmatched);
+        return summary;
+    }
+
+    private static async Task<int?> ParseAndMatchAsync(
+        Stream content, InvoiceMatcher matcher, List<MatchedPayment> matched, CancellationToken ct)
+    {
+        var taken = new HashSet<InvoiceId>();
+        var rows = 0;
+
+        using var reader = new StreamReader(content, leaveOpen: true);
+        await reader.ReadLineAsync(ct);
+        while (await reader.ReadLineAsync(ct) is { } line)
+        {
+            if (line.Length == 0)
+                continue;
+            if (++rows > StatementLimits.MaxRows)
+                return null;
+
+            if (rows % StatementLimits.CancellationCheckEvery == 0)
+                ct.ThrowIfCancellationRequested();
+
+            if (StatementRow.TryParse(line) is not { } row)
+                continue;
+            if (matcher.Match(row) is { } invoice && taken.Add(invoice.Id))
+                matched.Add(new MatchedPayment(row.PaymentRef, invoice));
+        }
+        return rows;
+    }
+}
