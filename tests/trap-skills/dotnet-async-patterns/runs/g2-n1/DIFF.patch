@@ -0,0 +1,17 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed class ImportStatementValidator : BillingValidator<ImportStatementCommand>
+{
+    public ImportStatementValidator()
+    {
+        RuleFor(x => x.ContentType)
+            .NotEmpty()
+            .MaximumLength(StatementLimits.MaxContentTypeLength)
+            .Must(t => t!.StartsWith("text/csv", StringComparison.OrdinalIgnoreCase))
+            .WithMessage("Content-Type must be text/csv");
+        RuleFor(x => x.Content).Must(s => s.CanSeek).WithMessage("Content must be seekable");
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs b/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs
