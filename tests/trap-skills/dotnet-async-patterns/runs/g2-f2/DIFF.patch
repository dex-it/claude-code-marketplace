@@ -0,0 +1,36 @@
+namespace Billing.Api.Application.Handlers.Statements;
+
+public static class Levenshtein
+{
+    /// <summary>Расстояние Левенштейна, если оно не больше <paramref name="max"/>; иначе null.</summary>
+    public static int? Within(ReadOnlySpan<char> a, ReadOnlySpan<char> b, int max)
+    {
+        if (Math.Abs(a.Length - b.Length) > max)
+            return null;
+
+        Span<int> prev = stackalloc int[b.Length + 1];
+        Span<int> curr = stackalloc int[b.Length + 1];
+        for (var j = 0; j <= b.Length; j++)
+            prev[j] = j;
+
+        for (var i = 1; i <= a.Length; i++)
+        {
+            curr[0] = i;
+            var rowMin = curr[0];
+            for (var j = 1; j <= b.Length; j++)
+            {
+                var cost = a[i - 1] == b[j - 1] ? 0 : 1;
+                curr[j] = Math.Min(Math.Min(prev[j] + 1, curr[j - 1] + 1), prev[j - 1] + cost);
+                rowMin = Math.Min(rowMin, curr[j]);
+            }
+
+            if (rowMin > max)
+                return null;
+            var tmp = prev;
+            prev = curr;
+            curr = tmp;
+        }
+
+        return prev[b.Length] <= max ? prev[b.Length] : null;
+    }
+}
