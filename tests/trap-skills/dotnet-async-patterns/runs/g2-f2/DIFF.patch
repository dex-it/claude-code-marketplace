+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed class StatementRowValidator : BillingValidator<StatementRow>
+{
+    public StatementRowValidator()
+    {
+        RuleFor(x => x.AmountMinor).GreaterThan(0);
+        RuleFor(x => x.Currency).Length(3);
+        RuleFor(x => x.PaymentRef).NotEmpty().MaximumLength(100);
+        RuleFor(x => x.Purpose).MaximumLength(1000);
+    }
+}
