index 0000000..cae9a01
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
@@ -0,0 +1,156 @@
+using System.Collections.Concurrent;
+using System.Globalization;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Handlers.Invoices;
+using Billing.Api.Domain;
+using Billing.Api.Infrastructure.Bank;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed record ImportStatementCommand(Stream Content);
+
+public sealed record StatementSummary(int Rows, int Matched, int Paid, int Unmatched);
+
+public sealed class ImportStatementHandler(
+    IStatementArchive archive,
+    IInvoiceRepository invoices,
+    BankClient bank,
+    PayInvoiceHandler payInvoice,
+    StatementRowValidator rowValidator,
+    TimeProvider clock,
+    ILogger<ImportStatementHandler> logger)
+{
+    public const int MaxRows = 200_000;
+    private const int MaxDistance = 2;
+    private const int BankParallelism = 64;
+    private static readonly TimeSpan ImportTimeout = TimeSpan.FromMinutes(2);
+    private static readonly char[] TokenSeparators = " \t,;:.()[]#№\"'/\\".ToCharArray();
+
+    public async Task<Result<StatementSummary>> HandleAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        if (!command.Content.CanSeek)
+            throw new ArgumentException("Statement content must be seekable", nameof(command));
+
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(ImportTimeout);
+        try
+        {
+            return await ImportAsync(command.Content, timeout.Token);
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested && timeout.IsCancellationRequested)
+        {
+            return new StatementImportTimeoutError(ImportTimeout);
+        }
+    }
+
+    private async Task<Result<StatementSummary>> ImportAsync(Stream content, CancellationToken ct)
+    {
+        var fileName = $"{clock.GetUtcNow():yyyyMMdd-HHmmss}-{Guid.NewGuid():N}.csv";
+        using var scope = logger.BeginScope(new Dictionary<string, object> { ["StatementFile"] = fileName });
+
+        await archive.SaveAsync(fileName, content, ct);
+        content.Position = 0;
+
+        var issued = await invoices.ListByStatusAsync(InvoiceStatus.Issued, ct);
+        var index = issued
+            .GroupBy(i => (i.Amount.Currency, i.Amount.Minor))
+            .ToDictionary(g => g.Key, g => g.Select(i => (i.Id, Key: i.Id.ToString())).ToArray());
+
+        var matchedByInvoice = new Dictionary<InvoiceId, List<string>>();
+        var rows = 0;
+        var matched = 0;
+
+        using var reader = new StreamReader(content);
+        if (await reader.ReadLineAsync(ct) is null)
+            return new ValidationError("body", "Statement is empty");
+
+        while (await reader.ReadLineAsync(ct) is { } line)
+        {
+            if (string.IsNullOrWhiteSpace(line))
+                continue;
+            if (++rows > MaxRows)
+                return new ValidationError("body", $"Statement has more than {MaxRows} rows");
+
+            if (!TryParse(line, out var row) || rowValidator.Check(row) is not null)
+                continue;
+            if (!index.TryGetValue((row.Currency, row.AmountMinor), out var candidates))
+                continue;
+            if (Match(row.Purpose, candidates, ct) is not { } invoiceId)
+                continue;
+
+            matched++;
+            if (!matchedByInvoice.TryGetValue(invoiceId, out var refs))
+                matchedByInvoice[invoiceId] = refs = [];
+            refs.Add(row.PaymentRef);
+        }
+
+        var settled = await FindSettledAsync(matchedByInvoice, ct);
+
+        var paid = 0;
+        foreach (var invoiceId in settled)
+        {
+            var result = await payInvoice.HandleAsync(new PayInvoiceCommand(invoiceId), ct);
+            if (result.IsSuccess)
+                paid++;
+        }
+
+        var summary = new StatementSummary(rows, matched, paid, rows - matched);
+        logger.LogInformation(
+            "Statement imported: {Rows} rows, {Matched} matched, {Paid} paid, {Unmatched} unmatched",
+            summary.Rows, summary.Matched, summary.Paid, summary.Unmatched);
+        return summary;
+    }
+
+    private async Task<List<InvoiceId>> FindSettledAsync(Dictionary<InvoiceId, List<string>> matched, CancellationToken ct)
+    {
+        var settled = new ConcurrentBag<InvoiceId>();
+        await Parallel.ForEachAsync(
+            matched,
+            new ParallelOptions { MaxDegreeOfParallelism = BankParallelism, CancellationToken = ct },
+            async (entry, token) =>
+            {
+                foreach (var paymentRef in entry.Value)
+                {
+                    if (await bank.GetPaymentStatusAsync(paymentRef, token) == BankPaymentStatus.Settled)
+                    {
+                        settled.Add(entry.Key);
+                        return;
+                    }
+                }
+            });
+        return settled.ToList();
+    }
+
+    private static InvoiceId? Match(string purpose, (InvoiceId Id, string Key)[] candidates, CancellationToken ct)
+    {
+        InvoiceId? best = null;
+        var bestDistance = MaxDistance + 1;
+        foreach (var token in purpose.Split(TokenSeparators, StringSplitOptions.RemoveEmptyEntries))
+        {
+            ct.ThrowIfCancellationRequested();
+            foreach (var (id, key) in candidates)
+            {
+                if (Levenshtein.Within(token, key, MaxDistance) is { } d && d < bestDistance)
+                {
+                    best = id;
+                    bestDistance = d;
+                }
+            }
+        }
+
+        return best;
+    }
+
+    private static bool TryParse(string line, out StatementRow row)
+    {
+        row = null!;
+        var parts = line.Split(';', 5);
+        if (parts.Length != 5
+            || !DateOnly.TryParseExact(parts[0].Trim(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
+            || !long.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var amount))
+            return false;
+
+        row = new StatementRow(date, amount, parts[2].Trim().ToUpperInvariant(), parts[3].Trim(), parts[4]);
+        return true;
+    }
+}
