+using Billing.Api.Application.Handlers.Statements;
+using Microsoft.AspNetCore.Http.Features;
+
+namespace Billing.Api.Api;
+
+public static class StatementEndpoints
+{
+    private const int MaxBodyBytes = 50 * 1024 * 1024;
+    private const int MemoryBufferBytes = 1024 * 1024;
+
+    public static IEndpointRouteBuilder MapStatementEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/statements", async (HttpRequest request, ImportStatementHandler handler, CancellationToken ct) =>
+        {
+            if (request.ContentType?.StartsWith("text/csv", StringComparison.OrdinalIgnoreCase) != true)
+                return Results.Problem("Content-Type must be text/csv", statusCode: StatusCodes.Status415UnsupportedMediaType);
+
+            var limit = request.HttpContext.Features.Get<IHttpMaxRequestBodySizeFeature>();
+            if (limit is { IsReadOnly: false })
+                limit.MaxRequestBodySize = MaxBodyBytes;
+
+            // файл нужен дважды (архив, разбор): буфер сверх 1 МБ уходит на диск
+            request.EnableBuffering(MemoryBufferBytes, MaxBodyBytes);
+
+            return (await handler.HandleAsync(new ImportStatementCommand(request.Body), ct))
+                .ToHttp(s => Results.Ok(new { rows = s.Rows, matched = s.Matched, paid = s.Paid, unmatched = s.Unmatched }));
+        });
+
+        return app;
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
