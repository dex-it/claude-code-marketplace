+namespace Billing.Api.Application.Handlers.Statements;
+
+public static class StatementLimits
+{
+    public const int MaxBodyBytes = 50 * 1024 * 1024;
+    public const int MaxRows = 200_000;
+    public const int MaxReferenceLength = 64;
+    public const int MaxPurposeLength = 500;
+    public const int CurrencyLength = 3;
+    public const int MaxEditDistance = 2;
+}
+
+public sealed record StatementRow(DateOnly Date, long AmountMinor, string Currency, string Reference, string Purpose);
