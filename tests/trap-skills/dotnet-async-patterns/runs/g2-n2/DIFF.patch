@@ -0,0 +1,15 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed class ImportStatementValidator : BillingValidator<StatementRow>
+{
+    public ImportStatementValidator()
+    {
+        RuleFor(x => x.AmountMinor).GreaterThan(0);
+        RuleFor(x => x.Currency).Length(StatementLimits.CurrencyLength);
+        RuleFor(x => x.Reference).NotEmpty().MaximumLength(StatementLimits.MaxReferenceLength);
+        RuleFor(x => x.Purpose).MaximumLength(StatementLimits.MaxPurposeLength);
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs b/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs
new file mode 100644
index 0000000..fe50f22
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs
@@ -0,0 +1,73 @@
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed class InvoiceMatcher
+{
+    private readonly Dictionary<(long Minor, string Currency), List<(InvoiceId Id, string Number)>> byAmount = new();
+
+    public InvoiceMatcher(IEnumerable<Invoice> issued)
+    {
+        foreach (var invoice in issued)
+        {
+            var key = (invoice.Amount.Minor, invoice.Amount.Currency);
+            if (!byAmount.TryGetValue(key, out var list))
+                byAmount[key] = list = [];
+            list.Add((invoice.Id, invoice.Id.ToString()));
+        }
+    }
+
+    // Счёт, номер которого не дальше MaxEditDistance от какого-то фрагмента назначения; null - нет или неоднозначно.
+    public InvoiceId? Match(StatementRow row)
+    {
+        if (!byAmount.TryGetValue((row.AmountMinor, row.Currency), out var candidates))
+            return null;
+
+        var purpose = row.Purpose.ToLowerInvariant();
+        InvoiceId? best = null;
+        var bestDistance = int.MaxValue;
+        var tie = false;
+        foreach (var (id, number) in candidates)
+        {
+            var distance = SubstringDistance(number, purpose, StatementLimits.MaxEditDistance);
+            if (distance > StatementLimits.MaxEditDistance)
+                continue;
+            if (distance < bestDistance)
+            {
+                best = id;
+                bestDistance = distance;
+                tie = false;
+            }
+            else if (distance == bestDistance)
+            {
+                tie = true;
+            }
+        }
+
+        return tie ? null : best;
+    }
+
+    // Расстояние Левенштейна от pattern до ближайшего фрагмента text; больше max - возвращает max + 1.
+    private static int SubstringDistance(string pattern, string text, int max)
+    {
+        var previous = new int[text.Length + 1];
+        var current = new int[text.Length + 1];
+        for (var i = 1; i <= pattern.Length; i++)
+        {
+            current[0] = i;
+            var rowMin = i;
+            for (var j = 1; j <= text.Length; j++)
+            {
+                var cost = pattern[i - 1] == text[j - 1] ? 0 : 1;
+                current[j] = Math.Min(Math.Min(previous[j] + 1, current[j - 1] + 1), previous[j - 1] + cost);
+                rowMin = Math.Min(rowMin, current[j]);
+            }
+
+            if (rowMin > max)
+                return max + 1;
+            (previous, current) = (current, previous);
+        }
+
+        return previous.Min();
+    }
+}
