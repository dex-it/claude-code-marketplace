@@ -0,0 +1,28 @@
+using Billing.Api.Application.Handlers.Statements;
+using Microsoft.AspNetCore.Http.Features;
+
+namespace Billing.Api.Api;
+
+public static class StatementEndpoints
+{
+    public static IEndpointRouteBuilder MapStatementEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/statements", async (HttpRequest request, ImportStatementHandler handler, CancellationToken ct) =>
+        {
+            if (!string.Equals(request.GetTypedHeaders().ContentType?.MediaType.Value, "text/csv", StringComparison.OrdinalIgnoreCase))
+                return Results.StatusCode(StatusCodes.Status415UnsupportedMediaType);
+
+            request.HttpContext.Features.Get<IHttpMaxRequestBodySizeFeature>()!.MaxRequestBodySize = StatementLimits.MaxBodyBytes;
+            return (await handler.HandleAsync(new ImportStatementCommand(request.Body), ct))
+                .ToHttp(summary => Results.Ok(new
+                {
+                    rows = summary.Rows,
+                    matched = summary.Matched,
+                    paid = summary.Paid,
+                    unmatched = summary.Unmatched,
+                }));
+        });
+
+        return app;
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
new file mode 100644
index 0000000..a9520e7
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
@@ -0,0 +1,127 @@
+using System.Collections.Concurrent;
+using System.Globalization;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Handlers.Invoices;
+using Billing.Api.Domain;
+using Billing.Api.Infrastructure.Bank;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed record ImportStatementCommand(Stream Content);
+
+public sealed record StatementSummary(int Rows, int Matched, int Paid, int Unmatched);
+
+public sealed class ImportStatementHandler(
+    IStatementArchive archive,
+    IInvoiceRepository invoices,
+    BankClient bank,
+    PayInvoiceHandler payHandler,
+    ImportStatementValidator validator,
+    TimeProvider clock,
+    ILogger<ImportStatementHandler> logger)
+{
+    private const string Header = "дата;сумма_в_копейках;валюта;референс_платежа;назначение";
+    private const int BankParallelism = 64;
+    private static readonly TimeSpan ImportTimeout = TimeSpan.FromMinutes(2);
+
+    public async Task<Result<StatementSummary>> HandleAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(ImportTimeout);
+        try
+        {
+            return await ImportAsync(command, timeout.Token);
+        }
+        catch (OperationCanceledException) when (timeout.IsCancellationRequested && !ct.IsCancellationRequested)
+        {
+            return new StatementImportTimeoutError(ImportTimeout);
+        }
+    }
+
+    private async Task<Result<StatementSummary>> ImportAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        // Тело читается один раз: во временный файл, из него - в архив, затем в разбор.
+        await using var spool = new FileStream(
+            Path.Combine(Path.GetTempPath(), $"billing-statement-{Guid.NewGuid():N}.tmp"),
+            FileMode.CreateNew, FileAccess.ReadWrite, FileShare.None, 81920,
+            FileOptions.Asynchronous | FileOptions.DeleteOnClose);
+        await command.Content.CopyToAsync(spool, ct);
+
+        spool.Position = 0;
+        var archiveName = $"statement-{clock.GetUtcNow():yyyyMMddHHmmss}-{Guid.NewGuid():N}.csv";
+        await archive.SaveAsync(archiveName, spool, ct);
+
+        spool.Position = 0;
+        var matcher = new InvoiceMatcher(await invoices.ListByStatusAsync(InvoiceStatus.Issued, ct));
+        var parsed = await MatchRowsAsync(spool, matcher, ct);
+        if (parsed.Error is not null)
+            return parsed.Error;
+
+        var settled = new ConcurrentBag<InvoiceId>();
+        await Parallel.ForEachAsync(
+            parsed.Payments,
+            new ParallelOptions { MaxDegreeOfParallelism = BankParallelism, CancellationToken = ct },
+            async (payment, token) =>
+            {
+                if (await bank.GetPaymentStatusAsync(payment.Reference, token) == BankPaymentStatus.Settled)
+                    settled.Add(payment.InvoiceId);
+            });
+
+        var paid = 0;
+        foreach (var invoiceId in settled)
+        {
+            var result = await payHandler.HandleAsync(new PayInvoiceCommand(invoiceId), ct);
+            if (result.IsSuccess)
+                paid++;
+        }
+
+        var summary = new StatementSummary(parsed.Rows, parsed.Payments.Count, paid, parsed.Rows - parsed.Payments.Count);
+        logger.LogInformation(
+            "Statement {ArchiveName} imported: {Rows} rows, {Matched} matched, {Paid} paid, {Unmatched} unmatched",
+            archiveName, summary.Rows, summary.Matched, summary.Paid, summary.Unmatched);
+        return summary;
+    }
+
+    private async Task<ParseOutcome> MatchRowsAsync(Stream content, InvoiceMatcher matcher, CancellationToken ct)
+    {
+        using var reader = new StreamReader(content, leaveOpen: true);
+        var header = await reader.ReadLineAsync(ct);
+        if (header is null || header.TrimStart('﻿').Trim() != Header)
+            return ParseOutcome.Fail(new ValidationError("header", $"Expected '{Header}'"));
+
+        var payments = new List<(InvoiceId InvoiceId, string Reference)>();
+        var rows = 0;
+        while (await reader.ReadLineAsync(ct) is { } line)
+        {
+            if (line.Length == 0)
+                continue;
+            if (++rows > StatementLimits.MaxRows)
+                return ParseOutcome.Fail(new ValidationError("rows", $"At most {StatementLimits.MaxRows} rows"));
+
+            // сопоставление - CPU-цикл, отмену проверяем на каждой строке
+            ct.ThrowIfCancellationRequested();
+            var row = ParseRow(line);
+            if (row is null || validator.Check(row) is not null)
+                continue;
+            if (matcher.Match(row) is { } invoiceId)
+                payments.Add((invoiceId, row.Reference));
+        }
+
+        return new ParseOutcome(rows, payments, null);
+    }
+
+    private static StatementRow? ParseRow(string line)
+    {
+        var parts = line.Split(';', 5);
+        if (parts.Length != 5
+            || !DateOnly.TryParseExact(parts[0], "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
+            || !long.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var amount))
+            return null;
+        return new StatementRow(date, amount, parts[2], parts[3], parts[4]);
+    }
+
+    private sealed record ParseOutcome(int Rows, List<(InvoiceId InvoiceId, string Reference)> Payments, BillingError? Error)
+    {
+        public static ParseOutcome Fail(BillingError error) => new(0, [], error);
+    }
+}
