@@ -0,0 +1,44 @@
+using System.Globalization;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public static class StatementParser
+{
+    public const int MaxRows = 200_000;
+
+    // Строка, которую не удалось разобрать, даёт null - она считается несопоставленной.
+    public static async Task<Result<List<StatementRow?>>> ParseAsync(Stream content, CancellationToken ct)
+    {
+        var rows = new List<StatementRow?>();
+        using var reader = new StreamReader(content, leaveOpen: true);
+
+        if (await reader.ReadLineAsync(ct) is null)
+            return new ValidationError("body", "statement is empty");
+
+        while (await reader.ReadLineAsync(ct) is { } line)
+        {
+            if (line.Length == 0)
+                continue;
+            if (rows.Count == MaxRows)
+                return new ValidationError("body", $"statement has more than {MaxRows} rows");
+            rows.Add(ParseLine(line));
+        }
+
+        return rows;
+    }
+
+    private static StatementRow? ParseLine(string line)
+    {
+        // дата;сумма_в_копейках;валюта;референс_платежа;назначение - в назначении возможен ';'
+        var parts = line.Split(';', 5);
+        if (parts.Length < 5
+            || !DateOnly.TryParse(parts[0], CultureInfo.InvariantCulture, out _)
+            || !long.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var amount)
+            || parts[2].Length != 3
+            || parts[3].Length == 0)
+            return null;
+
+        return new StatementRow(amount, parts[2].ToUpperInvariant(), parts[3], parts[4]);
+    }
+}
