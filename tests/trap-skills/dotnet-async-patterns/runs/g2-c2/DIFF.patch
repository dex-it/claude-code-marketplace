@@ -0,0 +1,74 @@
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Handlers.Invoices;
+using Billing.Api.Domain;
+using Billing.Api.Infrastructure.Bank;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+// Content - seekable-поток: сначала уходит в архив, затем разбирается.
+public sealed record ImportStatementCommand(Stream Content);
+
+public sealed record StatementSummary(int Rows, int Matched, int Paid, int Unmatched);
+
+public sealed class ImportStatementHandler(
+    IStatementArchive archive,
+    IInvoiceRepository invoices,
+    BankClient bank,
+    PayInvoiceHandler payInvoice,
+    TimeProvider clock)
+{
+    private static readonly TimeSpan Timeout = TimeSpan.FromMinutes(2);
+
+    // 50 тыс. запросов по ~100 мс последовательно - часы; параллелизм укладывает их в лимит импорта.
+    private const int BankConcurrency = 100;
+
+    public async Task<Result<StatementSummary>> HandleAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(Timeout);
+        try
+        {
+            return await ImportAsync(command, timeout.Token);
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            return new StatementImportTimeoutError(Timeout);
+        }
+    }
+
+    private async Task<Result<StatementSummary>> ImportAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        var fileName = $"statement-{clock.GetUtcNow():yyyyMMdd-HHmmss}-{Guid.NewGuid():N}.csv";
+        await archive.SaveAsync(fileName, command.Content, ct);
+        command.Content.Position = 0;
+
+        var parsed = await StatementParser.ParseAsync(command.Content, ct);
+        if (!parsed.IsSuccess)
+            return parsed.Error!;
+        var rows = parsed.Value!;
+
+        var matcher = new InvoiceMatcher(await invoices.ListByStatusAsync(InvoiceStatus.Issued, ct));
+        var matches = new List<(StatementRow Row, InvoiceId Invoice)>();
+        var taken = new HashSet<InvoiceId>();
+        foreach (var row in rows)
+        {
+            ct.ThrowIfCancellationRequested();
+            if (row is not null && matcher.Match(row) is { } id && taken.Add(id))
+                matches.Add((row, id));
+        }
+
+        var paid = 0;
+        await Parallel.ForEachAsync(
+            matches,
+            new ParallelOptions { MaxDegreeOfParallelism = BankConcurrency, CancellationToken = ct },
+            async (match, token) =>
+            {
+                if (await bank.GetPaymentStatusAsync(match.Row.PaymentRef, token) != BankPaymentStatus.Settled)
+                    return;
+                if ((await payInvoice.HandleAsync(new PayInvoiceCommand(match.Invoice), token)).IsSuccess)
+                    Interlocked.Increment(ref paid);
+            });
+
+        return new StatementSummary(rows.Count, matches.Count, paid, rows.Count - matches.Count);
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs b/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs
new file mode 100644
index 0000000..6579719
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Statements/InvoiceMatcher.cs
@@ -0,0 +1,97 @@
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+// Нечёткое сопоставление назначения с номером счёта: расстояние Левенштейна между номером и ближайшим
+// фрагментом назначения не больше MaxDistance. Счета заранее группируются по сумме и валюте, а точное
+// вхождение части номера отсекает почти все остальные, поэтому полный перебор счетов на строку не нужен.
+public sealed class InvoiceMatcher
+{
+    private const int MaxDistance = 2;
+
+    private readonly Dictionary<(long, string), List<Candidate>> byAmount = new();
+
+    public InvoiceMatcher(IEnumerable<Invoice> issued)
+    {
+        foreach (var invoice in issued)
+        {
+            var key = (invoice.Amount.Minor, invoice.Amount.Currency.ToUpperInvariant());
+            if (!byAmount.TryGetValue(key, out var list))
+                byAmount[key] = list = new List<Candidate>();
+            list.Add(new Candidate(invoice.Id, invoice.Id.ToString().ToLowerInvariant()));
+        }
+    }
+
+    // Единственный ближайший счёт; null, если подходящих нет или ближайших несколько.
+    public InvoiceId? Match(StatementRow row)
+    {
+        if (!byAmount.TryGetValue((row.AmountMinor, row.Currency), out var candidates))
+            return null;
+
+        var text = row.Purpose.ToLowerInvariant();
+        var best = MaxDistance + 1;
+        InvoiceId? found = null;
+        var ambiguous = false;
+
+        foreach (var candidate in candidates)
+        {
+            if (!MayMatch(candidate.Number, text))
+                continue;
+            var distance = Distance(candidate.Number, text);
+            if (distance < best)
+            {
+                best = distance;
+                found = candidate.Id;
+                ambiguous = false;
+            }
+            else if (distance == best && found is not null)
+            {
+                ambiguous = true;
+            }
+        }
+
+        return ambiguous ? null : found;
+    }
+
+    // Номер режется на MaxDistance+1 частей; при <=MaxDistance правок хотя бы одна часть встретится в тексте точно.
+    private static bool MayMatch(string number, string text)
+    {
+        var size = number.Length / (MaxDistance + 1);
+        for (var i = 0; i <= MaxDistance; i++)
+        {
+            var length = i == MaxDistance ? number.Length - size * MaxDistance : size;
+            if (text.AsSpan().Contains(number.AsSpan(i * size, length), StringComparison.Ordinal))
+                return true;
+        }
+
+        return false;
+    }
+
+    // Алгоритм Селлерса: Левенштейн номера до ближайшей подстроки текста.
+    private static int Distance(string pattern, string text)
+    {
+        var m = pattern.Length;
+        Span<int> prev = stackalloc int[m + 1];
+        Span<int> cur = stackalloc int[m + 1];
+        for (var i = 0; i <= m; i++)
+            prev[i] = i;
+
+        var best = prev[m];
+        foreach (var c in text)
+        {
+            cur[0] = 0;
+            for (var i = 1; i <= m; i++)
+                cur[i] = Math.Min(
+                    Math.Min(prev[i] + 1, cur[i - 1] + 1),
+                    prev[i - 1] + (pattern[i - 1] == c ? 0 : 1));
+            best = Math.Min(best, cur[m]);
+            var tmp = prev;
+            prev = cur;
+            cur = tmp;
+        }
+
+        return best;
+    }
+
+    private sealed record Candidate(InvoiceId Id, string Number);
+}
