@@ -0,0 +1,19 @@
+using Billing.Api.Application.Abstractions;
+
+namespace Billing.Api.Infrastructure.Audit;
+
+public sealed class BackgroundAuditTrail(AuditClient client, ILogger<BackgroundAuditTrail> logger) : IAuditTrail
+{
+    public void Record(string actor, string action, string subject, DateTimeOffset at) =>
+        _ = Task.Run(async () =>
+        {
+            try
+            {
+                await client.WriteAsync(new AuditRecord(actor, action, subject, at), CancellationToken.None);
+            }
+            catch (Exception ex)
+            {
+                logger.LogWarning(ex, "Audit write failed for {Action} {Subject}", action, subject);
+            }
+        });
+}
diff --git a/src/Billing.Api/Infrastructure/Pdf/HtmlPdfRenderer.cs b/src/Billing.Api/Infrastructure/Pdf/HtmlPdfRenderer.cs
new file mode 100644
index 0000000..7f6e994
--- /dev/null
+++ b/src/Billing.Api/Infrastructure/Pdf/HtmlPdfRenderer.cs
@@ -0,0 +1,104 @@
+using System.Diagnostics;
+using System.Text;
+using Billing.Api.Application.Abstractions;
+using Microsoft.Extensions.Options;
+
+namespace Billing.Api.Infrastructure.Pdf;
+
+public sealed class HtmlPdfRenderer(IOptions<PdfOptions> options) : IPdfRenderer
+{
+    private const int MaxStderrChars = 4096;
+
+    public async Task<byte[]> RenderAsync(string html, CancellationToken ct)
+    {
+        var opts = options.Value;
+        var psi = new ProcessStartInfo(opts.ToolPath)
+        {
+            RedirectStandardInput = true,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false,
+        };
+        using var process = new Process { StartInfo = psi };
+        process.Start();
+
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(opts.TimeoutSeconds));
+
+        try
+        {
+            // stdout и stderr читаем параллельно с записью stdin, иначе буфер пайпа заполнится и утилита встанет.
+            var stdout = new MemoryStream();
+            var copyOut = process.StandardOutput.BaseStream.CopyToAsync(stdout, timeout.Token);
+            var readErr = ReadHeadAsync(process.StandardError, timeout.Token);
+            var writeIn = WriteInputAsync(process, html, timeout.Token);
+
+            await Task.WhenAll(writeIn, copyOut, readErr);
+            await process.WaitForExitAsync(timeout.Token);
+
+            if (process.ExitCode != 0)
+                throw new PdfRenderException($"htmlpdf exited with code {process.ExitCode}: {readErr.Result}");
+            return stdout.ToArray();
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            Kill(process);
+            throw new PdfRenderException($"htmlpdf timed out after {opts.TimeoutSeconds}s");
+        }
+        catch
+        {
+            Kill(process);
+            throw;
+        }
+    }
+
+    private static async Task WriteInputAsync(Process process, string html, CancellationToken ct)
+    {
+        try
+        {
+            await process.StandardInput.BaseStream.WriteAsync(Encoding.UTF8.GetBytes(html), ct);
+            await process.StandardInput.BaseStream.FlushAsync(ct);
+        }
+        catch (IOException)
+        {
+            // утилита закрыла stdin раньше времени - причина будет в коде выхода и stderr
+        }
+        finally
+        {
+            try
+            {
+                process.StandardInput.Close();
+            }
+            catch (IOException)
+            {
+            }
+        }
+    }
+
+    // Читаем stderr до конца, но храним только начало: предупреждений бывают тысячи строк.
+    private static async Task<string> ReadHeadAsync(StreamReader reader, CancellationToken ct)
+    {
+        var sb = new StringBuilder();
+        var buffer = new char[1024];
+        int n;
+        while ((n = await reader.ReadAsync(buffer.AsMemory(), ct)) > 0)
+        {
+            var room = MaxStderrChars - sb.Length;
+            if (room > 0)
+                sb.Append(buffer, 0, Math.Min(n, room));
+        }
+        return sb.ToString();
+    }
+
+    private static void Kill(Process process)
+    {
+        try
+        {
+            if (!process.HasExited)
+                process.Kill(entireProcessTree: true);
+        }
+        catch (InvalidOperationException)
+        {
+        }
+    }
+}
