@@ -0,0 +1,43 @@
+using System.Net;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Invoices;
+
+public sealed record DownloadInvoicePdfQuery(InvoiceId InvoiceId);
+
+public sealed class DownloadInvoicePdfHandler(
+    IInvoiceRepository invoices,
+    IPdfRenderer renderer,
+    IAuditTrail audit,
+    ICurrentUser currentUser,
+    TimeProvider clock)
+{
+    public async Task<Result<byte[]>> HandleAsync(DownloadInvoicePdfQuery query, CancellationToken ct)
+    {
+        var invoice = await invoices.FindAsync(query.InvoiceId, ct);
+        if (invoice is null)
+            return new InvoiceNotFoundError(query.InvoiceId);
+
+        var pdf = await renderer.RenderAsync(BuildHtml(invoice), ct);
+
+        audit.Record(currentUser.Id, "invoice.pdf_downloaded", invoice.Id.ToString(), clock.GetUtcNow());
+        return pdf;
+    }
+
+    private static string BuildHtml(Invoice invoice)
+    {
+        var minor = invoice.Amount.Minor;
+        var amount = WebUtility.HtmlEncode($"{minor / 100}.{Math.Abs(minor % 100):00} {invoice.Amount.Currency}");
+        return $"""
+            <!DOCTYPE html>
+            <html><head><meta charset="utf-8"><title>Invoice {invoice.Id}</title></head>
+            <body>
+            <h1>Invoice {invoice.Id}</h1>
+            <p>Customer: {invoice.CustomerId}</p>
+            <p>Amount: {amount}</p>
+            <p>Due date: {invoice.DueDate:yyyy-MM-dd}</p>
+            </body></html>
+            """;
+    }
+}
diff --git a/src/Billing.Api/Infrastructure/Audit/BackgroundAuditTrail.cs b/src/Billing.Api/Infrastructure/Audit/BackgroundAuditTrail.cs
