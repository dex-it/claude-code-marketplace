+using Billing.Api.Application.Abstractions;
+using Billing.Api.Infrastructure.Pdf;
+
+namespace Billing.Api.Modules;
+
+public static class PdfModule
+{
+    public static IServiceCollection AddPdf(this IServiceCollection services)
+    {
+        services.AddOptions<PdfOptions>().BindConfiguration("Pdf").ValidateDataAnnotations().ValidateOnStart();
+        services.AddSingleton<IPdfRenderer, HtmlPdfRenderer>();
+        return services;
+    }
+}
