+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed class ImportStatementValidator : BillingValidator<ImportStatementCommand>
+{
+    public ImportStatementValidator()
+    {
+        RuleFor(x => x.Csv).Must(s => s.CanRead && s.CanSeek).WithMessage("statement stream must be readable and seekable");
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/StatementMatcher.cs b/src/Billing.Api/Application/Handlers/Statements/StatementMatcher.cs
new file mode 100644
index 0000000..e749725
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Statements/StatementMatcher.cs
@@ -0,0 +1,92 @@
+using Billing.Api.Domain;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+// Нечёткое сопоставление назначения платежа со счётом: расстояние Левенштейна от номера счёта
+// до ближайшей подстроки назначения не больше MaxDistance.
+public sealed class StatementMatcher
+{
+    public const int MaxDistance = 2;
+    private const int SegmentLength = 12; // номер 36 символов, 3 сегмента: при <= 2 правках один цел
+
+    private readonly Dictionary<string, List<Entry>> bySegment = new(StringComparer.Ordinal);
+
+    public StatementMatcher(IEnumerable<Invoice> issued)
+    {
+        foreach (var invoice in issued)
+        {
+            var entry = new Entry(invoice, invoice.Id.ToString().ToLowerInvariant());
+            for (var i = 0; i + SegmentLength <= entry.Number.Length; i += SegmentLength)
+            {
+                var key = entry.Number.Substring(i, SegmentLength);
+                if (!bySegment.TryGetValue(key, out var list))
+                    bySegment[key] = list = new List<Entry>();
+                list.Add(entry);
+            }
+        }
+    }
+
+    // Единственный подходящий счёт с минимальным расстоянием; при неоднозначности - null.
+    public Invoice? Match(string purpose, Money amount)
+    {
+        var text = purpose.ToLowerInvariant();
+        HashSet<Entry>? candidates = null;
+        for (var i = 0; i + SegmentLength <= text.Length; i++)
+        {
+            if (!bySegment.TryGetValue(text.Substring(i, SegmentLength), out var list))
+                continue;
+            foreach (var entry in list)
+                if (entry.Invoice.Amount == amount)
+                    (candidates ??= new HashSet<Entry>()).Add(entry);
+        }
+
+        if (candidates is null)
+            return null;
+
+        Invoice? best = null;
+        var bestDistance = MaxDistance + 1;
+        var tie = false;
+        foreach (var entry in candidates)
+        {
+            var distance = SubstringDistance(entry.Number, text);
+            if (distance < bestDistance)
+            {
+                best = entry.Invoice;
+                bestDistance = distance;
+                tie = false;
+            }
+            else if (distance == bestDistance && best is not null)
+            {
+                tie = true;
+            }
+        }
+
+        return tie ? null : best;
+    }
+
+    // Седжвик: минимальное расстояние Левенштейна от pattern до любой подстроки text.
+    private static int SubstringDistance(string pattern, string text)
+    {
+        var column = new int[pattern.Length + 1];
+        for (var i = 0; i <= pattern.Length; i++)
+            column[i] = i;
+
+        var best = column[pattern.Length];
+        foreach (var c in text)
+        {
+            var diagonal = column[0]; // D[0][j] = 0
+            for (var i = 1; i <= pattern.Length; i++)
+            {
+                var above = column[i];
+                column[i] = Math.Min(Math.Min(above + 1, column[i - 1] + 1), diagonal + (pattern[i - 1] == c ? 0 : 1));
+                diagonal = above;
+            }
+
+            best = Math.Min(best, column[pattern.Length]);
+        }
+
+        return best;
+    }
+
+    private sealed record Entry(Invoice Invoice, string Number);
+}
