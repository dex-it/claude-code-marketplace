@@ -0,0 +1,39 @@
+using Billing.Api.Application.Handlers.Statements;
+using Microsoft.AspNetCore.Http.Features;
+
+namespace Billing.Api.Api;
+
+public static class StatementEndpoints
+{
+    private const long MaxBodyBytes = 50L * 1024 * 1024;
+    private const int MemoryBufferBytes = 64 * 1024;
+
+    public static IEndpointRouteBuilder MapStatementEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/statements", async (HttpRequest request, ImportStatementHandler handler, CancellationToken ct) =>
+        {
+            if (request.ContentType?.StartsWith("text/csv", StringComparison.OrdinalIgnoreCase) != true)
+                return Results.StatusCode(StatusCodes.Status415UnsupportedMediaType);
+
+            if (request.HttpContext.Features.Get<IHttpMaxRequestBodySizeFeature>() is { IsReadOnly: false } limit)
+                limit.MaxRequestBodySize = MaxBodyBytes;
+            // выписка пишется в архив как есть, затем читается заново; сверх порога буфер уходит на диск
+            request.EnableBuffering(MemoryBufferBytes, MaxBodyBytes);
+
+            try
+            {
+                await request.Body.CopyToAsync(Stream.Null, ct);
+            }
+            catch (Exception e) when (e is InvalidDataException or BadHttpRequestException)
+            {
+                return Results.StatusCode(StatusCodes.Status413PayloadTooLarge);
+            }
+
+            request.Body.Position = 0;
+            return (await handler.HandleAsync(new ImportStatementCommand(request.Body), ct))
+                .ToHttp(s => Results.Ok(new { rows = s.Rows, matched = s.Matched, paid = s.Paid, unmatched = s.Unmatched }));
+        });
+
+        return app;
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
new file mode 100644
index 0000000..7c9bb4d
--- /dev/null
+++ b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
@@ -0,0 +1,88 @@
+using System.Globalization;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Handlers.Invoices;
+using Billing.Api.Domain;
+using Billing.Api.Infrastructure.Bank;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed record ImportStatementCommand(Stream Csv);
+
+public sealed record StatementSummary(int Rows, int Matched, int Paid, int Unmatched);
+
+public sealed class ImportStatementHandler(
+    IStatementArchive archive,
+    IInvoiceRepository invoices,
+    BankClient bank,
+    PayInvoiceHandler payInvoice,
+    ImportStatementValidator validator,
+    TimeProvider clock)
+{
+    public static readonly TimeSpan Timeout = TimeSpan.FromMinutes(2);
+    private const int BankParallelism = 100; // 50 тыс. сверок по ~100 мс должны уложиться в таймаут
+
+    private sealed record Payment(string Ref, Invoice Invoice);
+
+    public async Task<Result<StatementSummary>> HandleAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        if (validator.Check(command) is { } error)
+            return error;
+
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        deadline.CancelAfter(Timeout);
+        try
+        {
+            return await ImportAsync(command.Csv, deadline.Token);
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested && deadline.IsCancellationRequested)
+        {
+            return new StatementTimeoutError(Timeout);
+        }
+    }
+
+    private async Task<Result<StatementSummary>> ImportAsync(Stream csv, CancellationToken ct)
+    {
+        var now = clock.GetUtcNow();
+        await archive.SaveAsync($"statement-{now:yyyyMMddTHHmmss}-{Guid.NewGuid():N}.csv", csv, ct);
+        csv.Position = 0;
+
+        var matcher = new StatementMatcher(await invoices.ListByStatusAsync(InvoiceStatus.Issued, ct));
+        var payments = new List<Payment>();
+        var claimed = new HashSet<InvoiceId>();
+        var rows = 0;
+
+        using var reader = new StreamReader(csv);
+        if (await reader.ReadLineAsync(ct) is null)
+            return new ValidationError("csv", "header row is missing");
+
+        while (await reader.ReadLineAsync(ct) is { } line)
+        {
+            if (line.Length == 0)
+                continue;
+            rows++;
+            var parts = line.Split(';', 5);
+            if (parts.Length < 5
+                || !long.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var minor))
+                continue;
+
+            var money = new Money(minor, parts[2].Trim().ToUpperInvariant());
+            if (matcher.Match(parts[4], money) is { } invoice && claimed.Add(invoice.Id))
+                payments.Add(new Payment(parts[3].Trim(), invoice));
+        }
+
+        var paid = 0;
+        await Parallel.ForEachAsync(
+            payments,
+            new ParallelOptions { MaxDegreeOfParallelism = BankParallelism, CancellationToken = ct },
+            async (payment, token) =>
+            {
+                if (await bank.GetPaymentStatusAsync(payment.Ref, token) != BankPaymentStatus.Settled)
+                    return;
+                var result = await payInvoice.HandleAsync(new PayInvoiceCommand(payment.Invoice.Id), token);
+                if (result.IsSuccess)
+                    Interlocked.Increment(ref paid);
+            });
+
+        return new StatementSummary(rows, payments.Count, paid, rows - payments.Count);
+    }
+}
