@@ -0,0 +1,20 @@
+using Billing.Api.Application.Validation;
+using FluentValidation;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+public sealed class ImportStatementValidator : BillingValidator<ParsedStatement>
+{
+    public const int MaxRows = 200_000;
+
+    public ImportStatementValidator()
+    {
+        RuleFor(x => x.Rows.Count).LessThanOrEqualTo(MaxRows).WithName("Rows");
+        RuleForEach(x => x.Rows).ChildRules(row =>
+        {
+            row.RuleFor(r => r.Currency).Length(3);
+            row.RuleFor(r => r.PaymentRef).MaximumLength(100);
+            row.RuleFor(r => r.Purpose).MaximumLength(1000);
+        });
+    }
+}
