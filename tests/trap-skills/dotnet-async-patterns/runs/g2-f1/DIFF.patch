+using Billing.Api.Application.Handlers.Statements;
+using Microsoft.AspNetCore.Http.Features;
+
+namespace Billing.Api.Api;
+
+public static class StatementEndpoints
+{
+    private const long MaxBodyBytes = 50L * 1024 * 1024;
+    private static readonly TimeSpan ImportTimeout = TimeSpan.FromMinutes(2);
+
+    public static IEndpointRouteBuilder MapStatementEndpoints(this IEndpointRouteBuilder app)
+    {
+        app.MapPost("/statements", async (HttpRequest request, ImportStatementHandler handler, TimeProvider clock, CancellationToken ct) =>
+        {
+            if (!string.Equals(request.ContentType?.Split(';')[0].Trim(), "text/csv", StringComparison.OrdinalIgnoreCase))
+                return Results.Problem("Content-Type must be text/csv", statusCode: StatusCodes.Status415UnsupportedMediaType);
+
+            request.HttpContext.Features.Get<IHttpMaxRequestBodySizeFeature>()!.MaxRequestBodySize = MaxBodyBytes;
+            request.EnableBuffering(bufferThreshold: 64 * 1024, bufferLimit: MaxBodyBytes);
+
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            timeout.CancelAfter(ImportTimeout);
+            var fileName = $"statement-{clock.GetUtcNow():yyyyMMdd}-{Guid.NewGuid():N}.csv";
+            try
+            {
+                return (await handler.HandleAsync(new ImportStatementCommand(fileName, request.Body), timeout.Token))
+                    .ToHttp(s => Results.Ok(new { lines = s.Lines, matched = s.Matched, paid = s.Paid, unmatched = s.Unmatched }));
+            }
+            catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+            {
+                return Results.Problem("Statement import timed out", statusCode: StatusCodes.Status504GatewayTimeout);
+            }
+        });
+
+        return app;
+    }
+}
diff --git a/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
