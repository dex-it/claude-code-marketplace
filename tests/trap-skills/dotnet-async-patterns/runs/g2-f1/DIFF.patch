+++ b/src/Billing.Api/Application/Handlers/Statements/ImportStatementHandler.cs
@@ -0,0 +1,145 @@
+using System.Globalization;
+using Billing.Api.Application.Abstractions;
+using Billing.Api.Application.Handlers.Invoices;
+using Billing.Api.Domain;
+using Billing.Api.Infrastructure.Bank;
+
+namespace Billing.Api.Application.Handlers.Statements;
+
+// Content должен быть перематываемым: сначала он уходит в архив, затем читается заново.
+public sealed record ImportStatementCommand(string FileName, Stream Content);
+
+public sealed class ImportStatementHandler(
+    IStatementArchive archive,
+    IInvoiceRepository invoices,
+    BankClient bank,
+    PayInvoiceHandler payInvoice,
+    ImportStatementValidator validator,
+    ILogger<ImportStatementHandler> logger)
+{
+    private const int MaxTypos = 2;
+    private const int BankParallelism = 100;
+    private const string Header = "дата;сумма_в_копейках;валюта;референс_платежа;назначение";
+
+    public async Task<Result<StatementImportSummary>> HandleAsync(ImportStatementCommand command, CancellationToken ct)
+    {
+        using var scope = logger.BeginScope("Statement {FileName}", command.FileName);
+
+        await archive.SaveAsync(command.FileName, command.Content, ct);
+        command.Content.Position = 0;
+
+        var parsed = await ParseAsync(command.Content, ct);
+        if (parsed is null)
+            return new ValidationError("header", $"Expected first line: {Header}");
+        if (validator.Check(parsed) is { } error)
+            return error;
+
+        var matches = await MatchAsync(parsed.Rows, ct);
+        var paid = 0;
+        var bankFailures = 0;
+        await Parallel.ForEachAsync(matches, new ParallelOptions
+        {
+            MaxDegreeOfParallelism = BankParallelism,
+            CancellationToken = ct,
+        }, async (match, token) =>
+        {
+            try
+            {
+                if (await bank.GetPaymentStatusAsync(match.PaymentRef, token) != BankPaymentStatus.Settled)
+                    return;
+            }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                Interlocked.Increment(ref bankFailures);
+                return;
+            }
+
+            if ((await payInvoice.HandleAsync(new PayInvoiceCommand(match.InvoiceId), token)).IsSuccess)
+                Interlocked.Increment(ref paid);
+        });
+
+        var lines = parsed.Rows.Count + parsed.MalformedLines;
+        var summary = new StatementImportSummary(lines, matches.Count, paid, lines - matches.Count);
+        if (bankFailures > 0)
+            logger.LogWarning("Bank status check failed for {BankFailures} payments", bankFailures);
+        logger.LogInformation("Statement imported: {Lines} lines, {Matched} matched, {Paid} paid",
+            summary.Lines, summary.Matched, summary.Paid);
+        return summary;
+    }
+
+    private static async Task<ParsedStatement?> ParseAsync(Stream content, CancellationToken ct)
+    {
+        using var reader = new StreamReader(content, leaveOpen: true);
+        if (await reader.ReadLineAsync(ct) is not { } header || header.Trim().TrimStart('﻿') != Header)
+            return null;
+
+        var rows = new List<StatementRow>();
+        var malformed = 0;
+        while (await reader.ReadLineAsync(ct) is { } line)
+        {
+            if (string.IsNullOrWhiteSpace(line))
+                continue;
+            var parts = line.Split(';', 5);
+            if (parts.Length == 5
+                && DateOnly.TryParse(parts[0], CultureInfo.InvariantCulture, out var date)
+                && long.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var amount))
+                rows.Add(new StatementRow(date, amount, parts[2], parts[3], parts[4]));
+            else
+                malformed++;
+        }
+
+        return new ParsedStatement(rows, malformed);
+    }
+
+    private async Task<List<MatchedPayment>> MatchAsync(IReadOnlyList<StatementRow> rows, CancellationToken ct)
+    {
+        var issued = await invoices.ListByStatusAsync(InvoiceStatus.Issued, ct);
+        var byAmount = issued
+            .GroupBy(i => (i.Amount.Minor, i.Amount.Currency))
+            .ToDictionary(g => g.Key, g => g.Select(i => (Invoice: i, Key: i.Id.ToString().ToLowerInvariant())).ToList());
+
+        var claimed = new HashSet<InvoiceId>();
+        var matches = new List<MatchedPayment>();
+        foreach (var row in rows)
+        {
+            ct.ThrowIfCancellationRequested();
+            if (!byAmount.TryGetValue((row.AmountMinor, row.Currency), out var candidates))
+                continue;
+            if (FindInvoice(row.Purpose, candidates) is { } invoice && claimed.Add(invoice.Id))
+                matches.Add(new MatchedPayment(invoice.Id, row.PaymentRef));
+        }
+
+        return matches;
+    }
+
+    // Счёт с наименьшим расстоянием до слова назначения; при равенстве у разных счетов - не сопоставлен.
+    private static Invoice? FindInvoice(string purpose, List<(Invoice Invoice, string Key)> candidates)
+    {
+        var idLength = candidates[0].Key.Length;
+        Invoice? best = null;
+        var bestDistance = MaxTypos + 1;
+        var tie = false;
+        foreach (var token in purpose.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries))
+        {
+            var word = token.Trim(',', '.', ':', ';', '"', '(', ')').ToLowerInvariant();
+            if (Math.Abs(word.Length - idLength) > MaxTypos)
+                continue;
+            foreach (var (invoice, key) in candidates)
+            {
+                var distance = Levenshtein.Distance(word, key, MaxTypos);
+                if (distance < bestDistance)
+                {
+                    (best, bestDistance, tie) = (invoice, distance, false);
+                }
+                else if (distance == bestDistance && best is not null && best.Id != invoice.Id)
+                {
+                    tie = true;
+                }
+            }
+        }
+
+        return tie ? null : best;
+    }
+
+    private sealed record MatchedPayment(InvoiceId InvoiceId, string PaymentRef);
+}
