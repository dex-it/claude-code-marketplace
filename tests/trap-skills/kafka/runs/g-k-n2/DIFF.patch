@@ -0,0 +1,62 @@
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Confluent.Kafka;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+public static class KafkaJson
+{
+    public static readonly JsonSerializerOptions Options = new(JsonSerializerDefaults.Web)
+    {
+        Converters = { new JsonStringEnumConverter() }
+    };
+}
+
+// Один продьюсер на процесс. Идемпотентность: повторы отправки librdkafka не дублируют и не переупорядочивают.
+public sealed class KafkaPublisher : IDisposable
+{
+    private readonly IProducer<string, byte[]> _producer;
+    private readonly FulfilOptions _options;
+
+    public KafkaPublisher(IOptions<FulfilOptions> options)
+    {
+        _options = options.Value;
+        _producer = new ProducerBuilder<string, byte[]>(new ProducerConfig
+        {
+            BootstrapServers = _options.KafkaBootstrapServers,
+            EnableIdempotence = true,
+            Acks = Acks.All
+        }).Build();
+    }
+
+    public async Task PublishAsync<T>(string topic, string key, T message, CancellationToken ct)
+    {
+        var value = JsonSerializer.SerializeToUtf8Bytes(message, KafkaJson.Options);
+        await _producer.ProduceAsync(topic, new Message<string, byte[]> { Key = key, Value = value }, ct);
+    }
+
+    // Нечитаемое сообщение уходит в "<топик>.dlq" как есть, с причиной в заголовке.
+    public async Task DeadLetterAsync(ConsumeResult<string, byte[]> source, string reason, CancellationToken ct)
+    {
+        var message = new Message<string, byte[]>
+        {
+            Key = source.Message.Key,
+            Value = source.Message.Value,
+            Headers = new Headers
+            {
+                { "dlq-reason", Encoding.UTF8.GetBytes(reason) },
+                { "dlq-source", Encoding.UTF8.GetBytes($"{source.Topic}[{source.Partition.Value}]@{source.Offset.Value}") }
+            }
+        };
+        await _producer.ProduceAsync(source.Topic + _options.DeadLetterSuffix, message, ct);
+    }
+
+    public void Dispose()
+    {
+        _producer.Flush(TimeSpan.FromSeconds(10));
+        _producer.Dispose();
+    }
+}
diff --git a/src/Fulfil/Kafka/OrderImportWorker.cs b/src/Fulfil/Kafka/OrderImportWorker.cs
