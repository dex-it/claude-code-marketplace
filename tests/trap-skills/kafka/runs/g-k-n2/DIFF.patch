--- /dev/null
+++ b/src/Fulfil/Kafka/ConsumerWorker.cs
@@ -0,0 +1,85 @@
+using Confluent.Kafka;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+// Основа потребителей. Смещение сохраняется (StoreOffset) только после обработки сообщения,
+// фиксирует его фоновый автокоммит и ребаланс, поэтому необработанное не теряется,
+// а обработанное после ребаланса перечитывается лишь в пределах последнего интервала коммита.
+// Обработка поэтому должна быть идемпотентной.
+public abstract class ConsumerWorker : BackgroundService
+{
+    protected readonly FulfilOptions Options;
+    protected readonly ILogger Logger;
+
+    protected ConsumerWorker(IOptions<FulfilOptions> options, ILogger logger)
+    {
+        Options = options.Value;
+        Logger = logger;
+    }
+
+    protected abstract string Topic { get; }
+
+    protected abstract Task RunAsync(IConsumer<string, byte[]> consumer, CancellationToken ct);
+
+    protected override Task ExecuteAsync(CancellationToken stoppingToken) =>
+        Task.Run(async () =>
+        {
+            using var consumer = new ConsumerBuilder<string, byte[]>(new ConsumerConfig
+            {
+                BootstrapServers = Options.KafkaBootstrapServers,
+                GroupId = Options.KafkaGroupId,
+                AutoOffsetReset = AutoOffsetReset.Earliest,
+                EnableAutoCommit = true,
+                EnableAutoOffsetStore = false,
+                // Три реплики и rolling update: кооперативный ребаланс не останавливает все партиции.
+                PartitionAssignmentStrategy = PartitionAssignmentStrategy.CooperativeSticky
+            }).Build();
+            consumer.Subscribe(Topic);
+            try
+            {
+                await RunAsync(consumer, stoppingToken);
+            }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+            {
+            }
+            finally
+            {
+                consumer.Close(); // коммит сохранённых смещений и выход из группы
+            }
+        }, CancellationToken.None);
+
+    protected ConsumeResult<string, byte[]>? TryConsume(IConsumer<string, byte[]> consumer, TimeSpan timeout, CancellationToken ct)
+    {
+        try
+        {
+            return consumer.Consume(timeout);
+        }
+        catch (ConsumeException e) when (!e.Error.IsFatal)
+        {
+            Logger.LogWarning(e, "Ошибка чтения из {Topic}", Topic);
+            return null;
+        }
+    }
+
+    // Повтор при временных сбоях (Mongo, брокер): смещение не сохраняется, сообщение не пропускается.
+    protected async Task RetryAsync(Func<Task> action, CancellationToken ct)
+    {
+        var delay = TimeSpan.FromSeconds(1);
+        while (true)
+        {
+            try
+            {
+                await action();
+                return;
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                Logger.LogError(e, "Сбой обработки в {Topic}, повтор через {Delay}", Topic, delay);
+                await Task.Delay(delay, ct);
+                delay = TimeSpan.FromSeconds(Math.Min(delay.TotalSeconds * 2, 30));
+            }
+        }
+    }
+}
diff --git a/src/Fulfil/Kafka/KafkaPublisher.cs b/src/Fulfil/Kafka/KafkaPublisher.cs
