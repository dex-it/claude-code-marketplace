+++ b/src/Fulfil/Kafka/OrderPlacedWorker.cs
@@ -0,0 +1,65 @@
+using System.Text.Json;
+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Mongo;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+// orders.placed -> проекция клиента -> OrderStatusChanged(Placed).
+public sealed class OrderPlacedWorker : ConsumerWorker
+{
+    private readonly CustomerProjection _projection;
+    private readonly KafkaPublisher _publisher;
+
+    public OrderPlacedWorker(
+        IOptions<FulfilOptions> options,
+        CustomerProjection projection,
+        KafkaPublisher publisher,
+        ILogger<OrderPlacedWorker> logger) : base(options, logger)
+    {
+        _projection = projection;
+        _publisher = publisher;
+    }
+
+    protected override string Topic => Options.OrdersPlacedTopic;
+
+    protected override async Task RunAsync(IConsumer<string, byte[]> consumer, CancellationToken ct)
+    {
+        while (!ct.IsCancellationRequested)
+        {
+            var result = TryConsume(consumer, TimeSpan.FromSeconds(1), ct);
+            if (result?.Message is null) continue;
+
+            OrderPlaced? order;
+            try
+            {
+                order = JsonSerializer.Deserialize<OrderPlaced>(result.Message.Value, KafkaJson.Options);
+                if (order is null || order.OrderId == Guid.Empty || order.CustomerId == Guid.Empty || order.Lines is null)
+                    throw new JsonException("Пустой идентификатор или нет строк заказа");
+            }
+            catch (JsonException e)
+            {
+                // Ядовитое сообщение: в DLQ и дальше, партиция не блокируется.
+                Logger.LogError(e, "Нечитаемое сообщение {Partition}@{Offset}, в DLQ", result.Partition.Value, result.Offset.Value);
+                await RetryAsync(() => _publisher.DeadLetterAsync(result, e.Message, ct), ct);
+                consumer.StoreOffset(result);
+                continue;
+            }
+
+            await RetryAsync(async () =>
+            {
+                await _projection.ApplyAsync(order, ct);
+                // При повторной доставке событие уйдёт ещё раз: склад различает его по OrderId.
+                await _publisher.PublishAsync(
+                    Options.OrderStatusChangedTopic,
+                    order.OrderId.ToString(),
+                    new OrderStatusChanged(order.OrderId, OrderStatus.Placed, DateTimeOffset.UtcNow),
+                    ct);
+            }, ct);
+            consumer.StoreOffset(result);
+        }
+    }
+}
diff --git a/src/Fulfil/Mongo/MongoStores.cs b/src/Fulfil/Mongo/MongoStores.cs
new file mode 100644
index 0000000..ad13261
--- /dev/null
+++ b/src/Fulfil/Mongo/MongoStores.cs
@@ -0,0 +1,86 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Mongo;
+
+// Проекция клиентов. Повторная доставка не должна учесть заказ дважды, а транзакций на одиночном
+// узле нет, поэтому идентификатор заказа проверяется и пишется тем же атомарным обновлением
+// документа клиента (хранятся последние RecentLimit заказов - с запасом на окно повторной доставки).
+public sealed class CustomerProjection
+{
+    private const int RecentLimit = 1000;
+    private readonly IMongoCollection<BsonDocument> _customers;
+
+    public CustomerProjection(IMongoClient client, IOptions<FulfilOptions> options) =>
+        _customers = client.GetDatabase(options.Value.MongoDatabase).GetCollection<BsonDocument>("customers");
+
+    public async Task ApplyAsync(OrderPlaced placed, CancellationToken ct)
+    {
+        var orderId = placed.OrderId.ToString();
+        var total = placed.Lines.Sum(l => l.Quantity * l.UnitPrice);
+
+        var filter = Builders<BsonDocument>.Filter.Eq("_id", placed.CustomerId.ToString())
+                     & Builders<BsonDocument>.Filter.Ne("recentOrderIds", orderId);
+        var update = new BsonDocument
+        {
+            ["$inc"] = new BsonDocument { ["ordersCount"] = 1, ["totalSpent"] = new BsonDecimal128(total) },
+            ["$push"] = new BsonDocument
+            {
+                ["recentOrderIds"] = new BsonDocument { ["$each"] = new BsonArray { orderId }, ["$slice"] = -RecentLimit }
+            }
+        };
+
+        try
+        {
+            await _customers.UpdateOneAsync(filter, update, new UpdateOptions { IsUpsert = true }, ct);
+        }
+        catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            // Клиент есть, и заказ в нём уже учтён: upsert упёрся в _id.
+        }
+    }
+}
+
+public sealed class OrderImportStore
+{
+    private readonly IMongoCollection<BsonDocument> _orders;
+
+    public OrderImportStore(IMongoClient client, IOptions<FulfilOptions> options) =>
+        _orders = client.GetDatabase(options.Value.MongoDatabase).GetCollection<BsonDocument>("orders");
+
+    // Неупорядоченная вставка с _id = идентификатор заказа: после повторной доставки пачки
+    // дубликаты отбрасываются, остальное дописывается.
+    public async Task InsertBatchAsync(IEnumerable<OrderPlaced> placed, CancellationToken ct)
+    {
+        var documents = placed
+            .DistinctBy(p => p.OrderId)
+            .Select(p => new BsonDocument
+            {
+                ["_id"] = p.OrderId.ToString(),
+                ["customerId"] = p.CustomerId.ToString(),
+                ["status"] = OrderStatus.Placed.ToString(),
+                ["lines"] = new BsonArray(p.Lines.Select(l => new BsonDocument
+                {
+                    ["sku"] = l.Sku,
+                    ["quantity"] = l.Quantity,
+                    ["unitPrice"] = new BsonDecimal128(l.UnitPrice)
+                })),
+                ["total"] = new BsonDecimal128(p.Lines.Sum(l => l.Quantity * l.UnitPrice)),
+                ["giftWrap"] = p.GiftWrap,
+                ["placedAt"] = p.PlacedAt.UtcDateTime
+            })
+            .ToList();
+
+        try
+        {
+            await _orders.InsertManyAsync(documents, new InsertManyOptions { IsOrdered = false }, ct);
+        }
+        catch (MongoBulkWriteException e) when (e.WriteErrors.All(w => w.Category == ServerErrorCategory.DuplicateKey))
+        {
+        }
+    }
+}
