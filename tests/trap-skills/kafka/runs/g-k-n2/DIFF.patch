--- /dev/null
+++ b/src/Fulfil/Kafka/OrderImportWorker.cs
@@ -0,0 +1,69 @@
+using System.Text.Json;
+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Mongo;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+// Ночной импорт: orders.import (формат OrderPlaced), пачки по ImportBatchSize, один InsertMany на пачку.
+// В памяти держится только текущая пачка, не весь миллион.
+public sealed class OrderImportWorker : ConsumerWorker
+{
+    private static readonly TimeSpan BatchWait = TimeSpan.FromSeconds(1);
+
+    private readonly OrderImportStore _store;
+    private readonly KafkaPublisher _publisher;
+
+    public OrderImportWorker(
+        IOptions<FulfilOptions> options,
+        OrderImportStore store,
+        KafkaPublisher publisher,
+        ILogger<OrderImportWorker> logger) : base(options, logger)
+    {
+        _store = store;
+        _publisher = publisher;
+    }
+
+    protected override string Topic => Options.OrdersImportTopic;
+
+    protected override async Task RunAsync(IConsumer<string, byte[]> consumer, CancellationToken ct)
+    {
+        var batch = new List<ConsumeResult<string, byte[]>>(Options.ImportBatchSize);
+        while (!ct.IsCancellationRequested)
+        {
+            batch.Clear();
+            while (batch.Count < Options.ImportBatchSize)
+            {
+                var result = TryConsume(consumer, BatchWait, ct);
+                if (result?.Message is null) break; // топик иссяк или пауза: обрабатываем, что набралось
+                batch.Add(result);
+            }
+            if (batch.Count == 0) continue;
+
+            var orders = new List<OrderPlaced>(batch.Count);
+            foreach (var result in batch)
+            {
+                try
+                {
+                    var order = JsonSerializer.Deserialize<OrderPlaced>(result.Message.Value, KafkaJson.Options);
+                    if (order is null || order.OrderId == Guid.Empty || order.CustomerId == Guid.Empty || order.Lines is null)
+                        throw new JsonException("Пустой идентификатор или нет строк заказа");
+                    orders.Add(order);
+                }
+                catch (JsonException e)
+                {
+                    Logger.LogError(e, "Нечитаемое сообщение {Partition}@{Offset}, в DLQ", result.Partition.Value, result.Offset.Value);
+                    await RetryAsync(() => _publisher.DeadLetterAsync(result, e.Message, ct), ct);
+                }
+            }
+
+            if (orders.Count > 0)
+                await RetryAsync(() => _store.InsertBatchAsync(orders, ct), ct);
+
+            // Смещения сохраняются после записи всей пачки.
+            foreach (var result in batch) consumer.StoreOffset(result);
+        }
+    }
+}
diff --git a/src/Fulfil/Kafka/OrderPlacedWorker.cs b/src/Fulfil/Kafka/OrderPlacedWorker.cs
