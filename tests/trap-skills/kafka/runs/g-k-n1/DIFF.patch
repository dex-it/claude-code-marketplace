diff --git a/src/Fulfil/Kafka/KafkaSupport.cs b/src/Fulfil/Kafka/KafkaSupport.cs
new file mode 100644
index 0000000..38c3652
--- /dev/null
+++ b/src/Fulfil/Kafka/KafkaSupport.cs
@@ -0,0 +1,109 @@
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+public static class OrderJson
+{
+    public static readonly JsonSerializerOptions Options = new(JsonSerializerDefaults.Web)
+    {
+        Converters = { new JsonStringEnumConverter() }
+    };
+
+    // null - сообщение не разобрать или оно не соответствует контракту (ядовитое).
+    // Старый формат без giftWrap даёт GiftWrap = false.
+    public static OrderPlaced? TryParse(byte[]? value, out string error)
+    {
+        error = "";
+        if (value is null || value.Length == 0) { error = "empty value"; return null; }
+        try
+        {
+            var e = JsonSerializer.Deserialize<OrderPlaced>(value, Options);
+            if (e is null || e.OrderId == Guid.Empty || e.CustomerId == Guid.Empty || e.Lines is null)
+            {
+                error = "missing required fields";
+                return null;
+            }
+            return e;
+        }
+        catch (JsonException ex)
+        {
+            error = ex.Message;
+            return null;
+        }
+    }
+}
+
+public static class Retry
+{
+    // Временные сбои (Mongo, брокер) повторяем на месте, не пропуская сообщение:
+    // смещение сохраняется только после успеха.
+    public static async Task RunAsync(Func<Task> action, ILogger logger, string what, CancellationToken ct)
+    {
+        var delay = TimeSpan.FromSeconds(1);
+        while (true)
+        {
+            try { await action(); return; }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                logger.LogWarning(ex, "{What} failed, retry in {Delay}", what, delay);
+                await Task.Delay(delay, ct);
+                delay = TimeSpan.FromSeconds(Math.Min(delay.TotalSeconds * 2, 30));
+            }
+        }
+    }
+}
+
+// Общий идемпотентный продьюсер: статусы заказов и dead-letter.
+public sealed class KafkaPublisher : IDisposable
+{
+    private readonly IProducer<byte[]?, byte[]?> _producer;
+    private readonly FulfilOptions _options;
+
+    public KafkaPublisher(IOptions<FulfilOptions> options)
+    {
+        _options = options.Value;
+        _producer = new ProducerBuilder<byte[]?, byte[]?>(new ProducerConfig
+        {
+            BootstrapServers = _options.KafkaBootstrapServers,
+            EnableIdempotence = true,
+            Acks = Acks.All
+        }).Build();
+    }
+
+    public async Task PublishStatusChangedAsync(OrderPlaced placed, CancellationToken ct)
+    {
+        var evt = new OrderStatusChanged(placed.OrderId, Domain.OrderStatus.Placed, DateTimeOffset.UtcNow);
+        await _producer.ProduceAsync(_options.StatusChangedTopic, new Message<byte[]?, byte[]?>
+        {
+            Key = Encoding.UTF8.GetBytes(placed.OrderId.ToString()),
+            Value = JsonSerializer.SerializeToUtf8Bytes(evt, OrderJson.Options)
+        }, ct);
+    }
+
+    public async Task SendToDeadLetterAsync(ConsumeResult<byte[]?, byte[]?> source, string error, CancellationToken ct)
+    {
+        var headers = new Headers
+        {
+            { "dlq-error", Encoding.UTF8.GetBytes(error) },
+            { "dlq-source", Encoding.UTF8.GetBytes($"{source.Topic}[{source.Partition.Value}]@{source.Offset.Value}") }
+        };
+        await _producer.ProduceAsync(source.Topic + ".dlq", new Message<byte[]?, byte[]?>
+        {
+            Key = source.Message.Key,
+            Value = source.Message.Value,
+            Headers = headers
+        }, ct);
+    }
+
+    public void Dispose()
+    {
+        _producer.Flush(TimeSpan.FromSeconds(5));
+        _producer.Dispose();
+    }
+}
