@@ -0,0 +1,138 @@
+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Mongo;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+internal static class ConsumerFactory
+{
+    // Смещения не сохраняются автоматически: StoreOffset вызывается только после обработки,
+    // а фоновый автокоммит (в том числе при ребалансе) коммитит лишь сохранённое.
+    public static IConsumer<byte[]?, byte[]?> Create(FulfilOptions o, string groupId) =>
+        new ConsumerBuilder<byte[]?, byte[]?>(new ConsumerConfig
+        {
+            BootstrapServers = o.KafkaBootstrapServers,
+            GroupId = groupId,
+            EnableAutoCommit = true,
+            EnableAutoOffsetStore = false,
+            AutoOffsetReset = AutoOffsetReset.Earliest,
+            PartitionAssignmentStrategy = PartitionAssignmentStrategy.CooperativeSticky
+        }).Build();
+}
+
+// orders.placed -> проекция клиента -> OrderStatusChanged(Placed).
+public sealed class OrdersPlacedConsumer(
+    IOptions<FulfilOptions> options,
+    CustomerProjection projection,
+    KafkaPublisher publisher,
+    ILogger<OrdersPlacedConsumer> logger) : BackgroundService
+{
+    private readonly FulfilOptions _o = options.Value;
+
+    protected override Task ExecuteAsync(CancellationToken ct) => Task.Run(() => RunAsync(ct), ct);
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        using var consumer = ConsumerFactory.Create(_o, _o.OrdersGroupId);
+        consumer.Subscribe(_o.OrdersPlacedTopic);
+        try
+        {
+            while (!ct.IsCancellationRequested)
+            {
+                ConsumeResult<byte[]?, byte[]?> r;
+                try { r = consumer.Consume(ct); }
+                catch (ConsumeException ex)
+                {
+                    logger.LogWarning(ex, "Consume error");
+                    continue;
+                }
+                if (r?.Message is null) continue;
+
+                var placed = OrderJson.TryParse(r.Message.Value, out var error);
+                if (placed is null)
+                {
+                    logger.LogError("Poison message {Tp}@{Offset}: {Error}, sent to dead letter",
+                        r.TopicPartition, r.Offset.Value, error);
+                    await Retry.RunAsync(() => publisher.SendToDeadLetterAsync(r, error, ct),
+                        logger, "dead letter publish", ct);
+                }
+                else
+                {
+                    await Retry.RunAsync(async () =>
+                    {
+                        await projection.ApplyAsync(placed, ct);
+                        // публикуем и для повторно пришедшего заказа: прошлая попытка могла
+                        // упасть между учётом и публикацией; склад получит дубль события
+                        await publisher.PublishStatusChangedAsync(placed, ct);
+                    }, logger, $"order {placed.OrderId}", ct);
+                }
+                consumer.StoreOffset(r);
+            }
+        }
+        catch (OperationCanceledException) { }
+        finally { consumer.Close(); }
+    }
+}
+
+// orders.import: пачки по ImportBatchSize, один InsertMany на пачку.
+public sealed class OrdersImportConsumer(
+    IOptions<FulfilOptions> options,
+    OrderImportStore store,
+    KafkaPublisher publisher,
+    ILogger<OrdersImportConsumer> logger) : BackgroundService
+{
+    private readonly FulfilOptions _o = options.Value;
+
+    protected override Task ExecuteAsync(CancellationToken ct) => Task.Run(() => RunAsync(ct), ct);
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        using var consumer = ConsumerFactory.Create(_o, _o.OrdersImportGroupId);
+        consumer.Subscribe(_o.OrdersImportTopic);
+        try
+        {
+            while (!ct.IsCancellationRequested)
+            {
+                var results = new List<ConsumeResult<byte[]?, byte[]?>>();
+                try
+                {
+                    var first = consumer.Consume(ct);
+                    if (first?.Message is null) continue;
+                    results.Add(first);
+                    while (results.Count < _o.ImportBatchSize)
+                    {
+                        var next = consumer.Consume(TimeSpan.FromMilliseconds(500));
+                        if (next?.Message is null) break;
+                        results.Add(next);
+                    }
+                }
+                catch (ConsumeException ex)
+                {
+                    logger.LogWarning(ex, "Consume error");
+                    if (results.Count == 0) continue;
+                }
+
+                var orders = new List<OrderPlaced>(results.Count);
+                foreach (var r in results)
+                {
+                    var placed = OrderJson.TryParse(r.Message.Value, out var error);
+                    if (placed is null)
+                    {
+                        logger.LogError("Poison message {Tp}@{Offset}: {Error}, sent to dead letter",
+                            r.TopicPartition, r.Offset.Value, error);
+                        await Retry.RunAsync(() => publisher.SendToDeadLetterAsync(r, error, ct),
+                            logger, "dead letter publish", ct);
+                    }
+                    else orders.Add(placed);
+                }
+
+                await Retry.RunAsync(() => store.InsertBatchAsync(orders, ct), logger, "import batch", ct);
+                foreach (var r in results) consumer.StoreOffset(r);
+            }
+        }
+        catch (OperationCanceledException) { }
+        finally { consumer.Close(); }
+    }
+}
diff --git a/src/Fulfil/Mongo/OrderStores.cs b/src/Fulfil/Mongo/OrderStores.cs
new file mode 100644
index 0000000..d5652d2
--- /dev/null
+++ b/src/Fulfil/Mongo/OrderStores.cs
@@ -0,0 +1,79 @@
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Mongo;
+
+public sealed class CustomerProjection
+{
+    private readonly IMongoCollection<BsonDocument> _customers;
+
+    public CustomerProjection(IMongoClient client, IOptions<FulfilOptions> options) =>
+        _customers = client.GetDatabase(options.Value.MongoDatabase).GetCollection<BsonDocument>("customers");
+
+    // Учёт идемпотентен: доставка at-least-once, при ребалансе или падении реплики
+    // заказ приходит повторно. Идентификаторы учтённых заказов лежат в самом документе
+    // клиента, так что проверка и приращение - одна атомарная операция.
+    // false - заказ уже был учтён.
+    public async Task<bool> ApplyAsync(OrderPlaced placed, CancellationToken ct)
+    {
+        var total = placed.Lines.Sum(l => l.Quantity * l.UnitPrice);
+        var orderId = placed.OrderId.ToString();
+        var filter = Builders<BsonDocument>.Filter.Eq("_id", placed.CustomerId.ToString())
+                     & Builders<BsonDocument>.Filter.Ne("processedOrders", orderId);
+        var update = Builders<BsonDocument>.Update
+            .Inc("ordersCount", 1)
+            .Inc("totalSpent", (Decimal128)total)
+            .AddToSet("processedOrders", orderId);
+        try
+        {
+            await _customers.UpdateOneAsync(filter, update, new UpdateOptions { IsUpsert = true }, ct);
+            return true;
+        }
+        catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            // клиент есть, и заказ в нём уже учтён
+            return false;
+        }
+    }
+}
+
+public sealed class OrderImportStore
+{
+    private readonly IMongoCollection<BsonDocument> _orders;
+
+    public OrderImportStore(IMongoClient client, IOptions<FulfilOptions> options) =>
+        _orders = client.GetDatabase(options.Value.MongoDatabase).GetCollection<BsonDocument>("orders");
+
+    // Один InsertMany на пачку. Повтор пачки после сбоя безопасен: дубликаты по _id игнорируются.
+    public async Task InsertBatchAsync(IReadOnlyCollection<OrderPlaced> batch, CancellationToken ct)
+    {
+        var docs = batch.GroupBy(o => o.OrderId).Select(g => ToDocument(g.First())).ToList();
+        if (docs.Count == 0) return;
+        try
+        {
+            await _orders.InsertManyAsync(docs, new InsertManyOptions { IsOrdered = false }, ct);
+        }
+        catch (MongoBulkWriteException<BsonDocument> ex)
+            when (ex.WriteErrors.All(e => e.Category == ServerErrorCategory.DuplicateKey))
+        {
+        }
+    }
+
+    private static BsonDocument ToDocument(OrderPlaced o) => new()
+    {
+        { "_id", o.OrderId.ToString() },
+        { "customerId", o.CustomerId.ToString() },
+        { "status", Domain.OrderStatus.Placed.ToString() },
+        { "lines", new BsonArray(o.Lines.Select(l => new BsonDocument
+            {
+                { "sku", l.Sku },
+                { "quantity", l.Quantity },
+                { "unitPrice", (Decimal128)l.UnitPrice }
+            })) },
+        { "placedAt", o.PlacedAt.UtcDateTime },
+        { "giftWrap", o.GiftWrap }
+    };
+}
