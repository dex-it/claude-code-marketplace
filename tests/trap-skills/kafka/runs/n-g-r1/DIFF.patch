+using Fulfil.Domain;
+using Xunit;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UtcNow);
+
+    [Theory]
+    [InlineData(0, 0)]
+    [InlineData(9999.99, 9999.99)]
+    [InlineData(10000, 9500)]
+    [InlineData(49999.99, 47499.99)] // 47499.9905 -> вниз
+    [InlineData(50000, 45000)]
+    [InlineData(100000, 90000)]
+    public void Apply_UsesTierByTotal(decimal total, decimal expected) =>
+        Assert.Equal(expected, VolumeDiscount.Apply(total));
+
+    [Fact]
+    public void Apply_RoundsDownToKopecks() =>
+        Assert.Equal(10449.94m, VolumeDiscount.Apply(10999.94m)); // 10449.943
+
+    [Fact]
+    public void Order_TotalStaysLinesSum_TotalWithDiscountApplies()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 3000m), new OrderLine("B", 1, 4000m));
+
+        Assert.Equal(10000m, order.Total);
+        Assert.Equal(9500m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Order_WithoutLines_HasNoDiscount()
+    {
+        var order = OrderOf();
+
+        Assert.Equal(0m, order.TotalWithDiscount);
+    }
+}
