@@ -0,0 +1,20 @@
+namespace Fulfil.Domain;
+
+public static class VolumeDiscount
+{
+    public const decimal Tier1Threshold = 10_000m;
+    public const decimal Tier2Threshold = 50_000m;
+    public const decimal Tier1Rate = 0.05m;
+    public const decimal Tier2Rate = 0.10m;
+
+    public static decimal RateFor(decimal total) => total switch
+    {
+        >= Tier2Threshold => Tier2Rate,
+        >= Tier1Threshold => Tier1Rate,
+        _ => 0m
+    };
+
+    /// <summary>Сумма после скидки, округлённая до копеек вниз.</summary>
+    public static decimal Apply(decimal total) =>
+        Math.Floor(total * (1 - RateFor(total)) * 100m) / 100m;
+}
