@@ -0,0 +1,49 @@
+using Fulfil.Domain;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UtcNow);
+
+    [Theory]
+    [InlineData(0, 0)]
+    [InlineData(9999.99, 0)]
+    [InlineData(10000, 0.05)]
+    [InlineData(49999.99, 0.05)]
+    [InlineData(50000, 0.10)]
+    [InlineData(100000, 0.10)]
+    public void RateFor_uses_thresholds_inclusively(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, VolumeDiscount.RateFor(subtotal));
+
+    [Theory]
+    [InlineData(9999.99, 9999.99)]
+    [InlineData(10000, 9500)]
+    [InlineData(50000, 45000)]
+    [InlineData(10000.10, 9500.09)] // 9500.095 -> down
+    [InlineData(10000.19, 9500.18)] // 9500.1805 -> down
+    public void Apply_rounds_down_to_kopecks(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, VolumeDiscount.Apply(subtotal));
+
+    [Fact]
+    public void Total_stays_sum_of_lines_and_discount_is_separate()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 4000m), new OrderLine("B", 1, 2000m));
+
+        Assert.Equal(10000m, order.Total);
+        Assert.Equal(9500m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Small_order_has_no_discount()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 500m));
+
+        Assert.Equal(order.Total, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Empty_order_total_is_zero() =>
+        Assert.Equal(0m, OrderOf().TotalWithDiscount);
+}
