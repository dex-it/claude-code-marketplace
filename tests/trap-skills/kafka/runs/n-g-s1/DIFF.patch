+using Fulfil.Domain;
+using Xunit;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UnixEpoch);
+
+    [Theory]
+    [InlineData(9999.99, 9999.99)]
+    [InlineData(10000, 9500)]
+    [InlineData(49999.99, 47499.99)]
+    [InlineData(50000, 45000)]
+    [InlineData(80000, 72000)]
+    public void TotalWithDiscount_AppliesTier(double total, double expected)
+    {
+        var order = OrderOf(new OrderLine("A", 1, (decimal)total));
+
+        Assert.Equal((decimal)expected, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void TotalWithDiscount_RoundsDownToKopecks()
+    {
+        // 10000.01 * 0.95 = 9500.0095 -> 9500.00
+        var order = OrderOf(new OrderLine("A", 1, 10000.01m));
+
+        Assert.Equal(9500.00m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Total_StaysSumOfLines()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 5000m), new OrderLine("B", 1, 1000m));
+
+        Assert.Equal(11000m, order.Total);
+        Assert.Equal(10450m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void EmptyOrder_HasZeroTotal()
+    {
+        Assert.Equal(0m, OrderOf().TotalWithDiscount);
+    }
+}
