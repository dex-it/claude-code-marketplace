+using Fulfil.Domain;
+using Xunit;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UtcNow);
+
+    [Theory]
+    [InlineData(0, 0)]
+    [InlineData(9999.99, 0)]
+    [InlineData(10000, 5)]
+    [InlineData(49999.99, 5)]
+    [InlineData(50000, 10)]
+    [InlineData(120000, 10)]
+    public void PercentFor_uses_tier_boundaries(double total, int expected) =>
+        Assert.Equal(expected, VolumeDiscount.PercentFor((decimal)total));
+
+    [Fact]
+    public void Below_first_tier_has_no_discount()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 9999.99m));
+        Assert.Equal(9999.99m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void First_tier_gives_five_percent()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 5000m));
+        Assert.Equal(10000m, order.Total);
+        Assert.Equal(9500m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Second_tier_gives_ten_percent()
+    {
+        var order = OrderOf(new OrderLine("A", 5, 10000m));
+        Assert.Equal(50000m, order.Total);
+        Assert.Equal(45000m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Discounted_total_is_rounded_down_to_kopecks()
+    {
+        // 10000.03 * 0.95 = 9500.0285 -> 9500.02
+        var order = OrderOf(new OrderLine("A", 1, 10000.03m));
+        Assert.Equal(10000.03m, order.Total);
+        Assert.Equal(9500.02m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Empty_order_has_zero_total()
+    {
+        var order = OrderOf();
+        Assert.Equal(0m, order.TotalWithDiscount);
+    }
+}
