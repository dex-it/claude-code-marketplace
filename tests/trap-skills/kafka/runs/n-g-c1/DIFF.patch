+using Fulfil.Domain;
+using Xunit;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UtcNow);
+
+    [Fact]
+    public void Below_first_threshold_no_discount()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 9999.99m));
+
+        Assert.Equal(9999.99m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void First_threshold_gives_5_percent()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 10000m));
+
+        Assert.Equal(10000m, order.Total);
+        Assert.Equal(9500m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Below_second_threshold_still_5_percent()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 49999m));
+
+        Assert.Equal(47499.05m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Second_threshold_gives_10_percent()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 50000m));
+
+        Assert.Equal(45000m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Rounds_down_to_kopecks()
+    {
+        // 10000.01 * 0.95 = 9500.0095 -> 9500.00
+        var order = OrderOf(new OrderLine("A", 1, 10000.01m));
+
+        Assert.Equal(9500.00m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Threshold_is_checked_against_sum_of_lines()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 20000m), new OrderLine("B", 1, 10000m));
+
+        Assert.Equal(50000m, order.Total);
+        Assert.Equal(45000m, order.TotalWithDiscount);
+    }
+}
