+using Fulfil.Domain;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UnixEpoch);
+
+    [Theory]
+    [InlineData(0, 0)]
+    [InlineData(9_999.99, 0)]
+    [InlineData(10_000, 0.05)]
+    [InlineData(49_999.99, 0.05)]
+    [InlineData(50_000, 0.10)]
+    [InlineData(80_000, 0.10)]
+    public void RateFor_UsesThresholds(decimal total, decimal expected) =>
+        Assert.Equal(expected, VolumeDiscount.RateFor(total));
+
+    [Theory]
+    [InlineData(9_999.99, 9_999.99)]
+    [InlineData(10_000, 9_500)]
+    [InlineData(50_000, 45_000)]
+    [InlineData(10_000.10, 9_500.09)] // 9500.095 -> вниз
+    public void Apply_RoundsDownToKopecks(decimal total, decimal expected) =>
+        Assert.Equal(expected, VolumeDiscount.Apply(total));
+
+    [Fact]
+    public void Order_TotalStaysSumOfLines_AndDiscountIsApplied()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 3_000m), new OrderLine("B", 1, 4_000m));
+
+        Assert.Equal(10_000m, order.Total);
+        Assert.Equal(9_500m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Order_WithoutDiscount_TotalWithDiscountEqualsTotal()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 100m));
+
+        Assert.Equal(order.Total, order.TotalWithDiscount);
+    }
+}
