@@ -0,0 +1,17 @@
+namespace Fulfil.Domain;
+
+public static class VolumeDiscount
+{
+    public static decimal RateFor(decimal total) => total switch
+    {
+        >= 50_000m => 0.10m,
+        >= 10_000m => 0.05m,
+        _ => 0m
+    };
+
+    public static decimal Apply(decimal total)
+    {
+        var discounted = total * (1 - RateFor(total));
+        return Math.Floor(discounted * 100m) / 100m;
+    }
+}
