+using Fulfil.Domain;
+using Xunit;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UnixEpoch);
+
+    [Theory]
+    [InlineData("0", "0")]
+    [InlineData("9999.99", "9999.99")]
+    [InlineData("10000", "9500")]
+    [InlineData("49999.99", "47499.9905")]
+    [InlineData("50000", "45000")]
+    [InlineData("100000", "90000")]
+    public void Applies_tier_by_subtotal(string subtotal, string expectedRaw)
+    {
+        var expected = Math.Floor(decimal.Parse(expectedRaw, System.Globalization.CultureInfo.InvariantCulture) * 100) / 100;
+        var total = decimal.Parse(subtotal, System.Globalization.CultureInfo.InvariantCulture);
+
+        Assert.Equal(expected, VolumeDiscount.Apply(total));
+    }
+
+    [Fact]
+    public void Rounds_down_to_kopecks()
+    {
+        // 10000.01 * 0.95 = 9500.0095 -> 9500.00
+        Assert.Equal(9500.00m, VolumeDiscount.Apply(10000.01m));
+        // 10000.03 * 0.95 = 9500.0285 -> 9500.02
+        Assert.Equal(9500.02m, VolumeDiscount.Apply(10000.03m));
+    }
+
+    [Fact]
+    public void Order_total_stays_sum_of_lines_and_discount_is_separate()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 3000m), new OrderLine("B", 1, 5000m));
+
+        Assert.Equal(11000m, order.Total);
+        Assert.Equal(10450m, order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Order_below_threshold_has_no_discount()
+    {
+        var order = OrderOf(new OrderLine("A", 1, 100m));
+
+        Assert.Equal(order.Total, order.TotalWithDiscount);
+    }
+}
