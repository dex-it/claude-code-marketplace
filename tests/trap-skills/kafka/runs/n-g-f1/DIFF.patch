@@ -0,0 +1,16 @@
+namespace Fulfil.Domain;
+
+public static class VolumeDiscount
+{
+    private const decimal Tier1Threshold = 10_000m;
+    private const decimal Tier2Threshold = 50_000m;
+
+    public static int PercentFor(decimal subtotal) =>
+        subtotal >= Tier2Threshold ? 10 :
+        subtotal >= Tier1Threshold ? 5 :
+        0;
+
+    // Сумма со скидкой, округлённая до копеек вниз.
+    public static decimal Apply(decimal subtotal) =>
+        Math.Floor(subtotal * (100 - PercentFor(subtotal))) / 100m;
+}
