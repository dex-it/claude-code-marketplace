+using Fulfil.Domain;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderWith(decimal unitPrice, int quantity = 1) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed,
+            [new OrderLine("SKU-1", quantity, unitPrice)], DateTimeOffset.UtcNow);
+
+    [Theory]
+    [InlineData(0, 0)]
+    [InlineData(9999.99, 9999.99)]
+    [InlineData(10000, 9500)]
+    [InlineData(49999.99, 47499.99)]
+    [InlineData(50000, 45000)]
+    [InlineData(100000, 90000)]
+    public void TotalWithDiscount_AppliesTier(decimal total, decimal expected)
+    {
+        Assert.Equal(expected, OrderWith(total).TotalWithDiscount);
+    }
+
+    [Fact]
+    public void TotalWithDiscount_RoundsDownToKopecks()
+    {
+        // 10000.01 * 0.95 = 9500.0095 -> 9500.00
+        Assert.Equal(9500.00m, OrderWith(10000.01m).TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Total_StaysSumOfLines()
+    {
+        var order = OrderWith(5000m, 3);
+
+        Assert.Equal(15000m, order.Total);
+        Assert.Equal(14250m, order.TotalWithDiscount);
+    }
+}
