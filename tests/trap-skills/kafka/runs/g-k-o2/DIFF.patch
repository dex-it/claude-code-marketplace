diff --git a/src/Fulfil/Messaging/CustomerProjection.cs b/src/Fulfil/Messaging/CustomerProjection.cs
new file mode 100644
index 0000000..efbdcb9
--- /dev/null
+++ b/src/Fulfil/Messaging/CustomerProjection.cs
@@ -0,0 +1,41 @@
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Messaging;
+
+// Проекция клиента: ordersCount и totalSpent. Доставка at-least-once, поэтому учёт идемпотентен:
+// id последних заказов хранятся в том же документе, и инкремент с проверкой - одна атомарная операция.
+public sealed class CustomerProjection
+{
+    private const int RecentOrdersWindow = 1000;
+
+    private readonly IMongoCollection<BsonDocument> _customers;
+
+    public CustomerProjection(IMongoClient client, IOptions<FulfilOptions> options) =>
+        _customers = client.GetDatabase(options.Value.MongoDatabase).GetCollection<BsonDocument>("customers");
+
+    // true - заказ учтён сейчас, false - уже был учтён ранее.
+    public async Task<bool> ApplyAsync(OrderPlaced order, CancellationToken ct)
+    {
+        var total = order.Lines.Sum(l => l.Quantity * l.UnitPrice);
+        var filter = Builders<BsonDocument>.Filter.Eq("_id", order.CustomerId)
+                     & Builders<BsonDocument>.Filter.Ne("recentOrderIds", order.OrderId);
+        var update = Builders<BsonDocument>.Update
+            .Inc("ordersCount", 1)
+            .Inc("totalSpent", total)
+            .PushEach("recentOrderIds", new[] { order.OrderId }, slice: -RecentOrdersWindow);
+        try
+        {
+            await _customers.UpdateOneAsync(filter, update, new UpdateOptions { IsUpsert = true }, ct);
+            return true;
+        }
+        catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            // Документ клиента есть и уже содержит этот заказ: upsert упёрся в _id.
+            return false;
+        }
+    }
+}
diff --git a/src/Fulfil/Messaging/KafkaConsumerService.cs b/src/Fulfil/Messaging/KafkaConsumerService.cs
