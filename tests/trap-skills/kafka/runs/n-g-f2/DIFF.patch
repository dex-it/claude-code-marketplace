@@ -0,0 +1,43 @@
+using System.Globalization;
+using Fulfil.Domain;
+
+namespace Fulfil.Tests;
+
+public class VolumeDiscountTests
+{
+    private static Order OrderOf(params OrderLine[] lines) =>
+        new(Guid.NewGuid(), Guid.NewGuid(), OrderStatus.Placed, lines, DateTimeOffset.UtcNow);
+
+    private static decimal D(string s) => decimal.Parse(s, CultureInfo.InvariantCulture);
+
+    [Theory]
+    [InlineData("0", "0")]
+    [InlineData("9999.99", "9999.99")]
+    [InlineData("10000", "9500")]
+    [InlineData("49999.99", "47499.99")]
+    [InlineData("50000", "45000")]
+    [InlineData("80000", "72000")]
+    public void TotalWithDiscount_AppliesTier(string total, string expected)
+    {
+        var order = OrderOf(new OrderLine("A", 1, D(total)));
+
+        Assert.Equal(D(expected), order.TotalWithDiscount);
+    }
+
+    [Fact]
+    public void TotalWithDiscount_RoundsDownToKopecks()
+    {
+        // 10000.19 * 0.95 = 9500.1805 -> 9500.18; 10000.99 * 0.95 = 9500.9405 -> 9500.94
+        Assert.Equal(9500.18m, OrderOf(new OrderLine("A", 1, 10000.19m)).TotalWithDiscount);
+        Assert.Equal(9500.94m, OrderOf(new OrderLine("A", 1, 10000.99m)).TotalWithDiscount);
+    }
+
+    [Fact]
+    public void Total_StaysSumOfLines_AndDiscountUsesAllLines()
+    {
+        var order = OrderOf(new OrderLine("A", 2, 3000m), new OrderLine("B", 1, 4000m));
+
+        Assert.Equal(10000m, order.Total);
+        Assert.Equal(9500m, order.TotalWithDiscount);
+    }
+}
