diff --git a/src/Fulfil/Domain/Order.cs b/src/Fulfil/Domain/Order.cs
index 00325b0..df5540d 100644
--- a/src/Fulfil/Domain/Order.cs
+++ b/src/Fulfil/Domain/Order.cs
@@ -12,4 +12,23 @@ public sealed record Order(
     DateTimeOffset PlacedAt)
 {
     public decimal Total => Lines.Sum(l => l.Quantity * l.UnitPrice);
+
+    public decimal TotalWithDiscount => VolumeDiscount.Apply(Total);
+}
+
+public static class VolumeDiscount
+{
+    public const decimal Tier1Threshold = 10_000m;
+    public const decimal Tier2Threshold = 50_000m;
+    public const decimal Tier1Percent = 5m;
+    public const decimal Tier2Percent = 10m;
+
+    public static decimal Percent(decimal total) =>
+        total >= Tier2Threshold ? Tier2Percent
+        : total >= Tier1Threshold ? Tier1Percent
+        : 0m;
+
+    /// <summary>Сумма после скидки, округлённая до копеек вниз.</summary>
+    public static decimal Apply(decimal total) =>
+        Math.Floor(total * (100m - Percent(total))) / 100m;
 }
