+using Fulfil.Kafka;
 using Fulfil.Options;
+using Fulfil.Storage;
+using Microsoft.Extensions.Options;
+using MongoDB.Driver;
 
 var builder = WebApplication.CreateBuilder(args);
 builder.Services.Configure<FulfilOptions>(builder.Configuration.GetSection("Fulfil"));
 
+builder.Services.AddSingleton<IMongoClient>(sp =>
+    new MongoClient(sp.GetRequiredService<IOptions<FulfilOptions>>().Value.MongoConnectionString));
+builder.Services.AddSingleton(sp =>
+    sp.GetRequiredService<IMongoClient>().GetDatabase(sp.GetRequiredService<IOptions<FulfilOptions>>().Value.MongoDatabase));
+builder.Services.AddSingleton<CustomerProjection>();
+builder.Services.AddSingleton<OrderStore>();
+builder.Services.AddSingleton<KafkaPublisher>();
+builder.Services.AddHostedService<OrderPlacedConsumer>();
+builder.Services.AddHostedService<OrderImportConsumer>();
+
 var app = builder.Build();
 app.MapGet("/health", () => Results.Ok());
 app.Run();
diff --git a/src/Fulfil/Storage/MongoStores.cs b/src/Fulfil/Storage/MongoStores.cs
new file mode 100644
index 0000000..c466bfc
--- /dev/null
+++ b/src/Fulfil/Storage/MongoStores.cs
@@ -0,0 +1,76 @@
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using MongoDB.Bson;
+using MongoDB.Driver;
+
+namespace Fulfil.Storage;
+
+public sealed class CustomerProjection
+{
+    private const int AppliedOrdersKept = 1000;
+    private readonly IMongoCollection<BsonDocument> _customers;
+
+    public CustomerProjection(IMongoDatabase db) => _customers = db.GetCollection<BsonDocument>("customers");
+
+    // Идемпотентно: id учтённых заказов лежат в самом документе клиента, поэтому условие и
+    // приращение выполняются одной атомарной операцией (транзакций на одиночном узле нет).
+    // Повторная доставка заказа даёт конфликт _id при upsert - значит, он уже учтён.
+    public async Task ApplyAsync(OrderPlaced order, CancellationToken ct)
+    {
+        var id = order.CustomerId.ToString();
+        var orderId = order.OrderId.ToString();
+        var total = order.Lines.Sum(l => l.Quantity * l.UnitPrice);
+
+        var filter = Builders<BsonDocument>.Filter.Eq("_id", id)
+            & Builders<BsonDocument>.Filter.Ne("appliedOrders", orderId);
+        var update = Builders<BsonDocument>.Update
+            .Inc("ordersCount", 1)
+            .Inc("totalSpent", (Decimal128)total)
+            .PushEach("appliedOrders", new[] { orderId }, slice: -AppliedOrdersKept);
+        try
+        {
+            await _customers.UpdateOneAsync(filter, update, new UpdateOptions { IsUpsert = true }, ct);
+        }
+        catch (MongoCommandException ex) when (ex.Code == 11000) { }
+        catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey) { }
+    }
+}
+
+public sealed class OrderStore
+{
+    private readonly IMongoCollection<BsonDocument> _orders;
+
+    public OrderStore(IMongoDatabase db) => _orders = db.GetCollection<BsonDocument>("orders");
+
+    public static BsonDocument ToDocument(OrderPlaced e)
+    {
+        var order = new Order(e.OrderId, e.CustomerId, OrderStatus.Placed, e.Lines, e.PlacedAt, e.GiftWrap);
+        return new BsonDocument
+        {
+            { "_id", order.Id.ToString() },
+            { "customerId", order.CustomerId.ToString() },
+            { "status", order.Status.ToString() },
+            { "lines", new BsonArray(order.Lines.Select(l => new BsonDocument
+                {
+                    { "sku", l.Sku }, { "quantity", l.Quantity }, { "unitPrice", (Decimal128)l.UnitPrice }
+                })) },
+            { "total", (Decimal128)order.Total },
+            { "placedAt", order.PlacedAt.UtcDateTime },
+            { "giftWrap", order.GiftWrap }
+        };
+    }
+
+    // Одна пачка - один InsertMany. _id = id заказа и unordered: повторная доставка пачки
+    // даёт только конфликты ключа, они не ошибка.
+    public async Task InsertManyAsync(IReadOnlyList<BsonDocument> docs, CancellationToken ct)
+    {
+        if (docs.Count == 0) return;
+        try
+        {
+            await _orders.InsertManyAsync(docs, new InsertManyOptions { IsOrdered = false }, ct);
+        }
+        catch (MongoBulkWriteException ex) when (
+            ex.WriteErrors.Count > 0 && ex.WriteErrors.All(e => e.Category == ServerErrorCategory.DuplicateKey)
+            && ex.WriteConcernError is null) { }
+    }
+}
