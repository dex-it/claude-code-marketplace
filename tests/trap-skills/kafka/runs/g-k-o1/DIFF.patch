@@ -0,0 +1,128 @@
+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Options;
+using Fulfil.Storage;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+// orders.placed -> проекция клиента -> OrderStatusChanged(Placed).
+// Доставка at-least-once: смещение фиксируется синхронно после каждого сообщения, поэтому
+// ребаланс не заставляет перечитывать обработанное; повторы переживает идемпотентная проекция.
+public sealed class OrderPlacedConsumer : BackgroundService
+{
+    private readonly FulfilOptions _options;
+    private readonly CustomerProjection _projection;
+    private readonly KafkaPublisher _publisher;
+    private readonly ILogger<OrderPlacedConsumer> _log;
+
+    public OrderPlacedConsumer(IOptions<FulfilOptions> options, CustomerProjection projection,
+        KafkaPublisher publisher, ILogger<OrderPlacedConsumer> log)
+    {
+        _options = options.Value;
+        _projection = projection;
+        _publisher = publisher;
+        _log = log;
+    }
+
+    protected override Task ExecuteAsync(CancellationToken ct) =>
+        Task.Factory.StartNew(() => RunAsync(ct), ct, TaskCreationOptions.LongRunning, TaskScheduler.Default).Unwrap();
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        using var consumer = new ConsumerBuilder<byte[], byte[]>(new ConsumerConfig
+        {
+            BootstrapServers = _options.KafkaBootstrapServers,
+            GroupId = _options.OrdersGroupId,
+            EnableAutoCommit = false,
+            AutoOffsetReset = AutoOffsetReset.Earliest,
+            PartitionAssignmentStrategy = PartitionAssignmentStrategy.CooperativeSticky
+        }).Build();
+        consumer.Subscribe(_options.OrdersPlacedTopic);
+
+        try
+        {
+            while (!ct.IsCancellationRequested)
+            {
+                ConsumeResult<byte[], byte[]>? result;
+                try { result = consumer.Consume(ct); }
+                catch (ConsumeException ex) when (!ex.Error.IsFatal)
+                {
+                    _log.LogWarning(ex, "Ошибка чтения {Topic}", _options.OrdersPlacedTopic);
+                    continue;
+                }
+                if (result?.Message is null) continue;
+
+                await HandleAsync(result, ct);
+                CommitSafe(consumer, result);
+            }
+        }
+        catch (OperationCanceledException) { }
+        finally
+        {
+            consumer.Close();
+        }
+    }
+
+    private async Task HandleAsync(ConsumeResult<byte[], byte[]> result, CancellationToken ct)
+    {
+        Exception? last = null;
+        for (var attempt = 1; attempt <= _options.MaxProcessingAttempts; attempt++)
+        {
+            try
+            {
+                await ProcessAsync(result, ct);
+                return;
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
+            catch (InvalidDataException ex) { last = ex; break; } // повтор не поможет
+            catch (Exception ex)
+            {
+                last = ex;
+                _log.LogWarning(ex, "Попытка {Attempt}/{Max}: {Topic}[{Partition}]@{Offset}", attempt,
+                    _options.MaxProcessingAttempts, result.Topic, result.Partition.Value, result.Offset.Value);
+                await Task.Delay(TimeSpan.FromMilliseconds(500 * attempt), ct);
+            }
+        }
+
+        // Смещение сдвинется только после того, как брокер принял сообщение в DLT.
+        _log.LogError(last, "Сообщение {Topic}[{Partition}]@{Offset} уходит в DLT", result.Topic,
+            result.Partition.Value, result.Offset.Value);
+        await SendToDltAsync(result, last!, ct);
+    }
+
+    private async Task ProcessAsync(ConsumeResult<byte[], byte[]> result, CancellationToken ct)
+    {
+        var order = KafkaJson.Parse<OrderPlaced>(result.Message.Value);
+        if (order.OrderId == Guid.Empty || order.CustomerId == Guid.Empty || order.Lines is null || order.Lines.Count == 0)
+            throw new InvalidDataException("OrderPlaced без идентификаторов или строк заказа");
+
+        await _projection.ApplyAsync(order, ct);
+        await _publisher.PublishAsync(_options.OrderStatusChangedTopic, order.OrderId.ToString(),
+            new OrderStatusChanged(order.OrderId, OrderStatus.Placed, DateTimeOffset.UtcNow), ct);
+    }
+
+    private async Task SendToDltAsync(ConsumeResult<byte[], byte[]> result, Exception reason, CancellationToken ct)
+    {
+        while (true)
+        {
+            try { await _publisher.DeadLetterAsync(result, reason, ct); return; }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                _log.LogError(ex, "DLT недоступен, повтор");
+                await Task.Delay(TimeSpan.FromSeconds(2), ct);
+            }
+        }
+    }
+
+    private void CommitSafe(IConsumer<byte[], byte[]> consumer, ConsumeResult<byte[], byte[]> result)
+    {
+        try { consumer.Commit(result); }
+        catch (KafkaException ex)
+        {
+            // Например, партицию забрали при ребалансе: новый владелец перечитает, проекция идемпотентна.
+            _log.LogWarning(ex, "Не удалось зафиксировать смещение {Partition}@{Offset}", result.Partition.Value, result.Offset.Value);
+        }
+    }
+}
