@@ -0,0 +1,59 @@
+using System.Text;
+using System.Text.Json;
+using Confluent.Kafka;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Kafka;
+
+// Общий идемпотентный продьюсер: события и сообщения в DLT.
+public sealed class KafkaPublisher : IDisposable
+{
+    private readonly IProducer<byte[], byte[]> _producer;
+
+    public KafkaPublisher(IOptions<FulfilOptions> options)
+    {
+        _producer = new ProducerBuilder<byte[], byte[]>(new ProducerConfig
+        {
+            BootstrapServers = options.Value.KafkaBootstrapServers,
+            EnableIdempotence = true,
+            Acks = Acks.All,
+            MessageTimeoutMs = 30_000
+        }).Build();
+    }
+
+    public async Task PublishAsync<T>(string topic, string key, T payload, CancellationToken ct)
+    {
+        await _producer.ProduceAsync(topic, new Message<byte[], byte[]>
+        {
+            Key = Encoding.UTF8.GetBytes(key),
+            Value = JsonSerializer.SerializeToUtf8Bytes(payload, KafkaJson.Options)
+        }, ct);
+    }
+
+    // Ядовитое сообщение уходит в `<топик>.DLT` как есть, причина и источник - в заголовках.
+    // Вернулся - значит брокер принял, и смещение можно двигать.
+    public async Task DeadLetterAsync(ConsumeResult<byte[], byte[]> source, Exception reason, CancellationToken ct)
+    {
+        var headers = new Headers
+        {
+            { "dlt-reason", Encoding.UTF8.GetBytes(reason.Message) },
+            { "dlt-exception", Encoding.UTF8.GetBytes(reason.GetType().FullName ?? "unknown") },
+            { "dlt-source-topic", Encoding.UTF8.GetBytes(source.Topic) },
+            { "dlt-source-partition", Encoding.UTF8.GetBytes(source.Partition.Value.ToString()) },
+            { "dlt-source-offset", Encoding.UTF8.GetBytes(source.Offset.Value.ToString()) }
+        };
+        await _producer.ProduceAsync(source.Topic + ".DLT", new Message<byte[], byte[]>
+        {
+            Key = source.Message.Key,
+            Value = source.Message.Value,
+            Headers = headers
+        }, ct);
+    }
+
+    public void Dispose()
+    {
+        _producer.Flush(TimeSpan.FromSeconds(10));
+        _producer.Dispose();
+    }
+}
diff --git a/src/Fulfil/Kafka/OrderImportConsumer.cs b/src/Fulfil/Kafka/OrderImportConsumer.cs
new file mode 100644
index 0000000..6535c75
--- /dev/null
+++ b/src/Fulfil/Kafka/OrderImportConsumer.cs
@@ -0,0 +1,149 @@
+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Fulfil.Storage;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+
+namespace Fulfil.Kafka;
+
+// Ночной импорт orders.import: пачки по ImportBatchSize, один InsertMany на пачку.
+public sealed class OrderImportConsumer : BackgroundService
+{
+    private readonly FulfilOptions _options;
+    private readonly OrderStore _orders;
+    private readonly KafkaPublisher _publisher;
+    private readonly ILogger<OrderImportConsumer> _log;
+
+    public OrderImportConsumer(IOptions<FulfilOptions> options, OrderStore orders,
+        KafkaPublisher publisher, ILogger<OrderImportConsumer> log)
+    {
+        _options = options.Value;
+        _orders = orders;
+        _publisher = publisher;
+        _log = log;
+    }
+
+    protected override Task ExecuteAsync(CancellationToken ct) =>
+        Task.Factory.StartNew(() => RunAsync(ct), ct, TaskCreationOptions.LongRunning, TaskScheduler.Default).Unwrap();
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        using var consumer = new ConsumerBuilder<byte[], byte[]>(new ConsumerConfig
+        {
+            BootstrapServers = _options.KafkaBootstrapServers,
+            GroupId = _options.OrdersImportGroupId,
+            EnableAutoCommit = false,
+            AutoOffsetReset = AutoOffsetReset.Earliest,
+            PartitionAssignmentStrategy = PartitionAssignmentStrategy.CooperativeSticky
+        }).Build();
+        consumer.Subscribe(_options.OrdersImportTopic);
+
+        try
+        {
+            var batch = new List<ConsumeResult<byte[], byte[]>>(_options.ImportBatchSize);
+            while (!ct.IsCancellationRequested)
+            {
+                batch.Clear();
+                var deadline = DateTime.UtcNow.AddSeconds(2);
+                while (batch.Count < _options.ImportBatchSize && DateTime.UtcNow < deadline)
+                {
+                    try
+                    {
+                        var r = consumer.Consume(TimeSpan.FromMilliseconds(500));
+                        if (r?.Message is not null) batch.Add(r);
+                    }
+                    catch (ConsumeException ex) when (!ex.Error.IsFatal)
+                    {
+                        _log.LogWarning(ex, "Ошибка чтения {Topic}", _options.OrdersImportTopic);
+                    }
+                }
+                if (batch.Count == 0) continue;
+
+                await HandleBatchAsync(batch, ct);
+                CommitSafe(consumer, batch);
+            }
+        }
+        catch (OperationCanceledException) { }
+        finally
+        {
+            consumer.Close();
+        }
+    }
+
+    private async Task HandleBatchAsync(List<ConsumeResult<byte[], byte[]>> batch, CancellationToken ct)
+    {
+        var valid = new List<(ConsumeResult<byte[], byte[]> Source, BsonDocument Doc)>(batch.Count);
+        foreach (var r in batch)
+        {
+            try
+            {
+                var order = KafkaJson.Parse<OrderPlaced>(r.Message.Value);
+                if (order.OrderId == Guid.Empty || order.CustomerId == Guid.Empty || order.Lines is null || order.Lines.Count == 0)
+                    throw new InvalidDataException("OrderPlaced без идентификаторов или строк заказа");
+                valid.Add((r, OrderStore.ToDocument(order)));
+            }
+            catch (InvalidDataException ex)
+            {
+                await SendToDltAsync(r, ex, ct);
+            }
+        }
+        if (valid.Count == 0) return;
+
+        Exception? last = null;
+        for (var attempt = 1; attempt <= _options.MaxProcessingAttempts; attempt++)
+        {
+            try
+            {
+                await _orders.InsertManyAsync(valid.Select(v => v.Doc).ToList(), ct);
+                return;
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
+            catch (Exception ex)
+            {
+                last = ex;
+                _log.LogWarning(ex, "Пачка импорта, попытка {Attempt}/{Max}", attempt, _options.MaxProcessingAttempts);
+                await Task.Delay(TimeSpan.FromMilliseconds(500 * attempt), ct);
+            }
+        }
+
+        // Пачка не вставляется: ищем виновника поодиночке, остальные сохраняем, ядовитые - в DLT.
+        _log.LogError(last, "Пачка импорта не прошла, разбор по одному");
+        foreach (var (source, doc) in valid)
+        {
+            try { await _orders.InsertManyAsync(new[] { doc }, ct); }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
+            catch (Exception ex) { await SendToDltAsync(source, ex, ct); }
+        }
+    }
+
+    private async Task SendToDltAsync(ConsumeResult<byte[], byte[]> result, Exception reason, CancellationToken ct)
+    {
+        _log.LogError(reason, "Сообщение {Topic}[{Partition}]@{Offset} уходит в DLT", result.Topic,
+            result.Partition.Value, result.Offset.Value);
+        while (true)
+        {
+            try { await _publisher.DeadLetterAsync(result, reason, ct); return; }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                _log.LogError(ex, "DLT недоступен, повтор");
+                await Task.Delay(TimeSpan.FromSeconds(2), ct);
+            }
+        }
+    }
+
+    // Фиксируем смещение по каждой партиции пачки после полной обработки пачки.
+    private void CommitSafe(IConsumer<byte[], byte[]> consumer, List<ConsumeResult<byte[], byte[]>> batch)
+    {
+        var offsets = batch
+            .GroupBy(r => r.TopicPartition)
+            .Select(g => new TopicPartitionOffset(g.Key, g.Max(r => r.Offset.Value) + 1))
+            .ToList();
+        try { consumer.Commit(offsets); }
+        catch (KafkaException ex)
+        {
+            // Партицию забрали при ребалансе: новый владелец перечитает, вставка идемпотентна.
+            _log.LogWarning(ex, "Не удалось зафиксировать смещения пачки импорта");
+        }
+    }
+}
diff --git a/src/Fulfil/Kafka/OrderPlacedConsumer.cs b/src/Fulfil/Kafka/OrderPlacedConsumer.cs
