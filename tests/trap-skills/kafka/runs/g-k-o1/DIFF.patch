@@ -0,0 +1,32 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace Fulfil.Kafka;
+
+public static class KafkaJson
+{
+    public static readonly JsonSerializerOptions Options = Create();
+
+    private static JsonSerializerOptions Create()
+    {
+        var o = new JsonSerializerOptions(JsonSerializerDefaults.Web);
+        o.Converters.Add(new JsonStringEnumConverter());
+        return o;
+    }
+
+    // Невалидное сообщение - постоянная ошибка: повтор её не лечит.
+    public static T Parse<T>(byte[]? value) where T : class
+    {
+        if (value is null || value.Length == 0)
+            throw new InvalidDataException("Пустое сообщение");
+        try
+        {
+            return JsonSerializer.Deserialize<T>(value, Options)
+                ?? throw new InvalidDataException("JSON null");
+        }
+        catch (JsonException ex)
+        {
+            throw new InvalidDataException("Некорректный JSON: " + ex.Message, ex);
+        }
+    }
+}
