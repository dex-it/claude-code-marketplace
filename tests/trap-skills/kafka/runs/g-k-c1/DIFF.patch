@@ -0,0 +1,27 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Fulfil.Contracts;
+
+namespace Fulfil.Messaging;
+
+public static class OrderJson
+{
+    public static readonly JsonSerializerOptions Options = new(JsonSerializerDefaults.Web)
+    {
+        Converters = { new JsonStringEnumConverter() },
+    };
+
+    // null - сообщение не разобрать или оно неполное: повтор не поможет, его пропускают.
+    public static OrderPlaced? TryReadOrderPlaced(string json)
+    {
+        try
+        {
+            var e = JsonSerializer.Deserialize<OrderPlaced>(json, Options);
+            return e is { Lines: not null } && e.OrderId != Guid.Empty && e.CustomerId != Guid.Empty ? e : null;
+        }
+        catch (JsonException)
+        {
+            return null;
+        }
+    }
+}
diff --git a/src/Fulfil/Messaging/OrderPlacedConsumer.cs b/src/Fulfil/Messaging/OrderPlacedConsumer.cs
