diff --git a/src/Fulfil/Messaging/OrderImportConsumer.cs b/src/Fulfil/Messaging/OrderImportConsumer.cs
new file mode 100644
index 0000000..5e3b610
--- /dev/null
+++ b/src/Fulfil/Messaging/OrderImportConsumer.cs
@@ -0,0 +1,112 @@
+using Confluent.Kafka;
+using Fulfil.Domain;
+using Fulfil.Options;
+using Fulfil.Persistence;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Messaging;
+
+// Ночной импорт из orders.import: пачки по ImportBatchSize сообщений, один InsertMany на пачку.
+// В памяти держится не больше одной пачки; смещения сохраняются после успешной вставки.
+public sealed class OrderImportConsumer(
+    IOptions<FulfilOptions> options,
+    MongoOrderStore store,
+    ILogger<OrderImportConsumer> logger) : BackgroundService
+{
+    private static readonly TimeSpan RetryDelay = TimeSpan.FromSeconds(2);
+    private static readonly TimeSpan FlushAfter = TimeSpan.FromSeconds(1);
+
+    protected override Task ExecuteAsync(CancellationToken stoppingToken) =>
+        Task.Factory.StartNew(() => RunAsync(stoppingToken), stoppingToken,
+            TaskCreationOptions.LongRunning, TaskScheduler.Default).Unwrap();
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        var o = options.Value;
+        var batchSize = Math.Max(1, o.ImportBatchSize);
+        using var consumer = new ConsumerBuilder<string, string>(new ConsumerConfig
+        {
+            BootstrapServers = o.KafkaBootstrapServers,
+            GroupId = o.OrdersImportConsumerGroup,
+            EnableAutoCommit = true,
+            EnableAutoOffsetStore = false,
+            AutoOffsetReset = AutoOffsetReset.Earliest,
+            PartitionAssignmentStrategy = PartitionAssignmentStrategy.CooperativeSticky,
+        }).Build();
+        consumer.Subscribe(o.OrdersImportTopic);
+
+        var orders = new List<Order>(batchSize);
+        var consumed = new List<ConsumeResult<string, string>>(batchSize);
+        try
+        {
+            while (!ct.IsCancellationRequested)
+            {
+                orders.Clear();
+                consumed.Clear();
+                var deadline = DateTime.UtcNow + FlushAfter;
+
+                while (consumed.Count < batchSize)
+                {
+                    var left = deadline - DateTime.UtcNow;
+                    if (left <= TimeSpan.Zero && consumed.Count > 0) break;
+                    ConsumeResult<string, string>? result;
+                    try
+                    {
+                        result = consumer.Consume(consumed.Count == 0 ? TimeSpan.FromSeconds(1) : left);
+                    }
+                    catch (ConsumeException e) when (!e.Error.IsFatal)
+                    {
+                        logger.LogWarning(e, "Ошибка чтения {Topic}", o.OrdersImportTopic);
+                        continue;
+                    }
+                    if (result?.Message is null)
+                    {
+                        if (ct.IsCancellationRequested) break;
+                        if (consumed.Count > 0) break;
+                        continue;
+                    }
+
+                    consumed.Add(result);
+                    var placed = OrderJson.TryReadOrderPlaced(result.Message.Value);
+                    if (placed is null)
+                    {
+                        logger.LogError("Сообщение {Partition}:{Offset} не разобрано, пропущено",
+                            result.Partition.Value, result.Offset.Value);
+                        continue;
+                    }
+                    orders.Add(new Order(placed.OrderId, placed.CustomerId, OrderStatus.Placed,
+                        placed.Lines, placed.PlacedAt, placed.GiftWrap));
+                }
+
+                if (consumed.Count == 0) continue;
+
+                await InsertWithRetryAsync(orders, ct);
+                foreach (var r in consumed) consumer.StoreOffset(r);
+            }
+        }
+        catch (OperationCanceledException)
+        {
+        }
+        finally
+        {
+            consumer.Close();
+        }
+    }
+
+    private async Task InsertWithRetryAsync(List<Order> orders, CancellationToken ct)
+    {
+        while (true)
+        {
+            try
+            {
+                await store.InsertOrdersAsync(orders, ct);
+                return;
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                logger.LogError(e, "Не удалось записать пачку из {Count} заказов, повтор", orders.Count);
+                await Task.Delay(RetryDelay, ct);
+            }
+        }
+    }
+}
