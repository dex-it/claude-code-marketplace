@@ -0,0 +1,44 @@
+using System.Text.Json;
+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Messaging;
+
+public sealed class StatusChangedPublisher : IDisposable
+{
+    private readonly IProducer<string, string> _producer;
+    private readonly string _topic;
+
+    public StatusChangedPublisher(IOptions<FulfilOptions> options)
+    {
+        var o = options.Value;
+        _topic = o.OrderStatusChangedTopic;
+        _producer = new ProducerBuilder<string, string>(new ProducerConfig
+        {
+            BootstrapServers = o.KafkaBootstrapServers,
+            Acks = Acks.All,
+            EnableIdempotence = true,
+        }).Build();
+    }
+
+    // Ключ - OrderId: все статусы одного заказа попадают в одну партицию и идут по порядку.
+    public async Task PublishAsync(OrderStatusChanged e, CancellationToken ct)
+    {
+        await _producer.ProduceAsync(
+            _topic,
+            new Message<string, string>
+            {
+                Key = e.OrderId.ToString(),
+                Value = JsonSerializer.Serialize(e, OrderJson.Options),
+            },
+            ct);
+    }
+
+    public void Dispose()
+    {
+        _producer.Flush(TimeSpan.FromSeconds(5));
+        _producer.Dispose();
+    }
+}
