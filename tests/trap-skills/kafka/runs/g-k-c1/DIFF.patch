+using Confluent.Kafka;
+using Fulfil.Contracts;
+using Fulfil.Domain;
+using Fulfil.Options;
+using Fulfil.Persistence;
+using Microsoft.Extensions.Options;
+
+namespace Fulfil.Messaging;
+
+// Читает orders.placed, ведёт проекцию клиента и публикует OrderStatusChanged(Placed).
+// Реплики равноправны: партиции делит группа потребителей. Смещение сохраняется только после
+// учёта и публикации (at-least-once); повторы гасит маркер заказа в MongoOrderStore.
+public sealed class OrderPlacedConsumer(
+    IOptions<FulfilOptions> options,
+    MongoOrderStore store,
+    StatusChangedPublisher publisher,
+    ILogger<OrderPlacedConsumer> logger) : BackgroundService
+{
+    private static readonly TimeSpan RetryDelay = TimeSpan.FromSeconds(2);
+
+    protected override Task ExecuteAsync(CancellationToken stoppingToken) =>
+        Task.Factory.StartNew(() => RunAsync(stoppingToken), stoppingToken,
+            TaskCreationOptions.LongRunning, TaskScheduler.Default).Unwrap();
+
+    private async Task RunAsync(CancellationToken ct)
+    {
+        var o = options.Value;
+        using var consumer = new ConsumerBuilder<string, string>(new ConsumerConfig
+        {
+            BootstrapServers = o.KafkaBootstrapServers,
+            GroupId = o.OrdersConsumerGroup,
+            EnableAutoCommit = true,
+            EnableAutoOffsetStore = false,
+            AutoOffsetReset = AutoOffsetReset.Earliest,
+            PartitionAssignmentStrategy = PartitionAssignmentStrategy.CooperativeSticky,
+        }).Build();
+        consumer.Subscribe(o.OrdersPlacedTopic);
+
+        try
+        {
+            while (!ct.IsCancellationRequested)
+            {
+                ConsumeResult<string, string>? result;
+                try
+                {
+                    result = consumer.Consume(ct);
+                }
+                catch (ConsumeException e) when (!e.Error.IsFatal)
+                {
+                    logger.LogWarning(e, "Ошибка чтения {Topic}", o.OrdersPlacedTopic);
+                    continue;
+                }
+                if (result?.Message is null) continue;
+
+                await HandleWithRetryAsync(result, ct);
+                consumer.StoreOffset(result);
+            }
+        }
+        catch (OperationCanceledException)
+        {
+        }
+        finally
+        {
+            consumer.Close();
+        }
+    }
+
+    private async Task HandleWithRetryAsync(ConsumeResult<string, string> result, CancellationToken ct)
+    {
+        var placed = OrderJson.TryReadOrderPlaced(result.Message.Value);
+        if (placed is null)
+        {
+            logger.LogError("Сообщение {Partition}:{Offset} не разобрано, пропущено",
+                result.Partition.Value, result.Offset.Value);
+            return;
+        }
+
+        var total = placed.Lines.Sum(l => l.Quantity * l.UnitPrice);
+        while (true)
+        {
+            try
+            {
+                // Если прошлая попытка учла заказ, но не опубликовала событие, публикация
+                // повторится: учёт идемпотентен только по счётчикам, событие уйдёт повторно.
+                await store.TryProjectPlacedAsync(placed.OrderId, placed.CustomerId, total, ct);
+                await publisher.PublishAsync(
+                    new OrderStatusChanged(placed.OrderId, OrderStatus.Placed, DateTimeOffset.UtcNow), ct);
+                return;
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                logger.LogError(e, "Не удалось обработать заказ {OrderId}, повтор", placed.OrderId);
+                await Task.Delay(RetryDelay, ct);
+            }
+        }
+    }
+}
