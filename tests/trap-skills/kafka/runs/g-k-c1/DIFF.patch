diff --git a/src/Fulfil/Persistence/MongoOrderStore.cs b/src/Fulfil/Persistence/MongoOrderStore.cs
new file mode 100644
index 0000000..d6ec9df
--- /dev/null
+++ b/src/Fulfil/Persistence/MongoOrderStore.cs
@@ -0,0 +1,94 @@
+using Fulfil.Domain;
+using Fulfil.Options;
+using Microsoft.Extensions.Options;
+using MongoDB.Bson;
+using MongoDB.Bson.Serialization;
+using MongoDB.Bson.Serialization.Conventions;
+using MongoDB.Bson.Serialization.Serializers;
+using MongoDB.Driver;
+
+namespace Fulfil.Persistence;
+
+public sealed class CustomerProjection
+{
+    public Guid Id { get; set; }
+    public int OrdersCount { get; set; }
+    public decimal TotalSpent { get; set; }
+}
+
+public sealed class ProcessedOrder
+{
+    public Guid Id { get; set; }
+    public DateTime CreatedAt { get; set; }
+}
+
+public sealed class MongoOrderStore
+{
+    private static readonly TimeSpan MarkerTtl = TimeSpan.FromDays(30);
+
+    private readonly IMongoCollection<CustomerProjection> _customers;
+    private readonly IMongoCollection<ProcessedOrder> _processed;
+    private readonly IMongoCollection<Order> _orders;
+
+    static MongoOrderStore()
+    {
+        BsonSerializer.TryRegisterSerializer(new GuidSerializer(GuidRepresentation.Standard));
+        BsonSerializer.TryRegisterSerializer(new DecimalSerializer(BsonType.Decimal128));
+        BsonSerializer.TryRegisterSerializer(new DateTimeOffsetSerializer(BsonType.String));
+        ConventionRegistry.Register(
+            "fulfil",
+            new ConventionPack { new CamelCaseElementNameConvention(), new EnumRepresentationConvention(BsonType.String) },
+            t => t.Namespace != null && t.Namespace.StartsWith("Fulfil"));
+    }
+
+    public MongoOrderStore(IOptions<FulfilOptions> options)
+    {
+        var o = options.Value;
+        var db = new MongoClient(o.MongoConnectionString).GetDatabase(o.MongoDatabase);
+        _customers = db.GetCollection<CustomerProjection>("customers");
+        _processed = db.GetCollection<ProcessedOrder>("processedOrders");
+        _orders = db.GetCollection<Order>("orders");
+
+        _processed.Indexes.CreateOne(new CreateIndexModel<ProcessedOrder>(
+            Builders<ProcessedOrder>.IndexKeys.Ascending(p => p.CreatedAt),
+            new CreateIndexOptions { ExpireAfter = MarkerTtl }));
+    }
+
+    // Возвращает false, если заказ уже учтён (повторная доставка из Kafka).
+    // Доставка at-least-once, реплик несколько: сначала занимаем маркер заказа, и только
+    // владелец маркера увеличивает счётчики. Транзакций на одиночном узле нет, поэтому
+    // сбой между маркером и $inc даст недоучёт, а не двойной счёт.
+    public async Task<bool> TryProjectPlacedAsync(Guid orderId, Guid customerId, decimal total, CancellationToken ct)
+    {
+        try
+        {
+            await _processed.InsertOneAsync(
+                new ProcessedOrder { Id = orderId, CreatedAt = DateTime.UtcNow }, cancellationToken: ct);
+        }
+        catch (MongoWriteException e) when (e.WriteError.Category == ServerErrorCategory.DuplicateKey)
+        {
+            return false;
+        }
+
+        await _customers.UpdateOneAsync(
+            Builders<CustomerProjection>.Filter.Eq(c => c.Id, customerId),
+            Builders<CustomerProjection>.Update.Inc(c => c.OrdersCount, 1).Inc(c => c.TotalSpent, total),
+            new UpdateOptions { IsUpsert = true },
+            ct);
+        return true;
+    }
+
+    // Одна пачка - один InsertMany. Вставка неупорядоченная; дубликаты (повторная доставка
+    // пачки) игнорируются, прочие ошибки пробрасываются.
+    public async Task InsertOrdersAsync(IReadOnlyCollection<Order> batch, CancellationToken ct)
+    {
+        if (batch.Count == 0) return;
+        try
+        {
+            await _orders.InsertManyAsync(batch, new InsertManyOptions { IsOrdered = false }, ct);
+        }
+        catch (MongoBulkWriteException e) when (e.WriteErrors.All(w => w.Category == ServerErrorCategory.DuplicateKey))
+        {
+        }
+    }
+}
