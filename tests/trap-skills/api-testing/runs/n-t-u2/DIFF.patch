@@ -0,0 +1,231 @@
+using System.Net;
+using System.Net.Http.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsChangeTests(ApiFixture api) : ApiTestBase(api)
+{
+    // --- PATCH /api/v1/bookings/{bookingId} ---
+
+    [Fact]
+    public async Task Reschedule_ByOwner_ReturnsUpdatedBookingWithNewVersion()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start(2, 9), 90);
+        var newStart = Start(2, 15);
+
+        var response = await Api.Alice.PatchAsync(Url(booking), Patch(newStart, 60, booking.GetProperty("version").GetInt64()));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var updated = await ReadJsonAsync(response);
+        AssertBookingShape(updated);
+        Assert.Equal(newStart, updated.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, updated.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(newStart.AddMinutes(60), updated.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", updated.GetProperty("ownerId").GetString());
+        Assert.NotEqual(booking.GetProperty("version").GetInt64(), updated.GetProperty("version").GetInt64());
+
+        var reread = await ReadJsonAsync(await Api.Alice.GetAsync(Url(booking)));
+        Assert.Equal(updated.GetProperty("version").GetInt64(), reread.GetProperty("version").GetInt64());
+        Assert.Equal(newStart, reread.GetProperty("startsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Reschedule_ByAdmin_IsAccepted()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+
+        var response = await Api.Admin.PatchAsync(Url(booking), Patch(Start(2, 15), 30, booking.GetProperty("version").GetInt64()));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("alice", (await ReadJsonAsync(response)).GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Reschedule_ByAnotherMember_Returns403NotOwner()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+
+        var response = await Api.Bob.PatchAsync(Url(booking), Patch(Start(2, 15), 30, booking.GetProperty("version").GetInt64()));
+
+        await AssertProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+    }
+
+    [Fact]
+    public async Task Reschedule_StaleVersion_Returns409VersionConflict()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+        var version = booking.GetProperty("version").GetInt64();
+        Assert.Equal(HttpStatusCode.OK, (await Api.Alice.PatchAsync(Url(booking), Patch(Start(2, 12), 60, version))).StatusCode);
+
+        var response = await Api.Alice.PatchAsync(Url(booking), Patch(Start(2, 15), 60, version));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "version-conflict");
+    }
+
+    [Fact]
+    public async Task Reschedule_ConcurrentWithSameVersion_ExactlyOneWins()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+        var version = booking.GetProperty("version").GetInt64();
+
+        var responses = await Task.WhenAll(Enumerable.Range(0, 6)
+            .Select(i => Api.Alice.PatchAsync(Url(booking), Patch(Start(3, 8 + i), 60, version))));
+
+        Assert.Equal(1, responses.Count(r => r.StatusCode == HttpStatusCode.OK));
+        foreach (var lost in responses.Where(r => r.StatusCode != HttpStatusCode.OK))
+            await AssertProblemAsync(lost, HttpStatusCode.Conflict, "version-conflict");
+    }
+
+    [Fact]
+    public async Task Reschedule_OntoOverlappingBooking_Returns409Overlap()
+    {
+        var room = await Api.CreateRoomAsync();
+        await CreateBookingAsync(room, Start(2, 10), 60, Api.Bob);
+        var booking = await CreateBookingAsync(room, Start(2, 14), 60);
+
+        var response = await Api.Alice.PatchAsync(Url(booking), Patch(Start(2, 10).AddMinutes(30), 60, booking.GetProperty("version").GetInt64()));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Reschedule_OverlappingOwnOldTime_IsAccepted()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start(2, 10), 60);
+
+        var response = await Api.Alice.PatchAsync(Url(booking), Patch(Start(2, 10).AddMinutes(30), 60, booking.GetProperty("version").GetInt64()));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Reschedule_CancelledBooking_Returns409BookingCancelled()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+        await Api.Alice.DeleteAsync(Url(booking));
+        var current = await ReadJsonAsync(await Api.Alice.GetAsync(Url(booking)));
+
+        var response = await Api.Alice.PatchAsync(Url(booking), Patch(Start(2, 15), 30, current.GetProperty("version").GetInt64()));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-cancelled");
+    }
+
+    [Fact]
+    public async Task Reschedule_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Api.Alice.PatchAsync($"/api/v1/bookings/{Guid.NewGuid()}", Patch(Start(), 60, 1));
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Theory]
+    [InlineData(-1, 60, "startsAt")]
+    [InlineData(2, 50, "durationMinutes")]
+    [InlineData(2, 300, "durationMinutes")]
+    [InlineData(91, 60, "startsAt")]
+    public async Task Reschedule_InvalidTime_Returns400(int days, int duration, string field)
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+
+        var response = await Api.Alice.PatchAsync(Url(booking), Patch(Start(days), duration, booking.GetProperty("version").GetInt64()));
+
+        await AssertValidationAsync(response, field);
+    }
+
+    [Fact]
+    public async Task Reschedule_WithoutKey_Returns401()
+    {
+        var response = await Api.Anonymous.PatchAsync($"/api/v1/bookings/{Guid.NewGuid()}", Patch(Start(), 60, 1));
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- DELETE /api/v1/bookings/{bookingId} ---
+
+    [Fact]
+    public async Task Cancel_ByOwner_Returns204AndKeepsBookingCancelled()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+
+        var response = await Api.Alice.DeleteAsync(Url(booking));
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        var reread = await ReadJsonAsync(await Api.Alice.GetAsync(Url(booking)));
+        Assert.Equal("cancelled", reread.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_ByAdmin_IsAccepted()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+
+        var response = await Api.Admin.DeleteAsync(Url(booking));
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Cancel_ByAnotherMember_Returns403AndLeavesBookingActive()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+
+        var response = await Api.Bob.DeleteAsync(Url(booking));
+
+        await AssertProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+        var reread = await ReadJsonAsync(await Api.Alice.GetAsync(Url(booking)));
+        Assert.Equal("active", reread.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_Twice_ReturnsNoContentBothTimes()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+
+        var first = await Api.Alice.DeleteAsync(Url(booking));
+        var second = await Api.Alice.DeleteAsync(Url(booking));
+
+        Assert.Equal(HttpStatusCode.NoContent, first.StatusCode);
+        Assert.Equal(HttpStatusCode.NoContent, second.StatusCode);
+    }
+
+    [Fact]
+    public async Task Cancel_FreesTheRoom()
+    {
+        var room = await Api.CreateRoomAsync();
+        var booking = await CreateBookingAsync(room, Start());
+        await Api.Alice.DeleteAsync(Url(booking));
+
+        var response = await Api.Bob.PostAsJsonAsync("/api/v1/bookings", CreateBody(room, Start()));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Cancel_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Api.Alice.DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Cancel_WithoutKey_Returns401()
+    {
+        var response = await Api.Anonymous.DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
