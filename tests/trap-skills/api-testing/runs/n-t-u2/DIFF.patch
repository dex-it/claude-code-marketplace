@@ -0,0 +1,92 @@
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Testcontainers.PostgreSql;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис на настоящем PostgreSQL: пересечения броней держит exclusion constraint,
+/// версию брони - системный столбец xmin, поэтому подменная база (InMemory, Sqlite) не подходит.
+/// </summary>
+public sealed class ApiFixture : IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+    private WebApplicationFactory<Program> _factory = null!;
+
+    public HttpClient Alice { get; private set; } = null!;
+    public HttpClient Bob { get; private set; } = null!;
+    public HttpClient Admin { get; private set; } = null!;
+    public HttpClient Anonymous { get; private set; } = null!;
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+        {
+            builder.UseEnvironment("Testing");
+            builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["ConnectionStrings:Bookings"] = _postgres.GetConnectionString(),
+                ["Database:Initialize"] = "true",
+                ["Auth:Keys:0:key"] = AliceKey,
+                ["Auth:Keys:0:userId"] = "alice",
+                ["Auth:Keys:0:role"] = "member",
+                ["Auth:Keys:1:key"] = BobKey,
+                ["Auth:Keys:1:userId"] = "bob",
+                ["Auth:Keys:1:role"] = "member",
+                ["Auth:Keys:2:key"] = AdminKey,
+                ["Auth:Keys:2:userId"] = "admin",
+                ["Auth:Keys:2:role"] = "admin",
+            }));
+        });
+
+        Alice = ClientWithKey(AliceKey);
+        Bob = ClientWithKey(BobKey);
+        Admin = ClientWithKey(AdminKey);
+        Anonymous = _factory.CreateClient();
+    }
+
+    public async Task DisposeAsync()
+    {
+        Alice.Dispose();
+        Bob.Dispose();
+        Admin.Dispose();
+        Anonymous.Dispose();
+        await _factory.DisposeAsync();
+        await _postgres.DisposeAsync();
+    }
+
+    public HttpClient ClientWithKey(string key)
+    {
+        var client = _factory.CreateClient();
+        client.DefaultRequestHeaders.Add("X-Api-Key", key);
+        return client;
+    }
+
+    /// <summary>Новая комната: брони разных тестов не пересекаются и не попадают в чужие выборки.</summary>
+    public async Task<string> CreateRoomAsync()
+    {
+        var id = "t-" + Guid.NewGuid().ToString("N")[..16];
+        using var scope = _factory.Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<BookingsDbContext>();
+        db.Rooms.Add(new Room(id, "Test " + id, 6, 1));
+        await db.SaveChangesAsync();
+        return id;
+    }
+}
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
