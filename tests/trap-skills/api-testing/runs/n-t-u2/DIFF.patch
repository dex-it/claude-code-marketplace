+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase(ApiFixture api)
+{
+    protected ApiFixture Api { get; } = api;
+
+    /// <summary>Начало через <paramref name="days"/> суток от сегодня, в заданный час (UTC).</summary>
+    protected static DateTimeOffset Start(int days = 2, int hour = 9)
+    {
+        var day = DateTimeOffset.UtcNow.Date.AddDays(days);
+        return new DateTimeOffset(day.AddHours(hour), TimeSpan.Zero);
+    }
+
+    protected static object CreateBody(string roomId, DateTimeOffset startsAt, int duration = 60, string title = "Планёрка", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes = duration, comment };
+
+    protected static async Task<JsonElement> ReadJsonAsync(HttpResponseMessage response)
+    {
+        var text = await response.Content.ReadAsStringAsync();
+        return JsonDocument.Parse(text).RootElement.Clone();
+    }
+
+    protected async Task<JsonElement> CreateBookingAsync(string roomId, DateTimeOffset startsAt, int duration = 60,
+        HttpClient? client = null, string title = "Планёрка", string? comment = null)
+    {
+        var response = await (client ?? Api.Alice).PostAsJsonAsync("/api/v1/bookings", CreateBody(roomId, startsAt, duration, title, comment));
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJsonAsync(response);
+    }
+
+    protected static string Url(JsonElement booking) => $"/api/v1/bookings/{booking.GetProperty("id").GetString()}";
+
+    protected static JsonContent Patch(DateTimeOffset startsAt, int duration, long version) =>
+        JsonContent.Create(new { startsAt, durationMinutes = duration, version });
+
+    protected static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await ReadJsonAsync(response);
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.Equal(JsonValueKind.String, problem.GetProperty("title").ValueKind);
+        Assert.Equal(code, problem.GetProperty("code").GetString());
+    }
+
+    protected static async Task AssertValidationAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await ReadJsonAsync(response);
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        var errors = problem.GetProperty("errors");
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"нет ошибки по полю {field}");
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+
+    /// <summary>Бронь по схеме Booking контракта: обязательные поля, типы, перечисления, ограничения.</summary>
+    protected static void AssertBookingShape(JsonElement b)
+    {
+        string[] required = ["id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version"];
+        foreach (var name in required)
+            Assert.True(b.TryGetProperty(name, out _), $"нет поля {name}");
+
+        Assert.True(Guid.TryParse(b.GetProperty("id").GetString(), out _));
+        Assert.InRange(b.GetProperty("title").GetString()!.Length, 1, 120);
+        Assert.Contains(b.GetProperty("comment").ValueKind, new[] { JsonValueKind.String, JsonValueKind.Null });
+        var duration = b.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        var startsAt = b.GetProperty("startsAt").GetDateTimeOffset();
+        var endsAt = b.GetProperty("endsAt").GetDateTimeOffset();
+        Assert.Equal(TimeSpan.Zero, startsAt.Offset);
+        Assert.Equal(startsAt.AddMinutes(duration), endsAt);
+        Assert.Contains(b.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(b.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+    }
+}
