+using System.Net;
+using System.Net.Http.Json;
+using System.Text;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsCreateTests(ApiFixture api) : ApiTestBase(api)
+{
+    [Fact]
+    public async Task Create_ReturnsCreatedBookingOwnedByCaller()
+    {
+        var room = await Api.CreateRoomAsync();
+        var startsAt = Start();
+
+        var response = await Api.Alice.PostAsJsonAsync("/api/v1/bookings", CreateBody(room, startsAt, 90, "Планирование спринта", "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal(room, booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(startsAt.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Create_SetsLocationToCreatedBooking()
+    {
+        var room = await Api.CreateRoomAsync();
+
