+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+internal static class ApiClientExtensions
+{
+    public static async Task<JsonElement> ReadJsonAsync(this HttpResponseMessage response) =>
+        (await response.Content.ReadFromJsonAsync<JsonElement>()).Clone();
+
+    public static Task<HttpResponseMessage> PostBookingAsync(
+        this HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60,
+        string title = "Планирование", string? comment = null) =>
+        client.PostAsJsonAsync("/api/v1/bookings", new { roomId, title, startsAt, durationMinutes, comment });
+
+    public static Task<HttpResponseMessage> PatchBookingAsync(
+        this HttpClient client, string bookingId, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{bookingId}", new { startsAt, durationMinutes, version });
+
+    public static async Task<JsonElement> CreateBookingAsync(
+        this HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60)
+    {
+        var response = await client.PostBookingAsync(roomId, startsAt, durationMinutes);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await response.ReadJsonAsync();
+    }
+
+    public static string Str(this JsonElement element, string name) => element.GetProperty(name).GetString()!;
+}
