@@ -0,0 +1,94 @@
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Testcontainers.PostgreSql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис на настоящем PostgreSQL: пересечение броней держит exclusion-constraint, версия брони - xmin,
+/// на подменной базе (InMemory, Sqlite) эти ответы контракта не воспроизвести.
+/// </summary>
+public sealed class BookingsApiFactory : WebApplicationFactory<Program>, IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+    private int _roomCounter;
+
+    /// <summary>Часы сервиса стоят: границы окна в 90 дней проверяются без гонки с реальным временем.</summary>
+    public FixedTimeProvider Clock { get; } = new(DateTimeOffset.UtcNow);
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+        // Схема и три комнаты (orion, vega, lyra) создаются на старте приложения.
+        using var client = CreateClient();
+    }
+
+    async Task IAsyncLifetime.DisposeAsync()
+    {
+        await base.DisposeAsync();
+        await _postgres.DisposeAsync();
+    }
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+        builder.UseSetting("ConnectionStrings:Bookings", _postgres.GetConnectionString());
+        builder.UseSetting("Database:Initialize", "true");
+        AddKey(builder, 0, AliceKey, "alice", "member");
+        AddKey(builder, 1, BobKey, "bob", "member");
+        AddKey(builder, 2, AdminKey, "admin", "admin");
+
+        builder.ConfigureServices(services =>
+        {
+            services.RemoveAll<TimeProvider>();
+            services.AddSingleton<TimeProvider>(Clock);
+        });
+    }
+
+    public HttpClient CreateClient(string? apiKey)
+    {
+        var client = CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+
+    /// <summary>Своя комната на тест: брони разных тестов не пересекаются и не попадают в ленты друг друга.</summary>
+    public async Task<string> CreateRoomAsync()
+    {
+        var id = $"t-{Interlocked.Increment(ref _roomCounter)}-{Guid.NewGuid():N}"[..24];
+        using var scope = Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<BookingsDbContext>();
+        db.Rooms.Add(new Room(id, $"Тестовая {id}", 6, 1));
+        await db.SaveChangesAsync();
+        return id;
+    }
+
+    private static void AddKey(IWebHostBuilder builder, int index, string key, string userId, string role)
+    {
+        builder.UseSetting($"Auth:Keys:{index}:key", key);
+        builder.UseSetting($"Auth:Keys:{index}:userId", userId);
+        builder.UseSetting($"Auth:Keys:{index}:role", role);
+    }
+}
+
+public sealed class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+{
+    public DateTimeOffset Now { get; } = now;
+
+    public override DateTimeOffset GetUtcNow() => Now;
+}
+
+[CollectionDefinition(Name)]
+public sealed class ApiCollection : ICollectionFixture<BookingsApiFactory>
+{
+    public const string Name = "api";
+}
