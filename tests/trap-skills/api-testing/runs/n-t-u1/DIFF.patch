+using System.Net;
+using System.Net.Http.Json;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsTests(BookingsApiFactory factory) : ApiTestBase(factory)
+{
+    // ---- createBooking ----
+
+    [Fact]
+    public async Task Create_returns_201_with_booking_and_location()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+        var startsAt = Day(3);
+
+        var response = await Alice.PostBookingAsync(roomId, startsAt, 90, "Планирование спринта", "Принести ноутбуки");
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await response.ReadJsonAsync();
+        AssertBooking(booking, roomId, "alice", startsAt, 90);
+        Assert.Equal("Планирование спринта", booking.Str("title"));
+        Assert.Equal("Принести ноутбуки", booking.Str("comment"));
+        var location = response.Headers.Location;
+        Assert.NotNull(location);
+        Assert.Equal($"/api/v1/bookings/{booking.Str("id")}", location.IsAbsoluteUri ? location.AbsolutePath : location.ToString());
+    }
+
+    [Fact]
+    public async Task Create_without_comment_returns_null_comment()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var booking = await Alice.CreateBookingAsync(roomId, Day(3));
+
+        Assert.Equal(System.Text.Json.JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_normalizes_start_to_utc()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+        var local = new DateTimeOffset(Day(3, 12).DateTime, TimeSpan.FromHours(3));
+
+        var booking = await Alice.CreateBookingAsync(roomId, local);
+
+        Assert.Equal(local.ToUniversalTime(), booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(TimeSpan.Zero, booking.GetProperty("startsAt").GetDateTimeOffset().Offset);
+    }
+
+    [Fact]
+    public async Task Create_owner_is_the_key_holder()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var booking = await Bob.CreateBookingAsync(roomId, Day(3));
+
+        Assert.Equal("bob", booking.Str("ownerId"));
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(45)]
+    [InlineData(240)]
+    public async Task Create_accepts_valid_duration_bounds(int minutes)
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var response = await Alice.PostBookingAsync(roomId, Day(3), minutes);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(14)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_rejects_invalid_duration(int minutes)
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var response = await Alice.PostBookingAsync(roomId, Day(3), minutes);
+
+        await AssertValidationAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_rejects_start_in_the_past()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var response = await Alice.PostBookingAsync(roomId, Now.AddMinutes(-15));
+
+        await AssertValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_rejects_start_equal_to_now()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var response = await Alice.PostBookingAsync(roomId, Now);
+
+        await AssertValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_accepts_start_exactly_90_days_ahead()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var response = await Alice.PostBookingAsync(roomId, Now.AddDays(90));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_rejects_start_beyond_90_days()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var response = await Alice.PostBookingAsync(roomId, Now.AddDays(90).AddMinutes(1));
+
+        await AssertValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_title_length_bounds()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var max = await Alice.PostBookingAsync(roomId, Day(3, 8), title: new string('я', 120));
+        var tooLong = await Alice.PostBookingAsync(roomId, Day(3, 10), title: new string('я', 121));
+        var empty = await Alice.PostBookingAsync(roomId, Day(3, 12), title: "");
+
+        Assert.Equal(HttpStatusCode.Created, max.StatusCode);
+        await AssertValidationAsync(tooLong, "title");
+        await AssertValidationAsync(empty, "title");
+    }
+
+    [Fact]
+    public async Task Create_comment_length_bounds()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var max = await Alice.PostBookingAsync(roomId, Day(3, 8), comment: new string('x', 500));
+        var tooLong = await Alice.PostBookingAsync(roomId, Day(3, 10), comment: new string('x', 501));
+
+        Assert.Equal(HttpStatusCode.Created, max.StatusCode);
+        await AssertValidationAsync(tooLong, "comment");
+    }
+
+    [Fact]
+    public async Task Create_reports_all_invalid_fields_at_once()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+
+        var response = await Alice.PostBookingAsync(roomId, Now.AddDays(-1), 7, title: "");
+
+        await AssertValidationAsync(response, "title", "startsAt", "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_missing_required_field_is_validation_error()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", new { roomId = "orion", title = "Встреча" });
+
+        await AssertValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_malformed_json_is_400()
+    {
+        var response = await Alice.PostAsync("/api/v1/bookings",
+            new StringContent("{ not json", System.Text.Encoding.UTF8, "application/json"));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+    }
+
+    [Fact]
+    public async Task Create_unknown_room_is_404_room_not_found()
+    {
+        var response = await Alice.PostBookingAsync("no-such-room", Day(3));
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact(Skip = "Расхождение с контрактом: roomId длиннее 64 символов контракт отклоняет (maxLength 64, 400), сервис отвечает 404 room-not-found.")]
+    public async Task Create_rejects_room_id_longer_than_64()
+    {
+        var response = await Alice.PostBookingAsync(new string('a', 65), Day(3));
+
+        await AssertValidationAsync(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_overlapping_active_booking_is_409_booking_overlap()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+        await Alice.CreateBookingAsync(roomId, Day(3, 10), 60);
+
+        var response = await Bob.PostBookingAsync(roomId, Day(3, 10).AddMinutes(30), 60);
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_adjacent_booking_is_allowed()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+        await Alice.CreateBookingAsync(roomId, Day(3, 10), 60);
+
+        var before = await Bob.PostBookingAsync(roomId, Day(3, 9), 60);
+        var after = await Bob.PostBookingAsync(roomId, Day(3, 11), 60);
+
+        Assert.Equal(HttpStatusCode.Created, before.StatusCode);
+        Assert.Equal(HttpStatusCode.Created, after.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_same_time_in_another_room_is_allowed()
+    {
+        var first = await Factory.CreateRoomAsync();
+        var second = await Factory.CreateRoomAsync();
+        await Alice.CreateBookingAsync(first, Day(3, 10));
+
+        var response = await Bob.PostBookingAsync(second, Day(3, 10));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_over_cancelled_booking_is_allowed()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+        var booking = await Alice.CreateBookingAsync(roomId, Day(3, 10));
+        await Alice.DeleteAsync($"/api/v1/bookings/{booking.Str("id")}");
+
+        var response = await Bob.PostBookingAsync(roomId, Day(3, 10));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_concurrent_requests_for_same_slot_yield_one_booking()
+    {
+        var roomId = await Factory.CreateRoomAsync();
+        var startsAt = Day(4, 10);
