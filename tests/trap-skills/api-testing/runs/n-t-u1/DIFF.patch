@@ -0,0 +1,58 @@
+using System.Net;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase(BookingsApiFactory factory)
+{
+    protected BookingsApiFactory Factory { get; } = factory;
+
+    protected HttpClient Alice { get; } = factory.CreateClient(BookingsApiFactory.AliceKey);
+    protected HttpClient Bob { get; } = factory.CreateClient(BookingsApiFactory.BobKey);
+    protected HttpClient Admin { get; } = factory.CreateClient(BookingsApiFactory.AdminKey);
+
+    protected DateTimeOffset Now => Factory.Clock.Now;
+
+    /// <summary>Начало рабочего дня (08:00 UTC) через <paramref name="days"/> суток от текущего момента сервиса.</summary>
+    protected DateTimeOffset Day(int days, int hour = 8) =>
+        new DateTimeOffset(Now.UtcDateTime.Date, TimeSpan.Zero).AddDays(days).AddHours(hour);
+
+    protected static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await response.ReadJsonAsync();
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrEmpty(problem.Str("title")));
+        Assert.Equal(code, problem.Str("code"));
+    }
+
+    protected static async Task AssertValidationAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await response.ReadJsonAsync();
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        var errors = problem.GetProperty("errors");
+        Assert.Equal(JsonValueKind.Object, errors.ValueKind);
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"В errors нет поля {field}: {errors}");
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+
+    protected static void AssertBooking(JsonElement booking, string roomId, string ownerId, DateTimeOffset startsAt, int durationMinutes, string status = "active")
+    {
+        Assert.True(Guid.TryParse(booking.Str("id"), out _));
+        Assert.Equal(roomId, booking.Str("roomId"));
+        Assert.Equal(ownerId, booking.Str("ownerId"));
+        Assert.Equal(status, booking.Str("status"));
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(durationMinutes, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(durationMinutes), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.True(booking.TryGetProperty("comment", out _), "Поле comment обязательно (nullable)");
+        Assert.True(booking.GetProperty("version").GetInt64() >= 0);
+    }
+}
