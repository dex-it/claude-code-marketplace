@@ -0,0 +1,542 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsTests : ApiTestBase
+{
+    private const string Bookings = "/api/v1/bookings";
+
+    private static string IdOf(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    // --- POST /bookings (createBooking) ---
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithBooking()
+    {
+        var startsAt = Now.AddDays(10);
+
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(startsAt: startsAt, durationMinutes: 60, comment: "Принести маркеры"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var body = await ReadAsync(response);
+        Assert.True(Guid.TryParse(IdOf(body), out _));
+        Assert.Equal("orion", body.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", body.GetProperty("title").GetString());
+        Assert.Equal("Принести маркеры", body.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, body.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, body.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("alice", body.GetProperty("ownerId").GetString());
+        Assert.Equal("active", body.GetProperty("status").GetString());
+        Assert.Equal(JsonValueKind.Number, body.GetProperty("version").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var body = await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(comment: null));
+
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("comment").ValueKind);
+    }
+
+    [Fact(Skip = DivergenceSkip)]
+    public async Task Create_ReturnsLocationOfCreatedBooking()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking());
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var body = await ReadAsync(response);
+        Assert.Equal($"{Bookings}/{IdOf(body)}", response.Headers.Location?.ToString());
+    }
+
+    [Theory]
+    [InlineData(60)]
+    [InlineData(240)]
+    public async Task Create_EndsAtIsStartsAtPlusWholeHours(int durationMinutes)
+    {
+        var startsAt = Now.AddDays(10);
+
+        var body = await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: startsAt, durationMinutes: durationMinutes));
+
+        Assert.Equal(startsAt.AddMinutes(durationMinutes), body.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Theory(Skip = DivergenceSkip)]
+    [InlineData(15)]
+    [InlineData(90)]
+    public async Task Create_EndsAtIsStartsAtPlusDuration(int durationMinutes)
+    {
+        var startsAt = Now.AddDays(10);
+
+        var body = await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: startsAt, durationMinutes: durationMinutes));
+
+        Assert.Equal(startsAt.AddMinutes(durationMinutes), body.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_DurationOnBounds_Returns201(int durationMinutes)
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(durationMinutes: durationMinutes));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    public async Task Create_InvalidDuration_Returns400(int durationMinutes)
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(durationMinutes: durationMinutes));
+
+        await AssertValidationProblemAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_StartInThePast_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(startsAt: Now.AddMinutes(-1)));
+
+        await AssertValidationProblemAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(startsAt: Now.AddDays(90).AddMinutes(1)));
+
+        await AssertValidationProblemAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartAt90DaysExactly_Returns201()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(startsAt: Now.AddDays(90)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("   ")]
+    public async Task Create_EmptyTitle_Returns400(string title)
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(title: title));
+
+        await AssertValidationProblemAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleLongerThan120_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(title: new string('a', 121)));
+
+        await AssertValidationProblemAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf120_Returns201()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(title: new string('a', 120)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_CommentLongerThan500_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(comment: new string('a', 501)));
+
+        await AssertValidationProblemAsync(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_EmptyRoomId_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(roomId: ""));
+
+        await AssertValidationProblemAsync(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await Client().PostAsJsonAsync(Bookings, NewBooking(roomId: "no-such-room"));
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact(Skip = NeedsPostgres)]
+    public async Task Create_OverlapsActiveBooking_Returns409BookingOverlap()
+    {
+        await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: Now.AddDays(10), durationMinutes: 60));
+
+        var response = await Client(ApiFactory.BobKey).PostAsJsonAsync(
+            Bookings, NewBooking(startsAt: Now.AddDays(10).AddMinutes(30), durationMinutes: 60));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_NoKey_Returns401()
+    {
+        var response = await Client(null).PostAsJsonAsync(Bookings, NewBooking());
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- GET /bookings/{bookingId} (getBooking) ---
+
+    [Fact]
+    public async Task Get_AnotherMembersBooking_ReturnsIt()
+    {
+        var created = await CreateBookingAsync(ApiFactory.AliceKey);
+
+        var response = await Client(ApiFactory.BobKey).GetAsync($"{Bookings}/{IdOf(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await ReadAsync(response);
+        Assert.Equal(IdOf(created), IdOf(body));
+        Assert.Equal("alice", body.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Client().GetAsync($"{Bookings}/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_NoKey_Returns401()
+    {
+        var response = await Client(null).GetAsync($"{Bookings}/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- GET /bookings (listBookings) ---
+
+    [Fact(Skip = DivergenceSkip)]
+    public async Task List_Empty_ReturnsEmptyItemsArrayAndNullCursor()
+    {
+        var response = await Client().GetAsync(Bookings);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await ReadAsync(response);
+        Assert.Equal(JsonValueKind.Array, body.GetProperty("items").ValueKind);
+        Assert.Empty(body.GetProperty("items").EnumerateArray());
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_ReturnsAllRoomsAscendingByStartsAt_IncludingCancelled()
+    {
+        var late = await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(roomId: "vega", startsAt: Now.AddDays(12)));
+        var early = await CreateBookingAsync(ApiFactory.BobKey, NewBooking(roomId: "orion", startsAt: Now.AddDays(11)));
+        var cancelled = await CreateBookingAsync(ApiFactory.BobKey, NewBooking(roomId: "lyra", startsAt: Now.AddDays(13)));
+        await Client(ApiFactory.BobKey).DeleteAsync($"{Bookings}/{IdOf(cancelled)}");
+
+        var body = await ReadAsync(await Client().GetAsync(Bookings));
+
+        var items = body.GetProperty("items").EnumerateArray().ToArray();
+        Assert.Equal([IdOf(early), IdOf(late), IdOf(cancelled)], items.Select(IdOf).ToArray());
+        Assert.Equal("cancelled", items[2].GetProperty("status").GetString());
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_FilterByRoom_ReturnsOnlyThatRoom()
+    {
+        await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(roomId: "vega"));
+        var orion = await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(roomId: "orion"));
+
+        var body = await ReadAsync(await Client().GetAsync($"{Bookings}?roomId=orion"));
+
+        Assert.Equal([IdOf(orion)], body.GetProperty("items").EnumerateArray().Select(IdOf).ToArray());
+    }
+
+    [Fact]
+    public async Task List_FilterByPeriod_ReturnsOverlappingBookings()
+    {
+        var day10 = await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: Now.AddDays(10), durationMinutes: 60));
+        var day20 = await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: Now.AddDays(20), durationMinutes: 60));
+        await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: Now.AddDays(30), durationMinutes: 60));
+
+        var from = Uri.EscapeDataString(Now.AddDays(10).AddMinutes(30).ToString("O"));
+        var to = Uri.EscapeDataString(Now.AddDays(25).ToString("O"));
+        var body = await ReadAsync(await Client().GetAsync($"{Bookings}?from={from}&to={to}"));
+
+        Assert.Equal([IdOf(day10), IdOf(day20)], body.GetProperty("items").EnumerateArray().Select(IdOf).ToArray());
+    }
+
+    [Fact]
+    public async Task List_CursorPaging_WalksAllItemsOnceInOrder()
+    {
+        var expected = new List<string>();
+        for (var day = 10; day < 15; day++)
+            expected.Add(IdOf(await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: Now.AddDays(day)))));
+
+        var seen = new List<string>();
+        string? cursor = null;
+        var pages = 0;
+        do
+        {
+            var url = cursor is null ? $"{Bookings}?limit=2" : $"{Bookings}?limit=2&cursor={Uri.EscapeDataString(cursor)}";
+            var body = await ReadAsync(await Client().GetAsync(url));
+            seen.AddRange(body.GetProperty("items").EnumerateArray().Select(IdOf));
+            cursor = body.GetProperty("nextCursor").GetString();
+            pages++;
+        }
+        while (cursor is not null && pages < 10);
+
+        Assert.Equal(3, pages);
+        Assert.Equal(expected, seen);
+    }
+
+    [Fact]
+    public async Task List_ExactlyOnePage_NextCursorIsNull()
+    {
+        await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: Now.AddDays(10)));
+        await CreateBookingAsync(ApiFactory.AliceKey, NewBooking(startsAt: Now.AddDays(11)));
+
+        var body = await ReadAsync(await Client().GetAsync($"{Bookings}?limit=2"));
+
+        Assert.Equal(2, body.GetProperty("items").GetArrayLength());
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_MalformedCursor_Returns400()
+    {
+        var response = await Client().GetAsync($"{Bookings}?cursor=not-a-cursor");
+
+        await AssertValidationProblemAsync(response, "cursor");
+    }
+
+    [Theory(Skip = DivergenceSkip)]
