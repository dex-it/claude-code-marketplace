@@ -0,0 +1,73 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public abstract class ApiTestBase : IDisposable
+{
+    protected const string DivergenceSkip = "BKG-31: расхождение с контрактом, см. описание MR";
+
+    protected const string NeedsPostgres =
+        "Нужен PostgreSQL: пересечения ловит exclusion-констрейнт БД, в InMemory его нет; docker run недоступен";
+
+    private readonly ApiFactory _factory = new();
+
+    protected ApiTestBase()
+    {
+        _factory.SeedRooms();
+    }
+
+    protected static DateTimeOffset Now => ApiFactory.Now;
+
+    protected HttpClient Client(string? apiKey = ApiFactory.AliceKey)
+    {
+        var client = _factory.CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+
+    protected static object NewBooking(
+        string roomId = "orion", string title = "Планирование спринта", DateTimeOffset? startsAt = null,
+        int durationMinutes = 60, string? comment = null) =>
+        new { roomId, title, startsAt = startsAt ?? Now.AddDays(10), durationMinutes, comment };
+
+    protected async Task<JsonElement> CreateBookingAsync(string apiKey, object? request = null)
+    {
+        var response = await Client(apiKey).PostAsJsonAsync("/api/v1/bookings", request ?? NewBooking());
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadAsync(response);
+    }
+
+    protected static async Task<JsonElement> ReadAsync(HttpResponseMessage response)
+    {
+        using var stream = await response.Content.ReadAsStreamAsync();
+        return (await JsonDocument.ParseAsync(stream)).RootElement.Clone();
+    }
+
+    protected static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadAsync(response);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+    }
+
+    protected static async Task AssertValidationProblemAsync(HttpResponseMessage response, string field)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadAsync(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        Assert.True(body.GetProperty("errors").TryGetProperty(field, out var messages), $"нет ошибки по полю {field}");
+        Assert.NotEmpty(messages.EnumerateArray());
+    }
+
+    public void Dispose()
+    {
+        _factory.Dispose();
+        GC.SuppressFinalize(this);
+    }
+}
