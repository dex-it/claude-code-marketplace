@@ -0,0 +1,73 @@
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис в памяти: EF InMemory вместо PostgreSQL, фиксированные часы, три комнаты как в DbInitializer.
+/// Ограничения хранилища (exclusion-констрейнт пересечений, xmin-версия) в InMemory не воспроизводятся.
+/// </summary>
+public class ApiFactory : WebApplicationFactory<Program>
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    public static readonly DateTimeOffset Now = new(2026, 10, 11, 9, 0, 0, TimeSpan.Zero);
+
+    private readonly string _databaseName = Guid.NewGuid().ToString();
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+        builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["Database:Initialize"] = "false",
+            ["Auth:Keys:0:key"] = AliceKey,
+            ["Auth:Keys:0:userId"] = "alice",
+            ["Auth:Keys:0:role"] = "member",
+            ["Auth:Keys:1:key"] = BobKey,
+            ["Auth:Keys:1:userId"] = "bob",
+            ["Auth:Keys:1:role"] = "member",
+            ["Auth:Keys:2:key"] = AdminKey,
+            ["Auth:Keys:2:userId"] = "admin",
+            ["Auth:Keys:2:role"] = "admin",
+        }));
+
+        builder.ConfigureServices(services =>
+        {
+            services.RemoveAll<DbContextOptions<BookingsDbContext>>();
+            services.AddDbContext<BookingsDbContext>(o => o.UseInMemoryDatabase(_databaseName));
+            services.RemoveAll<TimeProvider>();
+            services.AddSingleton<TimeProvider>(new FixedTimeProvider(Now));
+        });
+    }
+
+    public void SeedRooms()
+    {
+        using var scope = Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<BookingsDbContext>();
+        if (db.Rooms.Any())
+            return;
+
+        var orion = new Room("orion", "Orion", 8, 3);
+        orion.Features.AddRange([RoomFeature.Projector, RoomFeature.Whiteboard]);
+        var vega = new Room("vega", "Vega", 4, 3);
+        vega.Features.Add(RoomFeature.Whiteboard);
+        var lyra = new Room("lyra", "Lyra", 12, 5);
+        lyra.Features.AddRange([RoomFeature.Projector, RoomFeature.Videoconf]);
+        db.Rooms.AddRange(orion, vega, lyra);
+        db.SaveChanges();
+    }
+
+    private sealed class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => now;
+    }
+}
