+        Assert.Equal(JsonValueKind.Array, body.GetProperty("items").ValueKind);
+        Assert.Equal(0, body.GetProperty("items").GetArrayLength());
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [DiscrepancyFact("GET /bookings: limit вне 1..100 - 400; сервис принимает limit=0 и limit=1000, 200")]
+    public async Task List_LimitOutOfRange_Returns400()
+    {
+        foreach (var limit in new[] { 0, 101, 1000 })
+        {
+            using var response = await Client().GetAsync($"/api/v1/bookings?limit={limit}");
+
+            await AssertValidationAsync(response, "limit");
+        }
+    }
+
+    [Fact]
+    public async Task List_GarbageCursor_Returns400()
+    {
+        using var response = await Client().GetAsync("/api/v1/bookings?cursor=not-a-cursor");
+
+        await AssertValidationAsync(response, "cursor");
+    }
+
+    [Fact]
+    public async Task List_InvalidFrom_Returns400()
+    {
+        using var response = await Client().GetAsync("/api/v1/bookings?from=yesterday");
+
+        await AssertValidationAsync(response, "from");
+    }
+
+    [Fact]
+    public async Task List_WithoutKey_Returns401Unauthorized()
+    {
+        using var response = await Client(key: null).GetAsync("/api/v1/bookings");
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
