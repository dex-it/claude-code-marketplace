+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Get_CancelledBooking_IsStillVisibleWithStatusCancelled()
+    {
+        var created = await CreateBookingAsync();
+        using var cancel = await Client().DeleteAsync($"/api/v1/bookings/{IdOf(created)}");
+        Assert.Equal(HttpStatusCode.NoContent, cancel.StatusCode);
+
+        using var response = await Client(BobKey).GetAsync($"/api/v1/bookings/{IdOf(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("cancelled", (await ReadJsonAsync(response)).GetProperty("status").GetString());
