+public abstract class ApiTestBase : IDisposable
+{
+    protected const string AliceKey = "dev-alice-key";
+    protected const string BobKey = "dev-bob-key";
+    protected const string AdminKey = "dev-admin-key";
+
+    private readonly BookingsFactory _factory = new();
+
+    protected static DateTimeOffset Now => BookingsFactory.Now;
+
+    /// <summary>Начало в будущем: день и час относительно фиксированного "сейчас".</summary>
+    protected static DateTimeOffset At(int daysAhead, int hour = 7, int minute = 0) =>
+        new DateTimeOffset(Now.Date, TimeSpan.Zero).AddDays(daysAhead).AddHours(hour).AddMinutes(minute);
+
+    protected HttpClient Client(string? key = AliceKey)
+    {
+        var client = _factory.CreateClient();
+        if (key is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", key);
+        return client;
+    }
+
+    protected static object NewBooking(
+        string roomId = "orion", string title = "Планирование спринта", DateTimeOffset? startsAt = null,
+        int durationMinutes = 90, string? comment = null) =>
+        new { roomId, title, startsAt = startsAt ?? At(9), durationMinutes, comment };
+
+    protected async Task<JsonElement> CreateBookingAsync(string key = AliceKey, object? request = null)
+    {
+        using var response = await Client(key).PostAsJsonAsync("/api/v1/bookings", request ?? NewBooking());
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJsonAsync(response);
+    }
+
+    protected static async Task<JsonElement> ReadJsonAsync(HttpResponseMessage response) =>
+        JsonDocument.Parse(await response.Content.ReadAsStringAsync()).RootElement.Clone();
+
+    protected static Guid IdOf(JsonElement booking) => booking.GetProperty("id").GetGuid();
+
+    /// <summary>Ошибка по контракту: статус, application/problem+json, поле code.</summary>
+    protected static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJsonAsync(response);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        Assert.True(body.TryGetProperty("title", out _));
+        Assert.True(body.TryGetProperty("type", out _));
+    }
+
+    /// <summary>ValidationProblem: 400, application/problem+json, errors содержит поле (camelCase).</summary>
+    protected static async Task AssertValidationAsync(HttpResponseMessage response, string field)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJsonAsync(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        var errors = body.GetProperty("errors");
+        Assert.True(
+            errors.EnumerateObject().Any(p => string.Equals(p.Name, field, StringComparison.Ordinal)),
+            $"В errors нет поля '{field}': {errors}");
+    }
+
+    /// <summary>Все обязательные поля схемы Booking с нужными типами.</summary>
+    protected static void AssertBookingShape(JsonElement booking)
+    {
+        Assert.Equal(JsonValueKind.String, booking.GetProperty("id").ValueKind);
+        Assert.NotEqual(Guid.Empty, booking.GetProperty("id").GetGuid());
+        Assert.Equal(JsonValueKind.String, booking.GetProperty("roomId").ValueKind);
+        Assert.Equal(JsonValueKind.String, booking.GetProperty("title").ValueKind);
+        Assert.Contains(booking.GetProperty("comment").ValueKind, new[] { JsonValueKind.String, JsonValueKind.Null });
+        Assert.True(booking.GetProperty("startsAt").TryGetDateTimeOffset(out _));
+        Assert.True(booking.GetProperty("endsAt").TryGetDateTimeOffset(out _));
+        Assert.True(booking.GetProperty("durationMinutes").TryGetInt32(out _));
+        Assert.Equal(JsonValueKind.String, booking.GetProperty("ownerId").ValueKind);
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.True(booking.GetProperty("version").TryGetInt64(out var version));
+        Assert.InRange(version, 0, uint.MaxValue);
+    }
+
+    public void Dispose()
+    {
+        _factory.Dispose();
+        GC.SuppressFinalize(this);
+    }
