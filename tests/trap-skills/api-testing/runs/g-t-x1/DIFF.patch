+            new { startsAt = At(9, 7, 30), durationMinutes = 60, version = other.GetProperty("version").GetInt64() });
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [DiscrepancyFact("PATCH /bookings/{id}: версия не совпала - 409 version-conflict; сервис версию из запроса не сверяет", requiresPostgres: true)]
+    public async Task Reschedule_WithStaleVersionAfterChange_Returns409VersionConflict()
+    {
+        var created = await CreateBookingAsync();
+        var originalVersion = created.GetProperty("version").GetInt64();
+        using var first = await Client().PatchAsJsonAsync(
+            $"/api/v1/bookings/{IdOf(created)}", new { startsAt = At(10, 7), durationMinutes = 60, version = originalVersion });
+        Assert.Equal(HttpStatusCode.OK, first.StatusCode);
+        Assert.NotEqual(originalVersion, (await ReadJsonAsync(first)).GetProperty("version").GetInt64());
+
+        using var second = await Client().PatchAsJsonAsync(
+            $"/api/v1/bookings/{IdOf(created)}", new { startsAt = At(11, 7), durationMinutes = 60, version = originalVersion });
+
+        await AssertProblemAsync(second, HttpStatusCode.Conflict, "version-conflict");
+    }
+
+    // ---- DELETE /api/v1/bookings/{bookingId}
+
+    [Fact]
+    public async Task Cancel_ByOwner_Returns204AndBookingIsCancelled()
+    {
+        var created = await CreateBookingAsync();
+
+        using var response = await Client().DeleteAsync($"/api/v1/bookings/{IdOf(created)}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        using var fetched = await Client().GetAsync($"/api/v1/bookings/{IdOf(created)}");
+        Assert.Equal("cancelled", (await ReadJsonAsync(fetched)).GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_ByAdmin_Returns204()
+    {
+        var created = await CreateBookingAsync(AliceKey);
+
+        using var response = await Client(AdminKey).DeleteAsync($"/api/v1/bookings/{IdOf(created)}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Cancel_ByAnotherMember_Returns403NotOwner()
+    {
+        var created = await CreateBookingAsync(AliceKey);
+
+        using var response = await Client(BobKey).DeleteAsync($"/api/v1/bookings/{IdOf(created)}");
+
+        await AssertProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+        using var fetched = await Client().GetAsync($"/api/v1/bookings/{IdOf(created)}");
+        Assert.Equal("active", (await ReadJsonAsync(fetched)).GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_Unknown_Returns404BookingNotFound()
+    {
+        using var response = await Client().DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Cancel_WithoutKey_Returns401Unauthorized()
+    {
+        using var response = await Client(key: null).DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [DiscrepancyFact("DELETE /bookings/{id}: повторная отмена - 204 (FR-11); сервис падает на уже отменённой брони, 500")]
+    public async Task Cancel_Twice_Returns204BothTimes()
+    {
+        var created = await CreateBookingAsync();
+        using var first = await Client().DeleteAsync($"/api/v1/bookings/{IdOf(created)}");
+        Assert.Equal(HttpStatusCode.NoContent, first.StatusCode);
+
+        using var second = await Client().DeleteAsync($"/api/v1/bookings/{IdOf(created)}");
+
+        Assert.Equal(HttpStatusCode.NoContent, second.StatusCode);
+    }
+
+    // ---- GET /api/v1/bookings
+
+    [Fact]
+    public async Task List_ReturnsActiveAndCancelledOrderedByStart()
+    {
+        var third = await CreateBookingAsync(request: NewBooking(roomId: "vega", startsAt: At(12, 7)));
+        var first = await CreateBookingAsync(request: NewBooking(roomId: "orion", startsAt: At(10, 7)));
+        var second = await CreateBookingAsync(request: NewBooking(roomId: "lyra", startsAt: At(11, 7)));
+        using var cancel = await Client().DeleteAsync($"/api/v1/bookings/{IdOf(second)}");
+        Assert.Equal(HttpStatusCode.NoContent, cancel.StatusCode);
+
+        using var response = await Client(BobKey).GetAsync("/api/v1/bookings");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await ReadJsonAsync(response);
+        Assert.Equal([IdOf(first), IdOf(second), IdOf(third)], body.GetProperty("items").EnumerateArray().Select(IdOf));
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
