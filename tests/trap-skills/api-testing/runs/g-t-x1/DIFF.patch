+        using var response = await Client().PatchAsJsonAsync(
+            $"/api/v1/bookings/{IdOf(created)}",
+            new { startsAt = newStart, durationMinutes = 120, version = created.GetProperty("version").GetInt64() });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal(IdOf(created), IdOf(booking));
+        Assert.Equal(newStart, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(120, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(newStart.AddMinutes(120),booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
