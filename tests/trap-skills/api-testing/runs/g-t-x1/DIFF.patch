@@ -0,0 +1,223 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.Extensions.Hosting;
+using Npgsql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Тест, которому нужен PostgreSQL (исключающее ограничение, xmin): задайте BOOKINGS_TEST_PG.</summary>
+public sealed class PostgresFactAttribute : FactAttribute
+{
+    public PostgresFactAttribute()
+    {
+        if (TestEnvironment.PostgresConnectionString is null)
+            Skip = $"Нужен PostgreSQL: задайте {TestEnvironment.PostgresVariable} (строка подключения к серверу).";
+    }
+}
+
+/// <summary>
+/// Тест фиксирует расхождение реализации с контрактом: он падает, пока сервис не исправлен,
+/// поэтому по умолчанию пропускается. Запуск: BOOKINGS_RUN_DISCREPANCIES=1 dotnet test.
+/// </summary>
+public sealed class DiscrepancyFactAttribute : FactAttribute
+{
+    public DiscrepancyFactAttribute(string discrepancy, bool requiresPostgres = false)
+    {
+        if (Environment.GetEnvironmentVariable(TestEnvironment.DiscrepanciesVariable) != "1")
+            Skip = $"Расхождение с контрактом: {discrepancy}";
+        else if (requiresPostgres && TestEnvironment.PostgresConnectionString is null)
+            Skip = $"Нужен PostgreSQL: задайте {TestEnvironment.PostgresVariable}. Расхождение: {discrepancy}";
+    }
+}
+
+public static class TestEnvironment
+{
+    public const string PostgresVariable = "BOOKINGS_TEST_PG";
+    public const string DiscrepanciesVariable = "BOOKINGS_RUN_DISCREPANCIES";
+
+    public static string? PostgresConnectionString => Environment.GetEnvironmentVariable(PostgresVariable);
+}
+
+public sealed class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+{
+    public override DateTimeOffset GetUtcNow() => now;
+}
+
+/// <summary>
+/// Сервис в памяти процесса. По умолчанию БД - EF InMemory (без ограничений PostgreSQL);
+/// с BOOKINGS_TEST_PG - отдельная база на PostgreSQL, создаваемая и удаляемая фабрикой.
+/// </summary>
+public sealed class BookingsFactory : WebApplicationFactory<Program>
+{
+    public static readonly DateTimeOffset Now = new(2026, 10, 11, 9, 0, 0, TimeSpan.Zero);
+
+    private readonly string? _postgresDatabase;
+    private readonly string? _postgresServer;
+
+    public BookingsFactory()
+    {
+        _postgresServer = TestEnvironment.PostgresConnectionString;
+        if (_postgresServer is not null)
+            _postgresDatabase = "bookings_test_" + Guid.NewGuid().ToString("N");
+    }
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Development");
+        builder.UseSetting("Database:Initialize", _postgresServer is null ? "false" : "true");
+
+        if (_postgresServer is not null)
+        {
+            var connection = new NpgsqlConnectionStringBuilder(_postgresServer) { Database = _postgresDatabase };
+            builder.UseSetting("ConnectionStrings:Bookings", connection.ConnectionString);
+        }
+
+        builder.ConfigureServices(services =>
+        {
+            services.RemoveAll<TimeProvider>();
+            services.AddSingleton<TimeProvider>(new FixedTimeProvider(Now));
+
+            if (_postgresServer is null)
+            {
+                services.RemoveAll<DbContextOptions<BookingsDbContext>>();
+                services.RemoveAll<DbContextOptions>();
+                var name = "bookings-" + Guid.NewGuid();
+                services.AddDbContext<BookingsDbContext>(o => o.UseInMemoryDatabase(name));
+            }
+        });
+    }
+
+    protected override IHost CreateHost(IHostBuilder builder)
+    {
+        var host = base.CreateHost(builder);
+        if (_postgresServer is null)
+            SeedRooms(host.Services);
+        return host;
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing && _postgresServer is not null)
+        {
+            var connection = new NpgsqlConnectionStringBuilder(_postgresServer) { Database = _postgresDatabase };
+            var options = new DbContextOptionsBuilder<BookingsDbContext>().UseNpgsql(connection.ConnectionString).Options;
+            using var db = new BookingsDbContext(options);
+            db.Database.EnsureDeleted();
+        }
+
+        base.Dispose(disposing);
+    }
+
+    // Те же три комнаты, что заводит DbInitializer
+    private static void SeedRooms(IServiceProvider services)
+    {
+        using var scope = services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<BookingsDbContext>();
+
+        var orion = new Room("orion", "Orion", 8, 3);
+        orion.Features.AddRange([RoomFeature.Projector, RoomFeature.Whiteboard]);
+        var vega = new Room("vega", "Vega", 4, 3);
+        vega.Features.Add(RoomFeature.Whiteboard);
+        var lyra = new Room("lyra", "Lyra", 12, 5);
+        lyra.Features.AddRange([RoomFeature.Projector, RoomFeature.Videoconf]);
+
+        db.Rooms.AddRange(orion, vega, lyra);
