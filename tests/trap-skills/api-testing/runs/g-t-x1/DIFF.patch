+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsTests : ApiTestBase
+{
+    // ---- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithBooking()
+    {
+        var startsAt = At(9, 7);
+        using var response = await Client(AliceKey).PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking(title: "Планирование спринта", startsAt: startsAt, durationMinutes: 60, comment: "Принесите ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принесите ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(60), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var booking = await CreateBookingAsync();
+
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_OwnerIsTheKeyHolder()
+    {
+        var booking = await CreateBookingAsync(BobKey);
+
+        Assert.Equal("bob", booking.GetProperty("ownerId").GetString());
+    }
+
+    [DiscrepancyFact("POST /bookings: endsAt = startsAt + durationMinutes; сервис считает конец как startsAt + (durationMinutes / 60) часов, 90 минут даёт +1 ч")]
+    public async Task Create_EndsAtIsStartPlusDuration_ForNonWholeHours()
+    {
+        var startsAt = At(9, 7);
+        var booking = await CreateBookingAsync(request: NewBooking(startsAt: startsAt, durationMinutes: 90));
+
+        Assert.Equal(startsAt.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [DiscrepancyFact("POST /bookings: 201 содержит заголовок Location /api/v1/bookings/{id}; сервис его не отдаёт")]
+    public async Task Create_ReturnsLocationOfCreatedBooking()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking());
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        Assert.NotNull(response.Headers.Location);
+        Assert.EndsWith($"/api/v1/bookings/{IdOf(booking)}", response.Headers.Location!.ToString());
+    }
+
+    [Fact]
+    public async Task Create_ThenGet_ReturnsSameBooking()
+    {
+        var created = await CreateBookingAsync();
+
+        using var response = await Client(BobKey).GetAsync($"/api/v1/bookings/{IdOf(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var fetched = await ReadJsonAsync(response);
+        Assert.Equal(IdOf(created), IdOf(fetched));
+        Assert.Equal(created.GetProperty("version").GetInt64(), fetched.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId: "atlantis"));
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401Unauthorized()
+    {
+        using var response = await Client(key: null).PostAsJsonAsync("/api/v1/bookings", NewBooking());
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Create_UnknownKey_Returns401Unauthorized()
+    {
+        using var response = await Client("no-such-key").PostAsJsonAsync("/api/v1/bookings", NewBooking());
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Create_StartInThePast_Returns400()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: Now.AddMinutes(-15)));
+
+        await AssertValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartNowExactly_Returns400()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: Now));
+
+        await AssertValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: Now.AddDays(90).AddMinutes(1)));
+
+        await AssertValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartExactly90Days_IsAccepted()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: Now.AddDays(90)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
