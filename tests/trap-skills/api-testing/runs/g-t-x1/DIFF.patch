+
+        await AssertValidationAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleLongerThan120_Returns400()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(title: new string('т', 121)));
+
+        await AssertValidationAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf120_IsAccepted()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(title: new string('т', 120)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_CommentLongerThan500_Returns400()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(comment: new string('к', 501)));
+
+        await AssertValidationAsync(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_CommentOf500_IsAccepted()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking(comment: new string('к', 500)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_MissingRequiredFields_Returns400()
+    {
+        using var response = await Client().PostAsJsonAsync("/api/v1/bookings", new { title = "Без комнаты" });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+    }
+
+    [DiscrepancyFact("POST /bookings: пересечение с активной бронью - 409 problem+json с code booking-overlap; сервис отвечает 409 с телом {\"error\":\"overlap\"} (application/json, без code)", requiresPostgres: true)]
+    public async Task Create_OverlapWithActiveBooking_Returns409Overlap()
+    {
+        await CreateBookingAsync(request: NewBooking(startsAt: At(9, 7), durationMinutes: 60));
+
+        using var response = await Client(BobKey).PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking(startsAt: At(9, 7, 30), durationMinutes: 60));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [PostgresFact]
+    public async Task Create_AdjacentToActiveBooking_IsAccepted()
+    {
+        await CreateBookingAsync(request: NewBooking(startsAt: At(9, 7), durationMinutes: 60));
+
+        using var response = await Client(BobKey).PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking(startsAt: At(9, 8), durationMinutes: 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [PostgresFact]
+    public async Task Create_OverCancelledBooking_IsAccepted()
+    {
+        var first = await CreateBookingAsync(request: NewBooking(startsAt: At(9, 7), durationMinutes: 60));
+        using var cancel = await Client().DeleteAsync($"/api/v1/bookings/{IdOf(first)}");
+        Assert.Equal(HttpStatusCode.NoContent, cancel.StatusCode);
