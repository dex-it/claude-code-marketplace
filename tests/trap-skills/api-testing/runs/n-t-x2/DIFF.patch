diff --git a/tests/Bookings.Api.IntegrationTests/BookingsApiFactory.cs b/tests/Bookings.Api.IntegrationTests/BookingsApiFactory.cs
new file mode 100644
index 0000000..d4850cd
--- /dev/null
+++ b/tests/Bookings.Api.IntegrationTests/BookingsApiFactory.cs
@@ -0,0 +1,135 @@
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Diagnostics;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.Extensions.Hosting;
+using Npgsql;
+
+namespace Bookings.Api.IntegrationTests;
+
+/// <summary>
+/// Сервис на EF InMemory вместо PostgreSQL (Docker в локальном прогоне не нужен). Поведение, которое в
+/// продакшене даёт БД - версия брони (xmin) и ограничение пересечения (EXCLUDE), - воспроизводит
+/// <see cref="PostgresBehaviorEmulation"/>.
+/// </summary>
+public class BookingsApiFactory : WebApplicationFactory<Program>
+{
+    public const string MemberKey = "test-alice-key";
+    public const string OtherMemberKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    public const string Alice = "alice";
+    public const string Bob = "bob";
+
+    private readonly string _databaseName = Guid.NewGuid().ToString("N");
+    private readonly PostgresBehaviorEmulation _emulation = new();
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+
+        builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["Database:Initialize"] = "false",
+            ["Auth:Keys:0:Key"] = MemberKey,
+            ["Auth:Keys:0:UserId"] = Alice,
+            ["Auth:Keys:0:Role"] = "member",
+            ["Auth:Keys:1:Key"] = OtherMemberKey,
+            ["Auth:Keys:1:UserId"] = Bob,
+            ["Auth:Keys:1:Role"] = "member",
+            ["Auth:Keys:2:Key"] = AdminKey,
+            ["Auth:Keys:2:UserId"] = "admin",
+            ["Auth:Keys:2:Role"] = "admin",
+        }));
+
+        builder.ConfigureServices(services =>
+        {
+            services.RemoveAll<DbContextOptions<BookingsDbContext>>();
+            services.RemoveAll<BookingsDbContext>();
+            services.AddDbContext<BookingsDbContext>(options => options
+                .UseInMemoryDatabase(_databaseName)
+                .AddInterceptors(_emulation));
+        });
+    }
+
+    protected override IHost CreateHost(IHostBuilder builder)
+    {
+        var host = base.CreateHost(builder);
+        using var scope = host.Services.CreateScope();
+        SeedRooms(scope.ServiceProvider.GetRequiredService<BookingsDbContext>());
+        return host;
+    }
+
+    // Те же три комнаты, что заводит DbInitializer в Development.
+    private static void SeedRooms(BookingsDbContext db)
+    {
+        var orion = new Room("orion", "Orion", 8, 3);
+        orion.Features.AddRange([RoomFeature.Projector, RoomFeature.Whiteboard]);
+        var vega = new Room("vega", "Vega", 4, 3);
+        vega.Features.Add(RoomFeature.Whiteboard);
+        var lyra = new Room("lyra", "Lyra", 12, 5);
+        lyra.Features.AddRange([RoomFeature.Projector, RoomFeature.Videoconf]);
+
+        db.Rooms.AddRange(orion, vega, lyra);
+        db.SaveChanges();
+    }
+
+    public HttpClient CreateClient(string? apiKey)
+    {
+        var client = CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+}
+
+internal sealed class PostgresBehaviorEmulation : SaveChangesInterceptor
+{
+    private long _version = 800;
+
+    public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)
+    {
+        Apply(eventData.Context!);
+        return result;
+    }
+
+    public override ValueTask<InterceptionResult<int>> SavingChangesAsync(
+        DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)
+    {
+        Apply(eventData.Context!);
+        return ValueTask.FromResult(result);
+    }
+
+    private void Apply(DbContext db)
+    {
+        var changed = db.ChangeTracker.Entries<Booking>()
+            .Where(e => e.State is EntityState.Added or EntityState.Modified)
+            .ToList();
+
+        foreach (var entry in changed)
+        {
+            var booking = entry.Entity;
+            if (booking.Status == BookingStatus.Active && Overlaps(db, booking))
+            {
+                throw new DbUpdateException(
+                    "bookings_no_overlap",
+                    new PostgresException("exclusion violation", "ERROR", "ERROR", PostgresErrorCodes.ExclusionViolation));
+            }
+
+            // xmin меняется при каждой записи строки
+            entry.Property(nameof(Booking.Version)).CurrentValue = (uint)Interlocked.Increment(ref _version);
+        }
+    }
+
+    // EXCLUDE (room_id WITH =, tstzrange(starts_at, ends_at) WITH &&) WHERE (status = 'active')
+    private static bool Overlaps(DbContext db, Booking booking) =>
+        db.Set<Booking>().AsNoTracking()
+            .Where(o => o.RoomId == booking.RoomId && o.Id != booking.Id)
+            .AsEnumerable()
+            .Any(o => o.Status == BookingStatus.Active && o.StartsAt < booking.EndsAt && booking.StartsAt < o.EndsAt);
+}
