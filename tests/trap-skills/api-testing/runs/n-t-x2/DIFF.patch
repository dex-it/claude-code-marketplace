diff --git a/tests/Bookings.Api.IntegrationTests/ApiTestBase.cs b/tests/Bookings.Api.IntegrationTests/ApiTestBase.cs
new file mode 100644
index 0000000..5b2ab1f
--- /dev/null
+++ b/tests/Bookings.Api.IntegrationTests/ApiTestBase.cs
@@ -0,0 +1,104 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.IntegrationTests;
+
+/// <summary>Новый экземпляр сервиса и пустая БД на каждый тест.</summary>
+public abstract class ApiTestBase : IDisposable
+{
+    protected ApiTestBase()
+    {
+        Factory = new BookingsApiFactory();
+        Alice = Factory.CreateClient(BookingsApiFactory.MemberKey);
+        Bob = Factory.CreateClient(BookingsApiFactory.OtherMemberKey);
+        Admin = Factory.CreateClient(BookingsApiFactory.AdminKey);
+    }
+
+    protected BookingsApiFactory Factory { get; }
+    protected HttpClient Alice { get; }
+    protected HttpClient Bob { get; }
+    protected HttpClient Admin { get; }
+
+    public void Dispose()
+    {
+        Alice.Dispose();
+        Bob.Dispose();
+        Admin.Dispose();
+        Factory.Dispose();
+        GC.SuppressFinalize(this);
+    }
+
+    /// <summary>Момент в будущем: через <paramref name="days"/> суток от начала текущих суток UTC, в <paramref name="hour"/> часов.</summary>
+    protected static DateTimeOffset Future(int days, int hour = 10, int minute = 0) =>
+        new DateTimeOffset(DateTime.UtcNow.Date, TimeSpan.Zero).AddDays(days).AddHours(hour).AddMinutes(minute);
+
+    protected static string Iso(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss'Z'");
+
+    protected static object NewBooking(
+        string roomId = "orion", DateTimeOffset? startsAt = null, int durationMinutes = 60, string title = "Планирование", string? comment = null) =>
+        new { roomId, title, startsAt = startsAt ?? Future(5), durationMinutes, comment };
+
+    protected static async Task<JsonElement> ReadJsonAsync(HttpResponseMessage response) =>
+        (await response.Content.ReadFromJsonAsync<JsonElement>()).Clone();
+
+    protected static async Task<JsonElement> CreateAsync(HttpClient client, object body)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", body);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJsonAsync(response);
+    }
+
+    protected static async Task<JsonElement> CreateAsync(
+        HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60) =>
+        await CreateAsync(client, NewBooking(roomId, startsAt, durationMinutes));
+
+    protected static string IdOf(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    protected static Task<HttpResponseMessage> RescheduleAsync(
+        HttpClient client, string id, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{id}", new { startsAt, durationMinutes, version });
+
+    /// <summary>Ошибка по контракту: статус, application/problem+json, обязательные поля Problem и <c>code</c>.</summary>
+    protected static async Task<JsonElement> AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+
+        var problem = await ReadJsonAsync(response);
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.Equal(code, problem.GetProperty("code").GetString());
+        Assert.False(string.IsNullOrEmpty(problem.GetProperty("type").GetString()));
+        Assert.False(string.IsNullOrEmpty(problem.GetProperty("title").GetString()));
+        return problem;
+    }
+
+    /// <summary>Ошибка проверки: 400, application/problem+json, <c>errors</c> с полем <paramref name="field"/>.</summary>
+    protected static async Task AssertValidationProblemAsync(HttpResponseMessage response, string field)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+
+        var problem = await ReadJsonAsync(response);
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrEmpty(problem.GetProperty("title").GetString()));
+        var errors = problem.GetProperty("errors");
+        Assert.True(errors.TryGetProperty(field, out var messages), $"В errors нет поля '{field}': {errors}");
+        Assert.NotEmpty(messages.EnumerateArray());
+    }
+
+    /// <summary>Поля брони по схеме Booking контракта.</summary>
+    protected static void AssertBookingShape(JsonElement booking)
+    {
+        foreach (var name in new[]
+                     { "id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version" })
+            Assert.True(booking.TryGetProperty(name, out _), $"В брони нет поля '{name}'");
+
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        var startsAt = booking.GetProperty("startsAt").GetDateTimeOffset();
+        var endsAt = booking.GetProperty("endsAt").GetDateTimeOffset();
+        Assert.Equal(startsAt.AddMinutes(booking.GetProperty("durationMinutes").GetInt32()), endsAt);
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+    }
+}
