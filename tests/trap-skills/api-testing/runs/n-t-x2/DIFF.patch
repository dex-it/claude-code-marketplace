+using System.Net;
+using System.Net.Http.Json;
+
+namespace Bookings.Api.IntegrationTests;
+
+public class BookingsApiTests : ApiTestBase
+{
+    // ---- POST /api/v1/bookings ----
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithBookingAndLocation()
+    {
+        var startsAt = Future(5, 7);
+
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings",
+            NewBooking("orion", startsAt, 90, "Планирование спринта", "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal(BookingsApiFactory.Alice, booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+        var location = response.Headers.Location;
+        Assert.NotNull(location);
+        var path = location.IsAbsoluteUri ? location.AbsolutePath : location.ToString();
+        Assert.Equal($"/api/v1/bookings/{IdOf(booking)}", path);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var booking = await CreateAsync(Alice, NewBooking());
+
+        Assert.Equal(System.Text.Json.JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_OwnerIsKeyHolder()
+    {
+        var booking = await CreateAsync(Bob, NewBooking());
+
+        Assert.Equal(BookingsApiFactory.Bob, booking.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Create_StartWithOffset_IsReturnedInUtc()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion",
+            title = "Встреча",
+            startsAt = Future(5, 10).ToOffset(TimeSpan.FromHours(3)),
+            durationMinutes = 30,
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        Assert.Equal(Future(5, 10), booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(TimeSpan.Zero, booking.GetProperty("startsAt").GetDateTimeOffset().Offset);
+        Assert.Equal(TimeSpan.Zero, booking.GetProperty("endsAt").GetDateTimeOffset().Offset);
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_DurationBounds_Accepted(int minutes)
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(durationMinutes: minutes));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(14)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(durationMinutes: minutes));
+
+        await AssertValidationProblemAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_StartInPast_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: DateTimeOffset.UtcNow.AddMinutes(-5)));
+
+        await AssertValidationProblemAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: DateTimeOffset.UtcNow.AddDays(91)));
+
+        await AssertValidationProblemAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartWithin90Days_Accepted()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: DateTimeOffset.UtcNow.AddDays(89)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_TitleBounds()
+    {
+        var max = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(title: new string('т', 120), startsAt: Future(5, 8)));
+        var tooLong = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(title: new string('т', 121), startsAt: Future(5, 12)));
+        var empty = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(title: "", startsAt: Future(5, 14)));
+
+        Assert.Equal(HttpStatusCode.Created, max.StatusCode);
+        await AssertValidationProblemAsync(tooLong, "title");
+        await AssertValidationProblemAsync(empty, "title");
+    }
+
+    [Fact]
+    public async Task Create_CommentBounds()
+    {
+        var max = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(comment: new string('к', 500), startsAt: Future(5, 8)));
+        var tooLong = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(comment: new string('к', 501), startsAt: Future(5, 12)));
+
+        Assert.Equal(HttpStatusCode.Created, max.StatusCode);
+        await AssertValidationProblemAsync(tooLong, "comment");
+    }
+
+    [Fact]
+    public async Task Create_EmptyRoomId_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId: ""));
+
+        await AssertValidationProblemAsync(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_MissingRequiredField_Returns400ProblemJson()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", new { roomId = "orion", durationMinutes = 60 });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        Assert.True((await ReadJsonAsync(response)).TryGetProperty("errors", out _));
+    }
+
+    [Fact(Skip = "Расхождение с контрактом (BKG-31): errors содержит 'Title', контракт - поле запроса в camelCase ('title')")]
+    public async Task Create_MissingTitle_ReportsFieldInCamelCase()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings",
+            new { roomId = "orion", startsAt = Future(5), durationMinutes = 60 });
+
+        await AssertValidationProblemAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId: "no-such-room"));
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_OverlapWithActiveBooking_Returns409Overlap()
+    {
+        await CreateAsync(Alice, "orion", Future(5, 10), 60);
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", Future(5, 10, 30), 60));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBooking_Accepted()
+    {
+        await CreateAsync(Alice, "orion", Future(5, 10), 60);
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", Future(5, 11), 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInOtherRoom_Accepted()
+    {
+        await CreateAsync(Alice, "orion", Future(5, 10), 60);
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking("vega", Future(5, 10), 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
