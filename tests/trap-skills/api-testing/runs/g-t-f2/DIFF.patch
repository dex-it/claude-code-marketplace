@@ -0,0 +1,30 @@
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Testcontainers.PostgreSql;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Сервис поверх настоящего PostgreSQL: ограничение пересечений броней живёт в БД (btree_gist).</summary>
+public sealed class BookingsApiFactory : WebApplicationFactory<Program>, IAsyncLifetime
+{
+    private readonly PostgreSqlContainer postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+
+    Task IAsyncLifetime.InitializeAsync() => postgres.StartAsync();
+
+    Task IAsyncLifetime.DisposeAsync() => postgres.DisposeAsync().AsTask();
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        // Ключи участников - из appsettings.Development.json
+        builder.UseEnvironment("Development");
+        builder.UseSetting("ConnectionStrings:Bookings", postgres.GetConnectionString());
+        builder.UseSetting("Database:Initialize", "true");
+    }
+}
+
+[CollectionDefinition(Name)]
+public sealed class ApiCollection : ICollectionFixture<BookingsApiFactory>
+{
+    public const string Name = "api";
+}
