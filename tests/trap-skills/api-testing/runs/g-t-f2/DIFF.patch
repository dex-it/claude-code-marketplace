@@ -0,0 +1,102 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase(BookingsApiFactory factory)
+{
+    protected const string Alice = "dev-alice-key";
+    protected const string Bob = "dev-bob-key";
+    protected const string Admin = "dev-admin-key";
+
+    protected static readonly string[] RoomIds = ["lyra", "orion", "vega"];
+
+    private static int slotCounter;
+
+    private readonly HttpClient client = factory.CreateClient();
+
+    /// <summary>
+    /// Свободное окно для теста: у каждого теста своя пара (комната, начало) в общей БД, шаг 4 часа,
+    /// начиная со 2-го дня вперёд - тесты не пересекаются друг с другом.
+    /// </summary>
+    protected static (string RoomId, DateTimeOffset StartsAt) NextSlot()
+    {
+        var n = Interlocked.Increment(ref slotCounter);
+        var room = RoomIds[n % RoomIds.Length];
+        var index = n / RoomIds.Length;
+        var day = DateTime.UtcNow.Date.AddDays(2 + index / 6);
+        return (room, new DateTimeOffset(day, TimeSpan.Zero).AddHours(index % 6 * 4));
+    }
+
+    protected Task<HttpResponseMessage> Send(HttpMethod method, string url, string? key, object? body = null)
+    {
+        var request = new HttpRequestMessage(method, url);
+        if (key is not null)
+            request.Headers.Add("X-Api-Key", key);
+        if (body is not null)
+            request.Content = JsonContent.Create(body);
+        return client.SendAsync(request);
+    }
+
+    protected Task<HttpResponseMessage> Get(string url, string? key = Alice) => Send(HttpMethod.Get, url, key);
+
+    protected Task<HttpResponseMessage> CreateRaw(object body, string? key = Alice) =>
+        Send(HttpMethod.Post, "/api/v1/bookings", key, body);
+
+    protected static object NewBooking(string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string title = "Планирование", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes, comment };
+
+    protected async Task<JsonElement> CreateBooking(string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string key = Alice)
+    {
+        var response = await CreateRaw(NewBooking(roomId, startsAt, durationMinutes), key);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await Json(response);
+    }
+
+    protected static async Task<JsonElement> Json(HttpResponseMessage response) =>
+        await response.Content.ReadFromJsonAsync<JsonElement>();
+
+    protected static string IdOf(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    protected static async Task AssertProblem(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await Json(response);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        Assert.False(string.IsNullOrEmpty(body.GetProperty("title").GetString()));
+    }
+
+    protected static async Task AssertValidation(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await Json(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        var errors = body.GetProperty("errors");
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"нет ошибки по полю {field}");
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+
+    protected static void AssertBooking(JsonElement booking, string roomId, DateTimeOffset startsAt, int durationMinutes, string ownerId, string status = "active")
+    {
+        foreach (var name in new[] { "id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version" })
+            Assert.True(booking.TryGetProperty(name, out _), $"в брони нет обязательного поля {name}");
+
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.Equal(roomId, booking.GetProperty("roomId").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(durationMinutes, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(durationMinutes), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal(ownerId, booking.GetProperty("ownerId").GetString());
+        Assert.Equal(status, booking.GetProperty("status").GetString());
+        Assert.True(booking.GetProperty("version").GetInt64() >= 0);
+    }
+}
