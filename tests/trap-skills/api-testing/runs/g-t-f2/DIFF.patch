+using System.Net;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-02..FR-12: брони (/api/v1/bookings).</summary>
+public class BookingsTests(BookingsApiFactory factory) : ApiTestBase(factory)
+{
+    private static string Iso(DateTimeOffset value) => Uri.EscapeDataString(value.ToString("O"));
+
+    private static string Url(JsonElement booking) => $"/api/v1/bookings/{IdOf(booking)}";
+
+    // items у пустой ленты - отдельная проверка (SkipEmptyItems); границы периода её не повторяют
+    private static IEnumerable<JsonElement> ItemsOf(JsonElement page) =>
+        page.GetProperty("items") is { ValueKind: JsonValueKind.Array } items ? items.EnumerateArray() : [];
+
+    // Тесты ниже описывают поведение по контракту 1.2.0; расхождения найдены сервисом при написании
+    // тестов и перечислены в описании MR BKG-31. Снять Skip - вместе с исправлением сервиса.
+    private const string SkipLocation = "BKG-31: POST /bookings отвечает 201 без заголовка Location";
+    private const string SkipEndsAt = "BKG-31: endsAt считается как startsAt + целые часы (durationMinutes / 60), минуты теряются";
+    private const string SkipOverlapBody = "BKG-31: пересечение - 409 с application/json {\"error\":\"overlap\"} вместо problem+json с code booking-overlap";
+    private const string SkipRescheduleOwner = "BKG-31: PATCH не проверяет владельца, чужую бронь переносят с 200 вместо 403 not-owner";
+    private const string SkipVersion = "BKG-31: PATCH игнорирует version из запроса, устаревшая версия проходит с 200 вместо 409 version-conflict";
+    private const string SkipCancelTwice = "BKG-31: повторная отмена - 500 вместо 204";
+    private const string SkipLimit = "BKG-31: GET /bookings не проверяет limit: 0 и 101 - 200, -5 - 500 вместо 400";
+    private const string SkipEmptyItems = "BKG-31: GET /bookings без результата отдаёт items: null вместо []";
+
+    // ---- создание (FR-03, FR-05, FR-08, FR-09) ----
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithBooking()
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start, 60, comment: "Приносите ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await Json(response);
+        AssertBooking(booking, room, start, 60, "alice");
+        Assert.Equal("Планирование", booking.GetProperty("title").GetString());
+        Assert.Equal("Приносите ноутбуки", booking.GetProperty("comment").GetString());
+    }
+
+    [Fact(Skip = SkipLocation)]
+    public async Task Create_Valid_ReturnsLocationOfCreatedBooking()
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start, 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal(Url(await Json(response)), response.Headers.Location?.OriginalString);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var (room, start) = NextSlot();
+
+        var booking = await CreateBooking(room, start);
+
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_OwnerIsKeyHolder()
+    {
+        var (room, start) = NextSlot();
+
+        var booking = await CreateBooking(room, start, key: Bob);
+
+        Assert.Equal("bob", booking.GetProperty("ownerId").GetString());
+    }
+
+    [Theory]
+    [InlineData(60)]
+    [InlineData(120)]
+    [InlineData(240)]
+    public async Task Create_EndsAtIsStartPlusDuration_WholeHours(int minutes)
+    {
+        var (room, start) = NextSlot();
+
+        var booking = await CreateBooking(room, start, minutes);
+
+        Assert.Equal(start.AddMinutes(minutes), booking.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Theory(Skip = SkipEndsAt)]
+    [InlineData(15)]
+    [InlineData(45)]
+    [InlineData(90)]
+    public async Task Create_EndsAtIsStartPlusDuration_PartialHours(int minutes)
+    {
+        var (room, start) = NextSlot();
+
+        var booking = await CreateBooking(room, start, minutes);
+
+        Assert.Equal(start.AddMinutes(minutes), booking.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(14)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(300)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start, minutes));
+
+        await AssertValidation(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_StartInPast_Returns400()
+    {
+        var response = await CreateRaw(NewBooking("orion", DateTimeOffset.UtcNow.AddHours(-1)));
+
+        await AssertValidation(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await CreateRaw(NewBooking("orion", DateTimeOffset.UtcNow.AddDays(91)));
+
+        await AssertValidation(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartWithin90Days_Returns201()
+    {
+        var response = await CreateRaw(NewBooking("vega", DateTime.UtcNow.Date.AddDays(89).AddHours(3)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_BlankTitle_Returns400()
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start, title: "   "));
+
+        await AssertValidation(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf121Chars_Returns400()
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start, title: new string('я', 121)));
+
+        await AssertValidation(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_CommentOf501Chars_Returns400()
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start, comment: new string('a', 501)));
+
+        await AssertValidation(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_TitleAndCommentAtLimit_Returns201()
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start, title: new string('t', 120), comment: new string('c', 500)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_MissingRequiredField_Returns400()
+    {
+        var response = await CreateRaw(new { roomId = "orion", title = "Без времени" });
+
+        await AssertValidation(response);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var (_, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking("no-such-room", start));
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401()
+    {
+        var (room, start) = NextSlot();
+
+        var response = await CreateRaw(NewBooking(room, start), key: null);
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact(Skip = SkipOverlapBody)]
+    public async Task Create_OverlapsActiveBooking_Returns409BookingOverlap()
+    {
+        var (room, start) = NextSlot();
+        await CreateBooking(room, start, 60);
+
+        var response = await CreateRaw(NewBooking(room, start.AddMinutes(30), 60), key: Bob);
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBooking_Returns201()
+    {
+        var (room, start) = NextSlot();
+        await CreateBooking(room, start, 60);
+
+        var response = await CreateRaw(NewBooking(room, start.AddMinutes(60), 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_Returns201()
+    {
+        // Своё окно вне сетки NextSlot: другие тесты могут занимать соседнюю комнату в то же время
+        var start = new DateTimeOffset(DateTime.UtcNow.Date.AddDays(70), TimeSpan.Zero);
+        await CreateBooking("lyra", start, 60);
+
+        var response = await CreateRaw(NewBooking("vega", start, 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_Returns201()
+    {
+        var (room, start) = NextSlot();
+        var booking = await CreateBooking(room, start, 60);
+        await Send(HttpMethod.Delete, Url(booking), Alice);
+
+        var response = await CreateRaw(NewBooking(room, start, 60), key: Bob);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    // ---- чтение (FR-04) ----
+
+    [Fact]
+    public async Task Get_ReturnsBooking_ToAnyParticipant()
+    {
+        var (room, start) = NextSlot();
+        var created = await CreateBooking(room, start, 60);
+
+        var response = await Get(Url(created), Bob);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await Json(response);
+        AssertBooking(booking, room, start, 60, "alice");
+        Assert.Equal(IdOf(created), IdOf(booking));
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Get($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401()
+    {
+        var response = await Get($"/api/v1/bookings/{Guid.NewGuid()}", key: null);
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // ---- лента (FR-02) ----
+
+    [Fact]
+    public async Task List_FiltersByRoomAndPeriod_AscendingByStart()
+    {
+        var (room, start) = NextSlot();
+        var second = await CreateBooking(room, start.AddHours(1), 60);
+        var first = await CreateBooking(room, start, 60);
+        await CreateBooking(room, start.AddHours(3), 60);
+
+        var response = await Get($"/api/v1/bookings?roomId={room}&from={Iso(start)}&to={Iso(start.AddHours(2))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Json(response);
+        Assert.Equal([IdOf(first), IdOf(second)], page.GetProperty("items").EnumerateArray().Select(IdOf));
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_PeriodBoundaries_AreExclusive()
+    {
+        var (room, start) = NextSlot();
+        await CreateBooking(room, start, 60);
+
+        // from == endsAt и to == startsAt - бронь в период не попадает
+        var afterEnd = await Json(await Get($"/api/v1/bookings?roomId={room}&from={Iso(start.AddMinutes(60))}&to={Iso(start.AddHours(2))}"));
+        var beforeStart = await Json(await Get($"/api/v1/bookings?roomId={room}&from={Iso(start.AddHours(-1))}&to={Iso(start)}"));
+
+        Assert.Empty(ItemsOf(afterEnd));
+        Assert.Empty(ItemsOf(beforeStart));
+    }
+
+    [Fact]
+    public async Task List_IncludesCancelled()
+    {
+        var (room, start) = NextSlot();
+        var booking = await CreateBooking(room, start, 60);
+        await Send(HttpMethod.Delete, Url(booking), Alice);
+
+        var page = await Json(await Get($"/api/v1/bookings?roomId={room}&from={Iso(start)}&to={Iso(start.AddHours(1))}"));
+
+        var item = Assert.Single(page.GetProperty("items").EnumerateArray());
+        Assert.Equal("cancelled", item.GetProperty("status").GetString());
+    }
+
+    [Fact(Skip = SkipEmptyItems)]
