+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase(ApiFixture api)
+{
+    private static int _slotCounter;
+
+    protected const string Orion = "orion";
+    protected const string Vega = "vega";
+
+    protected HttpClient Alice { get; } = api.ClientFor(ApiFixture.AliceKey);
+    protected HttpClient Bob { get; } = api.ClientFor(ApiFixture.BobKey);
+    protected HttpClient Admin { get; } = api.ClientFor(ApiFixture.AdminKey);
+    protected HttpClient Anonymous { get; } = api.ClientFor(null);
+
+    /// <summary>
+    /// Свободное четырёхчасовое окно в будущем (в пределах 90 дней): тесты делят одну БД и не мешают друг другу.
+    /// </summary>
+    protected static DateTimeOffset NextSlot()
+    {
+        var n = Interlocked.Increment(ref _slotCounter);
+        var day = DateTimeOffset.UtcNow.Date.AddDays(1 + n / 6 % 80);
+        return new DateTimeOffset(day.AddHours(n % 6 * 4), TimeSpan.Zero);
+    }
+
+    protected static object NewBooking(DateTimeOffset startsAt, int durationMinutes = 60, string roomId = Orion,
+        string title = "Планирование", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes, comment };
+
+    protected static async Task<JsonElement> ReadJson(HttpResponseMessage response) =>
+        (await response.Content.ReadFromJsonAsync<JsonElement>()).Clone();
+
+    protected static async Task<JsonElement> CreateBooking(HttpClient client, object request)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", request);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJson(response);
+    }
+
+    protected static string IdOf(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    protected static string Url(JsonElement booking) => $"/api/v1/bookings/{IdOf(booking)}";
+
+    protected static async Task AssertProblem(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await ReadJson(response);
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.Equal(code, problem.GetProperty("code").GetString());
+        Assert.True(problem.TryGetProperty("title", out _));
+    }
+
+    protected static async Task AssertValidationProblem(HttpResponseMessage response, string field)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await ReadJson(response);
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        Assert.True(problem.GetProperty("errors").TryGetProperty(field, out var messages), $"нет ошибок по полю {field}");
+        Assert.NotEmpty(messages.EnumerateArray());
+    }
+}
