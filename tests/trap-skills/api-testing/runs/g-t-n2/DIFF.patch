@@ -0,0 +1,612 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-03..FR-12: создание, чтение, перенос, отмена и лента броней.</summary>
+public class BookingsTests(ApiFixture api) : ApiTestBase(api)
+{
+    private const string EndsAtDefect = "endsAt = startsAt + durationMinutes; сервис считает по целым часам (90 мин -> 1 ч)";
+    private const string LocationDefect = "201 содержит заголовок Location; сервис его не отдаёт";
+    private const string OverlapDefect = "409 application/problem+json с code booking-overlap; сервис отдаёт application/json {\"error\":\"overlap\"}";
+    private const string VersionDefect = "перенос с устаревшей версией - 409 version-conflict; сервис версию не проверяет и переносит";
+    private const string NotOwnerDefect = "перенос чужой брони участником - 403 not-owner; сервис переносит";
+    private const string RepeatCancelDefect = "повторная отмена - 204 (FR-11); сервис отвечает 500";
+    private const string EmptyItemsDefect = "пустой результат - items: []; сервис отдаёт items: null";
+    private const string LimitDefect = "limit вне 1..100 - 400; сервис отвечает 200";
+
+    // --- создание ---
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithBooking()
+    {
+        var slot = NextSlot();
+
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(slot, 60, Orion, "Ретро", "Принесите ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJson(response);
+        Assert.True(Guid.TryParse(IdOf(booking), out _));
+        Assert.Equal(Orion, booking.GetProperty("roomId").GetString());
+        Assert.Equal("Ретро", booking.GetProperty("title").GetString());
+        Assert.Equal("Принесите ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(slot, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(slot.AddHours(1), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+        Assert.True(booking.GetProperty("version").GetInt64() >= 0);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var booking = await CreateBooking(Alice, NewBooking(NextSlot()));
+
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [KnownDefectFact(EndsAtDefect)]
+    public async Task Create_NinetyMinutes_EndsAtIsStartPlusDuration()
+    {
+        var slot = NextSlot();
+
+        var booking = await CreateBooking(Alice, NewBooking(slot, 90));
+
+        Assert.Equal(slot.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [KnownDefectFact(LocationDefect)]
+    public async Task Create_Valid_ReturnsLocationOfBooking()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot()));
+
+        var booking = await ReadJson(response);
+        Assert.NotNull(response.Headers.Location);
+        Assert.EndsWith($"/api/v1/bookings/{IdOf(booking)}", response.Headers.Location!.ToString());
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBookings_AreAllowed()
+    {
+        var slot = NextSlot();
+        await CreateBooking(Alice, NewBooking(slot, 60));
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking(slot.AddHours(1), 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_IsAllowed()
+    {
+        var slot = NextSlot();
+        await CreateBooking(Alice, NewBooking(slot, 60, Orion));
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking(slot, 60, Vega));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverlapWithActive_Returns409()
+    {
+        var slot = NextSlot();
+        await CreateBooking(Alice, NewBooking(slot, 60));
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking(slot.AddMinutes(30), 60));
+
+        Assert.Equal(HttpStatusCode.Conflict, response.StatusCode);
+    }
+
+    [KnownDefectFact(OverlapDefect)]
+    public async Task Create_OverlapWithActive_ReturnsProblemBookingOverlap()
+    {
+        var slot = NextSlot();
+        await CreateBooking(Alice, NewBooking(slot, 60));
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking(slot.AddMinutes(30), 60));
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_IsAllowed()
+    {
+        var slot = NextSlot();
+        var first = await CreateBooking(Alice, NewBooking(slot, 60));
+        Assert.Equal(HttpStatusCode.NoContent, (await Alice.DeleteAsync(Url(first))).StatusCode);
+
+        var response = await Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking(slot, 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), 60, "no-such-room"));
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_StartInPast_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(DateTimeOffset.UtcNow.AddHours(-1)));
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(DateTimeOffset.UtcNow.AddDays(91)));
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartWithin90Days_IsAllowed()
+    {
+        var start = new DateTimeOffset(DateTimeOffset.UtcNow.Date.AddDays(89).AddHours(20), TimeSpan.Zero);
+
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(start, 60, Vega));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), minutes));
+
+        await AssertValidationProblem(response, "durationMinutes");
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_BoundaryDuration_IsAllowed(int minutes)
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), minutes));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("   ")]
+    public async Task Create_BlankTitle_Returns400(string title)
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), 60, Orion, title));
+
+        await AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf121Chars_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), 60, Orion, new string('т', 121)));
+
+        await AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf120Chars_IsAllowed()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), 60, Orion, new string('т', 120)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_CommentOf501Chars_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), 60, Orion, comment: new string('к', 501)));
+
+        await AssertValidationProblem(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_CommentOf500Chars_IsAllowed()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot(), 60, Orion, comment: new string('к', 500)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_EmptyObject_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", new { });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401()
+    {
+        var response = await Anonymous.PostAsJsonAsync("/api/v1/bookings", NewBooking(NextSlot()));
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- чтение ---
+
+    [Fact]
+    public async Task Get_ByAnotherMember_ReturnsBooking()
+    {
+        var created = await CreateBooking(Alice, NewBooking(NextSlot()));
+
+        var response = await Bob.GetAsync(Url(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadJson(response);
+        Assert.Equal(IdOf(created), IdOf(booking));
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Alice.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401()
+    {
+        var response = await Anonymous.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- перенос ---
+
+    private static object Reschedule(DateTimeOffset startsAt, int durationMinutes, long version) =>
+        new { startsAt, durationMinutes, version };
+
+    [Fact]
+    public async Task Reschedule_ByOwner_Returns200WithNewTimeAndVersion()
+    {
+        var slot = NextSlot();
+        var created = await CreateBooking(Alice, NewBooking(slot, 60));
+        var version = created.GetProperty("version").GetInt64();
+
+        var response = await Alice.PatchAsJsonAsync(Url(created), Reschedule(slot.AddHours(2), 120, version));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadJson(response);
+        Assert.Equal(IdOf(created), IdOf(booking));
+        Assert.Equal(slot.AddHours(2), booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(120, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(slot.AddHours(4), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.NotEqual(version, booking.GetProperty("version").GetInt64());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Reschedule_ByAdmin_Returns200()
+    {
+        var slot = NextSlot();
+        var created = await CreateBooking(Alice, NewBooking(slot, 60));
+
+        var response = await Admin.PatchAsJsonAsync(Url(created), Reschedule(slot.AddHours(1), 60, created.GetProperty("version").GetInt64()));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [KnownDefectFact(NotOwnerDefect)]
+    public async Task Reschedule_ByAnotherMember_Returns403NotOwner()
+    {
+        var slot = NextSlot();
+        var created = await CreateBooking(Alice, NewBooking(slot, 60));
+
+        var response = await Bob.PatchAsJsonAsync(Url(created), Reschedule(slot.AddHours(1), 60, created.GetProperty("version").GetInt64()));
+
+        await AssertProblem(response, HttpStatusCode.Forbidden, "not-owner");
+    }
+
+    [KnownDefectFact(VersionDefect)]
