+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Testcontainers.PostgreSql;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
+
+/// <summary>Сервис на реальном PostgreSQL: ограничение на пересечение броней живёт в БД.</summary>
+public sealed class ApiFixture : WebApplicationFactory<Program>, IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private static readonly DateTimeOffset SlotsStart = new DateTimeOffset(DateTime.UtcNow.Date, TimeSpan.Zero).AddDays(1);
+    private static readonly TimeSpan SlotLength = TimeSpan.FromHours(4);
+    private const int MaxSlots = 88 * 6;
+    private int _nextSlot = -1;
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+
+    public async Task InitializeAsync() => await _postgres.StartAsync();
+
+    async Task IAsyncLifetime.DisposeAsync() => await _postgres.DisposeAsync();
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+        builder.ConfigureAppConfiguration(config => config.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["ConnectionStrings:Bookings"] = _postgres.GetConnectionString(),
+            ["Database:Initialize"] = "true",
+            ["Auth:Keys:0:Key"] = AliceKey,
+            ["Auth:Keys:0:UserId"] = "alice",
+            ["Auth:Keys:0:Role"] = "member",
+            ["Auth:Keys:1:Key"] = BobKey,
+            ["Auth:Keys:1:UserId"] = "bob",
+            ["Auth:Keys:1:Role"] = "member",
+            ["Auth:Keys:2:Key"] = AdminKey,
+            ["Auth:Keys:2:UserId"] = "admin",
+            ["Auth:Keys:2:Role"] = "admin",
+        }));
+    }
+
+    public HttpClient ClientFor(string? key)
+    {
+        var client = CreateClient();
+        if (key is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", key);
+        return client;
+    }
+
+    /// <summary>
+    /// Свободные 4-часовые окна комнаты orion в пределах 90 дней: база общая на все тесты,
+    /// поэтому каждый тест берёт свои окна, и брони разных тестов не пересекаются.
+    /// Подряд выданные окна идут впритык друг к другу.
+    /// </summary>
+    public DateTimeOffset[] TakeSlots(int count)
+    {
+        var last = Interlocked.Add(ref _nextSlot, count);
+        if (last >= MaxSlots)
+            throw new InvalidOperationException("Закончились окна для тестовых броней.");
+        return Enumerable.Range(last - count + 1, count).Select(i => SlotsStart + i * SlotLength).ToArray();
+    }
+
+    public DateTimeOffset TakeSlot() => TakeSlots(1)[0];
+}
