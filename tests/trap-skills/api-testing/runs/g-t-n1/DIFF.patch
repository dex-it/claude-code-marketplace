+    {
+        var response = await _alice.GetAsync("/api/v1/rooms");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Api.Body(response);
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+        var ids = page.GetProperty("items").EnumerateArray().Select(r => r.GetProperty("id").GetString()!).ToArray();
+        Assert.Equal(["lyra", "orion", "vega"], ids);
+    }
+
+    [Fact]
+    public async Task ListRooms_ItemHasContractFields()
+    {
+        var page = await Api.Body(await _alice.GetAsync("/api/v1/rooms"));
+
+        var orion = page.GetProperty("items").EnumerateArray().Single(r => r.GetProperty("id").GetString() == "orion");
+        Assert.Equal("Orion", orion.GetProperty("name").GetString());
+        Assert.Equal(8, orion.GetProperty("capacity").GetInt32());
+        Assert.Equal(3, orion.GetProperty("floor").GetInt32());
+        var features = orion.GetProperty("features").EnumerateArray().Select(f => f.GetString()!).ToArray();
+        Assert.Equal(["projector", "whiteboard"], features);
+    }
+
+    [Fact]
+    public async Task ListRooms_LimitAndOffset_CutPageAndKeepTotal()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms?limit=1&offset=1");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Api.Body(response);
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+        var item = Assert.Single(page.GetProperty("items").EnumerateArray());
+        Assert.Equal("orion", item.GetProperty("id").GetString());
+    }
+
+    [Fact]
+    public async Task ListRooms_OffsetBeyondEnd_ReturnsEmptyItems()
+    {
+        var page = await Api.Body(await _alice.GetAsync("/api/v1/rooms?offset=50"));
+
+        Assert.Equal(JsonValueKind.Array, page.GetProperty("items").ValueKind);
+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("offset=-1", "offset")]
+    public async Task ListRooms_InvalidPaging_Returns400(string query, string field)
+    {
+        var response = await _alice.GetAsync($"/api/v1/rooms?{query}");
+
+        await Asserts.Validation(response, field);
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("unknown-key")]
+    public async Task ListRooms_WithoutValidKey_Returns401(string? key)
+    {
+        var response = await api.ClientFor(key).GetAsync("/api/v1/rooms");
+
+        await Asserts.Problem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task GetRoom_ReturnsRoom()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms/vega");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var room = await Api.Body(response);
+        Assert.Equal("vega", room.GetProperty("id").GetString());
+        Assert.Equal("Vega", room.GetProperty("name").GetString());
+        Assert.Equal(4, room.GetProperty("capacity").GetInt32());
+        Assert.Equal(3, room.GetProperty("floor").GetInt32());
+        Assert.Equal("whiteboard", Assert.Single(room.GetProperty("features").EnumerateArray()).GetString());
+    }
+
+    [Fact]
+    public async Task GetRoom_Unknown_Returns404RoomNotFound()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms/no-such-room");
+
+        await Asserts.Problem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task GetRoom_WithoutKey_Returns401()
+    {
+        var response = await api.ClientFor(null).GetAsync("/api/v1/rooms/orion");
+
+        await Asserts.Problem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_ReturnsActiveAndCancelledAscendingByStart()
+    {
+        var slots = api.TakeSlots(3);
+        var later = await Api.CreateOk(_alice, slots[2].AddHours(1), 60);
+        var earlier = await Api.CreateOk(_alice, slots[0], 60);
+        var cancelled = await Api.CreateOk(_alice, slots[1], 60);
+        Assert.Equal(HttpStatusCode.NoContent, (await _alice.DeleteAsync($"/api/v1/bookings/{Api.Id(cancelled)}")).StatusCode);
