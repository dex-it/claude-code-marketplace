+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_RoomFilter_ReturnsOnlyThatRoom()
+    {
+        var slot = api.TakeSlot();
+        var inOrion = await Api.CreateOk(_alice, slot, 60);
+        var inVega = await Api.CreateOk(_alice, slot, 60, roomId: "vega");
+        var from = Uri.EscapeDataString(Api.Iso(slot));
+        var to = Uri.EscapeDataString(Api.Iso(slot.AddHours(2)));
+
+        var vega = await Api.Body(await _alice.GetAsync($"/api/v1/bookings?roomId=vega&from={from}&to={to}"));
+        var all = await Api.Body(await _alice.GetAsync($"/api/v1/bookings?from={from}&to={to}"));
+
+        Assert.Equal(Api.Id(inVega), Api.Id(Assert.Single(vega.GetProperty("items").EnumerateArray())));
+        var allIds = all.GetProperty("items").EnumerateArray().Select(Api.Id).ToArray();
+        Assert.Contains(Api.Id(inOrion), allIds);
+        Assert.Contains(Api.Id(inVega), allIds);
+    }
+
+    [Fact]
+    public async Task List_PeriodBoundaries_FromIsExclusiveOfEndAndToOfStart()
+    {
+        var slot = api.TakeSlot();
+        var booking = await Api.CreateOk(_alice, slot, 60);
+
+        var endingAtFrom = await Api.Body(await _alice.GetAsync(Query(slot.AddMinutes(60), slot.AddHours(2))));
+        var startingAtTo = await Api.Body(await _alice.GetAsync(Query(slot.AddHours(-1), slot)));
+        var touching = await Api.Body(await _alice.GetAsync(Query(slot.AddMinutes(30), slot.AddMinutes(45))));
+
+        Assert.Empty(ItemsOrEmpty(endingAtFrom));
+        Assert.Empty(ItemsOrEmpty(startingAtTo));
+        Assert.Equal(Api.Id(booking), Api.Id(Assert.Single(touching.GetProperty("items").EnumerateArray())));
+    }
+
+    private static JsonElement[] ItemsOrEmpty(JsonElement page) =>
+        page.GetProperty("items") is { ValueKind: JsonValueKind.Array } items ? items.EnumerateArray().ToArray() : [];
+
+    [Theory(Skip = Defects.LimitNotValidated)]
