+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Api.Body(response);
+        var items = page.GetProperty("items").EnumerateArray().ToArray();
+        Assert.Equal([Api.Id(first), Api.Id(second), Api.Id(third)], items.Select(Api.Id).ToArray());
+        Assert.Equal(["active", "cancelled", "active"], items.Select(b => b.GetProperty("status").GetString()!).ToArray());
+        Assert.All(items, Asserts.Booking);
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_FollowingNextCursor_WalksAllPagesWithoutRepeats()
+    {
+        var slots = api.TakeSlots(5);
+        var expected = new List<string>();
+        foreach (var slot in slots)
+            expected.Add(Api.Id(await Api.CreateOk(_alice, slot, 60)));
+        var window = Query(slots[0], slots[4].AddHours(2), "&limit=2");
+
+        var seen = new List<string>();
+        var pages = 0;
+        string? cursor = null;
+        do
+        {
+            var url = cursor is null ? window : $"{window}&cursor={Uri.EscapeDataString(cursor)}";
+            var response = await _alice.GetAsync(url);
+            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+            var page = await Api.Body(response);
+            var items = page.GetProperty("items").EnumerateArray().ToArray();
+            Assert.InRange(items.Length, 1, 2);
+            seen.AddRange(items.Select(Api.Id));
+            var next = page.GetProperty("nextCursor");
+            cursor = next.ValueKind == JsonValueKind.Null ? null : next.GetString();
+            pages++;
+        } while (cursor is not null && pages < 10);
+
+        Assert.Equal(3, pages);
+        Assert.Equal(expected, seen);
+    }
+
+    [Fact]
+    public async Task List_ExactlyLimitItemsLeft_NextCursorIsNull()
+    {
+        var slots = api.TakeSlots(2);
+        await Api.CreateOk(_alice, slots[0], 60);
