+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingsTests(ApiFixture api)
+{
+    private readonly HttpClient _alice = api.ClientFor(ApiFixture.AliceKey);
+    private readonly HttpClient _bob = api.ClientFor(ApiFixture.BobKey);
+    private readonly HttpClient _admin = api.ClientFor(ApiFixture.AdminKey);
+
+    // ---- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_ReturnsCreatedBookingOfCaller()
+    {
+        var start = api.TakeSlot();
+
+        var response = await Api.Create(_alice, start, 60, comment: "Принести маркеры");
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await Api.Body(response);
+        Asserts.Booking(booking);
+        Assert.Equal(Api.Room, booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести маркеры", booking.GetProperty("comment").GetString());
+        Assert.Equal(start, Api.Time(booking, "startsAt"));
+        Assert.Equal(60, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(start.AddMinutes(60), Api.Time(booking, "endsAt"));
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact(Skip = Defects.NoLocationHeader)]
+    public async Task Create_ReturnsLocationOfCreatedBooking()
+    {
+        var response = await Api.Create(_alice, api.TakeSlot());
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await Api.Body(response);
+        Assert.Equal($"/api/v1/bookings/{Api.Id(booking)}", response.Headers.Location?.ToString());
+    }
+
+    [Theory]
+    [InlineData(60)]
+    [InlineData(240)]
+    public async Task Create_WholeHours_EndsAtIsStartPlusDuration(int durationMinutes)
+    {
+        var start = api.TakeSlot();
+
+        var booking = await Api.CreateOk(_alice, start, durationMinutes);
+
+        Assert.Equal(start.AddMinutes(durationMinutes), Api.Time(booking, "endsAt"));
+    }
+
+    [Theory(Skip = Defects.EndsAtWholeHours)]
+    [InlineData(15)]
+    [InlineData(90)]
+    public async Task Create_EndsAtIsStartPlusDuration(int durationMinutes)
+    {
+        var start = api.TakeSlot();
+
+        var booking = await Api.CreateOk(_alice, start, durationMinutes);
+
+        Assert.Equal(durationMinutes, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(start.AddMinutes(durationMinutes), Api.Time(booking, "endsAt"));
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var response = await _alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = Api.Room,
+            title = "Без комментария",
+            startsAt = Api.Iso(api.TakeSlot()),
+            durationMinutes = 30,
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal(JsonValueKind.Null, (await Api.Body(response)).GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_StartInThePast_Returns400()
+    {
+        var response = await Api.Create(_alice, DateTimeOffset.UtcNow.AddMinutes(-30));
+
+        await Asserts.Validation(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await Api.Create(_alice, DateTimeOffset.UtcNow.AddDays(91));
+
+        await Asserts.Validation(response, "startsAt");
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(480)]
+    public async Task Create_InvalidDuration_Returns400(int durationMinutes)
+    {
+        var response = await Api.Create(_alice, api.TakeSlot(), durationMinutes);
+
+        await Asserts.Validation(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_EmptyTitle_Returns400()
+    {
+        var response = await Api.Create(_alice, api.TakeSlot(), title: "");
+
+        await Asserts.Validation(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleLongerThan120_Returns400()
+    {
+        var response = await Api.Create(_alice, api.TakeSlot(), title: new string('я', 121));
+
+        await Asserts.Validation(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_CommentLongerThan500_Returns400()
+    {
+        var response = await Api.Create(_alice, api.TakeSlot(), comment: new string('x', 501));
+
+        await Asserts.Validation(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_TitleAndCommentAtLimit_Returns201()
+    {
+        var response = await Api.Create(_alice, api.TakeSlot(), title: new string('я', 120), comment: new string('x', 500));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_EmptyRoomId_Returns400()
+    {
+        var response = await Api.Create(_alice, api.TakeSlot(), roomId: "");
+
+        await Asserts.Validation(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await Api.Create(_alice, api.TakeSlot(), roomId: "no-such-room");
+
+        await Asserts.Problem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact(Skip = Defects.OverlapNotProblem)]
+    public async Task Create_OverlapsActiveBooking_Returns409BookingOverlap()
+    {
+        var start = api.TakeSlot();
+        await Api.CreateOk(_alice, start, 60);
+
+        var response = await Api.Create(_bob, start.AddMinutes(30), 60);
+
+        await Asserts.Problem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentToActiveBooking_Returns201()
+    {
+        var start = api.TakeSlot();
+        await Api.CreateOk(_alice, start, 60);
+
+        var response = await Api.Create(_bob, start.AddMinutes(60), 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInOtherRoom_Returns201()
+    {
+        var start = api.TakeSlot();
+        await Api.CreateOk(_alice, start, 60);
+
+        var response = await Api.Create(_bob, start, 60, roomId: "vega");
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_Returns201()
+    {
+        var start = api.TakeSlot();
+        var first = await Api.CreateOk(_alice, start, 60);
+        await _alice.DeleteAsync($"/api/v1/bookings/{Api.Id(first)}");
+
+        var response = await Api.Create(_bob, start, 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401()
+    {
+        var response = await Api.Create(api.ClientFor(null), api.TakeSlot());
+
+        await Asserts.Problem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // ---- GET /api/v1/bookings/{bookingId}
+
+    [Fact]
+    public async Task Get_ReturnsBooking()
+    {
+        var created = await Api.CreateOk(_alice, api.TakeSlot(), 45);
+
+        var response = await _alice.GetAsync($"/api/v1/bookings/{Api.Id(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await Api.Body(response);
+        Asserts.Booking(booking);
+        Assert.Equal(Api.Id(created), Api.Id(booking));
+        Assert.Equal(Api.Time(created, "startsAt"), Api.Time(booking, "startsAt"));
+        Assert.Equal(Api.Version(created), Api.Version(booking));
+    }
+
+    [Fact]
+    public async Task Get_OtherMembersBooking_IsVisible()
+    {
+        var created = await Api.CreateOk(_alice, api.TakeSlot());
+
+        var response = await _bob.GetAsync($"/api/v1/bookings/{Api.Id(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("alice", (await Api.Body(response)).GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await _alice.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await Asserts.Problem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401()
+    {
+        var response = await api.ClientFor(null).GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await Asserts.Problem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // ---- PATCH /api/v1/bookings/{bookingId}
+
+    [Fact]
+    public async Task Reschedule_ByOwner_MovesBooking()
+    {
+        var slots = api.TakeSlots(2);
+        var created = await Api.CreateOk(_alice, slots[0], 60);
+
+        var response = await Api.Reschedule(_alice, Api.Id(created), slots[1].AddMinutes(30), 120, Api.Version(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await Api.Body(response);
+        Asserts.Booking(booking);
+        Assert.Equal(Api.Id(created), Api.Id(booking));
+        Assert.Equal(slots[1].AddMinutes(30), Api.Time(booking, "startsAt"));
+        Assert.Equal(120, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(slots[1].AddMinutes(150), Api.Time(booking, "endsAt"));
+        Assert.NotEqual(Api.Version(created), Api.Version(booking));
+    }
+
+    [Fact(Skip = Defects.EndsAtWholeHours)]
+    public async Task Reschedule_EndsAtIsStartPlusDuration()
+    {
+        var slots = api.TakeSlots(2);
+        var created = await Api.CreateOk(_alice, slots[0], 60);
+
+        var response = await Api.Reschedule(_alice, Api.Id(created), slots[1], 90, Api.Version(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(slots[1].AddMinutes(90), Api.Time(await Api.Body(response), "endsAt"));
+    }
+
+    [Fact]
+    public async Task Reschedule_ByAdmin_MovesBooking()
+    {
+        var slots = api.TakeSlots(2);
+        var created = await Api.CreateOk(_alice, slots[0], 60);
+
+        var response = await Api.Reschedule(_admin, Api.Id(created), slots[1], 60, Api.Version(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("alice", (await Api.Body(response)).GetProperty("ownerId").GetString());
+    }
+
+    [Fact(Skip = Defects.RescheduleNoOwnerCheck)]
+    public async Task Reschedule_ByOtherMember_Returns403NotOwner()
+    {
+        var slots = api.TakeSlots(2);
+        var created = await Api.CreateOk(_alice, slots[0], 60);
+
+        var response = await Api.Reschedule(_bob, Api.Id(created), slots[1], 60, Api.Version(created));
