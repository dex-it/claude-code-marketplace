+using System.Net;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public static class Asserts
+{
+    public static async Task Problem(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await Api.Body(response);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        Assert.True(body.TryGetProperty("type", out _));
+        Assert.True(body.TryGetProperty("title", out _));
+    }
+
+    public static async Task Validation(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await Api.Body(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        var errors = body.GetProperty("errors");
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"нет ошибки по полю {field}: {errors}");
+            Assert.Equal(JsonValueKind.Array, messages.ValueKind);
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+
+    public static void Booking(JsonElement booking)
+    {
+        foreach (var name in new[]
+                 {
+                     "id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status",
+                     "version",
+                 })
+            Assert.True(booking.TryGetProperty(name, out _), $"в брони нет поля {name}");
+
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.Equal(JsonValueKind.Number, booking.GetProperty("version").ValueKind);
+    }
+}
