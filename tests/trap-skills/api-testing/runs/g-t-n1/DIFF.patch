+
+    [Fact]
+    public async Task ListRoomBookings_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms/no-such-room/bookings");
+
+        await Asserts.Problem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_MalformedFrom_Returns400()
+    {
+        var response = await _alice.GetAsync($"/api/v1/rooms/{Api.Room}/bookings?from=yesterday");
+
+        await Asserts.Validation(response, "from");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_WithoutKey_Returns401()
+    {
+        var response = await api.ClientFor(null).GetAsync($"/api/v1/rooms/{Api.Room}/bookings");
+
+        await Asserts.Problem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
