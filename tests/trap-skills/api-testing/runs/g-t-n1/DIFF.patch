+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Известные расхождения реализации с контрактом 1.2.0 (перечислены в описании MR).
+/// Тесты с этими причинами пропущены, чтобы набор оставался зелёным; после исправления сервиса
+/// пропуск снимают - проверка уже написана по контракту.
+/// </summary>
+public static class Defects
+{
+    public const string NoLocationHeader =
+        "Расхождение: POST /api/v1/bookings 201 без заголовка Location (контракт: обязателен).";
+
+    public const string EndsAtWholeHours =
+        "Расхождение: endsAt = startsAt + durationMinutes / 60 часов, минуты теряются (15 мин -> +0, 90 мин -> +1 ч).";
+
+    public const string OverlapNotProblem =
+        "Расхождение: 409 при пересечении отдаётся как application/json {\"error\":\"overlap\"}, а не problem+json с code booking-overlap.";
+
+    public const string VersionIgnored =
+        "Расхождение: PATCH не сверяет version, устаревшая версия принимается (контракт: 409 version-conflict).";
+
+    public const string RescheduleNoOwnerCheck =
+        "Расхождение: PATCH чужой брони выполняется (контракт: 403 not-owner).";
+
+    public const string RepeatedCancelFails =
+        "Расхождение: повторная DELETE отменённой брони даёт 500 (контракт и FR-11: 204).";
+
+    public const string EmptyItemsIsNull =
+        "Расхождение: GET /api/v1/bookings без результатов отдаёт items: null (контракт: items: []).";
+
+    public const string LimitNotValidated =
+        "Расхождение: GET /api/v1/bookings принимает limit вне 1..100 (контракт: 400).";
+}
