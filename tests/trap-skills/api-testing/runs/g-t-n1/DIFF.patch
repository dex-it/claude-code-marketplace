+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public static class Api
+{
+    public const string Room = "orion";
+
+    public static string Iso(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ");
+
+    public static Task<HttpResponseMessage> Create(
+        HttpClient client, DateTimeOffset startsAt, int durationMinutes = 60, string roomId = Room,
+        string title = "Планирование спринта", string? comment = null) =>
+        client.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId,
+            title,
+            startsAt = Iso(startsAt),
+            durationMinutes,
+            comment,
+        });
+
+    public static async Task<JsonElement> CreateOk(
+        HttpClient client, DateTimeOffset startsAt, int durationMinutes = 60, string roomId = Room)
+    {
+        var response = await Create(client, startsAt, durationMinutes, roomId);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await Body(response);
+    }
+
+    public static Task<HttpResponseMessage> Reschedule(
+        HttpClient client, string id, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{id}", new { startsAt = Iso(startsAt), durationMinutes, version });
+
+    public static async Task<JsonElement> Body(HttpResponseMessage response)
+    {
+        using var stream = await response.Content.ReadAsStreamAsync();
+        return (await JsonDocument.ParseAsync(stream)).RootElement.Clone();
+    }
+
+    public static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    public static long Version(JsonElement booking) => booking.GetProperty("version").GetInt64();
+
+    public static DateTimeOffset Time(JsonElement booking, string property) =>
+        booking.GetProperty(property).GetDateTimeOffset();
+}
