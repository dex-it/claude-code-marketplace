+
+        Assert.Equal(3, body.GetProperty("total").GetInt32());
+        var items = body.GetProperty("items").EnumerateArray().ToArray();
+        Assert.Single(items);
+        Assert.Equal("orion", items[0].GetProperty("id").GetString());
+    }
