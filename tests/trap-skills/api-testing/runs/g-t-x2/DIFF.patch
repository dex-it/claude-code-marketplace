+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsApiTests : ApiTestBase
+{
+    private static string IdOf(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    private static string[] Ids(JsonElement page) =>
+        page.GetProperty("items").EnumerateArray().Select(IdOf).ToArray();
+
+    // --- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_ReturnsBookingOwnedByCaller()
+    {
+        var startsAt = Now.AddDays(1);
+
+        var response = await Alice.PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking(title: "Спринт", startsAt: startsAt, durationMinutes: 60, comment: "заметка"), Json);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var body = await ReadJson(response);
+        Assert.True(Guid.TryParse(IdOf(body), out _));
+        Assert.Equal("orion", body.GetProperty("roomId").GetString());
+        Assert.Equal("Спринт", body.GetProperty("title").GetString());
+        Assert.Equal("заметка", body.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, body.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, body.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(60), body.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", body.GetProperty("ownerId").GetString());
+        Assert.Equal("active", body.GetProperty("status").GetString());
+        Assert.True(body.TryGetProperty("version", out var version) && version.ValueKind == JsonValueKind.Number);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var body = await Created(Alice, NewBooking());
+
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("comment").ValueKind);
+    }
+
+    [ContractDefectFact("POST /api/v1/bookings: endsAt считается по целым часам (AddHours(duration / 60)), для 90 минут - +1 час вместо +90 минут")]
+    public async Task Create_EndsAtIsStartPlusDuration()
+    {
+        var startsAt = Now.AddDays(1);
+
+        var body = await Created(Alice, NewBooking(startsAt: startsAt, durationMinutes: 90));
+
+        Assert.Equal(startsAt.AddMinutes(90), body.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [ContractDefectFact("POST /api/v1/bookings: в 201 нет заголовка Location")]
+    public async Task Create_ReturnsLocationOfCreatedBooking()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(), Json);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var id = IdOf(await ReadJson(response));
+        Assert.NotNull(response.Headers.Location);
+        Assert.Equal("/api/v1/bookings/" + id, response.Headers.Location!.ToString());
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_DurationBounds_AreAccepted(int minutes)
+    {
+        var body = await Created(Alice, NewBooking(durationMinutes: minutes));
+
+        Assert.Equal(minutes, body.GetProperty("durationMinutes").GetInt32());
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(300)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(durationMinutes: minutes), Json);
+
+        await AssertValidationProblem(response, "durationMinutes");
+    }
+
+    [Theory]
+    [InlineData(-1)]
+    [InlineData(0)]
+    public async Task Create_StartNotInFuture_Returns400(int offsetMinutes)
+    {
+        var response = await Alice.PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking(startsAt: Now.AddMinutes(offsetMinutes)), Json);
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking(startsAt: Now.AddDays(90).AddMinutes(1)), Json);
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartAt90Days_IsAccepted()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: Now.AddDays(90)), Json);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_EmptyTitle_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(title: ""), Json);
+
+        await AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleLongerThan120_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(title: new string('я', 121)), Json);
+
+        await AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_CommentLongerThan500_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(comment: new string('я', 501)), Json);
+
+        await AssertValidationProblem(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_EmptyRoomId_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId: ""), Json);
+
+        await AssertValidationProblem(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId: "nowhere"), Json);
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401()
+    {
+        using var anonymous = Factory.ClientFor(null);
+
+        var response = await anonymous.PostAsJsonAsync("/api/v1/bookings", NewBooking(), Json);
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // Расхождение найдено чтением кода (BookingsController.Overlap), без PostgreSQL не воспроизводится.
+    [ContractDefectFact("POST /api/v1/bookings: при пересечении 409 с телом {\"error\":\"overlap\"}, а не problem+json с code booking-overlap")]
+    public async Task Create_OverlapsActiveBooking_Returns409BookingOverlap()
+    {
+        using var pg = new PostgresScope();
+        await Created(pg.Alice, NewBooking(startsAt: Now.AddDays(1), durationMinutes: 60));
+
+        var response = await pg.Bob.PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking(startsAt: Now.AddDays(1).AddMinutes(30), durationMinutes: 60), Json);
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [PostgresFact]
+    public async Task Create_OverlapsCancelledBooking_IsAccepted()
+    {
+        using var pg = new PostgresScope();
+        var first = await Created(pg.Alice, NewBooking(startsAt: Now.AddDays(1), durationMinutes: 60));
+        await pg.Alice.DeleteAsync("/api/v1/bookings/" + IdOf(first));
+
+        var response = await pg.Bob.PostAsJsonAsync("/api/v1/bookings", NewBooking(startsAt: Now.AddDays(1), durationMinutes: 60), Json);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    // --- GET /api/v1/bookings/{bookingId}
+
+    [Fact]
+    public async Task Get_ReturnsBooking_ToAnyMember()
+    {
+        var created = await Created(Alice, NewBooking());
+
+        var response = await Bob.GetAsync("/api/v1/bookings/" + IdOf(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await ReadJson(response);
+        Assert.Equal(IdOf(created), IdOf(body));
+        Assert.Equal("alice", body.GetProperty("ownerId").GetString());
+        Assert.Equal(created.GetProperty("version").GetInt64(), body.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Alice.GetAsync("/api/v1/bookings/" + Guid.NewGuid());
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401()
+    {
+        using var anonymous = Factory.ClientFor(null);
+
+        var response = await anonymous.GetAsync("/api/v1/bookings/" + Guid.NewGuid());
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- GET /api/v1/bookings
+
+    [Fact]
+    public async Task List_ReturnsActiveAndCancelledAscendingByStart()
+    {
+        var late = await Created(Alice, NewBooking(startsAt: Now.AddDays(3)));
+        var early = await Created(Bob, NewBooking(roomId: "vega", startsAt: Now.AddDays(1)));
+        var cancelled = await Created(Alice, NewBooking(startsAt: Now.AddDays(2)));
+        await Alice.DeleteAsync("/api/v1/bookings/" + IdOf(cancelled));
+
+        var response = await Bob.GetAsync("/api/v1/bookings");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ReadJson(response);
+        Assert.Equal([IdOf(early), IdOf(cancelled), IdOf(late)], Ids(page));
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_RoomId_FiltersByRoom()
+    {
+        await Created(Alice, NewBooking(roomId: "orion"));
+        var vega = await Created(Alice, NewBooking(roomId: "vega"));
+
+        var page = await ReadJson(await Alice.GetAsync("/api/v1/bookings?roomId=vega"));
+
+        Assert.Equal([IdOf(vega)], Ids(page));
+    }
+
+    [Fact]
+    public async Task List_FromTo_FiltersByPeriod()
+    {
+        await Created(Alice, NewBooking(startsAt: Now.AddDays(1)));
+        var inside = await Created(Alice, NewBooking(startsAt: Now.AddDays(5)));
+        await Created(Alice, NewBooking(startsAt: Now.AddDays(9)));
+
+        var from = Uri.EscapeDataString(Now.AddDays(4).ToString("O"));
+        var to = Uri.EscapeDataString(Now.AddDays(6).ToString("O"));
+        var page = await ReadJson(await Alice.GetAsync($"/api/v1/bookings?from={from}&to={to}"));
+
+        Assert.Equal([IdOf(inside)], Ids(page));
+    }
+
+    [Fact]
+    public async Task List_CursorWalksAllPagesWithoutRepeats()
+    {
+        var expected = new List<string>();
+        for (var day = 1; day <= 5; day++)
+            expected.Add(IdOf(await Created(Alice, NewBooking(startsAt: Now.AddDays(day)))));
+
+        var seen = new List<string>();
+        string? cursor = null;
+        var pages = 0;
+        do
+        {
