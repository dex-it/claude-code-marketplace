+    /// <summary>Сервис поверх настоящего PostgreSQL (BOOKINGS_TEST_POSTGRES); схема и комнаты создаются при старте.</summary>
+    private sealed class PostgresScope : IDisposable
+    {
+        private readonly BookingsApiFactory _factory = new(PostgresFactAttribute.ConnectionString);
+
+        public PostgresScope()
+        {
+            Alice = _factory.ClientFor(BookingsApiFactory.Alice);
+            Bob = _factory.ClientFor(BookingsApiFactory.Bob);
