+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Тест описывает поведение по контракту, которого сервис пока не выполняет (список - в описании MR BKG-31).
+/// Пропущен, чтобы набор был зелёным; BOOKINGS_TEST_RUN_DEFECTS=1 запускает такие тесты (проверка исправления).
+/// </summary>
+public sealed class ContractDefectFactAttribute : FactAttribute
+{
+    public ContractDefectFactAttribute(string defect)
+    {
+        if (Environment.GetEnvironmentVariable("BOOKINGS_TEST_RUN_DEFECTS") != "1")
+            Skip = "Расхождение с контрактом: " + defect;
+    }
+}
+
+/// <summary>Нужен PostgreSQL (ограничение пересечений, rowversion): строка подключения - в BOOKINGS_TEST_POSTGRES.</summary>
+public sealed class PostgresFactAttribute : FactAttribute
+{
+    public const string Variable = "BOOKINGS_TEST_POSTGRES";
+
+    public PostgresFactAttribute()
+    {
+        if (string.IsNullOrEmpty(ConnectionString))
+            Skip = "Не задана переменная " + Variable;
+    }
+
+    public static string? ConnectionString => Environment.GetEnvironmentVariable(Variable);
+}
