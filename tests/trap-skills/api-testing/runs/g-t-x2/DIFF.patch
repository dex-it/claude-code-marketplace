@@ -0,0 +1,67 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public abstract class ApiTestBase : IDisposable
+{
+    protected static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    protected ApiTestBase(string? postgresConnectionString = null)
+    {
+        Factory = new BookingsApiFactory(postgresConnectionString);
+        Alice = Factory.ClientFor(BookingsApiFactory.Alice);
+        Bob = Factory.ClientFor(BookingsApiFactory.Bob);
+        Admin = Factory.ClientFor(BookingsApiFactory.Admin);
+    }
+
+    protected BookingsApiFactory Factory { get; }
+    protected HttpClient Alice { get; }
+    protected HttpClient Bob { get; }
+    protected HttpClient Admin { get; }
+
+    protected static DateTimeOffset Now => BookingsApiFactory.Now;
+
+    protected static object NewBooking(
+        string roomId = "orion", string title = "Планёрка", DateTimeOffset? startsAt = null, int durationMinutes = 60, string? comment = null) =>
+        new { roomId, title, startsAt = startsAt ?? Now.AddDays(1), durationMinutes, comment };
+
+    protected static async Task<JsonElement> ReadJson(HttpResponseMessage response) =>
+        await response.Content.ReadFromJsonAsync<JsonElement>(Json);
+
+    protected static async Task<JsonElement> Created(HttpClient client, object body)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", body, Json);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJson(response);
+    }
+
+    protected static async Task AssertProblem(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJson(response);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        Assert.True(body.TryGetProperty("title", out _));
+    }
+
+    protected static async Task AssertValidationProblem(HttpResponseMessage response, string field)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJson(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        Assert.True(body.GetProperty("errors").TryGetProperty(field, out var messages), "нет ошибки по полю " + field);
+        Assert.NotEmpty(messages.EnumerateArray());
+    }
+
+    public void Dispose()
+    {
+        Alice.Dispose();
+        Bob.Dispose();
+        Admin.Dispose();
+        Factory.Dispose();
+        GC.SuppressFinalize(this);
+    }
+}
