@@ -0,0 +1,90 @@
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.Extensions.Hosting;
+
+namespace Bookings.Api.Tests;
+
+public sealed class FixedTimeProvider(DateTimeOffset now) : TimeProvider
+{
+    public override DateTimeOffset GetUtcNow() => now;
+}
+
+/// <summary>
+/// Сервис в памяти: EF InMemory вместо PostgreSQL, фиксированное время, три комнаты и три ключа.
+/// InMemory не знает ограничения пересечений и rowversion - их проверяют тесты с <see cref="PostgresFactAttribute"/>,
+/// для них передаётся строка подключения и схему создаёт сам сервис.
+/// </summary>
+public sealed class BookingsApiFactory(string? postgresConnectionString = null) : WebApplicationFactory<Program>
+{
+    public const string Alice = "key-alice";
+    public const string Bob = "key-bob";
+    public const string Admin = "key-admin";
+
+    public static readonly DateTimeOffset Now = new(2026, 10, 11, 9, 0, 0, TimeSpan.Zero);
+
+    private readonly string _database = Guid.NewGuid().ToString();
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["Database:Initialize"] = (postgresConnectionString is not null).ToString(),
+            ["ConnectionStrings:Bookings"] = postgresConnectionString ?? "",
+            ["Auth:Keys:0:Key"] = Alice,
+            ["Auth:Keys:0:UserId"] = "alice",
+            ["Auth:Keys:0:Role"] = "member",
+            ["Auth:Keys:1:Key"] = Bob,
+            ["Auth:Keys:1:UserId"] = "bob",
+            ["Auth:Keys:1:Role"] = "member",
+            ["Auth:Keys:2:Key"] = Admin,
+            ["Auth:Keys:2:UserId"] = "admin",
+            ["Auth:Keys:2:Role"] = "admin",
+        }));
+
+        builder.ConfigureServices(services =>
+        {
+            services.RemoveAll<TimeProvider>();
+            services.AddSingleton<TimeProvider>(new FixedTimeProvider(Now));
+
+            if (postgresConnectionString is not null)
+                return;
+
+            services.RemoveAll<DbContextOptions<BookingsDbContext>>();
+            services.AddDbContext<BookingsDbContext>(o => o.UseInMemoryDatabase(_database));
+        });
+    }
+
+    protected override IHost CreateHost(IHostBuilder builder)
+    {
+        var host = base.CreateHost(builder);
+        if (postgresConnectionString is null)
+        {
+            using var scope = host.Services.CreateScope();
+            var db = scope.ServiceProvider.GetRequiredService<BookingsDbContext>();
+            var orion = new Room("orion", "Orion", 8, 3);
+            orion.Features.AddRange([RoomFeature.Projector, RoomFeature.Whiteboard]);
+            var vega = new Room("vega", "Vega", 4, 3);
+            vega.Features.Add(RoomFeature.Whiteboard);
+            var lyra = new Room("lyra", "Lyra", 12, 5);
+            lyra.Features.AddRange([RoomFeature.Projector, RoomFeature.Videoconf]);
+            db.Rooms.AddRange(orion, vega, lyra);
+            db.SaveChanges();
+        }
+
+        return host;
+    }
+
+    public HttpClient ClientFor(string? key)
+    {
+        var client = CreateClient();
+        if (key is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", key);
+        return client;
+    }
+}
