+using System.Net;
+using System.Net.Http.Json;
+using System.Text;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class CreateBookingTests(ApiFixture api)
+{
+    [Fact]
+    public async Task Create_returns_201_with_booking_owned_by_key_holder()
+    {
+        var slot = api.NextSlot();
+
+        var response = await api.Alice().PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = slot.RoomId, title = "Планирование спринта", startsAt = slot.At(9), durationMinutes = 60, comment = "Принести ноутбуки",
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await Contract.ReadObjectAsync(response);
+        Contract.Booking(booking, slot.RoomId, "alice", slot.At(9), 60);
+        Assert.Equal("Планирование спринта", (string?)booking["title"]);
+        Assert.Equal("Принести ноутбуки", (string?)booking["comment"]);
+    }
+
+    [Fact]
+    public async Task Create_without_comment_returns_null_comment()
+    {
+        var slot = api.NextSlot();
+
+        var booking = await api.CreateBookingAsync(api.Bob(), slot.RoomId, slot.At(9));
+
+        Assert.True(booking.ContainsKey("comment"));
+        Assert.Null(booking["comment"]);
+        Assert.Equal("bob", (string?)booking["ownerId"]);
+    }
+
+    [Fact(Skip = Divergences.Location)]
+    public async Task Create_returns_location_of_created_booking()
+    {
+        var slot = api.NextSlot();
+
+        var response = await api.Alice().PostAsJsonAsync("/api/v1/bookings",
+            new { roomId = slot.RoomId, title = "Встреча", startsAt = slot.At(9), durationMinutes = 60 });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var id = (string?)(await Contract.ReadObjectAsync(response))["id"];
+        Assert.Equal($"/api/v1/bookings/{id}", response.Headers.Location?.OriginalString);
+    }
+
+    [Theory(Skip = Divergences.EndsAt)]
+    [InlineData(15)]
+    [InlineData(45)]
+    [InlineData(90)]
+    [InlineData(240)]
+    public async Task Create_computes_ends_at_from_duration(int minutes)
+    {
+        var slot = api.NextSlot();
+
+        var booking = await api.CreateBookingAsync(api.Alice(), slot.RoomId, slot.At(9), minutes);
+
+        Assert.Equal(slot.At(9).AddMinutes(minutes), Contract.Utc(booking["endsAt"]));
+        Contract.Booking(booking, slot.RoomId, "alice", slot.At(9), minutes);
+    }
+
+    [Fact]
+    public async Task Create_accepts_start_given_with_offset_and_returns_utc()
+    {
+        var slot = api.NextSlot();
+        var local = slot.At(9).ToOffset(TimeSpan.FromHours(3)).ToString("O");
+
+        var response = await api.Alice().PostAsync("/api/v1/bookings", new StringContent(
+            $$"""{"roomId":"{{slot.RoomId}}","title":"Встреча","startsAt":"{{local}}","durationMinutes":60}""",
+            Encoding.UTF8, "application/json"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Contract.Booking(await Contract.ReadObjectAsync(response), slot.RoomId, "alice", slot.At(9), 60);
+    }
+
+    [Fact]
+    public async Task Create_is_visible_through_get_and_to_other_members()
+    {
+        var slot = api.NextSlot();
+        var created = await api.CreateBookingAsync(api.Alice(), slot.RoomId, slot.At(9));
+
+        var response = await api.Bob().GetAsync($"/api/v1/bookings/{created["id"]}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await Contract.ReadObjectAsync(response);
+        Contract.Booking(booking, slot.RoomId, "alice", slot.At(9), 60);
+        Assert.Equal((string?)created["id"], (string?)booking["id"]);
+        Assert.Equal((long)created["version"]!, (long)booking["version"]!);
+    }
+
+    [Fact]
+    public async Task Create_accepts_boundary_title_comment_and_duration()
+    {
+        var slot = api.NextSlot();
+
+        var booking = await api.CreateBookingAsync(
+            api.Alice(), slot.RoomId, slot.At(9, 15), 15, new string('т', 120), new string('к', 500));
+
+        Assert.Equal(120, ((string?)booking["title"])!.Length);
+        Assert.Equal(500, ((string?)booking["comment"])!.Length);
+    }
+
+    [Fact]
+    public async Task Create_accepts_start_just_inside_90_days()
+    {
+        var response = await api.Alice().PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "vega", title = "Далеко", startsAt = DateTimeOffset.UtcNow.AddDays(89).AddHours(23), durationMinutes = 15,
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_rejects_start_in_the_past()
+    {
+        var response = await api.Alice().PostAsJsonAsync("/api/v1/bookings",
+            new { roomId = "orion", title = "Вчера", startsAt = DateTimeOffset.UtcNow.AddHours(-1), durationMinutes = 60 });
+
+        await Contract.ValidationProblemAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_rejects_start_beyond_90_days()
+    {
