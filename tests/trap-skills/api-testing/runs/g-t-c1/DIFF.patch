@@ -0,0 +1,175 @@
+using System.Net;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class ListBookingsTests(ApiFixture api)
+{
+    [Fact]
+    public async Task Feed_is_ordered_by_start_and_includes_cancelled()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var late = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(15));
+        var early = await api.CreateBookingAsync(api.Bob(), slot.RoomId, slot.At(9));
+        var cancelled = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(12));
+        await alice.DeleteAsync($"/api/v1/bookings/{cancelled["id"]}");
+
+        var response = await api.Bob().GetAsync($"/api/v1/bookings?roomId={slot.RoomId}&from={slot.From}&to={slot.To}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Contract.ReadObjectAsync(response);
+        Assert.Equal([(string)early["id"]!, (string)cancelled["id"]!, (string)late["id"]!], Contract.Ids(page["items"]));
+        foreach (var item in page["items"]!.AsArray())
+            Contract.Booking(item);
+        Assert.Equal(["active", "cancelled", "active"], page["items"]!.AsArray().Select(b => (string)b!["status"]!).ToArray());
+        Assert.True(page.ContainsKey("nextCursor"));
+        Assert.Null(page["nextCursor"]);
+    }
+
+    [Fact(Skip = Divergences.EmptyFeed)]
+    public async Task Feed_without_matches_is_empty_items_and_null_cursor()
+    {
+        var slot = api.NextSlot();
+
+        var response = await api.Alice().GetAsync($"/api/v1/bookings?roomId={slot.RoomId}&from={slot.From}&to={slot.To}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Contract.ReadObjectAsync(response);
+        var items = Assert.IsType<System.Text.Json.Nodes.JsonArray>(page["items"]);
+        Assert.Empty(items);
+        Assert.True(page.ContainsKey("nextCursor"));
+        Assert.Null(page["nextCursor"]);
+    }
+
+    [Fact]
+    public async Task Feed_pages_with_cursor_until_next_cursor_is_null()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var ids = new List<string>();
+        for (var hour = 8; hour <= 16; hour += 2)
+            ids.Add((string)(await api.CreateBookingAsync(alice, slot.RoomId, slot.At(hour)))["id"]!);
+
+        var collected = new List<string>();
+        var pages = 0;
+        string? cursor = null;
+        do
+        {
+            var url = $"/api/v1/bookings?roomId={slot.RoomId}&from={slot.From}&to={slot.To}&limit=2"
+                + (cursor is null ? "" : $"&cursor={Uri.EscapeDataString(cursor)}");
+            var response = await alice.GetAsync(url);
+            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+            var page = await Contract.ReadObjectAsync(response);
+            var pageIds = Contract.Ids(page["items"]);
+            Assert.InRange(pageIds.Length, 1, 2);
+            collected.AddRange(pageIds);
+            cursor = (string?)page["nextCursor"];
+            pages++;
+        }
+        while (cursor is not null && pages < 10);
+
+        Assert.Equal(3, pages);
+        Assert.Equal(ids, collected);
+    }
+
+    [Fact]
+    public async Task Feed_full_last_page_has_null_cursor()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        await api.CreateBookingAsync(alice, slot.RoomId, slot.At(11));
+
+        var response = await alice.GetAsync($"/api/v1/bookings?roomId={slot.RoomId}&from={slot.From}&to={slot.To}&limit=2");
+
+        var page = await Contract.ReadObjectAsync(response);
+        Assert.Equal(2, page["items"]!.AsArray().Count);
+        Assert.Null(page["nextCursor"]);
+    }
+
+    [Fact]
+    public async Task Feed_filters_by_room()
+    {
+        var slot = api.NextSlot();
+        var otherRoom = slot.RoomId == "orion" ? "vega" : "orion";
+        var alice = api.Alice();
+        var inRoom = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        await api.CreateBookingAsync(alice, otherRoom, slot.At(9));
+
+        var response = await alice.GetAsync($"/api/v1/bookings?roomId={slot.RoomId}&from={slot.From}&to={slot.To}");
+
+        var page = await Contract.ReadObjectAsync(response);
+        Assert.Equal([(string)inRoom["id"]!], Contract.Ids(page["items"]));
+    }
+
+    [Fact]
+    public async Task Feed_without_room_covers_all_rooms()
+    {
+        var slot = api.NextSlot();
+        var otherRoom = slot.RoomId == "orion" ? "vega" : "orion";
+        var alice = api.Alice();
+        var first = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        var second = await api.CreateBookingAsync(alice, otherRoom, slot.At(10));
+
+        var response = await alice.GetAsync($"/api/v1/bookings?from={slot.From}&to={slot.To}");
+
+        var page = await Contract.ReadObjectAsync(response);
+        Assert.Equal([(string)first["id"]!, (string)second["id"]!], Contract.Ids(page["items"]));
+    }
+
+    [Fact]
+    public async Task Feed_period_takes_bookings_ending_after_from_and_starting_before_to()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        await api.CreateBookingAsync(alice, slot.RoomId, slot.At(8));
+        var noon = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(12));
+        await api.CreateBookingAsync(alice, slot.RoomId, slot.At(16));
+        var from = Uri.EscapeDataString(slot.At(12, 30).ToString("O"));
+        var to = Uri.EscapeDataString(slot.At(14).ToString("O"));
+
+        var response = await alice.GetAsync($"/api/v1/bookings?roomId={slot.RoomId}&from={from}&to={to}");
+
+        var page = await Contract.ReadObjectAsync(response);
+        Assert.Equal([(string)noon["id"]!], Contract.Ids(page["items"]));
+    }
+
+    [Theory(Skip = Divergences.FeedLimit)]
+    [InlineData("limit=0")]
+    [InlineData("limit=101")]
+    [InlineData("limit=-1")]
+    public async Task Feed_rejects_out_of_range_limit(string query)
+    {
+        var response = await api.Alice().GetAsync($"/api/v1/bookings?{query}");
+
+        await Contract.ValidationProblemAsync(response, "limit");
+    }
+
+    [Fact]
+    public async Task Feed_rejects_unparsable_cursor()
+    {
+        var response = await api.Alice().GetAsync("/api/v1/bookings?cursor=%21%21not-a-cursor%21%21");
+
+        await Contract.ValidationProblemAsync(response, "cursor");
+    }
+
+    [Theory]
+    [InlineData("from=yesterday")]
+    [InlineData("to=2026-13-45")]
+    [InlineData("limit=abc")]
+    public async Task Feed_rejects_malformed_query(string query)
+    {
+        var response = await api.Alice().GetAsync($"/api/v1/bookings?{query}");
+
+        await Contract.ValidationProblemAsync(response);
+    }
+
+    [Fact]
+    public async Task Feed_without_api_key_is_401_unauthorized()
+    {
+        var response = await api.Client(null).GetAsync("/api/v1/bookings");
+
+        await Contract.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
