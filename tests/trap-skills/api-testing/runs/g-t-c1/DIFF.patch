@@ -0,0 +1,35 @@
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Известные расхождения реализации с api/openapi.yaml 1.2.0, найденные тестами BKG-31. Тесты проверяют
+/// контракт и пропущены до исправления сервиса; снять Skip вместе с исправлением.
+/// </summary>
+public static class Divergences
+{
+    public const string EndsAt =
+        "Расхождение: endsAt = startsAt + durationMinutes/60 часов (целочисленно), для 15/45/90 минут неверно.";
+
+    public const string OverlapProblem =
+        "Расхождение: конфликт по времени - 409 application/json {\"error\":\"overlap\"}, а не problem+json с code booking-overlap.";
+
+    public const string Location =
+        "Расхождение: 201 на создание без заголовка Location.";
+
+    public const string VersionConflict =
+        "Расхождение: версия из запроса PATCH не сверяется, перенос по устаревшей версии выполняется (нет 409 version-conflict).";
+
+    public const string RescheduleOwner =
+        "Расхождение: PATCH не проверяет владельца, чужую бронь переносит любой участник (нет 403 not-owner).";
+
+    public const string RepeatedCancel =
+        "Расхождение: повторная отмена - 500 (исключение из Booking.Cancel), а не 204.";
+
+    public const string FeedLimit =
+        "Расхождение: limit в GET /bookings не проверяется (0, -1, 101 - не 400).";
+
+    public const string EmptyFeed =
+        "Расхождение: пустая лента - items: null, а не [].";
+
+    public const string RoomIdLength =
+        "Расхождение: roomId длиннее 64 символов - 404 room-not-found, а не 400.";
+}
