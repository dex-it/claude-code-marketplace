@@ -0,0 +1,97 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json.Nodes;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Testcontainers.PostgreSql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Сервис в памяти процесса поверх настоящего PostgreSQL (ограничение пересечения - exclusion constraint).</summary>
+public sealed class ApiFixture : WebApplicationFactory<Program>, IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private static readonly string[] SlotRooms = ["orion", "vega", "lyra"];
+
+    private readonly PostgreSqlContainer _db = new PostgreSqlBuilder("postgres:16-alpine").Build();
+
+    private int _slots;
+
+    Task IAsyncLifetime.InitializeAsync() => _db.StartAsync();
+
+    async Task IAsyncLifetime.DisposeAsync()
+    {
+        await DisposeAsync();
+        await _db.DisposeAsync();
+    }
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+        builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["ConnectionStrings:Bookings"] = _db.GetConnectionString(),
+            ["Database:Initialize"] = "true",
+            ["Auth:Keys:0:key"] = AliceKey,
+            ["Auth:Keys:0:userId"] = "alice",
+            ["Auth:Keys:0:role"] = "member",
+            ["Auth:Keys:1:key"] = BobKey,
+            ["Auth:Keys:1:userId"] = "bob",
+            ["Auth:Keys:1:role"] = "member",
+            ["Auth:Keys:2:key"] = AdminKey,
+            ["Auth:Keys:2:userId"] = "admin",
+            ["Auth:Keys:2:role"] = "admin",
+        }));
+    }
+
+    public HttpClient Client(string? apiKey)
+    {
+        var client = CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+
+    public HttpClient Alice() => Client(AliceKey);
+    public HttpClient Bob() => Client(BobKey);
+    public HttpClient Admin() => Client(AdminKey);
+
+    /// <summary>
+    /// Свободные сутки в одной из комнат: каждый тест работает в своём окне, поэтому тесты не мешают
+    /// друг другу в общей базе. Начало - в будущем и в пределах 90 дней.
+    /// </summary>
+    public Slot NextSlot()
+    {
+        var n = Interlocked.Increment(ref _slots) - 1;
+        var day = new DateTimeOffset(DateTime.UtcNow.Date, TimeSpan.Zero).AddDays(1 + n % 80);
+        return new Slot(SlotRooms[n / 80 % SlotRooms.Length], day);
+    }
+
+    public async Task<JsonObject> CreateBookingAsync(
+        HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60,
+        string title = "Встреча", string? comment = null)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", new { roomId, title, startsAt, durationMinutes, comment });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await Contract.ReadObjectAsync(response);
+    }
+}
+
+/// <summary>Сутки (UTC) в комнате, отведённые одному тесту.</summary>
+public sealed record Slot(string RoomId, DateTimeOffset Day)
+{
+    public DateTimeOffset At(int hour, int minute = 0) => Day.AddHours(hour).AddMinutes(minute);
+
+    public string From => Uri.EscapeDataString(Day.ToString("O"));
+    public string To => Uri.EscapeDataString(Day.AddDays(1).ToString("O"));
+}
+
+[CollectionDefinition(Name)]
+public sealed class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
