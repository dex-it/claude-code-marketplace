+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json.Nodes;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class RescheduleBookingTests(ApiFixture api)
+{
+    private static Task<HttpResponseMessage> PatchAsync(HttpClient client, object id, object body) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{id}", body);
+
+    [Fact]
+    public async Task Owner_reschedules_booking()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9), 60, "Ретро", "Кофе");
+
+        var response = await PatchAsync(alice, booking["id"]!,
+            new { startsAt = slot.At(13), durationMinutes = 120, version = (long)booking["version"]! });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var moved = await Contract.ReadObjectAsync(response);
+        Contract.Booking(moved, slot.RoomId, "alice", slot.At(13), 120);
+        Assert.Equal((string?)booking["id"], (string?)moved["id"]);
+        Assert.Equal("Ретро", (string?)moved["title"]);
+        Assert.Equal("Кофе", (string?)moved["comment"]);
+        Assert.Equal(slot.At(15), Contract.Utc(moved["endsAt"]));
+        Assert.NotEqual((long)booking["version"]!, (long)moved["version"]!);
+    }
+
+    [Fact]
+    public async Task Rescheduled_booking_is_persisted()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        var moved = await Contract.ReadObjectAsync(await PatchAsync(alice, booking["id"]!,
+            new { startsAt = slot.At(14), durationMinutes = 60, version = (long)booking["version"]! }));
+
+        var stored = await Contract.ReadObjectAsync(await api.Bob().GetAsync($"/api/v1/bookings/{booking["id"]}"));
+
+        Contract.Booking(stored, slot.RoomId, "alice", slot.At(14), 60);
+        Assert.Equal((long)moved["version"]!, (long)stored["version"]!);
+    }
+
+    [Fact(Skip = Divergences.EndsAt)]
+    public async Task Rescheduling_to_ninety_minutes_computes_ends_at()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+
+        var response = await PatchAsync(alice, booking["id"]!,
+            new { startsAt = slot.At(9), durationMinutes = 90, version = (long)booking["version"]! });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(slot.At(10, 30), Contract.Utc((await Contract.ReadObjectAsync(response))["endsAt"]));
+    }
+
+    [Fact]
+    public async Task Admin_reschedules_someone_elses_booking()
+    {
+        var slot = api.NextSlot();
+        var booking = await api.CreateBookingAsync(api.Alice(), slot.RoomId, slot.At(9));
+
+        var response = await PatchAsync(api.Admin(), booking["id"]!,
+            new { startsAt = slot.At(11), durationMinutes = 60, version = (long)booking["version"]! });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var moved = await Contract.ReadObjectAsync(response);
+        Contract.Booking(moved, slot.RoomId, "alice", slot.At(11), 60);
+    }
+
+    [Fact(Skip = Divergences.RescheduleOwner)]
+    public async Task Other_member_cannot_reschedule_is_403_not_owner()
+    {
+        var slot = api.NextSlot();
+        var booking = await api.CreateBookingAsync(api.Alice(), slot.RoomId, slot.At(9));
+
+        var response = await PatchAsync(api.Bob(), booking["id"]!,
+            new { startsAt = slot.At(11), durationMinutes = 60, version = (long)booking["version"]! });
+
+        await Contract.ProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+    }
+
+    [Fact(Skip = Divergences.VersionConflict)]
+    public async Task Stale_version_is_409_version_conflict()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        var staleVersion = (long)booking["version"]!;
+        var first = await PatchAsync(alice, booking["id"]!,
+            new { startsAt = slot.At(11), durationMinutes = 60, version = staleVersion });
+        Assert.Equal(HttpStatusCode.OK, first.StatusCode);
+
+        var second = await PatchAsync(alice, booking["id"]!,
+            new { startsAt = slot.At(13), durationMinutes = 60, version = staleVersion });
+
+        await Contract.ProblemAsync(second, HttpStatusCode.Conflict, "version-conflict");
+    }
+
+    [Fact(Skip = Divergences.VersionConflict)]
+    public async Task Stale_version_does_not_change_booking()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
