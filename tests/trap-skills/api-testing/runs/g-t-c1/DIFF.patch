+using System.Net;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class CancelBookingTests(ApiFixture api)
+{
+    [Fact]
+    public async Task Owner_cancels_booking()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+
+        var response = await alice.DeleteAsync($"/api/v1/bookings/{booking["id"]}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        Assert.Empty(await response.Content.ReadAsStringAsync());
+    }
+
+    [Fact]
+    public async Task Cancelled_booking_stays_in_history_with_status_cancelled()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        await alice.DeleteAsync($"/api/v1/bookings/{booking["id"]}");
+
+        var response = await api.Bob().GetAsync($"/api/v1/bookings/{booking["id"]}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Contract.Booking(await Contract.ReadObjectAsync(response), slot.RoomId, "alice", slot.At(9), 60, "cancelled");
+    }
+
+    [Fact]
+    public async Task Cancelled_booking_frees_the_room()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        await alice.DeleteAsync($"/api/v1/bookings/{booking["id"]}");
+
+        var created = await api.CreateBookingAsync(api.Bob(), slot.RoomId, slot.At(9));
+
+        Assert.Equal("bob", (string?)created["ownerId"]);
+    }
+
+    [Fact]
+    public async Task Admin_cancels_someone_elses_booking()
+    {
+        var slot = api.NextSlot();
+        var booking = await api.CreateBookingAsync(api.Alice(), slot.RoomId, slot.At(9));
+
+        var response = await api.Admin().DeleteAsync($"/api/v1/bookings/{booking["id"]}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Other_member_cannot_cancel_is_403_not_owner_and_booking_stays_active()
+    {
+        var slot = api.NextSlot();
+        var booking = await api.CreateBookingAsync(api.Alice(), slot.RoomId, slot.At(9));
+
+        var response = await api.Bob().DeleteAsync($"/api/v1/bookings/{booking["id"]}");
+
+        await Contract.ProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+        var stored = await Contract.ReadObjectAsync(await api.Alice().GetAsync($"/api/v1/bookings/{booking["id"]}"));
+        Assert.Equal("active", (string?)stored["status"]);
+    }
+
+    [Fact(Skip = Divergences.RepeatedCancel)]
+    public async Task Repeated_cancel_is_204()
+    {
+        var slot = api.NextSlot();
+        var alice = api.Alice();
+        var booking = await api.CreateBookingAsync(alice, slot.RoomId, slot.At(9));
+        Assert.Equal(HttpStatusCode.NoContent, (await alice.DeleteAsync($"/api/v1/bookings/{booking["id"]}")).StatusCode);
+
+        var response = await alice.DeleteAsync($"/api/v1/bookings/{booking["id"]}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+    }
+
+    [Fact(Skip = Divergences.RepeatedCancel)]
+    public async Task Repeated_cancel_by_admin_is_204()
+    {
+        var slot = api.NextSlot();
+        var booking = await api.CreateBookingAsync(api.Alice(), slot.RoomId, slot.At(9));
+        var admin = api.Admin();
+        Assert.Equal(HttpStatusCode.NoContent, (await admin.DeleteAsync($"/api/v1/bookings/{booking["id"]}")).StatusCode);
+
+        var response = await admin.DeleteAsync($"/api/v1/bookings/{booking["id"]}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Unknown_booking_is_404_booking_not_found()
+    {
+        var response = await api.Alice().DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await Contract.ProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Without_api_key_is_401_unauthorized()
+    {
+        var response = await api.Client(null).DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await Contract.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
diff --git a/tests/Bookings.Api.Tests/Contract.cs b/tests/Bookings.Api.Tests/Contract.cs
new file mode 100644
index 0000000..c104482
--- /dev/null
+++ b/tests/Bookings.Api.Tests/Contract.cs
@@ -0,0 +1,98 @@
+using System.Globalization;
+using System.Net;
+using System.Text.Json.Nodes;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Проверки форм ответов по api/openapi.yaml.</summary>
+public static class Contract
+{
+    private static readonly string[] BookingFields =
+        ["id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version"];
+
+    public static async Task<JsonObject> ReadObjectAsync(HttpResponseMessage response) =>
+        JsonNode.Parse(await response.Content.ReadAsStringAsync())!.AsObject();
+
+    public static async Task<JsonArray> ReadArrayAsync(HttpResponseMessage response) =>
+        JsonNode.Parse(await response.Content.ReadAsStringAsync())!.AsArray();
+
+    public static async Task ProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadObjectAsync(response);
+        Assert.Equal((int)status, (int)body["status"]!);
+        Assert.False(string.IsNullOrEmpty((string?)body["title"]));
+        Assert.Equal(code, (string?)body["code"]);
+    }
+
+    public static async Task ValidationProblemAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadObjectAsync(response);
+        Assert.Equal(400, (int)body["status"]!);
+        var errors = Assert.IsType<JsonObject>(body["errors"]);
+        foreach (var field in fields)
+        {
+            var messages = Assert.IsType<JsonArray>(errors[field]);
+            Assert.NotEmpty(messages);
+        }
+    }
+
+    public static void Room(JsonNode? node, string id, string name, int capacity, int floor, params string[] features)
+    {
+        var room = Assert.IsType<JsonObject>(node);
+        Assert.Equal(id, (string?)room["id"]);
+        Assert.Equal(name, (string?)room["name"]);
+        Assert.Equal(capacity, (int)room["capacity"]!);
+        Assert.Equal(floor, (int)room["floor"]!);
+        Assert.Equal(features, room["features"]!.AsArray().Select(f => (string?)f).ToArray());
+    }
+
+    public static void Booking(JsonNode? node)
+    {
+        var booking = Assert.IsType<JsonObject>(node);
+        foreach (var field in BookingFields)
+            Assert.True(booking.ContainsKey(field), $"В брони нет поля {field}.");
+
+        Assert.True(Guid.TryParse((string?)booking["id"], out _));
+        Assert.False(string.IsNullOrEmpty((string?)booking["roomId"]));
+        Assert.InRange(((string?)booking["title"])!.Length, 1, 120);
+        if (booking["comment"] is { } comment)
+            Assert.InRange(((string?)comment)!.Length, 0, 500);
+        var startsAt = Utc(booking["startsAt"]);
+        var endsAt = Utc(booking["endsAt"]);
+        var duration = (int)booking["durationMinutes"]!;
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        Assert.Equal(startsAt.AddMinutes(duration), endsAt);
+        Assert.False(string.IsNullOrEmpty((string?)booking["ownerId"]));
+        Assert.Contains((string?)booking["status"], new[] { "active", "cancelled" });
+        Assert.InRange((long)booking["version"]!, 0, uint.MaxValue);
+    }
+
+    public static void Booking(JsonNode? node, string roomId, string owner, DateTimeOffset startsAt, int duration, string status = "active")
+    {
+        Booking(node);
+        var booking = node!.AsObject();
+        Assert.Equal(roomId, (string?)booking["roomId"]);
+        Assert.Equal(owner, (string?)booking["ownerId"]);
+        Assert.Equal(startsAt, Utc(booking["startsAt"]));
+        Assert.Equal(duration, (int)booking["durationMinutes"]!);
+        Assert.Equal(status, (string?)booking["status"]);
+    }
+
+    /// <summary>Момент времени в ответе - UTC (смещение нулевое: Z или +00:00).</summary>
+    public static DateTimeOffset Utc(JsonNode? value)
+    {
+        var text = (string?)value;
+        Assert.NotNull(text);
+        var moment = DateTimeOffset.Parse(text, CultureInfo.InvariantCulture);
+        Assert.Equal(TimeSpan.Zero, moment.Offset);
+        return moment;
+    }
+
+    public static string[] Ids(JsonNode? items) =>
+        items!.AsArray().Select(i => (string)i!["id"]!).ToArray();
+}
