+namespace Bookings.Api.Tests;
+
+/// <summary>FR-12: любой запрос - только с ключом доступа.</summary>
+[Collection(ApiCollection.Name)]
+public class AuthTests(ApiFixture api)
+{
+    private const string BookingUrl = "/api/v1/bookings/3f2b8a64-5717-4562-b3fc-2c963f66afa6";
+
+    public static TheoryData<string, string> Operations => new()
+    {
+        { "GET", "/api/v1/rooms" },
+        { "GET", "/api/v1/rooms/orion" },
+        { "GET", "/api/v1/rooms/orion/bookings" },
+        { "GET", "/api/v1/bookings" },
+        { "POST", "/api/v1/bookings" },
+        { "GET", BookingUrl },
+        { "PATCH", BookingUrl },
+        { "DELETE", BookingUrl },
+    };
+
+    private static object? BodyFor(string method) => method switch
+    {
+        "POST" => new { roomId = "orion", title = "t", startsAt = DateTimeOffset.UtcNow.AddDays(1), durationMinutes = 60 },
+        "PATCH" => new { startsAt = DateTimeOffset.UtcNow.AddDays(1), durationMinutes = 60, version = 1 },
+        _ => null,
+    };
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task Without_key_is_unauthorized(string method, string url)
+    {
+        var response = await api.SendAsync(new HttpMethod(method), url, apiKey: null, BodyFor(method));
+
+        ProblemAssert.Problem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task Unknown_key_is_unauthorized(string method, string url)
+    {
+        var response = await api.SendAsync(new HttpMethod(method), url, "no-such-key", BodyFor(method));
+
+        ProblemAssert.Problem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
