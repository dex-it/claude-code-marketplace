+namespace Bookings.Api.Tests;
+
+/// <summary>Известные расхождения реализации с контрактом: причины пропуска тестов (BKG-31).</summary>
+internal static class Discrepancy
+{
+    public const string CreateNoLocation = "POST /bookings: 201 без заголовка Location";
+    public const string EndsAt = "endsAt считается как startsAt + целые часы (durationMinutes / 60), а не startsAt + durationMinutes";
+    public const string BindingErrorsPascalCase = "Ошибки разбора тела запроса приходят с полем в PascalCase (Title), контракт - camelCase";
+    public const string OverlapProblem = "Пересечение: 409 application/json {error: overlap} вместо problem+json с code booking-overlap";
+    public const string RescheduleNotOwner = "PATCH /bookings/{id}: чужую бронь переносят (200), контракт - 403 not-owner";
+    public const string VersionNotChecked = "PATCH /bookings/{id}: version из запроса не проверяется, контракт - 409 version-conflict";
+    public const string RepeatCancel = "DELETE /bookings/{id}: повторная отмена - 500, контракт - 204";
+    public const string EmptyItemsNull = "GET /bookings: пустой результат - items: null, контракт - items: []";
+    public const string BookingsLimit = "GET /bookings: limit вне 1..100 принимается (200), контракт - 400";
+}
