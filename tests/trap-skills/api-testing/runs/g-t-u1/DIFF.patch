@@ -0,0 +1,121 @@
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Hosting;
+using Testcontainers.PostgreSql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис на настоящем PostgreSQL: ограничение пересечения (exclusion constraint) и версию строки (xmin)
+/// держит сама база, на EF InMemory/Sqlite их не проверить.
+/// </summary>
+public sealed class ApiFixture : IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+
+    private WebApplicationFactory<Program>? _factory;
+    private HttpClient? _client;
+    private int _slot;
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+        {
+            builder.UseEnvironment(Environments.Staging);
+            builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["ConnectionStrings:Bookings"] = _postgres.GetConnectionString(),
+                ["Database:Initialize"] = "true",
+                ["Auth:Keys:0:key"] = AliceKey,
+                ["Auth:Keys:0:userId"] = "alice",
+                ["Auth:Keys:0:role"] = "member",
+                ["Auth:Keys:1:key"] = BobKey,
+                ["Auth:Keys:1:userId"] = "bob",
+                ["Auth:Keys:1:role"] = "member",
+                ["Auth:Keys:2:key"] = AdminKey,
+                ["Auth:Keys:2:userId"] = "admin",
+                ["Auth:Keys:2:role"] = "admin",
+            }));
+        });
+        _client = _factory.CreateClient();
+    }
+
+    public async Task DisposeAsync()
+    {
+        _client?.Dispose();
+        if (_factory is not null)
+            await _factory.DisposeAsync();
+        await _postgres.DisposeAsync();
+    }
+
+    /// <summary>
+    /// Свободное четырёхчасовое окно в будущем (в пределах 90 дней): тесты делят одну базу
+    /// и не должны пересекаться по времени друг с другом.
+    /// </summary>
+    public DateTimeOffset NextSlot()
+    {
+        var n = Interlocked.Increment(ref _slot);
+        var tomorrow = new DateTimeOffset(DateTimeOffset.UtcNow.Date, TimeSpan.Zero).AddDays(1);
+        return tomorrow.AddHours(4 * (n % 500));
+    }
+
+    public async Task<ApiResponse> SendAsync(HttpMethod method, string url, string? apiKey, object? body = null)
+    {
+        using var request = new HttpRequestMessage(method, url);
+        if (apiKey is not null)
+            request.Headers.Add("X-Api-Key", apiKey);
+        if (body is not null)
+            request.Content = JsonContent.Create(body, options: JsonOptions);
+
+        using var response = await _client!.SendAsync(request);
+        var text = await response.Content.ReadAsStringAsync();
+        JsonElement? json = null;
+        if (text.Length > 0 && response.Content.Headers.ContentType?.MediaType is { } type && type.EndsWith("json"))
+            json = JsonDocument.Parse(text).RootElement.Clone();
+
+        return new ApiResponse(response.StatusCode, response.Content.Headers.ContentType?.MediaType, response.Headers.Location, json);
+    }
+
+    public Task<ApiResponse> GetAsync(string url, string? apiKey = AliceKey) => SendAsync(HttpMethod.Get, url, apiKey);
+
+    public Task<ApiResponse> CreateBookingAsync(
+        string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string title = "Встреча",
+        string? comment = null, string? apiKey = AliceKey) =>
+        SendAsync(HttpMethod.Post, "/api/v1/bookings", apiKey,
+            new { roomId, title, startsAt, durationMinutes, comment });
+
+    public Task<ApiResponse> RescheduleAsync(string id, DateTimeOffset startsAt, int durationMinutes, long version, string? apiKey = AliceKey) =>
+        SendAsync(HttpMethod.Patch, $"/api/v1/bookings/{id}", apiKey, new { startsAt, durationMinutes, version });
+
+    public Task<ApiResponse> CancelAsync(string id, string? apiKey = AliceKey) =>
+        SendAsync(HttpMethod.Delete, $"/api/v1/bookings/{id}", apiKey);
+
+    /// <summary>Создаёт бронь и проверяет, что она создана; возвращает её тело.</summary>
+    public async Task<JsonElement> CreatedBookingAsync(
+        string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string? apiKey = AliceKey)
+    {
+        var response = await CreateBookingAsync(roomId, startsAt, durationMinutes, apiKey: apiKey);
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+        return response.Json!.Value;
+    }
+
+    public static string Iso(DateTimeOffset value) => Uri.EscapeDataString(value.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ"));
+}
+
+public sealed record ApiResponse(HttpStatusCode Status, string? MediaType, Uri? Location, JsonElement? Json);
+
+[CollectionDefinition(Name)]
+public sealed class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
