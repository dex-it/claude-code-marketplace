+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// FR-03..FR-11: создание, чтение, перенос и отмена броней.
+/// Тесты с Skip - расхождения реализации с контрактом 1.2.0 (см. <see cref="Discrepancy"/>): тест описывает
+/// поведение по контракту, пропуск снимают вместе с исправлением сервиса.
+/// </summary>
+[Collection(ApiCollection.Name)]
+public class BookingsTests(ApiFixture api)
+{
+    private static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    // --- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_returns_201_with_location_and_booking()
+    {
+        var startsAt = api.NextSlot();
+
+        var response = await api.CreateBookingAsync("orion", startsAt, 90, "Планирование спринта", "Принести маркеры");
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+        var booking = response.Json!.Value;
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести маркеры", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+        Assert.True(booking.GetProperty("version").GetInt64() >= 0);
+    }
+
+    [Fact(Skip = Discrepancy.CreateNoLocation)]
+    public async Task Create_returns_location_of_created_booking()
+    {
+        var response = await api.CreateBookingAsync("orion", api.NextSlot());
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+        Assert.Equal($"/api/v1/bookings/{Id(response.Json!.Value)}", response.Location?.OriginalString);
+    }
+
+    [Fact(Skip = Discrepancy.EndsAt)]
+    public async Task Create_ends_at_is_start_plus_duration()
+    {
+        var startsAt = api.NextSlot();
+
+        var booking = await api.CreatedBookingAsync("orion", startsAt, 90);
+
+        Assert.Equal(startsAt.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Create_without_comment_returns_null_comment()
+    {
+        var booking = await api.CreatedBookingAsync("orion", api.NextSlot());
+
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Theory]
+    [InlineData(15, 1, 0)]
+    [InlineData(240, 120, 500)]
+    public async Task Create_accepts_boundary_values(int duration, int titleLength, int commentLength)
+    {
+        var title = new string('т', titleLength);
+        var comment = commentLength > 0 ? new string('к', commentLength) : null;
+
+        var response = await api.CreateBookingAsync("orion", api.NextSlot(), duration, title, comment);
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+    }
+
+    [Fact]
+    public async Task Create_accepts_start_just_inside_90_days()
+    {
+        var startsAt = DateTimeOffset.UtcNow.AddDays(90).AddMinutes(-5);
+
+        var response = await api.CreateBookingAsync("lyra", startsAt, 15);
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(14)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(300)]
+    public async Task Create_invalid_duration_is_validation_error(int duration)
+    {
+        var response = await api.CreateBookingAsync("orion", api.NextSlot(), duration);
+
+        ProblemAssert.Validation(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_start_in_past_is_validation_error()
+    {
+        var response = await api.CreateBookingAsync("orion", DateTimeOffset.UtcNow.AddMinutes(-1));
+
+        ProblemAssert.Validation(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_start_beyond_90_days_is_validation_error()
+    {
+        var response = await api.CreateBookingAsync("orion", DateTimeOffset.UtcNow.AddDays(91));
+
+        ProblemAssert.Validation(response, "startsAt");
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("   ")]
+    public async Task Create_blank_title_is_validation_error(string title)
+    {
+        var response = await api.CreateBookingAsync("orion", api.NextSlot(), title: title);
+
+        ProblemAssert.Validation(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_too_long_title_is_validation_error()
+    {
+        var response = await api.CreateBookingAsync("orion", api.NextSlot(), title: new string('т', 121));
+
+        ProblemAssert.Validation(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_too_long_comment_is_validation_error()
+    {
+        var response = await api.CreateBookingAsync("orion", api.NextSlot(), comment: new string('к', 501));
+
+        ProblemAssert.Validation(response, "comment");
+    }
+
+    [Fact(Skip = Discrepancy.BindingErrorsPascalCase)]
+    public async Task Create_missing_required_field_is_validation_error()
+    {
+        var response = await api.SendAsync(HttpMethod.Post, "/api/v1/bookings", ApiFixture.AliceKey,
+            new { roomId = "orion", startsAt = api.NextSlot(), durationMinutes = 60 });
+
+        ProblemAssert.Validation(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_unknown_room_is_not_found()
+    {
+        var response = await api.CreateBookingAsync("no-such-room", api.NextSlot());
+
+        ProblemAssert.Problem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact(Skip = Discrepancy.OverlapProblem)]
+    public async Task Create_overlapping_active_booking_is_conflict()
+    {
+        var slot = api.NextSlot();
+        await api.CreatedBookingAsync("orion", slot, 60);
+
+        var response = await api.CreateBookingAsync("orion", slot.AddMinutes(30), 60, apiKey: ApiFixture.BobKey);
+
+        ProblemAssert.Problem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_adjacent_booking_is_allowed()
+    {
+        var slot = api.NextSlot();
+        await api.CreatedBookingAsync("orion", slot, 60);
+
+        var response = await api.CreateBookingAsync("orion", slot.AddHours(1), 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+    }
+
+    [Fact]
+    public async Task Create_same_time_in_other_room_is_allowed()
+    {
+        var slot = api.NextSlot();
+        await api.CreatedBookingAsync("orion", slot, 60);
+
+        var response = await api.CreateBookingAsync("vega", slot, 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+    }
+
+    [Fact]
+    public async Task Create_over_cancelled_booking_is_allowed()
+    {
+        var slot = api.NextSlot();
+        var first = await api.CreatedBookingAsync("orion", slot, 60);
+        Assert.Equal(HttpStatusCode.NoContent, (await api.CancelAsync(Id(first))).Status);
+
+        var response = await api.CreateBookingAsync("orion", slot, 60, apiKey: ApiFixture.BobKey);
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+    }
+
+    [Fact(Skip = Discrepancy.OverlapProblem)]
+    public async Task Create_concurrent_requests_for_same_slot_yield_one_booking()
+    {
+        var slot = api.NextSlot();
+
+        var responses = await Task.WhenAll(Enumerable.Range(0, 5)
+            .Select(_ => api.CreateBookingAsync("lyra", slot, 60)));
+
+        Assert.Single(responses, r => r.Status == HttpStatusCode.Created);
+        foreach (var rejected in responses.Where(r => r.Status != HttpStatusCode.Created))
+            ProblemAssert.Problem(rejected, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    // --- GET /api/v1/bookings/{id}
+
+    [Fact]
+    public async Task Get_returns_booking_to_any_participant()
+    {
+        var created = await api.CreatedBookingAsync("orion", api.NextSlot(), 45);
+
+        var response = await api.GetAsync($"/api/v1/bookings/{Id(created)}", ApiFixture.BobKey);
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        var booking = response.Json!.Value;
+        Assert.Equal(Id(created), Id(booking));
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Get_unknown_is_not_found()
+    {
+        var response = await api.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        ProblemAssert.Problem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    // --- PATCH /api/v1/bookings/{id}
+
+    [Fact]
+    public async Task Reschedule_by_owner_moves_booking_and_changes_version()
+    {
+        var slot = api.NextSlot();
+        var created = await api.CreatedBookingAsync("orion", slot, 60);
+        var newStart = slot.AddHours(2);
+
+        var response = await api.RescheduleAsync(Id(created), newStart, 120, created.GetProperty("version").GetInt64());
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        var booking = response.Json!.Value;
+        Assert.Equal(Id(created), Id(booking));
+        Assert.Equal(newStart, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(120, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.NotEqual(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+    }
+
+    [Fact(Skip = Discrepancy.EndsAt)]
+    public async Task Reschedule_ends_at_is_start_plus_duration()
+    {
+        var slot = api.NextSlot();
+        var created = await api.CreatedBookingAsync("orion", slot, 60);
+
+        var response = await api.RescheduleAsync(Id(created), slot.AddHours(2), 45, created.GetProperty("version").GetInt64());
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Equal(slot.AddHours(2).AddMinutes(45), response.Json!.Value.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Reschedule_by_admin_is_allowed()
+    {
+        var slot = api.NextSlot();
+        var created = await api.CreatedBookingAsync("orion", slot, 60);
+
+        var response = await api.RescheduleAsync(
+            Id(created), slot.AddHours(1), 60, created.GetProperty("version").GetInt64(), ApiFixture.AdminKey);
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+    }
+
+    [Fact(Skip = Discrepancy.RescheduleNotOwner)]
+    public async Task Reschedule_by_other_member_is_forbidden()
+    {
+        var slot = api.NextSlot();
+        var created = await api.CreatedBookingAsync("orion", slot, 60);
+
+        var response = await api.RescheduleAsync(
+            Id(created), slot.AddHours(1), 60, created.GetProperty("version").GetInt64(), ApiFixture.BobKey);
+
+        ProblemAssert.Problem(response, HttpStatusCode.Forbidden, "not-owner");
+    }
+
+    [Fact(Skip = Discrepancy.VersionNotChecked)]
+    public async Task Reschedule_with_stale_version_is_conflict()
+    {
