+using System.Net;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class RoomsTests(ApiFixture api)
+{
+    [Fact]
+    public async Task ListRooms_ReturnsPageOrderedById()
+    {
+        var response = await api.GetAsync("/api/v1/rooms");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ApiFixture.ReadAsync<RoomPageView>(response);
+        Assert.Equal(["lyra", "orion", "vega"], page.Items.Select(r => r.Id));
+        Assert.Equal(3, page.Total);
+    }
+
+    [Fact]
+    public async Task ListRooms_RoomHasContractFields()
+    {
+        var page = await ApiFixture.ReadAsync<RoomPageView>(await api.GetAsync("/api/v1/rooms"));
+
+        var orion = Assert.Single(page.Items, r => r.Id == "orion");
+        Assert.Equal("Orion", orion.Name);
+        Assert.Equal(8, orion.Capacity);
+        Assert.Equal(3, orion.Floor);
+        Assert.Equal(["projector", "whiteboard"], orion.Features);
+    }
+
+    [Fact]
+    public async Task ListRooms_LimitAndOffset_SlicePageAndKeepTotal()
+    {
+        var response = await api.GetAsync("/api/v1/rooms?limit=1&offset=1");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ApiFixture.ReadAsync<RoomPageView>(response);
+        Assert.Equal("orion", Assert.Single(page.Items).Id);
+        Assert.Equal(3, page.Total);
+    }
+
+    [Fact]
+    public async Task ListRooms_OffsetBeyondEnd_ReturnsEmptyItems()
+    {
+        var page = await ApiFixture.ReadAsync<RoomPageView>(await api.GetAsync("/api/v1/rooms?offset=50"));
+
+        Assert.Empty(page.Items);
+        Assert.Equal(3, page.Total);
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("offset=-1", "offset")]
+    public async Task ListRooms_InvalidPaging_Returns400(string query, string field)
+    {
+        var response = await api.GetAsync($"/api/v1/rooms?{query}");
+
+        await Asserts.ValidationAsync(response, field);
+    }
+
+    [Fact]
+    public async Task GetRoom_Existing_ReturnsRoom()
+    {
+        var response = await api.GetAsync("/api/v1/rooms/lyra");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var room = await ApiFixture.ReadAsync<RoomView>(response);
+        Assert.Equal(("lyra", "Lyra", 12, 5), (room.Id, room.Name, room.Capacity, room.Floor));
+        Assert.Equal(["projector", "videoconf"], room.Features);
+    }
+
+    [Fact]
+    public async Task GetRoom_Unknown_Returns404RoomNotFound()
+    {
+        var response = await api.GetAsync("/api/v1/rooms/no-such-room");
+
+        await Asserts.ProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_ReturnsActiveAndCancelledByStartsAt()
+    {
+        var slot = Slots.Next();
+        var later = await api.CreateBookingAsync(slot.AddHours(2), 30, "vega");
+        var earlier = await api.CreateBookingAsync(slot, 30, "vega");
+        var cancelled = await api.CreateBookingAsync(slot.AddHours(1), 30, "vega");
+        await api.SendAsync(HttpMethod.Delete, $"/api/v1/bookings/{cancelled.Id}", ApiFixture.AliceKey);
+
+        var response = await api.GetAsync(
+            $"/api/v1/rooms/vega/bookings?from={Slots.Query(slot)}&to={Slots.Query(slot.AddHours(4))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var bookings = await ApiFixture.ReadAsync<BookingView[]>(response);
+        Assert.Equal([earlier.Id, cancelled.Id, later.Id], bookings.Select(b => b.Id));
+        Assert.Equal(["active", "cancelled", "active"], bookings.Select(b => b.Status));
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await api.GetAsync("/api/v1/rooms/no-such-room/bookings");
