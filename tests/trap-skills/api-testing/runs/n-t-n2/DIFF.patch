+namespace Bookings.Api.Tests;
+
+// Модели ответов описаны по api/openapi.yaml, а не берутся из кода сервиса.
+public record RoomView(string Id, string Name, int Capacity, int Floor, string[] Features);
+
+public record RoomPageView(RoomView[] Items, int Total);
+
+public record BookingView(
+    Guid Id, string RoomId, string Title, string? Comment, DateTimeOffset StartsAt, int DurationMinutes,
+    DateTimeOffset EndsAt, string OwnerId, string Status, long Version);
+
+public record BookingPageView(BookingView[] Items, string? NextCursor);
+
+public static class Slots
+{
+    private static int _next;
+    private static readonly DateTimeOffset Origin = new(DateTimeOffset.UtcNow.Date.AddDays(2), TimeSpan.Zero);
+
+    /// <summary>Своё четырёхчасовое окно на тест: брони разных тестов не пересекаются в общей БД.</summary>
+    public static DateTimeOffset Next() => Origin.AddHours(4 * Interlocked.Increment(ref _next));
+
+    public static string Query(DateTimeOffset moment) =>
+        Uri.EscapeDataString(moment.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"));
+}
