+using System.Net;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class AuthTests(ApiFixture api)
+{
+    private const string SomeId = "3f2b8a64-5717-4562-b3fc-2c963f66afa6";
+
+    public static TheoryData<string, string, bool> Operations => new()
+    {
+        { "GET", "/api/v1/rooms", false },
+        { "GET", "/api/v1/rooms/orion", false },
+        { "GET", "/api/v1/rooms/orion/bookings", false },
+        { "GET", "/api/v1/bookings", false },
+        { "POST", "/api/v1/bookings", true },
+        { "GET", $"/api/v1/bookings/{SomeId}", false },
+        { "PATCH", $"/api/v1/bookings/{SomeId}", true },
+        { "DELETE", $"/api/v1/bookings/{SomeId}", false },
+    };
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task NoKey_Returns401Unauthorized(string method, string url, bool hasBody)
+    {
+        var response = await api.SendAsync(new HttpMethod(method), url, key: null, hasBody ? new { } : null);
+
+        await Asserts.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task UnknownKey_Returns401Unauthorized(string method, string url, bool hasBody)
+    {
+        var response = await api.SendAsync(new HttpMethod(method), url, key: "no-such-key", hasBody ? new { } : null);
+
+        await Asserts.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
