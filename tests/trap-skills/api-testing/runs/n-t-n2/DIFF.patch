@@ -0,0 +1,43 @@
+using System.Net;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public static class Asserts
+{
+    public static async Task ProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        var root = json.RootElement;
+        Assert.Equal((int)status, root.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrEmpty(root.GetProperty("title").GetString()));
+        Assert.True(root.TryGetProperty("type", out _), "В problem нет обязательного поля type");
+        Assert.True(root.TryGetProperty("code", out var actual), "В problem нет обязательного поля code");
+        Assert.Equal(code, actual.GetString());
+    }
+
+    public static async Task ValidationAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        var root = json.RootElement;
+        Assert.Equal(400, root.GetProperty("status").GetInt32());
+        Assert.True(root.TryGetProperty("type", out _), "В problem нет обязательного поля type");
+        Assert.True(root.TryGetProperty("title", out _), "В problem нет обязательного поля title");
+        var errors = root.GetProperty("errors").EnumerateObject().Select(p => p.Name).ToArray();
+        foreach (var field in fields)
+            Assert.Contains(field, errors);
+    }
+
+    public static async Task BookingShapeAsync(HttpResponseMessage response)
+    {
+        using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        string[] required =
+            ["id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version"];
+        foreach (var name in required)
+            Assert.True(json.RootElement.TryGetProperty(name, out _), $"В брони нет обязательного поля {name}");
+    }
+}
