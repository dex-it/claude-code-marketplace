+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Testcontainers.PostgreSql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Сервис поверх настоящего PostgreSQL: нужны exclusion constraint и версия из xmin.</summary>
+public sealed class ApiFixture : WebApplicationFactory<Program>, IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+
+    public async Task InitializeAsync() => await _postgres.StartAsync();
+
+    async Task IAsyncLifetime.DisposeAsync()
+    {
+        await base.DisposeAsync();
+        await _postgres.DisposeAsync();
+    }
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+        builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["ConnectionStrings:Bookings"] = _postgres.GetConnectionString(),
+            ["Database:Initialize"] = "true",
+            ["Auth:Keys:0:Key"] = AliceKey,
+            ["Auth:Keys:0:UserId"] = "alice",
+            ["Auth:Keys:0:Role"] = "member",
+            ["Auth:Keys:1:Key"] = BobKey,
+            ["Auth:Keys:1:UserId"] = "bob",
+            ["Auth:Keys:1:Role"] = "member",
+            ["Auth:Keys:2:Key"] = AdminKey,
+            ["Auth:Keys:2:UserId"] = "admin",
+            ["Auth:Keys:2:Role"] = "admin",
+        }));
+    }
+
+    public Task<HttpResponseMessage> SendAsync(HttpMethod method, string url, string? key, object? body = null)
+    {
+        var request = new HttpRequestMessage(method, url);
+        if (key is not null)
+            request.Headers.Add("X-Api-Key", key);
+        if (body is not null)
+            request.Content = JsonContent.Create(body, options: JsonOptions);
+        return CreateClient().SendAsync(request);
+    }
+
+    public Task<HttpResponseMessage> GetAsync(string url, string? key = AliceKey) => SendAsync(HttpMethod.Get, url, key);
+
+    public Task<HttpResponseMessage> PostBookingAsync(object body, string? key = AliceKey) =>
+        SendAsync(HttpMethod.Post, "/api/v1/bookings", key, body);
+
+    public async Task<BookingView> CreateBookingAsync(
+        DateTimeOffset startsAt, int durationMinutes = 60, string roomId = "orion", string key = AliceKey,
+        string title = "Планирование спринта", string? comment = null)
+    {
+        var response = await PostBookingAsync(new { roomId, title, startsAt, durationMinutes, comment }, key);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadAsync<BookingView>(response);
+    }
+
+    public static async Task<T> ReadAsync<T>(HttpResponseMessage response) =>
+        (await response.Content.ReadFromJsonAsync<T>(JsonOptions))!;
+}
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
