+using System.Net;
+using System.Text;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingsTests(ApiFixture api)
+{
+    // ---- createBooking (FR-03, FR-05, FR-08, FR-09)
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithBookingAndLocation()
+    {
+        var startsAt = Slots.Next();
+
+        var response = await api.PostBookingAsync(new
+        {
+            roomId = "orion", title = "Планирование спринта", startsAt, durationMinutes = 90, comment = "Принести ноутбуки",
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        await Asserts.BookingShapeAsync(response);
+        var booking = await ApiFixture.ReadAsync<BookingView>(response);
+        Assert.Equal("orion", booking.RoomId);
+        Assert.Equal("Планирование спринта", booking.Title);
+        Assert.Equal("Принести ноутбуки", booking.Comment);
+        Assert.Equal(startsAt, booking.StartsAt);
+        Assert.Equal(90, booking.DurationMinutes);
+        Assert.Equal(startsAt.AddMinutes(90), booking.EndsAt);
+        Assert.Equal("alice", booking.OwnerId);
+        Assert.Equal("active", booking.Status);
+        Assert.Equal($"/api/v1/bookings/{booking.Id}", response.Headers.Location?.AbsolutePath);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var response = await api.PostBookingAsync(
+            new { roomId = "orion", title = "Без комментария", startsAt = Slots.Next(), durationMinutes = 15 });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        await Asserts.BookingShapeAsync(response);
+        Assert.Null((await ApiFixture.ReadAsync<BookingView>(response)).Comment);
+    }
+
+    [Fact]
+    public async Task Create_StartsAtWithOffset_IsReturnedAsSameMomentInUtc()
+    {
+        var startsAt = Slots.Next();
+        var withOffset = startsAt.ToOffset(TimeSpan.FromHours(3));
+
+        var booking = await api.CreateBookingAsync(withOffset, 30);
+
+        Assert.Equal(startsAt, booking.StartsAt);
+        Assert.Equal(TimeSpan.Zero, booking.StartsAt.Offset);
+    }
+
+    [Fact]
+    public async Task Create_ByTwoUsers_OwnerIsKeyHolder()
+    {
+        var booking = await api.CreateBookingAsync(Slots.Next(), 30, key: ApiFixture.BobKey);
+
+        Assert.Equal("bob", booking.OwnerId);
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_DurationBoundaries_Accepted(int minutes)
+    {
+        var booking = await api.CreateBookingAsync(Slots.Next(), minutes);
+
+        Assert.Equal(minutes, booking.DurationMinutes);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var response = await api.PostBookingAsync(
+            new { roomId = "orion", title = "Встреча", startsAt = Slots.Next(), durationMinutes = minutes });
+
+        await Asserts.ValidationAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_StartInPast_Returns400()
+    {
+        var response = await api.PostBookingAsync(new
+        {
+            roomId = "orion", title = "Встреча", startsAt = DateTimeOffset.UtcNow.AddHours(-1), durationMinutes = 30,
+        });
+
+        await Asserts.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await api.PostBookingAsync(new
+        {
+            roomId = "orion", title = "Встреча", startsAt = DateTimeOffset.UtcNow.AddDays(91), durationMinutes = 30,
+        });
+
+        await Asserts.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartWithin90Days_Accepted()
+    {
+        var response = await api.PostBookingAsync(new
+        {
+            roomId = "lyra", title = "Далёкая встреча", startsAt = DateTimeOffset.UtcNow.AddDays(89), durationMinutes = 30,
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("   ")]
+    public async Task Create_EmptyTitle_Returns400(string title)
+    {
+        var response = await api.PostBookingAsync(
+            new { roomId = "orion", title, startsAt = Slots.Next(), durationMinutes = 30 });
+
+        await Asserts.ValidationAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf121Chars_Returns400()
+    {
+        var response = await api.PostBookingAsync(
+            new { roomId = "orion", title = new string('я', 121), startsAt = Slots.Next(), durationMinutes = 30 });
+
+        await Asserts.ValidationAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleAndCommentAtLimit_Accepted()
+    {
+        var booking = await api.CreateBookingAsync(
+            Slots.Next(), 30, title: new string('я', 120), comment: new string('к', 500));
+
+        Assert.Equal(120, booking.Title.Length);
+        Assert.Equal(500, booking.Comment!.Length);
+    }
+
+    [Fact]
+    public async Task Create_CommentOf501Chars_Returns400()
+    {
+        var response = await api.PostBookingAsync(new
+        {
+            roomId = "orion", title = "Встреча", startsAt = Slots.Next(), durationMinutes = 30, comment = new string('к', 501),
+        });
+
+        await Asserts.ValidationAsync(response, "comment");
+    }
+
+    [Fact(Skip = "Расхождение с контрактом: ключ errors - 'Title', контракт требует camelCase ('title')")]
+    public async Task Create_MissingRequiredFields_Returns400WithCamelCaseFields()
+    {
+        var response = await api.PostBookingAsync(new { roomId = "orion" });
+
+        await Asserts.ValidationAsync(response, "title", "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_MalformedJson_Returns400Problem()
+    {
+        var request = new HttpRequestMessage(HttpMethod.Post, "/api/v1/bookings")
+        {
+            Content = new StringContent("{ not json", Encoding.UTF8, "application/json"),
+        };
+        request.Headers.Add("X-Api-Key", ApiFixture.AliceKey);
+
+        var response = await api.CreateClient().SendAsync(request);
+
+        await Asserts.ValidationAsync(response);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await api.PostBookingAsync(
+            new { roomId = "no-such-room", title = "Встреча", startsAt = Slots.Next(), durationMinutes = 30 });
+
+        await Asserts.ProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_OverlapsActiveBooking_Returns409Overlap()
+    {
+        var slot = Slots.Next();
+        await api.CreateBookingAsync(slot, 60);
+
+        var response = await api.PostBookingAsync(
+            new { roomId = "orion", title = "Встреча", startsAt = slot.AddMinutes(30), durationMinutes = 60 }, ApiFixture.BobKey);
+
+        await Asserts.ProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentToActiveBooking_Accepted()
+    {
+        var slot = Slots.Next();
+        await api.CreateBookingAsync(slot, 60);
+
+        var booking = await api.CreateBookingAsync(slot.AddMinutes(60), 60);
+
+        Assert.Equal("active", booking.Status);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInOtherRoom_Accepted()
+    {
+        var slot = Slots.Next();
+        await api.CreateBookingAsync(slot, 60, "orion");
+
+        var booking = await api.CreateBookingAsync(slot, 60, "vega");
+
+        Assert.Equal("vega", booking.RoomId);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_Accepted()
+    {
+        var slot = Slots.Next();
+        var first = await api.CreateBookingAsync(slot, 60);
+        await api.SendAsync(HttpMethod.Delete, $"/api/v1/bookings/{first.Id}", ApiFixture.AliceKey);
+
+        var second = await api.CreateBookingAsync(slot, 60, key: ApiFixture.BobKey);
+
+        Assert.Equal("active", second.Status);
+    }
+
+    // ---- getBooking (FR-04)
+
+    [Fact]
+    public async Task Get_OwnBooking_ReturnsBooking()
+    {
+        var created = await api.CreateBookingAsync(Slots.Next(), 45);
+
+        var response = await api.GetAsync($"/api/v1/bookings/{created.Id}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        await Asserts.BookingShapeAsync(response);
+        Assert.Equal(created, await ApiFixture.ReadAsync<BookingView>(response));
+    }
+
+    [Fact]
+    public async Task Get_SomeoneElsesBooking_IsVisible()
+    {
+        var created = await api.CreateBookingAsync(Slots.Next(), 45, key: ApiFixture.AliceKey);
+
+        var response = await api.GetAsync($"/api/v1/bookings/{created.Id}", ApiFixture.BobKey);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("alice", (await ApiFixture.ReadAsync<BookingView>(response)).OwnerId);
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await api.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await Asserts.ProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Theory(Skip = "Расхождение с контрактом: 404 на не-uuid идентификатор приходит без поля code")]
+    [InlineData("GET")]
+    [InlineData("PATCH")]
+    [InlineData("DELETE")]
+    public async Task BookingById_IdIsNotUuid_Returns404BookingNotFound(string method)
+    {
+        var body = method == "PATCH" ? new { startsAt = Slots.Next(), durationMinutes = 30, version = 1 } : null;
+
+        var response = await api.SendAsync(new HttpMethod(method), "/api/v1/bookings/not-a-uuid", ApiFixture.AliceKey, body);
+
+        await Asserts.ProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    // ---- listBookings (FR-02)
+
+    [Fact]
+    public async Task List_ByRoomAndPeriod_ReturnsOrderedByStartsAtAndHasNullCursor()
+    {
+        var slot = Slots.Next();
+        var second = await api.CreateBookingAsync(slot.AddHours(1), 30, "lyra");
+        var first = await api.CreateBookingAsync(slot, 30, "lyra");
+        await api.CreateBookingAsync(slot, 30, "vega");
+
+        var response = await api.GetAsync(
+            $"/api/v1/bookings?roomId=lyra&from={Slots.Query(slot)}&to={Slots.Query(slot.AddHours(4))}");
+
