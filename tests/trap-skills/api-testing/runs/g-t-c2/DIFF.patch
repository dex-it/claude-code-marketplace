@@ -0,0 +1,85 @@
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+using Testcontainers.PostgreSql;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис поверх настоящего PostgreSQL: запрет пересечений броней (FR-09) и версия брони (xmin)
+/// обеспечиваются самой БД, на InMemory/SQLite их не проверить.
+/// </summary>
+public sealed class ApiFixture : IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+    private ApiFactory? _factory;
+    private int _roomCounter;
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+        _factory = new ApiFactory(_postgres.GetConnectionString());
+    }
+
+    public async Task DisposeAsync()
+    {
+        if (_factory is not null)
+            await _factory.DisposeAsync();
+        await _postgres.DisposeAsync();
+    }
+
+    /// <summary>Клиент с ключом доступа; <c>null</c> - запросы без ключа.</summary>
+    public HttpClient CreateClient(string? apiKey)
+    {
+        var client = _factory!.CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+
+    /// <summary>Новая комната: тесты не делят комнаты и не мешают друг другу пересечениями.</summary>
+    public async Task<string> CreateRoomAsync()
+    {
+        var id = $"t-room-{Interlocked.Increment(ref _roomCounter)}";
+        using var scope = _factory!.Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<BookingsDbContext>();
+        db.Rooms.Add(new Room(id, $"Test room {id}", 6, 2));
+        await db.SaveChangesAsync();
+        return id;
+    }
+
+    private sealed class ApiFactory(string connectionString) : WebApplicationFactory<Program>
+    {
+        protected override void ConfigureWebHost(IWebHostBuilder builder)
+        {
+            builder.UseSetting("ConnectionStrings:Bookings", connectionString);
+            builder.UseSetting("Database:Initialize", "true");
+
+            var keys = new (string Key, string UserId, string Role)[]
+            {
+                (AliceKey, "alice", "member"),
+                (BobKey, "bob", "member"),
+                (AdminKey, "admin", "admin")
+            };
+            for (var i = 0; i < keys.Length; i++)
+            {
+                builder.UseSetting($"Auth:Keys:{i}:Key", keys[i].Key);
+                builder.UseSetting($"Auth:Keys:{i}:UserId", keys[i].UserId);
+                builder.UseSetting($"Auth:Keys:{i}:Role", keys[i].Role);
+            }
+        }
+    }
+}
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
