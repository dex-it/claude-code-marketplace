+using System.Net;
+using System.Net.Http.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public class AuthTests(ApiFixture fixture) : ApiTestBase(fixture)
+{
+    private const string SomeBookingId = "3f2b8a64-5717-4562-b3fc-2c963f66afa6";
+
+    public static TheoryData<string, string> Operations => new()
+    {
+        { "GET", "/api/v1/rooms" },
+        { "GET", "/api/v1/rooms/orion" },
+        { "GET", "/api/v1/rooms/orion/bookings" },
+        { "GET", "/api/v1/bookings" },
+        { "POST", "/api/v1/bookings" },
+        { "GET", $"/api/v1/bookings/{SomeBookingId}" },
+        { "PATCH", $"/api/v1/bookings/{SomeBookingId}" },
+        { "DELETE", $"/api/v1/bookings/{SomeBookingId}" }
+    };
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task NoApiKey_Returns401Unauthorized(string method, string url)
+    {
+        using var client = Fixture.CreateClient(null);
+
+        var response = await client.SendAsync(Request(method, url));
+
+        await ContractAssert.AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task UnknownApiKey_Returns401Unauthorized(string method, string url)
+    {
+        using var client = Fixture.CreateClient("not-a-known-key");
+
+        var response = await client.SendAsync(Request(method, url));
+
+        await ContractAssert.AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task EmptyApiKey_Returns401Unauthorized()
+    {
+        using var client = Fixture.CreateClient("");
+
+        var response = await client.GetAsync("/api/v1/rooms");
+
+        await ContractAssert.AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task MemberAndAdminKeys_AreAccepted()
+    {
+        Assert.Equal(HttpStatusCode.OK, (await Alice.GetAsync("/api/v1/rooms")).StatusCode);
+        Assert.Equal(HttpStatusCode.OK, (await Admin.GetAsync("/api/v1/rooms")).StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OwnerIsKeyHolder()
+    {
+        var room = await Fixture.CreateRoomAsync();
+
+        var booking = await CreateOkAsync(Bob, NewBooking(room, At(5)));
+
+        Assert.Equal("bob", booking.GetProperty("ownerId").GetString());
+    }
+
+    private static HttpRequestMessage Request(string method, string url)
+    {
+        var request = new HttpRequestMessage(new HttpMethod(method), url);
+        if (method is "POST" or "PATCH")
+            request.Content = JsonContent.Create(new { });
+        return request;
+    }
+}
