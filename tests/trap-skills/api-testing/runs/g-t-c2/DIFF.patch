@@ -0,0 +1,40 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase(ApiFixture fixture)
+{
+    protected ApiFixture Fixture { get; } = fixture;
+
+    protected HttpClient Alice { get; } = fixture.CreateClient(ApiFixture.AliceKey);
+    protected HttpClient Bob { get; } = fixture.CreateClient(ApiFixture.BobKey);
+    protected HttpClient Admin { get; } = fixture.CreateClient(ApiFixture.AdminKey);
+
+    /// <summary>Целое число минут от полуночи UTC через <paramref name="daysAhead"/> дней: стабильно и в будущем.</summary>
+    protected static DateTimeOffset At(int daysAhead, int hour = 10, int minute = 0) =>
+        new(DateTime.UtcNow.Date.AddDays(daysAhead).AddHours(hour).AddMinutes(minute), TimeSpan.Zero);
+
+    protected static object NewBooking(
+        string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string title = "Планёрка", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes, comment };
+
+    protected static Task<HttpResponseMessage> CreateAsync(HttpClient client, object request) =>
+        client.PostAsJsonAsync("/api/v1/bookings", request);
+
+    /// <summary>Создаёт бронь и возвращает её JSON; падает, если сервис ответил не 201.</summary>
+    protected static async Task<JsonElement> CreateOkAsync(HttpClient client, object request)
+    {
+        var response = await CreateAsync(client, request);
+        Assert.Equal(System.Net.HttpStatusCode.Created, response.StatusCode);
+        return await ContractAssert.ReadJsonAsync(response);
+    }
+
+    protected static Task<HttpResponseMessage> RescheduleAsync(
+        HttpClient client, string bookingId, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{bookingId}", new { startsAt, durationMinutes, version });
+
+    protected static string IdOf(JsonElement booking) => booking.GetProperty("id").GetString()!;
+}
