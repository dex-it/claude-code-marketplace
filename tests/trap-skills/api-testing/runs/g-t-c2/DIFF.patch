+/// <summary>
+/// Расхождения реализации с контрактом api/openapi.yaml (BKG-31). Тесты с этими причинами пропущены,
+/// пока сервис не исправлен; после исправления убрать Skip - тест уже описывает ожидание контракта.
+/// </summary>
+internal static class Discrepancy
+{
+    public const string CreateNoLocation =
+        "BKG-31: POST /bookings - контракт: заголовок Location в 201; сервис его не отдаёт";
+
+    public const string EndsAt =
+        "BKG-31: POST /bookings - контракт: endsAt = startsAt + durationMinutes; сервис считает часами "
+        + "(AddHours(durationMinutes / 60)), для 15/45/90 минут endsAt неверен";
+
+    public const string OverlapProblem =
+        "BKG-31: POST /bookings, PATCH /bookings/{id} - контракт: 409 problem+json code booking-overlap; "
+        + "сервис отвечает 409 application/json {\"error\":\"overlap\"}";
+
+    public const string MalformedIdCode =
+        "BKG-31: /bookings/{bookingId} с не-UUID - контракт: 404 с code booking-not-found; "
+        + "сервис отвечает 404 problem+json без code (не совпал маршрут)";
+
+    public const string EmptyItemsNull =
+        "BKG-31: GET /bookings - контракт: пустой результат - items: []; сервис отдаёт items: null";
+
+    public const string RescheduleNotOwner =
+        "BKG-31: PATCH /bookings/{id} - контракт: 403 not-owner для чужой брони; сервис переносит чужую бронь (200)";
+
+    public const string VersionConflict =
+        "BKG-31: PATCH /bookings/{id} - контракт: 409 version-conflict при устаревшей version; "
+        + "сервис игнорирует version и отвечает 200";
+
+    public const string MissingVersion =
+        "BKG-31: PATCH /bookings/{id} - контракт: version обязателен, без него 400; сервис отвечает 200";
+
+    public const string RepeatCancel =
+        "BKG-31: DELETE /bookings/{id} - контракт: повторная отмена - 204 (FR-11); сервис отвечает 500";
+
+    public const string ListLimitRange =
+        "BKG-31: GET /bookings - контракт: limit вне 1..100 - 400; сервис отвечает 200";
+
+    public const string CreateRoomIdLength =
+        "BKG-31: POST /bookings - контракт: roomId не длиннее 64 - 400; сервис отвечает 404 room-not-found";
+}
