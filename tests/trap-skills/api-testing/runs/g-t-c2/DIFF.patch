+using System.Net;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Проверки формы ответов по схемам api/openapi.yaml.</summary>
+internal static class ContractAssert
+{
+    private static readonly string[] BookingFields =
+        ["id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version"];
+
+    public static async Task<JsonElement> ReadJsonAsync(HttpResponseMessage response)
+    {
+        var body = await response.Content.ReadAsStringAsync();
+        using var doc = JsonDocument.Parse(body);
+        return doc.RootElement.Clone();
+    }
+
+    public static void AssertRoom(JsonElement room)
+    {
+        Assert.Equal(JsonValueKind.Object, room.ValueKind);
+        Assert.Matches("^[a-z0-9-]{1,64}$", room.GetProperty("id").GetString());
+        var name = room.GetProperty("name").GetString()!;
+        Assert.InRange(name.Length, 1, 120);
+        Assert.InRange(room.GetProperty("capacity").GetInt32(), 1, 50);
+        room.GetProperty("floor").GetInt32();
+        var features = room.GetProperty("features");
+        Assert.Equal(JsonValueKind.Array, features.ValueKind);
+        foreach (var feature in features.EnumerateArray())
+            Assert.Contains(feature.GetString(), new[] { "projector", "whiteboard", "videoconf" });
+    }
+
+    public static void AssertBooking(JsonElement booking)
+    {
+        Assert.Equal(JsonValueKind.Object, booking.ValueKind);
+        foreach (var field in BookingFields)
+            Assert.True(booking.TryGetProperty(field, out _), $"В брони нет обязательного поля {field}");
+
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.InRange(booking.GetProperty("roomId").GetString()!.Length, 1, 64);
+        Assert.InRange(booking.GetProperty("title").GetString()!.Length, 1, 120);
+
+        var comment = booking.GetProperty("comment");
+        Assert.True(comment.ValueKind is JsonValueKind.Null or JsonValueKind.String);
+        if (comment.ValueKind == JsonValueKind.String)
+            Assert.True(comment.GetString()!.Length <= 500);
+
+        Assert.Equal(TimeSpan.Zero, booking.GetProperty("startsAt").GetDateTimeOffset().Offset);
+        Assert.Equal(TimeSpan.Zero, booking.GetProperty("endsAt").GetDateTimeOffset().Offset);
+
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0L, uint.MaxValue);
+    }
+
+    /// <summary>Ответ ошибки: application/problem+json со status и кодом из перечня контракта.</summary>
+    public static async Task<JsonElement> AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+
+        var problem = await ReadJsonAsync(response);
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.Equal(JsonValueKind.String, problem.GetProperty("title").ValueKind);
+        Assert.Equal(code, problem.GetProperty("code").GetString());
+        return problem;
+    }
+
+    /// <summary>400: ValidationProblem с errors; <paramref name="field"/> - поле, на которое ждём сообщение.</summary>
+    public static async Task AssertValidationProblemAsync(HttpResponseMessage response, string? field = null)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+
+        var problem = await ReadJsonAsync(response);
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        Assert.Equal(JsonValueKind.String, problem.GetProperty("title").ValueKind);
+        var errors = problem.GetProperty("errors");
+        Assert.Equal(JsonValueKind.Object, errors.ValueKind);
+        if (field is not null)
+        {
+            var messages = errors.GetProperty(field);
+            Assert.Equal(JsonValueKind.Array, messages.ValueKind);
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+}
