@@ -0,0 +1,614 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsTests(ApiFixture fixture) : ApiTestBase(fixture)
+{
+    // ---- POST /api/v1/bookings (FR-03, FR-05, FR-08, FR-09) ----
+
+    [Fact(Skip = Discrepancy.CreateNoLocation)]
+    public async Task Create_ReturnsCreatedBookingWithLocation()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var startsAt = At(3, 10);
+
+        var response = await CreateAsync(Alice, NewBooking(room, startsAt, 60, "Планирование спринта", "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ContractAssert.ReadJsonAsync(response);
+        ContractAssert.AssertBooking(booking);
+        Assert.Equal(room, booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+
+        var location = response.Headers.Location;
+        Assert.NotNull(location);
+        Assert.EndsWith($"/api/v1/bookings/{IdOf(booking)}", location.ToString());
+        Assert.Equal(HttpStatusCode.OK, (await Alice.GetAsync(location)).StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var room = await Fixture.CreateRoomAsync();
+
+        var response = await Alice.PostAsJsonAsync(
+            "/api/v1/bookings", new { roomId = room, title = "Без комментария", startsAt = At(3), durationMinutes = 30 });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ContractAssert.ReadJsonAsync(response);
+        ContractAssert.AssertBooking(booking);
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Theory(Skip = Discrepancy.EndsAt)]
+    [InlineData(15)]
+    [InlineData(45)]
+    [InlineData(90)]
+    public async Task Create_EndsAtIsStartsAtPlusDuration(int durationMinutes)
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var startsAt = At(4, 9);
+
+        var booking = await CreateOkAsync(Alice, NewBooking(room, startsAt, durationMinutes));
+
+        Assert.Equal(durationMinutes, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(durationMinutes), booking.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Create_StartInNonUtcOffset_IsReturnedInUtc()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var startsAt = At(4, 7);
+        var local = startsAt.ToOffset(TimeSpan.FromHours(3));
+
+        var booking = await CreateOkAsync(Alice, NewBooking(room, local));
+
+        ContractAssert.AssertBooking(booking);
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Create_AtLimits_IsAccepted()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var title = new string('т', 120);
+        var comment = new string('к', 500);
+
+        var response = await CreateAsync(Alice, NewBooking(room, At(89, 10), 240, title, comment));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await CreateAsync(Alice, NewBooking("no-such-room", At(3)));
+
+        await ContractAssert.AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Theory]
+    [InlineData("startsAt", "past")]
+    [InlineData("startsAt", "tooFar")]
+    [InlineData("durationMinutes", "10")]
+    [InlineData("durationMinutes", "0")]
+    [InlineData("durationMinutes", "20")]
+    [InlineData("durationMinutes", "255")]
+    [InlineData("durationMinutes", "-15")]
+    [InlineData("title", "empty")]
+    [InlineData("title", "tooLong")]
+    [InlineData("comment", "tooLong")]
+    [InlineData("roomId", "empty")]
+    public async Task Create_InvalidField_Returns400(string field, string kind)
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var request = new Dictionary<string, object?>
+        {
+            ["roomId"] = room,
+            ["title"] = "Встреча",
+            ["startsAt"] = At(3),
+            ["durationMinutes"] = 60,
+            ["comment"] = null
+        };
+        request[field] = (field, kind) switch
+        {
+            ("startsAt", "past") => DateTimeOffset.UtcNow.AddMinutes(-5),
+            ("startsAt", "tooFar") => DateTimeOffset.UtcNow.AddDays(91),
+            ("durationMinutes", _) => int.Parse(kind),
+            ("title", "empty") => "",
+            ("title", "tooLong") => new string('т', 121),
+            ("comment", "tooLong") => new string('к', 501),
+            ("roomId", "empty") => "",
+            _ => throw new ArgumentOutOfRangeException(nameof(kind))
+        };
+
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", request);
+
+        await ContractAssert.AssertValidationProblemAsync(response, field);
+    }
+
+    [Fact(Skip = Discrepancy.CreateRoomIdLength)]
+    public async Task Create_RoomIdLongerThan64_Returns400()
+    {
+        var response = await CreateAsync(Alice, NewBooking(new string('a', 65), At(3)));
+
+        await ContractAssert.AssertValidationProblemAsync(response, "roomId");
+    }
+
+    [Theory]
+    [InlineData("{}")]
+    [InlineData("{\"roomId\":\"orion\"}")]
+    [InlineData("not json")]
+    public async Task Create_MalformedBody_Returns400(string body)
+    {
+        var response = await Alice.PostAsync("/api/v1/bookings", new StringContent(body, Encoding.UTF8, "application/json"));
+
+        await ContractAssert.AssertValidationProblemAsync(response);
+    }
+
+    [Fact(Skip = Discrepancy.OverlapProblem)]
+    public async Task Create_OverlappingActiveBooking_Returns409Overlap()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        await CreateOkAsync(Alice, NewBooking(room, At(6, 10), 60));
+
+        var response = await CreateAsync(Bob, NewBooking(room, At(6, 10, 30), 60));
+
+        await ContractAssert.AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBookings_AreNotOverlapping()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        await CreateOkAsync(Alice, NewBooking(room, At(6, 10), 60));
+
+        var after = await CreateAsync(Bob, NewBooking(room, At(6, 11), 60));
+        var before = await CreateAsync(Bob, NewBooking(room, At(6, 9), 60));
+
+        Assert.Equal(HttpStatusCode.Created, after.StatusCode);
+        Assert.Equal(HttpStatusCode.Created, before.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_IsAccepted()
+    {
+        var first = await Fixture.CreateRoomAsync();
+        var second = await Fixture.CreateRoomAsync();
+        await CreateOkAsync(Alice, NewBooking(first, At(6, 10)));
+
+        var response = await CreateAsync(Alice, NewBooking(second, At(6, 10)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_IsAccepted()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var first = await CreateOkAsync(Alice, NewBooking(room, At(6, 10)));
+        Assert.Equal(HttpStatusCode.NoContent, (await Alice.DeleteAsync($"/api/v1/bookings/{IdOf(first)}")).StatusCode);
+
+        var response = await CreateAsync(Bob, NewBooking(room, At(6, 10)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    // ---- GET /api/v1/bookings/{bookingId} (FR-04) ----
+
+    [Fact]
+    public async Task Get_ReturnsBooking_ToAnyParticipant()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var created = await CreateOkAsync(Alice, NewBooking(room, At(7)));
+
+        var response = await Bob.GetAsync($"/api/v1/bookings/{IdOf(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ContractAssert.ReadJsonAsync(response);
+        ContractAssert.AssertBooking(booking);
+        Assert.Equal(IdOf(created), IdOf(booking));
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Get_UnknownBooking_Returns404BookingNotFound()
+    {
+        var response = await Alice.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await ContractAssert.AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact(Skip = Discrepancy.MalformedIdCode)]
+    public async Task Get_NotAUuid_Returns404BookingNotFound()
+    {
+        var response = await Alice.GetAsync("/api/v1/bookings/not-a-uuid");
+
+        await ContractAssert.AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    // ---- GET /api/v1/bookings (FR-02) ----
+
+    [Fact(Skip = Discrepancy.EmptyItemsNull)]
+    public async Task List_NoBookings_ReturnsEmptyItemsAndNullCursor()
+    {
+        var room = await Fixture.CreateRoomAsync();
+
+        var response = await Alice.GetAsync($"/api/v1/bookings?roomId={room}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ContractAssert.ReadJsonAsync(response);
+        Assert.Equal(JsonValueKind.Array, page.GetProperty("items").ValueKind);
+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_ReturnsBookingsOrderedByStart_IncludingCancelled()
+    {
+        var room = await Fixture.CreateRoomAsync();
+        var third = await CreateOkAsync(Alice, NewBooking(room, At(8, 15)));
