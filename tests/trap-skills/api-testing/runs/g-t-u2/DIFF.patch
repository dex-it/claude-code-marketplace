+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Расхождения реализации с контрактом api/openapi.yaml (1.2.0), найденные в BKG-31. Тесты на них
+/// пропущены (Skip), чтобы `dotnet test` был зелёным; снимать Skip - вместе с исправлением сервиса.
+/// </summary>
+public static class KnownDefects
+{
+    public const string CreateWithoutLocation =
+        "BKG-31: POST /bookings - контракт: заголовок Location /api/v1/bookings/{id}; сервис отвечает 201 без Location";
+
+    public const string EndsAtTruncatedToHours =
+        "BKG-31: POST и PATCH /bookings - контракт: endsAt = startsAt + durationMinutes; сервис прибавляет целые часы (duration / 60), 90 мин даёт +1 ч, 15 мин даёт +0";
+
+    public const string OverlapNotProblem =
+        "BKG-31: POST и PATCH /bookings - контракт: 409 application/problem+json, code booking-overlap; сервис отвечает 409 application/json с телом {error: overlap}";
+
+    public const string EmptyPageItemsNull =
+        "BKG-31: GET /bookings - контракт: пустой результат - items: []; сервис отвечает items: null";
+
+    public const string ListLimitNotValidated =
+        "BKG-31: GET /bookings - контракт: limit 1..100, иначе 400; сервис не проверяет limit (0 и 101 - 200, -5 - 500)";
+
+    public const string RescheduleByNonOwner =
+        "BKG-31: PATCH /bookings/{id} - контракт: не владелец и не администратор - 403 not-owner; сервис переносит чужую бронь, 200";
+
+    public const string StaleVersionAccepted =
+        "BKG-31: PATCH /bookings/{id} - контракт: устаревшая version - 409 version-conflict; сервис игнорирует version из запроса, 200";
+
+    public const string RepeatedCancelFails =
+        "BKG-31: DELETE /bookings/{id} - контракт: повторная отмена - 204; сервис отвечает 500";
+}
