+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingsTests(ApiFixture api) : ApiTestBase(api)
+{
+    private const string Bookings = "/api/v1/bookings";
+
+    // --- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_returns_201_with_booking_and_location()
+    {
+        var startsAt = Api.NextSlot();
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", startsAt, 60, "Планирование спринта", "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadAsync(response);
+        ContractAssert.Booking(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact(Skip = KnownDefects.CreateWithoutLocation)]
+    public async Task Create_returns_location_of_created_booking()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", Api.NextSlot()));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadAsync(response);
+        Assert.Equal(UrlOf(booking), response.Headers.Location?.ToString());
+    }
+
+    [Theory(Skip = KnownDefects.EndsAtTruncatedToHours)]
+    [InlineData(15)]
+    [InlineData(90)]
+    [InlineData(240)]
+    public async Task Create_ends_at_is_start_plus_duration(int duration)
+    {
+        var booking = await CreateBookingAsync(Api.NextSlot(), duration);
+
+        ContractAssert.EndsAtMatchesDuration(booking);
+    }
+
+    [Fact]
+    public async Task Create_without_comment_returns_null_comment()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("vega", Api.NextSlot()));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal(JsonValueKind.Null, (await ReadAsync(response)).GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_is_readable_by_other_member()
+    {
+        var created = await CreateBookingAsync(Api.NextSlot());
+
+        using var bob = Api.Client(ApiFixture.OtherMemberKey);
+        using var response = await bob.GetAsync(UrlOf(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadAsync(response);
+        ContractAssert.Booking(booking);
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Create_accepts_boundary_durations()
+    {
+        using var client = Api.Client();
+        foreach (var duration in new[] { 15, 240 })
+        {
+            using var response = await client.PostAsJsonAsync(Bookings, NewBooking("lyra", Api.NextSlot(), duration));
+            Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+            Assert.Equal(duration, (await ReadAsync(response)).GetProperty("durationMinutes").GetInt32());
+        }
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_rejects_invalid_duration(int duration)
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", Api.NextSlot(), duration));
+
+        await ContractAssert.ValidationAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_rejects_start_in_the_past()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", DateTimeOffset.UtcNow.AddHours(-1)));
+
+        await ContractAssert.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_rejects_start_beyond_90_days()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", DateTimeOffset.UtcNow.AddDays(91)));
+
+        await ContractAssert.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_rejects_too_long_title_and_comment()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(
+            Bookings, NewBooking("orion", Api.NextSlot(), title: new string('t', 121), comment: new string('c', 501)));
+
+        await ContractAssert.ValidationAsync(response, "title", "comment");
+    }
+
+    [Fact]
+    public async Task Create_rejects_empty_title_and_room()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("", Api.NextSlot(), title: ""));
+
+        await ContractAssert.ValidationAsync(response, "roomId", "title");
+    }
+
+    [Fact]
+    public async Task Create_accepts_max_length_title_and_comment()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(
+            Bookings, NewBooking("orion", Api.NextSlot(), title: new string('t', 120), comment: new string('c', 500)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_unknown_room_returns_404_room_not_found()
+    {
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("no-such-room", Api.NextSlot()));
+
+        await ContractAssert.ProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_without_key_returns_401()
+    {
+        using var client = Api.Client(apiKey: null);
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", Api.NextSlot()));
+
+        await ContractAssert.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Create_overlapping_active_booking_returns_409()
+    {
+        var startsAt = Api.NextSlot();
+        await CreateBookingAsync(startsAt, 60);
+
+        using var client = Api.Client(ApiFixture.OtherMemberKey);
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", startsAt.AddMinutes(30), 60));
+
+        Assert.Equal(HttpStatusCode.Conflict, response.StatusCode);
+    }
+
+    [Fact(Skip = KnownDefects.OverlapNotProblem)]
+    public async Task Create_overlapping_active_booking_returns_problem_booking_overlap()
+    {
+        var startsAt = Api.NextSlot();
+        await CreateBookingAsync(startsAt, 60);
+
+        using var client = Api.Client(ApiFixture.OtherMemberKey);
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", startsAt.AddMinutes(30), 60));
+
+        await ContractAssert.ProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_adjacent_booking_is_allowed()
+    {
+        var startsAt = Api.NextSlot();
+        await CreateBookingAsync(startsAt, 60);
+
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", startsAt.AddMinutes(60), 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_same_time_in_other_room_is_allowed()
+    {
+        var startsAt = Api.NextSlot();
+        await CreateBookingAsync(startsAt, roomId: "orion");
+
+        using var client = Api.Client();
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("vega", startsAt));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_over_cancelled_booking_is_allowed()
+    {
+        var startsAt = Api.NextSlot();
+        var first = await CreateBookingAsync(startsAt);
+        using var client = Api.Client();
+        using (var cancel = await client.DeleteAsync(UrlOf(first)))
+            Assert.Equal(HttpStatusCode.NoContent, cancel.StatusCode);
+
+        using var response = await client.PostAsJsonAsync(Bookings, NewBooking("orion", startsAt));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_concurrent_requests_for_same_time_book_exactly_once()
+    {
+        var startsAt = Api.NextSlot();
+        var requests = Enumerable.Range(0, 8).Select(async _ =>
+        {
+            using var client = Api.Client();
+            using var response = await client.PostAsJsonAsync(Bookings, NewBooking("lyra", startsAt));
+            return response.StatusCode;
+        });
+
+        var statuses = await Task.WhenAll(requests);
+
+        Assert.Equal(1, statuses.Count(s => s == HttpStatusCode.Created));
+        Assert.All(statuses.Where(s => s != HttpStatusCode.Created), s => Assert.Equal(HttpStatusCode.Conflict, s));
+    }
+
+    // --- GET /api/v1/bookings/{id}
+
+    [Fact]
+    public async Task Get_unknown_booking_returns_404_booking_not_found()
+    {
+        using var client = Api.Client();
+        using var response = await client.GetAsync($"{Bookings}/{Guid.NewGuid()}");
+
+        await ContractAssert.ProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_without_key_returns_401()
+    {
+        using var client = Api.Client(apiKey: null);
+        using var response = await client.GetAsync($"{Bookings}/{Guid.NewGuid()}");
+
+        await ContractAssert.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- GET /api/v1/bookings
+
+    [Fact]
+    public async Task List_returns_bookings_of_period_ordered_by_start_with_cancelled()
+    {
+        var slot = Api.NextSlot();
+        var late = await CreateBookingAsync(slot.AddHours(2), roomId: "vega");
+        var early = await CreateBookingAsync(slot, roomId: "orion");
+        var cancelled = await CreateBookingAsync(slot.AddHours(1), roomId: "lyra");
+        using var client = Api.Client();
+        using (var cancel = await client.DeleteAsync(UrlOf(cancelled)))
+            Assert.Equal(HttpStatusCode.NoContent, cancel.StatusCode);
+
+        var page = await ListAsync(client, slot, slot.AddHours(3));
+
+        var items = ItemsOf(page);
+        items.ForEach(ContractAssert.Booking);
+        Assert.Equal(
+            [early.GetProperty("id").GetGuid(), cancelled.GetProperty("id").GetGuid(), late.GetProperty("id").GetGuid()],
+            items.Select(b => b.GetProperty("id").GetGuid()));
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_filters_by_room()
+    {
+        var slot = Api.NextSlot();
+        var vega = await CreateBookingAsync(slot, roomId: "vega");
+        await CreateBookingAsync(slot, roomId: "orion");
+        using var client = Api.Client();
+
+        var page = await ListAsync(client, slot, slot.AddHours(1), "&roomId=vega");
+
+        var item = Assert.Single(ItemsOf(page));
+        Assert.Equal(vega.GetProperty("id").GetGuid(), item.GetProperty("id").GetGuid());
+    }
+
+    [Fact]
+    public async Task List_period_includes_booking_ending_after_from_and_starting_before_to()
+    {
+        var slot = Api.NextSlot();
+        var booking = await CreateBookingAsync(slot, 60);
+        using var client = Api.Client();
+
+        var overlapping = await ListAsync(client, slot.AddMinutes(30), slot.AddMinutes(45), "&roomId=orion");
+        var touchingEnd = await ListAsync(client, slot.AddMinutes(60), slot.AddMinutes(120), "&roomId=orion");
+        var touchingStart = await ListAsync(client, slot.AddMinutes(-60), slot, "&roomId=orion");
+
+        Assert.Equal(
+            booking.GetProperty("id").GetGuid(),
+            Assert.Single(ItemsOf(overlapping)).GetProperty("id").GetGuid());
+        Assert.Empty(ItemsOf(touchingEnd));
+        Assert.Empty(ItemsOf(touchingStart));
+    }
+
+    [Fact(Skip = KnownDefects.EmptyPageItemsNull)]
+    public async Task List_empty_result_returns_empty_items_array_and_null_cursor()
+    {
+        using var client = Api.Client();
+
+        var page = await ListAsync(client, DateTimeOffset.UtcNow.AddDays(-400), DateTimeOffset.UtcNow.AddDays(-399));
+
+        Assert.Equal(JsonValueKind.Array, page.GetProperty("items").ValueKind);
+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_pages_through_cursor_without_gaps_or_duplicates()
+    {
+        var slot = Api.NextSlot();
+        var ids = new List<Guid>();
+        for (var i = 0; i < 3; i++)
+            ids.Add((await CreateBookingAsync(slot.AddMinutes(60 * i), roomId: "lyra")).GetProperty("id").GetGuid());
+        using var client = Api.Client();
+
+        var first = await ListAsync(client, slot, slot.AddHours(3), "&limit=2");
+        var firstItems = ItemsOf(first);
+        var cursor = first.GetProperty("nextCursor").GetString();
+        Assert.Equal(2, firstItems.Count);
+        Assert.False(string.IsNullOrEmpty(cursor));
+
+        var second = await ListAsync(client, slot, slot.AddHours(3), $"&limit=2&cursor={Uri.EscapeDataString(cursor!)}");
+        var secondItems = ItemsOf(second);
+        Assert.Single(secondItems);
+        Assert.Equal(JsonValueKind.Null, second.GetProperty("nextCursor").ValueKind);
+
+        Assert.Equal(ids, firstItems.Concat(secondItems).Select(b => b.GetProperty("id").GetGuid()));
