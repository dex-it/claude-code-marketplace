@@ -0,0 +1,70 @@
+using System.Net;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Проверки схем и ошибок из api/openapi.yaml (1.2.0).</summary>
+public static class ContractAssert
+{
+    private static readonly string[] BookingFields =
+        ["id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version"];
+
+    public static void Room(JsonElement room)
+    {
+        Assert.Matches("^[a-z0-9-]{1,64}$", room.GetProperty("id").GetString());
+        Assert.InRange(room.GetProperty("name").GetString()!.Length, 1, 120);
+        Assert.InRange(room.GetProperty("capacity").GetInt32(), 1, 50);
+        room.GetProperty("floor").GetInt32();
+        foreach (var feature in room.GetProperty("features").EnumerateArray())
+            Assert.Contains(feature.GetString(), new[] { "projector", "whiteboard", "videoconf" });
+    }
+
+    public static void Booking(JsonElement booking)
+    {
+        foreach (var field in BookingFields)
+            Assert.True(booking.TryGetProperty(field, out _), $"В брони нет обязательного поля {field}");
+
+        Assert.True(booking.GetProperty("id").TryGetGuid(out _));
+        Assert.InRange(booking.GetProperty("title").GetString()!.Length, 1, 120);
+        Assert.True(booking.GetProperty("comment").ValueKind is JsonValueKind.Null or JsonValueKind.String);
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+        Assert.True(booking.GetProperty("startsAt").TryGetDateTimeOffset(out _));
+        Assert.True(booking.GetProperty("endsAt").TryGetDateTimeOffset(out _));
+    }
+
+    /// <summary>endsAt = startsAt + durationMinutes (описание поля в схеме Booking).</summary>
+    public static void EndsAtMatchesDuration(JsonElement booking)
+    {
+        var startsAt = booking.GetProperty("startsAt").GetDateTimeOffset();
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.Equal(startsAt.AddMinutes(duration), booking.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    public static async Task ProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = JsonDocument.Parse(await response.Content.ReadAsStringAsync()).RootElement;
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrEmpty(problem.GetProperty("title").GetString()));
+        Assert.Equal(code, problem.GetProperty("code").GetString());
+    }
+
+    public static async Task ValidationAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = JsonDocument.Parse(await response.Content.ReadAsStringAsync()).RootElement;
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        var errors = problem.GetProperty("errors");
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"Нет ошибки поля {field}");
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+}
