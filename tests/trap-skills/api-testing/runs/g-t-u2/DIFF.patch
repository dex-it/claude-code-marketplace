+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public abstract class ApiTestBase(ApiFixture api)
+{
+    protected ApiFixture Api { get; } = api;
+
+    protected static object NewBooking(string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string title = "Планирование", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes, comment };
+
+    protected async Task<JsonElement> CreateBookingAsync(
+        DateTimeOffset startsAt, int durationMinutes = 60, string roomId = "orion", string? apiKey = ApiFixture.MemberKey)
+    {
+        using var client = Api.Client(apiKey);
+        using var response = await client.PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId, startsAt, durationMinutes));
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadAsync(response);
+    }
+
+    protected static async Task<JsonElement> ReadAsync(HttpResponseMessage response) =>
+        JsonDocument.Parse(await response.Content.ReadAsStringAsync()).RootElement.Clone();
+
+    /// <summary>Элементы страницы; null вместо массива (расхождение с контрактом) читается как пустой список.</summary>
+    protected static List<JsonElement> ItemsOf(JsonElement page) =>
+        page.GetProperty("items") is { ValueKind: JsonValueKind.Array } items ? items.EnumerateArray().ToList() : [];
+
+    protected static string UrlOf(JsonElement booking) => $"/api/v1/bookings/{booking.GetProperty("id").GetGuid()}";
+}
