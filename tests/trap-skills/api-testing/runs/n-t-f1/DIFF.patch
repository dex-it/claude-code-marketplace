+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Testcontainers.PostgreSql;
+using Xunit;
+
+namespace Bookings.Api.IntegrationTests;
+
+/// <summary>Сервис на настоящем PostgreSQL: запрет пересечений брони держит ограничение БД.</summary>
+public sealed class BookingsApiFactory : WebApplicationFactory<Program>, IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+
+    public async Task InitializeAsync() => await _postgres.StartAsync();
+
+    async Task IAsyncLifetime.DisposeAsync()
+    {
+        await base.DisposeAsync();
+        await _postgres.DisposeAsync();
+    }
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseSetting("ConnectionStrings:Bookings", _postgres.GetConnectionString());
+        builder.UseSetting("Database:Initialize", "true");
+        builder.UseSetting("Auth:Keys:0:key", AliceKey);
+        builder.UseSetting("Auth:Keys:0:userId", "alice");
+        builder.UseSetting("Auth:Keys:0:role", "member");
+        builder.UseSetting("Auth:Keys:1:key", BobKey);
+        builder.UseSetting("Auth:Keys:1:userId", "bob");
+        builder.UseSetting("Auth:Keys:1:role", "member");
+        builder.UseSetting("Auth:Keys:2:key", AdminKey);
+        builder.UseSetting("Auth:Keys:2:userId", "admin");
+        builder.UseSetting("Auth:Keys:2:role", "admin");
+    }
+
+    public HttpClient CreateClientWithKey(string? key)
+    {
+        var client = CreateClient();
+        if (key is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", key);
+        return client;
+    }
+}
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<BookingsApiFactory>
+{
+    public const string Name = "api";
+}
