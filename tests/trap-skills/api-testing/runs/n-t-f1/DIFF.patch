+
+    [Fact]
+    public async Task Reschedule_ByNonOwnerMember_Returns403NotOwner()
+    {
+        var starts = Slots.Take(2);
+        var created = await ApiCalls.CreateOkAsync(_alice, "orion", starts[0]);
+
+        var response = await ApiCalls.RescheduleAsync(
