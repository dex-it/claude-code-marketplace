+
+    // ---- FR-12: ключ доступа ----
+
+    [Theory]
+    [InlineData("GET", "/api/v1/bookings")]
+    [InlineData("POST", "/api/v1/bookings")]
+    [InlineData("GET", "/api/v1/bookings/3f2b8a64-5717-4562-b3fc-2c963f66afa6")]
+    [InlineData("PATCH", "/api/v1/bookings/3f2b8a64-5717-4562-b3fc-2c963f66afa6")]
+    [InlineData("DELETE", "/api/v1/bookings/3f2b8a64-5717-4562-b3fc-2c963f66afa6")]
+    public async Task BookingOperations_WithoutKeyOrWithUnknownKey_Return401(string method, string url)
+    {
+        foreach (var key in new string?[] { null, "wrong-key" })
+        {
+            var request = new HttpRequestMessage(new HttpMethod(method), url);
+            if (method is "POST" or "PATCH")
+                request.Content = JsonContent.Create(new { roomId = "orion", title = "x", startsAt = Json.Iso(Slots.TakeOne()), durationMinutes = 60, version = 1 });
+
+            var response = await factory.CreateClientWithKey(key).SendAsync(request);
+
+            await ContractAssert.ProblemAsync(response, 401, "unauthorized");
+        }
+    }
+}
