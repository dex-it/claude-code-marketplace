+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.IntegrationTests;
+
+/// <summary>Операции комнат: listRooms, getRoom, listRoomBookings (FR-01, FR-02).</summary>
+[Collection(ApiCollection.Name)]
+public class RoomsApiTests(BookingsApiFactory factory)
+{
+    private readonly HttpClient _alice = factory.CreateClientWithKey(BookingsApiFactory.AliceKey);
+
+    [Fact]
+    public async Task ListRooms_ReturnsPageOrderedById()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await Json.ReadAsync(response);
+        var items = body.GetProperty("items").EnumerateArray().ToList();
+        Assert.Equal(3, body.GetProperty("total").GetInt32());
+        Assert.Equal(["lyra", "orion", "vega"], items.Select(i => i.GetProperty("id").GetString()));
+        items.ForEach(ContractAssert.Room);
+    }
+
+    [Fact]
+    public async Task ListRooms_LimitAndOffset_SlicePageAndKeepTotal()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms?limit=1&offset=1");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await Json.ReadAsync(response);
+        var item = Assert.Single(body.GetProperty("items").EnumerateArray());
+        Assert.Equal("orion", item.GetProperty("id").GetString());
+        Assert.Equal(3, body.GetProperty("total").GetInt32());
+    }
+
+    [Fact]
+    public async Task ListRooms_OffsetBeyondEnd_ReturnsEmptyItems()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms?offset=10");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await Json.ReadAsync(response);
+        Assert.Empty(body.GetProperty("items").EnumerateArray());
+        Assert.Equal(3, body.GetProperty("total").GetInt32());
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("offset=-1", "offset")]
+    [InlineData("limit=abc", "limit")]
+    public async Task ListRooms_InvalidPaging_Returns400WithField(string query, string field)
+    {
+        var response = await _alice.GetAsync($"/api/v1/rooms?{query}");
+
+        await ContractAssert.ValidationAsync(response, field);
+    }
+
+    [Fact]
+    public async Task GetRoom_Existing_ReturnsRoomCard()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms/orion");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var room = await Json.ReadAsync(response);
+        ContractAssert.Room(room);
+        Assert.Equal("orion", room.GetProperty("id").GetString());
+        Assert.Equal("Orion", room.GetProperty("name").GetString());
+        Assert.Equal(8, room.GetProperty("capacity").GetInt32());
+        Assert.Equal(3, room.GetProperty("floor").GetInt32());
+        Assert.Equal(["projector", "whiteboard"], room.GetProperty("features").EnumerateArray().Select(f => f.GetString()));
+    }
+
+    [Theory]
+    [InlineData("no-such-room")]
+    [InlineData("Bad_Id")]
+    public async Task GetRoom_Unknown_Returns404RoomNotFound(string roomId)
+    {
+        var response = await _alice.GetAsync($"/api/v1/rooms/{roomId}");
+
+        await ContractAssert.ProblemAsync(response, 404, "room-not-found");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_ReturnsActiveAndCancelledInPeriodAscending()
+    {
+        var starts = Slots.Take(3);
+        var late = await ApiCalls.CreateOkAsync(_alice, "vega", starts[2], 30);
+        var cancelled = await ApiCalls.CreateOkAsync(_alice, "vega", starts[0], 30);
+        var middle = await ApiCalls.CreateOkAsync(_alice, "vega", starts[1], 30);
+        (await _alice.DeleteAsync($"/api/v1/bookings/{cancelled.GetProperty("id").GetString()}")).EnsureSuccessStatusCode();
+        var from = Json.Iso(starts[0].AddMinutes(-1));
+        var to = Json.Iso(starts[2].AddHours(1));
+
+        var response = await _alice.GetAsync($"/api/v1/rooms/vega/bookings?from={from}&to={to}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var items = (await Json.ReadAsync(response)).EnumerateArray().ToList();
+        items.ForEach(ContractAssert.Booking);
+        Assert.Equal(
+            [cancelled.GetProperty("id").GetString(), middle.GetProperty("id").GetString(), late.GetProperty("id").GetString()],
+            items.Select(i => i.GetProperty("id").GetString()));
+        Assert.Equal(["cancelled", "active", "active"], items.Select(i => i.GetProperty("status").GetString()));
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_PeriodBounds_FromIsExclusiveOfEndedAndToOfStarted()
+    {
+        var start = Slots.TakeOne();
+        var booking = await ApiCalls.CreateOkAsync(_alice, "vega", start, 60);
+        var id = booking.GetProperty("id").GetString();
+
+        // Бронь заканчивается ровно в from - в период не входит; начинается ровно в to - не входит.
+        var endedAtFrom = await _alice.GetAsync($"/api/v1/rooms/vega/bookings?from={Json.Iso(start.AddHours(1))}&to={Json.Iso(start.AddHours(3))}");
+        var startedAtTo = await _alice.GetAsync($"/api/v1/rooms/vega/bookings?from={Json.Iso(start.AddHours(-2))}&to={Json.Iso(start)}");
+        var inside = await _alice.GetAsync($"/api/v1/rooms/vega/bookings?from={Json.Iso(start.AddMinutes(30))}&to={Json.Iso(start.AddHours(2))}");
+
+        Assert.Empty((await Json.ReadAsync(endedAtFrom)).EnumerateArray());
+        Assert.Empty((await Json.ReadAsync(startedAtTo)).EnumerateArray());
+        Assert.Equal(id, Assert.Single((await Json.ReadAsync(inside)).EnumerateArray()).GetProperty("id").GetString());
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_RoomWithoutBookingsInPeriod_ReturnsEmptyArray()
+    {
+        var start = Slots.TakeOne();
+
+        var response = await _alice.GetAsync(
+            $"/api/v1/rooms/lyra/bookings?from={Json.Iso(start)}&to={Json.Iso(start.AddHours(1))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await Json.ReadAsync(response);
+        Assert.Equal(JsonValueKind.Array, body.ValueKind);
+        Assert.Empty(body.EnumerateArray());
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await _alice.GetAsync("/api/v1/rooms/no-such-room/bookings");
+
+        await ContractAssert.ProblemAsync(response, 404, "room-not-found");
+    }
+
+    [Theory]
+    [InlineData("from=yesterday")]
+    [InlineData("to=not-a-date")]
+    public async Task ListRoomBookings_InvalidPeriod_Returns400(string query)
+    {
+        var response = await _alice.GetAsync($"/api/v1/rooms/orion/bookings?{query}");
+
+        await ContractAssert.ValidationAsync(response);
+    }
+
+    [Theory]
+    [InlineData("/api/v1/rooms")]
+    [InlineData("/api/v1/rooms/orion")]
+    [InlineData("/api/v1/rooms/orion/bookings")]
+    public async Task RoomOperations_WithoutKeyOrWithUnknownKey_Return401(string url)
+    {
+        var anonymous = await factory.CreateClientWithKey(null).GetAsync(url);
+        var unknown = await factory.CreateClientWithKey("wrong-key").GetAsync(url);
+
+        await ContractAssert.ProblemAsync(anonymous, 401, "unauthorized");
+        await ContractAssert.ProblemAsync(unknown, 401, "unauthorized");
+    }
+}
