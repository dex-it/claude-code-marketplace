@@ -0,0 +1,147 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.IntegrationTests;
+
+/// <summary>
+/// Свободные слоты времени: база общая для всех тестов, поэтому каждый тест берёт свои
+/// непересекающиеся 4-часовые слоты в пределах 90 дней вперёд.
+/// </summary>
+public static class Slots
+{
+    private static readonly object Gate = new();
+    private static readonly DateTimeOffset Origin = new(DateTimeOffset.UtcNow.Date.AddDays(2), TimeSpan.Zero);
+    private static int _next;
+
+    public static DateTimeOffset[] Take(int count)
+    {
+        lock (Gate)
+        {
+            var result = new DateTimeOffset[count];
+            for (var i = 0; i < count; i++)
+                result[i] = Origin.AddHours(4 * _next++);
+            if (_next > 80 * 6)
+                throw new InvalidOperationException("Слоты тестов исчерпаны.");
+            return result;
+        }
+    }
+
+    public static DateTimeOffset TakeOne() => Take(1)[0];
+}
+
+public static class Json
+{
+    public static async Task<JsonElement> ReadAsync(HttpResponseMessage response)
+    {
+        var text = await response.Content.ReadAsStringAsync();
+        return JsonDocument.Parse(text).RootElement.Clone();
+    }
+
+    public static string Iso(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
+}
+
+public static class ApiCalls
+{
+    public static Task<HttpResponseMessage> CreateAsync(
+        HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60,
+        string title = "Планирование", string? comment = null) =>
+        client.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId,
+            title,
+            startsAt = Json.Iso(startsAt),
+            durationMinutes,
+            comment
+        });
+
+    public static async Task<JsonElement> CreateOkAsync(
+        HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60)
+    {
+        var response = await CreateAsync(client, roomId, startsAt, durationMinutes);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await Json.ReadAsync(response);
+    }
+
+    public static Task<HttpResponseMessage> RescheduleAsync(
+        HttpClient client, string id, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{id}", new
+        {
+            startsAt = Json.Iso(startsAt),
+            durationMinutes,
+            version
+        });
+}
+
+public static class ContractAssert
+{
+    private static readonly string[] ProblemCodes =
+    [
+        "unauthorized", "room-not-found", "booking-not-found", "not-owner",
+        "booking-overlap", "version-conflict", "booking-cancelled"
+    ];
+
+    public static void Room(JsonElement room)
+    {
+        Assert.Matches("^[a-z0-9-]{1,64}$", room.GetProperty("id").GetString()!);
+        Assert.InRange(room.GetProperty("name").GetString()!.Length, 1, 120);
+        Assert.InRange(room.GetProperty("capacity").GetInt32(), 1, 50);
+        room.GetProperty("floor").GetInt32();
+        var features = room.GetProperty("features");
+        Assert.Equal(JsonValueKind.Array, features.ValueKind);
+        foreach (var feature in features.EnumerateArray())
+            Assert.Contains(feature.GetString(), new[] { "projector", "whiteboard", "videoconf" });
+    }
+
+    public static void Booking(JsonElement booking)
+    {
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.InRange(booking.GetProperty("roomId").GetString()!.Length, 1, 64);
+        Assert.InRange(booking.GetProperty("title").GetString()!.Length, 1, 120);
+        var comment = booking.GetProperty("comment");
+        Assert.True(comment.ValueKind is JsonValueKind.Null or JsonValueKind.String);
+        var startsAt = booking.GetProperty("startsAt").GetDateTimeOffset();
+        var endsAt = booking.GetProperty("endsAt").GetDateTimeOffset();
+        Assert.Equal(TimeSpan.Zero, startsAt.Offset);
+        Assert.Equal(TimeSpan.Zero, endsAt.Offset);
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        Assert.Equal(startsAt.AddMinutes(duration), endsAt);
+        Assert.False(string.IsNullOrEmpty(booking.GetProperty("ownerId").GetString()));
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+    }
+
+    public static async Task<JsonElement> ProblemAsync(HttpResponseMessage response, int status, string code)
+    {
+        Assert.Equal(status, (int)response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await Json.ReadAsync(response);
+        Assert.Equal(status, body.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrEmpty(body.GetProperty("title").GetString()));
+        Assert.Contains(code, ProblemCodes);
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        return body;
+    }
+
+    public static async Task<JsonElement> ValidationAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(400, (int)response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await Json.ReadAsync(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        var errors = body.GetProperty("errors");
+        var names = errors.EnumerateObject().Select(p => p.Name).ToList();
+        foreach (var field in fields)
+            Assert.Contains(field, names);
+        foreach (var property in errors.EnumerateObject())
+        {
+            Assert.Equal(JsonValueKind.Array, property.Value.ValueKind);
+            Assert.All(property.Value.EnumerateArray(), m => Assert.Equal(JsonValueKind.String, m.ValueKind));
+        }
+
+        return body;
+    }
+}
