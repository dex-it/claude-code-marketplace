+
+    [Fact]
+    public async Task Reschedule_StaleVersion_Returns409VersionConflict()
+    {
+        var starts = Slots.Take(3);
+        var created = await ApiCalls.CreateOkAsync(_alice, "orion", starts[0]);
+        var staleVersion = created.GetProperty("version").GetInt64();
+        (await ApiCalls.RescheduleAsync(_alice, Id(created), starts[1], 60, staleVersion)).EnsureSuccessStatusCode();
