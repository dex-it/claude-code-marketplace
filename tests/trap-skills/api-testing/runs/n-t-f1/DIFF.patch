+    [Fact]
+    public async Task Cancel_ByAdmin_Returns204()
+    {
+        var created = await ApiCalls.CreateOkAsync(_alice, "orion", Slots.TakeOne());
+
+        var response = await _admin.DeleteAsync($"/api/v1/bookings/{Id(created)}");
