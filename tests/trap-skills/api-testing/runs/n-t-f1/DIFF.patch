@@ -0,0 +1,596 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.IntegrationTests;
+
+/// <summary>Операции броней: listBookings, createBooking, getBooking, rescheduleBooking, cancelBooking (FR-02..FR-12).</summary>
+[Collection(ApiCollection.Name)]
+public class BookingsApiTests(BookingsApiFactory factory)
+{
+    private readonly HttpClient _alice = factory.CreateClientWithKey(BookingsApiFactory.AliceKey);
+    private readonly HttpClient _bob = factory.CreateClientWithKey(BookingsApiFactory.BobKey);
+    private readonly HttpClient _admin = factory.CreateClientWithKey(BookingsApiFactory.AdminKey);
+
+    private static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    // ---- createBooking ----
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithLocationAndOwnerFromKey()
+    {
+        var start = Slots.TakeOne();
+
+        var response = await ApiCalls.CreateAsync(_alice, "orion", start, 90, "Планирование спринта", "Принести ноутбуки");
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await Json.ReadAsync(response);
+        ContractAssert.Booking(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(start, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(start.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+        var location = response.Headers.Location;
+        Assert.NotNull(location);
+        Assert.Equal($"/api/v1/bookings/{Id(booking)}", location.IsAbsoluteUri ? location.AbsolutePath : location.OriginalString);
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsCommentNull()
+    {
+        var response = await ApiCalls.CreateAsync(_alice, "orion", Slots.TakeOne(), comment: null);
+
+        var booking = await Json.ReadAsync(response);
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_StartWithOffset_IsReturnedInUtc()
+    {
+        var start = Slots.TakeOne();
+        var local = start.ToOffset(TimeSpan.FromHours(3)).ToString("yyyy-MM-dd'T'HH:mm:sszzz");
+
+        var response = await _alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion",
+            title = "Со смещением",
+            startsAt = local,
+            durationMinutes = 60
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await Json.ReadAsync(response);
+        var startsAt = booking.GetProperty("startsAt").GetDateTimeOffset();
+        Assert.Equal(start, startsAt);
+        Assert.Equal(TimeSpan.Zero, startsAt.Offset);
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_BoundaryDuration_IsAccepted(int minutes)
+    {
+        var response = await ApiCalls.CreateAsync(_alice, "orion", Slots.TakeOne(), minutes);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var response = await ApiCalls.CreateAsync(_alice, "orion", Slots.TakeOne(), minutes);
+
+        await ContractAssert.ValidationAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_StartInThePast_Returns400()
+    {
+        var response = await ApiCalls.CreateAsync(_alice, "orion", DateTimeOffset.UtcNow.AddHours(-1));
+
+        await ContractAssert.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await ApiCalls.CreateAsync(_alice, "orion", DateTimeOffset.UtcNow.AddDays(91));
+
+        await ContractAssert.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_TitleTooLongOrBlank_Returns400()
+    {
+        var tooLong = await ApiCalls.CreateAsync(_alice, "orion", Slots.TakeOne(), title: new string('я', 121));
+        var blank = await ApiCalls.CreateAsync(_alice, "orion", Slots.TakeOne(), title: "   ");
+
+        await ContractAssert.ValidationAsync(tooLong, "title");
+        await ContractAssert.ValidationAsync(blank, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf120AndCommentOf500_AreAccepted()
+    {
+        var response = await ApiCalls.CreateAsync(
+            _alice, "orion", Slots.TakeOne(), title: new string('я', 120), comment: new string('к', 500));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_CommentTooLong_Returns400()
+    {
+        var response = await ApiCalls.CreateAsync(_alice, "orion", Slots.TakeOne(), comment: new string('к', 501));
+
+        await ContractAssert.ValidationAsync(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_MissingRequiredFields_Returns400()
+    {
+        var response = await _alice.PostAsJsonAsync("/api/v1/bookings", new { roomId = "orion" });
+
+        await ContractAssert.ValidationAsync(response);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await ApiCalls.CreateAsync(_alice, "no-such-room", Slots.TakeOne());
+
+        await ContractAssert.ProblemAsync(response, 404, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_OverlapWithActiveBooking_Returns409BookingOverlap()
+    {
+        var start = Slots.TakeOne();
+        await ApiCalls.CreateOkAsync(_alice, "orion", start, 60);
+
+        var response = await ApiCalls.CreateAsync(_bob, "orion", start.AddMinutes(30), 60);
+
+        await ContractAssert.ProblemAsync(response, 409, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBookings_AreNotOverlap()
+    {
+        var start = Slots.TakeOne();
+        await ApiCalls.CreateOkAsync(_alice, "orion", start, 60);
+
+        var after = await ApiCalls.CreateAsync(_bob, "orion", start.AddHours(1), 60);
+        var before = await ApiCalls.CreateAsync(_bob, "orion", start.AddHours(-1), 60);
+
+        Assert.Equal(HttpStatusCode.Created, after.StatusCode);
+        Assert.Equal(HttpStatusCode.Created, before.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_IsAllowed()
+    {
+        var start = Slots.TakeOne();
+        await ApiCalls.CreateOkAsync(_alice, "orion", start, 60);
+
+        var response = await ApiCalls.CreateAsync(_alice, "vega", start, 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_IsAllowed()
+    {
+        var start = Slots.TakeOne();
+        var first = await ApiCalls.CreateOkAsync(_alice, "orion", start, 60);
+        (await _alice.DeleteAsync($"/api/v1/bookings/{Id(first)}")).EnsureSuccessStatusCode();
+
+        var response = await ApiCalls.CreateAsync(_bob, "orion", start, 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    // ---- getBooking ----
+
+    [Fact]
+    public async Task Get_Existing_IsVisibleToNonOwner()
+    {
+        var created = await ApiCalls.CreateOkAsync(_alice, "orion", Slots.TakeOne(), 45);
+
+        var response = await _bob.GetAsync($"/api/v1/bookings/{Id(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await Json.ReadAsync(response);
+        ContractAssert.Booking(booking);
+        Assert.Equal(Id(created), Id(booking));
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await _alice.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await ContractAssert.ProblemAsync(response, 404, "booking-not-found");
+    }
+
+    [Theory(Skip = "Расхождение 1 (BKG-31): id не uuid - сервис отвечает 404 без code, контракт ждёт code booking-not-found")]
+    [InlineData("GET")]
+    [InlineData("PATCH")]
+    [InlineData("DELETE")]
+    public async Task BookingById_IdIsNotUuid_Returns404BookingNotFound(string method)
+    {
+        var request = new HttpRequestMessage(new HttpMethod(method), "/api/v1/bookings/not-a-uuid");
+        if (method == "PATCH")
+            request.Content = JsonContent.Create(new { startsAt = Json.Iso(Slots.TakeOne()), durationMinutes = 60, version = 1 });
+
+        var response = await _alice.SendAsync(request);
+
+        await ContractAssert.ProblemAsync(response, 404, "booking-not-found");
+    }
+
+    // ---- listBookings ----
+
+    [Fact]
+    public async Task List_ReturnsActiveAndCancelledOrderedByStart()
+    {
+        var starts = Slots.Take(3);
+        var third = await ApiCalls.CreateOkAsync(_alice, "lyra", starts[2], 30);
+        var first = await ApiCalls.CreateOkAsync(_alice, "lyra", starts[0], 30);
+        var second = await ApiCalls.CreateOkAsync(_bob, "lyra", starts[1], 30);
+        (await _bob.DeleteAsync($"/api/v1/bookings/{Id(second)}")).EnsureSuccessStatusCode();
+        var window = $"from={Json.Iso(starts[0].AddMinutes(-1))}&to={Json.Iso(starts[2].AddHours(1))}";
+
+        var response = await _alice.GetAsync($"/api/v1/bookings?roomId=lyra&{window}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await Json.ReadAsync(response);
+        var items = body.GetProperty("items").EnumerateArray().ToList();
+        items.ForEach(ContractAssert.Booking);
+        Assert.Equal([Id(first), Id(second), Id(third)], items.Select(Id));
+        Assert.Equal(["active", "cancelled", "active"], items.Select(i => i.GetProperty("status").GetString()));
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_FilterByRoom_ExcludesOtherRooms()
+    {
+        var start = Slots.TakeOne();
+        var orion = await ApiCalls.CreateOkAsync(_alice, "orion", start, 60);
+        await ApiCalls.CreateOkAsync(_alice, "vega", start, 60);
+        var window = $"from={Json.Iso(start.AddMinutes(-1))}&to={Json.Iso(start.AddHours(2))}";
+
+        var response = await _alice.GetAsync($"/api/v1/bookings?roomId=orion&{window}");
+
+        var body = await Json.ReadAsync(response);
+        Assert.Equal(Id(orion), Id(Assert.Single(body.GetProperty("items").EnumerateArray())));
+    }
+
+    [Fact]
+    public async Task List_EmptyResult_ReturnsEmptyItemsAndNullCursor()
+    {
+        var start = Slots.TakeOne();
+
+        var response = await _alice.GetAsync(
+            $"/api/v1/bookings?from={Json.Iso(start)}&to={Json.Iso(start.AddHours(1))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await Json.ReadAsync(response);
+        Assert.Empty(body.GetProperty("items").EnumerateArray());
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_CursorPaging_WalksAllPagesWithoutGapsOrDuplicates()
+    {
+        var starts = Slots.Take(5);
+        var expected = new List<string>();
+        foreach (var start in starts)
+            expected.Add(Id(await ApiCalls.CreateOkAsync(_alice, "lyra", start, 30)));
+        var window = $"roomId=lyra&from={Json.Iso(starts[0].AddMinutes(-1))}&to={Json.Iso(starts[^1].AddHours(1))}&limit=2";
+
+        var seen = new List<string>();
+        string? cursor = null;
+        var pages = 0;
+        do
+        {
+            var url = $"/api/v1/bookings?{window}" + (cursor is null ? "" : $"&cursor={Uri.EscapeDataString(cursor)}");
+            var response = await _alice.GetAsync(url);
+            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+            var body = await Json.ReadAsync(response);
+            var items = body.GetProperty("items").EnumerateArray().ToList();
+            Assert.InRange(items.Count, 1, 2);
+            seen.AddRange(items.Select(Id));
+            var next = body.GetProperty("nextCursor");
+            cursor = next.ValueKind == JsonValueKind.Null ? null : next.GetString();
+            pages++;
+        }
+        while (cursor is not null && pages < 10);
+
+        Assert.Equal(3, pages);
+        Assert.Equal(expected, seen);
+    }
+
+    [Fact]
+    public async Task List_CursorPaging_BookingsWithSameStartInDifferentRooms_AreNotLostOrRepeated()
+    {
+        var start = Slots.TakeOne();
+        var expected = new List<string>();
+        foreach (var room in new[] { "lyra", "orion", "vega" })
+            expected.Add(Id(await ApiCalls.CreateOkAsync(_alice, room, start, 30)));
+        var window = $"from={Json.Iso(start.AddMinutes(-1))}&to={Json.Iso(start.AddHours(1))}&limit=1";
+
+        var seen = new List<string>();
+        string? cursor = null;
+        var pages = 0;
+        do
+        {
+            var url = $"/api/v1/bookings?{window}" + (cursor is null ? "" : $"&cursor={Uri.EscapeDataString(cursor)}");
+            var body = await Json.ReadAsync(await _alice.GetAsync(url));
+            seen.AddRange(body.GetProperty("items").EnumerateArray().Select(Id));
+            var next = body.GetProperty("nextCursor");
+            cursor = next.ValueKind == JsonValueKind.Null ? null : next.GetString();
+            pages++;
+        }
+        while (cursor is not null && pages < 10);
+
+        Assert.Equal(expected.Order(), seen.Order());
+        Assert.Equal(seen.Count, seen.Distinct().Count());
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("cursor=%21%21%21", "cursor")]
+    [InlineData("cursor=bm90LWEtY3Vyc29y", "cursor")]
+    public async Task List_InvalidParameters_Returns400WithField(string query, string field)
+    {
+        var response = await _alice.GetAsync($"/api/v1/bookings?{query}");
+
+        await ContractAssert.ValidationAsync(response, field);
+    }
+
+    [Theory]
+    [InlineData("from=yesterday")]
+    [InlineData("to=not-a-date")]
+    public async Task List_InvalidPeriod_Returns400(string query)
+    {
+        var response = await _alice.GetAsync($"/api/v1/bookings?{query}");
+
+        await ContractAssert.ValidationAsync(response);
+    }
+
+    // ---- rescheduleBooking ----
+
+    [Fact]
+    public async Task Reschedule_ByOwner_ReturnsUpdatedBookingWithNewVersion()
+    {
+        var starts = Slots.Take(2);
+        var created = await ApiCalls.CreateOkAsync(_alice, "orion", starts[0], 90);
+
+        var response = await ApiCalls.RescheduleAsync(
+            _alice, Id(created), starts[1], 60, created.GetProperty("version").GetInt64());
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await Json.ReadAsync(response);
+        ContractAssert.Booking(booking);
+        Assert.Equal(Id(created), Id(booking));
+        Assert.Equal(starts[1], booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(60, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+        Assert.NotEqual(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+
+        var reread = await Json.ReadAsync(await _alice.GetAsync($"/api/v1/bookings/{Id(created)}"));
+        Assert.Equal(starts[1], reread.GetProperty("startsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Reschedule_ByAdmin_IsAllowed()
+    {
+        var starts = Slots.Take(2);
+        var created = await ApiCalls.CreateOkAsync(_alice, "orion", starts[0]);
+
+        var response = await ApiCalls.RescheduleAsync(
