+using System.Net;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-02: брони по комнате или по всем комнатам (listBookings, listRoomBookings).</summary>
+public class ListBookingsTests(ApiFixture api) : ApiTestBase(api)
+{
+    private static string Iso(DateTimeOffset value) => Uri.EscapeDataString(value.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ"));
+
+    /// <summary>Три брони по часу в одной комнате подряд и окно from/to, в которое попадают только они.</summary>
+    private async Task<(List<JsonElement> Bookings, string Window)> CreateThreeAsync(string roomId)
+    {
+        var bookings = new List<JsonElement>();
+        for (var i = 0; i < 3; i++)
+            bookings.Add(await CreateBookingAsync(Member(), roomId));
+
+        var window = $"from={Iso(bookings[0].GetProperty("startsAt").GetDateTimeOffset().AddMinutes(-1))}" +
+                     $"&to={Iso(bookings[2].GetProperty("endsAt").GetDateTimeOffset().AddMinutes(1))}";
+        return (bookings, window);
+    }
+
+    private static List<string?> Ids(JsonElement items) =>
+        items.EnumerateArray().Select(b => b.GetProperty("id").GetString()).ToList();
+
+    [Fact]
+    public async Task ListBookings_returns_room_bookings_in_period_ordered_by_start()
+    {
+        var (bookings, window) = await CreateThreeAsync("orion");
+
+        var response = await Member().GetAsync($"/api/v1/bookings?roomId=orion&{window}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ReadJsonAsync(response);
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+        var items = page.GetProperty("items");
+        Assert.Equal(bookings.Select(b => b.GetProperty("id").GetString()), Ids(items));
+        foreach (var item in items.EnumerateArray())
+            AssertBookingShape(item);
+    }
+
+    [Fact]
+    public async Task ListBookings_includes_cancelled_bookings()
+    {
+        var (bookings, window) = await CreateThreeAsync("lyra");
+        Assert.Equal(HttpStatusCode.NoContent, (await Member().DeleteAsync(BookingUrl(bookings[1]))).StatusCode);
+
+        var page = await ReadJsonAsync(await Member().GetAsync($"/api/v1/bookings?roomId=lyra&{window}"));
+
+        var items = page.GetProperty("items").EnumerateArray().ToList();
+        Assert.Equal(3, items.Count);
+        Assert.Equal("cancelled", items[1].GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task ListBookings_pages_with_cursor_until_next_cursor_is_null()
+    {
+        var (bookings, window) = await CreateThreeAsync("vega");
+        var expected = bookings.Select(b => b.GetProperty("id").GetString()).ToList();
+
+        var first = await ReadJsonAsync(await Member().GetAsync($"/api/v1/bookings?roomId=vega&{window}&limit=2"));
+        var cursor = first.GetProperty("nextCursor").GetString();
+        Assert.False(string.IsNullOrEmpty(cursor));
+        Assert.Equal(expected.Take(2), Ids(first.GetProperty("items")));
+
+        var second = await ReadJsonAsync(
+            await Member().GetAsync($"/api/v1/bookings?roomId=vega&{window}&limit=2&cursor={Uri.EscapeDataString(cursor!)}"));
+        Assert.Equal(expected.Skip(2), Ids(second.GetProperty("items")));
+        Assert.Equal(JsonValueKind.Null, second.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task ListBookings_exact_page_size_has_no_next_cursor()
+    {
+        var (_, window) = await CreateThreeAsync("vega");
+
+        var page = await ReadJsonAsync(await Member().GetAsync($"/api/v1/bookings?roomId=vega&{window}&limit=3"));
+
+        Assert.Equal(3, page.GetProperty("items").GetArrayLength());
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task ListBookings_empty_result_is_empty_items()
+    {
+        var from = Iso(DateTimeOffset.UtcNow.AddDays(1));
+        var to = Iso(DateTimeOffset.UtcNow.AddDays(1).AddMinutes(1));
+
+        var response = await Member().GetAsync($"/api/v1/bookings?roomId=no-such-room&from={from}&to={to}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ReadJsonAsync(response);
+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task ListBookings_from_excludes_bookings_that_ended_before()
+    {
+        var (bookings, _) = await CreateThreeAsync("lyra");
+        var from = Iso(bookings[2].GetProperty("startsAt").GetDateTimeOffset());
+        var to = Iso(bookings[2].GetProperty("endsAt").GetDateTimeOffset().AddMinutes(1));
+
+        var page = await ReadJsonAsync(await Member().GetAsync($"/api/v1/bookings?roomId=lyra&from={from}&to={to}"));
+
+        Assert.Equal([bookings[2].GetProperty("id").GetString()], Ids(page.GetProperty("items")));
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("cursor=not-a-cursor", "cursor")]
+    public async Task ListBookings_rejects_invalid_paging(string query, string field)
+    {
+        var response = await Member().GetAsync($"/api/v1/bookings?{query}");
+
+        await AssertValidationProblemAsync(response, field);
+    }
+
+    [Fact]
+    public async Task ListBookings_rejects_malformed_date()
+    {
+        var response = await Member().GetAsync("/api/v1/bookings?from=yesterday");
+
+        await AssertValidationProblemAsync(response, "from");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_returns_all_room_bookings_in_period_without_paging()
+    {
+        var (bookings, window) = await CreateThreeAsync("orion");
+        Assert.Equal(HttpStatusCode.NoContent, (await Member().DeleteAsync(BookingUrl(bookings[0]))).StatusCode);
+
+        var response = await Member().GetAsync($"/api/v1/rooms/orion/bookings?{window}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var items = await ReadJsonAsync(response);
+        Assert.Equal(JsonValueKind.Array, items.ValueKind);
+        Assert.Equal(bookings.Select(b => b.GetProperty("id").GetString()), Ids(items));
+        Assert.Equal("cancelled", items[0].GetProperty("status").GetString());
+        foreach (var item in items.EnumerateArray())
+            AssertBookingShape(item);
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_unknown_room_is_not_found()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms/no-such-room/bookings");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_rejects_malformed_date()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms/orion/bookings?to=tomorrow");
+
+        await AssertValidationProblemAsync(response, "to");
+    }
+}
