+using System.Net;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-07, FR-10, FR-11: отмена брони (cancelBooking).</summary>
+public class CancelBookingTests(ApiFixture api) : ApiTestBase(api)
+{
+    [Fact]
+    public async Task Cancel_by_owner_returns_no_content_and_keeps_booking_in_history()
+    {
+        var created = await CreateBookingAsync(Member(), "vega");
+
+        var response = await Member().DeleteAsync(BookingUrl(created));
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        var booking = await ReadJsonAsync(await Member().GetAsync(BookingUrl(created)));
+        Assert.Equal("cancelled", booking.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_repeated_returns_no_content_again()
+    {
+        var created = await CreateBookingAsync(Member(), "vega");
+        Assert.Equal(HttpStatusCode.NoContent, (await Member().DeleteAsync(BookingUrl(created))).StatusCode);
+
+        var response = await Member().DeleteAsync(BookingUrl(created));
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Cancel_by_admin_is_allowed()
+    {
+        var created = await CreateBookingAsync(Member(), "vega");
+
+        var response = await Admin().DeleteAsync(BookingUrl(created));
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Cancel_by_other_member_is_forbidden()
+    {
+        var created = await CreateBookingAsync(Member(), "vega");
+
+        var response = await OtherMember().DeleteAsync(BookingUrl(created));
+
+        await AssertProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+        var booking = await ReadJsonAsync(await Member().GetAsync(BookingUrl(created)));
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_unknown_booking_is_not_found()
+    {
+        var response = await Member().DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+}
