+using System.Net;
+using System.Net.Http.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-12: любой запрос - только с ключом доступа; 401 описан у каждой операции.</summary>
+public class AuthTests(ApiFixture api) : ApiTestBase(api)
+{
+    public static TheoryData<string, string> Operations => new()
+    {
+        { "GET", "/api/v1/rooms" },
+        { "GET", "/api/v1/rooms/orion" },
+        { "GET", "/api/v1/rooms/orion/bookings" },
+        { "GET", "/api/v1/bookings" },
+        { "POST", "/api/v1/bookings" },
+        { "GET", "/api/v1/bookings/3f2b8a64-5717-4562-b3fc-2c963f66afa6" },
+        { "PATCH", "/api/v1/bookings/3f2b8a64-5717-4562-b3fc-2c963f66afa6" },
+        { "DELETE", "/api/v1/bookings/3f2b8a64-5717-4562-b3fc-2c963f66afa6" },
+    };
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task Request_without_key_is_unauthorized(string method, string url)
+    {
+        var response = await Anonymous().SendAsync(Build(method, url));
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task Request_with_unknown_key_is_unauthorized(string method, string url)
+    {
+        var response = await Api.CreateClient("no-such-key").SendAsync(Build(method, url));
+
+        await AssertProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    private static HttpRequestMessage Build(string method, string url)
+    {
+        var request = new HttpRequestMessage(new HttpMethod(method), url);
+        if (method is "POST" or "PATCH")
+            request.Content = JsonContent.Create(new { });
+        return request;
+    }
+}
