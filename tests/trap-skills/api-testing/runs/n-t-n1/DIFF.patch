+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-06, FR-10: перенос брони (rescheduleBooking).</summary>
+public class RescheduleBookingTests(ApiFixture api) : ApiTestBase(api)
+{
+    private static object Reschedule(DateTimeOffset startsAt, int durationMinutes, long version) =>
+        new { startsAt, durationMinutes, version };
+
+    [Fact]
+    public async Task Reschedule_by_owner_moves_booking_and_changes_version()
+    {
+        var created = await CreateBookingAsync(Member(), "orion", durationMinutes: 60);
+        var newStart = Api.NextSlot("orion");
+
+        var response = await Member().PatchAsJsonAsync(
+            BookingUrl(created), Reschedule(newStart, 90, created.GetProperty("version").GetInt64()));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal(created.GetProperty("id").GetString(), booking.GetProperty("id").GetString());
+        Assert.Equal(newStart, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(newStart.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.NotEqual(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Reschedule_is_visible_on_following_read()
+    {
+        var created = await CreateBookingAsync(Member(), "orion");
+        var newStart = Api.NextSlot("orion");
+        var patch = await Member().PatchAsJsonAsync(
+            BookingUrl(created), Reschedule(newStart, 30, created.GetProperty("version").GetInt64()));
+        var patched = await ReadJsonAsync(patch);
+
+        var read = await ReadJsonAsync(await Member().GetAsync(BookingUrl(created)));
+
+        Assert.Equal(newStart, read.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(patched.GetProperty("version").GetInt64(), read.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Reschedule_by_admin_is_allowed()
+    {
+        var created = await CreateBookingAsync(Member(), "orion");
+
+        var response = await Admin().PatchAsJsonAsync(
+            BookingUrl(created), Reschedule(Api.NextSlot("orion"), 60, created.GetProperty("version").GetInt64()));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Reschedule_overlapping_own_previous_time_is_allowed()
+    {
+        var created = await CreateBookingAsync(Member(), "orion", durationMinutes: 60);
+        var startsAt = created.GetProperty("startsAt").GetDateTimeOffset();
+
+        var response = await Member().PatchAsJsonAsync(
+            BookingUrl(created), Reschedule(startsAt.AddMinutes(30), 60, created.GetProperty("version").GetInt64()));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Reschedule_by_other_member_is_forbidden()
+    {
+        var created = await CreateBookingAsync(Member(), "orion");
+
+        var response = await OtherMember().PatchAsJsonAsync(
+            BookingUrl(created), Reschedule(Api.NextSlot("orion"), 60, created.GetProperty("version").GetInt64()));
+
+        await AssertProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+    }
+
+    [Fact]
+    public async Task Reschedule_with_stale_version_is_conflict()
+    {
+        var created = await CreateBookingAsync(Member(), "orion");
+        var staleVersion = created.GetProperty("version").GetInt64();
+        var first = await Member().PatchAsJsonAsync(BookingUrl(created), Reschedule(Api.NextSlot("orion"), 60, staleVersion));
+        Assert.Equal(HttpStatusCode.OK, first.StatusCode);
+
+        var response = await Member().PatchAsJsonAsync(BookingUrl(created), Reschedule(Api.NextSlot("orion"), 60, staleVersion));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "version-conflict");
+    }
+
+    [Fact]
+    public async Task Reschedule_onto_occupied_time_is_conflict()
+    {
+        var other = await CreateBookingAsync(OtherMember(), "orion", durationMinutes: 60);
+        var created = await CreateBookingAsync(Member(), "orion", durationMinutes: 60);
+
+        var response = await Member().PatchAsJsonAsync(
+            BookingUrl(created),
+            Reschedule(other.GetProperty("startsAt").GetDateTimeOffset(), 60, created.GetProperty("version").GetInt64()));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Reschedule_cancelled_booking_is_conflict()
+    {
+        var created = await CreateBookingAsync(Member(), "orion");
+        Assert.Equal(HttpStatusCode.NoContent, (await Member().DeleteAsync(BookingUrl(created))).StatusCode);
+        var cancelled = await ReadJsonAsync(await Member().GetAsync(BookingUrl(created)));
+
+        var response = await Member().PatchAsJsonAsync(
+            BookingUrl(created), Reschedule(Api.NextSlot("orion"), 60, cancelled.GetProperty("version").GetInt64()));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-cancelled");
+    }
+
+    [Fact]
+    public async Task Reschedule_unknown_booking_is_not_found()
+    {
+        var response = await Member().PatchAsJsonAsync(
+            $"/api/v1/bookings/{Guid.NewGuid()}", Reschedule(Api.NextSlot("orion"), 60, 1));
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Reschedule_rejects_invalid_duration_and_past_start()
+    {
+        var created = await CreateBookingAsync(Member(), "orion");
+        var version = created.GetProperty("version").GetInt64();
+
+        var badDuration = await Member().PatchAsJsonAsync(BookingUrl(created), Reschedule(Api.NextSlot("orion"), 20, version));
+        var past = await Member().PatchAsJsonAsync(BookingUrl(created), Reschedule(DateTimeOffset.UtcNow.AddHours(-1), 60, version));
+        var tooFar = await Member().PatchAsJsonAsync(BookingUrl(created), Reschedule(DateTimeOffset.UtcNow.AddDays(91), 60, version));
+
+        await AssertValidationProblemAsync(badDuration, "durationMinutes");
+        await AssertValidationProblemAsync(past, "startsAt");
+        await AssertValidationProblemAsync(tooFar, "startsAt");
+    }
+
+    // Расхождение BKG-31: версия обязательна по контракту (RescheduleBookingRequest.required), но сервис
+    // подставляет 0 и отвечает 409 version-conflict вместо 400. Включить после исправления сервиса.
+    [Fact(Skip = "Расхождение с контрактом: запрос без version даёт 409, ждём 400 (см. описание MR BKG-31)")]
+    public async Task Reschedule_without_version_is_rejected()
+    {
+        var created = await CreateBookingAsync(Member(), "orion");
+
+        var response = await Member().PatchAsJsonAsync(BookingUrl(created), new { startsAt = Api.NextSlot("orion"), durationMinutes = 60 });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal(ProblemJson, response.Content.Headers.ContentType?.MediaType);
+    }
+
+    [Fact]
+    public async Task Reschedule_changes_only_time_not_room_or_owner()
+    {
+        var created = await CreateBookingAsync(Member(), "lyra");
+
+        var response = await Admin().PatchAsJsonAsync(
+            BookingUrl(created), Reschedule(Api.NextSlot("lyra"), 120, created.GetProperty("version").GetInt64()));
+
+        var booking = await ReadJsonAsync(response);
+        Assert.Equal("lyra", booking.GetProperty("roomId").GetString());
+        Assert.Equal(created.GetProperty("title").GetString(), booking.GetProperty("title").GetString());
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+}
