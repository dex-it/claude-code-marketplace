@@ -0,0 +1,77 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase(ApiFixture api)
+{
+    protected const string ProblemJson = "application/problem+json";
+
+    protected ApiFixture Api { get; } = api;
+
+    protected HttpClient Member() => Api.CreateClient(ApiFixture.MemberKey);
+    protected HttpClient OtherMember() => Api.CreateClient(ApiFixture.OtherMemberKey);
+    protected HttpClient Admin() => Api.CreateClient(ApiFixture.AdminKey);
+    protected HttpClient Anonymous() => Api.CreateClient(null);
+
+    protected static object NewBooking(string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string title = "Планирование", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes, comment };
+
+    protected async Task<JsonElement> CreateBookingAsync(HttpClient client, string roomId, DateTimeOffset? startsAt = null, int durationMinutes = 60)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId, startsAt ?? Api.NextSlot(roomId), durationMinutes));
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJsonAsync(response);
+    }
+
+    protected static string BookingUrl(JsonElement booking) => $"/api/v1/bookings/{booking.GetProperty("id").GetString()}";
+
+    protected static async Task<JsonElement> ReadJsonAsync(HttpResponseMessage response)
+    {
+        using var stream = await response.Content.ReadAsStreamAsync();
+        return (await JsonDocument.ParseAsync(stream)).RootElement.Clone();
+    }
+
+    protected static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal(ProblemJson, response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJsonAsync(response);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        Assert.True(body.TryGetProperty("type", out _), "Problem без обязательного type");
+        Assert.True(body.TryGetProperty("title", out _), "Problem без обязательного title");
+    }
+
+    protected static async Task AssertValidationProblemAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal(ProblemJson, response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJsonAsync(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        Assert.True(body.TryGetProperty("type", out _), "ValidationProblem без обязательного type");
+        Assert.True(body.TryGetProperty("title", out _), "ValidationProblem без обязательного title");
+        var errors = body.GetProperty("errors");
+        foreach (var field in fields)
+            Assert.True(errors.TryGetProperty(field, out var messages) && messages.GetArrayLength() > 0, $"Нет ошибки по полю {field}: {errors}");
+    }
+
+    /// <summary>Бронь в ответе соответствует схеме Booking: все обязательные поля, границы, формат.</summary>
+    protected static void AssertBookingShape(JsonElement booking)
+    {
+        foreach (var name in new[] { "id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version" })
+            Assert.True(booking.TryGetProperty(name, out _), $"В Booking нет обязательного поля {name}");
+
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        Assert.Equal(
+            booking.GetProperty("startsAt").GetDateTimeOffset().AddMinutes(duration),
+            booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0L, uint.MaxValue);
+    }
+}
