@@ -0,0 +1,210 @@
+using System.Net;
+using System.Net.Http.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-03, FR-04, FR-05, FR-08, FR-09: создание и чтение брони (createBooking, getBooking).</summary>
+public class BookingsTests(ApiFixture api) : ApiTestBase(api)
+{
+    [Fact]
+    public async Task CreateBooking_returns_created_booking_owned_by_key_holder()
+    {
+        var startsAt = Api.NextSlot("orion");
+
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", startsAt, 90, "Планирование спринта", "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task CreateBooking_sets_location_of_created_booking()
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("vega", Api.NextSlot("vega")));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        Assert.NotNull(response.Headers.Location);
+        Assert.Equal($"/api/v1/bookings/{booking.GetProperty("id").GetString()}", response.Headers.Location!.AbsolutePath);
+    }
+
+    [Fact]
+    public async Task CreateBooking_without_comment_returns_null_comment()
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("vega", Api.NextSlot("vega")));
+
+        var booking = await ReadJsonAsync(response);
+        Assert.Equal(System.Text.Json.JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task CreateBooking_accepts_duration_bounds(int minutes)
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("lyra", Api.NextSlot("lyra"), minutes));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task CreateBooking_rejects_invalid_duration(int minutes)
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("lyra", Api.NextSlot("lyra"), minutes));
+
+        await AssertValidationProblemAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task CreateBooking_rejects_start_in_the_past()
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("lyra", DateTimeOffset.UtcNow.AddMinutes(-5)));
+
+        await AssertValidationProblemAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task CreateBooking_rejects_start_beyond_90_days()
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("lyra", DateTimeOffset.UtcNow.AddDays(91)));
+
+        await AssertValidationProblemAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task CreateBooking_rejects_too_long_title_and_comment()
+    {
+        var response = await Member().PostAsJsonAsync(
+            "/api/v1/bookings",
+            NewBooking("lyra", Api.NextSlot("lyra"), title: new string('т', 121), comment: new string('к', 501)));
+
+        await AssertValidationProblemAsync(response, "title", "comment");
+    }
+
+    [Fact]
+    public async Task CreateBooking_accepts_max_length_title_and_comment()
+    {
+        var response = await Member().PostAsJsonAsync(
+            "/api/v1/bookings",
+            NewBooking("lyra", Api.NextSlot("lyra"), title: new string('т', 120), comment: new string('к', 500)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task CreateBooking_rejects_empty_title()
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("lyra", Api.NextSlot("lyra"), title: ""));
+
+        await AssertValidationProblemAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task CreateBooking_rejects_request_without_required_fields()
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", new { roomId = "lyra" });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal(ProblemJson, response.Content.Headers.ContentType?.MediaType);
+    }
+
+    [Fact]
+    public async Task CreateBooking_unknown_room_is_not_found()
+    {
+        var response = await Member().PostAsJsonAsync("/api/v1/bookings", NewBooking("no-such-room", Api.NextSlot("no-such-room")));
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task CreateBooking_overlapping_active_booking_is_conflict()
+    {
+        var first = await CreateBookingAsync(Member(), "orion", durationMinutes: 60);
+        var startsAt = first.GetProperty("startsAt").GetDateTimeOffset();
+
+        var response = await OtherMember().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", startsAt.AddMinutes(30)));
+
+        await AssertProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task CreateBooking_adjacent_booking_is_allowed()
+    {
+        var first = await CreateBookingAsync(Member(), "orion", durationMinutes: 60);
+        var endsAt = first.GetProperty("endsAt").GetDateTimeOffset();
+
+        var response = await OtherMember().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", endsAt));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task CreateBooking_same_time_in_another_room_is_allowed()
+    {
+        var first = await CreateBookingAsync(Member(), "orion", durationMinutes: 60);
+        var startsAt = first.GetProperty("startsAt").GetDateTimeOffset();
+
+        var response = await OtherMember().PostAsJsonAsync("/api/v1/bookings", NewBooking("vega", startsAt));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task CreateBooking_cancelled_booking_does_not_occupy_room()
+    {
+        var first = await CreateBookingAsync(Member(), "orion", durationMinutes: 60);
+        var cancel = await Member().DeleteAsync(BookingUrl(first));
+        Assert.Equal(HttpStatusCode.NoContent, cancel.StatusCode);
+
+        var response = await OtherMember().PostAsJsonAsync(
+            "/api/v1/bookings", NewBooking("orion", first.GetProperty("startsAt").GetDateTimeOffset()));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task GetBooking_returns_booking_to_any_member()
+    {
+        var created = await CreateBookingAsync(Member(), "vega");
+
+        var response = await OtherMember().GetAsync(BookingUrl(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal(created.GetProperty("id").GetString(), booking.GetProperty("id").GetString());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+    }
+
+    // Расхождение BKG-31: id не UUID не проходит ограничение маршрута; ответ 404 приходит без `code`.
+    // Включить после исправления сервиса или уточнения контракта.
+    [Fact(Skip = "Расхождение с контрактом: 404 для id не UUID без code (см. описание MR BKG-31)")]
+    public async Task GetBooking_malformed_id_is_not_found_problem()
+    {
+        var response = await Member().GetAsync("/api/v1/bookings/not-a-guid");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task GetBooking_unknown_booking_is_not_found()
+    {
+        var response = await Member().GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+}
