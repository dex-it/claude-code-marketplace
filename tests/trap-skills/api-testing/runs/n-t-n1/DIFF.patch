diff --git a/tests/Bookings.Api.Tests/ApiFixture.cs b/tests/Bookings.Api.Tests/ApiFixture.cs
new file mode 100644
index 0000000..900f607
--- /dev/null
+++ b/tests/Bookings.Api.Tests/ApiFixture.cs
@@ -0,0 +1,82 @@
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Testcontainers.PostgreSql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис поверх настоящего PostgreSQL: запрет пересечений (FR-09) и версия брони держатся на возможностях БД.
+/// Один контейнер и одно приложение на все тесты.
+/// </summary>
+public sealed class ApiFixture : IAsyncLifetime
+{
+    public const string MemberKey = "test-alice-key";
+    public const string OtherMemberKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16").Build();
+    private readonly object _slotsLock = new();
+    private readonly Dictionary<string, int> _slotCounters = new();
+    private readonly DateTimeOffset _slotsBase = new DateTimeOffset(DateTimeOffset.UtcNow.UtcDateTime.Date, TimeSpan.Zero).AddDays(2);
+    private WebApplicationFactory<Program>? _factory;
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+        var connectionString = _postgres.GetConnectionString();
+
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+        {
+            builder.UseEnvironment("Testing");
+            builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["ConnectionStrings:Bookings"] = connectionString,
+                ["Database:Initialize"] = "true",
+                ["Auth:Keys:0:key"] = MemberKey,
+                ["Auth:Keys:0:userId"] = "alice",
+                ["Auth:Keys:0:role"] = "member",
+                ["Auth:Keys:1:key"] = OtherMemberKey,
+                ["Auth:Keys:1:userId"] = "bob",
+                ["Auth:Keys:1:role"] = "member",
+                ["Auth:Keys:2:key"] = AdminKey,
+                ["Auth:Keys:2:userId"] = "admin",
+                ["Auth:Keys:2:role"] = "admin",
+            }));
+        });
+    }
+
+    public async Task DisposeAsync()
+    {
+        _factory?.Dispose();
+        await _postgres.DisposeAsync();
+    }
+
+    public HttpClient CreateClient(string? apiKey = MemberKey)
+    {
+        var client = _factory!.CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+
+    /// <summary>
+    /// Свободный слот комнаты в будущем (в пределах 90 дней): тесты делят одну БД и не должны пересекаться
+    /// друг с другом. Слоты разнесены на 5 часов, поэтому брони до 4 часов не соприкасаются.
+    /// </summary>
+    public DateTimeOffset NextSlot(string roomId)
+    {
+        lock (_slotsLock)
+        {
+            _slotCounters.TryGetValue(roomId, out var n);
+            _slotCounters[roomId] = n + 1;
+            return _slotsBase.AddHours(n * 5);
+        }
+    }
+}
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
