+using System.Net;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-01: перечень комнат и карточка комнаты (listRooms, getRoom).</summary>
+public class RoomsTests(ApiFixture api) : ApiTestBase(api)
+{
+    private static readonly string[] Features = ["projector", "whiteboard", "videoconf"];
+
+    [Fact]
+    public async Task ListRooms_returns_page_ordered_by_id_with_total()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ReadJsonAsync(response);
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+        var items = page.GetProperty("items").EnumerateArray().ToList();
+        Assert.Equal(["lyra", "orion", "vega"], items.Select(r => r.GetProperty("id").GetString()));
+        foreach (var room in items)
+            AssertRoomShape(room);
+    }
+
+    [Fact]
+    public async Task ListRooms_applies_limit_and_offset()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms?limit=1&offset=1");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ReadJsonAsync(response);
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+        var item = Assert.Single(page.GetProperty("items").EnumerateArray());
+        Assert.Equal("orion", item.GetProperty("id").GetString());
+    }
+
+    [Fact]
+    public async Task ListRooms_offset_past_the_end_returns_empty_items()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms?offset=50");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await ReadJsonAsync(response);
+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("offset=-1", "offset")]
+    public async Task ListRooms_rejects_out_of_range_paging(string query, string field)
+    {
+        var response = await Member().GetAsync($"/api/v1/rooms?{query}");
+
+        await AssertValidationProblemAsync(response, field);
+    }
+
+    [Fact]
+    public async Task ListRooms_accepts_max_limit()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms?limit=100");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task GetRoom_returns_room_card()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms/orion");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var room = await ReadJsonAsync(response);
+        AssertRoomShape(room);
+        Assert.Equal("orion", room.GetProperty("id").GetString());
+        Assert.Equal("Orion", room.GetProperty("name").GetString());
+        Assert.Equal(8, room.GetProperty("capacity").GetInt32());
+        Assert.Equal(3, room.GetProperty("floor").GetInt32());
+        Assert.Equal(["projector", "whiteboard"], room.GetProperty("features").EnumerateArray().Select(f => f.GetString()));
+    }
+
+    [Fact]
+    public async Task GetRoom_unknown_room_is_not_found()
+    {
+        var response = await Member().GetAsync("/api/v1/rooms/no-such-room");
+
+        await AssertProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    private static void AssertRoomShape(JsonElement room)
+    {
+        foreach (var name in new[] { "id", "name", "capacity", "floor", "features" })
+            Assert.True(room.TryGetProperty(name, out _), $"В Room нет обязательного поля {name}");
+
+        Assert.Matches("^[a-z0-9-]{1,64}$", room.GetProperty("id").GetString()!);
+        Assert.InRange(room.GetProperty("capacity").GetInt32(), 1, 50);
+        foreach (var feature in room.GetProperty("features").EnumerateArray())
+            Assert.Contains(feature.GetString(), Features);
+    }
+}
