+        await Check.ValidationAsync(response, "roomId");
+    }
+
+    [Fact(Skip = "Расхождение с контрактом: POST /api/v1/bookings без title - контракт ждёт ключ errors в camelCase (title), сервис отвечает ключом Title.")]
+    public async Task Create_without_required_field_is_validation_error()
+    {
+        var response = await _alice.PostAsJsonAsync(
+            "/api/v1/bookings", new { roomId = "orion", startsAt = Slots.NextDay().AddHours(7), durationMinutes = 60 });
