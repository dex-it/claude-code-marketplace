+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Свободные окна времени: каждому тесту - свои сутки, чтобы брони разных тестов не пересекались.</summary>
+public static class Slots
+{
+    private static int _next = 1;
+
+    public static DateTimeOffset NextDay()
+    {
+        var n = Interlocked.Increment(ref _next);
+        Assert.True(n <= 88, "Закончились сутки для тестов (бронь - не дальше 90 дней вперёд).");
+        return new DateTimeOffset(DateTime.UtcNow.Date.AddDays(n), TimeSpan.Zero);
+    }
+}
+
+public static class Http
+{
+    public static string Iso(DateTimeOffset value) => Uri.EscapeDataString(value.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ"));
+
+    public static object NewBooking(string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string title = "Встреча", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes, comment };
+
+    public static async Task<JsonElement> CreateBookingAsync(
+        HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string? comment = null)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId, startsAt, durationMinutes, comment: comment));
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await response.Content.ReadFromJsonAsync<JsonElement>();
+    }
+
+    public static async Task<JsonElement> GetBookingAsync(HttpClient client, string id)
+    {
+        var response = await client.GetAsync($"/api/v1/bookings/{id}");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        return await response.Content.ReadFromJsonAsync<JsonElement>();
+    }
+
+    public static Task<HttpResponseMessage> RescheduleAsync(HttpClient client, string id, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{id}", new { startsAt, durationMinutes, version });
+}
+
+public static class Check
+{
+    public static async Task<JsonElement> ProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal(JsonValueKind.String, body.GetProperty("type").ValueKind);
+        Assert.Equal(JsonValueKind.String, body.GetProperty("title").ValueKind);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        return body;
+    }
+
+    public static async Task<JsonElement> ValidationAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        var errors = body.GetProperty("errors");
+        Assert.Equal(JsonValueKind.Object, errors.ValueKind);
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"Нет ошибки по полю '{field}': {errors}");
+            Assert.Equal(JsonValueKind.Array, messages.ValueKind);
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+
+        return errors;
+    }
+
+    public static void Room(JsonElement room)
+    {
+        Assert.Matches("^[a-z0-9-]{1,64}$", room.GetProperty("id").GetString()!);
+        Assert.Equal(JsonValueKind.String, room.GetProperty("name").ValueKind);
+        Assert.InRange(room.GetProperty("capacity").GetInt32(), 1, 50);
+        Assert.Equal(JsonValueKind.Number, room.GetProperty("floor").ValueKind);
+        var features = room.GetProperty("features");
+        Assert.Equal(JsonValueKind.Array, features.ValueKind);
+        foreach (var feature in features.EnumerateArray())
+            Assert.Contains(feature.GetString(), new[] { "projector", "whiteboard", "videoconf" });
+    }
+
+    public static void Booking(JsonElement booking)
+    {
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.Equal(JsonValueKind.String, booking.GetProperty("roomId").ValueKind);
+        Assert.InRange(booking.GetProperty("title").GetString()!.Length, 1, 120);
+        Assert.True(booking.GetProperty("comment").ValueKind is JsonValueKind.Null or JsonValueKind.String);
+        var startsAt = booking.GetProperty("startsAt").GetDateTimeOffset();
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        Assert.Equal(startsAt.AddMinutes(duration).UtcDateTime, booking.GetProperty("endsAt").GetDateTimeOffset().UtcDateTime);
+        Assert.Equal(JsonValueKind.String, booking.GetProperty("ownerId").ValueKind);
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+    }
+}
