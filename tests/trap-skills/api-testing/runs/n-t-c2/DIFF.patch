+using System.Net;
+using System.Net.Http.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-12: любой запрос - только с ключом доступа; 401 с code unauthorized.</summary>
+[Collection(ApiCollection.Name)]
+public class AuthTests(ApiFactory factory)
+{
+    private const string BookingId = "3f2b8a64-5717-4562-b3fc-2c963f66afa6";
+
+    public static TheoryData<string, string> Operations => new()
+    {
+        { "GET", "/api/v1/rooms" },
+        { "GET", "/api/v1/rooms/orion" },
+        { "GET", "/api/v1/rooms/orion/bookings" },
+        { "GET", "/api/v1/bookings" },
+        { "POST", "/api/v1/bookings" },
+        { "GET", $"/api/v1/bookings/{BookingId}" },
+        { "PATCH", $"/api/v1/bookings/{BookingId}" },
+        { "DELETE", $"/api/v1/bookings/{BookingId}" },
+    };
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task Request_without_key_is_unauthorized(string method, string url)
+    {
+        var response = await factory.ClientFor(null).SendAsync(Request(method, url));
+
+        await Check.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task Request_with_unknown_key_is_unauthorized(string method, string url)
+    {
+        var response = await factory.ClientFor("no-such-key").SendAsync(Request(method, url));
+
+        await Check.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    private static HttpRequestMessage Request(string method, string url) => new(new HttpMethod(method), url)
+    {
+        Content = method is "POST" or "PATCH" ? JsonContent.Create(new { }) : null,
+    };
+}
