+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+    }
+
+    [Fact]
+    public async Task Create_in_unknown_room_is_not_found()
+    {
+        var response = await _alice.PostAsJsonAsync("/api/v1/bookings", Http.NewBooking("no-such-room", Slots.NextDay().AddHours(7)));
