+    [Fact(Skip = "Расхождение с контрактом: POST /api/v1/bookings, roomId длиннее 64 - контракт ждёт 400, сервис отвечает 404 room-not-found.")]
+    public async Task Create_with_too_long_room_id_is_validation_error()
+    {
