+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingsTests(ApiFactory factory)
+{
+    private readonly HttpClient _alice = factory.ClientFor(ApiFactory.AliceKey);
+    private readonly HttpClient _bob = factory.ClientFor(ApiFactory.BobKey);
+    private readonly HttpClient _admin = factory.ClientFor(ApiFactory.AdminKey);
+
+    private static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+    private static long Version(JsonElement booking) => booking.GetProperty("version").GetInt64();
+
+    // ---- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_returns_201_with_location_and_booking()
+    {
+        var startsAt = Slots.NextDay().AddHours(7);
+
+        var response = await _alice.PostAsJsonAsync(
+            "/api/v1/bookings", Http.NewBooking("orion", startsAt, 90, "Планирование спринта", "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Check.Booking(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+
+        var location = response.Headers.Location;
+        Assert.NotNull(location);
+        Assert.Equal($"/api/v1/bookings/{Id(booking)}", location.IsAbsoluteUri ? location.AbsolutePath : location.OriginalString);
+    }
+
+    [Fact]
+    public async Task Create_without_comment_returns_null_comment()
+    {
+        var response = await _alice.PostAsJsonAsync(
+            "/api/v1/bookings",
+            new { roomId = "orion", title = "Без комментария", startsAt = Slots.NextDay().AddHours(7), durationMinutes = 30 });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await response.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_owner_is_the_key_owner()
+    {
+        var booking = await Http.CreateBookingAsync(_bob, "vega", Slots.NextDay().AddHours(7));
+
+        Assert.Equal("bob", booking.GetProperty("ownerId").GetString());
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_accepts_duration_bounds(int minutes)
+    {
+        var booking = await Http.CreateBookingAsync(_alice, "orion", Slots.NextDay().AddHours(7), minutes);
+
+        Assert.Equal(minutes, booking.GetProperty("durationMinutes").GetInt32());
+    }
+
+    [Fact]
+    public async Task Create_accepts_longest_title_and_comment()
+    {
+        var response = await _alice.PostAsJsonAsync(
+            "/api/v1/bookings",
+            Http.NewBooking("orion", Slots.NextDay().AddHours(7), 60, new string('т', 120), new string('к', 500)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_accepts_start_within_90_days()
+    {
+        var response = await _alice.PostAsJsonAsync(
+            "/api/v1/bookings", Http.NewBooking("lyra", DateTimeOffset.UtcNow.AddDays(89)));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(14)]
+    [InlineData(0)]
+    [InlineData(20)]
+    [InlineData(241)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_with_invalid_duration_is_validation_error(int minutes)
+    {
+        var response = await _alice.PostAsJsonAsync(
+            "/api/v1/bookings", Http.NewBooking("orion", Slots.NextDay().AddHours(7), minutes));
+
+        await Check.ValidationAsync(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_in_the_past_is_validation_error()
+    {
+        var response = await _alice.PostAsJsonAsync("/api/v1/bookings", Http.NewBooking("orion", DateTimeOffset.UtcNow.AddHours(-1)));
+
+        await Check.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_further_than_90_days_is_validation_error()
