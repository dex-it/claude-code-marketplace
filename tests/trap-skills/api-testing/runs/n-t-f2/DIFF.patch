+    [Fact]
+    public async Task ListRooms_LimitAndOffset_SliceThePageAndKeepTotal()
+    {
+        var response = await _alice.GetAsync($"{Api.Rooms}?limit=1&offset=1");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await response.ReadJson();
+        var items = page.GetProperty("items").EnumerateArray().ToList();
+        Assert.Equal(["orion"], items.Select(r => r.GetProperty("id").GetString()));
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+    }
+
+    [Fact]
+    public async Task ListRooms_OffsetBeyondTotal_ReturnsEmptyItems()
+    {
+        var response = await _alice.GetAsync($"{Api.Rooms}?offset=50");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await response.ReadJson();
+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
