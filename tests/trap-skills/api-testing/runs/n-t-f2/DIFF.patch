+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingsTests(ApiFixture api)
+{
+    private readonly HttpClient _alice = api.CreateClient(ApiFixture.AliceKey);
+    private readonly HttpClient _bob = api.CreateClient(ApiFixture.BobKey);
+    private readonly HttpClient _admin = api.CreateClient(ApiFixture.AdminKey);
+
+    private static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    // --- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_ReturnsCreatedBookingWithLocation()
+    {
+        var start = Slots.Next();
+
+        var response = await _alice.CreateBooking("orion", start, 90, "Планирование спринта", "Принести маркеры");
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await response.ReadJson();
+        Contract.AssertBooking(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести маркеры", booking.GetProperty("comment").GetString());
+        Assert.Equal(start, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(start.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal("active", booking.GetProperty("status").GetString());
+        // uri-reference: допустим и относительный, и абсолютный URL
+        var location = response.Headers.Location!;
+        Assert.Equal($"{Api.Bookings}/{Id(booking)}", location.IsAbsoluteUri ? location.AbsolutePath : location.ToString());
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var response = await _alice.PostAsJsonAsync(Api.Bookings,
+            new { roomId = "orion", title = "Синк", startsAt = Api.Iso(Slots.Next()), durationMinutes = 30 });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal(JsonValueKind.Null, (await response.ReadJson()).GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_NonUtcOffset_IsReturnedInUtc()
+    {
+        var start = Slots.Next();
+        var local = start.ToOffset(TimeSpan.FromHours(3)).ToString("yyyy-MM-dd'T'HH:mm:ssK");
+
+        var response = await _alice.PostAsJsonAsync(Api.Bookings,
+            new { roomId = "orion", title = "Синк", startsAt = local, durationMinutes = 30 });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await response.ReadJson();
+        Contract.AssertBooking(booking);
+        Assert.Equal(start, booking.GetProperty("startsAt").GetDateTimeOffset());
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_BoundaryDurations_AreAccepted(int minutes)
+    {
+        var response = await _alice.CreateBooking("lyra", Slots.Next(), minutes);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(14)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var response = await _alice.CreateBooking("lyra", Slots.Next(), minutes);
+
+        await Contract.AssertValidationProblem(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_StartInThePast_Returns400()
+    {
+        var response = await _alice.CreateBooking("lyra", DateTimeOffset.UtcNow.AddHours(-1));
+
+        await Contract.AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await _alice.CreateBooking("lyra", DateTimeOffset.UtcNow.AddDays(91));
+
+        await Contract.AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartWithin90Days_IsAccepted()
+    {
+        var response = await _alice.CreateBooking("lyra", DateTimeOffset.UtcNow.Date.AddDays(89).AddHours(23).AddMinutes(15));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_EmptyTitle_Returns400()
+    {
+        var response = await _alice.CreateBooking("lyra", Slots.Next(), title: "");
+
+        await Contract.AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleLongerThan120_Returns400()
+    {
+        var response = await _alice.CreateBooking("lyra", Slots.Next(), title: new string('я', 121));
+
+        await Contract.AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOf120AndCommentOf500_AreAccepted()
+    {
+        var response = await _alice.CreateBooking("lyra", Slots.Next(), title: new string('я', 120), comment: new string('x', 500));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_CommentLongerThan500_Returns400()
+    {
+        var response = await _alice.CreateBooking("lyra", Slots.Next(), comment: new string('x', 501));
+
+        await Contract.AssertValidationProblem(response, "comment");
+    }
+
+    [Fact(Skip = "Расхождение с контрактом (BKG-31): roomId длиннее 64 - сервис отвечает 404 room-not-found, а не 400")]
+    public async Task Create_RoomIdLongerThan64_Returns400()
+    {
+        var response = await _alice.CreateBooking(new string('a', 65), Slots.Next());
+
+        await Contract.AssertValidationProblem(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_EmptyRoomId_Returns400()
+    {
+        var response = await _alice.CreateBooking("", Slots.Next());
+
+        await Contract.AssertValidationProblem(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_MissingRequiredFields_Returns400()
+    {
+        var response = await _alice.PostAsJsonAsync(Api.Bookings, new { title = "Синк" });
+
+        await Contract.AssertValidationProblem(response);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await _alice.CreateBooking("no-such-room", Slots.Next());
+
+        await Contract.AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_OverlappingActiveBooking_Returns409BookingOverlap()
+    {
+        var start = Slots.Next();
+        await _alice.Booked("orion", start, 60);
+
+        var response = await _bob.CreateBooking("orion", start.AddMinutes(30), 60);
+
+        await Contract.AssertProblem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBooking_IsAccepted()
+    {
+        var start = Slots.Next();
+        await _alice.Booked("orion", start, 60);
+
+        var response = await _bob.CreateBooking("orion", start.AddHours(1), 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_IsAccepted()
+    {
+        var start = Slots.Next();
+        await _alice.Booked("orion", start, 60);
+
+        var response = await _bob.CreateBooking("vega", start, 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_IsAccepted()
+    {
+        var start = Slots.Next();
+        var first = await _alice.Booked("orion", start, 60);
+        (await _alice.DeleteAsync($"{Api.Bookings}/{Id(first)}")).EnsureSuccessStatusCode();
+
+        var response = await _bob.CreateBooking("orion", start, 60);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401Unauthorized()
+    {
+        var response = await api.CreateClient(null).CreateBooking("orion", Slots.Next());
+
+        await Contract.AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- GET /api/v1/bookings/{bookingId}
+
+    [Fact]
+    public async Task Get_ReturnsBooking_ToAnyParticipant()
+    {
+        var created = await _alice.Booked("orion", Slots.Next(), 45);
+
+        var response = await _bob.GetAsync($"{Api.Bookings}/{Id(created)}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await response.ReadJson();
+        Contract.AssertBooking(booking);
+        Assert.Equal(Id(created), Id(booking));
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+        Assert.Equal(created.GetProperty("version").GetInt64(), booking.GetProperty("version").GetInt64());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await _alice.GetAsync($"{Api.Bookings}/{Guid.NewGuid()}");
+
+        await Contract.AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact(Skip = "Расхождение с контрактом (BKG-31): 404 без расширения code, схема Problem требует code")]
+    public async Task Get_IdIsNotUuid_Returns404BookingNotFound()
+    {
+        var response = await _alice.GetAsync($"{Api.Bookings}/not-a-uuid");
+
+        await Contract.AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401Unauthorized()
+    {
+        var response = await api.CreateClient(null).GetAsync($"{Api.Bookings}/{Guid.NewGuid()}");
+
+        await Contract.AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // --- GET /api/v1/bookings
+
+    [Fact]
+    public async Task List_FiltersByRoomAndPeriod_AscendingByStart()
+    {
+        var start = Slots.Next();
+        var second = await _alice.Booked("lyra", start.AddHours(2), 60);
+        var first = await _bob.Booked("lyra", start, 60);
+        var cancelled = await _alice.Booked("lyra", start.AddHours(3), 30);
+        await _alice.Booked("vega", start, 60);
+        (await _alice.DeleteAsync($"{Api.Bookings}/{Id(cancelled)}")).EnsureSuccessStatusCode();
+
+        var response = await _alice.GetAsync(
+            $"{Api.Bookings}?roomId=lyra&from={Api.Iso(start)}&to={Api.Iso(start.AddHours(4))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await response.ReadJson();
+        var items = page.GetProperty("items").EnumerateArray().ToList();
+        items.ForEach(Contract.AssertBooking);
+        Assert.Equal([Id(first), Id(second), Id(cancelled)], items.Select(Id));
+        Assert.Equal(["active", "active", "cancelled"], items.Select(b => b.GetProperty("status").GetString()));
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_AcrossRooms_ReturnsBookingsOfAllRooms()
+    {
+        var start = Slots.Next();
+        var vega = await _alice.Booked("vega", start, 60);
+        var orion = await _alice.Booked("orion", start, 60);
+
+        var response = await _alice.GetAsync($"{Api.Bookings}?from={Api.Iso(start)}&to={Api.Iso(start.AddHours(1))}");
+
+        var items = (await response.ReadJson()).GetProperty("items").EnumerateArray().Select(Id).ToList();
+        Assert.Equal(2, items.Count);
+        Assert.Contains(Id(vega), items);
+        Assert.Contains(Id(orion), items);
+    }
+
+    [Fact]
+    public async Task List_EmptyResult_ReturnsEmptyItemsAndNullCursor()
+    {
+        var start = Slots.Next();
+
+        var response = await _alice.GetAsync($"{Api.Bookings}?roomId=lyra&from={Api.Iso(start)}&to={Api.Iso(start.AddHours(1))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await response.ReadJson();
+        Assert.Empty(page.GetProperty("items").EnumerateArray());
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_Cursor_WalksAllPagesWithoutGapsOrRepeats()
+    {
+        var start = Slots.Next();
+        // три брони с одним началом в разных комнатах и две в одной комнате позже: порядок - (startsAt, id)
+        var expected = new List<string>
+        {
+            Id(await _alice.Booked("orion", start, 30)),
+            Id(await _alice.Booked("vega", start, 30)),
+            Id(await _alice.Booked("lyra", start, 30)),
+            Id(await _alice.Booked("orion", start.AddHours(1), 30)),
+            Id(await _alice.Booked("orion", start.AddHours(2), 30)),
+        };
+        var window = $"from={Api.Iso(start)}&to={Api.Iso(start.AddHours(3))}";
+
+        var seen = new List<string>();
+        var pages = 0;
+        string? cursor = null;
+        do
+        {
+            var url = $"{Api.Bookings}?{window}&limit=2" + (cursor is null ? "" : $"&cursor={Uri.EscapeDataString(cursor)}");
+            var response = await _alice.GetAsync(url);
+            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+            var page = await response.ReadJson();
+            var items = page.GetProperty("items").EnumerateArray().ToList();
+            Assert.True(items.Count <= 2);
+            seen.AddRange(items.Select(Id));
+            var next = page.GetProperty("nextCursor");
+            cursor = next.ValueKind == JsonValueKind.Null ? null : next.GetString();
+            if (cursor is not null)
+                Assert.Equal(2, items.Count);
+            pages++;
+        } while (cursor is not null && pages < 10);
+
+        Assert.Equal(3, pages);
+        Assert.Equal(expected.Order().ToList(), seen.Order().ToList());
+        Assert.Equal(seen.Count, seen.Distinct().Count());
+        // внутри одного начала - по возрастанию id
+        Assert.Equal(expected.Take(3).Order(StringComparer.Ordinal).ToList(), seen.Take(3).ToList());
+    }
+
+    [Fact]
+    public async Task List_ExactlyOnePage_HasNullCursor()
+    {
+        var start = Slots.Next();
+        await _alice.Booked("orion", start, 30);
+        await _alice.Booked("orion", start.AddHours(1), 30);
+
+        var response = await _alice.GetAsync($"{Api.Bookings}?from={Api.Iso(start)}&to={Api.Iso(start.AddHours(2))}&limit=2");
+
+        var page = await response.ReadJson();
+        Assert.Equal(2, page.GetProperty("items").GetArrayLength());
+        Assert.Equal(JsonValueKind.Null, page.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("limit=abc", "limit")]
+    [InlineData("cursor=%21%21%21", "cursor")]
+    [InlineData("from=yesterday", "from")]
+    [InlineData("to=tomorrow", "to")]
+    public async Task List_InvalidQuery_Returns400(string query, string field)
+    {
+        var response = await _alice.GetAsync($"{Api.Bookings}?{query}");
+
+        await Contract.AssertValidationProblem(response, field);
+    }
+
+    [Fact]
+    public async Task List_WithoutKey_Returns401Unauthorized()
+    {
+        var response = await api.CreateClient(null).GetAsync(Api.Bookings);
+
+        await Contract.AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
