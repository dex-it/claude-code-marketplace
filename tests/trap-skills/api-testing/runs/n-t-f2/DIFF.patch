+        await Contract.AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_ReturnsActiveAndCancelledAscendingByStart_WithoutPaging()
+    {
+        var start = Slots.Next();
+        var later = await _alice.Booked("vega", start.AddHours(2), 60);
+        var earlier = await _alice.Booked("vega", start, 60);
+        var cancelled = await _alice.Booked("vega", start.AddHours(4), 30);
+        (await _alice.DeleteAsync($"{Api.Bookings}/{cancelled.GetProperty("id").GetString()}")).EnsureSuccessStatusCode();
