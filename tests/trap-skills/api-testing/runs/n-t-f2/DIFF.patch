+
+    [Fact]
+    public async Task ListRooms_ReturnsPageOrderedById()
+    {
+        var response = await _alice.GetAsync(Api.Rooms);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await response.ReadJson();
+        var items = page.GetProperty("items").EnumerateArray().ToList();
+        Assert.Equal(3, page.GetProperty("total").GetInt32());
+        Assert.Equal(["lyra", "orion", "vega"], items.Select(r => r.GetProperty("id").GetString()));
+        items.ForEach(Contract.AssertRoom);
+    }
