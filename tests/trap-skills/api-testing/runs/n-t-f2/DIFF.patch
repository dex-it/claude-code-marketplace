@@ -0,0 +1,125 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Выдаёт каждому вызову своё окно времени, чтобы тесты на общей БД не пересекались по броням.</summary>
+public static class Slots
+{
+    private static int _next;
+
+    /// <summary>Начало окна длиной 4 часа, в будущем и в пределах 90 дней; шаг между окнами - 5 часов.</summary>
+    public static DateTimeOffset Next()
+    {
+        var index = Interlocked.Increment(ref _next);
+        if (index > 400)
+            throw new InvalidOperationException("Окна времени исчерпаны: добавьте очистку БД между классами тестов.");
+
+        var origin = DateTimeOffset.UtcNow.Date.AddDays(2);
+        return new DateTimeOffset(origin.AddHours(index * 5), TimeSpan.Zero);
+    }
+}
+
+public static class Api
+{
+    public const string Rooms = "/api/v1/rooms";
+    public const string Bookings = "/api/v1/bookings";
+
+    public static string Iso(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
+
+    public static async Task<JsonElement> ReadJson(this HttpResponseMessage response)
+    {
+        var text = await response.Content.ReadAsStringAsync();
+        using var doc = JsonDocument.Parse(text);
+        return doc.RootElement.Clone();
+    }
+
+    public static Task<HttpResponseMessage> CreateBooking(
+        this HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60,
+        string title = "Планирование спринта", string? comment = null) =>
+        client.PostAsJsonAsync(Bookings, new { roomId, title, startsAt = Iso(startsAt), durationMinutes, comment });
+
+    /// <summary>Создаёт бронь и возвращает её тело; падает, если ответ не 201.</summary>
+    public static async Task<JsonElement> Booked(
+        this HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60)
+    {
+        var response = await client.CreateBooking(roomId, startsAt, durationMinutes);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await response.ReadJson();
+    }
+
+    public static Task<HttpResponseMessage> Reschedule(
+        this HttpClient client, string id, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"{Bookings}/{id}", new { startsAt = Iso(startsAt), durationMinutes, version });
+}
+
+/// <summary>Проверки формы ответов по схемам api/openapi.yaml.</summary>
+public static class Contract
+{
+    private static readonly string[] CodeEnum =
+        ["unauthorized", "room-not-found", "booking-not-found", "not-owner", "booking-overlap", "version-conflict", "booking-cancelled"];
+
+    public static void AssertRoom(JsonElement room)
+    {
+        Assert.Equal(JsonValueKind.Object, room.ValueKind);
+        Assert.Matches("^[a-z0-9-]{1,64}$", room.GetProperty("id").GetString());
+        var name = room.GetProperty("name").GetString()!;
+        Assert.InRange(name.Length, 1, 120);
+        Assert.InRange(room.GetProperty("capacity").GetInt32(), 1, 50);
+        Assert.Equal(JsonValueKind.Number, room.GetProperty("floor").ValueKind);
+        var features = room.GetProperty("features");
+        Assert.Equal(JsonValueKind.Array, features.ValueKind);
+        foreach (var feature in features.EnumerateArray())
+            Assert.Contains(feature.GetString(), new[] { "projector", "whiteboard", "videoconf" });
+    }
+
+    public static void AssertBooking(JsonElement booking)
+    {
+        Assert.Equal(JsonValueKind.Object, booking.ValueKind);
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.True(booking.GetProperty("roomId").GetString()!.Length <= 64);
+        Assert.InRange(booking.GetProperty("title").GetString()!.Length, 1, 120);
+        var comment = booking.GetProperty("comment");
+        Assert.True(comment.ValueKind is JsonValueKind.Null or JsonValueKind.String);
+        var startsAt = DateTimeOffset.Parse(booking.GetProperty("startsAt").GetString()!);
+        var endsAt = DateTimeOffset.Parse(booking.GetProperty("endsAt").GetString()!);
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        Assert.Equal(startsAt.AddMinutes(duration), endsAt);
+        Assert.Equal(TimeSpan.Zero, startsAt.Offset);
+        Assert.False(string.IsNullOrEmpty(booking.GetProperty("ownerId").GetString()));
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+    }
+
+    public static async Task AssertProblem(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await response.ReadJson();
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(JsonValueKind.String, body.GetProperty("type").ValueKind);
+        Assert.Equal(JsonValueKind.String, body.GetProperty("title").ValueKind);
+        Assert.True(body.TryGetProperty("code", out var actual), "в problem+json нет расширения code");
+        Assert.Equal(code, actual.GetString());
+        Assert.Contains(code, CodeEnum);
+    }
+
+    public static async Task AssertValidationProblem(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await response.ReadJson();
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        var errors = body.GetProperty("errors");
+        Assert.Equal(JsonValueKind.Object, errors.ValueKind);
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"нет ошибки по полю {field}");
+            Assert.Equal(JsonValueKind.Array, messages.ValueKind);
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+}
