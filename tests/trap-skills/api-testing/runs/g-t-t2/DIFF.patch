+
+    [Theory]
+    [InlineData("")]
+    [InlineData("   ")]
+    public async Task Create_rejects_blank_title(string title)
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title, startsAt = api.NextStart(), durationMinutes = 30,
+        });
+
+        await ApiAssert.ValidationAsync(response, "title");
