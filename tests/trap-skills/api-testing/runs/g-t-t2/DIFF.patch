+
+    [Fact]
+    public async Task Create_rejects_too_long_title()
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title = new string('т', 121), startsAt = api.NextStart(), durationMinutes = 30,
+        });
+
+        await ApiAssert.ValidationAsync(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_rejects_too_long_comment()
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title = "Встреча", startsAt = api.NextStart(), durationMinutes = 30,
+            comment = new string('к', 501),
+        });
