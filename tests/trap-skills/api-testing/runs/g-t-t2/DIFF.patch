+using System.Net;
+using System.Net.Http.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class ChangeBookingTests(ApiFixture api)
+{
+    // PATCH /api/v1/bookings/{bookingId} (FR-06, FR-10)
+
+    [Fact]
+    public async Task Reschedule_by_owner_moves_booking_and_changes_version()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+        var newStart = api.NextStart();
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, newStart, 90);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var moved = await ApiAssert.JsonAsync(response);
+        ApiAssert.Booking(moved);
+        Assert.Equal(ApiAssert.Id(booking), ApiAssert.Id(moved));
+        Assert.Equal(newStart, moved.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, moved.GetProperty("durationMinutes").GetInt32());
+        Assert.NotEqual(booking.GetProperty("version").GetInt64(), moved.GetProperty("version").GetInt64());
+        Assert.Equal("alice", moved.GetProperty("ownerId").GetString());
+
+        var stored = await ApiAssert.GetAsync(api.Bob, ApiAssert.Id(booking));
+        Assert.Equal(newStart, stored.GetProperty("startsAt").GetDateTimeOffset());
+    }
+
+    [Fact(Skip = KnownDivergence.EndsAtDropsMinutes)]
+    public async Task Reschedule_computes_endsAt_as_start_plus_duration()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+        var newStart = api.NextStart();
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, newStart, 90);
+
+        var moved = await ApiAssert.JsonAsync(response);
+        Assert.Equal(newStart.AddMinutes(90), moved.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Reschedule_by_admin_is_allowed()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Admin, booking, api.NextStart(), 30);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact(Skip = KnownDivergence.RescheduleSkipsOwnerCheck)]
+    public async Task Reschedule_by_another_member_is_forbidden_and_booking_stays()
+    {
+        var startsAt = api.NextStart();
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", startsAt, 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Bob, booking, api.NextStart(), 30);
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.Forbidden, "not-owner");
+        var stored = await ApiAssert.GetAsync(api.Alice, ApiAssert.Id(booking));
+        Assert.Equal(startsAt, stored.GetProperty("startsAt").GetDateTimeOffset());
+    }
+
+    [Fact(Skip = KnownDivergence.RescheduleIgnoresVersion)]
+    public async Task Reschedule_with_stale_version_is_conflict_and_booking_stays()
+    {
+        var startsAt = api.NextStart();
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", startsAt, 60);
+        var firstMove = await ApiAssert.RescheduleAsync(api.Alice, booking, api.NextStart(), 60);
+        Assert.Equal(HttpStatusCode.OK, firstMove.StatusCode);
+        var current = await ApiAssert.JsonAsync(firstMove);
+
+        // версия из первого чтения брони устарела
+        var stale = await ApiAssert.RescheduleAsync(api.Alice, booking, api.NextStart(), 30);
+
+        await ApiAssert.ProblemAsync(stale, HttpStatusCode.Conflict, "version-conflict");
+        var stored = await ApiAssert.GetAsync(api.Alice, ApiAssert.Id(booking));
+        Assert.Equal(current.GetProperty("startsAt").GetDateTimeOffset(), stored.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(current.GetProperty("version").GetInt64(), stored.GetProperty("version").GetInt64());
+    }
+
+    [Fact(Skip = KnownDivergence.OverlapIsNotProblem)]
+    public async Task Reschedule_onto_another_active_booking_is_conflict()
+    {
+        var busy = api.NextStart();
+        await ApiAssert.CreateAsync(api.Bob, "orion", busy, 60);
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, busy.AddMinutes(30), 60);
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Reschedule_overlapping_its_own_old_time_is_allowed()
+    {
+        var startsAt = api.NextStart();
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", startsAt, 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, startsAt.AddMinutes(30), 60);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Reschedule_cancelled_booking_is_conflict()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+        await api.Alice.DeleteAsync($"/api/v1/bookings/{ApiAssert.Id(booking)}");
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, api.NextStart(), 60);
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.Conflict, "booking-cancelled");
+    }
+
+    [Fact]
+    public async Task Reschedule_unknown_booking_is_not_found()
+    {
+        var response = await api.Alice.PatchAsJsonAsync($"/api/v1/bookings/{Guid.NewGuid()}", new
+        {
+            startsAt = api.NextStart(), durationMinutes = 30, version = 1,
+        });
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Reschedule_rejects_start_in_the_past()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, DateTimeOffset.UtcNow.AddMinutes(-5), 60);
+
+        await ApiAssert.ValidationAsync(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Reschedule_rejects_start_beyond_90_days()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, DateTimeOffset.UtcNow.AddDays(91), 60);
+
+        await ApiAssert.ValidationAsync(response, "startsAt");
+    }
+
+    [Theory]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    public async Task Reschedule_rejects_invalid_duration(int durationMinutes)
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Alice, booking, api.NextStart(), durationMinutes);
+
+        await ApiAssert.ValidationAsync(response, "durationMinutes");
+    }
+
+    [Fact(Skip = KnownDivergence.RescheduleVersionOptional)]
+    public async Task Reschedule_without_version_is_rejected()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
+        var response = await api.Alice.PatchAsJsonAsync($"/api/v1/bookings/{ApiAssert.Id(booking)}", new
+        {
+            startsAt = api.NextStart(), durationMinutes = 30,
+        });
+
+        await ApiAssert.ValidationAsync(response, "version");
+    }
+
+    [Fact]
+    public async Task Reschedule_without_key_is_unauthorized()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
+        var response = await ApiAssert.RescheduleAsync(api.Anonymous, booking, api.NextStart(), 30);
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // DELETE /api/v1/bookings/{bookingId} (FR-07, FR-10, FR-11)
+
+    [Fact]
+    public async Task Cancel_by_owner_keeps_booking_in_history_as_cancelled()
+    {
+        var booking = await ApiAssert.CreateAsync(api.Alice, "orion", api.NextStart(), 60);
+
