+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class CreateBookingTests(ApiFixture api)
+{
+    // POST /api/v1/bookings (FR-03, FR-05, FR-08, FR-09)
+
+    [Fact]
+    public async Task Create_returns_201_with_booking_of_the_key_owner()
+    {
+        var startsAt = api.NextStart();
+
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title = "Планирование спринта", startsAt, durationMinutes = 90, comment = "Принести маркеры",
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ApiAssert.JsonAsync(response);
