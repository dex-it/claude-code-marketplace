+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(300)]
+    public async Task Create_rejects_invalid_duration(int durationMinutes)
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title = "Встреча", startsAt = api.NextStart(), durationMinutes,
+        });
+
+        await ApiAssert.ValidationAsync(response, "durationMinutes");
