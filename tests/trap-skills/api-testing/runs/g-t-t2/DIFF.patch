+
+    [Fact]
+    public async Task Create_rejects_empty_room_id()
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "", title = "Встреча", startsAt = api.NextStart(), durationMinutes = 30,
+        });
+
+        await ApiAssert.ValidationAsync(response, "roomId");
+    }
+
+    [Fact]
+    public async Task Create_rejects_body_without_required_fields()
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new { roomId = "orion" });
+
+        await ApiAssert.ValidationAsync(response);
+    }
+
+    [Fact]
+    public async Task Create_unknown_room_is_not_found()
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "no-such-room", title = "Встреча", startsAt = api.NextStart(), durationMinutes = 30,
+        });
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_without_key_is_unauthorized()
+    {
+        var response = await api.Anonymous.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title = "Встреча", startsAt = api.NextStart(), durationMinutes = 30,
+        });
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // FR-09: пересечения
+
+    [Theory(Skip = KnownDivergence.OverlapIsNotProblem)]
+    [InlineData(0, 60)]    // то же время
+    [InlineData(30, 60)]   // начало внутри
+    [InlineData(-30, 60)]  // конец внутри
+    [InlineData(-60, 180)] // охватывает
+    public async Task Create_overlapping_active_booking_is_conflict(int offsetMinutes, int durationMinutes)
+    {
+        await AssertOverlapConflictAsync(offsetMinutes, durationMinutes);
+    }
+
+    [Fact(Skip = KnownDivergence.EndsAtDropsMinutes)]
+    public async Task Create_short_booking_inside_active_one_is_conflict()
+    {
+        await AssertOverlapConflictAsync(15, 15);
+    }
+
+    private async Task AssertOverlapConflictAsync(int offsetMinutes, int durationMinutes)
+    {
+        var startsAt = api.NextStart().AddHours(1);
+        await ApiAssert.CreateAsync(api.Alice, "orion", startsAt, 60);
+
+        var response = await api.Bob.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title = "Другая встреча", startsAt = startsAt.AddMinutes(offsetMinutes), durationMinutes,
+        });
+
+        await ApiAssert.ProblemAsync(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_adjacent_booking_is_not_overlap()
+    {
+        var startsAt = api.NextStart();
+        await ApiAssert.CreateAsync(api.Alice, "orion", startsAt, 60);
+
+        await ApiAssert.CreateAsync(api.Bob, "orion", startsAt.AddHours(1), 60);
+        await ApiAssert.CreateAsync(api.Bob, "orion", startsAt.AddHours(-1), 60);
+    }
+
+    [Fact]
+    public async Task Create_same_time_in_another_room_is_not_overlap()
+    {
+        var startsAt = api.NextStart();
+        await ApiAssert.CreateAsync(api.Alice, "orion", startsAt, 60);
+
+        await ApiAssert.CreateAsync(api.Bob, "vega", startsAt, 60);
+    }
+
+    [Fact]
+    public async Task Create_over_cancelled_booking_is_allowed()
+    {
+        var startsAt = api.NextStart();
+        var first = await ApiAssert.CreateAsync(api.Alice, "orion", startsAt, 60);
+        var cancel = await api.Alice.DeleteAsync($"/api/v1/bookings/{ApiAssert.Id(first)}");
+        Assert.Equal(HttpStatusCode.NoContent, cancel.StatusCode);
+
+        await ApiAssert.CreateAsync(api.Bob, "orion", startsAt, 60);
+    }
+
+    [Fact]
+    public async Task Create_concurrent_requests_for_the_same_slot_let_exactly_one_through()
+    {
+        var startsAt = api.NextStart();
+        var attempts = Enumerable.Range(0, 8)
+            .Select(_ => Task.Run(() => api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+            {
+                roomId = "lyra", title = "Гонка", startsAt, durationMinutes = 60,
+            })))
+            .ToArray();
+
+        var responses = await Task.WhenAll(attempts);
+
+        Assert.Equal(1, responses.Count(r => r.StatusCode == HttpStatusCode.Created));
+        var losers = responses.Where(r => r.StatusCode != HttpStatusCode.Created).ToList();
+        Assert.All(losers, loser => Assert.Equal(HttpStatusCode.Conflict, loser.StatusCode));
+    }
