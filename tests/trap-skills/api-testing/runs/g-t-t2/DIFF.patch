@@ -0,0 +1,107 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Проверки форм ответов по схемам api/openapi.yaml и вспомогательные вызовы API.</summary>
+public static class ApiAssert
+{
+    private static readonly string[] BookingRequired =
+        ["id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version"];
+
+    public static async Task<JsonElement> JsonAsync(HttpResponseMessage response) =>
+        await response.Content.ReadFromJsonAsync<JsonElement>();
+
+    public static async Task<JsonElement> CreateAsync(
+        HttpClient client, string roomId, DateTimeOffset startsAt, int durationMinutes = 60,
+        string title = "Встреча", string? comment = null)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", new { roomId, title, startsAt, durationMinutes, comment });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await JsonAsync(response);
+    }
+
+    public static Task<HttpResponseMessage> RescheduleAsync(
+        HttpClient client, JsonElement booking, DateTimeOffset startsAt, int durationMinutes, long? version = null) =>
+        client.PatchAsJsonAsync(
+            $"/api/v1/bookings/{booking.GetProperty("id").GetString()}",
+            new { startsAt, durationMinutes, version = version ?? booking.GetProperty("version").GetInt64() });
+
+    /// <summary>
+    /// Элементы items страницы; null вместо массива даёт пустой список - строго это проверяют
+    /// отдельные тесты, чтобы остальные не падали по той же причине.
+    /// </summary>
+    public static List<JsonElement> Items(JsonElement page)
+    {
+        var items = page.GetProperty("items");
+        return items.ValueKind == JsonValueKind.Array ? items.EnumerateArray().ToList() : [];
+    }
+
+    public static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    public static async Task<JsonElement> GetAsync(HttpClient client, string id)
+    {
+        var response = await client.GetAsync($"/api/v1/bookings/{id}");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        return await JsonAsync(response);
+    }
+
+    /// <summary>Брони из постраничного ответа в окне [from, to] по комнате (если задана).</summary>
+    public static string WindowQuery(DateTimeOffset from, DateTimeOffset to, string? roomId = null) =>
+        $"from={Uri.EscapeDataString(from.ToString("O"))}&to={Uri.EscapeDataString(to.ToString("O"))}"
+        + (roomId is null ? "" : $"&roomId={roomId}");
+
+    public static void Booking(JsonElement booking)
+    {
+        Assert.Equal(JsonValueKind.Object, booking.ValueKind);
+        foreach (var name in BookingRequired)
+            Assert.True(booking.TryGetProperty(name, out _), $"В брони нет обязательного поля {name}");
+
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.Contains(booking.GetProperty("comment").ValueKind, new[] { JsonValueKind.String, JsonValueKind.Null });
+        Assert.True(DateTimeOffset.TryParse(booking.GetProperty("startsAt").GetString(), out _));
+        Assert.True(DateTimeOffset.TryParse(booking.GetProperty("endsAt").GetString(), out _));
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.InRange(duration, 15, 240);
+        Assert.Equal(0, duration % 15);
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+    }
+
+    public static void Room(JsonElement room, string id, string name, int capacity, int floor, params string[] features)
+    {
+        Assert.Equal(id, room.GetProperty("id").GetString());
+        Assert.Equal(name, room.GetProperty("name").GetString());
+        Assert.Equal(capacity, room.GetProperty("capacity").GetInt32());
+        Assert.Equal(floor, room.GetProperty("floor").GetInt32());
+        Assert.Equal(features, room.GetProperty("features").EnumerateArray().Select(f => f.GetString()).ToArray());
+    }
+
+    /// <summary>Ошибка - application/problem+json со status и code (Problem в контракте).</summary>
+    public static async Task ProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await JsonAsync(response);
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.Equal(code, problem.GetProperty("code").GetString());
+        Assert.True(problem.TryGetProperty("type", out _));
+        Assert.True(problem.TryGetProperty("title", out _));
+    }
+
+    /// <summary>400 - ValidationProblem: errors содержит поля запроса (camelCase).</summary>
+    public static async Task ValidationAsync(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await JsonAsync(response);
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        var errors = problem.GetProperty("errors");
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"В errors нет поля {field}");
+            Assert.NotEmpty(messages.EnumerateArray());
+        }
+    }
+}
