+
+    [Theory(Skip = KnownDivergence.EndsAtDropsMinutes)]
+    [InlineData(15)]
+    [InlineData(45)]
+    [InlineData(90)]
+    public async Task Create_computes_endsAt_as_start_plus_duration(int durationMinutes)
