+using Microsoft.AspNetCore.Mvc.Testing;
+using Testcontainers.PostgreSql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис на настоящем PostgreSQL: ограничение от пересечений броней (EXCLUDE) и конкурентность
+/// держит сама база, на EF InMemory/Sqlite это не проверить.
+/// </summary>
+public sealed class ApiFixture : IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine")
+        .WithDatabase("bookings")
+        .WithUsername("bookings")
+        .WithPassword("bookings")
+        .Build();
+
+    private BookingsFactory? _factory;
+    private DateTimeOffset _nextStart;
+
+    public HttpClient Alice { get; private set; } = null!;
+    public HttpClient Bob { get; private set; } = null!;
+    public HttpClient Admin { get; private set; } = null!;
+    public HttpClient Anonymous { get; private set; } = null!;
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+
+        _factory = new BookingsFactory(_postgres.GetConnectionString());
+        Alice = ClientWithKey(AliceKey);
+        Bob = ClientWithKey(BobKey);
+        Admin = ClientWithKey(AdminKey);
+        Anonymous = _factory.CreateClient();
+
+        var now = DateTimeOffset.UtcNow;
+        _nextStart = new DateTimeOffset(now.Year, now.Month, now.Day, now.Hour, 0, 0, TimeSpan.Zero).AddDays(1);
+    }
+
+    public async Task DisposeAsync()
+    {
+        _factory?.Dispose();
+        await _postgres.DisposeAsync();
+    }
+
+    /// <summary>
+    /// Начало, свободное во всех комнатах: слоты не повторяются между тестами (шаг 4 часа - не меньше
+    /// максимальной длительности), поэтому тесты не мешают друг другу и окно from/to выделяет их брони.
+    /// </summary>
+    public DateTimeOffset NextStart()
+    {
+        lock (this)
+        {
+            var start = _nextStart;
+            _nextStart = _nextStart.AddHours(4);
+            return start;
+        }
+    }
+
+    private HttpClient ClientWithKey(string key)
+    {
+        var client = _factory!.CreateClient();
+        client.DefaultRequestHeaders.Add("X-Api-Key", key);
+        return client;
+    }
+
+    private sealed class BookingsFactory(string connectionString) : WebApplicationFactory<Program>
+    {
+        protected override void ConfigureWebHost(IWebHostBuilder builder)
+        {
+            builder.UseSetting("ConnectionStrings:Bookings", connectionString);
+            builder.UseSetting("Database:Initialize", "true");
+            builder.UseSetting("Auth:Keys:0:key", AliceKey);
+            builder.UseSetting("Auth:Keys:0:userId", "alice");
+            builder.UseSetting("Auth:Keys:0:role", "member");
+            builder.UseSetting("Auth:Keys:1:key", BobKey);
+            builder.UseSetting("Auth:Keys:1:userId", "bob");
+            builder.UseSetting("Auth:Keys:1:role", "member");
+            builder.UseSetting("Auth:Keys:2:key", AdminKey);
+            builder.UseSetting("Auth:Keys:2:userId", "admin");
+            builder.UseSetting("Auth:Keys:2:role", "admin");
+        }
+    }
+}
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "Api";
+}
