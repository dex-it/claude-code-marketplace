@@ -0,0 +1,35 @@
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Подтверждённые расхождения сервиса с api/openapi.yaml (BKG-31). Тесты с этими причинами
+/// пропущены, пока сервис не исправлен; убрать Skip - значит вернуть проверку.
+/// </summary>
+public static class KnownDivergence
+{
+    public const string EndsAtDropsMinutes =
+        "Расхождение: endsAt = startsAt + durationMinutes/60 часов - минуты не из целых часов теряются";
+
+    public const string OverlapIsNotProblem =
+        "Расхождение: 409 при пересечении - {\"error\":\"overlap\"} (application/json), контракт - problem+json с code booking-overlap";
+
+    public const string CreateWithoutLocation =
+        "Расхождение: 201 без заголовка Location";
+
+    public const string ListLimitNotValidated =
+        "Расхождение: limit вне 1..100 в GET /bookings принимается (200), контракт - 400";
+
+    public const string EmptyItemsIsNull =
+        "Расхождение: пустая лента броней - items: null, контракт - items: []";
+
+    public const string CancelTwiceFails =
+        "Расхождение: повторная отмена - 500, контракт (FR-11) - 204";
+
+    public const string RescheduleIgnoresVersion =
+        "Расхождение: PATCH не сверяет version, устаревшая версия принимается (200), контракт - 409 version-conflict";
+
+    public const string RescheduleVersionOptional =
+        "Расхождение: PATCH без version принимается (200), контракт - version обязателен, 400";
+
+    public const string RescheduleSkipsOwnerCheck =
+        "Расхождение: PATCH чужой брони участником - 200, контракт (FR-10) - 403 not-owner";
+}
