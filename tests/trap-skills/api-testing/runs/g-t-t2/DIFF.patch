+    [Fact(Skip = KnownDivergence.CreateWithoutLocation)]
+    public async Task Create_sets_location_of_the_created_booking()
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "orion", title = "Встреча", startsAt = api.NextStart(), durationMinutes = 30,
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ApiAssert.JsonAsync(response);
+        Assert.NotNull(response.Headers.Location);
+        Assert.EndsWith($"/api/v1/bookings/{ApiAssert.Id(booking)}", response.Headers.Location!.ToString());
+    }
+
+    [Fact]
+    public async Task Create_without_comment_returns_null_comment()
+    {
+        var response = await api.Alice.PostAsJsonAsync("/api/v1/bookings", new
+        {
+            roomId = "vega", title = "Встреча", startsAt = api.NextStart(), durationMinutes = 15,
+        });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ApiAssert.JsonAsync(response);
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(45)]
+    [InlineData(240)]
+    public async Task Create_accepts_boundary_and_step_durations(int durationMinutes)
+    {
+        var startsAt = api.NextStart();
+        api.NextStart(); // 240 минут занимают и следующий слот: окна from/to других тестов их не заденут
