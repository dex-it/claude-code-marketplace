+using System.Net;
+using System.Net.Http.Json;
+using System.Text;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsApiTests(ApiFixture api) : ApiTestBase(api)
+{
+    // ---- createBooking (FR-03, FR-05, FR-08, FR-09) ----
+
+    [Fact]
+    public async Task Create_Valid_Returns201WithBookingAndLocation()
+    {
+        var slot = Api.NextSlot();
+
+        var response = await Create(Alice, NewBooking(slot, 90, comment: "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJson(response);
+        AssertBooking(booking, "active");
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести ноутбуки", booking.GetProperty("comment").GetString());
+        Assert.Equal(slot, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+
+        var location = response.Headers.Location;
+        Assert.NotNull(location);
+        Assert.EndsWith(BookingUrl(booking), location!.ToString());
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var booking = await CreateOk(Alice, NewBooking(Api.NextSlot()));
+
+        Assert.Equal(JsonValueKind.Null, booking.GetProperty("comment").ValueKind);
+    }
+
+    [Fact]
+    public async Task Create_NonUtcStart_IsReturnedInUtc()
+    {
+        var slot = Api.NextSlot();
+        var body = new { roomId = "orion", title = "Созвон", startsAt = slot.ToOffset(TimeSpan.FromHours(3)).ToString("O"), durationMinutes = 30 };
+
+        var booking = await CreateOk(Alice, body);
+
+        AssertBooking(booking);
+        Assert.Equal(slot, booking.GetProperty("startsAt").GetDateTimeOffset());
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_BoundaryDuration_Returns201(int minutes)
+    {
+        var response = await Create(Alice, NewBooking(Api.NextSlot(), minutes));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(14)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_InvalidDuration_Returns400(int minutes)
+    {
+        var response = await Create(Alice, NewBooking(Api.NextSlot(), minutes));
+
+        await AssertValidationProblem(response, "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_StartInPast_Returns400()
+    {
+        var response = await Create(Alice, NewBooking(DateTimeOffset.UtcNow.AddHours(-1)));
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await Create(Alice, NewBooking(DateTimeOffset.UtcNow.AddDays(91)));
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartWithin90Days_Returns201()
+    {
+        var start = new DateTimeOffset(DateTime.UtcNow.Date.AddDays(89).AddHours(8), TimeSpan.Zero);
+
+        var response = await Create(Alice, NewBooking(start, 30, "lyra"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_TitleBoundaries()
+    {
+        var ok = await Create(Alice, NewBooking(Api.NextSlot(), title: new string('я', 120)));
+        var tooLong = await Create(Alice, NewBooking(Api.NextSlot(), title: new string('я', 121)));
+        var empty = await Create(Alice, NewBooking(Api.NextSlot(), title: ""));
+
+        Assert.Equal(HttpStatusCode.Created, ok.StatusCode);
+        await AssertValidationProblem(tooLong, "title");
+        await AssertValidationProblem(empty, "title");
+    }
+
+    [Fact]
+    public async Task Create_CommentBoundaries()
+    {
+        var ok = await Create(Alice, NewBooking(Api.NextSlot(), comment: new string('x', 500)));
+        var tooLong = await Create(Alice, NewBooking(Api.NextSlot(), comment: new string('x', 501)));
+
+        Assert.Equal(HttpStatusCode.Created, ok.StatusCode);
+        await AssertValidationProblem(tooLong, "comment");
+    }
+
+    [Fact]
+    public async Task Create_ReportsAllInvalidFieldsAtOnce()
+    {
+        var response = await Create(Alice, NewBooking(DateTimeOffset.UtcNow.AddDays(-1), 7, title: ""));
+
+        await AssertValidationProblem(response, "title", "startsAt", "durationMinutes");
+    }
+
+    [Fact]
+    public async Task Create_MalformedJson_Returns400()
+    {
+        var response = await Alice.PostAsync("/api/v1/bookings", new StringContent("{", Encoding.UTF8, "application/json"));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404()
+    {
+        var response = await Create(Alice, NewBooking(Api.NextSlot(), roomId: "no-such-room"));
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401()
+    {
+        var response = await Create(Anonymous, NewBooking(Api.NextSlot()));
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Create_OverlappingActiveBooking_Returns409Overlap()
+    {
+        var slot = Api.NextSlot();
+        await CreateOk(Alice, NewBooking(slot, 60));
+
+        var response = await Create(Bob, NewBooking(slot.AddMinutes(30), 60));
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBooking_Returns201()
+    {
+        var slot = Api.NextSlot();
+        await CreateOk(Alice, NewBooking(slot, 60));
+
+        var response = await Create(Bob, NewBooking(slot.AddHours(1), 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_Returns201()
+    {
+        var slot = Api.NextSlot();
+        await CreateOk(Alice, NewBooking(slot, 60, "orion"));
+
+        var response = await Create(Bob, NewBooking(slot, 60, "vega"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_Returns201()
+    {
+        var slot = Api.NextSlot();
+        var first = await CreateOk(Alice, NewBooking(slot, 60));
+        Assert.Equal(HttpStatusCode.NoContent, (await Alice.DeleteAsync(BookingUrl(first))).StatusCode);
+
+        var response = await Create(Bob, NewBooking(slot, 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_ConcurrentSameSlot_ExactlyOneWins()
+    {
+        var slot = Api.NextSlot();
+        var clients = new[] { Alice, Bob, Admin, Alice, Bob, Admin };
+
+        var responses = await Task.WhenAll(clients.Select(c => Create(c, NewBooking(slot, 60, "lyra"))));
+
+        Assert.Equal(1, responses.Count(r => r.StatusCode == HttpStatusCode.Created));
+        foreach (var loser in responses.Where(r => r.StatusCode != HttpStatusCode.Created))
+            await AssertProblem(loser, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    // ---- getBooking (FR-04) ----
+
+    [Fact]
+    public async Task Get_ReturnsBooking_AlsoForNonOwner()
+    {
+        var created = await CreateOk(Alice, NewBooking(Api.NextSlot()));
+
+        var response = await Bob.GetAsync(BookingUrl(created));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadJson(response);
+        AssertBooking(booking, "active");
+        Assert.Equal(created.GetProperty("id").GetString(), booking.GetProperty("id").GetString());
+        Assert.Equal("alice", booking.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404()
+    {
+        var response = await Alice.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401()
+    {
+        var response = await Anonymous.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // ---- listBookings (FR-02) ----
+
+    [Fact]
+    public async Task List_FiltersByRoomAndPeriod_AscendingByStartThenId()
+    {
+        var slot = Api.NextSlot();
