@@ -0,0 +1,119 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase
+{
+    protected ApiTestBase(ApiFixture api)
+    {
+        Api = api;
+        Alice = api.CreateClient(ApiFixture.AliceKey);
+        Bob = api.CreateClient(ApiFixture.BobKey);
+        Admin = api.CreateClient(ApiFixture.AdminKey);
+        Anonymous = api.CreateClient(null);
+    }
+
+    protected ApiFixture Api { get; }
+    protected HttpClient Alice { get; }
+    protected HttpClient Bob { get; }
+    protected HttpClient Admin { get; }
+    protected HttpClient Anonymous { get; }
+
+    protected static string Iso(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
+
+    protected static string Q(DateTimeOffset value) => Uri.EscapeDataString(Iso(value));
+
+    protected static async Task<JsonElement> ReadJson(HttpResponseMessage response)
+    {
+        var text = await response.Content.ReadAsStringAsync();
+        return JsonDocument.Parse(text).RootElement.Clone();
+    }
+
+    protected static object NewBooking(
+        DateTimeOffset startsAt, int durationMinutes = 60, string roomId = "orion", string title = "Планирование спринта", string? comment = null) =>
+        new { roomId, title, startsAt = Iso(startsAt), durationMinutes, comment };
+
+    protected static Task<HttpResponseMessage> Create(HttpClient client, object body) =>
+        client.PostAsJsonAsync("/api/v1/bookings", body);
+
+    /// <summary>Создаёт бронь и возвращает её (проверяя только 201).</summary>
+    protected static async Task<JsonElement> CreateOk(HttpClient client, object body)
+    {
+        var response = await Create(client, body);
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJson(response);
+    }
+
+    protected static string BookingUrl(JsonElement booking) => $"/api/v1/bookings/{booking.GetProperty("id").GetString()}";
+
+    protected static Task<HttpResponseMessage> Reschedule(
+        HttpClient client, JsonElement booking, DateTimeOffset startsAt, int durationMinutes, long? version = null) =>
+        client.PatchAsJsonAsync(
+            BookingUrl(booking),
+            new { startsAt = Iso(startsAt), durationMinutes, version = version ?? booking.GetProperty("version").GetInt64() });
+
+    /// <summary>Ответ ошибки: application/problem+json с нужным статусом и code.</summary>
+    protected static async Task AssertProblem(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await ReadJson(response);
+        Assert.Equal((int)status, problem.GetProperty("status").GetInt32());
+        Assert.False(string.IsNullOrEmpty(problem.GetProperty("title").GetString()));
+        Assert.Equal(code, problem.GetProperty("code").GetString());
+    }
+
+    /// <summary>Ответ ошибки валидации: problem+json с errors по перечисленным полям.</summary>
+    protected static async Task AssertValidationProblem(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await ReadJson(response);
+        Assert.Equal(400, problem.GetProperty("status").GetInt32());
+        var errors = problem.GetProperty("errors");
+        foreach (var field in fields)
+        {
+            Assert.True(errors.TryGetProperty(field, out var messages), $"нет ошибки по полю {field}: {errors}");
+            Assert.True(messages.GetArrayLength() > 0);
+        }
+    }
+
+    /// <summary>Бронь по схеме Booking контракта.</summary>
+    protected static void AssertBooking(JsonElement booking, string? status = null)
+    {
+        string[] required = ["id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version"];
+        foreach (var name in required)
+            Assert.True(booking.TryGetProperty(name, out _), $"нет поля {name}");
+
+        Assert.True(Guid.TryParse(booking.GetProperty("id").GetString(), out _));
+        Assert.Contains(booking.GetProperty("comment").ValueKind, new[] { JsonValueKind.String, JsonValueKind.Null });
+
+        var startsAt = booking.GetProperty("startsAt").GetDateTimeOffset();
+        var endsAt = booking.GetProperty("endsAt").GetDateTimeOffset();
+        var duration = booking.GetProperty("durationMinutes").GetInt32();
+        Assert.Equal(startsAt.AddMinutes(duration), endsAt);
+        Assert.Equal(TimeSpan.Zero, startsAt.Offset);
+
+        Assert.InRange(booking.GetProperty("version").GetInt64(), 0, uint.MaxValue);
+
+        var actualStatus = booking.GetProperty("status").GetString();
+        Assert.Contains(actualStatus, new[] { "active", "cancelled" });
+        if (status is not null)
+            Assert.Equal(status, actualStatus);
+    }
+
+    protected static void AssertRoom(JsonElement room)
+    {
+        string[] required = ["id", "name", "capacity", "floor", "features"];
+        foreach (var name in required)
+            Assert.True(room.TryGetProperty(name, out _), $"нет поля {name}");
+
+        Assert.Matches("^[a-z0-9-]{1,64}$", room.GetProperty("id").GetString()!);
+        Assert.InRange(room.GetProperty("capacity").GetInt32(), 1, 50);
+        foreach (var feature in room.GetProperty("features").EnumerateArray())
+            Assert.Contains(feature.GetString(), new[] { "projector", "whiteboard", "videoconf" });
+    }
+}
