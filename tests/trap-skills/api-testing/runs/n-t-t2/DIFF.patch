@@ -0,0 +1,72 @@
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Testcontainers.PostgreSql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис на настоящем PostgreSQL: ограничение пересечения броней и версию брони (xmin) держит сама база,
+/// на EF InMemory/Sqlite эти проверки были бы ложными.
+/// </summary>
+public sealed class ApiFixture : IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+    private WebApplicationFactory<Program>? _factory;
+    private int _slot = -1;
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+        {
+            builder.UseEnvironment("Testing");
+            builder.UseSetting("ConnectionStrings:Bookings", _postgres.GetConnectionString());
+            builder.UseSetting("Database:Initialize", "true");
+            builder.UseSetting("Auth:Keys:0:key", AliceKey);
+            builder.UseSetting("Auth:Keys:0:userId", "alice");
+            builder.UseSetting("Auth:Keys:0:role", "member");
+            builder.UseSetting("Auth:Keys:1:key", BobKey);
+            builder.UseSetting("Auth:Keys:1:userId", "bob");
+            builder.UseSetting("Auth:Keys:1:role", "member");
+            builder.UseSetting("Auth:Keys:2:key", AdminKey);
+            builder.UseSetting("Auth:Keys:2:userId", "admin");
+            builder.UseSetting("Auth:Keys:2:role", "admin");
+        });
+    }
+
+    public async Task DisposeAsync()
+    {
+        _factory?.Dispose();
+        await _postgres.DisposeAsync();
+    }
+
+    public HttpClient CreateClient(string? apiKey)
+    {
+        var client = _factory!.CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+
+    /// <summary>
+    /// Свободное четырёхчасовое окно в будущем (от 2 до 81 суток вперёд): тесты делят одну базу
+    /// и не должны пересекаться друг с другом по времени.
+    /// </summary>
+    public DateTimeOffset NextSlot()
+    {
+        var n = Interlocked.Increment(ref _slot);
+        var day = DateTime.UtcNow.Date.AddDays(2 + n / 6 % 80);
+        return new DateTimeOffset(day.AddHours(n % 6 * 4), TimeSpan.Zero);
+    }
+}
+
+[CollectionDefinition(Name)]
+public class ApiCollection : ICollectionFixture<ApiFixture>
+{
+    public const string Name = "api";
+}
