diff --git a/tests/Bookings.Api.Tests/ApiTestBase.cs b/tests/Bookings.Api.Tests/ApiTestBase.cs
new file mode 100644
index 0000000..9ee2c2c
--- /dev/null
+++ b/tests/Bookings.Api.Tests/ApiTestBase.cs
@@ -0,0 +1,102 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public abstract class ApiTestBase : IDisposable
+{
+    protected static readonly Guid UnknownId = Guid.Parse("00000000-0000-0000-0000-00000000dead");
+
+    private readonly BookingsApiFactory _factory = new();
+
+    protected ApiTestBase()
+    {
+        Alice = _factory.CreateClient(BookingsApiFactory.AliceKey);
+        Bob = _factory.CreateClient(BookingsApiFactory.BobKey);
+        Admin = _factory.CreateClient(BookingsApiFactory.AdminKey);
+        Anonymous = _factory.CreateClient(apiKey: null);
+    }
+
+    protected HttpClient Alice { get; }
+    protected HttpClient Bob { get; }
+    protected HttpClient Admin { get; }
+    protected HttpClient Anonymous { get; }
+
+    protected HttpClient WithKey(string key) => _factory.CreateClient(key);
+
+    /// <summary>Начало слота в будущем: день со смещением от сегодня (UTC) и час.</summary>
+    protected static DateTimeOffset Slot(int daysAhead, int hour, int minute = 0) =>
+        new(DateTime.UtcNow.Date.AddDays(daysAhead).AddHours(hour).AddMinutes(minute), TimeSpan.Zero);
+
+    protected static object NewBooking(
+        string roomId = "orion", string title = "Планирование спринта", DateTimeOffset? startsAt = null,
+        int durationMinutes = 60, string? comment = null) =>
+        new { roomId, title, startsAt = startsAt ?? Slot(5, 10), durationMinutes, comment };
+
+    protected static async Task<JsonElement> ReadJsonAsync(HttpResponseMessage response) =>
+        (await response.Content.ReadFromJsonAsync<JsonElement>())!;
+
+    protected static async Task<JsonElement> CreateAsync(HttpClient client, object? request = null)
+    {
+        var response = await client.PostAsJsonAsync("/api/v1/bookings", request ?? NewBooking());
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJsonAsync(response);
+    }
+
+    protected static string BookingUrl(JsonElement booking) => $"/api/v1/bookings/{booking.GetProperty("id").GetGuid()}";
+
+    protected static async Task<JsonElement> GetAsync(HttpClient client, string url)
+    {
+        var response = await client.GetAsync(url);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        return await ReadJsonAsync(response);
+    }
+
+    /// <summary>Ошибка по контракту: application/problem+json, status и code.</summary>
+    protected static async Task AssertProblemAsync(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJsonAsync(response);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+        Assert.True(body.TryGetProperty("title", out _));
+        Assert.True(body.TryGetProperty("type", out _));
+    }
+
+    /// <summary>Ошибка проверки: 400, application/problem+json, errors содержит поле запроса.</summary>
+    protected static async Task AssertValidationProblemAsync(HttpResponseMessage response, string field)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var body = await ReadJsonAsync(response);
+        Assert.Equal(400, body.GetProperty("status").GetInt32());
+        var errors = body.GetProperty("errors");
+        Assert.True(errors.TryGetProperty(field, out var messages), $"В errors нет поля {field}: {errors}");
+        Assert.NotEmpty(messages.EnumerateArray());
+    }
+
+    protected static void AssertBookingShape(JsonElement booking)
+    {
+        foreach (var name in new[]
+                 { "id", "roomId", "title", "comment", "startsAt", "durationMinutes", "endsAt", "ownerId", "status", "version" })
+            Assert.True(booking.TryGetProperty(name, out _), $"В брони нет поля {name}");
+
+        Assert.True(booking.GetProperty("id").TryGetGuid(out _));
+        Assert.Equal(booking.GetProperty("startsAt").GetDateTimeOffset().AddMinutes(booking.GetProperty("durationMinutes").GetInt32()),
+            booking.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal(TimeSpan.Zero, booking.GetProperty("startsAt").GetDateTimeOffset().Offset);
+        Assert.Contains(booking.GetProperty("status").GetString(), new[] { "active", "cancelled" });
+        Assert.True(booking.GetProperty("version").TryGetUInt32(out _));
+    }
+
+    public void Dispose()
+    {
+        Alice.Dispose();
+        Bob.Dispose();
+        Admin.Dispose();
+        Anonymous.Dispose();
+        _factory.Dispose();
+    }
+}
