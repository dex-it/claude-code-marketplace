diff --git a/tests/Bookings.Api.Tests/BookingsApiFactory.cs b/tests/Bookings.Api.Tests/BookingsApiFactory.cs
new file mode 100644
index 0000000..506d2e0
--- /dev/null
+++ b/tests/Bookings.Api.Tests/BookingsApiFactory.cs
@@ -0,0 +1,86 @@
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.Extensions.Hosting;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Сервис в памяти процесса: PostgreSQL заменён EF InMemory (docker в тестовом окружении недоступен),
+/// ограничения БД воспроизводит <see cref="PostgresBehaviourInterceptor"/>.
+/// Каждый экземпляр - своя изолированная база с тремя комнатами из DbInitializer.
+/// </summary>
+public sealed class BookingsApiFactory : WebApplicationFactory<Program>
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly string _databaseName = Guid.NewGuid().ToString();
+
+    // один на базу: счётчик версий общий для всех запросов, как xmin в БД
+    private readonly PostgresBehaviourInterceptor _interceptor = new();
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment("Testing");
+
+        builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["Database:Initialize"] = "false",
+            ["Auth:Keys:0:key"] = AliceKey,
+            ["Auth:Keys:0:userId"] = "alice",
+            ["Auth:Keys:0:role"] = "member",
+            ["Auth:Keys:1:key"] = BobKey,
+            ["Auth:Keys:1:userId"] = "bob",
+            ["Auth:Keys:1:role"] = "member",
+            ["Auth:Keys:2:key"] = AdminKey,
+            ["Auth:Keys:2:userId"] = "admin",
+            ["Auth:Keys:2:role"] = "admin"
+        }));
+
+        builder.ConfigureServices(services =>
+        {
+            services.RemoveAll<DbContextOptions<BookingsDbContext>>();
+            services.AddDbContext<BookingsDbContext>(options => options
+                .UseInMemoryDatabase(_databaseName)
+                .ReplaceService<IModelCustomizer, ClientManagedVersionModelCustomizer>()
+                .AddInterceptors(_interceptor));
+        });
+    }
+
+    protected override IHost CreateHost(IHostBuilder builder)
+    {
+        var host = base.CreateHost(builder);
+        using var scope = host.Services.CreateScope();
+        Seed(scope.ServiceProvider.GetRequiredService<BookingsDbContext>());
+        return host;
+    }
+
+    public HttpClient CreateClient(string? apiKey)
+    {
+        var client = CreateClient();
+        if (apiKey is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", apiKey);
+        return client;
+    }
+
+    private static void Seed(BookingsDbContext db)
+    {
+        var orion = new Room("orion", "Orion", 8, 3);
+        orion.Features.AddRange([RoomFeature.Projector, RoomFeature.Whiteboard]);
+        var vega = new Room("vega", "Vega", 4, 3);
+        vega.Features.Add(RoomFeature.Whiteboard);
+        var lyra = new Room("lyra", "Lyra", 12, 5);
+        lyra.Features.AddRange([RoomFeature.Projector, RoomFeature.Videoconf]);
+
+        db.Rooms.AddRange(orion, vega, lyra);
+        db.SaveChanges();
+    }
+}
