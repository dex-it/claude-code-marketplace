+using System.Net;
+using System.Net.Http.Json;
+using System.Text;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsWriteTests : ApiTestBase
+{
+    // POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_Returns201WithBookingAndLocation()
+    {
+        var startsAt = Slot(5, 10);
+
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", NewBooking(title: "Ретро", startsAt: startsAt, durationMinutes: 90, comment: "Принести стикеры"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadJsonAsync(response);
+        AssertBookingShape(booking);
+        Assert.Equal("orion", booking.GetProperty("roomId").GetString());
+        Assert.Equal("Ретро", booking.GetProperty("title").GetString());
+        Assert.Equal("Принести стикеры", booking.GetProperty("comment").GetString());
+        Assert.Equal(startsAt, booking.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, booking.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(startsAt.AddMinutes(90), booking.GetProperty("endsAt").GetDateTimeOffset());
