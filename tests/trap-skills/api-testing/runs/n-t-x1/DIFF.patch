new file mode 100644
index 0000000..d0e3e28
--- /dev/null
+++ b/tests/Bookings.Api.Tests/PostgresBehaviourInterceptor.cs
@@ -0,0 +1,61 @@
+using Bookings.Api.Domain;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Diagnostics;
+using Npgsql;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Воспроизводит то, что в рабочей схеме делает PostgreSQL: версия строки (xmin) меняется при каждой записи,
+/// а ограничение bookings_no_overlap (EXCLUDE USING gist) не допускает пересечения активных броней комнаты.
+/// </summary>
+internal sealed class PostgresBehaviourInterceptor : SaveChangesInterceptor
+{
+    private long _version = 700;
+
+    public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)
+    {
+        Apply(eventData.Context!);
+        return result;
+    }
+
+    public override ValueTask<InterceptionResult<int>> SavingChangesAsync(
+        DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)
+    {
+        Apply(eventData.Context!);
+        return ValueTask.FromResult(result);
+    }
+
+    private void Apply(DbContext context)
+    {
+        var changed = context.ChangeTracker.Entries<Booking>()
+            .Where(e => e.State is EntityState.Added or EntityState.Modified)
+            .ToList();
+
+        foreach (var entry in changed)
+        {
+            var booking = entry.Entity;
+            if (booking.Status == BookingStatus.Active)
+            {
+                var overlaps = context.Set<Booking>().AsNoTracking().Any(other =>
+                    other.Id != booking.Id
+                    && other.RoomId == booking.RoomId
+                    && other.Status == BookingStatus.Active
+                    && other.StartsAt < booking.EndsAt
+                    && other.EndsAt > booking.StartsAt);
+
+                if (overlaps)
+                {
+                    throw new DbUpdateException(
+                        "bookings_no_overlap",
+                        new PostgresException(
+                            "conflicting key value violates exclusion constraint", "ERROR", "ERROR", PostgresErrorCodes.ExclusionViolation));
+                }
+            }
+
+            var version = entry.Property(b => b.Version);
+            version.CurrentValue = (uint)Interlocked.Increment(ref _version);
+            version.IsModified = true;
+        }
+    }
+}
