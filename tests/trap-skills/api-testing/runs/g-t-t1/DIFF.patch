+    {
+        var response = await Client().GetAsync("/api/v1/rooms");
+        var body = await ReadJson(response);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(3, body.GetProperty("total").GetInt32());
+        var ids = body.GetProperty("items").EnumerateArray().Select(r => r.GetProperty("id").GetString()!).ToArray();
+        Assert.Equal(["lyra", "orion", "vega"], ids);
+    }
+
+    [Fact]
+    public async Task ListRooms_ItemHasContractFields()
+    {
+        var body = await ReadJson(await Client().GetAsync("/api/v1/rooms?limit=100"));
+
+        var orion = body.GetProperty("items").EnumerateArray().Single(r => r.GetProperty("id").GetString() == "orion");
+        Assert.Equal("Orion", orion.GetProperty("name").GetString());
+        Assert.Equal(8, orion.GetProperty("capacity").GetInt32());
+        Assert.Equal(3, orion.GetProperty("floor").GetInt32());
+        Assert.Equal(["projector", "whiteboard"], orion.GetProperty("features").EnumerateArray().Select(f => f.GetString()!).ToArray());
+    }
+
+    [Fact]
+    public async Task ListRooms_LimitAndOffset_SliceThePage()
+    {
+        var body = await ReadJson(await Client().GetAsync("/api/v1/rooms?limit=1&offset=1"));
+
+        var items = body.GetProperty("items").EnumerateArray().ToArray();
+        Assert.Single(items);
+        Assert.Equal("orion", items[0].GetProperty("id").GetString());
+        Assert.Equal(3, body.GetProperty("total").GetInt32());
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
