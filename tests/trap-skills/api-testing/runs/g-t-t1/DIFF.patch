+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingsTests(BookingsApiFactory factory) : ApiTestBase(factory)
+{
+    private static string Iso(DateTimeOffset value) => Uri.EscapeDataString(value.UtcDateTime.ToString("O"));
+
+    private static object Reschedule(DateTimeOffset startsAt, int durationMinutes, long version) =>
+        new { startsAt, durationMinutes, version };
+
+    private static int ItemCount(JsonElement page) =>
+        page.GetProperty("items") is { ValueKind: JsonValueKind.Array } items ? items.GetArrayLength() : 0;
+
+    // ---- POST /api/v1/bookings
+
+    [Fact]
+    public async Task Create_ReturnsActiveBookingOwnedByKeyHolder()
+    {
+        var slot = NextSlot();
+
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", slot, 90, "Планирование спринта", "Берём проектор"));
+        var body = await ReadJson(response);
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Equal("orion", body.GetProperty("roomId").GetString());
+        Assert.Equal("Планирование спринта", body.GetProperty("title").GetString());
+        Assert.Equal("Берём проектор", body.GetProperty("comment").GetString());
+        Assert.Equal(slot, body.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(90, body.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal("alice", body.GetProperty("ownerId").GetString());
+        Assert.Equal("active", body.GetProperty("status").GetString());
+        Assert.True(Guid.TryParse(body.GetProperty("id").GetString(), out _));
+        Assert.True(body.GetProperty("version").GetInt64() >= 0);
+    }
+
+    [Fact(Skip = Defect.EndsAt)]
+    public async Task Create_EndsAtIsStartPlusDuration()
+    {
+        var slot = NextSlot();
+
+        var body = await CreateBooking("orion", slot, 90);
+
+        Assert.Equal(slot.AddMinutes(90), body.GetProperty("endsAt").GetDateTimeOffset());
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot()));
+        var body = await ReadJson(response);
+
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("comment").ValueKind);
+    }
+
+    [Fact(Skip = Defect.Location)]
+    public async Task Create_LocationPointsToCreatedBooking()
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot()));
+        var body = await ReadJson(response);
+
+        Assert.Equal($"/api/v1/bookings/{body.GetProperty("id").GetString()}", response.Headers.Location?.ToString());
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("nowhere", NextSlot()));
+
+        AssertProblem(response, await ReadJson(response), HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact(Skip = Defect.OverlapBody)]
+    public async Task Create_OverlapsActiveBooking_Returns409BookingOverlap()
+    {
+        var slot = NextSlot();
+        await CreateBooking("vega", slot, 60);
+
+        var response = await Client(BookingsApiFactory.OtherMemberKey)
+            .PostAsJsonAsync("/api/v1/bookings", NewBooking("vega", slot.AddMinutes(30), 60));
+
+        AssertProblem(response, await ReadJson(response), HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_AdjacentBooking_IsAllowed()
+    {
+        var slot = NextSlot();
+        await CreateBooking("vega", slot, 60);
+
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("vega", slot.AddMinutes(60), 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInOtherRoom_IsAllowed()
+    {
+        var slot = NextSlot();
+        await CreateBooking("vega", slot, 60);
+
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", slot, 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_IsAllowed()
+    {
+        var slot = NextSlot();
+        var booking = await CreateBooking("vega", slot, 60);
+        Assert.Equal(HttpStatusCode.NoContent, (await Client().DeleteAsync(Url(booking))).StatusCode);
+
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("vega", slot, 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_ConcurrentSameSlot_OnlyOneSucceeds()
+    {
+        var slot = NextSlot();
+
+        var responses = await Task.WhenAll(Enumerable.Range(0, 5).Select(_ =>
+            Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("lyra", slot, 60))));
+
+        Assert.Equal(1, responses.Count(r => r.StatusCode == HttpStatusCode.Created));
+        Assert.Equal(4, responses.Count(r => r.StatusCode == HttpStatusCode.Conflict));
+    }
+
+    [Theory]
+    [InlineData(-60, 60, "startsAt")]
+    [InlineData(0, 60, "startsAt")]
+    public async Task Create_StartInThePast_Returns400(int offsetMinutes, int duration, string field)
+    {
+        var startsAt = DateTimeOffset.UtcNow.AddMinutes(offsetMinutes);
+
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", startsAt, duration));
+
+        AssertValidationProblem(response, await ReadJson(response), field);
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", DateTimeOffset.UtcNow.AddDays(91)));
+
+        AssertValidationProblem(response, await ReadJson(response), "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartWithin90Days_IsAllowed()
+    {
+        var startsAt = DateTimeOffset.UtcNow.Date.AddDays(89).AddHours(3);
+
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", startsAt));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData(14)]
+    [InlineData(0)]
+    [InlineData(20)]
+    [InlineData(241)]
+    [InlineData(255)]
+    public async Task Create_InvalidDuration_Returns400(int duration)
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot(), duration));
+
+        AssertValidationProblem(response, await ReadJson(response), "durationMinutes");
+    }
+
+    [Theory]
+    [InlineData(15)]
+    [InlineData(240)]
+    public async Task Create_BoundaryDuration_IsAllowed(int duration)
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot(), duration));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_EmptyTitle_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot(), title: ""));
+
+        AssertValidationProblem(response, await ReadJson(response), "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleOver120_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot(), title: new string('я', 121)));
+
+        AssertValidationProblem(response, await ReadJson(response), "title");
+    }
+
+    [Fact]
+    public async Task Create_CommentOver500_Returns400()
+    {
+        var response = await Client().PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot(), comment: new string('я', 501)));
+
+        AssertValidationProblem(response, await ReadJson(response), "comment");
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401()
+    {
+        var response = await Client(key: null).PostAsJsonAsync("/api/v1/bookings", NewBooking("orion", NextSlot()));
+
+        AssertProblem(response, await ReadJson(response), HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // ---- GET /api/v1/bookings/{bookingId}
+
+    [Fact]
+    public async Task Get_ReturnsBooking_ToAnyMember()
+    {
+        var created = await CreateBooking("orion", NextSlot());
+
+        var response = await Client(BookingsApiFactory.OtherMemberKey).GetAsync(Url(created));
+        var body = await ReadJson(response);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(created.GetProperty("id").GetString(), body.GetProperty("id").GetString());
+        Assert.Equal("alice", body.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Client().GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        AssertProblem(response, await ReadJson(response), HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401()
+    {
+        var response = await Client(key: null).GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        AssertProblem(response, await ReadJson(response), HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    // ---- GET /api/v1/bookings (лента)
+
+    [Fact]
+    public async Task List_FiltersByRoomAndPeriod_AscendingByStart()
+    {
+        var slot = NextSlot();
+        var second = await CreateBooking("orion", slot.AddHours(2), 60);
+        var first = await CreateBooking("orion", slot, 60);
+        await CreateBooking("vega", slot, 60);
+
+        var response = await Client().GetAsync($"/api/v1/bookings?roomId=orion&from={Iso(slot.AddMinutes(-1))}&to={Iso(slot.AddHours(4))}");
+        var body = await ReadJson(response);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var ids = body.GetProperty("items").EnumerateArray().Select(b => b.GetProperty("id").GetString()!).ToArray();
+        Assert.Equal([first.GetProperty("id").GetString()!, second.GetProperty("id").GetString()!], ids);
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_AllRooms_ReturnsBookingsOfSeveralRooms()
+    {
+        var slot = NextSlot();
+        await CreateBooking("orion", slot, 60);
+        await CreateBooking("vega", slot, 60);
+
+        var body = await ReadJson(await Client().GetAsync($"/api/v1/bookings?from={Iso(slot.AddMinutes(-1))}&to={Iso(slot.AddHours(1))}"));
+
+        var rooms = body.GetProperty("items").EnumerateArray().Select(b => b.GetProperty("roomId").GetString()!).Order().ToArray();
+        Assert.Equal(["orion", "vega"], rooms);
+    }
+
+    [Fact]
+    public async Task List_IncludesCancelledBookings()
+    {
+        var slot = NextSlot();
+        var booking = await CreateBooking("orion", slot, 60);
+        await Client().DeleteAsync(Url(booking));
+
+        var body = await ReadJson(await Client().GetAsync($"/api/v1/bookings?roomId=orion&from={Iso(slot.AddMinutes(-1))}&to={Iso(slot.AddHours(1))}"));
+
+        var only = Assert.Single(body.GetProperty("items").EnumerateArray());
+        Assert.Equal("cancelled", only.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task List_Cursor_WalksAllPagesWithoutRepeats()
+    {
+        var slot = NextSlot();
+        var expected = new List<string>();
+        foreach (var minutes in new[] { 0, 60, 120 })
+            expected.Add((await CreateBooking("lyra", slot.AddMinutes(minutes), 60)).GetProperty("id").GetString()!);
+        var baseQuery = $"/api/v1/bookings?roomId=lyra&from={Iso(slot.AddMinutes(-1))}&to={Iso(slot.AddHours(3))}&limit=2";
+
+        var first = await ReadJson(await Client().GetAsync(baseQuery));
+        var cursor = first.GetProperty("nextCursor").GetString();
+        Assert.NotNull(cursor);
+        var second = await ReadJson(await Client().GetAsync($"{baseQuery}&cursor={Uri.EscapeDataString(cursor)}"));
+
+        var ids = first.GetProperty("items").EnumerateArray().Concat(second.GetProperty("items").EnumerateArray())
+            .Select(b => b.GetProperty("id").GetString()!).ToArray();
+        Assert.Equal(expected, ids);
+        Assert.Equal(JsonValueKind.Null, second.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_LastPageExactlyFull_HasNullCursor()
+    {
+        var slot = NextSlot();
+        await CreateBooking("lyra", slot, 60);
