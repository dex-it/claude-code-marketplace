@@ -0,0 +1,74 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public abstract class ApiTestBase(BookingsApiFactory factory)
+{
+    private static int _slot;
+
+    protected HttpClient Client(string? key = BookingsApiFactory.MemberKey)
+    {
+        var client = factory.CreateClient();
+        if (key is not null)
+            client.DefaultRequestHeaders.Add("X-Api-Key", key);
+        return client;
+    }
+
+    // Тесты делят одну базу и три комнаты, поэтому каждому - своё окно в 4 часа в будущем (UTC).
+    protected static DateTimeOffset NextSlot()
+    {
+        var n = Interlocked.Increment(ref _slot);
+        var day = DateTimeOffset.UtcNow.Date.AddDays(1 + n / 6);
+        return new DateTimeOffset(day.AddHours(n % 6 * 4), TimeSpan.Zero);
+    }
+
+    protected static object NewBooking(string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string title = "Планёрка", string? comment = null) =>
+        new { roomId, title, startsAt, durationMinutes, comment };
+
+    protected static async Task<JsonElement> ReadJson(HttpResponseMessage response)
+    {
+        using var stream = await response.Content.ReadAsStreamAsync();
+        return (await JsonDocument.ParseAsync(stream)).RootElement.Clone();
+    }
+
+    protected async Task<JsonElement> CreateBooking(string roomId, DateTimeOffset startsAt, int durationMinutes = 60, string key = BookingsApiFactory.MemberKey)
+    {
+        var response = await Client(key).PostAsJsonAsync("/api/v1/bookings", NewBooking(roomId, startsAt, durationMinutes));
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadJson(response);
+    }
+
+    protected static string Url(JsonElement booking) => $"/api/v1/bookings/{booking.GetProperty("id").GetString()}";
+
+    protected static void AssertProblem(HttpResponseMessage response, JsonElement body, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        Assert.Equal((int)status, body.GetProperty("status").GetInt32());
+        Assert.Equal(code, body.GetProperty("code").GetString());
+    }
+
+    protected static void AssertValidationProblem(HttpResponseMessage response, JsonElement body, string field)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        Assert.True(body.GetProperty("errors").TryGetProperty(field, out var messages));
+        Assert.NotEmpty(messages.EnumerateArray());
+    }
+}
+
+// Причины пропуска тестов - расхождения реализации с контрактом (перечень в описании MR BKG-31).
+public static class Defect
+{
+    public const string RepeatCancel = "BKG-31: повторная отмена отвечает 500 вместо 204 (FR-11)";
+    public const string VersionIgnored = "BKG-31: версия в PATCH не проверяется, version-conflict не отдаётся (FR-06)";
+    public const string OwnerCheck = "BKG-31: перенос чужой брони разрешён, 403 not-owner не отдаётся (FR-10)";
+    public const string OverlapBody = "BKG-31: 409 при пересечении - тело {error: overlap}, не problem+json с code booking-overlap";
+    public const string EndsAt = "BKG-31: endsAt считается по целым часам, минуты длительности отбрасываются";
+    public const string Location = "BKG-31: в 201 нет заголовка Location";
+    public const string EmptyItems = "BKG-31: пустая выдача - items: null вместо []";
+    public const string LimitUnchecked = "BKG-31: limit вне 1..100 в ленте броней не отклоняется, ответ 200 вместо 400";
+}
