+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace Bookings.Api.Tests;
+
+public record RoomModel(string Id, string Name, int Capacity, int Floor, string[] Features);
+
+public record RoomPageModel(RoomModel[] Items, int Total);
+
+public record BookingModel(
+    Guid Id,
+    string RoomId,
+    string Title,
+    string? Comment,
+    DateTimeOffset StartsAt,
+    int DurationMinutes,
+    DateTimeOffset EndsAt,
+    string OwnerId,
+    string Status,
+    long Version);
+
+public record BookingPageModel(BookingModel[] Items, string? NextCursor);
+
+public record ProblemModel(string? Type, string? Title, int Status, string? Code, string? Detail);
+
+public record ValidationProblemModel(string? Title, int Status, Dictionary<string, string[]>? Errors);
+
+public static class Json
+{
+    public static readonly JsonSerializerOptions Options = new(JsonSerializerDefaults.Web);
+}
