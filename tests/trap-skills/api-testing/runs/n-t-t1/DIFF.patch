@@ -0,0 +1,236 @@
+using System.Net;
+using System.Net.Http.Json;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsChangeTests(ApiFixture fixture) : ApiTestBase(fixture)
+{
+    [Fact]
+    public async Task Reschedule_ByOwner_MovesBookingAndChangesVersion()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block, offsetMinutes: 0, durationMinutes: 60);
+
+        var response = await Reschedule(Alice, booking.Id, block.At(120), 90, booking.Version);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var moved = await ReadBooking(response);
+        Assert.Equal(booking.Id, moved.Id);
+        Assert.Equal(block.At(120), moved.StartsAt);
+        Assert.Equal(90, moved.DurationMinutes);
+        Assert.Equal(block.At(210), moved.EndsAt);
+        Assert.Equal("active", moved.Status);
+        Assert.NotEqual(booking.Version, moved.Version);
+        Assert.Equal(moved, await GetBooking(Alice, booking.Id));
+    }
+
+    [Fact]
+    public async Task Reschedule_ByAdmin_Succeeds()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+
+        var response = await Reschedule(Admin, booking.Id, block.At(120), 60, booking.Version);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("alice", (await ReadBooking(response)).OwnerId);
+    }
+
+    [Fact]
+    public async Task Reschedule_ByNonOwner_Returns403NotOwner()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+
+        var response = await Reschedule(Bob, booking.Id, block.At(120), 60, booking.Version);
+
+        await AssertProblem(response, HttpStatusCode.Forbidden, "not-owner");
+        Assert.Equal(booking, await GetBooking(Alice, booking.Id));
+    }
+
+    [Fact]
+    public async Task Reschedule_StaleVersion_Returns409VersionConflict()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+        Assert.Equal(HttpStatusCode.OK, (await Reschedule(Alice, booking.Id, block.At(120), 60, booking.Version)).StatusCode);
+
+        var response = await Reschedule(Alice, booking.Id, block.At(180), 30, booking.Version);
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "version-conflict");
+    }
+
+    [Fact]
+    public async Task Reschedule_ConcurrentWithSameVersion_ExactlyOneWins()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+
+        var responses = await Task.WhenAll(Enumerable.Range(1, 6)
+            .Select(i => Reschedule(Alice, booking.Id, block.At(i * 30), 15, booking.Version)));
+
+        Assert.Equal(1, responses.Count(r => r.StatusCode == HttpStatusCode.OK));
+        foreach (var loser in responses.Where(r => r.StatusCode != HttpStatusCode.OK))
+            await AssertProblem(loser, HttpStatusCode.Conflict, "version-conflict");
+    }
+
+    [Fact]
+    public async Task Reschedule_CancelledBooking_Returns409BookingCancelled()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+        await Alice.DeleteAsync($"/api/v1/bookings/{booking.Id}");
+        var cancelled = await GetBooking(Alice, booking.Id);
+
+        var response = await Reschedule(Alice, booking.Id, block.At(120), 60, cancelled.Version);
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "booking-cancelled");
+    }
+
+    [Fact]
+    public async Task Reschedule_OntoActiveBooking_Returns409Overlap()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block, offsetMinutes: 0, durationMinutes: 60);
+        await CreateBooking(Bob, block, offsetMinutes: 120, durationMinutes: 60);
+
+        var response = await Reschedule(Alice, booking.Id, block.At(150), 60, booking.Version);
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Reschedule_OverlappingItsOwnOldTime_Succeeds()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block, offsetMinutes: 0, durationMinutes: 60);
+
+        var response = await Reschedule(Alice, booking.Id, block.At(30), 60, booking.Version);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Reschedule_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Reschedule(Alice, Guid.NewGuid(), NextBlock().At(0), 60, 1);
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Reschedule_StartInThePast_Returns400()
+    {
+        var booking = await CreateBooking(Alice, NextBlock());
+
+        var response = await Reschedule(Alice, booking.Id, DateTimeOffset.UtcNow.AddHours(-1), 60, booking.Version);
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Reschedule_StartBeyond90Days_Returns400()
+    {
+        var booking = await CreateBooking(Alice, NextBlock());
+
+        var response = await Reschedule(Alice, booking.Id, DateTimeOffset.UtcNow.AddDays(91), 60, booking.Version);
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Theory]
+    [InlineData(10)]
+    [InlineData(255)]
+    public async Task Reschedule_InvalidDuration_Returns400(int durationMinutes)
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+
+        var response = await Reschedule(Alice, booking.Id, block.At(120), durationMinutes, booking.Version);
+
+        await AssertValidationProblem(response, "durationMinutes");
+    }
+
+    [Fact(Skip = KnownDeviation)]
+    public async Task Reschedule_WithoutVersion_Returns400()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+
+        var response = await Alice.PatchAsJsonAsync($"/api/v1/bookings/{booking.Id}", new { startsAt = block.At(120), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "version");
+    }
+
+    [Fact]
+    public async Task Reschedule_WithoutKey_Returns401()
+    {
+        var response = await Reschedule(Anonymous, Guid.NewGuid(), NextBlock().At(0), 60, 1);
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Cancel_ByOwner_Returns204AndKeepsBookingAsCancelled()
+    {
+        var booking = await CreateBooking(Alice, NextBlock());
+
+        var response = await Alice.DeleteAsync($"/api/v1/bookings/{booking.Id}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        var after = await GetBooking(Bob, booking.Id);
+        Assert.Equal("cancelled", after.Status);
+        Assert.Equal(booking.StartsAt, after.StartsAt);
+    }
+
+    [Fact]
+    public async Task Cancel_ByAdmin_Returns204()
+    {
+        var booking = await CreateBooking(Alice, NextBlock());
+
+        var response = await Admin.DeleteAsync($"/api/v1/bookings/{booking.Id}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        Assert.Equal("cancelled", (await GetBooking(Alice, booking.Id)).Status);
+    }
+
+    [Fact]
+    public async Task Cancel_ByNonOwner_Returns403NotOwner()
+    {
+        var booking = await CreateBooking(Alice, NextBlock());
+
+        var response = await Bob.DeleteAsync($"/api/v1/bookings/{booking.Id}");
+
+        await AssertProblem(response, HttpStatusCode.Forbidden, "not-owner");
+        Assert.Equal("active", (await GetBooking(Alice, booking.Id)).Status);
+    }
+
+    [Fact]
+    public async Task Cancel_Repeated_Returns204AndDoesNotChangeBooking()
+    {
+        var booking = await CreateBooking(Alice, NextBlock());
+        Assert.Equal(HttpStatusCode.NoContent, (await Alice.DeleteAsync($"/api/v1/bookings/{booking.Id}")).StatusCode);
+        var afterFirst = await GetBooking(Alice, booking.Id);
+
+        var response = await Alice.DeleteAsync($"/api/v1/bookings/{booking.Id}");
+
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        Assert.Equal(afterFirst, await GetBooking(Alice, booking.Id));
+    }
+
+    [Fact]
+    public async Task Cancel_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Alice.DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Cancel_WithoutKey_Returns401()
+    {
+        var response = await Anonymous.DeleteAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
