+using System.Net;
+using System.Net.Http.Json;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsCreateTests(ApiFixture fixture) : ApiTestBase(fixture)
+{
+    [Fact]
+    public async Task Create_ReturnsCreatedBookingOwnedByKeyHolder()
+    {
+        var block = NextBlock();
+
+        var response = await PostBooking(Alice, NewBooking(block, durationMinutes: 90, title: "Планирование спринта", comment: "Принести ноутбуки"));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var booking = await ReadBooking(response);
+        Assert.NotEqual(Guid.Empty, booking.Id);
+        Assert.Equal(block.RoomId, booking.RoomId);
+        Assert.Equal("Планирование спринта", booking.Title);
+        Assert.Equal("Принести ноутбуки", booking.Comment);
+        Assert.Equal(block.At(0), booking.StartsAt);
+        Assert.Equal(90, booking.DurationMinutes);
+        Assert.Equal(block.At(90), booking.EndsAt);
+        Assert.Equal("alice", booking.OwnerId);
+        Assert.Equal("active", booking.Status);
+        Assert.NotNull(response.Headers.Location);
+        Assert.EndsWith($"/api/v1/bookings/{booking.Id}", response.Headers.Location!.ToString());
+    }
+
+    [Fact]
+    public async Task Create_WithoutComment_ReturnsNullComment()
+    {
+        var response = await PostBooking(Alice, new { roomId = "orion", title = "Без комментария", startsAt = NextBlock("orion").At(0), durationMinutes = 30 });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        Assert.Null((await ReadBooking(response)).Comment);
+    }
+
+    [Fact]
+    public async Task Create_LocationPointsToReadableBooking_VisibleToOtherMembers()
+    {
+        var created = await PostBooking(Alice, NewBooking(NextBlock()));
+
+        var response = await Bob.GetAsync(created.Headers.Location);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var booking = await ReadBooking(response);
+        Assert.Equal("alice", booking.OwnerId);
+        Assert.Equal((await ReadBooking(created)).Id, booking.Id);
+    }
+
+    [Fact]
+    public async Task Create_AtLimitsOfDuration_Succeeds()
+    {
+        var block = NextBlock();
+        Assert.Equal(HttpStatusCode.Created, (await PostBooking(Alice, NewBooking(block, 0, 15))).StatusCode);
+        Assert.Equal(HttpStatusCode.Created, (await PostBooking(Alice, NewBooking(block, 15, 240))).StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await PostBooking(Alice, new { roomId = "no-such-room", title = "x", startsAt = NextBlock().At(0), durationMinutes = 60 });
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task Create_OverlapWithActiveBooking_Returns409Overlap()
+    {
+        var block = NextBlock();
+        await CreateBooking(Alice, block, offsetMinutes: 0, durationMinutes: 60);
+
+        var response = await PostBooking(Bob, NewBooking(block, offsetMinutes: 30, durationMinutes: 60));
+
+        await AssertProblem(response, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_BackToBack_DoesNotOverlap()
+    {
+        var block = NextBlock();
+        await CreateBooking(Alice, block, offsetMinutes: 0, durationMinutes: 60);
+
+        var response = await PostBooking(Bob, NewBooking(block, offsetMinutes: 60, durationMinutes: 60));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_Succeeds()
+    {
+        var blocks = NextBlockInEveryRoom();
+        await CreateBooking(Alice, blocks[0]);
+
+        var response = await PostBooking(Bob, NewBooking(blocks[1]));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_OnTimeFreedByCancellation_Succeeds()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block);
+        Assert.Equal(HttpStatusCode.NoContent, (await Alice.DeleteAsync($"/api/v1/bookings/{booking.Id}")).StatusCode);
+
+        var response = await PostBooking(Bob, NewBooking(block));
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Create_ConcurrentRequestsForSameSlot_ExactlyOneWins()
+    {
+        var block = NextBlock();
+
+        var responses = await Task.WhenAll(Enumerable.Range(0, 8)
+            .Select(i => PostBooking(i % 2 == 0 ? Alice : Bob, NewBooking(block, title: $"Гонка {i}"))));
+
+        Assert.Equal(1, responses.Count(r => r.StatusCode == HttpStatusCode.Created));
+        foreach (var loser in responses.Where(r => r.StatusCode != HttpStatusCode.Created))
+            await AssertProblem(loser, HttpStatusCode.Conflict, "booking-overlap");
+    }
+
+    [Fact]
+    public async Task Create_StartInThePast_Returns400()
+    {
+        var response = await PostBooking(Alice, new { roomId = "orion", title = "x", startsAt = DateTimeOffset.UtcNow.AddHours(-1), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_StartBeyond90Days_Returns400()
+    {
+        var response = await PostBooking(Alice, new { roomId = "orion", title = "x", startsAt = DateTimeOffset.UtcNow.AddDays(91), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(20)]
+    [InlineData(255)]
+    [InlineData(-15)]
+    public async Task Create_InvalidDuration_Returns400(int durationMinutes)
+    {
+        var response = await PostBooking(Alice, new { roomId = "orion", title = "x", startsAt = NextBlock("orion").At(0), durationMinutes });
+
+        await AssertValidationProblem(response, "durationMinutes");
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("   ")]
+    public async Task Create_EmptyTitle_Returns400(string title)
+    {
+        var response = await PostBooking(Alice, new { roomId = "orion", title, startsAt = NextBlock("orion").At(0), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_TitleLongerThan120_Returns400()
+    {
+        var response = await PostBooking(Alice, new { roomId = "orion", title = new string('я', 121), startsAt = NextBlock("orion").At(0), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_CommentLongerThan500_Returns400()
+    {
+        var response = await PostBooking(Alice, new { roomId = "orion", title = "x", comment = new string('я', 501), startsAt = NextBlock("orion").At(0), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "comment");
+    }
+
+    [Fact]
+    public async Task Create_EmptyRoomId_Returns400()
+    {
+        var response = await PostBooking(Alice, new { roomId = "", title = "x", startsAt = NextBlock("orion").At(0), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "roomId");
+    }
+
+    [Fact(Skip = KnownDeviation)]
+    public async Task Create_RoomIdLongerThan64_Returns400()
+    {
+        var response = await PostBooking(Alice, new { roomId = new string('a', 65), title = "x", startsAt = NextBlock("orion").At(0), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "roomId");
+    }
+
+    [Fact(Skip = KnownDeviation)]
+    public async Task Create_MissingTitle_Returns400WithCamelCaseField()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings",
+            new { roomId = "orion", startsAt = NextBlock("orion").At(0), durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "title");
+    }
+
+    [Fact]
+    public async Task Create_MissingStartsAt_Returns400()
+    {
+        var response = await Alice.PostAsJsonAsync("/api/v1/bookings", new { roomId = "orion", title = "x", durationMinutes = 60 });
+
+        await AssertValidationProblem(response, "startsAt");
+    }
+
+    [Fact]
+    public async Task Create_WithoutKey_Returns401()
+    {
+        var response = await PostBooking(Anonymous, NewBooking(NextBlock()));
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Create_UnknownKey_Returns401()
+    {
+        var response = await PostBooking(UnknownKey, NewBooking(NextBlock()));
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
