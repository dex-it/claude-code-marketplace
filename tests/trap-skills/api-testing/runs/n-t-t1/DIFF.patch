+using System.Net;
+
+namespace Bookings.Api.Tests;
+
+public class BookingsReadTests(ApiFixture fixture) : ApiTestBase(fixture)
+{
+    [Fact]
+    public async Task Get_ReturnsBookingToAnyMember()
+    {
+        var created = await CreateBooking(Alice, NextBlock());
+
+        var response = await Bob.GetAsync($"/api/v1/bookings/{created.Id}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(created, await ReadBooking(response));
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await Alice.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact(Skip = KnownDeviation)]
+    public async Task Get_IdIsNotUuid_Returns404BookingNotFound()
+    {
+        var response = await Alice.GetAsync("/api/v1/bookings/not-a-uuid");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "booking-not-found");
+    }
+
+    [Fact]
+    public async Task Get_WithoutKey_Returns401()
+    {
+        var response = await Anonymous.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        await AssertProblem(response, HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task List_FiltersByRoomAndPeriod_OrderedByStartsAtThenId()
+    {
+        var block = NextBlock();
+        var second = await CreateBooking(Alice, block, offsetMinutes: 60, durationMinutes: 60);
+        var first = await CreateBooking(Bob, block, offsetMinutes: 0, durationMinutes: 60);
+        var cancelled = await CreateBooking(Alice, block, offsetMinutes: 120, durationMinutes: 60);
+        await Alice.DeleteAsync($"/api/v1/bookings/{cancelled.Id}");
+
+        var response = await Alice.GetAsync(
+            $"/api/v1/bookings?roomId={block.RoomId}&from={Iso(block.At(0))}&to={Iso(block.At(240))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Read<BookingPageModel>(response);
+        Assert.Equal([first.Id, second.Id, cancelled.Id], page.Items.Select(b => b.Id));
+        Assert.Equal("cancelled", page.Items[2].Status);
+        Assert.Null(page.NextCursor);
+    }
+
+    [Fact]
+    public async Task List_PeriodBoundaries_AreExclusive()
+    {
+        var block = NextBlock();
+        var booking = await CreateBooking(Alice, block, offsetMinutes: 60, durationMinutes: 60);
+
+        // бронь [60, 120): from = её конец и to = её начало её не захватывают
+        var afterEnd = await Read<BookingPageModel>(await Alice.GetAsync(
+            $"/api/v1/bookings?roomId={block.RoomId}&from={Iso(block.At(120))}&to={Iso(block.At(240))}"));
+        var beforeStart = await Read<BookingPageModel>(await Alice.GetAsync(
+            $"/api/v1/bookings?roomId={block.RoomId}&from={Iso(block.At(0))}&to={Iso(block.At(60))}"));
+        var overlapping = await Read<BookingPageModel>(await Alice.GetAsync(
+            $"/api/v1/bookings?roomId={block.RoomId}&from={Iso(block.At(119))}&to={Iso(block.At(240))}"));
+
+        Assert.Empty(afterEnd.Items);
+        Assert.Empty(beforeStart.Items);
+        Assert.Equal(booking.Id, Assert.Single(overlapping.Items).Id);
+    }
+
+    [Fact]
+    public async Task List_NothingFound_ReturnsEmptyItemsAndNullCursor()
+    {
+        var response = await Alice.GetAsync("/api/v1/bookings?roomId=no-such-room");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Read<BookingPageModel>(response);
+        Assert.Empty(page.Items);
+        Assert.Null(page.NextCursor);
+    }
+
+    [Fact]
+    public async Task List_CursorWalksAllPagesWithoutGapsOrRepeats()
+    {
+        var block = NextBlock();
+        var expected = new List<Guid>();
+        for (var i = 0; i < 5; i++)
+            expected.Add((await CreateBooking(Alice, block, offsetMinutes: i * 30, durationMinutes: 30)).Id);
+
+        var window = $"roomId={block.RoomId}&from={Iso(block.At(0))}&to={Iso(block.At(240))}&limit=2";
+        var seen = new List<Guid>();
+        string? cursor = null;
+        var pages = 0;
+        do
+        {
+            var url = $"/api/v1/bookings?{window}" + (cursor is null ? "" : $"&cursor={Uri.EscapeDataString(cursor)}");
+            var response = await Alice.GetAsync(url);
+            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+            var page = await Read<BookingPageModel>(response);
+            Assert.True(page.Items.Length <= 2);
+            seen.AddRange(page.Items.Select(b => b.Id));
+            cursor = page.NextCursor;
+            pages++;
+        }
+        while (cursor is not null && pages < 10);
+
+        Assert.Equal(3, pages);
+        Assert.Equal(expected, seen);
+    }
+
+    [Fact]
+    public async Task List_ExactlyOnePageOfItems_HasNullCursor()
+    {
+        var block = NextBlock();
+        await CreateBooking(Alice, block, offsetMinutes: 0, durationMinutes: 30);
+        await CreateBooking(Alice, block, offsetMinutes: 30, durationMinutes: 30);
+
+        var response = await Alice.GetAsync(
+            $"/api/v1/bookings?roomId={block.RoomId}&from={Iso(block.At(0))}&to={Iso(block.At(240))}&limit=2");
+
+        var page = await Read<BookingPageModel>(response);
+        Assert.Equal(2, page.Items.Length);
+        Assert.Null(page.NextCursor);
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("cursor=%21%21not-a-cursor", "cursor")]
+    public async Task List_InvalidParameters_Returns400(string query, string field)
+    {
+        var response = await Alice.GetAsync($"/api/v1/bookings?{query}");
+
+        await AssertValidationProblem(response, field);
+    }
+
+    [Fact]
+    public async Task List_MalformedFrom_Returns400()
+    {
+        var response = await Alice.GetAsync("/api/v1/bookings?from=yesterday");
+
+        await AssertValidationProblem(response, "from");
+    }
+
+    [Fact]
+    public async Task List_WithoutKey_Returns401()
+    {
+        await AssertProblem(await Anonymous.GetAsync("/api/v1/bookings"), HttpStatusCode.Unauthorized, "unauthorized");
+    }
+}
