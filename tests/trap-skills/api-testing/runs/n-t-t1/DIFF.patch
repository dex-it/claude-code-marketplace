@@ -0,0 +1,148 @@
+using System.Net;
+
+namespace Bookings.Api.Tests;
+
+public class RoomsTests(ApiFixture fixture) : ApiTestBase(fixture)
+{
+    [Fact]
+    public async Task ListRooms_ReturnsPageOrderedById()
+    {
+        var response = await Alice.GetAsync("/api/v1/rooms");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Read<RoomPageModel>(response);
+        Assert.Equal(3, page.Total);
+        Assert.Equal(["lyra", "orion", "vega"], page.Items.Select(r => r.Id));
+        var orion = page.Items.Single(r => r.Id == "orion");
+        Assert.Equal(new RoomModel("orion", "Orion", 8, 3, ["projector", "whiteboard"]), orion, RoomComparer.Instance);
+    }
+
+    [Fact]
+    public async Task ListRooms_LimitAndOffset_SliceThePage()
+    {
+        var response = await Alice.GetAsync("/api/v1/rooms?limit=1&offset=1");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Read<RoomPageModel>(response);
+        Assert.Equal(3, page.Total);
+        Assert.Equal("orion", Assert.Single(page.Items).Id);
+    }
+
+    [Fact]
+    public async Task ListRooms_OffsetBeyondTotal_ReturnsEmptyItems()
+    {
+        var response = await Alice.GetAsync("/api/v1/rooms?offset=50");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var page = await Read<RoomPageModel>(response);
+        Assert.Empty(page.Items);
+        Assert.Equal(3, page.Total);
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("offset=-1", "offset")]
+    public async Task ListRooms_InvalidPaging_Returns400(string query, string field)
+    {
+        var response = await Alice.GetAsync($"/api/v1/rooms?{query}");
+
+        await AssertValidationProblem(response, field);
+    }
+
+    [Fact]
+    public async Task GetRoom_ReturnsRoom()
+    {
+        var response = await Alice.GetAsync("/api/v1/rooms/lyra");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var room = await Read<RoomModel>(response);
+        Assert.Equal("lyra", room.Id);
+        Assert.Equal("Lyra", room.Name);
+        Assert.Equal(12, room.Capacity);
+        Assert.Equal(5, room.Floor);
+        Assert.Equal(["projector", "videoconf"], room.Features);
+    }
+
+    [Fact]
+    public async Task GetRoom_Unknown_Returns404RoomNotFound()
+    {
+        var response = await Alice.GetAsync("/api/v1/rooms/no-such-room");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_ReturnsActiveAndCancelledByStartsAt()
+    {
+        var block = NextBlock("vega");
+        var later = await CreateBooking(Alice, block, offsetMinutes: 60);
+        var earlier = await CreateBooking(Alice, block, offsetMinutes: 0);
+        var cancelled = await CreateBooking(Alice, block, offsetMinutes: 120);
+        Assert.Equal(HttpStatusCode.NoContent, (await Alice.DeleteAsync($"/api/v1/bookings/{cancelled.Id}")).StatusCode);
+
+        var response = await Bob.GetAsync($"/api/v1/rooms/vega/bookings?from={Iso(block.At(0))}&to={Iso(block.At(180))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var items = await Read<BookingModel[]>(response);
+        Assert.Equal([earlier.Id, later.Id, cancelled.Id], items.Select(b => b.Id));
+        Assert.Equal(["active", "active", "cancelled"], items.Select(b => b.Status));
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_PeriodFilter_ExcludesBookingsOutsidePeriod()
+    {
+        var block = NextBlock("vega");
+        await CreateBooking(Alice, block, offsetMinutes: 0, durationMinutes: 60);
+        var second = await CreateBooking(Alice, block, offsetMinutes: 120, durationMinutes: 60);
+
+        var response = await Alice.GetAsync($"/api/v1/rooms/vega/bookings?from={Iso(block.At(90))}&to={Iso(block.At(240))}");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var items = await Read<BookingModel[]>(response);
+        Assert.Equal(second.Id, Assert.Single(items).Id);
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_UnknownRoom_Returns404RoomNotFound()
+    {
+        var response = await Alice.GetAsync("/api/v1/rooms/no-such-room/bookings");
+
+        await AssertProblem(response, HttpStatusCode.NotFound, "room-not-found");
+    }
+
+    [Fact]
+    public async Task ListRoomBookings_MalformedFrom_Returns400()
+    {
+        var response = await Alice.GetAsync("/api/v1/rooms/orion/bookings?from=yesterday");
+
+        await AssertValidationProblem(response, "from");
+    }
+
+    [Theory]
+    [InlineData("/api/v1/rooms")]
+    [InlineData("/api/v1/rooms/orion")]
+    [InlineData("/api/v1/rooms/orion/bookings")]
+    public async Task Rooms_WithoutKey_Return401(string url)
+    {
+        await AssertProblem(await Anonymous.GetAsync(url), HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    [Fact]
+    public async Task Rooms_UnknownKey_Returns401()
+    {
+        await AssertProblem(await UnknownKey.GetAsync("/api/v1/rooms"), HttpStatusCode.Unauthorized, "unauthorized");
+    }
+
+    private sealed class RoomComparer : IEqualityComparer<RoomModel>
+    {
+        public static readonly RoomComparer Instance = new();
+
+        public bool Equals(RoomModel? x, RoomModel? y) =>
+            x is not null && y is not null
+            && (x.Id, x.Name, x.Capacity, x.Floor) == (y.Id, y.Name, y.Capacity, y.Floor)
+            && x.Features.SequenceEqual(y.Features);
+
+        public int GetHashCode(RoomModel obj) => obj.Id.GetHashCode();
+    }
+}
