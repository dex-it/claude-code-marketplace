index 0000000..9d2b004
--- /dev/null
+++ b/tests/Bookings.Api.Tests/ApiTestBase.cs
@@ -0,0 +1,111 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>
+/// Свободное окно в комнате: 4 часа, которые не пересекаются с окнами других тестов,
+/// поэтому тесты не мешают друг другу, а выборки по from/to видят только свои брони.
+/// </summary>
+public sealed record Block(string RoomId, DateTimeOffset Start)
+{
+    public DateTimeOffset At(int minutes) => Start.AddMinutes(minutes);
+}
+
+[Collection(ApiCollection.Name)]
+public abstract class ApiTestBase(ApiFixture fixture)
+{
+    /// <summary>Тест описывает поведение по контракту, которого сервис пока не выдаёт; расхождение перечислено в описании MR BKG-31.</summary>
+    protected const string KnownDeviation = "Расхождение реализации с контрактом (BKG-31): тест включить после исправления сервиса.";
+
+    private static readonly string[] Rooms = ["orion", "vega", "lyra"];
+    private static readonly int[] Counters = new int[3];
+    private static int _everyRoomCounter;
+
+    protected HttpClient Alice { get; } = fixture.CreateClient(ApiFixture.AliceKey);
+    protected HttpClient Bob { get; } = fixture.CreateClient(ApiFixture.BobKey);
+    protected HttpClient Admin { get; } = fixture.CreateClient(ApiFixture.AdminKey);
+    protected HttpClient Anonymous { get; } = fixture.CreateClient(null);
+    protected HttpClient UnknownKey { get; } = fixture.CreateClient("no-such-key");
+
+    /// <summary>
+    /// Три окна с одним началом, по одному в каждой комнате (дни 81..88, отдельно от <see cref="NextBlock"/>):
+    /// для проверок «то же время в другой комнате».
+    /// </summary>
+    protected static Block[] NextBlockInEveryRoom()
+    {
+        var n = Interlocked.Increment(ref _everyRoomCounter) - 1;
+        var day = DateTimeOffset.UtcNow.Date.AddDays(81 + n % 8);
+        var start = new DateTimeOffset(day.AddHours(8 + n / 8 * 4), TimeSpan.Zero);
+        return Rooms.Select(room => new Block(room, start)).ToArray();
+    }
+
+    /// <summary>Новое окно в комнате <paramref name="roomId"/> (по умолчанию - в любой): день 1..80 вперёд, блок 08/12/16/20 ч UTC.</summary>
+    protected static Block NextBlock(string? roomId = null)
+    {
+        var index = roomId is null ? Random.Shared.Next(Rooms.Length) : Array.IndexOf(Rooms, roomId);
+        int n;
+        lock (Counters)
+            n = Counters[index]++;
+
+        var day = DateTimeOffset.UtcNow.Date.AddDays(1 + n % 80);
+        var hour = 8 + n / 80 * 4;
+        return new Block(Rooms[index], new DateTimeOffset(day.AddHours(hour), TimeSpan.Zero));
+    }
+
+    protected static object NewBooking(Block block, int offsetMinutes = 0, int durationMinutes = 60, string title = "Планирование", string? comment = null) =>
+        new { roomId = block.RoomId, title, startsAt = block.At(offsetMinutes), durationMinutes, comment };
+
+    protected static Task<HttpResponseMessage> PostBooking(HttpClient client, object body) =>
+        client.PostAsJsonAsync("/api/v1/bookings", body);
+
+    protected static async Task<BookingModel> CreateBooking(HttpClient client, Block block, int offsetMinutes = 0, int durationMinutes = 60)
+    {
+        var response = await PostBooking(client, NewBooking(block, offsetMinutes, durationMinutes));
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return await ReadBooking(response);
+    }
+
+    protected static async Task<BookingModel> GetBooking(HttpClient client, Guid id)
+    {
+        var response = await client.GetAsync($"/api/v1/bookings/{id}");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        return await ReadBooking(response);
+    }
+
+    protected static Task<HttpResponseMessage> Reschedule(HttpClient client, Guid id, DateTimeOffset startsAt, int durationMinutes, long version) =>
+        client.PatchAsJsonAsync($"/api/v1/bookings/{id}", new { startsAt, durationMinutes, version });
+
+    protected static async Task<BookingModel> ReadBooking(HttpResponseMessage response) =>
+        (await response.Content.ReadFromJsonAsync<BookingModel>(Json.Options))!;
+
+    protected static async Task<T> Read<T>(HttpResponseMessage response) =>
+        (await response.Content.ReadFromJsonAsync<T>(Json.Options))!;
+
+    /// <summary>Ответ - problem+json с ожидаемым статусом и кодом ошибки из контракта.</summary>
+    protected static async Task AssertProblem(HttpResponseMessage response, HttpStatusCode status, string code)
+    {
+        Assert.Equal(status, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await Read<ProblemModel>(response);
+        Assert.Equal((int)status, problem.Status);
+        Assert.Equal(code, problem.Code);
+    }
+
+    /// <summary>Ответ 400 - problem+json со списком ошибок, среди полей есть <paramref name="fields"/>.</summary>
+    protected static async Task AssertValidationProblem(HttpResponseMessage response, params string[] fields)
+    {
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal("application/problem+json", response.Content.Headers.ContentType?.MediaType);
+        var problem = await Read<ValidationProblemModel>(response);
+        Assert.NotNull(problem.Errors);
+        foreach (var field in fields)
+        {
+            Assert.True(problem.Errors.ContainsKey(field), $"В errors нет поля {field}: {string.Join(", ", problem.Errors.Keys)}");
+            Assert.NotEmpty(problem.Errors[field]);
+        }
+    }
+
+    protected static string Iso(DateTimeOffset value) => Uri.EscapeDataString(value.UtcDateTime.ToString("O"));
+}
