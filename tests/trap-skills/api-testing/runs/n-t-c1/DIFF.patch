+        var start = ApiFixture.Future();
+        await api.CreateBookingAsync(room, start, 60);
+
+        var response = await Create(new { roomId = room, title = "Пересечение", startsAt = start.AddMinutes(30), durationMinutes = 60 }, ApiFixture.BobKey);
