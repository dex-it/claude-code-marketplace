+using System.Net;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingChangeTests(ApiFixture api)
+{
+    private static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    private static long Version(JsonElement booking) => booking.GetProperty("version").GetInt64();
+
+    private Task<ApiResponse> Reschedule(JsonElement booking, DateTimeOffset startsAt, int durationMinutes, long? version = null,
+        string key = ApiFixture.AliceKey) =>
+        api.SendAsync(HttpMethod.Patch, $"/api/v1/bookings/{Id(booking)}", key,
+            new { startsAt, durationMinutes, version = version ?? Version(booking) });
+
+    private Task<ApiResponse> Cancel(JsonElement booking, string key = ApiFixture.AliceKey) =>
+        api.SendAsync(HttpMethod.Delete, $"/api/v1/bookings/{Id(booking)}", key);
+
+    private async Task<JsonElement> Reload(JsonElement booking) =>
+        (await api.GetAsync($"/api/v1/bookings/{Id(booking)}")).Body;
+
+    // --- PATCH ---
+
+    [Fact]
+    public async Task Reschedule_Owner_Returns200WithNewTimeAndNewVersion()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+        var newStart = ApiFixture.Future(hour: 10);
+
+        var response = await Reschedule(booking, newStart, 30);
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Equal(Id(booking), Id(response.Body));
+        Assert.Equal(newStart, response.Body.GetProperty("startsAt").GetDateTimeOffset());
+        Assert.Equal(30, response.Body.GetProperty("durationMinutes").GetInt32());
+        Assert.Equal(newStart.AddMinutes(30), response.Body.GetProperty("endsAt").GetDateTimeOffset());
+        Assert.Equal("active", response.Body.GetProperty("status").GetString());
+        Assert.NotEqual(Version(booking), Version(response.Body));
+        Assert.Equal(response.Body.ToString(), (await Reload(booking)).ToString());
+    }
+
+    [Fact]
+    public async Task Reschedule_Admin_CanRescheduleForeignBooking()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await Reschedule(booking, ApiFixture.Future(hour: 10), 60, key: ApiFixture.AdminKey);
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Equal("alice", response.Body.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Reschedule_NotOwner_Returns403NotOwner()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await Reschedule(booking, ApiFixture.Future(hour: 10), 60, key: ApiFixture.BobKey);
+
+        Assert.Equal(HttpStatusCode.Forbidden, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.Equal("not-owner", response.Code);
+    }
+
+    [Fact]
+    public async Task Reschedule_Unknown_Returns404BookingNotFound()
+    {
+        var response = await api.SendAsync(HttpMethod.Patch, $"/api/v1/bookings/{Guid.NewGuid()}", body:
+            new { startsAt = ApiFixture.Future(), durationMinutes = 30, version = 1 });
+
+        Assert.Equal(HttpStatusCode.NotFound, response.Status);
+        Assert.Equal("booking-not-found", response.Code);
+    }
+
+    [Fact]
+    public async Task Reschedule_StaleVersion_Returns409VersionConflict()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+        var first = await Reschedule(booking, ApiFixture.Future(hour: 10), 60);
+        Assert.Equal(HttpStatusCode.OK, first.Status);
+
+        var stale = await Reschedule(booking, ApiFixture.Future(hour: 12), 60);
+
+        Assert.Equal(HttpStatusCode.Conflict, stale.Status);
+        Assert.Equal("application/problem+json", stale.MediaType);
+        Assert.Equal("version-conflict", stale.Code);
+    }
+
+    [Fact]
+    public async Task Reschedule_AfterRereadingVersion_Succeeds()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+        var first = await Reschedule(booking, ApiFixture.Future(hour: 10), 60);
+
+        var second = await Reschedule(first.Body, ApiFixture.Future(hour: 12), 60);
+
+        Assert.Equal(HttpStatusCode.OK, second.Status);
+    }
+
+    [Fact]
+    public async Task Reschedule_IntoOccupiedTime_Returns409Overlap()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+        await api.CreateBookingAsync(room, ApiFixture.Future(hour: 12), 60, key: ApiFixture.BobKey);
+
+        var response = await Reschedule(booking, ApiFixture.Future(hour: 12).AddMinutes(30), 60);
+
+        Assert.Equal(HttpStatusCode.Conflict, response.Status);
+        Assert.Equal("booking-overlap", response.Code);
+    }
+
+    [Fact]
+    public async Task Reschedule_OverlappingItsOwnPreviousTime_Succeeds()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await Reschedule(booking, ApiFixture.Future(hour: 8).AddMinutes(30), 120);
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+    }
+
+    [Fact]
+    public async Task Reschedule_Cancelled_Returns409BookingCancelled()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+        await Cancel(booking);
+        var fresh = await Reload(booking);
+
+        var response = await Reschedule(fresh, ApiFixture.Future(hour: 10), 60);
+
+        Assert.Equal(HttpStatusCode.Conflict, response.Status);
+        Assert.Equal("booking-cancelled", response.Code);
+    }
+
+    [Theory]
+    [InlineData(14)]
+    [InlineData(0)]
+    [InlineData(255)]
+    public async Task Reschedule_InvalidDuration_Returns400(int minutes)
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await Reschedule(booking, ApiFixture.Future(hour: 10), minutes);
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.True(response.Body.GetProperty("errors").TryGetProperty("durationMinutes", out _));
+    }
+
+    [Fact]
+    public async Task Reschedule_StartInPast_Returns400()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await Reschedule(booking, DateTimeOffset.UtcNow.AddHours(-1), 60);
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.True(response.Body.GetProperty("errors").TryGetProperty("startsAt", out _));
+    }
+
+    [Fact]
+    public async Task Reschedule_StartBeyond90Days_Returns400()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await Reschedule(booking, DateTimeOffset.UtcNow.AddDays(91), 60);
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.True(response.Body.GetProperty("errors").TryGetProperty("startsAt", out _));
+    }
+
+    [Fact(Skip = "BKG-31: расхождение с контрактом - без version сервис отвечает 409 version-conflict (см. описание MR)")]
+    public async Task Reschedule_MissingVersion_Returns400()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await api.SendAsync(HttpMethod.Patch, $"/api/v1/bookings/{Id(booking)}", body:
+            new { startsAt = ApiFixture.Future(hour: 10), durationMinutes = 60 });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+    }
+
+    [Theory]
+    [InlineData(-1L)]
+    [InlineData(4294967296L)]
+    public async Task Reschedule_VersionOutOfRange_Returns400(long version)
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);
+
+        var response = await Reschedule(booking, ApiFixture.Future(hour: 10), 60, version);
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+    }
+
+    // --- DELETE ---
+
+    [Fact]
+    public async Task Cancel_Owner_Returns204AndBookingBecomesCancelled()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(), 60);
+
+        var response = await Cancel(booking);
+
+        Assert.Equal(HttpStatusCode.NoContent, response.Status);
+        Assert.Equal("", response.Text);
+        var after = await Reload(booking);
+        Assert.Equal("cancelled", after.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_Admin_CanCancelForeignBooking()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(), 60);
+
+        var response = await Cancel(booking, ApiFixture.AdminKey);
+
+        Assert.Equal(HttpStatusCode.NoContent, response.Status);
+    }
+
+    [Fact]
+    public async Task Cancel_NotOwner_Returns403NotOwnerAndKeepsBookingActive()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(), 60);
+
+        var response = await Cancel(booking, ApiFixture.BobKey);
+
+        Assert.Equal(HttpStatusCode.Forbidden, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.Equal("not-owner", response.Code);
+        Assert.Equal("active", (await Reload(booking)).GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task Cancel_Unknown_Returns404BookingNotFound()
+    {
+        var response = await api.SendAsync(HttpMethod.Delete, $"/api/v1/bookings/{Guid.NewGuid()}");
+
+        Assert.Equal(HttpStatusCode.NotFound, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.Equal("booking-not-found", response.Code);
+    }
+
+    [Fact]
+    public async Task Cancel_Twice_Returns204BothTimesAndDoesNotChangeBooking()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future(), 60);
+        var first = await Cancel(booking);
+        var afterFirst = await Reload(booking);
+
+        var second = await Cancel(booking);
+
+        Assert.Equal(HttpStatusCode.NoContent, first.Status);
+        Assert.Equal(HttpStatusCode.NoContent, second.Status);
+        Assert.Equal(afterFirst.ToString(), (await Reload(booking)).ToString());
+    }
+
+    [Fact]
+    public async Task Cancel_FreesTheRoomForNewBooking()
+    {
+        var room = await api.CreateRoomAsync();
+        var start = ApiFixture.Future();
+        var booking = await api.CreateBookingAsync(room, start, 60);
+        await Cancel(booking);
+
+        var again = await api.SendAsync(HttpMethod.Post, "/api/v1/bookings", ApiFixture.BobKey,
+            new { roomId = room, title = "Освободилось", startsAt = start, durationMinutes = 60 });
