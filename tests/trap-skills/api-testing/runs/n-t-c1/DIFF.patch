+using System.Net;
+using System.Text.Json;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class BookingReadTests(ApiFixture api)
+{
+    private static string Id(JsonElement booking) => booking.GetProperty("id").GetString()!;
+
+    private static List<string> Ids(ApiResponse page) =>
+        page.Body.GetProperty("items").EnumerateArray().Select(Id).ToList();
+
+    [Fact]
+    public async Task Get_AnotherParticipantsBooking_IsVisible()
+    {
+        var room = await api.CreateRoomAsync();
+        var created = await api.CreateBookingAsync(room, ApiFixture.Future(), key: ApiFixture.AliceKey);
+
+        var response = await api.GetAsync($"/api/v1/bookings/{Id(created)}", ApiFixture.BobKey);
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Equal("alice", response.Body.GetProperty("ownerId").GetString());
+    }
+
+    [Fact]
+    public async Task Get_Unknown_Returns404BookingNotFound()
+    {
+        var response = await api.GetAsync($"/api/v1/bookings/{Guid.NewGuid()}");
+
+        Assert.Equal(HttpStatusCode.NotFound, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.Equal("booking-not-found", response.Code);
+    }
+
+    [Theory(Skip = "BKG-31: расхождение с контрактом - 404 без code (см. описание MR)")]
+    [InlineData("GET")]
+    [InlineData("PATCH")]
+    [InlineData("DELETE")]
+    public async Task BookingId_NotAUuid_Returns404BookingNotFound(string method)
+    {
+        var response = await api.SendAsync(new HttpMethod(method), "/api/v1/bookings/not-a-uuid", body:
+            method == "PATCH" ? new { startsAt = ApiFixture.Future(), durationMinutes = 30, version = 1 } : null);
+
+        Assert.Equal(HttpStatusCode.NotFound, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.Equal("booking-not-found", response.Code);
+    }
+
+    [Fact]
+    public async Task List_FiltersByRoom_AscendingByStartThenId()
+    {
+        var room = await api.CreateRoomAsync();
+        var other = await api.CreateRoomAsync();
+        var b2 = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 13));
+        var b1 = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8));
+        await api.CreateBookingAsync(other, ApiFixture.Future(hour: 10));
+
+        var response = await api.GetAsync($"/api/v1/bookings?roomId={room}");
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Equal([Id(b1), Id(b2)], Ids(response));
+        Assert.Equal(JsonValueKind.Null, response.Body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_IncludesCancelledBookings()
+    {
+        var room = await api.CreateRoomAsync();
+        var booking = await api.CreateBookingAsync(room, ApiFixture.Future());
+        await api.SendAsync(HttpMethod.Delete, $"/api/v1/bookings/{Id(booking)}");
+
+        var response = await api.GetAsync($"/api/v1/bookings?roomId={room}");
+
+        var item = Assert.Single(response.Body.GetProperty("items").EnumerateArray());
+        Assert.Equal("cancelled", item.GetProperty("status").GetString());
+    }
+
+    [Fact]
+    public async Task List_EmptyResult_ReturnsEmptyItemsAndNullCursor()
+    {
+        var room = await api.CreateRoomAsync();
+
+        var response = await api.GetAsync($"/api/v1/bookings?roomId={room}");
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Equal(0, response.Body.GetProperty("items").GetArrayLength());
+        Assert.Equal(JsonValueKind.Null, response.Body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_CursorWalksAllPagesWithoutGapsOrDuplicates()
+    {
+        var room = await api.CreateRoomAsync();
+        var expected = new List<string>();
+        for (var i = 0; i < 5; i++)
+            expected.Add(Id(await api.CreateBookingAsync(room, ApiFixture.Future(hour: 6 + i * 2), 60)));
+
+        var seen = new List<string>();
+        string? cursor = null;
+        var pages = 0;
+        do
+        {
+            var url = $"/api/v1/bookings?roomId={room}&limit=2" + (cursor is null ? "" : $"&cursor={Uri.EscapeDataString(cursor)}");
+            var page = await api.GetAsync(url);
+            Assert.Equal(HttpStatusCode.OK, page.Status);
+            seen.AddRange(Ids(page));
+            var next = page.Body.GetProperty("nextCursor");
+            cursor = next.ValueKind == JsonValueKind.Null ? null : next.GetString();
+            pages++;
+        } while (cursor is not null && pages < 10);
+
+        Assert.Equal(3, pages);
+        Assert.Equal(expected, seen);
+    }
+
+    [Fact]
+    public async Task List_ExactlyLimitItems_HasNoNextCursor()
+    {
+        var room = await api.CreateRoomAsync();
+        await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8));
+        await api.CreateBookingAsync(room, ApiFixture.Future(hour: 10));
+
+        var response = await api.GetAsync($"/api/v1/bookings?roomId={room}&limit=2");
+
+        Assert.Equal(2, response.Body.GetProperty("items").GetArrayLength());
+        Assert.Equal(JsonValueKind.Null, response.Body.GetProperty("nextCursor").ValueKind);
+    }
+
+    [Fact]
+    public async Task List_FiltersByPeriod_FromIsExclusiveOfEndedAndToOfStarted()
+    {
+        var room = await api.CreateRoomAsync();
+        var morning = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 8), 60);   // 08-09
+        var noon = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 12), 60);     // 12-13
+        var evening = await api.CreateBookingAsync(room, ApiFixture.Future(hour: 18), 60);  // 18-19
+        var from = Uri.EscapeDataString(ApiFixture.Future(hour: 9).ToString("O"));          // morning заканчивается ровно в from
+        var to = Uri.EscapeDataString(ApiFixture.Future(hour: 18).ToString("O"));           // evening начинается ровно в to
+
+        var response = await api.GetAsync($"/api/v1/bookings?roomId={room}&from={from}&to={to}");
+
+        Assert.Equal([Id(noon)], Ids(response));
+        Assert.DoesNotContain(Id(morning), Ids(response));
+        Assert.DoesNotContain(Id(evening), Ids(response));
+    }
+
+    [Fact]
+    public async Task List_WithoutRoomFilter_SpansRooms()
+    {
+        var first = await api.CreateRoomAsync();
+        var second = await api.CreateRoomAsync();
+        var a = await api.CreateBookingAsync(first, ApiFixture.Future(days: 20, hour: 8));
+        var b = await api.CreateBookingAsync(second, ApiFixture.Future(days: 20, hour: 8));
+
+        var from = Uri.EscapeDataString(ApiFixture.Future(days: 20, hour: 0).ToString("O"));
+        var to = Uri.EscapeDataString(ApiFixture.Future(days: 20, hour: 23).ToString("O"));
+        var response = await api.GetAsync($"/api/v1/bookings?from={from}&to={to}&limit=100");
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Contains(Id(a), Ids(response));
+        Assert.Contains(Id(b), Ids(response));
+    }
+
+    [Theory]
+    [InlineData("limit=0", "limit")]
+    [InlineData("limit=101", "limit")]
+    [InlineData("limit=-5", "limit")]
+    [InlineData("cursor=%21%21not-a-cursor", "cursor")]
+    public async Task List_InvalidParameters_Returns400(string query, string field)
+    {
+        var response = await api.GetAsync($"/api/v1/bookings?{query}");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.True(response.Body.GetProperty("errors").TryGetProperty(field, out _), response.Text);
+    }
+
+    [Fact]
+    public async Task List_MalformedDate_Returns400()
+    {
+        var response = await api.GetAsync("/api/v1/bookings?to=tomorrow");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+    }
+
+    [Fact(Skip = "BKG-31: расхождение с контрактом - roomId длиннее 64 даёт 200 (см. описание MR)")]
+    public async Task List_RoomIdLongerThan64_Returns400()
+    {
+        var response = await api.GetAsync($"/api/v1/bookings?roomId={new string('a', 65)}");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+    }
+
+    [Fact]
+    public async Task List_CursorLongerThan256_Returns400()
+    {
+        var response = await api.GetAsync($"/api/v1/bookings?cursor={new string('A', 300)}");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+    }
+}
