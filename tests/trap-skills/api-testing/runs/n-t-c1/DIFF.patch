+using System.Net;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>FR-12: любой запрос - только с ключом; 401 с code unauthorized на каждой операции.</summary>
+[Collection(ApiCollection.Name)]
+public class AuthTests(ApiFixture api)
+{
+    private const string SomeId = "3f2b8a64-5717-4562-b3fc-2c963f66afa6";
+
+    public static TheoryData<string, string> Operations => new()
+    {
+        { "GET", "/api/v1/rooms" },
+        { "GET", "/api/v1/rooms/orion" },
+        { "GET", "/api/v1/rooms/orion/bookings" },
+        { "GET", "/api/v1/bookings" },
+        { "POST", "/api/v1/bookings" },
+        { "GET", $"/api/v1/bookings/{SomeId}" },
+        { "PATCH", $"/api/v1/bookings/{SomeId}" },
+        { "DELETE", $"/api/v1/bookings/{SomeId}" },
+    };
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task WithoutKey_Returns401Unauthorized(string method, string url)
+    {
+        var response = await api.SendAsync(new HttpMethod(method), url, key: null, body: BodyFor(method));
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.Equal("unauthorized", response.Code);
+    }
+
+    [Theory]
+    [MemberData(nameof(Operations))]
+    public async Task WithUnknownKey_Returns401Unauthorized(string method, string url)
+    {
+        var response = await api.SendAsync(new HttpMethod(method), url, key: "wrong-key", body: BodyFor(method));
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.Status);
+        Assert.Equal("application/problem+json", response.MediaType);
+        Assert.Equal("unauthorized", response.Code);
+    }
+
+    private static object? BodyFor(string method) => method switch
+    {
+        "POST" => new { roomId = "orion", title = "x", startsAt = ApiFixture.Future(), durationMinutes = 30 },
+        "PATCH" => new { startsAt = ApiFixture.Future(), durationMinutes = 30, version = 0 },
+        _ => null,
+    };
+}
