+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+[Collection(ApiCollection.Name)]
+public class RoomsTests(ApiFixture api)
+{
+    [Fact]
+    public async Task ListRooms_ReturnsPageOrderedById()
+    {
+        var response = await api.GetAsync("/api/v1/rooms?limit=100");
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        var items = response.Body.GetProperty("items").EnumerateArray().ToList();
+        var ids = items.Select(r => r.GetProperty("id").GetString()!).ToList();
+        Assert.Equal(ids.OrderBy(i => i, StringComparer.Ordinal), ids);
+        Assert.Contains("orion", ids);
+        Assert.True(response.Body.GetProperty("total").GetInt32() >= items.Count);
+    }
+
+    [Fact]
+    public async Task ListRooms_ItemMatchesRoomSchema()
+    {
+        var response = await api.GetAsync("/api/v1/rooms?limit=100");
+
+        var orion = response.Body.GetProperty("items").EnumerateArray().Single(r => r.GetProperty("id").GetString() == "orion");
+        Assert.Equal("Orion", orion.GetProperty("name").GetString());
+        Assert.Equal(8, orion.GetProperty("capacity").GetInt32());
+        Assert.Equal(3, orion.GetProperty("floor").GetInt32());
+        Assert.Equal(["projector", "whiteboard"], orion.GetProperty("features").EnumerateArray().Select(f => f.GetString()));
+    }
+
+    [Fact]
+    public async Task ListRooms_LimitAndOffsetSlicePage()
+    {
+        var all = await api.GetAsync("/api/v1/rooms?limit=100");
+        var allIds = all.Body.GetProperty("items").EnumerateArray().Select(r => r.GetProperty("id").GetString()).ToList();
+
+        var page = await api.GetAsync("/api/v1/rooms?limit=1&offset=1");
