+
+    [Fact]
+    public async Task Create_CreatedBookingIsReadable()
+    {
+        var room = await api.CreateRoomAsync();
+        var created = await api.CreateBookingAsync(room, ApiFixture.Future());
+
+        var response = await api.GetAsync($"/api/v1/bookings/{created.GetProperty("id").GetString()}");
+
+        Assert.Equal(HttpStatusCode.OK, response.Status);
+        Assert.Equal(created.ToString(), response.Body.ToString());
