+    [Fact]
+    public async Task Create_AdjacentBookings_Accepted()
+    {
+        var room = await api.CreateRoomAsync();
+        var start = ApiFixture.Future();
+        await api.CreateBookingAsync(room, start, 60);
+
+        var after = await Create(new { roomId = room, title = "Сразу после", startsAt = start.AddMinutes(60), durationMinutes = 60 });
+        var before = await Create(new { roomId = room, title = "Сразу до", startsAt = start.AddMinutes(-60), durationMinutes = 60 });
+
+        Assert.Equal(HttpStatusCode.Created, after.Status);
+        Assert.Equal(HttpStatusCode.Created, before.Status);
+    }
+
+    [Fact]
+    public async Task Create_SameTimeInAnotherRoom_Accepted()
+    {
+        var first = await api.CreateRoomAsync();
+        var second = await api.CreateRoomAsync();
+        var start = ApiFixture.Future();
+        await api.CreateBookingAsync(first, start, 60);
+
+        var response = await Create(new { roomId = second, title = "Другая комната", startsAt = start, durationMinutes = 60 });
+
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+    }
+
+    [Fact]
+    public async Task Create_OverCancelledBooking_Accepted()
+    {
+        var room = await api.CreateRoomAsync();
+        var start = ApiFixture.Future();
+        var first = await api.CreateBookingAsync(room, start, 60);
+        await api.SendAsync(HttpMethod.Delete, $"/api/v1/bookings/{first.GetProperty("id").GetString()}");
+
+        var response = await Create(new { roomId = room, title = "Вместо отменённой", startsAt = start, durationMinutes = 60 });
