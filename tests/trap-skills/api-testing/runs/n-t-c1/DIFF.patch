+using System.Net;
+using System.Net.Http.Headers;
+using System.Text.Json;
+
+namespace Bookings.Api.Tests;
+
+public sealed record ApiResponse(
+    HttpStatusCode Status, HttpResponseHeaders Headers, string? MediaType, string Text, JsonElement? Json)
+{
+    public JsonElement Body => Json ?? throw new InvalidOperationException($"Нет JSON-тела: {Text}");
+
+    public string? Code =>
+        Json is { ValueKind: JsonValueKind.Object } j && j.TryGetProperty("code", out var c) ? c.GetString() : null;
+}
