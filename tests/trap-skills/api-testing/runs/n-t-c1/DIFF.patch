new file mode 100644
index 0000000..2a01025
--- /dev/null
+++ b/tests/Bookings.Api.Tests/ApiFixture.cs
@@ -0,0 +1,102 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Bookings.Api.Data;
+using Bookings.Api.Domain;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Testcontainers.PostgreSql;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+/// <summary>Один PostgreSQL и одно приложение на все тесты; каждый тест работает в своей комнате.</summary>
+public sealed class ApiFixture : IAsyncLifetime
+{
+    public const string AliceKey = "test-alice-key";
+    public const string BobKey = "test-bob-key";
+    public const string AdminKey = "test-admin-key";
+
+    private readonly PostgreSqlContainer _postgres = new PostgreSqlBuilder("postgres:16-alpine").Build();
+    private WebApplicationFactory<Program> _factory = null!;
+    private int _roomCounter;
+
+    public HttpClient Client { get; private set; } = null!;
+
+    public async Task InitializeAsync()
+    {
+        await _postgres.StartAsync();
+        var connectionString = _postgres.GetConnectionString();
+
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+            builder.ConfigureAppConfiguration((_, config) => config.AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["ConnectionStrings:Bookings"] = connectionString,
+                ["Database:Initialize"] = "true",
+                ["Auth:Keys:0:key"] = AliceKey,
+                ["Auth:Keys:0:userId"] = "alice",
+                ["Auth:Keys:0:role"] = "member",
+                ["Auth:Keys:1:key"] = BobKey,
+                ["Auth:Keys:1:userId"] = "bob",
+                ["Auth:Keys:1:role"] = "member",
+                ["Auth:Keys:2:key"] = AdminKey,
+                ["Auth:Keys:2:userId"] = "admin",
+                ["Auth:Keys:2:role"] = "admin",
+            })));
+
+        // Создание клиента поднимает хост: схема и стартовые комнаты создаются на старте
+        Client = _factory.CreateClient();
+    }
+
+    public async Task DisposeAsync()
+    {
+        Client?.Dispose();
+        if (_factory is not null)
+            await _factory.DisposeAsync();
+        await _postgres.DisposeAsync();
+    }
+
+    /// <summary>Заводит новую пустую комнату напрямую в БД (API комнат только читает).</summary>
+    public async Task<string> CreateRoomAsync(string prefix = "t")
+    {
+        var id = $"{prefix}-{Interlocked.Increment(ref _roomCounter)}-{Guid.NewGuid():N}";
+        using var scope = _factory.Services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<BookingsDbContext>();
+        db.Rooms.Add(new Room(id, $"Room {id}", 6, 2));
+        await db.SaveChangesAsync();
+        return id;
+    }
+
+    public async Task<ApiResponse> SendAsync(HttpMethod method, string url, string? key = AliceKey, object? body = null)
+    {
+        using var request = new HttpRequestMessage(method, url);
+        if (key is not null)
+            request.Headers.Add("X-Api-Key", key);
+        if (body is not null)
+            request.Content = JsonContent.Create(body);
+
+        using var response = await Client.SendAsync(request);
+        var text = await response.Content.ReadAsStringAsync();
+        var mediaType = response.Content.Headers.ContentType?.MediaType;
+        JsonElement? json = text.Length > 0 && mediaType is not null && mediaType.Contains("json")
+            ? JsonDocument.Parse(text).RootElement.Clone()
+            : null;
+        return new ApiResponse(response.StatusCode, response.Headers, mediaType, text, json);
+    }
+
+    public Task<ApiResponse> GetAsync(string url, string? key = AliceKey) => SendAsync(HttpMethod.Get, url, key);
+
+    public async Task<JsonElement> CreateBookingAsync(string roomId, DateTimeOffset startsAt, int durationMinutes = 60,
+        string key = AliceKey, string title = "Встреча", string? comment = null)
+    {
+        var response = await SendAsync(HttpMethod.Post, "/api/v1/bookings", key,
+            new { roomId, title, startsAt, durationMinutes, comment });
+        Assert.Equal(HttpStatusCode.Created, response.Status);
+        return response.Body;
+    }
+
+    /// <summary>Начало в будущем на заданное число дней вперёд, в заданный час UTC.</summary>
+    public static DateTimeOffset Future(int days = 3, int hour = 9) =>
+        new(DateTimeOffset.UtcNow.Date.AddDays(days).AddHours(hour), TimeSpan.Zero);
+}
