new file mode 100644
index 0000000..baa576d
--- /dev/null
+++ b/src/Pricing.Api/Swagger/EnumDescriptionSchemaFilter.cs
@@ -0,0 +1,22 @@
+using System.ComponentModel;
+using System.Reflection;
+using Microsoft.OpenApi;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Pricing.Api.Swagger;
+
+/// <summary>Добавляет в описание enum значения с их смыслом из <see cref="DescriptionAttribute"/>.</summary>
+public sealed class EnumDescriptionSchemaFilter : ISchemaFilter
+{
+    public void Apply(IOpenApiSchema schema, SchemaFilterContext context)
+    {
+        var type = Nullable.GetUnderlyingType(context.Type) ?? context.Type;
+        if (!type.IsEnum || schema is not OpenApiSchema concrete) return;
+
+        var lines = type.GetFields(BindingFlags.Public | BindingFlags.Static)
+            .Select(f => (f.Name, f.GetCustomAttribute<DescriptionAttribute>()?.Description))
+            .Where(x => x.Description is not null)
+            .Select(x => $"- `{x.Name}` - {x.Description}");
+        concrete.Description = string.Join("\n", lines);
+    }
+}
