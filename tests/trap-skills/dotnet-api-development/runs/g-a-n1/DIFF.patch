+using Pricing.Domain;
+
+namespace Pricing.Api.Contracts;
+
+public sealed record PriceListItemDto(string Sku, decimal Price);
+
+/// <summary>Документ ERP. Поставщик берётся из пути; служебные поля ERP игнорируются.</summary>
+public sealed record CreatePriceListRequest(
+    int Number, string Currency, PriceListStatus Status, DateOnly ValidFrom, DateOnly ValidTo,
+    IReadOnlyList<PriceListItemDto> Items, decimal PurchaseCost, decimal MarginPercent);
+
+public sealed record PriceListDto(
+    string SupplierId, int Number, string Currency, PriceListStatus Status,
+    DateOnly ValidFrom, DateOnly ValidTo, IReadOnlyList<PriceListItemDto> Items);
+
+public sealed record PriceListSummaryDto(
+    int Number, string Currency, PriceListStatus Status, DateOnly ValidFrom, DateOnly ValidTo, int ItemCount);
+
+public static class PriceListMapping
+{
+    public static PriceListDto ToDto(this PriceList p) => new(
+        p.SupplierId, p.Number, p.Currency, p.Status, p.ValidFrom, p.ValidTo,
+        p.Items.Select(i => new PriceListItemDto(i.Sku, i.Price)).ToList());
+
+    public static PriceListSummaryDto ToSummary(this PriceList p) =>
+        new(p.Number, p.Currency, p.Status, p.ValidFrom, p.ValidTo, p.Items.Count);
+}
