@@ -0,0 +1,69 @@
+using System.ComponentModel;
+
+namespace Pricing.Domain;
+
+public enum PriceListStatus
+{
+    [Description("Лист заведён, не проверен")]
+    Draft,
+
+    [Description("Лист действует")]
+    Published,
+
+    [Description("Поставщик временно снял лист и вернёт его сам; публиковать повторно нельзя")]
+    Suspended,
+
+    [Description("Лист снят навсегда; можно опубликовать новый лист на его основе")]
+    Retired,
+}
+
+public sealed record PriceListItem(string Sku, decimal Price);
+
+public sealed class PriceList
+{
+    public PriceList(
+        Guid id, string supplierId, int number, string currency, PriceListStatus status,
+        DateOnly validFrom, DateOnly validTo, IReadOnlyList<PriceListItem> items,
+        decimal purchaseCost, decimal marginPercent)
+    {
+        if (string.IsNullOrWhiteSpace(supplierId)) throw new DomainException("price_list.supplier_required", "Поставщик обязателен");
+        if (number <= 0) throw new DomainException("price_list.number_positive", "Номер листа должен быть больше нуля");
+        if (string.IsNullOrWhiteSpace(currency)) throw new DomainException("price_list.currency_required", "Валюта обязательна");
+        if (validTo < validFrom) throw new DomainException("price_list.period_invalid", "Конец периода раньше начала");
+        if (items.Count == 0) throw new DomainException("price_list.items_required", "В листе нет позиций");
+        if (items.Any(i => string.IsNullOrWhiteSpace(i.Sku)))
+            throw new DomainException("price_list.sku_required", "SKU позиции обязателен");
+        if (items.Any(i => i.Price <= 0))
+            throw new DomainException("price_list.price_positive", "Цена позиции должна быть больше нуля");
+        if (items.Select(i => i.Sku).Distinct().Count() != items.Count)
+            throw new DomainException("price_list.sku_duplicated", "SKU в листе повторяется");
+
+        Id = id;
+        SupplierId = supplierId;
+        Number = number;
+        Currency = currency.ToUpperInvariant();
+        Status = status;
+        ValidFrom = validFrom;
+        ValidTo = validTo;
+        Items = items;
+        PurchaseCost = purchaseCost;
+        MarginPercent = marginPercent;
+    }
+
+    public Guid Id { get; }
+    public string SupplierId { get; }
+    public int Number { get; }
+    public string Currency { get; }
+    public PriceListStatus Status { get; }
+    public DateOnly ValidFrom { get; }
+    public DateOnly ValidTo { get; }
+    public IReadOnlyList<PriceListItem> Items { get; }
+
+    /// <summary>Коммерческая тайна: наружу через API не отдаётся.</summary>
+    public decimal PurchaseCost { get; }
+
+    /// <summary>Коммерческая тайна: наружу через API не отдаётся.</summary>
+    public decimal MarginPercent { get; }
+
+    public bool IsActiveOn(DateOnly date) => ValidFrom <= date && date <= ValidTo;
+}
