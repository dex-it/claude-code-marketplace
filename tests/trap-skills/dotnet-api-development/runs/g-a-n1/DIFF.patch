@@ -0,0 +1,25 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Infrastructure.Persistence;
+
+public sealed class InMemoryPriceListRepository(InMemoryStore store) : IPriceListRepository
+{
+    public Task<PriceList?> GetAsync(string supplierId, int number, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.GetValueOrDefault((supplierId, number)));
+
+    public Task<IReadOnlyList<PriceList>> SearchAsync(PriceListFilter filter, int skip, int take, CancellationToken ct) =>
+        Task.FromResult<IReadOnlyList<PriceList>>(Filter(filter).OrderBy(p => p.Number).Skip(skip).Take(take).ToList());
+
+    public Task<int> CountAsync(PriceListFilter filter, CancellationToken ct) => Task.FromResult(Filter(filter).Count());
+
+    public Task<bool> TryAddAsync(PriceList priceList, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.TryAdd((priceList.SupplierId, priceList.Number), priceList));
+
+    private IEnumerable<PriceList> Filter(PriceListFilter f) =>
+        store.PriceLists.Values.Where(p =>
+            p.SupplierId == f.SupplierId
+            && (f.Status is null || p.Status == f.Status)
+            && (f.Currency is null || p.Currency == f.Currency.ToUpperInvariant())
+            && (f.ActiveOn is null || p.IsActiveOn(f.ActiveOn.Value)));
+}
