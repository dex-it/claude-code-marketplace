+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceListServiceTests
+{
+    private readonly Mock<IPriceListRepository> _priceLists = new();
+    private readonly Mock<IProductRepository> _products = new();
+
+    private PriceListService Service() => new(_priceLists.Object, _products.Object);
+
+    private static PriceList Published(params PriceListItem[] items) =>
+        new(Guid.NewGuid(), "sup-7", 42, "rub", PriceListStatus.Published,
+            new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31), items, 100m, 10m);
+
+    [Fact]
+    public async Task Create_rejects_taken_number()
+    {
+        _priceLists.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(false);
+        var cmd = new CreatePriceList("sup-7", 42, "RUB", PriceListStatus.Draft,
+            new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31), [new PriceListItem("SKU-1", 1m)], 1m, 1m);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => Service().CreateAsync(cmd, default));
+
+        Assert.Equal("price_list.number_taken", ex.Code);
+    }
+
+    [Fact]
+    public void Constructor_rejects_inverted_period()
+    {
+        var ex = Assert.Throws<DomainException>(() =>
+            new PriceList(Guid.NewGuid(), "sup-7", 1, "RUB", PriceListStatus.Draft,
+                new DateOnly(2026, 12, 31), new DateOnly(2026, 10, 1), [new PriceListItem("SKU-1", 1m)], 1m, 1m));
+
+        Assert.Equal("price_list.period_invalid", ex.Code);
+    }
+
+    [Fact]
+    public async Task Recalculate_updates_prices_of_supplier_products()
+    {
+        var own = new Product(Guid.NewGuid(), "SKU-1", "A", Category.Grocery, 50m, "sup-7");
+        var foreign = new Product(Guid.NewGuid(), "SKU-2", "B", Category.Grocery, 50m, "sup-1");
+        _priceLists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(Published(new PriceListItem("SKU-1", 120.5m), new PriceListItem("SKU-2", 75m)));
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(own);
+        _products.Setup(r => r.GetBySkuAsync("SKU-2", It.IsAny<CancellationToken>())).ReturnsAsync(foreign);
+
+        var updated = await Service().RecalculateBasePricesAsync("sup-7", 42, default);
+
+        Assert.Equal(1, updated);
+        Assert.Equal(120.5m, own.BasePrice);
+        Assert.Equal(50m, foreign.BasePrice);
+    }
+
+    [Theory]
+    [InlineData(PriceListStatus.Draft)]
+    [InlineData(PriceListStatus.Suspended)]
+    [InlineData(PriceListStatus.Retired)]
+    public async Task Recalculate_rejects_not_published_list(PriceListStatus status)
+    {
+        var list = new PriceList(Guid.NewGuid(), "sup-7", 42, "RUB", status,
+            new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31), [new PriceListItem("SKU-1", 1m)], 1m, 1m);
+        _priceLists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(list);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => Service().RecalculateBasePricesAsync("sup-7", 42, default));
+
+        Assert.Equal("price_list.not_published", ex.Code);
+    }
+}
