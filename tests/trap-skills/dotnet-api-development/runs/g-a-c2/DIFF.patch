+using Pricing.Domain;
+
+namespace Pricing.Api.Contracts;
+
+public sealed record PriceListItemDto(string Sku, decimal Price);
+
+/// <summary>Документ ERP. Поля ERP-учёта (erpDocumentId, erpUser, erpExportedAt) принимаются и не сохраняются.</summary>
+public sealed record UploadPriceListRequest(
+    string SupplierId, int Number, string Currency, PriceListStatus Status,
+    DateOnly ValidFrom, DateOnly ValidTo, IReadOnlyList<PriceListItemDto> Items,
+    decimal PurchaseCost, decimal MarginPercent,
+    string? ErpDocumentId = null, string? ErpUser = null, DateTimeOffset? ErpExportedAt = null);
+
+/// <summary>Прайс-лист для поставщика и портала. Себестоимость и маржа не отдаются.</summary>
+public sealed record PriceListDto(
+    string SupplierId, int Number, string Currency, PriceListStatus Status,
+    DateOnly ValidFrom, DateOnly ValidTo, IReadOnlyList<PriceListItemDto> Items);
+
+/// <summary>Строка списка листов.</summary>
+public sealed record PriceListSummaryDto(
+    int Number, string Currency, PriceListStatus Status, DateOnly ValidFrom, DateOnly ValidTo, int ItemCount);
+
+public sealed record RecalculationResultDto(int UpdatedProducts);
+
+public static class PriceListMapping
+{
+    public static PriceListDto ToDto(this PriceList l) => new(l.SupplierId, l.Number, l.Currency, l.Status,
+        l.ValidFrom, l.ValidTo, l.Items.Select(i => new PriceListItemDto(i.Sku, i.Price)).ToList());
+
+    public static PriceListSummaryDto ToSummary(this PriceList l) =>
+        new(l.Number, l.Currency, l.Status, l.ValidFrom, l.ValidTo, l.Items.Count);
+}
