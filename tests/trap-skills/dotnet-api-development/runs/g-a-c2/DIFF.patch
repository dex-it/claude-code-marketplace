+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api/price-lists")]
+public sealed class PriceListsController(PriceListService lists) : ControllerBase
+{
+    public const int MaxPageSize = 100;
+
+    /// <summary>Загрузка листа из ERP.</summary>
+    /// <remarks>В ответе - адрес созданного листа (Location).</remarks>
+    [HttpPost]
+    [ProducesResponseType<PriceListDto>(StatusCodes.Status201Created)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status409Conflict)]
+    public async Task<ActionResult<PriceListDto>> Upload(UploadPriceListRequest r, CancellationToken ct)
+    {
+        var items = (r.Items ?? []).Select(i => new PriceListItem(i.Sku, i.Price)).ToList();
+        var list = await lists.UploadAsync(new UploadPriceList(r.SupplierId, r.Number, r.Currency, r.Status,
+            r.ValidFrom, r.ValidTo, items, r.PurchaseCost, r.MarginPercent), ct);
+        return CreatedAtAction(nameof(Get), new { supplierId = list.SupplierId, number = list.Number }, list.ToDto());
+    }
+
+    /// <summary>Лист поставщика по номеру.</summary>
+    [HttpGet("{supplierId}/{number:int}")]
+    [ProducesResponseType<PriceListDto>(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<ActionResult<PriceListDto>> Get(string supplierId, int number, CancellationToken ct) =>
+        (await lists.GetAsync(supplierId, number, ct)).ToDto();
+
+    /// <summary>Поиск листов поставщика, постранично.</summary>
+    /// <param name="supplierId">Поставщик.</param>
+    /// <param name="status">Статус листа.</param>
+    /// <param name="currency">Валюта.</param>
+    /// <param name="date">Вернуть листы, действующие на эту дату.</param>
+    /// <param name="page">Номер страницы с 1.</param>
+    /// <param name="pageSize">Размер страницы, максимум 100.</param>
+    /// <param name="ct">Токен отмены.</param>
+    [HttpGet("{supplierId}")]
+    public async Task<ActionResult<PageDto<PriceListSummaryDto>>> Search(
+        string supplierId, [FromQuery] PriceListStatus? status, [FromQuery] string? currency,
+        [FromQuery] DateOnly? date, [FromQuery] int page = 1, [FromQuery] int pageSize = 20,
+        CancellationToken ct = default)
+    {
+        page = Math.Max(page, 1);
+        pageSize = Math.Clamp(pageSize, 1, MaxPageSize);
+        var result = await lists.SearchAsync(new PriceListFilter(supplierId, status, currency, date), page, pageSize, ct);
+        return new PageDto<PriceListSummaryDto>(
+            result.Items.Select(l => l.ToSummary()).ToList(), result.Page, result.PageSize, result.Total);
+    }
+
+    /// <summary>Внутренний вызов планировщика; скрыт из Swagger.</summary>
+    [HttpPost("{supplierId}/{number:int}/recalculate-prices")]
+    [ApiExplorerSettings(IgnoreApi = true)]
+    public async Task<ActionResult<RecalculationResultDto>> Recalculate(string supplierId, int number, CancellationToken ct) =>
+        new RecalculationResultDto(await lists.RecalculateBasePricesAsync(supplierId, number, ct));
+}
