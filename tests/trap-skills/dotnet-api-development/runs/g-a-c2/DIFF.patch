@@ -0,0 +1,50 @@
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Application.PriceLists;
+
+public sealed record UploadPriceList(
+    string SupplierId, int Number, string Currency, PriceListStatus Status,
+    DateOnly ValidFrom, DateOnly ValidTo, IReadOnlyList<PriceListItem> Items,
+    decimal PurchaseCost, decimal MarginPercent);
+
+public sealed class PriceListService(IPriceListRepository lists, IProductRepository products)
+{
+    public async Task<PriceList> GetAsync(string supplierId, int number, CancellationToken ct) =>
+        await lists.GetAsync(supplierId, number, ct)
+        ?? throw new NotFoundException("pricelist.not_found", $"Прайс-лист {number} поставщика {supplierId} не найден");
+
+    public async Task<PriceList> UploadAsync(UploadPriceList cmd, CancellationToken ct)
+    {
+        var list = new PriceList(cmd.SupplierId, cmd.Number, cmd.Currency, cmd.Status, cmd.ValidFrom, cmd.ValidTo,
+            cmd.Items, cmd.PurchaseCost, cmd.MarginPercent);
+        if (!await lists.TryAddAsync(list, ct))
+            throw new DomainException("pricelist.number_taken", $"Лист {cmd.Number} поставщика {cmd.SupplierId} уже есть");
+        return list;
+    }
+
+    public async Task<PagedResult<PriceList>> SearchAsync(PriceListFilter filter, int page, int pageSize, CancellationToken ct)
+    {
+        var (items, total) = await lists.SearchAsync(filter, (page - 1) * pageSize, pageSize, ct);
+        return new PagedResult<PriceList>(items, page, pageSize, total);
+    }
+
+    /// <summary>Обновляет базовые цены товаров поставщика по опубликованному листу; возвращает число обновлённых.</summary>
+    public async Task<int> RecalculateBasePricesAsync(string supplierId, int number, CancellationToken ct)
+    {
+        var list = await GetAsync(supplierId, number, ct);
+        if (list.Status != PriceListStatus.Published)
+            throw new DomainException("pricelist.not_published", "Пересчёт возможен только по опубликованному листу");
+
+        var updated = 0;
+        foreach (var item in list.Items)
+        {
+            var product = await products.GetBySkuAsync(item.Sku, ct);
+            if (product is null || product.SupplierId != supplierId) continue;
+            product.ChangePrice(item.Price);
+            updated++;
+        }
+        return updated;
+    }
+}
