@@ -0,0 +1,26 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Infrastructure.Persistence;
+
+public sealed class InMemoryPriceListRepository(InMemoryStore store) : IPriceListRepository
+{
+    public Task<PriceList?> GetAsync(string supplierId, int number, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.GetValueOrDefault((supplierId, number)));
+
+    public Task<bool> TryAddAsync(PriceList list, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.TryAdd((list.SupplierId, list.Number), list));
+
+    public Task<(IReadOnlyList<PriceList> Items, int Total)> SearchAsync(
+        PriceListFilter filter, int skip, int take, CancellationToken ct)
+    {
+        var query = store.PriceLists.Values.Where(l => l.SupplierId == filter.SupplierId);
+        if (filter.Status is { } status) query = query.Where(l => l.Status == status);
+        if (filter.Currency is { } currency)
+            query = query.Where(l => string.Equals(l.Currency, currency, StringComparison.OrdinalIgnoreCase));
+        if (filter.ActiveOn is { } date) query = query.Where(l => l.IsActiveOn(date));
+
+        var ordered = query.OrderBy(l => l.Number).ToList();
+        return Task.FromResult<(IReadOnlyList<PriceList>, int)>((ordered.Skip(skip).Take(take).ToList(), ordered.Count));
+    }
+}
