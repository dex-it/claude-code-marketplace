+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceListServiceTests
+{
+    private readonly Mock<IPriceListRepository> _lists = new();
+    private readonly Mock<IProductRepository> _products = new();
+
+    private PriceListService Service() => new(_lists.Object, _products.Object);
+
+    private static PriceList List(PriceListStatus status, params PriceListItem[] items) =>
+        new("sup-7", 42, "RUB", status, new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31), items, 100m, 10m);
+
+    [Fact]
+    public async Task Create_rejects_taken_number()
+    {
+        _lists.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(false);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => Service().CreateAsync(
+            new CreatePriceList("sup-7", 42, "RUB", PriceListStatus.Draft, new DateOnly(2026, 10, 1),
+                new DateOnly(2026, 12, 31), [new PriceListItem("SKU-1", 120.5m)], 100m, 10m), default));
+
+        Assert.Equal("price_list.number_taken", ex.Code);
+    }
+
+    [Fact]
+    public void List_rejects_inverted_period()
+    {
+        var ex = Assert.Throws<DomainException>(() => new PriceList(
+            "sup-7", 1, "RUB", PriceListStatus.Draft, new DateOnly(2026, 12, 31), new DateOnly(2026, 10, 1),
+            [new PriceListItem("SKU-1", 1m)], 0m, 0m));
+
+        Assert.Equal("price_list.period_invalid", ex.Code);
+    }
+
+    [Fact]
+    public void IsActiveOn_includes_period_bounds()
+    {
+        var list = List(PriceListStatus.Published, new PriceListItem("SKU-1", 1m));
+
+        Assert.True(list.IsActiveOn(new DateOnly(2026, 10, 1)));
+        Assert.True(list.IsActiveOn(new DateOnly(2026, 12, 31)));
+        Assert.False(list.IsActiveOn(new DateOnly(2027, 1, 1)));
+    }
+
+    [Fact]
+    public async Task Recalculate_updates_prices_of_suppliers_products()
+    {
+        var own = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 100m, "sup-7");
+        var foreign = new Product(Guid.NewGuid(), "SKU-2", "Кефир", Category.Grocery, 50m, "sup-1");
+        _lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(
+            List(PriceListStatus.Published, new PriceListItem("SKU-1", 120.5m), new PriceListItem("SKU-2", 75m)));
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(own);
+        _products.Setup(r => r.GetBySkuAsync("SKU-2", It.IsAny<CancellationToken>())).ReturnsAsync(foreign);
+
+        var updated = await Service().RecalculateBasePricesAsync("sup-7", 42, default);
+
+        Assert.Equal(1, updated);
+        Assert.Equal(120.5m, own.BasePrice);
+        Assert.Equal(50m, foreign.BasePrice);
+    }
+
+    [Theory]
+    [InlineData(PriceListStatus.Draft)]
+    [InlineData(PriceListStatus.Suspended)]
+    [InlineData(PriceListStatus.Retired)]
+    public async Task Recalculate_rejects_unpublished_list(PriceListStatus status)
+    {
+        _lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>()))
+            .ReturnsAsync(List(status, new PriceListItem("SKU-1", 1m)));
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => Service().RecalculateBasePricesAsync("sup-7", 42, default));
+
+        Assert.Equal("price_list.not_published", ex.Code);
+    }
+}
