new file mode 100644
index 0000000..c8a7c0b
--- /dev/null
+++ b/src/Pricing.Api/Swagger/EnumDescriptionSchemaFilter.cs
@@ -0,0 +1,23 @@
+using System.ComponentModel;
+using Microsoft.OpenApi;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Pricing.Api.Swagger;
+
+/// <summary>Добавляет в описание enum значения с их [Description].</summary>
+public sealed class EnumDescriptionSchemaFilter : ISchemaFilter
+{
+    public void Apply(IOpenApiSchema schema, SchemaFilterContext context)
+    {
+        var type = context.Type;
+        if (!type.IsEnum || schema is not OpenApiSchema concrete) return;
+
+        var lines = Enum.GetNames(type)
+            .Select(name => (name, d: type.GetField(name)!.GetCustomAttributes(typeof(DescriptionAttribute), false)
+                .Cast<DescriptionAttribute>().FirstOrDefault()?.Description))
+            .Where(x => x.d is not null)
+            .Select(x => $"- `{x.name}` - {x.d}");
+        var text = string.Join("\n", lines);
+        if (text.Length > 0) concrete.Description = text;
+    }
+}
