+using System.ComponentModel;
+
+namespace Pricing.Domain;
+
+public enum PriceListStatus
+{
+    [Description("Лист заведён, не проверен. Не действует.")]
+    Draft,
+
+    [Description("Лист действует.")]
+    Published,
+
+    [Description("Поставщик временно снял лист и вернёт его сам. Публиковать повторно нельзя - кнопку «опубликовать заново» не показывать.")]
+    Suspended,
+
+    [Description("Лист снят навсегда. Можно опубликовать новый лист на его основе - кнопку «опубликовать заново» показывать.")]
+    Retired,
+}
+
+public sealed record PriceListItem(string Sku, decimal Price);
+
+public sealed class PriceList
+{
+    public PriceList(
+        string supplierId, int number, string currency, PriceListStatus status, DateOnly validFrom, DateOnly validTo,
+        IReadOnlyList<PriceListItem> items, decimal purchaseCost, decimal marginPercent)
+    {
+        if (string.IsNullOrWhiteSpace(supplierId)) throw new DomainException("pricelist.supplier_required", "Поставщик обязателен");
+        if (number <= 0) throw new DomainException("pricelist.number_positive", "Номер листа должен быть больше нуля");
+        if (string.IsNullOrWhiteSpace(currency)) throw new DomainException("pricelist.currency_required", "Валюта обязательна");
+        if (validTo < validFrom) throw new DomainException("pricelist.period_invalid", "Конец периода раньше начала");
+        if (items.Count == 0) throw new DomainException("pricelist.items_required", "В листе нет позиций");
+        if (items.Any(i => string.IsNullOrWhiteSpace(i.Sku) || i.Price <= 0))
+            throw new DomainException("pricelist.item_invalid", "У позиции нужны SKU и цена больше нуля");
+        if (items.Select(i => i.Sku).Distinct().Count() != items.Count)
+            throw new DomainException("pricelist.item_duplicate", "SKU в листе повторяется");
+        SupplierId = supplierId;
+        Number = number;
+        Currency = currency;
+        Status = status;
+        ValidFrom = validFrom;
+        ValidTo = validTo;
+        Items = items;
+        PurchaseCost = purchaseCost;
+        MarginPercent = marginPercent;
+    }
+
+    public string SupplierId { get; }
+    public int Number { get; }
+    public string Currency { get; }
+    public PriceListStatus Status { get; }
+    public DateOnly ValidFrom { get; }
+    public DateOnly ValidTo { get; }
+    public IReadOnlyList<PriceListItem> Items { get; }
+
+    /// <summary>Коммерческая тайна: только для закупщиков в ERP, наружу через API не отдаётся.</summary>
+    public decimal PurchaseCost { get; }
+
+    /// <summary>Коммерческая тайна: только для закупщиков в ERP, наружу через API не отдаётся.</summary>
+    public decimal MarginPercent { get; }
+}
