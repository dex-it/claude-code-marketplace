+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceListServiceTests
+{
+    private readonly Mock<IPriceListRepository> _lists = new();
+    private readonly Mock<IProductRepository> _products = new();
+
+    private PriceListService Service() => new(_lists.Object, _products.Object);
+
+    private static UploadPriceList Upload(int number = 42) => new(
+        "sup-7", number, "RUB", new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31),
+        [new PriceListItem("SKU-1", 120.5m)], 81000m, 18.5m);
+
+    [Fact]
+    public async Task Upload_creates_draft_list()
+    {
+        _lists.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(true);
+
+        var list = await Service().UploadAsync(Upload(), default);
+
+        Assert.Equal(PriceListStatus.Draft, list.Status);
+        Assert.Equal(42, list.Number);
+        Assert.Single(list.Items);
+    }
+
+    [Fact]
+    public async Task Upload_rejects_taken_number()
+    {
+        _lists.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(false);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => Service().UploadAsync(Upload(), default));
+
+        Assert.Equal("pricelist.number_taken", ex.Code);
+    }
+
+    [Fact]
+    public async Task Recalculate_rejects_unpublished_list()
+    {
+        var draft = new PriceList("sup-7", 42, "RUB", PriceListStatus.Draft, new DateOnly(2026, 10, 1),
+            new DateOnly(2026, 12, 31), [new PriceListItem("SKU-1", 120.5m)], 1m, 1m);
+        _lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(draft);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => Service().RecalculateBasePricesAsync("sup-7", 42, default));
+
+        Assert.Equal("pricelist.not_published", ex.Code);
+    }
+
+    [Fact]
+    public async Task Recalculate_updates_only_own_products_with_changed_price()
+    {
+        var list = new PriceList("sup-7", 42, "RUB", PriceListStatus.Published, new DateOnly(2026, 10, 1),
+            new DateOnly(2026, 12, 31), [new PriceListItem("SKU-1", 120.5m), new PriceListItem("SKU-2", 75m)], 1m, 1m);
+        var own = new Product(Guid.NewGuid(), "SKU-1", "A", Category.Grocery, 100m, "sup-7");
+        var foreign = new Product(Guid.NewGuid(), "SKU-2", "B", Category.Grocery, 50m, "sup-1");
+        _lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(list);
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(own);
+        _products.Setup(r => r.GetBySkuAsync("SKU-2", It.IsAny<CancellationToken>())).ReturnsAsync(foreign);
+
+        var updated = await Service().RecalculateBasePricesAsync("sup-7", 42, default);
+
+        Assert.Equal(1, updated);
+        Assert.Equal(120.5m, own.BasePrice);
+        Assert.Equal(50m, foreign.BasePrice);
+    }
+
+    [Fact]
+    public void List_requires_items()
+    {
+        var ex = Assert.Throws<DomainException>(() => new PriceList("sup-7", 1, "RUB", PriceListStatus.Draft,
+            new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31), [], 1m, 1m));
+
+        Assert.Equal("pricelist.items_required", ex.Code);
+    }
+}
