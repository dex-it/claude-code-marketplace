index 0000000..9bc4e13
--- /dev/null
+++ b/src/Pricing.Api/Swagger/EnumDescriptionSchemaFilter.cs
@@ -0,0 +1,22 @@
+using System.ComponentModel;
+using Microsoft.OpenApi;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Pricing.Api.Swagger;
+
+/// <summary>Добавляет в схему enum описание каждого значения из <see cref="DescriptionAttribute"/>.</summary>
+public sealed class EnumDescriptionSchemaFilter : ISchemaFilter
+{
+    public void Apply(IOpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (!context.Type.IsEnum || schema is not OpenApiSchema concrete) return;
+        var lines = Enum.GetNames(context.Type)
+            .Select(name => (name, text: context.Type.GetField(name)?
+                .GetCustomAttributes(typeof(DescriptionAttribute), false)
+                .OfType<DescriptionAttribute>().FirstOrDefault()?.Description))
+            .Where(x => x.text is not null)
+            .Select(x => $"* `{x.name}` - {x.text}")
+            .ToList();
+        if (lines.Count > 0) concrete.Description = string.Join("\n", lines);
+    }
+}
