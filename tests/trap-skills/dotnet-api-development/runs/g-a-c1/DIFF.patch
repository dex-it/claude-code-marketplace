@@ -0,0 +1,67 @@
+namespace Pricing.Domain;
+
+/// <summary>Статус прайс-листа поставщика.</summary>
+public enum PriceListStatus
+{
+    /// <summary>Лист заведён, не проверен. Не действует.</summary>
+    Draft,
+
+    /// <summary>Лист действует.</summary>
+    Published,
+
+    /// <summary>Поставщик временно снял лист и вернёт его сам. Повторно публиковать нельзя: кнопку «опубликовать заново» не показывать.</summary>
+    Suspended,
+
+    /// <summary>Лист снят навсегда. Закупщик может опубликовать новый лист на его основе; сам этот лист не возобновляется.</summary>
+    Retired,
+}
+
+public sealed record PriceListItem(string Sku, decimal Price);
+
+public sealed class PriceList
+{
+    public PriceList(
+        string supplierId, int number, string currency, PriceListStatus status,
+        DateOnly validFrom, DateOnly validTo, IReadOnlyList<PriceListItem> items,
+        decimal purchaseCost, decimal marginPercent)
+    {
+        if (string.IsNullOrWhiteSpace(supplierId)) throw new DomainException("pricelist.supplier_required", "Поставщик обязателен");
+        if (number <= 0) throw new DomainException("pricelist.number_positive", "Номер листа должен быть больше нуля");
+        if (string.IsNullOrWhiteSpace(currency) || currency.Length != 3)
+            throw new DomainException("pricelist.currency_invalid", "Валюта - трёхбуквенный код");
+        if (!Enum.IsDefined(status)) throw new DomainException("pricelist.status_invalid", "Неизвестный статус");
+        if (validTo < validFrom) throw new DomainException("pricelist.period_invalid", "Окончание действия раньше начала");
+        if (items is null || items.Count == 0) throw new DomainException("pricelist.items_required", "В листе нет позиций");
+        if (items.Any(i => string.IsNullOrWhiteSpace(i.Sku))) throw new DomainException("pricelist.sku_required", "SKU обязателен");
+        if (items.Any(i => i.Price <= 0)) throw new DomainException("pricelist.price_positive", "Цена должна быть больше нуля");
+        if (items.Select(i => i.Sku).Distinct().Count() != items.Count)
+            throw new DomainException("pricelist.sku_duplicate", "SKU в листе повторяются");
+        if (purchaseCost < 0) throw new DomainException("pricelist.cost_negative", "Себестоимость не может быть отрицательной");
+
+        SupplierId = supplierId;
+        Number = number;
+        Currency = currency.ToUpperInvariant();
+        Status = status;
+        ValidFrom = validFrom;
+        ValidTo = validTo;
+        Items = items.ToList();
+        PurchaseCost = purchaseCost;
+        MarginPercent = marginPercent;
+    }
+
+    public string SupplierId { get; }
+    public int Number { get; }
+    public string Currency { get; }
+    public PriceListStatus Status { get; }
+    public DateOnly ValidFrom { get; }
+    public DateOnly ValidTo { get; }
+    public IReadOnlyList<PriceListItem> Items { get; }
+
+    /// <summary>Коммерческая тайна: наружу (портал, витрина) не отдаётся.</summary>
+    public decimal PurchaseCost { get; }
+
+    /// <summary>Коммерческая тайна: наружу (портал, витрина) не отдаётся.</summary>
+    public decimal MarginPercent { get; }
+
+    public bool IsActiveOn(DateOnly date) => ValidFrom <= date && date <= ValidTo;
+}
