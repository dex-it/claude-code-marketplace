+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceListServiceTests
+{
+    private readonly Mock<IPriceListRepository> _lists = new();
+    private readonly Mock<IProductRepository> _products = new();
+
+    private static UploadPriceList Doc(PriceListStatus status = PriceListStatus.Draft) => new(
+        "sup-7", 42, "RUB", status, new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31),
+        [new PriceListItem("SKU-1", 120.5m)], 81000m, 18.5m);
+
+    [Fact]
+    public async Task Upload_rejects_taken_number()
+    {
+        _lists.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(false);
+        var ex = await Assert.ThrowsAsync<DomainException>(() =>
+            new PriceListService(_lists.Object, _products.Object).UploadAsync(Doc(), default));
+        Assert.Equal("pricelist.number_taken", ex.Code);
+    }
+
+    [Fact]
+    public async Task Recalculate_requires_published_list()
+    {
+        var list = new PriceList("sup-7", 42, "RUB", PriceListStatus.Suspended, new DateOnly(2026, 10, 1),
+            new DateOnly(2026, 12, 31), [new PriceListItem("SKU-1", 100m)], 1m, 1m);
+        _lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(list);
+        var ex = await Assert.ThrowsAsync<DomainException>(() =>
+            new PriceListService(_lists.Object, _products.Object).RecalculateBasePricesAsync("sup-7", 42, default));
+        Assert.Equal("pricelist.not_published", ex.Code);
+    }
+
+    [Fact]
+    public async Task Recalculate_updates_catalog_price()
+    {
+        var list = new PriceList("sup-7", 42, "RUB", PriceListStatus.Published, new DateOnly(2026, 10, 1),
+            new DateOnly(2026, 12, 31), [new PriceListItem("SKU-1", 100m), new PriceListItem("SKU-9", 5m)], 1m, 1m);
+        var product = new Product(Guid.NewGuid(), "SKU-1", "Молоко", Category.Grocery, 89.9m, "sup-7");
+        _lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(list);
+        _products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(product);
+
+        var result = await new PriceListService(_lists.Object, _products.Object).RecalculateBasePricesAsync("sup-7", 42, default);
+
+        Assert.Equal(100m, product.BasePrice);
+        Assert.Equal(new RecalculationResult(1, 1), result);
+    }
+}
