+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api/suppliers/{supplierId}/price-lists")]
+public sealed class PriceListsController(PriceListService lists) : ControllerBase
+{
+    public const int MaxPageSize = 100;
+
+    /// <summary>Загрузка листа из ERP. Возвращает 201 с адресом созданного листа.</summary>
+    [HttpPost]
+    [ProducesResponseType<PriceListDto>(StatusCodes.Status201Created)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status409Conflict)]
+    public async Task<ActionResult<PriceListDto>> Upload(string supplierId, UploadPriceListRequest request, CancellationToken ct)
+    {
+        if (!string.Equals(supplierId, request.SupplierId, StringComparison.Ordinal))
+            return Problem(statusCode: StatusCodes.Status400BadRequest, title: "supplierId в адресе и в документе различаются");
+        var list = await lists.UploadAsync(new UploadPriceList(
+            request.SupplierId, request.Number, request.Currency, request.Status, request.ValidFrom, request.ValidTo,
+            request.Items.Select(i => new PriceListItem(i.Sku, i.Price)).ToList(),
+            request.PurchaseCost, request.MarginPercent), ct);
+        return CreatedAtAction(nameof(Get), new { supplierId = list.SupplierId, number = list.Number }, list.ToDto());
+    }
+
+    [HttpGet("{number:int}")]
+    [ProducesResponseType<PriceListDto>(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<ActionResult<PriceListDto>> Get(string supplierId, int number, CancellationToken ct) =>
+        (await lists.GetAsync(supplierId, number, ct)).ToDto();
+
+    /// <summary>Поиск листов поставщика. <paramref name="activeOn"/> - лист действует на эту дату.</summary>
+    [HttpGet]
+    public async Task<ActionResult<PageDto<PriceListSummaryDto>>> Search(
+        string supplierId,
+        [FromQuery] PriceListStatus? status, [FromQuery] string? currency, [FromQuery] DateOnly? activeOn,
+        [FromQuery] int page = 1, [FromQuery] int pageSize = 20, CancellationToken ct = default)
+    {
+        page = Math.Max(page, 1);
+        pageSize = Math.Clamp(pageSize, 1, MaxPageSize);
+        var result = await lists.SearchAsync(supplierId, new PriceListFilter(status, currency, activeOn), page, pageSize, ct);
+        return new PageDto<PriceListSummaryDto>(
+            result.Items.Select(l => l.ToSummary()).ToList(), result.Page, result.PageSize, result.Total);
+    }
+
+    /// <summary>Внутренний вызов планировщика; в Swagger не публикуется.</summary>
+    [HttpPost("{number:int}/recalculate-base-prices")]
+    [ApiExplorerSettings(IgnoreApi = true)]
+    public async Task<ActionResult<RecalculationResultDto>> Recalculate(string supplierId, int number, CancellationToken ct)
+    {
+        var r = await lists.RecalculateBasePricesAsync(supplierId, number, ct);
+        return new RecalculationResultDto(r.Updated, r.Skipped);
+    }
+}
