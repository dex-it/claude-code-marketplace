diff --git a/src/Pricing.Api/Swagger/EnumDescriptionSchemaFilter.cs b/src/Pricing.Api/Swagger/EnumDescriptionSchemaFilter.cs
new file mode 100644
index 0000000..7c09cb6
--- /dev/null
+++ b/src/Pricing.Api/Swagger/EnumDescriptionSchemaFilter.cs
@@ -0,0 +1,23 @@
+using System.ComponentModel;
+using Microsoft.OpenApi;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Pricing.Api.Swagger;
+
+/// <summary>Переносит [Description] значений enum в описание схемы, чтобы интеграторы видели разницу значений.</summary>
+public sealed class EnumDescriptionSchemaFilter : ISchemaFilter
+{
+    public void Apply(IOpenApiSchema schema, SchemaFilterContext context)
+    {
+        var type = Nullable.GetUnderlyingType(context.Type) ?? context.Type;
+        if (!type.IsEnum || schema is not OpenApiSchema concrete) return;
+
+        var lines = type.GetFields().Where(f => f.IsStatic)
+            .Select(f => (f.Name, Text: f.GetCustomAttributes(typeof(DescriptionAttribute), false)
+                .Cast<DescriptionAttribute>().FirstOrDefault()?.Description))
+            .Where(x => x.Text is not null)
+            .Select(x => $"- `{x.Name}` - {x.Text}")
+            .ToList();
+        if (lines.Count > 0) concrete.Description = string.Join('\n', lines);
+    }
+}
