@@ -0,0 +1,28 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Infrastructure.Persistence;
+
+public sealed class InMemoryPriceListRepository(InMemoryStore store) : IPriceListRepository
+{
+    public Task<PriceList?> GetAsync(string supplierId, int number, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.GetValueOrDefault((supplierId, number)));
+
+    public Task<bool> TryAddAsync(PriceList list, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.TryAdd((list.SupplierId, list.Number), list));
+
+    public Task<IReadOnlyList<PriceList>> SearchAsync(
+        string supplierId, PriceListStatus? status, string? currency, DateOnly? date, int skip, int take, CancellationToken ct) =>
+        Task.FromResult<IReadOnlyList<PriceList>>(Filter(supplierId, status, currency, date)
+            .OrderBy(l => l.Number).Skip(skip).Take(take).ToList());
+
+    public Task<int> CountAsync(string supplierId, PriceListStatus? status, string? currency, DateOnly? date, CancellationToken ct) =>
+        Task.FromResult(Filter(supplierId, status, currency, date).Count());
+
+    private IEnumerable<PriceList> Filter(string supplierId, PriceListStatus? status, string? currency, DateOnly? date) =>
+        store.PriceLists.Values.Where(l =>
+            l.SupplierId == supplierId
+            && (status is null || l.Status == status)
+            && (currency is null || string.Equals(l.Currency, currency, StringComparison.OrdinalIgnoreCase))
+            && (date is null || l.IsActiveOn(date.Value)));
+}
