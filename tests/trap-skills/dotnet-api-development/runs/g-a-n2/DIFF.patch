@@ -0,0 +1,54 @@
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Application.PriceLists;
+
+public sealed record CreatePriceList(
+    string SupplierId, int Number, string Currency, PriceListStatus Status,
+    DateOnly ValidFrom, DateOnly ValidTo, IReadOnlyList<PriceListItem> Items,
+    decimal PurchaseCost, decimal MarginPercent);
+
+public sealed record PriceListQuery(string SupplierId, PriceListStatus? Status, string? Currency, DateOnly? Date);
+
+public sealed class PriceListService(IPriceListRepository priceLists, IProductRepository products)
+{
+    public async Task<PriceList> GetAsync(string supplierId, int number, CancellationToken ct) =>
+        await priceLists.GetAsync(supplierId, number, ct)
+        ?? throw new NotFoundException("price_list.not_found", $"Прайс-лист {number} поставщика {supplierId} не найден");
+
+    public async Task<PriceList> CreateAsync(CreatePriceList cmd, CancellationToken ct)
+    {
+        var list = new PriceList(cmd.SupplierId, cmd.Number, cmd.Currency, cmd.Status,
+            cmd.ValidFrom, cmd.ValidTo, cmd.Items, cmd.PurchaseCost, cmd.MarginPercent);
+        if (!await priceLists.TryAddAsync(list, ct))
+            throw new DomainException("price_list.number_taken", $"Лист {cmd.Number} поставщика {cmd.SupplierId} уже есть");
+        return list;
+    }
+
+    public async Task<PagedResult<PriceList>> SearchAsync(PriceListQuery query, int page, int pageSize, CancellationToken ct)
+    {
+        var items = await priceLists.SearchAsync(
+            query.SupplierId, query.Status, query.Currency, query.Date, (page - 1) * pageSize, pageSize, ct);
+        var total = await priceLists.CountAsync(query.SupplierId, query.Status, query.Currency, query.Date, ct);
+        return new PagedResult<PriceList>(items, page, pageSize, total);
+    }
+
+    /// <summary>Выставляет базовые цены каталога по опубликованному листу; возвращает число обновлённых товаров.</summary>
+    public async Task<int> RecalculateBasePricesAsync(string supplierId, int number, CancellationToken ct)
+    {
+        var list = await GetAsync(supplierId, number, ct);
+        if (list.Status != PriceListStatus.Published)
+            throw new DomainException("price_list.not_published", $"Лист {number} не опубликован: {list.Status}");
+
+        var updated = 0;
+        foreach (var item in list.Items)
+        {
+            var product = await products.GetBySkuAsync(item.Sku, ct);
+            if (product is null || product.SupplierId != supplierId) continue;
+            product.ChangePrice(item.Price);
+            updated++;
+        }
+        return updated;
+    }
+}
