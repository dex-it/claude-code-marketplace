+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api/suppliers/{supplierId}/price-lists")]
+public sealed class PriceListsController(PriceListService priceLists) : ControllerBase
+{
+    public const int MaxPageSize = 100;
+
+    [HttpPost]
+    [ProducesResponseType<PriceListDto>(StatusCodes.Status201Created)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status409Conflict)]
+    public async Task<ActionResult<PriceListDto>> Upload(string supplierId, UploadPriceListRequest request, CancellationToken ct)
+    {
+        var list = await priceLists.CreateAsync(new CreatePriceList(
+            supplierId, request.Number, request.Currency, request.Status, request.ValidFrom, request.ValidTo,
+            request.Items.Select(i => new PriceListItem(i.Sku, i.Price)).ToList(),
+            request.PurchaseCost, request.MarginPercent), ct);
+        return CreatedAtAction(nameof(Get), new { supplierId, number = list.Number }, list.ToDto());
+    }
+
+    [HttpGet("{number:int}")]
+    [ProducesResponseType<PriceListDto>(StatusCodes.Status200OK)]
+    [ProducesResponseType<ProblemDetails>(StatusCodes.Status404NotFound)]
+    public async Task<ActionResult<PriceListDto>> Get(string supplierId, int number, CancellationToken ct) =>
+        (await priceLists.GetAsync(supplierId, number, ct)).ToDto();
+
+    /// <param name="date">Вернуть листы, действующие на эту дату.</param>
+    [HttpGet]
+    public async Task<ActionResult<PageDto<PriceListSummaryDto>>> Search(
+        string supplierId,
+        [FromQuery] PriceListStatus? status, [FromQuery] string? currency, [FromQuery] DateOnly? date,
+        [FromQuery] int page = 1, [FromQuery] int pageSize = 20, CancellationToken ct = default)
+    {
+        page = Math.Max(page, 1);
+        pageSize = Math.Clamp(pageSize, 1, MaxPageSize);
+        var result = await priceLists.SearchAsync(new PriceListQuery(supplierId, status, currency, date), page, pageSize, ct);
+        return new PageDto<PriceListSummaryDto>(
+            result.Items.Select(l => l.ToSummary()).ToList(), result.Page, result.PageSize, result.Total);
+    }
+
+    /// <summary>Только для планировщика; в Swagger не публикуется.</summary>
+    [ApiExplorerSettings(IgnoreApi = true)]
+    [HttpPost("{number:int}/recalculation")]
+    public async Task<ActionResult<RecalculationResultDto>> Recalculate(string supplierId, int number, CancellationToken ct) =>
+        new RecalculationResultDto(await priceLists.RecalculateBasePricesAsync(supplierId, number, ct));
+}
