+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceListServiceTests
+{
+    private readonly Mock<IPriceListRepository> _priceLists = new();
+    private readonly Mock<IProductRepository> _products = new();
+
+    private static UploadPriceList Upload(int number = 42) => new(
+        "sup-7", number, "rub", new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31),
+        [new PriceListItem("SKU-1", 120.5m)], 81000m, 18.5m);
+
+    [Fact]
+    public async Task Upload_creates_draft_list()
+    {
+        _priceLists.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(true);
+        var service = new PriceListService(_priceLists.Object, _products.Object);
+
+        var created = await service.UploadAsync(Upload(), default);
+
+        Assert.Equal(PriceListStatus.Draft, created.Status);
+        Assert.Equal("RUB", created.Currency);
+        Assert.Single(created.Items);
+    }
+
+    [Fact]
+    public async Task Upload_rejects_taken_number()
+    {
+        _priceLists.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(false);
+        var service = new PriceListService(_priceLists.Object, _products.Object);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => service.UploadAsync(Upload(), default));
+
+        Assert.Equal("price_list.number_taken", ex.Code);
+    }
+
+    [Fact]
+    public async Task Recalculate_rejects_unpublished_list()
+    {
+        var draft = new PriceList("sup-7", 42, "RUB", new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31),
+            [new PriceListItem("SKU-1", 120.5m)], 1m, 1m);
+        _priceLists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(draft);
+        var service = new PriceListService(_priceLists.Object, _products.Object);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => service.RecalculateBasePricesAsync("sup-7", 42, default));
+
+        Assert.Equal("price_list.not_published", ex.Code);
+    }
+}
