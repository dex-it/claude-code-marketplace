+namespace Notify.Api.Services;
+
+public sealed class SmsSender : INotificationSender
+{
+    private readonly ILogger<SmsSender> _log;
+    public SmsSender(ILogger<SmsSender> log) => _log = log;
+
+    public Task SendAsync(string recipient, string text, CancellationToken ct = default)
+    {
+        _log.LogInformation("sms to {Recipient}", recipient);
+        return Task.CompletedTask;
+    }
+}
diff --git ab/_answer.md b/_answer.md
new file mode 100644
index 00000000..4978e6a0
--- /dev/null
+++ b/_answer.md
@@ -0,0 +1,15 @@
+**Создано:**
+- Services/SmsSender.cs
+- Services/NotificationChannels.cs
+- Controllers/ReportsController.cs
+
+**Изменено:**
+- Program.cs
+- Services/OrderService.cs
+- Controllers/OrdersController.cs
+
+**Решения:**
+- Оба отправителя зарегистрированы как keyed-singleton за `INotificationSender` (ключи "email" и "sms" лежат в константах `NotificationChannels`). Потребители берут нужный через `[FromKeyedServices]`. Незакрытой регистрации `INotificationSender` больше нет.
+- `OrderService` использует ключ sms. SMS нельзя слать на email, поэтому параметр стал `customerPhone`, а query-параметр `POST /orders/{id}/confirm` теперь `phone` вместо `email`. Это ломает контракт API для клиентов.
+- `POST /reports/{id}/send?email=...` использует ключ email. Id отчёта принят как Guid, потому что формат в проекте не задан. Содержимое отчёта пока заглушка, в тексте только id.
+- Сборку не запускал.
