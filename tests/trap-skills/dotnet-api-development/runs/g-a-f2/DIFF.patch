@@ -0,0 +1,27 @@
+using Pricing.Application.Abstractions;
+using Pricing.Domain;
+
+namespace Pricing.Infrastructure.Persistence;
+
+public sealed class InMemoryPriceListRepository(InMemoryStore store) : IPriceListRepository
+{
+    public Task<PriceList?> GetAsync(string supplierId, int number, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.GetValueOrDefault((supplierId, number)));
+
+    public Task<IReadOnlyList<PriceList>> SearchAsync(
+        string supplierId, PriceListFilter filter, int skip, int take, CancellationToken ct) =>
+        Task.FromResult<IReadOnlyList<PriceList>>(Query(supplierId, filter).OrderBy(p => p.Number).Skip(skip).Take(take).ToList());
+
+    public Task<int> CountAsync(string supplierId, PriceListFilter filter, CancellationToken ct) =>
+        Task.FromResult(Query(supplierId, filter).Count());
+
+    public Task<bool> TryAddAsync(PriceList priceList, CancellationToken ct) =>
+        Task.FromResult(store.PriceLists.TryAdd((priceList.SupplierId, priceList.Number), priceList));
+
+    private IEnumerable<PriceList> Query(string supplierId, PriceListFilter filter) =>
+        store.PriceLists.Values.Where(p =>
+            p.SupplierId == supplierId
+            && (filter.Status is null || p.Status == filter.Status)
+            && (filter.Currency is null || p.Currency == filter.Currency.ToUpperInvariant())
+            && (filter.ActiveOn is null || p.IsActiveOn(filter.ActiveOn.Value)));
+}
