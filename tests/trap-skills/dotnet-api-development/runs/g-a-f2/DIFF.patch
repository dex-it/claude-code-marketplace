+using Moq;
+using Pricing.Application.Abstractions;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+
+namespace Pricing.Tests;
+
+public sealed class PriceListServiceTests
+{
+    private static readonly IReadOnlyList<PriceListItem> Items =
+        [new PriceListItem("SKU-1", 120.5m), new PriceListItem("SKU-2", 75m)];
+
+    private static PriceList ListWith(PriceListStatus status) => new(
+        "sup-7", 42, "RUB", status, new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31), Items, 81000m, 18.5m);
+
+    [Fact]
+    public async Task Upload_rejects_taken_number()
+    {
+        var repo = new Mock<IPriceListRepository>();
+        repo.Setup(r => r.TryAddAsync(It.IsAny<PriceList>(), It.IsAny<CancellationToken>())).ReturnsAsync(false);
+        var service = new PriceListService(repo.Object, new Mock<IProductRepository>().Object);
+        var cmd = new UploadPriceList("sup-7", 42, "RUB", PriceListStatus.Draft,
+            new DateOnly(2026, 10, 1), new DateOnly(2026, 12, 31), Items, 81000m, 18.5m);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => service.UploadAsync(cmd, default));
+
+        Assert.Equal("price_list.number_taken", ex.Code);
+    }
+
+    [Fact]
+    public async Task Recalculate_updates_only_products_of_the_supplier()
+    {
+        var own = new Product(Guid.NewGuid(), "SKU-1", "A", Category.Grocery, 100m, "sup-7");
+        var foreign = new Product(Guid.NewGuid(), "SKU-2", "B", Category.Grocery, 50m, "sup-8");
+        var lists = new Mock<IPriceListRepository>();
+        lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(ListWith(PriceListStatus.Published));
+        var products = new Mock<IProductRepository>();
+        products.Setup(r => r.GetBySkuAsync("SKU-1", It.IsAny<CancellationToken>())).ReturnsAsync(own);
+        products.Setup(r => r.GetBySkuAsync("SKU-2", It.IsAny<CancellationToken>())).ReturnsAsync(foreign);
+
+        var result = await new PriceListService(lists.Object, products.Object).RecalculateAsync("sup-7", 42, default);
+
+        Assert.Equal(new RecalculationResult(1, 1), result);
+        Assert.Equal(120.5m, own.BasePrice);
+        Assert.Equal(50m, foreign.BasePrice);
+    }
+
+    [Theory]
+    [InlineData(PriceListStatus.Draft)]
+    [InlineData(PriceListStatus.Suspended)]
+    [InlineData(PriceListStatus.Retired)]
+    public async Task Recalculate_rejects_unpublished_list(PriceListStatus status)
+    {
+        var lists = new Mock<IPriceListRepository>();
+        lists.Setup(r => r.GetAsync("sup-7", 42, It.IsAny<CancellationToken>())).ReturnsAsync(ListWith(status));
+        var service = new PriceListService(lists.Object, new Mock<IProductRepository>().Object);
+
+        var ex = await Assert.ThrowsAsync<DomainException>(() => service.RecalculateAsync("sup-7", 42, default));
+
+        Assert.Equal("price_list.not_published", ex.Code);
+    }
+}
