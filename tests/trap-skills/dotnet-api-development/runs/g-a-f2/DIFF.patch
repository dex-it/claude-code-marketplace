@@ -0,0 +1,57 @@
+using Pricing.Application.Abstractions;
+using Pricing.Application.Products;
+using Pricing.Domain;
+
+namespace Pricing.Application.PriceLists;
+
+public sealed record UploadPriceList(
+    string SupplierId, int Number, string Currency, PriceListStatus Status, DateOnly ValidFrom, DateOnly ValidTo,
+    IReadOnlyList<PriceListItem> Items, decimal PurchaseCost, decimal MarginPercent);
+
+public sealed record RecalculationResult(int Updated, int Skipped);
+
+public sealed class PriceListService(IPriceListRepository priceLists, IProductRepository products)
+{
+    public async Task<PriceList> GetAsync(string supplierId, int number, CancellationToken ct) =>
+        await priceLists.GetAsync(supplierId, number, ct)
+        ?? throw new NotFoundException("price_list.not_found", $"Прайс-лист {number} поставщика {supplierId} не найден");
+
+    public async Task<PagedResult<PriceList>> SearchAsync(
+        string supplierId, PriceListFilter filter, int page, int pageSize, CancellationToken ct)
+    {
+        var items = await priceLists.SearchAsync(supplierId, filter, (page - 1) * pageSize, pageSize, ct);
+        return new PagedResult<PriceList>(items, page, pageSize, await priceLists.CountAsync(supplierId, filter, ct));
+    }
+
+    public async Task<PriceList> UploadAsync(UploadPriceList cmd, CancellationToken ct)
+    {
+        var priceList = new PriceList(
+            cmd.SupplierId, cmd.Number, cmd.Currency, cmd.Status, cmd.ValidFrom, cmd.ValidTo,
+            cmd.Items, cmd.PurchaseCost, cmd.MarginPercent);
+        if (!await priceLists.TryAddAsync(priceList, ct))
+            throw new DomainException("price_list.number_taken", $"Лист {cmd.Number} поставщика {cmd.SupplierId} уже есть");
+        return priceList;
+    }
+
+    /// <summary>Переносит цены опубликованного листа в базовые цены товаров этого поставщика.</summary>
+    public async Task<RecalculationResult> RecalculateAsync(string supplierId, int number, CancellationToken ct)
+    {
+        var priceList = await GetAsync(supplierId, number, ct);
+        if (priceList.Status != PriceListStatus.Published)
+            throw new DomainException("price_list.not_published", "Пересчёт возможен только по опубликованному листу");
+
+        int updated = 0, skipped = 0;
+        foreach (var item in priceList.Items)
+        {
+            var product = await products.GetBySkuAsync(item.Sku, ct);
+            if (product is null || product.SupplierId != supplierId)
+            {
+                skipped++;
+                continue;
+            }
+            product.ChangePrice(item.Price);
+            updated++;
+        }
+        return new RecalculationResult(updated, skipped);
+    }
+}
