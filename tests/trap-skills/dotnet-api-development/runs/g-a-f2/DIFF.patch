+using Microsoft.OpenApi;
+using Pricing.Application.PriceLists;
+using Pricing.Domain;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Pricing.Api.Contracts;
+
+/// <summary>Документ ERP. Служебные поля ERP (документ, пользователь, время выгрузки) не используются.</summary>
+public sealed record UploadPriceListRequest(
+    string SupplierId, int Number, string Currency, PriceListStatus Status, DateOnly ValidFrom, DateOnly ValidTo,
+    IReadOnlyList<PriceListItemDto> Items, decimal PurchaseCost, decimal MarginPercent);
+
+public sealed record PriceListItemDto(string Sku, decimal Price);
+
+/// <summary>Лист для портала: без себестоимости и маржи.</summary>
+public sealed record PriceListDto(
+    string SupplierId, int Number, string Currency, PriceListStatus Status, DateOnly ValidFrom, DateOnly ValidTo,
+    IReadOnlyList<PriceListItemDto> Items);
+
+public sealed record PriceListSummaryDto(
+    int Number, string Currency, PriceListStatus Status, DateOnly ValidFrom, DateOnly ValidTo, int ItemCount);
+
+public static class PriceListMapping
+{
+    public static PriceListDto ToDto(this PriceList p) => new(
+        p.SupplierId, p.Number, p.Currency, p.Status, p.ValidFrom, p.ValidTo,
+        p.Items.Select(i => new PriceListItemDto(i.Sku, i.Price)).ToList());
+
+    public static PriceListSummaryDto ToSummary(this PriceList p) =>
+        new(p.Number, p.Currency, p.Status, p.ValidFrom, p.ValidTo, p.Items.Count);
+
+    public static UploadPriceList ToCommand(this UploadPriceListRequest r) => new(
+        r.SupplierId, r.Number, r.Currency, r.Status, r.ValidFrom, r.ValidTo,
+        r.Items.Select(i => new PriceListItem(i.Sku, i.Price)).ToList(), r.PurchaseCost, r.MarginPercent);
+}
+
+/// <summary>Описывает смысл статусов листа в Swagger для интеграторов портала.</summary>
+public sealed class PriceListStatusSchemaFilter : ISchemaFilter
+{
+    public void Apply(IOpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (context.Type != typeof(PriceListStatus) || schema is not OpenApiSchema concrete) return;
+        concrete.Description =
+            "Draft - лист заведён, не проверен. " +
+            "Published - лист действует. " +
+            "Suspended - поставщик временно снял лист и вернёт его сам; публиковать повторно нельзя, кнопку «опубликовать заново» не показывать. " +
+            "Retired - лист снят навсегда; можно опубликовать новый лист на его основе, кнопку «опубликовать заново» показывать.";
+    }
+}
