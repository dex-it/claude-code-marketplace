+using Microsoft.AspNetCore.Mvc;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+using Bookings.Api.Contracts;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>Примеры значений в схемах моделей запросов и ответов и описание поля <c>code</c> в ошибках.</summary>
+public class SchemaExamplesFilter : ISchemaFilter
+{
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        var type = context.Type;
+
+        if (type == typeof(CreateBookingRequest))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["roomId"] = new OpenApiString("orion"),
+                ["title"] = new OpenApiString("Планёрка команды"),
+                ["startsAt"] = new OpenApiString("2026-11-02T09:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(60),
+                ["comment"] = new OpenApiString("Нужен проектор")
+            };
+        }
+        else if (type == typeof(RescheduleBookingRequest))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["startsAt"] = new OpenApiString("2026-11-02T10:30:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(45),
+                ["version"] = new OpenApiInteger(1)
+            };
+        }
+        else if (type == typeof(BookingDto))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["id"] = new OpenApiString("3f2b8c1e-5a47-4d0e-9b6a-1c7e2d4f8a90"),
+                ["roomId"] = new OpenApiString("orion"),
+                ["title"] = new OpenApiString("Планёрка команды"),
+                ["comment"] = new OpenApiString("Нужен проектор"),
+                ["startsAt"] = new OpenApiString("2026-11-02T09:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(60),
+                ["endsAt"] = new OpenApiString("2026-11-02T10:00:00Z"),
+                ["ownerId"] = new OpenApiString("alice"),
+                ["status"] = new OpenApiString("active"),
+                ["version"] = new OpenApiInteger(1)
+            };
+        }
+        else if (type == typeof(RoomDto))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["id"] = new OpenApiString("orion"),
+                ["name"] = new OpenApiString("Orion"),
+                ["capacity"] = new OpenApiInteger(8),
+                ["floor"] = new OpenApiInteger(3),
+                ["features"] = new OpenApiArray { new OpenApiString("projector"), new OpenApiString("whiteboard") }
+            };
+        }
+        else if (type == typeof(ProblemDetails))
+        {
+            schema.Description = "Ошибка в формате RFC 9457 (application/problem+json).";
+            schema.Properties["code"] = new OpenApiSchema
+            {
+                Type = "string",
+                Nullable = true,
+                Description = "Машинный код ошибки для ветвления в клиенте: unauthorized, forbidden, room-not-found, " +
+                              "booking-not-found, not-owner, version-conflict, booking-cancelled, booking-overlap. " +
+                              "В ответах 400 (ошибки валидации) поля нет."
+            };
+        }
+    }
+}
+
+/// <summary>Помечает обязательными свойства, не допускающие null: клиент получает ненулевые типы.</summary>
+public class RequiredPropertiesFilter : ISchemaFilter
+{
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (schema.Properties is null || typeof(ProblemDetails).IsAssignableFrom(context.Type))
+            return;
+
+        foreach (var (name, property) in schema.Properties)
+        {
+            if (!property.Nullable)
+                schema.Required.Add(name);
+        }
+    }
+}
+
+/// <summary>Ответ 401 у каждой операции и примеры ошибочных ответов из <see cref="ProblemResponseAttribute"/>.</summary>
+public class ProblemResponsesFilter : IOperationFilter
+{
+    private const string ProblemJson = "application/problem+json";
+
+    public void Apply(OpenApiOperation operation, OperationFilterContext context)
+    {
+        var problems = context.MethodInfo.GetCustomAttributes(typeof(ProblemResponseAttribute), true)
+            .Cast<ProblemResponseAttribute>()
+            .ToList();
+        problems.Add(new ProblemResponseAttribute(StatusCodes.Status401Unauthorized, "unauthorized", "Нужен действующий ключ доступа."));
+
+        foreach (var group in problems.GroupBy(p => p.Status))
+        {
+            var examples = group.ToDictionary(
+                p => p.Code,
+                p => new OpenApiExample
+                {
+                    Summary = p.Code,
+                    Value = new OpenApiObject
+                    {
+                        ["title"] = new OpenApiString(p.Title),
+                        ["status"] = new OpenApiInteger(p.Status),
+                        ["code"] = new OpenApiString(p.Code)
+                    }
+                });
+            AddProblem(operation, context, group.Key, typeof(ProblemDetails), group.First().Title, examples);
+        }
+
+        if (context.MethodInfo.GetCustomAttributes(typeof(ValidationProblemResponseAttribute), true)
+                .FirstOrDefault() is ValidationProblemResponseAttribute validation)
+        {
+            var examples = new Dictionary<string, OpenApiExample>
+            {
+                ["validation"] = new OpenApiExample
+                {
+                    Summary = "Ошибка валидации",
+                    Value = new OpenApiObject
+                    {
+                        ["title"] = new OpenApiString("One or more validation errors occurred."),
+                        ["status"] = new OpenApiInteger(400),
+                        ["errors"] = new OpenApiObject
+                        {
+                            [validation.Field] = new OpenApiArray { new OpenApiString(validation.Message) }
+                        }
+                    }
+                }
+            };
+            AddProblem(operation, context, StatusCodes.Status400BadRequest, typeof(ValidationProblemDetails), "Ошибка валидации запроса.", examples);
+        }
+    }
+
+    private static void AddProblem(
+        OpenApiOperation operation, OperationFilterContext context, int status, Type type, string description,
+        Dictionary<string, OpenApiExample> examples)
+    {
+        var key = status.ToString();
+        if (!operation.Responses.TryGetValue(key, out var response))
+        {
+            response = new OpenApiResponse { Description = description };
+            operation.Responses[key] = response;
+        }
+
+        response.Content.Clear();
+        response.Content[ProblemJson] = new OpenApiMediaType
+        {
+            Schema = context.SchemaGenerator.GenerateSchema(type, context.SchemaRepository),
+            Examples = examples
+        };
+    }
+}
