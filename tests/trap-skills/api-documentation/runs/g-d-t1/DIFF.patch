+            **Время.** Все моменты времени - в UTC (ISO 8601); смещение во входящих значениях приводится к UTC.
+
+            **Ошибки.** Ошибки - `application/problem+json`; машинный код - поле `code`
+            (ошибки валидации 400 - без `code`, с перечнем полей в `errors`).
+
+            **Повтор запроса.** `GET` и `DELETE` безопасно повторять. `POST /bookings` не идемпотентен
+            и ключа идемпотентности не принимает; `PATCH` защищён версией брони.
+            Подробности - в описании операций.
+            """
+    });
+
+    o.AddSecurityDefinition(ApiKeyAuthenticationHandler.SchemeName, new OpenApiSecurityScheme
+    {
+        Type = SecuritySchemeType.ApiKey,
+        In = ParameterLocation.Header,
+        Name = ApiKeyAuthenticationHandler.HeaderName,
+        Description = "Ключ доступа участника или администратора."
+    });
+    o.AddSecurityRequirement(new OpenApiSecurityRequirement
+    {
+        [new OpenApiSecurityScheme
+        {
+            Reference = new OpenApiReference { Type = ReferenceType.SecurityScheme, Id = ApiKeyAuthenticationHandler.SchemeName }
+        }] = []
+    });
+
+    o.IncludeXmlComments(Path.Combine(AppContext.BaseDirectory, $"{typeof(Program).Assembly.GetName().Name}.xml"));
+    o.SupportNonNullableReferenceTypes();
+    o.SchemaFilter<SchemaExamplesFilter>();
+    o.SchemaFilter<RequiredPropertiesFilter>();
+    o.OperationFilter<ProblemResponsesFilter>();
+});
 
 builder.Services.AddDbContext<BookingsDbContext>((services, options) =>
     options.UseNpgsql(services.GetRequiredService<IConfiguration>().GetConnectionString("Bookings")));
