+namespace Bookings.Api.Swagger;
+
+/// <summary>Описывает в Swagger ошибочный ответ problem+json с кодом <c>code</c> и пример к нему. На поведение не влияет.</summary>
+[AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
+public sealed class ProblemResponseAttribute(int status, string code, string title) : Attribute
+{
+    public int Status { get; } = status;
+    public string Code { get; } = code;
+    public string Title { get; } = title;
+}
+
+/// <summary>Описывает в Swagger ответ 400 с ошибками по полям и пример к нему. На поведение не влияет.</summary>
+[AttributeUsage(AttributeTargets.Method)]
+public sealed class ValidationProblemResponseAttribute(string field, string message) : Attribute
+{
+    public string Field { get; } = field;
+    public string Message { get; } = message;
+}
