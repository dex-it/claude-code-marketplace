+using Bookings.Api.Auth;
+using Microsoft.OpenApi.Models;
+
+namespace Bookings.Api.Swagger;
+
+public static class SwaggerConfiguration
+{
+    // Версия контракта - по api/CHANGELOG.md.
+    private const string ContractVersion = "1.2.0";
+
+    public static IServiceCollection AddBookingsSwagger(this IServiceCollection services) =>
+        services.AddSwaggerGen(c =>
+        {
+            c.SwaggerDoc("v1", new OpenApiInfo
+            {
+                Title = "Bookings API",
+                Version = ContractVersion,
+                Description =
+                    "Сервис бронирования переговорных: комнаты, брони, перенос и отмена.\n\n" +
+                    "- Время - UTC, формат ISO 8601 (`2026-10-20T09:00:00Z`).\n" +
+                    "- Все запросы - с заголовком `X-Api-Key`.\n" +
+                    "- Ошибки - `application/problem+json`; поле `code` - стабильный машиночитаемый код, " +
+                    "по нему клиент выбирает поведение. У ошибок валидации (400) вместо `code` - объект `errors` по полям.\n" +
+                    "- Идентификаторы комнат - строки (`orion`), брони - GUID.",
+            });
+
+            c.IncludeXmlComments(Path.Combine(AppContext.BaseDirectory, "Bookings.Api.xml"), includeControllerXmlComments: true);
+            c.SupportNonNullableReferenceTypes();
+            c.CustomSchemaIds(SchemaId);
+            c.CustomOperationIds(api =>
+                $"{api.ActionDescriptor.RouteValues["controller"]}_{api.ActionDescriptor.RouteValues["action"]}");
+
+            // Версия брони - xmin PostgreSQL, uint: в int32 не помещается.
+            c.MapType<uint>(() => new OpenApiSchema { Type = "integer", Format = "int64", Minimum = 0, Maximum = uint.MaxValue });
+
+            c.AddSecurityDefinition(ApiKeyAuthenticationHandler.SchemeName, new OpenApiSecurityScheme
+            {
+                Type = SecuritySchemeType.ApiKey,
+                In = ParameterLocation.Header,
+                Name = ApiKeyAuthenticationHandler.HeaderName,
+                Description = "Ключ доступа участника или администратора.",
+            });
+            c.AddSecurityRequirement(new OpenApiSecurityRequirement
+            {
+                [new OpenApiSecurityScheme
+                {
+                    Reference = new OpenApiReference { Type = ReferenceType.SecurityScheme, Id = ApiKeyAuthenticationHandler.SchemeName },
+                }] = [],
+            });
+
+            c.SchemaFilter<ContractSchemaFilter>();
+            c.OperationFilter<ContractOperationFilter>();
+        });
+
+    // CursorPageDto<BookingDto> -> BookingDtoCursorPage: читаемое имя типа в сгенерированном клиенте.
+    private static string SchemaId(Type type)
+    {
+        if (!type.IsGenericType)
+            return type.Name;
+
+        var name = type.Name[..type.Name.IndexOf('`')];
+        if (name.EndsWith("Dto", StringComparison.Ordinal))
+            name = name[..^3];
+
+        return string.Concat(type.GetGenericArguments().Select(SchemaId)) + name;
+    }
+}
