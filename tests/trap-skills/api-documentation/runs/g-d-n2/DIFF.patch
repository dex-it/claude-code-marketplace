+using Bookings.Api.Contracts;
+using Bookings.Api.Validation;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>
+/// Дополняет схемы: обязательные поля, ограничения из <see cref="BookingRules"/>, примеры значений,
+/// поле <c>code</c> в problem+json. Нужно, чтобы сгенерированный клиент не делал все поля необязательными.
+/// </summary>
+public sealed class ContractSchemaFilter : ISchemaFilter
+{
+    private static readonly Dictionary<string, IOpenApiAny> Examples = new()
+    {
+        ["id"] = new OpenApiString("3f2b8c1e-5a47-4d3e-9b6a-1c0f7e2d4a58"),
+        ["roomId"] = new OpenApiString("orion"),
+        ["title"] = new OpenApiString("Планирование спринта"),
+        ["comment"] = new OpenApiString("Нужен проектор"),
+        ["startsAt"] = new OpenApiString("2026-10-20T09:00:00Z"),
+        ["endsAt"] = new OpenApiString("2026-10-20T10:00:00Z"),
+        ["durationMinutes"] = new OpenApiInteger(60),
+        ["ownerId"] = new OpenApiString("alice"),
+        ["version"] = new OpenApiLong(1),
+        ["status"] = new OpenApiString("active"),
+        ["name"] = new OpenApiString("Orion"),
+        ["capacity"] = new OpenApiInteger(8),
+        ["floor"] = new OpenApiInteger(3),
+        ["total"] = new OpenApiInteger(3),
+        ["nextCursor"] = new OpenApiString("NjM5MDAwMDAwMDAwMDAwMDAwOjNmMmI4YzFlNWE0NzRkM2U5YjZhMWMwZjdlMmQ0YTU4"),
+    };
+
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        var type = context.Type;
+
+        if (type == typeof(ProblemDetails))
+        {
+            schema.Properties["code"] = new OpenApiSchema
+            {
+                Type = "string",
+                Nullable = true,
+                Description = "Машиночитаемый код ошибки, например `booking-overlap`; полный перечень - в описании операций.",
+                Example = new OpenApiString("booking-overlap"),
+            };
+            return;
+        }
+
+        if (type.Namespace != typeof(BookingDto).Namespace || schema.Properties is not { Count: > 0 })
+            return;
+
+        var isResponse = !type.Name.EndsWith("Request", StringComparison.Ordinal);
+
+        foreach (var (name, property) in schema.Properties)
+        {
+            if (type == typeof(RoomDto) && name == "id")
+                property.Example = new OpenApiString("orion");
+            else if (Examples.TryGetValue(name, out var example) && property.Example is null && property.Reference is null && property.Type != "array")
+                property.Example = example;
+
+            // Ответ всегда содержит все поля (null сериализуется); в запросе обязательны только не-nullable.
+            if (isResponse || !property.Nullable)
+                schema.Required.Add(name);
+        }
+
+        if (type == typeof(CreateBookingRequest))
+        {
+            schema.Properties["title"].MinLength = 1;
+            schema.Properties["title"].MaxLength = BookingRules.TitleMaxLength;
+            schema.Properties["comment"].MaxLength = BookingRules.CommentMaxLength;
+            ApplyDuration(schema.Properties["durationMinutes"]);
+        }
+        else if (type == typeof(RescheduleBookingRequest))
+        {
+            ApplyDuration(schema.Properties["durationMinutes"]);
+        }
+    }
+
+    private static void ApplyDuration(OpenApiSchema schema)
+    {
+        schema.Minimum = BookingRules.MinDurationMinutes;
+        schema.Maximum = BookingRules.MaxDurationMinutes;
+        schema.MultipleOf = BookingRules.DurationStep;
+    }
+}
