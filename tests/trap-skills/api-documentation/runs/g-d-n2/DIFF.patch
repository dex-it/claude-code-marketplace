diff --git a/src/Bookings.Api/Swagger/ContractOperationFilter.cs b/src/Bookings.Api/Swagger/ContractOperationFilter.cs
new file mode 100644
index 0000000..24006a6
--- /dev/null
+++ b/src/Bookings.Api/Swagger/ContractOperationFilter.cs
@@ -0,0 +1,108 @@
+using System.Reflection;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>
+/// Добавляет в каждую операцию ответ 401, примеры ошибок из <see cref="ProblemExampleAttribute"/> и
+/// <see cref="ValidationProblemExampleAttribute"/>, границы параметров <c>limit</c> и <c>offset</c>.
+/// </summary>
+public sealed class ContractOperationFilter : IOperationFilter
+{
+    private const string ProblemJson = "application/problem+json";
+    private const string TraceId = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00";
+
+    public void Apply(OpenApiOperation operation, OperationFilterContext context)
+    {
+        if (!operation.Responses.ContainsKey("401"))
+        {
+            operation.Responses["401"] = new OpenApiResponse
+            {
+                Description = "Ключ доступа не передан или не действителен.",
+                Content =
+                {
+                    [ProblemJson] = new OpenApiMediaType
+                    {
+                        Schema = context.SchemaGenerator.GenerateSchema(typeof(ProblemDetails), context.SchemaRepository),
+                    },
+                },
+            };
+        }
+
+        AddProblemExample(operation, new ProblemExampleAttribute(401, "unauthorized", "Нужен действующий ключ доступа."));
+
+        foreach (var attribute in context.MethodInfo.GetCustomAttributes<ProblemExampleAttribute>())
+            AddProblemExample(operation, attribute);
+
+        foreach (var attribute in context.MethodInfo.GetCustomAttributes<ValidationProblemExampleAttribute>())
+        {
+            if (!TryGetMedia(operation, 400, out var media))
+                continue;
+
+            media.Examples[attribute.Field] = new OpenApiExample
+            {
+                Value = new OpenApiObject
+                {
+                    ["type"] = new OpenApiString("https://tools.ietf.org/html/rfc9110#section-15.5.1"),
+                    ["title"] = new OpenApiString("One or more validation errors occurred."),
+                    ["status"] = new OpenApiInteger(400),
+                    ["errors"] = new OpenApiObject
+                    {
+                        [attribute.Field] = new OpenApiArray { new OpenApiString(attribute.Message) },
+                    },
+                    ["traceId"] = new OpenApiString(TraceId),
+                },
+            };
+        }
+
+        foreach (var parameter in operation.Parameters)
+        {
+            if (parameter.Name == "limit")
+            {
+                parameter.Schema.Minimum = 1;
+                parameter.Schema.Maximum = 100;
+            }
+            else if (parameter.Name == "offset")
+            {
+                parameter.Schema.Minimum = 0;
+            }
+        }
+    }
+
+    private static void AddProblemExample(OpenApiOperation operation, ProblemExampleAttribute attribute)
+    {
+        if (!TryGetMedia(operation, attribute.Status, out var media))
+            return;
+
+        media.Examples[attribute.Code] = new OpenApiExample
+        {
+            Value = new OpenApiObject
+            {
+                ["type"] = new OpenApiString($"https://tools.ietf.org/html/rfc9110#section-{Section(attribute.Status)}"),
+                ["title"] = new OpenApiString(attribute.Title),
+                ["status"] = new OpenApiInteger(attribute.Status),
+                ["code"] = new OpenApiString(attribute.Code),
+                ["traceId"] = new OpenApiString(TraceId),
+            },
+        };
+    }
+
+    private static bool TryGetMedia(OpenApiOperation operation, int status, out OpenApiMediaType media)
+    {
+        media = null!;
+        return operation.Responses.TryGetValue(status.ToString(), out var response)
+            && response.Content.TryGetValue(ProblemJson, out media!);
+    }
+
+    private static string Section(int status) => status switch
+    {
+        401 => "15.5.2",
+        403 => "15.5.4",
+        404 => "15.5.5",
+        409 => "15.5.10",
+        _ => "15.5.1",
+    };
+}
