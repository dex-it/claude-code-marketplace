@@ -0,0 +1,18 @@
+namespace Bookings.Api.Swagger;
+
+/// <summary>Пример ответа об ошибке (problem+json с полем <c>code</c>) для документации операции.</summary>
+[AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
+public sealed class ProblemExampleAttribute(int status, string code, string title) : Attribute
+{
+    public int Status { get; } = status;
+    public string Code { get; } = code;
+    public string Title { get; } = title;
+}
+
+/// <summary>Пример ответа 400 с ошибкой валидации одного поля для документации операции.</summary>
+[AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
+public sealed class ValidationProblemExampleAttribute(string field, string message) : Attribute
+{
+    public string Field { get; } = field;
+    public string Message { get; } = message;
+}
