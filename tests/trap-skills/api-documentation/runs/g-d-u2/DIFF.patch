+                ["name"] = new OpenApiString("Волга"),
+                ["capacity"] = new OpenApiInteger(8),
+                ["floor"] = new OpenApiInteger(3),
+                ["features"] = new OpenApiArray { new OpenApiString("projector"), new OpenApiString("whiteboard") }
+            };
+        else if (type == typeof(ProblemDetails))
+        {
+            schema.Properties["code"] = new OpenApiSchema
+            {
+                Type = "string",
+                Description = "Стабильный машинный код ошибки; на него опирается логика клиента."
+            };
+            schema.Example = new OpenApiObject
+            {
+                ["type"] = new OpenApiString("https://tools.ietf.org/html/rfc9110#section-15.5.10"),
+                ["title"] = new OpenApiString("Комната на это время уже занята."),
+                ["status"] = new OpenApiInteger(409),
+                ["code"] = new OpenApiString("booking-overlap"),
+                ["traceId"] = new OpenApiString(TraceId)
+            };
+        }
+        else if (type == typeof(ValidationProblemDetails))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["type"] = new OpenApiString("https://tools.ietf.org/html/rfc9110#section-15.5.1"),
+                ["title"] = new OpenApiString("One or more validation errors occurred."),
+                ["status"] = new OpenApiInteger(400),
+                ["errors"] = new OpenApiObject
+                {
+                    ["durationMinutes"] = new OpenApiArray
+                    {
+                        new OpenApiString("Длительность - от 15 до 240 минут, кратно 15.")
+                    }
+                },
+                ["traceId"] = new OpenApiString(TraceId)
+            };
+        }
+
+        // Поля ответов, не допускающие null, всегда приходят - клиент не должен делать их необязательными.
+        if (type == typeof(BookingDto) || type == typeof(RoomDto)
+            || type.IsGenericType && type.GetGenericTypeDefinition() is var generic
+            && (generic == typeof(PageDto<>) || generic == typeof(CursorPageDto<>)))
+        {
+            foreach (var (name, property) in schema.Properties)
+                if (!property.Nullable)
+                    schema.Required.Add(name);
+        }
+    }
+}
