+using Bookings.Api.Auth;
+using Microsoft.OpenApi.Models;
+
+namespace Bookings.Api.Swagger;
+
+public static class SwaggerSetup
+{
+    public const string DocumentName = "v1";
+
+    public static IServiceCollection AddBookingsSwagger(this IServiceCollection services)
+    {
+        services.AddEndpointsApiExplorer();
+        services.AddSwaggerGen(o =>
+        {
+            o.SwaggerDoc(DocumentName, new OpenApiInfo
+            {
+                Title = "Bookings API",
+                Version = "1.2.0",
+                Description = """
+                    Сервис бронирования переговорных: комнаты, брони, перенос и отмена.
+
+                    **Доступ.** Каждый запрос - с ключом доступа в заголовке `X-Api-Key`. Без ключа или с
+                    неизвестным ключом - 401 (`unauthorized`). Роли: `member` (участник) и `admin` (администратор).
+
+                    **Время.** Все моменты времени - UTC, формат ISO 8601 (`2026-11-02T09:00:00Z`).
+
+                    **Ошибки.** Все ошибки - `application/problem+json`; поле `code` - стабильный машинный код:
+                    `unauthorized`, `forbidden`, `room-not-found`, `booking-not-found`, `not-owner`,
+                    `booking-overlap`, `version-conflict`, `booking-cancelled`. Ошибки проверки полей (400)
+                    содержат `errors` - перечень сообщений по именам полей.
+
+                    **Параллельные изменения.** Бронь несёт `version`; перенос принимает версию, прочитанную
+                    клиентом, и при несовпадении отвечает 409 `version-conflict` - прочитайте бронь заново и повторите.
+
+                    **Повтор запросов.** `GET` и `DELETE` безопасно повторять после потерянного ответа.
+                    `PATCH` повторять можно: если первый запрос применился, версия брони уже изменилась, и повтор
+                    вернёт 409 `version-conflict` - прочитайте бронь и проверьте результат. `POST /api/v1/bookings`
+                    не идемпотентен - см. описание операции.
+                    """
+            });
+
+            o.AddSecurityDefinition(ApiKeyAuthenticationHandler.SchemeName, new OpenApiSecurityScheme
+            {
+                Type = SecuritySchemeType.ApiKey,
+                In = ParameterLocation.Header,
+                Name = ApiKeyAuthenticationHandler.HeaderName,
+                Description = "Ключ доступа участника или администратора."
+            });
+            o.AddSecurityRequirement(new OpenApiSecurityRequirement
+            {
+                [new OpenApiSecurityScheme
+                {
+                    Reference = new OpenApiReference
+                    {
+                        Type = ReferenceType.SecurityScheme,
+                        Id = ApiKeyAuthenticationHandler.SchemeName
+                    }
+                }] = Array.Empty<string>()
+            });
+
+            o.SupportNonNullableReferenceTypes();
+            // Version брони - xmin (uint): в int32 не помещается.
+            o.MapType<uint>(() => new OpenApiSchema { Type = "integer", Format = "int64" });
+            o.CustomOperationIds(api =>
+                api.ActionDescriptor.RouteValues.TryGetValue("controller", out var controller)
+                && api.ActionDescriptor.RouteValues.TryGetValue("action", out var action)
+                    ? $"{controller}_{action}"
+                    : null);
+            o.SchemaFilter<BookingsSchemaFilter>();
+
+            var xml = Path.Combine(AppContext.BaseDirectory, $"{typeof(SwaggerSetup).Assembly.GetName().Name}.xml");
+            if (File.Exists(xml))
+                o.IncludeXmlComments(xml, includeControllerXmlComments: true);
+        });
+
+        return services;
+    }
+}
