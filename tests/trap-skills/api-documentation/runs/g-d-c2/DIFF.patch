diff --git a/src/Bookings.Api/Documentation/RequiredNonNullablePropertiesFilter.cs b/src/Bookings.Api/Documentation/RequiredNonNullablePropertiesFilter.cs
new file mode 100644
index 0000000..04955e0
--- /dev/null
+++ b/src/Bookings.Api/Documentation/RequiredNonNullablePropertiesFilter.cs
@@ -0,0 +1,22 @@
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Documentation;
+
+/// <summary>
+/// Отмечает в схеме обязательными свойства, не допускающие null, чтобы клиент не получал их необязательными.
+/// </summary>
+public class RequiredNonNullablePropertiesFilter : ISchemaFilter
+{
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (schema.Properties is null || schema.Properties.Count == 0)
+            return;
+
+        foreach (var (name, property) in schema.Properties)
+        {
+            if (!property.Nullable)
+                schema.Required.Add(name);
+        }
+    }
+}
