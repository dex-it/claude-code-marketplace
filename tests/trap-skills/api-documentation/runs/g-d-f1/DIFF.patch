@@ -0,0 +1,64 @@
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>Добавляет к ошибочным ответам операций пример problem+json с кодом ошибки.</summary>
+public class ErrorExamplesOperationFilter : IOperationFilter
+{
+    private const string ProblemMediaType = "application/problem+json";
+
+    private static readonly Dictionary<string, (string Title, string Code)> Known = new()
+    {
+        ["401"] = ("Нужен действующий ключ доступа.", "unauthorized"),
+        ["Bookings_Create:404"] = ("Комната не найдена.", "room-not-found"),
+        ["Bookings_Create:409"] = ("Комната на это время уже занята.", "booking-overlap"),
+        ["Bookings_Get:404"] = ("Бронь не найдена.", "booking-not-found"),
+        ["Bookings_Reschedule:403"] = ("Изменить бронь может только её владелец или администратор.", "not-owner"),
+        ["Bookings_Reschedule:404"] = ("Бронь не найдена.", "booking-not-found"),
+        ["Bookings_Reschedule:409"] = ("Бронь изменилась, обновите её и повторите.", "version-conflict"),
+        ["Bookings_Cancel:403"] = ("Изменить бронь может только её владелец или администратор.", "not-owner"),
+        ["Bookings_Cancel:404"] = ("Бронь не найдена.", "booking-not-found"),
+        ["Rooms_Get:404"] = ("Комната не найдена.", "room-not-found"),
+        ["Rooms_ListRoomBookings:404"] = ("Комната не найдена.", "room-not-found")
+    };
+
+    public void Apply(OpenApiOperation operation, OperationFilterContext context)
+    {
+        foreach (var (status, response) in operation.Responses)
+        {
+            if (!response.Content.TryGetValue(ProblemMediaType, out var media))
+                continue;
+
+            if (status == "400")
+            {
+                media.Example = new OpenApiObject
+                {
+                    ["type"] = new OpenApiString("https://tools.ietf.org/html/rfc9110#section-15.5.1"),
+                    ["title"] = new OpenApiString("One or more validation errors occurred."),
+                    ["status"] = new OpenApiInteger(400),
+                    ["errors"] = new OpenApiObject
+                    {
+                        ["durationMinutes"] = new OpenApiArray
+                        {
+                            new OpenApiString("Длительность - от 15 до 240 минут, кратно 15.")
+                        }
+                    }
+                };
+                continue;
+            }
+
+            if (!Known.TryGetValue($"{operation.OperationId}:{status}", out var error) && !Known.TryGetValue(status, out error))
+                continue;
+
+            media.Example = new OpenApiObject
+            {
+                ["type"] = new OpenApiString("about:blank"),
+                ["title"] = new OpenApiString(error.Title),
+                ["status"] = new OpenApiInteger(int.Parse(status)),
+                ["code"] = new OpenApiString(error.Code)
+            };
+        }
+    }
+}
diff --git a/src/Bookings.Api/Swagger/RequiredAndExamplesSchemaFilter.cs b/src/Bookings.Api/Swagger/RequiredAndExamplesSchemaFilter.cs
