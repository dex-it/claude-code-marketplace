@@ -0,0 +1,64 @@
+using System.Reflection;
+using Bookings.Api.Auth;
+using Microsoft.OpenApi.Models;
+
+namespace Bookings.Api.Swagger;
+
+public static class SwaggerSetup
+{
+    public static IServiceCollection AddBookingsSwagger(this IServiceCollection services)
+    {
+        services.AddSwaggerGen(o =>
+        {
+            o.SwaggerDoc("v1", new OpenApiInfo
+            {
+                Title = "Bookings API",
+                Version = "1.2.0",
+                Description =
+                    "Сервис бронирования переговорных: комнаты, брони, перенос и отмена.\n\n" +
+                    "**Доступ.** Каждый запрос - с ключом доступа в заголовке `X-Api-Key`. Без ключа или с неизвестным ключом - 401, " +
+                    "для чужой брони без прав владельца или администратора - 403.\n\n" +
+                    "**Время.** Все моменты времени - UTC, формат ISO 8601 (`2026-11-03T09:00:00Z`).\n\n" +
+                    "**Ошибки.** Все ошибки - `application/problem+json`; поле `code` содержит стабильный машинный код ошибки, " +
+                    "по нему клиент выбирает поведение (поле `title` - текст для человека). Ошибки валидации (400) дополнительно содержат " +
+                    "`errors` - сообщения по полям.\n\n" +
+                    "**Повтор запроса.** `GET` и `DELETE` безопасно повторять. `DELETE` уже отменённой брони возвращает тот же 204. " +
+                    "`POST /api/v1/bookings` не идемпотентен: если ответ потерян, повтор того же запроса вернёт 409 `booking-overlap` " +
+                    "(комната занята вашей же бронью) - проверьте ленту броней, а не создавайте бронь заново. " +
+                    "`PATCH` защищён версией: повтор после успешного переноса вернёт 409 `version-conflict`.\n\n" +
+                    "**Постраничность.** Комнаты - `limit`/`offset` и `total`; брони - курсор: передайте `nextCursor` из ответа в `cursor` " +
+                    "следующего запроса, `nextCursor = null` - страниц больше нет. Курсор непрозрачен, не разбирайте его."
+            });
+
+            o.CustomOperationIds(api =>
+                $"{api.ActionDescriptor.RouteValues["controller"]}_{api.ActionDescriptor.RouteValues["action"]}");
+            o.SupportNonNullableReferenceTypes();
+            o.UseInlineDefinitionsForEnums();
+
+            o.AddSecurityDefinition(ApiKeyAuthenticationHandler.SchemeName, new OpenApiSecurityScheme
+            {
+                Type = SecuritySchemeType.ApiKey,
+                In = ParameterLocation.Header,
+                Name = ApiKeyAuthenticationHandler.HeaderName,
+                Description = "Ключ доступа участника или администратора."
+            });
+            o.AddSecurityRequirement(new OpenApiSecurityRequirement
+            {
+                [new OpenApiSecurityScheme
+                {
+                    Reference = new OpenApiReference
+                    {
+                        Type = ReferenceType.SecurityScheme,
+                        Id = ApiKeyAuthenticationHandler.SchemeName
+                    }
+                }] = []
+            });
+
+            o.IncludeXmlComments(Path.Combine(AppContext.BaseDirectory, $"{Assembly.GetExecutingAssembly().GetName().Name}.xml"));
+            o.SchemaFilter<RequiredAndExamplesSchemaFilter>();
+            o.OperationFilter<ErrorExamplesOperationFilter>();
+        });
+
+        return services;
+    }
+}
