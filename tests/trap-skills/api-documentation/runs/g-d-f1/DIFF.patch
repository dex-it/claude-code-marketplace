+++ b/src/Bookings.Api/Swagger/RequiredAndExamplesSchemaFilter.cs
@@ -0,0 +1,86 @@
+using Bookings.Api.Contracts;
+using Bookings.Api.Validation;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>
+/// Помечает обязательными непустые свойства (иначе сгенерированный клиент делает все поля nullable),
+/// добавляет ограничения из <see cref="BookingRules"/> и реалистичные примеры.
+/// </summary>
+public class RequiredAndExamplesSchemaFilter : ISchemaFilter
+{
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (schema.Type == "object" && schema.Properties.Count > 0 && context.Type.Namespace == typeof(BookingDto).Namespace)
+        {
+            foreach (var (name, property) in schema.Properties)
+            {
+                if (!property.Nullable)
+                    schema.Required.Add(name);
+            }
+        }
+
+        if (context.Type == typeof(CreateBookingRequest))
+        {
+            schema.Properties["title"].MaxLength = BookingRules.TitleMaxLength;
+            schema.Properties["comment"].MaxLength = BookingRules.CommentMaxLength;
+            ConstrainDuration(schema);
+            schema.Example = new OpenApiObject
+            {
+                ["roomId"] = new OpenApiString("room-301"),
+                ["title"] = new OpenApiString("Планирование спринта"),
+                ["startsAt"] = new OpenApiString("2026-11-03T09:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(60),
+                ["comment"] = new OpenApiString("Нужен проектор")
+            };
+        }
+        else if (context.Type == typeof(RescheduleBookingRequest))
+        {
+            ConstrainDuration(schema);
+            schema.Example = new OpenApiObject
+            {
+                ["startsAt"] = new OpenApiString("2026-11-03T10:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(45),
+                ["version"] = new OpenApiInteger(3)
+            };
+        }
+        else if (context.Type == typeof(BookingDto))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["id"] = new OpenApiString("3f2b8c1e-6a4d-4e0b-9b52-1d7f0c9a5e11"),
+                ["roomId"] = new OpenApiString("room-301"),
+                ["title"] = new OpenApiString("Планирование спринта"),
+                ["comment"] = new OpenApiString("Нужен проектор"),
+                ["startsAt"] = new OpenApiString("2026-11-03T09:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(60),
+                ["endsAt"] = new OpenApiString("2026-11-03T10:00:00Z"),
+                ["ownerId"] = new OpenApiString("user-17"),
+                ["status"] = new OpenApiString("active"),
+                ["version"] = new OpenApiInteger(3)
+            };
+        }
+        else if (context.Type == typeof(RoomDto))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["id"] = new OpenApiString("room-301"),
+                ["name"] = new OpenApiString("Байкал"),
+                ["capacity"] = new OpenApiInteger(12),
+                ["floor"] = new OpenApiInteger(3),
+                ["features"] = new OpenApiArray { new OpenApiString("projector"), new OpenApiString("whiteboard") }
+            };
+        }
+    }
+
+    private static void ConstrainDuration(OpenApiSchema schema)
+    {
+        var duration = schema.Properties["durationMinutes"];
+        duration.Minimum = BookingRules.MinDurationMinutes;
+        duration.Maximum = BookingRules.MaxDurationMinutes;
+        duration.MultipleOf = BookingRules.DurationStep;
+    }
+}
