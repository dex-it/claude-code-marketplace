new file mode 100644
index 0000000..269b959
--- /dev/null
+++ b/src/Bookings.Api/Documentation/ErrorResponseAttributes.cs
@@ -0,0 +1,18 @@
+namespace Bookings.Api.Documentation;
+
+/// <summary>Документирует ошибочный ответ операции (problem+json с полем <c>code</c>) вместе с примером.</summary>
+[AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
+public sealed class ErrorResponseAttribute(int status, string code, string title) : Attribute
+{
+    public int Status { get; } = status;
+    public string Code { get; } = code;
+    public string Title { get; } = title;
+}
+
+/// <summary>Документирует ответ 400 с ошибками проверки полей запроса вместе с примером.</summary>
+[AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
+public sealed class ValidationErrorResponseAttribute(string field, string message) : Attribute
+{
+    public string Field { get; } = field;
+    public string Message { get; } = message;
+}
diff --git a/src/Bookings.Api/Documentation/ErrorResponsesOperationFilter.cs b/src/Bookings.Api/Documentation/ErrorResponsesOperationFilter.cs
new file mode 100644
index 0000000..a944d97
--- /dev/null
+++ b/src/Bookings.Api/Documentation/ErrorResponsesOperationFilter.cs
@@ -0,0 +1,85 @@
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Documentation;
+
+/// <summary>
+/// Добавляет в операцию ошибочные ответы с примерами: <c>401</c> - у каждой операции (доступ только по ключу),
+/// остальные - по <see cref="ErrorResponseAttribute"/> и <see cref="ValidationErrorResponseAttribute"/>.
+/// </summary>
+public sealed class ErrorResponsesOperationFilter : IOperationFilter
+{
+    private const string ProblemJson = "application/problem+json";
+
+    private static readonly Dictionary<int, string> Descriptions = new()
+    {
+        [400] = "Запрос не прошёл проверку: в `errors` - поля и сообщения.",
+        [401] = "Нет ключа доступа или он неизвестен.",
+        [403] = "Недостаточно прав.",
+        [404] = "Объект не найден.",
+        [409] = "Конфликт с текущим состоянием."
+    };
+
+    public void Apply(OpenApiOperation operation, OperationFilterContext context)
+    {
+        var attributes = context.MethodInfo.GetCustomAttributes(inherit: true);
+        var validation = attributes.OfType<ValidationErrorResponseAttribute>().ToList();
+        var errors = attributes.OfType<ErrorResponseAttribute>().ToList();
+
+        var unauthorized = new Dictionary<string, OpenApiExample>
+        {
+            ["unauthorized"] = new() { Value = Problem(401, "unauthorized", "Нужен действующий ключ доступа.") }
+        };
+        SetResponse(operation, 401, ProblemSchema(context), unauthorized);
+
+        if (validation.Count > 0)
+        {
+            var schema = context.SchemaGenerator.GenerateSchema(typeof(ValidationProblemDetails), context.SchemaRepository);
+            var examples = new Dictionary<string, OpenApiExample>();
+            foreach (var v in validation)
+                examples[v.Field] = new OpenApiExample
+                {
+                    Value = new OpenApiObject
+                    {
+                        ["title"] = new OpenApiString("One or more validation errors occurred."),
+                        ["status"] = new OpenApiInteger(400),
+                        ["errors"] = new OpenApiObject
+                        {
+                            [v.Field] = new OpenApiArray { new OpenApiString(v.Message) }
+                        }
+                    }
+                };
+            SetResponse(operation, 400, schema, examples);
+        }
+
+        foreach (var group in errors.GroupBy(e => e.Status))
+        {
+            var examples = group.ToDictionary(e => e.Code, e => new OpenApiExample { Value = Problem(e.Status, e.Code, e.Title) });
+            SetResponse(operation, group.Key, ProblemSchema(context), examples);
+        }
+    }
+
+    private static OpenApiSchema ProblemSchema(OperationFilterContext context) =>
+        context.SchemaGenerator.GenerateSchema(typeof(ProblemDetails), context.SchemaRepository);
+
+    private static void SetResponse(OpenApiOperation operation, int status, OpenApiSchema schema, Dictionary<string, OpenApiExample> examples)
+    {
+        operation.Responses[status.ToString()] = new OpenApiResponse
+        {
+            Description = Descriptions[status],
+            Content =
+            {
+                [ProblemJson] = new OpenApiMediaType { Schema = schema, Examples = examples }
+            }
+        };
+    }
+
+    private static OpenApiObject Problem(int status, string code, string title) => new()
+    {
+        ["title"] = new OpenApiString(title),
+        ["status"] = new OpenApiInteger(status),
+        ["code"] = new OpenApiString(code)
+    };
+}
