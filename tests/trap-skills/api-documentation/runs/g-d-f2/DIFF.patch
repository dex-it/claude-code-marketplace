+++ b/src/Bookings.Api/Documentation/RequiredPropertiesSchemaFilter.cs
@@ -0,0 +1,22 @@
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Documentation;
+
+/// <summary>
+/// Свойство, не допускающее null, - обязательное: сгенерированный клиент не делает его необязательным.
+/// </summary>
+public sealed class RequiredPropertiesSchemaFilter : ISchemaFilter
+{
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (schema.Properties is not { Count: > 0 })
+            return;
+
+        foreach (var (name, property) in schema.Properties)
+        {
+            if (!property.Nullable && !property.ReadOnly)
+                schema.Required.Add(name);
+        }
+    }
+}
diff --git a/src/Bookings.Api/Documentation/SwaggerExtensions.cs b/src/Bookings.Api/Documentation/SwaggerExtensions.cs
new file mode 100644
index 0000000..1fa3094
--- /dev/null
+++ b/src/Bookings.Api/Documentation/SwaggerExtensions.cs
@@ -0,0 +1,78 @@
+using Bookings.Api.Auth;
+using Microsoft.OpenApi.Models;
+
+namespace Bookings.Api.Documentation;
+
+public static class SwaggerExtensions
+{
+    private const string Description = """
+        Сервис бронирования переговорных: комнаты, брони, перенос и отмена.
+
+        **Доступ.** Каждый запрос - с ключом доступа в заголовке `X-Api-Key`. Без ключа или с неизвестным
+        ключом - `401`. Ключ определяет участника и его роль: участник (`member`) или администратор (`admin`).
+
+        **Время.** Все моменты времени - UTC в формате ISO 8601 (`2026-11-03T09:00:00Z`). Смещение во входных
+        значениях допускается, сервис приводит его к UTC.
+
+        **Ошибки.** Ошибки - `application/problem+json`. Поле `code` - стабильный машинный код, по нему клиент
+        принимает решение; `title` - текст для человека и может меняться. Ошибки проверки полей (`400`) несут
+        словарь `errors`: поле - список сообщений.
+
+        **Страницы.** Комнаты - постранично `limit`/`offset` с общим числом `total`. Брони - лентой с курсором:
+        `nextCursor` из ответа передают в `cursor` следующего запроса; `null` - данных больше нет.
+        Курсор непрозрачен: его нельзя разбирать, составлять или сохранять надолго.
+
+        **Повтор запроса.** Что произойдёт при повторе после потерянного ответа, описано в каждой изменяющей
+        операции.
+
+        **Устаревшие операции** помечены `deprecated`; в описании - замена и срок удаления.
+        """;
+
+    public static IServiceCollection AddBookingsSwagger(this IServiceCollection services)
+    {
+        services.AddEndpointsApiExplorer();
+        services.AddSwaggerGen(c =>
+        {
+            c.SwaggerDoc("v1", new OpenApiInfo
+            {
+                Title = "Bookings API",
+                Version = "1.2.0",
+                Description = Description
+            });
+
+            var xml = Path.Combine(AppContext.BaseDirectory, $"{typeof(SwaggerExtensions).Assembly.GetName().Name}.xml");
+            if (File.Exists(xml))
+                c.IncludeXmlComments(xml);
+
+            c.SupportNonNullableReferenceTypes();
+
+            // uint (версия брони) не помещается в int32, который Swashbuckle назначает по умолчанию.
+            c.MapType<uint>(() => new OpenApiSchema { Type = "integer", Format = "int64" });
+
+            c.AddSecurityDefinition(ApiKeyAuthenticationHandler.SchemeName, new OpenApiSecurityScheme
+            {
+                Type = SecuritySchemeType.ApiKey,
+                In = ParameterLocation.Header,
+                Name = ApiKeyAuthenticationHandler.HeaderName,
+                Description = "Ключ доступа участника или администратора."
+            });
+            c.AddSecurityRequirement(new OpenApiSecurityRequirement
+            {
+                [new OpenApiSecurityScheme
+                {
+                    Reference = new OpenApiReference
+                    {
+                        Type = ReferenceType.SecurityScheme,
+                        Id = ApiKeyAuthenticationHandler.SchemeName
+                    }
+                }] = []
+            });
+
+            c.SchemaFilter<RequiredPropertiesSchemaFilter>();
+            c.SchemaFilter<ExamplesSchemaFilter>();
+            c.OperationFilter<ErrorResponsesOperationFilter>();
+        });
+
+        return services;
+    }
+}
