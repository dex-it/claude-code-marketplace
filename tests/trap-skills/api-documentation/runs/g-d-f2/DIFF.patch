+using Bookings.Api.Contracts;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Documentation;
+
+/// <summary>Реалистичные примеры в схемах моделей: клиент видит осмысленные значения, а не <c>"string"</c> и <c>0</c>.</summary>
+public sealed class ExamplesSchemaFilter : ISchemaFilter
+{
+    private const string BookingId = "3f8e6c1a-52b4-4d0e-9c2a-7a1d5b8e4f10";
+
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (context.Type == typeof(CreateBookingRequest))
+            schema.Example = new OpenApiObject
+            {
+                ["roomId"] = new OpenApiString("room-a1"),
+                ["title"] = new OpenApiString("Планирование спринта"),
+                ["startsAt"] = new OpenApiString("2026-11-03T09:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(60),
+                ["comment"] = new OpenApiString("Нужен проектор")
+            };
+        else if (context.Type == typeof(RescheduleBookingRequest))
+            schema.Example = new OpenApiObject
+            {
+                ["startsAt"] = new OpenApiString("2026-11-03T10:30:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(45),
+                ["version"] = new OpenApiLong(4821)
+            };
+        else if (context.Type == typeof(BookingDto))
+            schema.Example = BookingExample();
+        else if (context.Type == typeof(RoomDto))
+            schema.Example = RoomExample();
+        else if (context.Type == typeof(PageDto<RoomDto>))
+            schema.Example = new OpenApiObject
+            {
+                ["items"] = new OpenApiArray { RoomExample() },
+                ["total"] = new OpenApiInteger(3)
+            };
+        else if (context.Type == typeof(CursorPageDto<BookingDto>))
+            schema.Example = new OpenApiObject
+            {
+                ["items"] = new OpenApiArray { BookingExample() },
+                ["nextCursor"] = new OpenApiString("NjM5MDAwMDAwMDAwMDAwMDAwOjNmOGU2YzFhNTJiNDRkMGU5YzJhN2ExZDViOGU0ZjEw")
+            };
+        else if (context.Type == typeof(ProblemDetails))
+            schema.Properties["code"] = new OpenApiSchema
+            {
+                Type = "string",
+                Description = "Стабильный машинный код ошибки; у ошибок проверки полей (400) его нет.",
+                Nullable = true,
+                Example = new OpenApiString("booking-overlap")
+            };
+    }
+
+    private static OpenApiObject BookingExample() => new()
+    {
+        ["id"] = new OpenApiString(BookingId),
+        ["roomId"] = new OpenApiString("room-a1"),
+        ["title"] = new OpenApiString("Планирование спринта"),
+        ["comment"] = new OpenApiString("Нужен проектор"),
+        ["startsAt"] = new OpenApiString("2026-11-03T09:00:00Z"),
+        ["durationMinutes"] = new OpenApiInteger(60),
+        ["endsAt"] = new OpenApiString("2026-11-03T10:00:00Z"),
+        ["ownerId"] = new OpenApiString("alice"),
+        ["status"] = new OpenApiString("active"),
+        ["version"] = new OpenApiLong(4821)
+    };
+
+    private static OpenApiObject RoomExample() => new()
+    {
+        ["id"] = new OpenApiString("room-a1"),
+        ["name"] = new OpenApiString("Байкал"),
+        ["capacity"] = new OpenApiInteger(8),
+        ["floor"] = new OpenApiInteger(2),
+        ["features"] = new OpenApiArray { new OpenApiString("projector"), new OpenApiString("whiteboard") }
+    };
+}
