@@ -0,0 +1,98 @@
+using Bookings.Api.Auth;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+public static class SwaggerConfiguration
+{
+    public const string Version = "1.2.0";
+
+    public static void Configure(SwaggerGenOptions options)
+    {
+        options.SwaggerDoc("v1", new OpenApiInfo
+        {
+            Title = "Bookings API",
+            Version = Version,
+            Description =
+                "Сервис бронирования переговорных: комнаты, брони, перенос и отмена.\n\n" +
+                "**Доступ.** Каждый запрос выполняется с ключом доступа в заголовке `X-Api-Key`. " +
+                "Без ключа или с неизвестным ключом сервис отвечает 401.\n\n" +
+                "**Время.** Все моменты времени - UTC, формат ISO 8601.\n\n" +
+                "**Ошибки.** Ошибки возвращаются как `application/problem+json`. В поле `code` - стабильный " +
+                "машиночитаемый код (`room-not-found`, `booking-not-found`, `booking-overlap`, `version-conflict`, " +
+                "`booking-cancelled`, `not-owner`, `unauthorized`, `forbidden`); клиенту следует опираться на него, а не на `title`. " +
+                "Ошибки проверки данных (400) содержат `errors` - сообщения по полям запроса.",
+        });
+
+        options.SupportNonNullableReferenceTypes();
+        options.UseAllOfToExtendReferenceSchemas();
+        options.MapType<uint>(() => new OpenApiSchema { Type = "integer", Format = "int64", Minimum = 0 });
+        options.CustomOperationIds(api =>
+            api.ActionDescriptor.RouteValues.TryGetValue("controller", out var controller)
+            && api.ActionDescriptor.RouteValues.TryGetValue("action", out var action)
+                ? $"{controller}_{action}"
+                : null);
+
+        options.AddSecurityDefinition(ApiKeyAuthenticationHandler.SchemeName, new OpenApiSecurityScheme
+        {
+            Type = SecuritySchemeType.ApiKey,
+            In = ParameterLocation.Header,
+            Name = ApiKeyAuthenticationHandler.HeaderName,
+            Description = "Ключ доступа участника или администратора.",
+        });
+        options.AddSecurityRequirement(new OpenApiSecurityRequirement
+        {
+            [new OpenApiSecurityScheme
+            {
+                Reference = new OpenApiReference { Type = ReferenceType.SecurityScheme, Id = ApiKeyAuthenticationHandler.SchemeName },
+            }] = [],
+        });
+
+        var xml = Path.Combine(AppContext.BaseDirectory, $"{typeof(SwaggerConfiguration).Assembly.GetName().Name}.xml");
+        if (File.Exists(xml))
