+namespace Bookings.Api.Swagger;
+
+/// <summary>Пример ошибки problem+json для документации Swagger; на поведение API не влияет.</summary>
+[AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
+public sealed class ProblemExampleAttribute(int status, string code, string title) : Attribute
+{
+    public int Status { get; } = status;
+    public string Code { get; } = code;
+    public string Title { get; } = title;
+}
