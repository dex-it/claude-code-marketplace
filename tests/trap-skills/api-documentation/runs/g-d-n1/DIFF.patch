--- /dev/null
+++ b/src/Bookings.Api/Swagger/ProblemExamplesOperationFilter.cs
@@ -0,0 +1,59 @@
+using Microsoft.AspNetCore.Mvc.Controllers;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>Кладёт в ошибочные ответы операции примеры problem+json: по <see cref="ProblemExampleAttribute"/> и общие 400/401.</summary>
+public class ProblemExamplesOperationFilter : IOperationFilter
+{
+    public void Apply(OpenApiOperation operation, OperationFilterContext context)
+    {
+        var examples = context.ApiDescription.ActionDescriptor is ControllerActionDescriptor action
+            ? action.MethodInfo.GetCustomAttributes(typeof(ProblemExampleAttribute), false).Cast<ProblemExampleAttribute>().ToList()
+            : [];
+
+        foreach (var (statusText, response) in operation.Responses)
+        {
+            if (!int.TryParse(statusText, out var status) || status < 400)
+                continue;
+
+            foreach (var media in response.Content.Values)
+                media.Example = Example(status, examples) ?? media.Example;
+        }
+    }
+
+    private static IOpenApiAny? Example(int status, List<ProblemExampleAttribute> examples)
+    {
+        var declared = examples.FirstOrDefault(e => e.Status == status);
+        if (declared is not null)
+            return Problem(status, declared.Title, declared.Code);
+
+        return status switch
+        {
+            400 => new OpenApiObject
+            {
+                ["type"] = new OpenApiString("https://tools.ietf.org/html/rfc9110#section-15.5.1"),
+                ["title"] = new OpenApiString("One or more validation errors occurred."),
+                ["status"] = new OpenApiInteger(400),
+                ["errors"] = new OpenApiObject
+                {
+                    ["durationMinutes"] = new OpenApiArray
+                    {
+                        new OpenApiString("Длительность - от 15 до 240 минут, кратно 15.")
+                    }
+                }
+            },
+            401 => Problem(401, "Нужен действующий ключ доступа.", "unauthorized"),
+            _ => null
+        };
+    }
+
+    private static OpenApiObject Problem(int status, string title, string code) => new()
+    {
+        ["status"] = new OpenApiInteger(status),
+        ["title"] = new OpenApiString(title),
+        ["code"] = new OpenApiString(code)
+    };
+}
