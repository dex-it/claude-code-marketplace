new file mode 100644
index 0000000..54055b3
--- /dev/null
+++ b/src/Bookings.Api/Swagger/ExampleSchemaFilter.cs
@@ -0,0 +1,129 @@
+using Bookings.Api.Contracts;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>Реалистичные примеры и ограничения значений для схем запросов и ответов (по FR-01, FR-03, FR-05, FR-08).</summary>
+public class ExampleSchemaFilter : ISchemaFilter
+{
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        var type = context.Type;
+
+        // Свойства без null в контракте обязательны: иначе сгенерированный клиент сделает все поля nullable.
+        if (type.Namespace == typeof(BookingDto).Namespace)
+            schema.Required = schema.Properties.Where(p => !p.Value.Nullable).Select(p => p.Key).ToHashSet();
+
+        if (type == typeof(ProblemDetails) || type == typeof(ValidationProblemDetails))
+        {
+            schema.Description = "Ошибка в формате problem+json (RFC 9457).";
+            Describe(schema, "type", "Адрес типа ошибки.");
+            Describe(schema, "title", "Краткое описание ошибки.");
+            Describe(schema, "status", "HTTP-статус ответа.");
+            Describe(schema, "detail", "Подробности; бывают не всегда.");
+            Describe(schema, "instance", "Адрес запроса, вызвавшего ошибку; бывает не всегда.");
+            Describe(schema, "errors", "Сообщения об ошибках по полям запроса: имя поля - список сообщений.");
+            schema.Properties["code"] = new OpenApiSchema
+            {
+                Type = "string",
+                Nullable = true,
+                Description = "Машинный код ошибки, например booking-overlap, version-conflict, not-owner, room-not-found, booking-not-found; "
+                    + "для ошибок валидации (400) отсутствует. Клиент выбирает поведение по коду, а не по тексту."
+            };
+        }
+
+        if (type == typeof(CreateBookingRequest))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["roomId"] = new OpenApiString("room-a1"),
+                ["title"] = new OpenApiString("Планирование спринта"),
+                ["startsAt"] = new OpenApiString("2026-10-20T09:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(60),
+                ["comment"] = new OpenApiString("Нужен проектор")
+            };
+            Limit(schema, "title", minLength: 1, maxLength: 120);
+            Limit(schema, "comment", maxLength: 500);
+            Limit(schema, "durationMinutes", minimum: 15, maximum: 240, multipleOf: 15);
+        }
+        else if (type == typeof(RescheduleBookingRequest))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["startsAt"] = new OpenApiString("2026-10-20T10:00:00Z"),
+                ["durationMinutes"] = new OpenApiInteger(45),
+                ["version"] = new OpenApiLong(3)
+            };
+            Limit(schema, "durationMinutes", minimum: 15, maximum: 240, multipleOf: 15);
+        }
+        else if (type == typeof(BookingDto))
+        {
+            schema.Example = Booking();
+        }
+        else if (type == typeof(RoomDto))
+        {
+            schema.Example = Room();
+        }
+        else if (type == typeof(PageDto<RoomDto>))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["items"] = new OpenApiArray { Room() },
+                ["total"] = new OpenApiInteger(1)
+            };
+        }
+        else if (type == typeof(CursorPageDto<BookingDto>))
+        {
+            schema.Example = new OpenApiObject
+            {
+                ["items"] = new OpenApiArray { Booking() },
+                ["nextCursor"] = new OpenApiString("NjM4OTk4NzY1NDMyMTAwMDAwOjNmYTg1ZjY0NTcxNzQ1NjJiM2ZjMmM5NjNmNjZhZmE2")
+            };
+        }
+    }
+
+    private static OpenApiObject Booking() => new()
+    {
+        ["id"] = new OpenApiString("3fa85f64-5717-4562-b3fc-2c963f66afa6"),
+        ["roomId"] = new OpenApiString("room-a1"),
+        ["title"] = new OpenApiString("Планирование спринта"),
+        ["comment"] = new OpenApiString("Нужен проектор"),
+        ["startsAt"] = new OpenApiString("2026-10-20T09:00:00Z"),
+        ["durationMinutes"] = new OpenApiInteger(60),
+        ["endsAt"] = new OpenApiString("2026-10-20T10:00:00Z"),
+        ["ownerId"] = new OpenApiString("alice"),
+        ["status"] = new OpenApiString("active"),
+        ["version"] = new OpenApiLong(1)
+    };
+
+    private static OpenApiObject Room() => new()
+    {
+        ["id"] = new OpenApiString("room-a1"),
+        ["name"] = new OpenApiString("Альфа"),
+        ["capacity"] = new OpenApiInteger(8),
+        ["floor"] = new OpenApiInteger(2),
+        ["features"] = new OpenApiArray { new OpenApiString("projector"), new OpenApiString("whiteboard") }
+    };
+
+    private static void Describe(OpenApiSchema schema, string property, string description)
+    {
+        if (schema.Properties.TryGetValue(property, out var p))
+            p.Description = description;
+    }
+
+    private static void Limit(OpenApiSchema schema, string property, int? minLength = null, int? maxLength = null,
+        int? minimum = null, int? maximum = null, int? multipleOf = null)
+    {
+        if (!schema.Properties.TryGetValue(property, out var p))
+            return;
+
+        p.MinLength = minLength;
+        p.MaxLength = maxLength;
+        p.Minimum = minimum;
+        p.Maximum = maximum;
+        p.MultipleOf = multipleOf;
+    }
+}
