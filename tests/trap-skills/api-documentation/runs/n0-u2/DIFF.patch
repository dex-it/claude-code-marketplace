index 0000000..539915d
--- /dev/null
+++ b/tests/Bookings.Api.Tests/BookingRulesDurationTests.cs
@@ -0,0 +1,22 @@
+using Bookings.Api.Validation;
+using Xunit;
+
+namespace Bookings.Api.Tests;
+
+public class BookingRulesDurationTests
+{
+    [Theory]
+    [InlineData(15)]
+    [InlineData(225)]
+    [InlineData(240)]
+    public void Duration_within_FR08_is_valid(int minutes) =>
+        Assert.True(BookingRules.IsValidDuration(minutes));
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(10)]
+    [InlineData(250)]
+    [InlineData(255)]
+    public void Duration_outside_FR08_or_not_multiple_of_step_is_invalid(int minutes) =>
+        Assert.False(BookingRules.IsValidDuration(minutes));
+}
