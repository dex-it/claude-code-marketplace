@@ -0,0 +1,56 @@
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>Подставляет примеры из <see cref="SchemaExampleAttribute"/> и помечает обязательные поля.</summary>
+public class SchemaDocumentationFilter : ISchemaFilter
+{
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        if (context.MemberInfo?.GetCustomAttributes(typeof(SchemaExampleAttribute), true).FirstOrDefault() is SchemaExampleAttribute example)
+        {
+            schema.Example = example.Value switch
+            {
+                int i => new OpenApiInteger(i),
+                bool b => new OpenApiBoolean(b),
+                string s => new OpenApiString(s),
+                _ => schema.Example
+            };
+        }
+
+        // NSwag строит non-nullable поля только для required: ненулевые свойства всегда присутствуют.
+        if (schema.Type == "object" && schema.Properties is { Count: > 0 })
+        {
+            foreach (var (name, property) in schema.Properties)
+            {
+                if (!property.Nullable)
+                    schema.Required.Add(name);
+            }
+        }
+    }
+}
+
+/// <summary>Добавляет примеры ошибочных ответов из <see cref="ProblemExampleAttribute"/>.</summary>
+public class ProblemExampleOperationFilter : IOperationFilter
+{
+    public void Apply(OpenApiOperation operation, OperationFilterContext context)
+    {
+        var examples = context.MethodInfo.GetCustomAttributes(typeof(ProblemExampleAttribute), false).Cast<ProblemExampleAttribute>();
+        foreach (var example in examples)
+        {
+            if (!operation.Responses.TryGetValue(example.Status.ToString(), out var response)
+                || !response.Content.TryGetValue("application/problem+json", out var media))
+                continue;
+
+            media.Example = new OpenApiObject
+            {
+                ["type"] = new OpenApiString("about:blank"),
+                ["title"] = new OpenApiString(example.Title),
+                ["status"] = new OpenApiInteger(example.Status),
+                ["code"] = new OpenApiString(example.Code)
+            };
+        }
+    }
+}
