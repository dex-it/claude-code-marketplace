+        [(typeof(CreateBookingRequest), "startsAt")] = ("Начало брони: в будущем, не позже чем через 90 дней; передаётся со смещением, хранится в UTC.", new OpenApiString("2026-10-20T09:00:00Z")),
+        [(typeof(CreateBookingRequest), "durationMinutes")] = ("Длительность в минутах: от 15 до 240, кратно 15.", new OpenApiInteger(60)),
+        [(typeof(CreateBookingRequest), "comment")] = ("Необязательный комментарий, до 500 символов.", new OpenApiString("Нужен проектор")),
+
+        [(typeof(RescheduleBookingRequest), "startsAt")] = ("Новое начало брони: в будущем, не позже чем через 90 дней.", new OpenApiString("2026-10-21T14:00:00Z")),
+        [(typeof(RescheduleBookingRequest), "durationMinutes")] = ("Новая длительность в минутах: от 15 до 240, кратно 15.", new OpenApiInteger(30)),
+        [(typeof(RescheduleBookingRequest), "version")] = ("Версия брони, полученная при последнем чтении (поле version брони).", new OpenApiInteger(1042)),
+
+        [(typeof(RoomDto), "id")] = ("Идентификатор комнаты.", new OpenApiString("room-a")),
+        [(typeof(RoomDto), "name")] = ("Название комнаты.", new OpenApiString("Байкал")),
+        [(typeof(RoomDto), "capacity")] = ("Вместимость, человек (1-50).", new OpenApiInteger(12)),
+        [(typeof(RoomDto), "floor")] = ("Этаж.", new OpenApiInteger(3)),
+        [(typeof(RoomDto), "features")] = ("Оснащение комнаты.", new OpenApiArray { new OpenApiString("projector"), new OpenApiString("whiteboard") }),
