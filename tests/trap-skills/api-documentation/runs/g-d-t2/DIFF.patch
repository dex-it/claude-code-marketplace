+        [(typeof(BookingDto), "version")] = ("Версия брони; при переносе передаётся обратно как есть (оптимистичная блокировка).", new OpenApiInteger(1042)),
+
+        [(typeof(CreateBookingRequest), "roomId")] = ("Идентификатор существующей комнаты.", new OpenApiString("room-a")),
