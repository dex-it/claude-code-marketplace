+
+    public void Apply(OpenApiSchema schema, SchemaFilterContext context)
+    {
+        var type = context.Type;
+        if (type == typeof(ProblemDetails) || type == typeof(ValidationProblemDetails))
+        {
+            schema.Properties["code"] = new OpenApiSchema
+            {
+                Type = "string",
+                Description = "Машиночитаемый код ошибки (стабилен): room-not-found, booking-not-found, not-owner, "
+                    + "booking-overlap, version-conflict, booking-cancelled, validation-failed, unauthorized, forbidden.",
+                Example = new OpenApiString("booking-not-found")
+            };
+            return;
+        }
+
+        if (type.IsGenericType)
+            ApplyPage(schema, type.GetGenericTypeDefinition());
+
+        if (type.Namespace != typeof(BookingDto).Namespace || schema.Properties.Count == 0)
+            return;
+
+        var isRequest = type.Name.EndsWith("Request", StringComparison.Ordinal);
+        foreach (var (name, property) in schema.Properties)
+        {
+            // Ответы сериализуют все поля (null отдаётся явно); в запросе обязательны только не-nullable.
+            if (!isRequest || !property.Nullable)
+                schema.Required.Add(name);
+
+            if (Fields.TryGetValue((type, name), out var field))
+            {
+                property.Description = field.Description;
+                property.Example = field.Example;
+            }
+        }
+
+        if (type == typeof(CreateBookingRequest))
+        {
+            schema.Properties["title"].MinLength = 1;
+            schema.Properties["title"].MaxLength = BookingRules.TitleMaxLength;
+            schema.Properties["comment"].MaxLength = BookingRules.CommentMaxLength;
+        }
+
+        if (type == typeof(CreateBookingRequest) || type == typeof(RescheduleBookingRequest))
+        {
+            schema.Properties["durationMinutes"].Minimum = BookingRules.MinDurationMinutes;
+            schema.Properties["durationMinutes"].Maximum = BookingRules.MaxDurationMinutes;
+            schema.Properties["durationMinutes"].MultipleOf = BookingRules.DurationStep;
+        }
+    }
+
+    private static void ApplyPage(OpenApiSchema schema, Type definition)
+    {
+        if (definition == typeof(PageDto<>))
+        {
+            schema.Description = "Страница списка с позиционной пагинацией (limit/offset).";
+            schema.Properties["items"].Description = "Элементы страницы.";
+            schema.Properties["total"].Description = "Общее число элементов во всём списке.";
+            schema.Properties["total"].Example = new OpenApiInteger(3);
+        }
+        else if (definition == typeof(CursorPageDto<>))
+        {
+            schema.Description = "Страница ленты с курсорной пагинацией.";
+            schema.Properties["items"].Description = "Элементы страницы.";
+            schema.Properties["nextCursor"].Description =
+                "Непрозрачный курсор следующей страницы; передаётся в параметр cursor без изменений. null - страница последняя.";
+            schema.Properties["nextCursor"].Example = new OpenApiString("NjM5MDAwMDAwMDAwMDAwMDAwOjNmMmI4YzFlNWQ0YTRlN2I5YTYxMGM4ZjJkN2U0YjE1");
+        }
+    }
+}
