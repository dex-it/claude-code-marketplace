+using Microsoft.AspNetCore.Mvc;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>
+/// Ошибочный ответ операции в формате problem+json: попадает в swagger.json со схемой и примером тела.
+/// </summary>
+[AttributeUsage(AttributeTargets.Method, AllowMultiple = true)]
+public sealed class ProblemResponseAttribute(int statusCode, string code, string title)
+    : ProducesResponseTypeAttribute(typeof(ProblemDetails), statusCode, "application/problem+json")
+{
+    /// <summary>Значение поля <c>code</c> в теле ошибки.</summary>
+    public string Code { get; } = code;
+
+    /// <summary>Значение поля <c>title</c> в теле ошибки.</summary>
+    public string Title { get; } = title;
+}
+
+/// <summary>
+/// Ответ 400 с ошибками валидации (поле <c>errors</c>); пример построен на одном поле.
+/// </summary>
+[AttributeUsage(AttributeTargets.Method)]
+public sealed class ValidationProblemResponseAttribute(string field, string message)
+    : ProducesResponseTypeAttribute(typeof(ValidationProblemDetails), StatusCodes.Status400BadRequest, "application/problem+json")
+{
+    /// <summary>Поле, на котором построен пример.</summary>
+    public string Field { get; } = field;
+
+    /// <summary>Текст ошибки в примере.</summary>
+    public string Message { get; } = message;
+}
