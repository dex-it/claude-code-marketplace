diff --git a/src/Bookings.Api/Swagger/ContractOperationFilter.cs b/src/Bookings.Api/Swagger/ContractOperationFilter.cs
new file mode 100644
index 0000000..b8f5775
--- /dev/null
+++ b/src/Bookings.Api/Swagger/ContractOperationFilter.cs
@@ -0,0 +1,63 @@
+using Bookings.Api.Controllers;
+using Microsoft.OpenApi.Any;
+using Microsoft.OpenApi.Models;
+using Swashbuckle.AspNetCore.SwaggerGen;
+
+namespace Bookings.Api.Swagger;
+
+/// <summary>
+/// Примеры тел ошибок, ответ 401 для каждой операции, границы <c>limit</c>.
+/// </summary>
+public class ContractOperationFilter : IOperationFilter
+{
+    public void Apply(OpenApiOperation operation, OperationFilterContext context)
+    {
+        foreach (var attribute in context.MethodInfo.GetCustomAttributes(typeof(ProblemResponseAttribute), inherit: false).Cast<ProblemResponseAttribute>())
+            SetProblemExample(operation, attribute.StatusCode, attribute.Code, attribute.Title);
+
+        foreach (var attribute in context.MethodInfo.GetCustomAttributes(typeof(ValidationProblemResponseAttribute), inherit: false).Cast<ValidationProblemResponseAttribute>())
+            SetProblemExample(operation, 400, "validation-failed", "One or more validation errors occurred.", attribute.Field, attribute.Message);
+
+        if (!operation.Responses.ContainsKey("401"))
+        {
+            operation.Responses["401"] = new OpenApiResponse
+            {
+                Description = "Ключ доступа не передан или недействителен.",
+                Content = { ["application/problem+json"] = new OpenApiMediaType { Schema = ProblemSchema() } }
+            };
+            SetProblemExample(operation, 401, "unauthorized", "Нужен действующий ключ доступа.");
+        }
+
+        foreach (var parameter in operation.Parameters.Where(p => p.Name == "limit"))
+        {
+            parameter.Schema.Minimum = 1;
+            parameter.Schema.Maximum = context.MethodInfo.DeclaringType == typeof(BookingsController)
+                ? BookingsController.MaxLimit
+                : RoomsController.MaxLimit;
+        }
+    }
+
+    private static OpenApiSchema ProblemSchema() =>
+        new() { Reference = new OpenApiReference { Type = ReferenceType.Schema, Id = "ProblemDetails" } };
+
+    private static void SetProblemExample(
+        OpenApiOperation operation, int status, string code, string title, string? field = null, string? message = null)
+    {
+        if (!operation.Responses.TryGetValue(status.ToString(), out var response)
+            || !response.Content.TryGetValue("application/problem+json", out var media))
+            return;
+
+        var example = new OpenApiObject
+        {
+            ["title"] = new OpenApiString(title),
+            ["status"] = new OpenApiInteger(status),
+            ["code"] = new OpenApiString(code),
+            ["traceId"] = new OpenApiString("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00"),
+        };
+
+        if (field is not null)
+            example["errors"] = new OpenApiObject { [field] = new OpenApiArray { new OpenApiString(message) } };
+
+        media.Example = example;
+    }
+}
