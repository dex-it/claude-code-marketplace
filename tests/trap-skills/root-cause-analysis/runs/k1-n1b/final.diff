diff --git a/test/parcel.test.js b/test/parcel.test.js
index 554fcdf..afdc35c 100644
--- a/test/parcel.test.js
+++ b/test/parcel.test.js
@@ -27,3 +27,14 @@ test('расчётный вес - вверх до 0,5 кг', () => {
 test('неизвестный формат - 400', () => {
   assert.throws(() => parseWeight('1.5lb'), { status: 400 });
 });
+
+test('вес строкой без единицы с запятой - килограммы (виджет партнёра)', () => {
+  assert.equal(parseWeight('1,5'), 1500);
+  assert.equal(parseWeight('2,3'), 2300);
+});
+
+test('вес не число - 400', () => {
+  assert.throws(() => parseWeight('abc1'), { status: 400 });
+  assert.throws(() => parseWeight('1.2.3'), { status: 400 });
+  assert.throws(() => parseWeight(NaN), { status: 400 });
+});
