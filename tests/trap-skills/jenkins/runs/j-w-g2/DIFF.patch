diff --git a/Jenkinsfile b/Jenkinsfile
new file mode 100644
index 0000000..010b712
--- /dev/null
+++ b/Jenkinsfile
@@ -0,0 +1,174 @@
+@Library('depot-pipeline-lib@v1.4.0') _
+
+pipeline {
+    // Агент задаётся на стадиях: ожидание подтверждения prod не должно держать executor
+    agent none
+
+    options {
+        timestamps()
+        buildDiscarder(logRotator(numToKeepStr: '30'))
+        // Лимит времени ставится на стадиях, а не на весь пайплайн: лид подтверждает prod до нескольких дней
+    }
+
+    environment {
+        IMAGE = 'registry.example.com/depot/api'
+        DOTNET_NOLOGO = '1'
+        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
+    }
+
+    stages {
+        // Одна стадия с одним агентом: сборка, тесты и образ работают в одном workspace
+        stage('CI') {
+            agent { label 'dotnet-linux' }
+            options { timeout(time: 60, unit: 'MINUTES') }
+            stages {
+                stage('Сборка') {
+                    steps {
+                        sh 'dotnet restore Depot.sln'
+                        sh 'dotnet build Depot.sln -c Release --no-restore'
+                    }
+                }
+
+                stage('Проверки') {
+                    failFast true
+                    parallel {
+                        stage('Unit-тесты') {
+                            steps {
+                                sh '''dotnet test Depot.sln -c Release --no-build \
+                                    --filter "Category!=Integration" \
+                                    --logger "trx;LogFileName=unit.trx" \
+                                    --results-directory TestResults/unit'''
+                            }
+                            post {
+                                always { mstest testResultsFile: 'TestResults/unit/*.trx', failOnError: false }
+                            }
+                        }
+                        stage('Integration-тесты') {
+                            steps {
+                                // Postgres поднимает Testcontainers через Docker агента
+                                sh '''dotnet test Depot.sln -c Release --no-build \
+                                    --filter "Category=Integration" \
+                                    --logger "trx;LogFileName=integration.trx" \
+                                    --results-directory TestResults/integration'''
+                            }
+                            post {
+                                always { mstest testResultsFile: 'TestResults/integration/*.trx', failOnError: false }
+                            }
+                        }
+                        stage('Статический анализ') {
+                            steps {
+                                sh 'dotnet format Depot.sln --verify-no-changes --no-restore'
+                            }
+                        }
+                        stage('Аудит зависимостей') {
+                            steps {
+                                sh '''dotnet list Depot.sln package --vulnerable --include-transitive 2>&1 | tee audit.txt
+                                    if grep -q "has the following vulnerable packages" audit.txt; then
+                                        echo "Найдены уязвимые зависимости"
+                                        exit 1
+                                    fi'''
+                            }
+                        }
+                    }
+                }
+
+                stage('Образ') {
+                    steps {
+                        script {
+                            // Теги нужны локально; versionsort.suffix=- ставит пререлиз (v1.5.0-rc1) ниже релиза (v1.5.0)
+                            sh 'git fetch --tags --force'
+                            def version = sh(
+                                script: "git -c versionsort.suffix=- tag --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | head -n 1",
+                                returnStdout: true
+                            ).trim()
+                            if (!version) {
+                                error 'В репозитории нет семвер-тегов vX.Y.Z'
+                            }
+                            env.IMAGE_TAG = "${version}-${env.BUILD_NUMBER}"
+                        }
+                        sh 'docker build -t "$IMAGE:$IMAGE_TAG" .'
+                    }
+                }
+
+                // Секреты registry не отдаём PR (в том числе из форков): пуш только из main
+                stage('Push') {
+                    when {
+                        beforeAgent true
+                        branch 'main'
+                    }
+                    steps {
+                        withCredentials([usernamePassword(credentialsId: 'registry-creds',
+                                                          usernameVariable: 'REGISTRY_USER',
+                                                          passwordVariable: 'REGISTRY_PASS')]) {
+                            // Отдельный DOCKER_CONFIG: логин не остаётся на постоянном агенте
+                            withEnv(["DOCKER_CONFIG=${env.WORKSPACE}@tmp/docker-config"]) {
+                                sh '''mkdir -p "$DOCKER_CONFIG"
+                                    trap 'docker logout registry.example.com; rm -rf "$DOCKER_CONFIG"' EXIT
+                                    echo "$REGISTRY_PASS" | docker login registry.example.com -u "$REGISTRY_USER" --password-stdin
+                                    docker push "$IMAGE:$IMAGE_TAG"'''
+                            }
+                        }
+                    }
+                }
+
+                stage('Деплой на stage') {
+                    when {
+                        beforeAgent true
+                        branch 'main'
+                    }
+                    steps {
+                        withCredentials([string(credentialsId: 'deploy-token', variable: 'DEPLOY_TOKEN')]) {
+                            // Одинарные кавычки: токен подставляет shell, а не Groovy
+                            sh './deploy.sh --token "$DEPLOY_TOKEN" --env stage'
+                        }
+                    }
+                }
+            }
+            post {
+                always {
+                    sh 'docker rmi "$IMAGE:$IMAGE_TAG" || true'
+                    cleanWs()
+                }
+            }
+        }
+
+        // Ожидание без агента: executor не занят, пока лид не ответит
+        stage('Подтверждение prod') {
+            when {
+                beforeInput true
+                branch 'main'
+            }
+            options { timeout(time: 3, unit: 'DAYS') }
+            input {
+                message 'Деплоить в prod?'
+                ok 'Деплоить'
+            }
+            steps {
+                echo "Prod подтверждён: ${env.IMAGE}:${env.IMAGE_TAG}"
+            }
+        }
+
+        stage('Деплой на prod') {
+            when {
+                beforeAgent true
+                branch 'main'
+            }
+            agent { label 'dotnet-linux' }
+            options { timeout(time: 30, unit: 'MINUTES') }
+            steps {
+                withCredentials([string(credentialsId: 'deploy-token', variable: 'DEPLOY_TOKEN')]) {
+                    sh './deploy.sh --token "$DEPLOY_TOKEN" --env prod'
+                }
+            }
+            post {
+                always { cleanWs() }
+            }
+        }
+    }
+
+    post {
+        always {
+            notifySlack(currentBuild.currentResult)
+        }
+    }
+}
