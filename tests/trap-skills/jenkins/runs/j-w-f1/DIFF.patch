diff --git a/Jenkinsfile b/Jenkinsfile
new file mode 100644
index 0000000..5ef1932
--- /dev/null
+++ b/Jenkinsfile
@@ -0,0 +1,188 @@
+// Multibranch-job на GitHub, PR из форков собираются тоже.
+// Секреты (registry-creds, deploy-token) подключаются только в стадиях push и deploy, которые идут лишь на main,
+// поэтому сборка PR до них не доходит.
+@Library('depot-pipeline-lib@v1.4.0') _
+
+pipeline {
+    // Агента на весь пайплайн нет: на время ожидания подтверждения prod нода не должна быть занята.
+    agent none
+
+    options {
+        buildDiscarder(logRotator(numToKeepStr: '30'))
+        timestamps()
+    }
+
+    environment {
+        IMAGE_REPO = 'registry.example.com/depot/api'
+        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
+        DOTNET_NOLOGO = '1'
+    }
+
+    stages {
+        stage('CI') {
+            agent { label 'dotnet-linux' }
+            options { timeout(time: 60, unit: 'MINUTES') }
+            stages {
+                stage('Сборка') {
+                    steps {
+                        sh '''
+                            dotnet restore Depot.sln
+                            dotnet build Depot.sln -c Release --no-restore
+                        '''
+                    }
+                }
+
+                stage('Статический анализ') {
+                    steps {
+                        sh 'dotnet format Depot.sln --verify-no-changes --no-restore'
+                    }
+                }
+
+                stage('Аудит зависимостей') {
+                    steps {
+                        // dotnet list всегда завершается с 0, поэтому ищем уязвимости в отчёте
+                        sh '''#!/bin/bash
+                            set -euo pipefail
+                            dotnet list Depot.sln package --vulnerable --include-transitive > audit.txt 2>&1
+                            cat audit.txt
+                            if grep -q 'has the following vulnerable packages' audit.txt; then
+                                echo 'Найдены уязвимые зависимости' >&2
+                                exit 1
+                            fi
+                        '''
+                    }
+                }
+
+                stage('Тесты') {
+                    failFast true
+                    parallel {
+                        stage('Unit') {
+                            steps {
+                                sh '''
+                                    dotnet test Depot.sln -c Release --no-restore --no-build \
+                                        --filter "Category=Contracts" \
+                                        --logger "trx;LogFileName=unit.trx" \
+                                        --results-directory test-results/unit
+                                '''
+                            }
+                            post {
+                                always {
+                                    xunit(tools: [MSTest(pattern: 'test-results/unit/*.trx', skipNoTestFiles: true, failIfNotNew: false)])
+                                }
+                            }
+                        }
+                        stage('Integration') {
+                            // Testcontainers сам поднимает Postgres через Docker агента
+                            steps {
+                                sh '''
+                                    dotnet test Depot.sln -c Release --no-restore --no-build \
+                                        --filter "Category=Integration" \
+                                        --logger "trx;LogFileName=integration.trx" \
+                                        --results-directory test-results/integration
+                                '''
+                            }
+                            post {
+                                always {
+                                    xunit(tools: [MSTest(pattern: 'test-results/integration/*.trx', skipNoTestFiles: true, failIfNotNew: false)])
+                                }
+                            }
+                        }
+                    }
+                }
+
+                stage('Образ') {
+                    steps {
+                        script {
+                            // наибольший семвер-тег (sort -V, а не алфавит); пререлизы вроде v1.5.0-rc1 не учитываем
+                            def tag = sh(returnStdout: true, script: '''#!/bin/bash
+                                set -euo pipefail
+                                git fetch --tags --force --quiet origin
+                                git tag --list 'v*' | grep -E '^v[0-9]+\\.[0-9]+\\.[0-9]+$' | sort -V | tail -n 1
+                            ''').trim()
+                            if (!tag) {
+                                error 'В репозитории нет семвер-тегов vX.Y.Z'
+                            }
+                            env.IMAGE_TAG = "${tag}-${env.BUILD_NUMBER}"
+                        }
+                        sh 'docker build -t "$IMAGE_REPO:$IMAGE_TAG" .'
+                    }
+                }
+
+                stage('Push') {
+                    when { branch 'main' }
+                    steps {
+                        // отдельный DOCKER_CONFIG во временном каталоге, чтобы логин не остался на постоянной ноде
+                        withEnv(["DOCKER_CONFIG=${pwd(tmp: true)}/docker"]) {
+                            withCredentials([usernamePassword(credentialsId: 'registry-creds',
+                                                              usernameVariable: 'REGISTRY_USER',
+                                                              passwordVariable: 'REGISTRY_PASSWORD')]) {
+                                sh '''#!/bin/bash
+                                    set -euo pipefail
+                                    trap 'docker logout registry.example.com' EXIT
+                                    echo "$REGISTRY_PASSWORD" | docker login registry.example.com -u "$REGISTRY_USER" --password-stdin
+                                    docker push "$IMAGE_REPO:$IMAGE_TAG"
+                                '''
+                            }
+                        }
+                    }
+                }
+            }
+            post {
+                always {
+                    // workspace постоянной ноды между сборками сохраняется - чистим сами
+                    cleanWs(deleteDirs: true, disableDeferredWipeout: true)
+                }
+            }
+        }
+
+        stage('Деплой stage') {
+            when {
+                beforeAgent true
+                branch 'main'
+            }
+            agent { label 'dotnet-linux' }
+            options { timeout(time: 20, unit: 'MINUTES') }
+            steps {
+                withCredentials([string(credentialsId: 'deploy-token', variable: 'DEPLOY_TOKEN')]) {
+                    sh './deploy.sh --token "$DEPLOY_TOKEN" --env stage'
+                }
+            }
+            post {
+                always { cleanWs(deleteDirs: true, disableDeferredWipeout: true) }
+            }
+        }
+
+        stage('Подтверждение prod') {
+            when { branch 'main' }
+            agent none
+            // лид может ответить на следующий день; без агента ожидание не занимает executor
+            options { timeout(time: 3, unit: 'DAYS') }
+            steps {
+                input message: "Деплой ${env.IMAGE_TAG} на prod?", ok: 'Деплоить на prod'
+            }
+        }
+
+        stage('Деплой prod') {
+            when {
+                beforeAgent true
+                branch 'main'
+            }
+            agent { label 'dotnet-linux' }
+            options { timeout(time: 20, unit: 'MINUTES') }
+            steps {
+                withCredentials([string(credentialsId: 'deploy-token', variable: 'DEPLOY_TOKEN')]) {
+                    sh './deploy.sh --token "$DEPLOY_TOKEN" --env prod'
+                }
+            }
+            post {
+                always { cleanWs(deleteDirs: true, disableDeferredWipeout: true) }
+            }
+        }
+    }
+
+    post {
+        always {
+            notifySlack(currentBuild.currentResult)
+        }
+    }
+}
