diff --git a/api/src/payments/http-gateway.ts b/api/src/payments/http-gateway.ts
new file mode 100644
index 0000000..83276a4
--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,77 @@
+import { z } from 'zod';
+import { logger } from '../logger.js';
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+const MAX_ATTEMPTS = 3;
+const RETRY_DELAYS_MS = [500, 1500];
+const REQUEST_TIMEOUT_MS = 10_000;
+
+// Результат списания неизвестен (сеть, таймаут, 409, 5xx): безопасно повторить с тем же order_id.
+export class PaymentUnavailableError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PaymentUnavailableError';
+  }
+}
+
+const chargeResponseSchema = z.discriminatedUnion('status', [
+  z.object({ status: z.literal('approved'), transaction_id: z.string().min(1) }),
+  z.object({ status: z.literal('declined'), decline_reason: z.string() }),
+]);
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export class HttpPaymentGateway implements PaymentGateway {
+  constructor(
+    private readonly baseUrl: string,
+    private readonly apiKey: string,
+    private readonly retryDelaysMs: number[] = RETRY_DELAYS_MS,
+  ) {}
+
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    for (let attempt = 1; ; attempt += 1) {
+      try {
+        return await this.chargeOnce(req);
+      } catch (err) {
+        if (!(err instanceof PaymentUnavailableError)) throw err;
+        logger.warn(`payment gateway: no result for order ${req.orderId} (attempt ${attempt} of ${MAX_ATTEMPTS}): ${err.message}`);
+        if (attempt >= MAX_ATTEMPTS) throw err;
+        await pause(this.retryDelaysMs[attempt - 1] ?? 0);
+      }
+    }
+  }
+
+  private async chargeOnce(req: ChargeRequest): Promise<ChargeResult> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+    } catch (err) {
+      throw new PaymentUnavailableError('payment gateway is unreachable', { cause: err });
+    }
+    if (res.status === 409 || res.status >= 500) {
+      throw new PaymentUnavailableError(`payment gateway responded with ${res.status}`);
+    }
+    if (!res.ok) {
+      // 400/401 - ошибка нашей стороны, повтор не поможет.
+      throw new Error(`payment gateway responded with ${res.status}`);
+    }
+    let body: unknown;
+    try {
+      body = await res.json();
+    } catch (err) {
+      throw new PaymentUnavailableError('payment gateway returned malformed body', { cause: err });
+    }
+    const parsed = chargeResponseSchema.safeParse(body);
+    if (!parsed.success) throw new Error('payment gateway returned an unexpected response');
+    return parsed.data.status === 'approved'
+      ? { status: 'approved', transactionId: parsed.data.transaction_id }
+      : { status: 'declined', reason: parsed.data.decline_reason };
+  }
+}
