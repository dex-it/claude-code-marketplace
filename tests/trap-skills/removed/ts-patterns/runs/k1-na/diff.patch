diff --git a/api/test/http-gateway.test.ts b/api/test/http-gateway.test.ts
new file mode 100644
index 0000000..c6e8aec
--- /dev/null
+++ b/api/test/http-gateway.test.ts
@@ -0,0 +1,50 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpPaymentGateway, PaymentUnavailableError } from '../src/payments/http-gateway.js';
+
+const req = { orderId: 'ord-1', amountKopecks: 100, currency: 'RUB' } as const;
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status });
+
+describe('HttpPaymentGateway', () => {
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('maps approved and declined responses', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockResolvedValueOnce(json({ status: 'approved', transaction_id: 'tx_1' }))
+      .mockResolvedValueOnce(json({ status: 'declined', decline_reason: 'card_expired' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const gw = new HttpPaymentGateway('http://pay.test', 'key', []);
+    expect(await gw.charge(req)).toEqual({ status: 'approved', transactionId: 'tx_1' });
+    expect(await gw.charge(req)).toEqual({ status: 'declined', reason: 'card_expired' });
+    expect(fetchMock.mock.calls[0][1].headers['X-Api-Key']).toBe('key');
+  });
+
+  it('retries with the same order_id after a network failure', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(json({ error: 'busy' }, 409))
+      .mockResolvedValueOnce(json({ status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    const gw = new HttpPaymentGateway('http://pay.test', 'key', [0, 0]);
+    expect(await gw.charge(req)).toEqual({ status: 'approved', transactionId: 'tx_2' });
+    const bodies = fetchMock.mock.calls.map((c) => JSON.parse(c[1].body).order_id);
+    expect(bodies).toEqual(['ord-1', 'ord-1', 'ord-1']);
+  });
+
+  it('gives up with PaymentUnavailableError after 3 attempts', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(json({ error: 'x' }, 503));
+    vi.stubGlobal('fetch', fetchMock);
+    const gw = new HttpPaymentGateway('http://pay.test', 'key', [0, 0]);
+    await expect(gw.charge(req)).rejects.toBeInstanceOf(PaymentUnavailableError);
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('does not retry on 401', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(json({ error: 'key' }, 401));
+    vi.stubGlobal('fetch', fetchMock);
+    const gw = new HttpPaymentGateway('http://pay.test', 'key', [0, 0]);
+    await expect(gw.charge(req)).rejects.toThrow('401');
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+});
