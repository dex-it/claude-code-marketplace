diff --git a/api/test/http-gateway.test.ts b/api/test/http-gateway.test.ts
new file mode 100644
index 0000000..9958d34
--- /dev/null
+++ b/api/test/http-gateway.test.ts
@@ -0,0 +1,46 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpPaymentGateway, PaymentUnavailableError } from '../src/payments/http-gateway.js';
+
+const req = { orderId: 'ord-1', amountKopecks: 100, currency: 'RUB' } as const;
+const gateway = () => new HttpPaymentGateway({ baseUrl: 'https://pay.test', apiKey: 'k', retryDelaysMs: [0, 0] });
+const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('HttpPaymentGateway', () => {
+  it('maps approved and declined responses', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx' }))
+      .mockResolvedValueOnce(json(200, { status: 'declined', decline_reason: 'card_expired' }));
+    vi.stubGlobal('fetch', fetchMock);
+    expect(await gateway().charge(req)).toEqual({ status: 'approved', transactionId: 'tx' });
+    expect(await gateway().charge(req)).toEqual({ status: 'declined', reason: 'card_expired' });
+    expect(fetchMock.mock.calls[0][1].headers['X-Api-Key']).toBe('k');
+  });
+
+  it('retries network failures, 409 and 5xx with the same order_id', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('socket hang up'))
+      .mockResolvedValueOnce(json(409, { error: 'busy' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx' }));
+    vi.stubGlobal('fetch', fetchMock);
+    expect(await gateway().charge(req)).toEqual({ status: 'approved', transactionId: 'tx' });
+    const ids = fetchMock.mock.calls.map((c) => JSON.parse(c[1].body).order_id);
+    expect(ids).toEqual(['ord-1', 'ord-1', 'ord-1']);
+  });
+
+  it('gives up with PaymentUnavailableError when the result stays unknown', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(json(503, { error: 'down' })));
+    await expect(gateway().charge(req)).rejects.toBeInstanceOf(PaymentUnavailableError);
+  });
+
+  it('does not retry 401 and rejects malformed 200 bodies', async () => {
+    const fetchMock = vi.fn().mockResolvedValueOnce(json(401, { error: 'key' })).mockResolvedValueOnce(json(200, { status: 'approved' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).rejects.toThrow('401');
+    await expect(gateway().charge(req)).rejects.toThrow('unexpected response');
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+  });
+});
