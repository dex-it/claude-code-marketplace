new file mode 100644
index 0000000..9f73d59
--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,91 @@
+import { z } from 'zod';
+import { logger } from '../logger.js';
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+const chargeResponseSchema = z.discriminatedUnion('status', [
+  z.object({ status: z.literal('approved'), transaction_id: z.string().min(1) }),
+  z.object({ status: z.literal('declined'), decline_reason: z.string() }),
+]);
+
+export class PaymentUnavailableError extends Error {
+  constructor(
+    readonly orderId: string,
+    readonly attempts: number,
+    options?: ErrorOptions,
+  ) {
+    super(`Payment for order ${orderId} has no definite result after ${attempts} attempts`, options);
+    this.name = 'PaymentUnavailableError';
+  }
+}
+
+// Ошибка, после которой результат списания неизвестен или шлюз занят - безопасно повторить с тем же order_id.
+class RetryableChargeError extends Error {}
+
+export interface HttpPaymentGatewayOptions {
+  baseUrl: string;
+  apiKey: string;
+  timeoutMs?: number;
+  retryDelaysMs?: number[];
+}
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export class HttpPaymentGateway implements PaymentGateway {
+  private readonly timeoutMs: number;
+  private readonly retryDelaysMs: number[];
+
+  constructor(private readonly options: HttpPaymentGatewayOptions) {
+    this.timeoutMs = options.timeoutMs ?? 10_000;
+    this.retryDelaysMs = options.retryDelaysMs ?? [500, 1500];
+  }
+
+  // Шлюз идемпотентен по order_id в течение суток, поэтому сбои и 409 повторяем с тем же order_id.
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    const maxAttempts = this.retryDelaysMs.length + 1;
+    let lastError: unknown;
+    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
+      try {
+        return await this.chargeOnce(req);
+      } catch (err) {
+        if (!(err instanceof RetryableChargeError)) throw err;
+        lastError = err;
+        logger.warn(`payment for order ${req.orderId} is inconclusive (attempt ${attempt} of ${maxAttempts})`);
+        if (attempt < maxAttempts) await pause(this.retryDelaysMs[attempt - 1]);
+      }
+    }
+    throw new PaymentUnavailableError(req.orderId, maxAttempts, { cause: lastError });
+  }
+
+  private async chargeOnce(req: ChargeRequest): Promise<ChargeResult> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.options.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.options.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(this.timeoutMs),
+      });
+    } catch (err) {
+      throw new RetryableChargeError('payment gateway is unreachable', { cause: err });
+    }
+    if (res.status === 409 || res.status >= 500) {
+      throw new RetryableChargeError(`payment gateway responded with ${res.status}`);
+    }
+    if (!res.ok) {
+      throw new Error(`payment gateway responded with ${res.status}`);
+    }
+    let body: unknown;
+    try {
+      body = await res.json();
+    } catch (err) {
+      throw new RetryableChargeError('payment gateway returned a malformed body', { cause: err });
+    }
+    const parsed = chargeResponseSchema.safeParse(body);
+    if (!parsed.success) throw new Error('payment gateway returned an unexpected response');
+    return parsed.data.status === 'approved'
+      ? { status: 'approved', transactionId: parsed.data.transaction_id }
+      : { status: 'declined', reason: parsed.data.decline_reason };
+  }
+}
