 });
+
+describe('order payment', () => {
+  function setupPay(charge: PaymentGateway['charge']) {
+    const store = new Store();
+    seedDemo(store);
+    const calls = { paid: [] as number[], events: [] as unknown[] };
+    const app = createApp({
+      store,
+      payments: { charge },
+      notifier: { async orderPaid(o) { calls.paid.push(o.number); } },
+      analytics: { async track(event, props) { calls.events.push({ event, props }); } },
+    });
+    return { store, app, calls };
+  }
+
+  it('pays a new order, stores transactionId, notifies and tracks', async () => {
+    const { app, store, calls } = setupPay(async () => ({ status: 'approved', transactionId: 'tx-1' }));
+    const auth = await login(app, 'alice');
+    const res = await request(app).post('/api/orders/ord-1001/pay').set('Authorization', auth).expect(200);
+    expect(res.body).toMatchObject({ status: 'paid', transactionId: 'tx-1' });
+    expect(store.getOrder('ord-1001')?.status).toBe('paid');
+    expect(calls.paid).toEqual([1001]);
+    expect(calls.events).toEqual([{ event: 'order_paid', props: { orderNumber: 1001, amountKopecks: 129000 } }]);
+  });
+
+  it('answers 402 on decline and keeps the order new', async () => {
+    const { app, store, calls } = setupPay(async () => ({ status: 'declined', reason: 'insufficient_funds' }));
+    const auth = await login(app, 'alice');
+    const res = await request(app).post('/api/orders/ord-1001/pay').set('Authorization', auth);
+    expect(res.status).toBe(402);
+    expect(res.body).toEqual({ error: { code: 'payment_declined', message: 'insufficient_funds' } });
+    expect(store.getOrder('ord-1001')?.status).toBe('new');
+    expect(calls.paid).toEqual([]);
+  });
+
+  it('hides orders of other customers and unknown orders', async () => {
+    const { app } = setupPay(async () => ({ status: 'approved', transactionId: 'tx-1' }));
+    const auth = await login(app, 'alice');
+    await request(app).post('/api/orders/ord-1004/pay').set('Authorization', auth).expect(404);
+    await request(app).post('/api/orders/nope/pay').set('Authorization', auth).expect(404);
+  });
+
+  it('refuses to pay an already paid order without charging', async () => {
+    let charges = 0;
+    const { app } = setupPay(async () => {
+      charges += 1;
+      return { status: 'approved', transactionId: 'tx-1' };
+    });
+    const auth = await login(app, 'alice');
+    await request(app).post('/api/orders/ord-1003/pay').set('Authorization', auth).expect(409);
+    expect(charges).toBe(0);
+  });
+
+  it('does not charge twice for concurrent requests', async () => {
+    let charges = 0;
+    const { app } = setupPay(async () => {
+      charges += 1;
+      await new Promise((r) => setTimeout(r, 20));
+      return { status: 'approved', transactionId: 'tx-1' };
+    });
+    const auth = await login(app, 'alice');
+    const [a, b] = await Promise.all([
+      request(app).post('/api/orders/ord-1001/pay').set('Authorization', auth),
+      request(app).post('/api/orders/ord-1001/pay').set('Authorization', auth),
+    ]);
+    expect([a.status, b.status].sort()).toEqual([200, 409]);
+    expect(charges).toBe(1);
+  });
+});
