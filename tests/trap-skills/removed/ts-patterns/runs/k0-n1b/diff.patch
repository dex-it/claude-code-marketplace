--- /dev/null
+++ b/web/src/components/__tests__/ProductsPage.test.tsx
@@ -0,0 +1,26 @@
+import { render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Product } from '../../types';
+import { ProductsPage } from '../ProductsPage';
+
+const products: Product[] = [{ id: 'p-mug', title: 'Кружка керамическая', priceKopecks: 129000, currency: 'RUB' }];
+
+describe('ProductsPage', () => {
+  beforeEach(() => {
+    localStorage.setItem('shopdesk.token', 'test-token');
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it('shows price with currency code', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => new Response(JSON.stringify(products), { status: 200, headers: { 'Content-Type': 'application/json' } })),
+    );
+    render(<ProductsPage />);
+    const cell = await screen.findByText(/RUB/);
+    expect(cell.textContent?.replace(/\s/g, ' ')).toBe('1 290,00 RUB');
+  });
+});
