diff --git a/api/src/payments/http-gateway.ts b/api/src/payments/http-gateway.ts
new file mode 100644
index 0000000..82312a5
--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,84 @@
+import { logger } from '../logger.js';
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+const MAX_ATTEMPTS = 3;
+const RETRY_DELAYS_MS = [500, 1500];
+const REQUEST_TIMEOUT_MS = 10_000;
+
+export class PaymentGatewayError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PaymentGatewayError';
+  }
+}
+
+// Сбой, после которого результат списания неизвестен или шлюз занят: безопасно повторить с тем же order_id.
+class RetryableChargeError extends Error {}
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function parseCharge(body: unknown): ChargeResult {
+  const data = (typeof body === 'object' && body !== null ? body : {}) as Record<string, unknown>;
+  if (data.status === 'approved' && typeof data.transaction_id === 'string') {
+    return { status: 'approved', transactionId: data.transaction_id };
+  }
+  if (data.status === 'declined') {
+    return {
+      status: 'declined',
+      reason: typeof data.decline_reason === 'string' ? data.decline_reason : 'unknown',
+    };
+  }
+  throw new PaymentGatewayError('payment gateway returned an unexpected response');
+}
+
+export class HttpPaymentGateway implements PaymentGateway {
+  constructor(
+    private readonly baseUrl: string,
+    private readonly apiKey: string,
+    private readonly retryDelaysMs: number[] = RETRY_DELAYS_MS,
+  ) {}
+
+  // Шлюз идемпотентен по order_id в течение суток, поэтому повторы после сбоев не спишут деньги дважды.
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    for (let attempt = 1; ; attempt += 1) {
+      try {
+        return await this.send(req);
+      } catch (err) {
+        if (!(err instanceof RetryableChargeError)) throw err;
+        logger.warn(`payment gateway failed for order ${req.orderId} (attempt ${attempt} of ${MAX_ATTEMPTS})`);
+        if (attempt >= MAX_ATTEMPTS) {
+          throw new PaymentGatewayError(`Charge for order ${req.orderId} has unknown result`, { cause: err });
+        }
+        await pause(this.retryDelaysMs[attempt - 1] ?? 0);
+      }
+    }
+  }
+
+  private async send(req: ChargeRequest): Promise<ChargeResult> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+    } catch (err) {
+      throw new RetryableChargeError('payment gateway is unreachable', { cause: err });
+    }
+    if (res.status === 409 || res.status >= 500) {
+      throw new RetryableChargeError(`payment gateway responded with ${res.status}`);
+    }
+    if (!res.ok) {
+      throw new PaymentGatewayError(`payment gateway responded with ${res.status}`);
+    }
+    try {
+      return parseCharge(await res.json());
+    } catch (err) {
+      if (err instanceof PaymentGatewayError) throw err;
+      throw new RetryableChargeError('payment gateway returned an unreadable body', { cause: err });
+    }
+  }
+}
