diff --git a/api/test/http-gateway.test.ts b/api/test/http-gateway.test.ts
new file mode 100644
index 0000000..7375928
--- /dev/null
+++ b/api/test/http-gateway.test.ts
@@ -0,0 +1,56 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { HttpPaymentGateway, PaymentGatewayError } from '../src/payments/http-gateway.js';
+
+const req = { orderId: 'ord-1', amountKopecks: 129000, currency: 'RUB' } as const;
+
+function json(status: number, body: unknown): Response {
+  return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+}
+
+function gateway() {
+  return new HttpPaymentGateway('https://pay.example', 'key-1', [0, 0]);
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('HttpPaymentGateway', () => {
+  it('sends the charge with the api key and maps approval', async () => {
+    const fetchMock = vi.fn(async () => json(200, { status: 'approved', transaction_id: 'tx_1' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).resolves.toEqual({ status: 'approved', transactionId: 'tx_1' });
+    const [url, init] = fetchMock.mock.calls[0] as unknown as [URL, RequestInit];
+    expect(url.href).toBe('https://pay.example/v1/charges');
+    expect(init.headers).toMatchObject({ 'X-Api-Key': 'key-1' });
+    expect(JSON.parse(init.body as string)).toEqual({ order_id: 'ord-1', amount: 129000, currency: 'RUB' });
+  });
+
+  it('maps a decline with its reason', async () => {
+    vi.stubGlobal('fetch', async () => json(200, { status: 'declined', decline_reason: 'card_expired' }));
+    await expect(gateway().charge(req)).resolves.toEqual({ status: 'declined', reason: 'card_expired' });
+  });
+
+  it('retries network failures, 5xx and 409 with the same order id', async () => {
+    const fetchMock = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(json(409, { error: 'busy' }))
+      .mockResolvedValueOnce(json(200, { status: 'approved', transaction_id: 'tx_2' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).resolves.toEqual({ status: 'approved', transactionId: 'tx_2' });
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('gives up after three failed attempts', async () => {
+    const fetchMock = vi.fn(async () => json(503, { error: 'down' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).rejects.toBeInstanceOf(PaymentGatewayError);
+    expect(fetchMock).toHaveBeenCalledTimes(3);
+  });
+
+  it('does not retry client errors', async () => {
+    const fetchMock = vi.fn(async () => json(401, { error: 'bad key' }));
+    vi.stubGlobal('fetch', fetchMock);
+    await expect(gateway().charge(req)).rejects.toBeInstanceOf(PaymentGatewayError);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+});
