+export function formatMoneyWithCode(kopecks: number, currency: string): string {
+  return new Intl.NumberFormat('ru-RU', { style: 'currency', currency, currencyDisplay: 'code' }).format(kopecks / 100);
+}
+
 export function formatMoney(kopecks: number): string {
   return rub.format(kopecks / 100);
 }
