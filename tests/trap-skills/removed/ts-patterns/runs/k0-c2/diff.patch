+import { render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { Product } from '../../types';
+import { ProductsPage } from '../ProductsPage';
+
+const products: Product[] = [
+  { id: 'p-mug', title: 'Кружка керамическая', priceKopecks: 129000, currency: 'RUB' },
+];
+
+describe('ProductsPage', () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it('shows prices with the currency code', async () => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => new Response(JSON.stringify(products), { headers: { 'Content-Type': 'application/json' } })),
+    );
+
+    render(<ProductsPage />);
+
+    expect(await screen.findByText(/^1\s290,00\sRUB$/)).toBeInTheDocument();
+  });
+});
