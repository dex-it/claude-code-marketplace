+import { render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { ProductsPage } from '../ProductsPage';
+
+describe('ProductsPage', () => {
+  beforeEach(() => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () =>
+        new Response(JSON.stringify([{ id: 'p-mug', title: 'Кружка керамическая', priceKopecks: 129000, currency: 'RUB' }]), {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        }),
+      ),
+    );
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it('shows price with currency code', async () => {
+    render(<ProductsPage />);
+    expect(await screen.findByText(/^1\s290,00\sRUB$/)).toBeInTheDocument();
+  });
+});
