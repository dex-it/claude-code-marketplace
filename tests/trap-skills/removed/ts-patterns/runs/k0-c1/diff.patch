+import request from 'supertest';
+import { describe, expect, it } from 'vitest';
+import { createApp } from '../src/app.js';
+import { seedDemo } from '../src/seed.js';
+import { Store } from '../src/store.js';
+
+function setup() {
+  const store = new Store();
+  seedDemo(store);
+  const app = createApp({
+    store,
+    payments: { async charge() { return { status: 'approved', transactionId: 'tx-test' }; } },
+    notifier: { async orderPaid() {} },
+    analytics: { async track() {} },
+  });
+  return app;
+}
+
+describe('products api', () => {
+  it('returns currency for every product in the list', async () => {
+    const res = await request(setup()).get('/api/products').expect(200);
+    expect(res.body.length).toBeGreaterThan(0);
+    for (const product of res.body) expect(product.currency).toBe('RUB');
+  });
+
+  it('returns currency for a single product', async () => {
+    const res = await request(setup()).get('/api/products/p-mug').expect(200);
+    expect(res.body.currency).toBe('RUB');
+  });
+});
