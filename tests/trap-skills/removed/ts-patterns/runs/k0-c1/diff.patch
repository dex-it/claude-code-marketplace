+
+/** Цена товара в каталоге: сумма с кодом валюты, например `1 290,00 RUB`. */
+export function formatPrice(kopecks: number, currency: string): string {
+  return new Intl.NumberFormat('ru-RU', { style: 'currency', currency, currencyDisplay: 'code' }).format(kopecks / 100);
+}
