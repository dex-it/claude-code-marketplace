diff --git a/api/src/payments/http-gateway.ts b/api/src/payments/http-gateway.ts
new file mode 100644
index 0000000..c905cd1
--- /dev/null
+++ b/api/src/payments/http-gateway.ts
@@ -0,0 +1,85 @@
+import { logger } from '../logger.js';
+import type { ChargeRequest, ChargeResult, PaymentGateway } from './gateway.js';
+
+const MAX_ATTEMPTS = 3;
+const REQUEST_TIMEOUT_MS = 10_000;
+
+export class PaymentGatewayError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PaymentGatewayError';
+  }
+}
+
+class RetryableError extends Error {}
+
+function pause(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export interface HttpPaymentGatewayOptions {
+  retryDelayMs?: number;
+}
+
+// Повтор с тем же order_id безопасен: шлюз в течение суток возвращает результат первого списания.
+// Поэтому повторяем сетевые сбои (результат неизвестен), 409 (заказ обрабатывается) и 5xx.
+export class HttpPaymentGateway implements PaymentGateway {
+  private readonly retryDelayMs: number;
+
+  constructor(
+    private readonly baseUrl: string,
+    private readonly apiKey: string,
+    options: HttpPaymentGatewayOptions = {},
+  ) {
+    this.retryDelayMs = options.retryDelayMs ?? 500;
+  }
+
+  async charge(req: ChargeRequest): Promise<ChargeResult> {
+    let lastError: unknown;
+    for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt += 1) {
+      try {
+        return await this.chargeOnce(req);
+      } catch (err) {
+        if (!(err instanceof RetryableError)) throw err;
+        lastError = err;
+        logger.warn(`payment gateway failed for order ${req.orderId} (attempt ${attempt} of ${MAX_ATTEMPTS}): ${err.message}`);
+        if (attempt < MAX_ATTEMPTS) await pause(this.retryDelayMs * attempt);
+      }
+    }
+    throw new PaymentGatewayError(`Charge for order ${req.orderId} failed after ${MAX_ATTEMPTS} attempts`, {
+      cause: lastError,
+    });
+  }
+
+  private async chargeOnce(req: ChargeRequest): Promise<ChargeResult> {
+    let res: Response;
+    try {
+      res = await fetch(new URL('/v1/charges', this.baseUrl), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-Api-Key': this.apiKey },
+        body: JSON.stringify({ order_id: req.orderId, amount: req.amountKopecks, currency: req.currency }),
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+    } catch (err) {
+      throw new RetryableError(`gateway is unreachable: ${err instanceof Error ? err.message : String(err)}`);
+    }
+    if (res.status === 409 || res.status >= 500) throw new RetryableError(`gateway responded with ${res.status}`);
+    if (res.status !== 200) throw new PaymentGatewayError(`gateway responded with ${res.status}`);
+
+    const body: unknown = await res.json().catch(() => null);
+    return parseCharge(body);
+  }
+}
+
+function parseCharge(body: unknown): ChargeResult {
+  if (typeof body === 'object' && body !== null) {
+    const data = body as Record<string, unknown>;
+    if (data.status === 'approved' && typeof data.transaction_id === 'string') {
+      return { status: 'approved', transactionId: data.transaction_id };
+    }
+    if (data.status === 'declined' && typeof data.decline_reason === 'string') {
+      return { status: 'declined', reason: data.decline_reason };
+    }
+  }
+  throw new PaymentGatewayError('gateway returned an unexpected response');
+}
