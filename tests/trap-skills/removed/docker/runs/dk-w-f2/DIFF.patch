@@ -0,0 +1,24 @@
+FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
+WORKDIR /src
+
+# Манифесты отдельным слоем: restore кэшируется, пока не менялись зависимости
+COPY global.json Directory.Build.props Directory.Packages.props ./
+COPY src/Depot.Contracts/Depot.Contracts.csproj src/Depot.Contracts/
+COPY src/Depot.Api/Depot.Api.csproj src/Depot.Api/
+RUN dotnet restore src/Depot.Api/Depot.Api.csproj
+
+COPY src/ src/
+RUN dotnet publish src/Depot.Api/Depot.Api.csproj \
+    -c Release --no-restore -p:UseAppHost=false -o /app
+
+# Chiseled: без shell, пакетного менеджера и root; только рантайм ASP.NET
+FROM mcr.microsoft.com/dotnet/aspnet:8.0-jammy-chiseled AS final
+WORKDIR /app
+COPY --from=build /app .
+
+# Числовой UID, чтобы Kubernetes мог проверить runAsNonRoot
+USER $APP_UID
+EXPOSE 8080
+
+# Настройки (ConnectionStrings__Default, Auth__ApiKey, ...) - только переменные окружения во время запуска
+ENTRYPOINT ["dotnet", "Depot.Api.dll"]
