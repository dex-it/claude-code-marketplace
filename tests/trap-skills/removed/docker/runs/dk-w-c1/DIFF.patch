@@ -0,0 +1,21 @@
+FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
+WORKDIR /src
+
+# Сначала только манифесты проектов: слой restore кэшируется, пока не меняются зависимости.
+COPY global.json Directory.Build.props Directory.Packages.props ./
+COPY src/Depot.Contracts/Depot.Contracts.csproj src/Depot.Contracts/
+COPY src/Depot.Api/Depot.Api.csproj src/Depot.Api/
+RUN dotnet restore src/Depot.Api/Depot.Api.csproj
+
+COPY src/ src/
+RUN dotnet publish src/Depot.Api/Depot.Api.csproj -c Release --no-restore -p:UseAppHost=false -o /app
+
+# Chiseled: без shell и пакетного менеджера, непривилегированный пользователь app (UID 1654).
+FROM mcr.microsoft.com/dotnet/aspnet:8.0-jammy-chiseled AS final
+WORKDIR /app
+COPY --from=build /app .
+
+USER 1654
+EXPOSE 8080
+# Тот же образ запускает depot-worker: dotnet Depot.Api.dll --worker (аргументы дописываются к ENTRYPOINT).
+ENTRYPOINT ["dotnet", "Depot.Api.dll"]
