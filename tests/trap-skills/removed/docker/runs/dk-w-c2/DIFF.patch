+FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
+WORKDIR /src
+
+# Слой restore: только манифесты, чтобы кэш не сбрасывался от правок кода.
+COPY global.json Directory.Build.props Directory.Packages.props ./
+COPY src/Depot.Api/Depot.Api.csproj src/Depot.Api/
+COPY src/Depot.Contracts/Depot.Contracts.csproj src/Depot.Contracts/
+RUN dotnet restore src/Depot.Api/Depot.Api.csproj
+
+COPY src/ src/
+# Без trimming/AOT: обработчики IStockHandler находятся рефлексией. Без apphost: запуск через dotnet.
+RUN dotnet publish src/Depot.Api/Depot.Api.csproj -c Release --no-restore \
+    -o /app --no-self-contained -p:UseAppHost=false
+
+# Chiseled: без shell и пакетного менеджера, непривилегированный пользователь, порт 8080.
+FROM mcr.microsoft.com/dotnet/aspnet:8.0-jammy-chiseled AS final
+WORKDIR /app
+COPY --from=build /app .
+EXPOSE 8080
+USER app
+# Настройки (ConnectionStrings__Default, Auth__ApiKey, ...) передаёт платформа через переменные окружения.
+# depot-worker: тот же образ, аргумент `--worker`.
+ENTRYPOINT ["dotnet", "Depot.Api.dll"]
