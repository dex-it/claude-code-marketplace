+import numpy as np
+import pandas as pd
+import pytest
+
+from shelfwatch import churn_model as cm
+
+
+def make_accounts(n_stores: int = 400, n_months: int = 14, seed: int = 0) -> pd.DataFrame:
+    """Синтетика в формате docs/data.md; отток зависит от падения выручки и числа обращений."""
+    rng = np.random.default_rng(seed)
+    months = pd.period_range("2025-01", periods=n_months, freq="M").to_timestamp()
+    rows = []
+    for store in range(n_stores):
+        base = rng.lognormal(10, 0.5)
+        plan = rng.choice(["basic", "pro", "max"])
+        for i, month in enumerate(months):
+            revenue = base * rng.uniform(0.4, 1.2)
+            tickets = np.nan if rng.random() < 0.18 else float(rng.poisson(3))
+            risk = 0.02 + 0.3 * (revenue < 0.6 * base) + 0.03 * np.nan_to_num(tickets)
+            rows.append(
+                {
+                    "account_id": store,
+                    "snapshot": month,
+                    "tenure_months": i + 5,
+                    "plan": plan,
+                    "store_id": store,
+                    "n_tickets": tickets,
+                    "revenue": revenue,
+                    "churned": int(rng.random() < risk),
+                }
+            )
+    return pd.DataFrame(rows)
+
+
+def test_features_use_only_past_and_keep_index() -> None:
+    df = make_accounts(5, 4).sample(frac=1, random_state=1)
+    feats = cm.build_features(df)
+    assert feats.index.equals(df.index)
+    first = df[df["snapshot"] == df["snapshot"].min()].index
+    assert feats.loc[first, "prev_revenue"].isna().all()
+    one = df[(df["store_id"] == 0)].sort_values("snapshot")
+    f0 = feats.loc[one.index]
+    assert f0["prev_revenue"].iloc[1:].tolist() == one["revenue"].iloc[:-1].tolist()
+
+
+def test_missing_tickets_become_zero_with_flag() -> None:
+    df = make_accounts(20, 3)
+    feats = cm.build_features(df)
+    miss = df["n_tickets"].isna()
+    assert miss.any()
+    assert (feats.loc[miss, "n_tickets"] == 0).all()
+    assert (feats.loc[miss, "no_tickets"] == 1).all()
+    assert not feats.isin([np.inf, -np.inf]).any().any()
+
+
+def test_temporal_split_is_ordered_with_gap() -> None:
+    df = make_accounts(30, 14)
+    train, val, test = cm.temporal_split(df)
+    month = cm._month(df)
+    assert month[train].max() + 1 < month[val].min()
+    assert month[val].max() + 1 < month[test].min()
+    assert not set(train) & set(val) and not set(val) & set(test)
+
+
+def test_temporal_split_too_short() -> None:
+    with pytest.raises(ValueError):
+        cm.temporal_split(make_accounts(10, 6))
+
+
+def test_evaluate_picks_best_and_beats_base_rate() -> None:
+    res = cm.evaluate(make_accounts())
+    assert res["best_model"] in cm.MODEL_NAMES
+    assert set(res["val_average_precision"]) == set(cm.MODEL_NAMES)
+    assert res["best_model"] == max(res["val_average_precision"], key=res["val_average_precision"].get)
+    assert res["test_average_precision"] > res["test_churn_rate"]
+
+
+def test_predict_next_month_last_snapshot_stores() -> None:
+    df = make_accounts(150, 10)
+    last = df["snapshot"].max()
+    df = df[~((df["store_id"] < 10) & (df["snapshot"] == last))].copy()  # эти магазины в последнем срезе не видны
+    df.loc[df["snapshot"] == df["snapshot"].max(), "churned"] = np.nan  # исход ещё неизвестен
+    model = cm.fit_model(df, "xgboost")
+    pred = cm.predict_next_month(df, model)
+    assert pred.index.name == "store_id"
+    assert set(pred.index) == set(df.loc[df["snapshot"] == df["snapshot"].max(), "store_id"])
+    assert pred.between(0, 1).all()
+    assert pred.notna().all()
+
+
+def test_predict_next_month_without_model_selects_one() -> None:
+    pred = cm.predict_next_month(make_accounts(200, 12))
+    assert len(pred) == 200
+    assert pred.between(0, 1).all()
+
+
+def test_fit_model_needs_both_classes() -> None:
+    df = make_accounts(20, 4)
+    df["churned"] = 0
+    with pytest.raises(ValueError):
+        cm.fit_model(df, "random_forest")
