@@ -0,0 +1,80 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from shelfwatch.churn_model import (
+    build_features,
+    predict_next_month,
+    split_by_time,
+    train_and_evaluate,
+)
+
+
+def synthetic(n_stores: int = 300, n_months: int = 12, seed: int = 0) -> pd.DataFrame:
+    rng = np.random.default_rng(seed)
+    months = pd.date_range("2025-01-01", periods=n_months, freq="MS")
+    rows = []
+    for store in range(n_stores):
+        plan = rng.choice(["basic", "plus", "pro"])
+        for i, month in enumerate(months):
+            tickets = rng.poisson(2) if rng.random() > 0.2 else np.nan
+            revenue = rng.gamma(5, 1000)
+            risk = 0.02 + 0.4 * (0 if np.isnan(tickets) else tickets > 4)
+            rows.append(
+                {
+                    "account_id": store * 10,
+                    "snapshot": month,
+                    "tenure_months": i + store % 24,
+                    "plan": plan,
+                    "store_id": store,
+                    "n_tickets": tickets,
+                    "revenue": revenue,
+                    "churned": int(rng.random() < risk),
+                }
+            )
+    return pd.DataFrame(rows)
+
+
+def test_split_by_time_is_ordered_and_disjoint() -> None:
+    df = synthetic(20)
+    train, valid, test = split_by_time(df)
+    assert train["snapshot"].max() < valid["snapshot"].min()
+    assert valid["snapshot"].max() < test["snapshot"].min()
+    assert len(train) + len(valid) + len(test) == len(df)
+
+
+def test_split_by_time_too_few_months() -> None:
+    with pytest.raises(ValueError):
+        split_by_time(synthetic(5, n_months=6))
+
+
+def test_features_no_nan_and_tickets_flag() -> None:
+    df = synthetic(30)
+    feats = build_features(df)
+    assert not feats.isna().any().any()
+    assert (feats["no_tickets"] == df["n_tickets"].isna().astype(int)).all()
+    assert "store_id" not in feats.columns
+    assert feats.index.equals(df.index)
+
+
+def test_revenue_change_uses_only_past() -> None:
+    df = synthetic(3, n_months=4).sample(frac=1, random_state=1)  # порядок строк не важен
+    feats = build_features(df)
+    first = df.groupby("store_id")["snapshot"].transform("min") == df["snapshot"]
+    assert (feats.loc[first, "revenue_change"] == 0).all()
+
+
+def test_train_and_evaluate_beats_base_rate() -> None:
+    result = train_and_evaluate(synthetic())
+    assert result.best_name in {"random_forest", "xgboost"}
+    assert set(result.valid_pr_auc) == {"random_forest", "xgboost"}
+    assert result.test_pr_auc > result.test_base_rate
+
+
+def test_predict_next_month_one_probability_per_store() -> None:
+    df = synthetic(60)
+    model = train_and_evaluate(df).model
+    pred = predict_next_month(df, model)
+    assert pred.index.is_unique
+    assert set(pred.index) == set(df["store_id"])
+    assert pred.between(0, 1).all()
