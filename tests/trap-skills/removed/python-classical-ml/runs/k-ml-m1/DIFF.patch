@@ -0,0 +1,56 @@
+import numpy as np
+import pandas as pd
+
+from shelfwatch.churn_model import _split, evaluate, predict_next_month
+
+N_STORES = 400
+N_MONTHS = 10
+
+
+def _synthetic() -> pd.DataFrame:
+    rng = np.random.default_rng(1)
+    rows = []
+    for store in range(N_STORES):
+        plan = rng.choice(["basic", "plus", "pro"])
+        risk = rng.random()
+        for month in range(N_MONTHS):
+            tickets = rng.poisson(1 + 6 * risk)
+            rows.append(
+                {
+                    "account_id": store,
+                    "snapshot": pd.Timestamp("2025-01-01") + pd.DateOffset(months=month),
+                    "tenure_months": month + 5,
+                    "plan": plan,
+                    "store_id": store,
+                    "n_tickets": np.nan if tickets == 0 else float(tickets),
+                    "revenue": 1000 * (1 - risk) + rng.normal(0, 50),
+                    "churned": int(rng.random() < 0.02 + 0.2 * risk**3),
+                }
+            )
+    return pd.DataFrame(rows)
+
+
+def test_split_no_store_overlap_and_time_order() -> None:
+    df = _synthetic()
+    parts = _split(df)
+    train_stores = set(parts["train"]["store_id"])
+    assert not train_stores & set(parts["es"]["store_id"])
+    assert not train_stores & set(parts["valid"]["store_id"])
+    assert not set(parts["es"]["store_id"]) & set(parts["valid"]["store_id"])
+    assert parts["test"]["snapshot"].min() > parts["train"]["snapshot"].max()
+    assert df["snapshot"].max() not in set(parts["test"]["snapshot"])
+
+
+def test_evaluate_beats_base_rate() -> None:
+    report = evaluate(_synthetic())
+    assert report.best_model in {"random_forest", "xgboost"}
+    assert set(report.valid_pr_auc) == {"random_forest", "xgboost"}
+    assert report.test_pr_auc > report.test_base_rate
+
+
+def test_predict_next_month_shape_and_range() -> None:
+    df = _synthetic()
+    pred = predict_next_month(df)
+    assert len(pred) == N_STORES
+    assert pred.index.is_unique
+    assert pred.between(0, 1).all()
