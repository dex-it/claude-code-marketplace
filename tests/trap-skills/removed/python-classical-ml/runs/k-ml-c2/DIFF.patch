@@ -0,0 +1,98 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from shelfwatch.churn_model import (
+    FEATURES,
+    build_training_frame,
+    evaluate,
+    predict_next_month,
+    split_by_time,
+)
+
+FAST = {
+    "random_forest": {"n_estimators": 30, "n_jobs": 1},
+    "xgboost": {"n_estimators": 30, "n_jobs": 1},
+}
+
+
+def synthetic(n_stores: int = 400, n_months: int = 14, seed: int = 0) -> pd.DataFrame:
+    """Отток зависит от числа обращений и выручки; у части магазинов n_tickets пуст."""
+    rng = np.random.default_rng(seed)
+    months = pd.period_range("2025-01", periods=n_months, freq="M")
+    rows = []
+    for store in range(n_stores):
+        risky = rng.random() < 0.2
+        plan = rng.choice(["basic", "plus", "pro"])
+        gone = False
+        for i, m in enumerate(months):
+            if gone:
+                break
+            tickets = rng.poisson(6 if risky else 1)
+            rows.append(
+                {
+                    "account_id": store,
+                    "snapshot": m.to_timestamp(),
+                    "tenure_months": i + 12,
+                    "plan": plan,
+                    "store_id": store,
+                    "n_tickets": np.nan if tickets == 0 and rng.random() < 0.7 else tickets,
+                    "revenue": rng.normal(50 if risky else 100, 10),
+                    "churned": 0,
+                }
+            )
+            if risky and rng.random() < 0.25:
+                rows[-1]["churned"] = 1
+                gone = True
+    return pd.DataFrame(rows)
+
+
+def test_target_is_next_month_churn() -> None:
+    df = pd.DataFrame(
+        {
+            "store_id": [1, 1, 1, 2, 2],
+            "account_id": [1, 1, 1, 2, 2],
+            "snapshot": pd.to_datetime(["2025-01-01", "2025-02-01", "2025-03-01", "2025-01-01", "2025-03-01"]),
+            "tenure_months": 1,
+            "plan": "basic",
+            "n_tickets": [1.0, 2.0, 3.0, np.nan, 1.0],
+            "revenue": 10.0,
+            "churned": [0, 0, 1, 0, 0],
+        }
+    )
+    got = build_training_frame(df)
+    # магазин 1: янв->фев (0), фев->мар (1); магазин 2: пропуск месяца, пар нет
+    assert got["store_id"].tolist() == [1, 1]
+    assert got["target"].tolist() == [0, 1]
+
+
+def test_split_is_chronological() -> None:
+    train, val, test = split_by_time(build_training_frame(synthetic()))
+    assert train["month"].max() < val["month"].min()
+    assert val["month"].max() < test["month"].min()
+
+
+def test_missing_tickets_become_zero_with_flag() -> None:
+    data = build_training_frame(synthetic())
+    assert data[FEATURES].isna().sum().sum() == 0
+    assert (data.loc[data["no_tickets"] == 1, "n_tickets"] == 0).all()
+
+
+def test_evaluate_beats_base_rate() -> None:
+    report = evaluate(synthetic(), FAST)
+    assert report.best_model in {"random_forest", "xgboost"}
+    assert report.test_pr_auc > 2 * report.test_base_rate
+
+
+def test_predict_next_month() -> None:
+    df = synthetic()
+    pred = predict_next_month(df, "random_forest", FAST)
+    assert pred.index.is_unique
+    assert pred.between(0, 1).all()
+    still_active = df.groupby("store_id").tail(1).query("churned == 0")["store_id"]
+    assert set(pred.index) == set(still_active)
+
+
+def test_missing_columns() -> None:
+    with pytest.raises(ValueError):
+        evaluate(synthetic().drop(columns=["revenue"]), FAST)
