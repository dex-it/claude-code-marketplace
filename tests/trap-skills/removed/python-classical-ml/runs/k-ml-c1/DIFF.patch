+++ b/tests/test_churn_model.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from shelfwatch.churn_model import build_features, evaluate, predict_next_month
+
+
+def synthetic(n_stores: int = 300, n_months: int = 14, seed: int = 0) -> pd.DataFrame:
+    rng = np.random.default_rng(seed)
+    months = pd.period_range("2025-01", periods=n_months, freq="M").to_timestamp()
+    rows = []
+    for store in range(n_stores):
+        plan = rng.choice(["basic", "pro", "max"])
+        for i, month in enumerate(months):
+            tickets = float(rng.poisson(1 + 4 * (store % 10 == 0))) if rng.random() > 0.2 else np.nan
+            p = 0.02 + 0.4 * (np.nan_to_num(tickets) >= 5)
+            rows.append(
+                {
+                    "account_id": store,
+                    "snapshot": month,
+                    "tenure_months": i + 3,
+                    "plan": plan,
+                    "store_id": store,
+                    "n_tickets": tickets,
+                    "revenue": float(rng.normal(1000, 100)),
+                    "churned": int(rng.random() < p),
+                }
+            )
+    return pd.DataFrame(rows)
+
+
+def test_build_features_missing_tickets() -> None:
+    df = synthetic(5, 2)
+    x = build_features(df, ["basic", "max", "pro"])
+    assert not x.isna().any().any()
+    assert (x.loc[df["n_tickets"].isna(), "no_tickets"] == 1).all()
+    assert "store_id" not in x and "account_id" not in x
+
+
+def test_evaluate_beats_random() -> None:
+    report = evaluate(synthetic())
+    assert report.best_model in {"random_forest", "xgboost"}
+    assert set(report.valid_pr_auc) == {"random_forest", "xgboost"}
+    assert report.test_pr_auc > report.test_positive_rate
+
+
+def test_evaluate_needs_enough_months() -> None:
+    with pytest.raises(ValueError):
+        evaluate(synthetic(50, 5))
+
+
+def test_predict_next_month() -> None:
+    df = synthetic()
+    proba = predict_next_month(df)
+    last = df[df["snapshot"] == df["snapshot"].max()]
+    assert proba.index.is_unique
+    assert set(proba.index) == set(last.loc[last["churned"] == 0, "store_id"])
+    assert proba.between(0, 1).all()
