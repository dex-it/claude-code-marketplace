+"""Модель оттока магазинов: выбор между случайным лесом и XGBoost, прогноз на следующий месяц.
+
+Постановка: признаки среза магазина за месяц t -> отток (`churned`) в срезе за месяц t+1.
+Пары строятся только для подряд идущих месяцев одного магазина (`store_id`).
+Выбор модели и отчётная цифра считаются на разных периодах: модель выбирается по валидации,
+цифра для отчёта - на более позднем отложенном тесте, который в выборе не участвует.
+Метрика - PR-AUC (average precision): при доле оттока 5% accuracy и ROC-AUC вводят в заблуждение.
+"""
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+from sklearn.compose import ColumnTransformer
+from sklearn.ensemble import RandomForestClassifier
+from sklearn.metrics import average_precision_score
+from sklearn.pipeline import Pipeline
+from sklearn.preprocessing import OneHotEncoder
+from xgboost import XGBClassifier
+
+from shelfwatch.paths import DATA_DIR
+
+SEED = 42
+N_HOLDOUT_MONTHS = 3
+NUMERIC_FEATURES = ["tenure_months", "n_tickets", "revenue", "has_tickets"]
+CATEGORICAL_FEATURES = ["plan"]
+FEATURES = NUMERIC_FEATURES + CATEGORICAL_FEATURES
+MODEL_NAMES = ("random_forest", "xgboost")
+
+
+@dataclass(frozen=True)
+class ChurnReport:
+    best_model: str
+    test_pr_auc: float  # цифра для отчёта: PR-AUC выбранной модели на отложенном тесте
+    test_base_rate: float  # PR-AUC случайного ранжирования = доля оттока в тесте
+    val_pr_auc: dict[str, float]  # PR-AUC обеих моделей на валидации (по ним выбрана лучшая)
+
+
+def load_accounts() -> pd.DataFrame:
+    return pd.read_parquet(DATA_DIR / "accounts.parquet")
+
+
+def _month(df: pd.DataFrame) -> pd.Series:
+    return pd.to_datetime(df["snapshot"]).dt.to_period("M")
+
+
+def _add_features(df: pd.DataFrame) -> pd.DataFrame:
+    out = df.copy()
+    out["month"] = _month(out)
+    # пустой n_tickets - магазин ни разу не обращался в поддержку, то есть 0 обращений
+    out["has_tickets"] = out["n_tickets"].notna().astype(int)
+    out["n_tickets"] = out["n_tickets"].fillna(0)
+    return out
+
+
+def build_dataset(df: pd.DataFrame) -> pd.DataFrame:
+    """Пары (срез t, отток в t+1) по подряд идущим месяцам одного магазина."""
+    cur = _add_features(df).sort_values(["store_id", "month"])
+    nxt = cur[["store_id", "month", "churned"]].copy()
+    nxt["month"] = nxt["month"] - 1  # отток из среза t+1 присоединяется к срезу t
+    nxt = nxt.rename(columns={"churned": "target"})
+    pairs = cur.merge(nxt, on=["store_id", "month"], how="inner", validate="one_to_one")
+    return pairs.reset_index(drop=True)
+
+
+def split_by_time(
+    data: pd.DataFrame, n_holdout_months: int = N_HOLDOUT_MONTHS
+) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
+    """train / val / test по времени: тест - последние месяцы, валидация - предыдущие."""
+    months = sorted(data["month"].unique())
+    if len(months) < 3 * n_holdout_months:
+        raise ValueError(f"мало месяцев для разбиения: {len(months)}")
+    val_start = months[-2 * n_holdout_months]
+    test_start = months[-n_holdout_months]
+    train = data[data["month"] < val_start]
+    val = data[(data["month"] >= val_start) & (data["month"] < test_start)]
+    test = data[data["month"] >= test_start]
+    return train, val, test
+
+
+def make_model(name: str, y_train: pd.Series) -> Pipeline:
+    """Модель с учётом дисбаланса: веса классов у леса, scale_pos_weight у бустинга."""
+    prep = ColumnTransformer(
+        [
+            ("num", "passthrough", NUMERIC_FEATURES),
+            ("cat", OneHotEncoder(handle_unknown="ignore"), CATEGORICAL_FEATURES),
+        ]
+    )
+    if name == "random_forest":
+        clf = RandomForestClassifier(
+            n_estimators=300,
+            min_samples_leaf=5,
+            class_weight="balanced_subsample",
+            n_jobs=-1,
+            random_state=SEED,
+        )
+    elif name == "xgboost":
+        n_pos = int((y_train == 1).sum())
+        n_neg = int((y_train == 0).sum())
+        clf = XGBClassifier(
+            n_estimators=300,
+            max_depth=4,
+            learning_rate=0.05,
+            scale_pos_weight=n_neg / max(n_pos, 1),
+            eval_metric="aucpr",
+            n_jobs=-1,
+            random_state=SEED,
+        )
+    else:
+        raise ValueError(f"неизвестная модель: {name}")
+    return Pipeline([("prep", prep), ("clf", clf)])
+
+
+def _fit(name: str, data: pd.DataFrame) -> Pipeline:
+    model = make_model(name, data["target"])
+    model.fit(data[FEATURES], data["target"])
+    return model
+
+
+def _pr_auc(model: Pipeline, data: pd.DataFrame) -> float:
+    proba = model.predict_proba(data[FEATURES])[:, 1]
+    return float(average_precision_score(data["target"], proba))
+
+
+def evaluate(df: pd.DataFrame) -> ChurnReport:
+    """Выбирает лучшую модель по валидации и считает PR-AUC на отложенном тесте."""
+    train, val, test = split_by_time(build_dataset(df))
+    val_scores = {name: _pr_auc(_fit(name, train), val) for name in MODEL_NAMES}
+    best = max(val_scores, key=lambda name: val_scores[name])
+    # на тесте - модель, обученная на train+val: как будет в проде, но тест не виден
+    final = _fit(best, pd.concat([train, val]))
+    return ChurnReport(
+        best_model=best,
+        test_pr_auc=_pr_auc(final, test),
+        test_base_rate=float(test["target"].mean()),
+        val_pr_auc=val_scores,
+    )
+
+
+def predict_next_month(df: pd.DataFrame, model_name: str | None = None) -> pd.Series:
+    """Вероятность оттока на следующий месяц для магазинов из последнего среза.
+
+    Индекс - `store_id`. Если модель не задана, выбирается лучшая через `evaluate`;
+    обучение идёт на всей доступной истории пар (t, t+1).
+    """
+    if model_name is None:
+        model_name = evaluate(df).best_model
+    model = _fit(model_name, build_dataset(df))
+    feats = _add_features(df)
+    last = feats[feats["month"] == feats["month"].max()]
+    proba = model.predict_proba(last[FEATURES])[:, 1]
+    return pd.Series(proba, index=pd.Index(last["store_id"].to_numpy(), name="store_id"), name="churn_proba")
+
+
+def main() -> None:
+    report = evaluate(load_accounts())
+    print(f"лучшая модель: {report.best_model}")
+    print(f"PR-AUC на тесте: {report.test_pr_auc:.3f} (случайно: {report.test_base_rate:.3f})")
+    print(f"PR-AUC на валидации: {report.val_pr_auc}")
+
+
+if __name__ == "__main__":
+    main()
