@@ -0,0 +1,102 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from shelfwatch.churn_model import (
+    FEATURES,
+    MODEL_NAMES,
+    build_dataset,
+    evaluate,
+    make_model,
+    predict_next_month,
+    split_by_time,
+)
+
+N_STORES = 400
+N_MONTHS = 14
+
+
+def synthetic_accounts(seed: int = 0) -> pd.DataFrame:
+    """Отток ~5%, зависит от числа обращений; n_tickets пуст у части строк."""
+    rng = np.random.default_rng(seed)
+    rows = []
+    for store in range(N_STORES):
+        plan = rng.choice(["basic", "plus", "pro"])
+        for m in range(N_MONTHS):
+            tickets = rng.poisson(1.0)
+            logit = -4.5 + 0.8 * tickets
+            churned = int(rng.random() < 1 / (1 + np.exp(-logit)))
+            rows.append(
+                {
+                    "account_id": store * 100 + m,
+                    "snapshot": pd.Timestamp("2025-01-01") + pd.DateOffset(months=m),
+                    "tenure_months": m + 5,
+                    "plan": plan,
+                    "store_id": store,
+                    "n_tickets": np.nan if tickets == 0 else float(tickets),
+                    "revenue": float(rng.gamma(2.0, 500.0)),
+                    "churned": churned,
+                }
+            )
+    return pd.DataFrame(rows)
+
+
+def test_build_dataset_uses_next_month_label() -> None:
+    df = pd.DataFrame(
+        {
+            "account_id": [1, 2, 3, 4],
+            "snapshot": ["2025-01-01", "2025-02-01", "2025-04-01", "2025-01-01"],
+            "tenure_months": [1, 2, 4, 1],
+            "plan": ["basic"] * 4,
+            "store_id": [7, 7, 7, 8],
+            "n_tickets": [np.nan, 2.0, 1.0, 1.0],
+            "revenue": [1.0, 2.0, 3.0, 4.0],
+            "churned": [0, 1, 0, 0],
+        }
+    )
+    data = build_dataset(df)
+    # пара только одна: (магазин 7, январь) -> отток в феврале; пропуск марта пары не даёт
+    assert len(data) == 1
+    assert data.loc[0, "store_id"] == 7
+    assert data.loc[0, "target"] == 1
+    assert data.loc[0, "n_tickets"] == 0
+    assert data.loc[0, "has_tickets"] == 0
+
+
+def test_split_by_time_has_no_overlap_and_is_ordered() -> None:
+    train, val, test = split_by_time(build_dataset(synthetic_accounts()))
+    assert train["month"].max() < val["month"].min()
+    assert val["month"].max() < test["month"].min()
+
+
+def test_split_by_time_rejects_short_history() -> None:
+    data = build_dataset(synthetic_accounts())
+    data = data[data["month"] < data["month"].min() + 4]
+    with pytest.raises(ValueError):
+        split_by_time(data)
+
+
+def test_models_are_class_weighted() -> None:
+    y = pd.Series([0] * 95 + [1] * 5)
+    rf = make_model("random_forest", y)
+    xgb = make_model("xgboost", y)
+    assert rf.named_steps["clf"].class_weight == "balanced_subsample"
+    assert xgb.named_steps["clf"].scale_pos_weight == pytest.approx(19.0)
+
+
+def test_evaluate_beats_base_rate() -> None:
+    report = evaluate(synthetic_accounts())
+    assert report.best_model in MODEL_NAMES
+    assert set(report.val_pr_auc) == set(MODEL_NAMES)
+    assert report.test_pr_auc > report.test_base_rate
+
+
+@pytest.mark.parametrize("name", MODEL_NAMES)
+def test_predict_next_month_returns_probabilities_for_last_snapshot(name: str) -> None:
+    df = synthetic_accounts()
+    proba = predict_next_month(df, model_name=name)
+    assert proba.index.name == "store_id"
+    assert len(proba) == N_STORES
+    assert proba.between(0, 1).all()
+    assert not proba.isna().any()
+    assert set(FEATURES) <= set(build_dataset(df).columns)
