+      </bpmn:userTask>
+      <bpmn:endEvent id="End_Paid" name="Бронь подтверждена (outcome = CONFIRMED)">
+        <bpmn:incoming>P7a</bpmn:incoming>
+        <bpmn:incoming>P8</bpmn:incoming>
+      </bpmn:endEvent>
+
+      <bpmn:serviceTask id="Task_ReleaseHoldTimeout" name="Снять холд">
+        <bpmn:documentation>Слот снова свободен.</bpmn:documentation>
+        <bpmn:incoming>P9</bpmn:incoming>
+        <bpmn:outgoing>P10</bpmn:outgoing>
+      </bpmn:serviceTask>
+      <bpmn:sendTask id="Task_NotifyTimeout" name="Сообщить ученику о тайм-ауте">
+        <bpmn:incoming>P10</bpmn:incoming>
+        <bpmn:outgoing>P11</bpmn:outgoing>
+      </bpmn:sendTask>
+      <bpmn:endEvent id="End_TimeoutIn" name="Холд снят по тайм-ауту (outcome = TIMEOUT)">
+        <bpmn:incoming>P11</bpmn:incoming>
+      </bpmn:endEvent>
+
+      <bpmn:serviceTask id="Task_ReleaseHoldError" name="Снять холд">
+        <bpmn:documentation>Сразу, не дожидаясь 15 минут.</bpmn:documentation>
+        <bpmn:incoming>P12</bpmn:incoming>
+        <bpmn:outgoing>P13</bpmn:outgoing>
+      </bpmn:serviceTask>
+      <bpmn:sendTask id="Task_NotifyPayError" name="Сообщить ученику об ошибке оплаты">
+        <bpmn:incoming>P13</bpmn:incoming>
+        <bpmn:outgoing>P14</bpmn:outgoing>
+      </bpmn:sendTask>
+      <bpmn:endEvent id="End_ErrorIn" name="Оплата не прошла (outcome = PAYMENT_ERROR)">
+        <bpmn:incoming>P14</bpmn:incoming>
+      </bpmn:endEvent>
+
+      <bpmn:sequenceFlow id="P1" sourceRef="Start_P" targetRef="Task_RequestPayment"/>
+      <bpmn:sequenceFlow id="P2" sourceRef="Task_RequestPayment" targetRef="Gw_Event"/>
+      <bpmn:sequenceFlow id="P3" sourceRef="Gw_Event" targetRef="Catch_Paid"/>
+      <bpmn:sequenceFlow id="P4" sourceRef="Gw_Event" targetRef="Catch_Timeout"/>
+      <bpmn:sequenceFlow id="P5" sourceRef="Gw_Event" targetRef="Catch_PayError"/>
+      <bpmn:sequenceFlow id="P6" sourceRef="Catch_Paid" targetRef="Gw_Price"/>
+      <bpmn:sequenceFlow id="P7" name="Да: цена &gt; 3 000 ₽" sourceRef="Gw_Price" targetRef="Task_ManualConfirm">
+        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lesson.price &gt; 3000}</bpmn:conditionExpression>
+      </bpmn:sequenceFlow>
+      <bpmn:sequenceFlow id="P7a" sourceRef="Task_ManualConfirm" targetRef="End_Paid"/>
+      <bpmn:sequenceFlow id="P8" name="Нет: цена ≤ 3 000 ₽, подтверждается сразу" sourceRef="Gw_Price" targetRef="End_Paid"/>
+      <bpmn:sequenceFlow id="P9" sourceRef="Catch_Timeout" targetRef="Task_ReleaseHoldTimeout"/>
+      <bpmn:sequenceFlow id="P10" sourceRef="Task_ReleaseHoldTimeout" targetRef="Task_NotifyTimeout"/>
+      <bpmn:sequenceFlow id="P11" sourceRef="Task_NotifyTimeout" targetRef="End_TimeoutIn"/>
+      <bpmn:sequenceFlow id="P12" sourceRef="Catch_PayError" targetRef="Task_ReleaseHoldError"/>
+      <bpmn:sequenceFlow id="P13" sourceRef="Task_ReleaseHoldError" targetRef="Task_NotifyPayError"/>
+      <bpmn:sequenceFlow id="P14" sourceRef="Task_NotifyPayError" targetRef="End_ErrorIn"/>
+    </bpmn:subProcess>
+
+    <bpmn:sendTask id="Task_NotifyTutorHold" name="Уведомить репетитора: слот на удержании">
+      <bpmn:incoming>F4</bpmn:incoming>
+      <bpmn:outgoing>F6</bpmn:outgoing>
+    </bpmn:sendTask>
+
+    <bpmn:parallelGateway id="Gw_Join" name="Оплата и уведомление завершены">
+      <bpmn:incoming>F5</bpmn:incoming>
+      <bpmn:incoming>F6</bpmn:incoming>
+      <bpmn:outgoing>F7</bpmn:outgoing>
+    </bpmn:parallelGateway>
+    <bpmn:exclusiveGateway id="Gw_Outcome" name="Чем закончилась оплата?">
+      <bpmn:incoming>F7</bpmn:incoming>
+      <bpmn:outgoing>F8</bpmn:outgoing>
+      <bpmn:outgoing>F10</bpmn:outgoing>
+      <bpmn:outgoing>F11</bpmn:outgoing>
+    </bpmn:exclusiveGateway>
+
+    <bpmn:subProcess id="Sub_Finalize" name="Завершить подтверждённую бронь">
+      <bpmn:incoming>F8</bpmn:incoming>
+      <bpmn:outgoing>F9</bpmn:outgoing>
+
+      <bpmn:startEvent id="Start_F">
+        <bpmn:outgoing>G1</bpmn:outgoing>
+      </bpmn:startEvent>
+      <bpmn:parallelGateway id="Gw_FSplit">
+        <bpmn:incoming>G1</bpmn:incoming>
+        <bpmn:outgoing>G2</bpmn:outgoing>
+        <bpmn:outgoing>G3</bpmn:outgoing>
+        <bpmn:outgoing>G4</bpmn:outgoing>
+      </bpmn:parallelGateway>
+      <bpmn:sendTask id="Task_EmailStudent" name="Отправить письмо ученику">
+        <bpmn:incoming>G2</bpmn:incoming>
+        <bpmn:outgoing>G5</bpmn:outgoing>
+      </bpmn:sendTask>
+      <bpmn:sendTask id="Task_EmailTutor" name="Отправить письмо репетитору">
+        <bpmn:incoming>G3</bpmn:incoming>
+        <bpmn:outgoing>G6</bpmn:outgoing>
+      </bpmn:sendTask>
+      <bpmn:inclusiveGateway id="Gw_Opt" name="Что ещё нужно сделать?" default="G9">
+        <bpmn:incoming>G4</bpmn:incoming>
+        <bpmn:outgoing>G7</bpmn:outgoing>
+        <bpmn:outgoing>G8</bpmn:outgoing>
+        <bpmn:outgoing>G9</bpmn:outgoing>
+      </bpmn:inclusiveGateway>
+      <bpmn:sendTask id="Task_SendNewbieMemo" name="Отправить памятку новичка">
+        <bpmn:incoming>G7</bpmn:incoming>
+        <bpmn:outgoing>G10</bpmn:outgoing>
+      </bpmn:sendTask>
+      <bpmn:serviceTask id="Task_RedeemPromo" name="Погасить промокод">
+        <bpmn:incoming>G8</bpmn:incoming>
+        <bpmn:outgoing>G11</bpmn:outgoing>
+      </bpmn:serviceTask>
+      <bpmn:inclusiveGateway id="Gw_OptJoin">
+        <bpmn:incoming>G9</bpmn:incoming>
+        <bpmn:incoming>G10</bpmn:incoming>
+        <bpmn:incoming>G11</bpmn:incoming>
+        <bpmn:outgoing>G12</bpmn:outgoing>
+      </bpmn:inclusiveGateway>
+      <bpmn:parallelGateway id="Gw_FJoin">
+        <bpmn:incoming>G5</bpmn:incoming>
+        <bpmn:incoming>G6</bpmn:incoming>
+        <bpmn:incoming>G12</bpmn:incoming>
+        <bpmn:outgoing>G13</bpmn:outgoing>
+      </bpmn:parallelGateway>
+      <bpmn:endEvent id="End_F">
+        <bpmn:incoming>G13</bpmn:incoming>
+      </bpmn:endEvent>
+
+      <bpmn:sequenceFlow id="G1" sourceRef="Start_F" targetRef="Gw_FSplit"/>
+      <bpmn:sequenceFlow id="G2" sourceRef="Gw_FSplit" targetRef="Task_EmailStudent"/>
+      <bpmn:sequenceFlow id="G3" sourceRef="Gw_FSplit" targetRef="Task_EmailTutor"/>
+      <bpmn:sequenceFlow id="G4" sourceRef="Gw_FSplit" targetRef="Gw_Opt"/>
+      <bpmn:sequenceFlow id="G5" sourceRef="Task_EmailStudent" targetRef="Gw_FJoin"/>
+      <bpmn:sequenceFlow id="G6" sourceRef="Task_EmailTutor" targetRef="Gw_FJoin"/>
+      <bpmn:sequenceFlow id="G7" name="Первый урок ученика" sourceRef="Gw_Opt" targetRef="Task_SendNewbieMemo">
+        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${student.isFirstLesson}</bpmn:conditionExpression>
+      </bpmn:sequenceFlow>
+      <bpmn:sequenceFlow id="G8" name="В брони есть промокод" sourceRef="Gw_Opt" targetRef="Task_RedeemPromo">
+        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${booking.promoCode != null}</bpmn:conditionExpression>
+      </bpmn:sequenceFlow>
+      <bpmn:sequenceFlow id="G9" name="Ни первого урока, ни промокода" sourceRef="Gw_Opt" targetRef="Gw_OptJoin"/>
+      <bpmn:sequenceFlow id="G10" sourceRef="Task_SendNewbieMemo" targetRef="Gw_OptJoin"/>
+      <bpmn:sequenceFlow id="G11" sourceRef="Task_RedeemPromo" targetRef="Gw_OptJoin"/>
+      <bpmn:sequenceFlow id="G12" sourceRef="Gw_OptJoin" targetRef="Gw_FJoin"/>
+      <bpmn:sequenceFlow id="G13" sourceRef="Gw_FJoin" targetRef="End_F"/>
+    </bpmn:subProcess>
+
+    <bpmn:endEvent id="End_Confirmed" name="Бронь подтверждена">
+      <bpmn:incoming>F9</bpmn:incoming>
+    </bpmn:endEvent>
+    <bpmn:endEvent id="End_Timeout" name="Холд снят по тайм-ауту">
+      <bpmn:incoming>F10</bpmn:incoming>
+    </bpmn:endEvent>
+    <bpmn:endEvent id="End_PayError" name="Оплата не прошла">
+      <bpmn:incoming>F11</bpmn:incoming>
+    </bpmn:endEvent>
+
+    <bpmn:sequenceFlow id="F1" sourceRef="Start_Request" targetRef="Task_HoldSlot"/>
+    <bpmn:sequenceFlow id="F2" sourceRef="Task_HoldSlot" targetRef="Gw_Split"/>
+    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Split" targetRef="Sub_Payment"/>
+    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Split" targetRef="Task_NotifyTutorHold"/>
+    <bpmn:sequenceFlow id="F5" sourceRef="Sub_Payment" targetRef="Gw_Join"/>
+    <bpmn:sequenceFlow id="F6" sourceRef="Task_NotifyTutorHold" targetRef="Gw_Join"/>
+    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Join" targetRef="Gw_Outcome"/>
+    <bpmn:sequenceFlow id="F8" name="Оплата подтверждена" sourceRef="Gw_Outcome" targetRef="Sub_Finalize">
+      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'CONFIRMED'}</bpmn:conditionExpression>
+    </bpmn:sequenceFlow>
+    <bpmn:sequenceFlow id="F9" sourceRef="Sub_Finalize" targetRef="End_Confirmed"/>
+    <bpmn:sequenceFlow id="F10" name="Холд истёк" sourceRef="Gw_Outcome" targetRef="End_Timeout">
+      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'TIMEOUT'}</bpmn:conditionExpression>
+    </bpmn:sequenceFlow>
+    <bpmn:sequenceFlow id="F11" name="Ошибка PayFlow" sourceRef="Gw_Outcome" targetRef="End_PayError">
+      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outcome == 'PAYMENT_ERROR'}</bpmn:conditionExpression>
+    </bpmn:sequenceFlow>
+  </bpmn:process>
+</bpmn:definitions>
