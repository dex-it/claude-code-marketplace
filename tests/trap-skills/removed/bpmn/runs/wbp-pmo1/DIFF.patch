+<?xml version="1.0" encoding="UTF-8"?>
+<!-- CM-40. Бронирование урока, TO-BE. Источник: docs/process/booking-notes.md (2026-10-11). Без диаграммной части DI. -->
+<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
+                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+                  id="Definitions_Booking"
+                  targetNamespace="https://classmate.example/bpmn/booking">
+
+  <bpmn:message id="Msg_BookingRequest" name="Запрос на бронь слота"/>
+  <bpmn:message id="Msg_PaymentConfirmed" name="Оплата подтверждена (PayFlow)"/>
+  <bpmn:message id="Msg_PaymentError" name="Ошибка оплаты (PayFlow)"/>
+
+  <bpmn:collaboration id="Collab_Booking">
+    <bpmn:participant id="Part_Student" name="Ученик"/>
+    <bpmn:participant id="Part_Classmate" name="Платформа Classmate" processRef="Process_Booking"/>
+    <bpmn:participant id="Part_PayFlow" name="Платёжный провайдер PayFlow"/>
+    <bpmn:participant id="Part_Tutor" name="Репетитор"/>
+
+    <bpmn:messageFlow id="MF_Request" name="Выбран слот, «Забронировать»" sourceRef="Part_Student" targetRef="Start_Request"/>
+    <bpmn:messageFlow id="MF_PayRequest" name="Запрос оплаты" sourceRef="Task_RequestPayment" targetRef="Part_PayFlow"/>
+    <bpmn:messageFlow id="MF_Paid" name="Подтверждение оплаты" sourceRef="Part_PayFlow" targetRef="Catch_Paid"/>
+    <bpmn:messageFlow id="MF_PayErr" name="Ошибка на запрос оплаты" sourceRef="Part_PayFlow" targetRef="Catch_PayError"/>
+    <bpmn:messageFlow id="MF_TutorHold" name="Слот на удержании" sourceRef="Task_NotifyTutorHold" targetRef="Part_Tutor"/>
+    <bpmn:messageFlow id="MF_StudentTimeout" name="Время на оплату вышло" sourceRef="Task_NotifyTimeout" targetRef="Part_Student"/>
+    <bpmn:messageFlow id="MF_StudentPayError" name="Оплата не прошла, попробуйте ещё раз" sourceRef="Task_NotifyPayError" targetRef="Part_Student"/>
+    <bpmn:messageFlow id="MF_StudentEmail" name="Письмо: бронь подтверждена" sourceRef="Task_EmailStudent" targetRef="Part_Student"/>
+    <bpmn:messageFlow id="MF_TutorEmail" name="Письмо: бронь подтверждена" sourceRef="Task_EmailTutor" targetRef="Part_Tutor"/>
+    <bpmn:messageFlow id="MF_Memo" name="Памятка новичка" sourceRef="Task_SendNewbieMemo" targetRef="Part_Student"/>
+  </bpmn:collaboration>
+
+  <bpmn:process id="Process_Booking" name="Бронирование урока" isExecutable="false">
+    <bpmn:documentation>Свойство outcome (CONFIRMED | TIMEOUT | PAYMENT_ERROR) выставляется концевыми событиями подпроцесса Sub_Payment и читается шлюзом Gw_Outcome.</bpmn:documentation>
+    <bpmn:property id="Prop_outcome" name="outcome"/>
+
+    <bpmn:startEvent id="Start_Request" name="Ученик нажал «Забронировать»">
+      <bpmn:outgoing>F1</bpmn:outgoing>
+      <bpmn:messageEventDefinition messageRef="Msg_BookingRequest"/>
+    </bpmn:startEvent>
+    <bpmn:serviceTask id="Task_HoldSlot" name="Поставить холд на слот">
+      <bpmn:documentation>Холд на 15 минут. Фиксируется holdExpiresAt = момент холда + 15 минут.</bpmn:documentation>
+      <bpmn:incoming>F1</bpmn:incoming>
+      <bpmn:outgoing>F2</bpmn:outgoing>
+    </bpmn:serviceTask>
+    <bpmn:parallelGateway id="Gw_Split" name="Параллельно: оплата и уведомление">
+      <bpmn:incoming>F2</bpmn:incoming>
+      <bpmn:outgoing>F3</bpmn:outgoing>
+      <bpmn:outgoing>F4</bpmn:outgoing>
+    </bpmn:parallelGateway>
+
+    <bpmn:subProcess id="Sub_Payment" name="Получить результат оплаты">
+      <bpmn:incoming>F3</bpmn:incoming>
+      <bpmn:outgoing>F5</bpmn:outgoing>
+
+      <bpmn:startEvent id="Start_P">
+        <bpmn:outgoing>P1</bpmn:outgoing>
+      </bpmn:startEvent>
+      <bpmn:sendTask id="Task_RequestPayment" name="Запросить оплату у PayFlow">
+        <bpmn:incoming>P1</bpmn:incoming>
+        <bpmn:outgoing>P2</bpmn:outgoing>
+      </bpmn:sendTask>
+      <bpmn:eventBasedGateway id="Gw_Event" name="Что раньше?">
+        <bpmn:incoming>P2</bpmn:incoming>
+        <bpmn:outgoing>P3</bpmn:outgoing>
+        <bpmn:outgoing>P4</bpmn:outgoing>
+        <bpmn:outgoing>P5</bpmn:outgoing>
+      </bpmn:eventBasedGateway>
+      <bpmn:intermediateCatchEvent id="Catch_Paid" name="Оплата подтверждена">
+        <bpmn:incoming>P3</bpmn:incoming>
+        <bpmn:outgoing>P6</bpmn:outgoing>
+        <bpmn:messageEventDefinition messageRef="Msg_PaymentConfirmed"/>
+      </bpmn:intermediateCatchEvent>
+      <bpmn:intermediateCatchEvent id="Catch_Timeout" name="Холд истёк (15 минут)">
+        <bpmn:incoming>P4</bpmn:incoming>
+        <bpmn:outgoing>P9</bpmn:outgoing>
+        <bpmn:timerEventDefinition>
+          <bpmn:timeDate>${holdExpiresAt}</bpmn:timeDate>
+        </bpmn:timerEventDefinition>
+      </bpmn:intermediateCatchEvent>
+      <bpmn:intermediateCatchEvent id="Catch_PayError" name="PayFlow вернул ошибку">
+        <bpmn:incoming>P5</bpmn:incoming>
+        <bpmn:outgoing>P12</bpmn:outgoing>
+        <bpmn:messageEventDefinition messageRef="Msg_PaymentError"/>
+      </bpmn:intermediateCatchEvent>
+
+      <bpmn:exclusiveGateway id="Gw_Price" name="Урок дороже 3 000 ₽?" default="P8">
+        <bpmn:incoming>P6</bpmn:incoming>
+        <bpmn:outgoing>P7</bpmn:outgoing>
+        <bpmn:outgoing>P8</bpmn:outgoing>
+      </bpmn:exclusiveGateway>
+      <bpmn:userTask id="Task_ManualConfirm" name="Подтвердить бронь вручную">
+        <bpmn:documentation>Исполнитель: репетитор, в кабинете.</bpmn:documentation>
+        <bpmn:incoming>P7</bpmn:incoming>
+        <bpmn:outgoing>P7a</bpmn:outgoing>
+        <bpmn:humanPerformer>
+          <bpmn:resourceAssignmentExpression>
+            <bpmn:formalExpression>lesson.tutor</bpmn:formalExpression>
+          </bpmn:resourceAssignmentExpression>
