+    <sequenceFlow id="F33" sourceRef="Task_ReleaseHoldError" targetRef="Task_NotifyPayFailed"/>
+    <sendTask id="Task_NotifyPayFailed" name="Сообщить ученику: «оплата не прошла, попробуйте ещё раз»" messageRef="Msg_PayFailed"/>
+    <sequenceFlow id="F34" sourceRef="Task_NotifyPayFailed" targetRef="End_PayFailed"/>
+    <endEvent id="End_PayFailed" name="Оплата не прошла"/>
+  </process>
