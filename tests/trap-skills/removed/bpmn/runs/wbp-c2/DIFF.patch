+    </sequenceFlow>
+    <sequenceFlow id="F26" name="ничего из этого" sourceRef="Gw_Extras" targetRef="Gw_ExtrasJoin"/>
+
+    <sendTask id="Task_SendMemo" name="Отправить ученику памятку новичка" messageRef="Msg_Memo"/>
+    <task id="Task_RedeemPromo" name="Погасить промокод"/>
+    <sequenceFlow id="F27" sourceRef="Task_SendMemo" targetRef="Gw_ExtrasJoin"/>
+    <sequenceFlow id="F28" sourceRef="Task_RedeemPromo" targetRef="Gw_ExtrasJoin"/>
+
+    <inclusiveGateway id="Gw_ExtrasJoin"/>
+    <sequenceFlow id="F29" sourceRef="Gw_ExtrasJoin" targetRef="Join_Confirmed"/>
+
+    <parallelGateway id="Join_Confirmed"/>
+    <sequenceFlow id="F30" sourceRef="Join_Confirmed" targetRef="End_Confirmed"/>
