new file mode 100644
index 0000000..9e54a19
--- /dev/null
+++ b/test/order.test.js
@@ -0,0 +1,217 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  OrderStateError, createOrder, pay, pack, ship, deliver, cancel, returnOrder,
+} from '../src/order.js';
+
+const DAY = 24 * 60 * 60 * 1000;
+const T0 = new Date('2026-10-01T10:00:00.000Z');
+
+function newOrder(extra = {}) {
+  return createOrder({
+    id: 7,
+    customerId: 1,
+    customer: { name: 'Мария Белова', phone: '+79213456703' },
+    address: { postcode: '101000', line: 'Москва, Тверская, 1' },
+    items: [{ sku: 'A-1', qty: 2 }],
+    weightKg: 1.2,
+    ...extra,
+  });
+}
+
+function fakes() {
+  const refunds = [];
+  const released = [];
+  return {
+    refunds,
+    released,
+    payments: { refund: (id, kopecks) => refunds.push([id, kopecks]) },
+    stock: { release: (items) => released.push(items) },
+  };
+}
+
+function orderIn(status) {
+  const o = newOrder();
+  const steps = ['created', 'paid', 'packed', 'shipped', 'delivered'];
+  const fns = [pay, pack, (x) => ship(x, { trackingNumber: 'TN1' }), (x) => deliver(x, { at: T0 })];
+  for (let i = 0; i < steps.indexOf(status); i += 1) fns[i](o);
+  return o;
+}
+
+const throwsState = (fn, code) =>
+  assert.throws(fn, (e) => e instanceof OrderStateError && e.code === code);
+
+test('createOrder: статус created, сумма и зона по тарифу', () => {
+  const o = newOrder();
+  assert.equal(o.status, 'created');
+  assert.equal(o.zone, 'A');
+  assert.equal(o.totalKopecks, 36000);
+  assert.deepEqual(o.history, []);
+});
+
+test('createOrder: зона B и опции учитываются в сумме', () => {
+  const o = newOrder({ address: { postcode: '190121', line: 'СПб' }, express: true, fragile: true });
+  assert.equal(o.zone, 'B');
+  // 3 * 150 * 1.5 + 600 = 1275 ₽
+  assert.equal(o.totalKopecks, 127500);
+});
+
+test('цепочка переходов: created -> paid -> packed -> shipped -> delivered, история пишется', () => {
+  const o = newOrder();
+  assert.equal(pay(o), o);
+  assert.equal(o.status, 'paid');
+  pack(o);
+  assert.equal(o.status, 'packed');
+  ship(o, { trackingNumber: 'TN1' });
+  assert.equal(o.status, 'shipped');
+  assert.equal(o.trackingNumber, 'TN1');
+  deliver(o, { at: T0 });
+  assert.equal(o.status, 'delivered');
+  assert.equal(o.deliveredAt, T0.toISOString());
+  assert.deepEqual(o.history.map((h) => h.status), ['paid', 'packed', 'shipped', 'delivered']);
+  assert.equal(o.history[3].at, T0.toISOString());
+  for (const h of o.history) assert.ok(!Number.isNaN(Date.parse(h.at)));
+});
+
+test('пропуск шага - TRANSITION, заказ не меняется', () => {
+  const cases = [
+    ['created', (o) => pack(o)],
+    ['created', (o) => ship(o, { trackingNumber: 'X' })],
+    ['created', (o) => deliver(o, { at: T0 })],
+    ['paid', (o) => ship(o, { trackingNumber: 'X' })],
+    ['paid', (o) => deliver(o, { at: T0 })],
+    ['packed', (o) => deliver(o, { at: T0 })],
+  ];
+  for (const [status, act] of cases) {
+    const o = orderIn(status);
+    const before = structuredClone(o);
+    throwsState(() => act(o), 'TRANSITION');
+    assert.deepEqual(o, before, status);
+  }
+});
+
+test('повтор шага - TRANSITION, заказ не меняется', () => {
+  const cases = [
+    ['paid', (o) => pay(o)],
+    ['packed', (o) => pack(o)],
+    ['shipped', (o) => ship(o, { trackingNumber: 'X' })],
+    ['delivered', (o) => deliver(o, { at: T0 })],
+  ];
+  for (const [status, act] of cases) {
+    const o = orderIn(status);
+    const before = structuredClone(o);
+    throwsState(() => act(o), 'TRANSITION');
+    assert.deepEqual(o, before, status);
+  }
+});
+
+test('движение назад - TRANSITION, заказ не меняется', () => {
+  const cases = [
+    ['packed', (o) => pay(o)],
+    ['shipped', (o) => pack(o)],
+    ['delivered', (o) => pay(o)],
+    ['delivered', (o) => ship(o, { trackingNumber: 'X' })],
+  ];
+  for (const [status, act] of cases) {
+    const o = orderIn(status);
+    const before = structuredClone(o);
+    throwsState(() => act(o), 'TRANSITION');
+    assert.deepEqual(o, before, status);
+  }
+});
+
+test('переходы из отменённого и возвращённого заказов - TRANSITION', () => {
+  const cancelled = newOrder();
+  cancel(cancelled, fakes());
+  const returned = orderIn('delivered');
+  returnOrder(returned, { now: new Date(T0.getTime() + DAY), payments: fakes().payments });
+  for (const o of [cancelled, returned]) {
+    for (const act of [pay, pack, (x) => ship(x, { trackingNumber: 'X' }), (x) => deliver(x, { at: T0 })]) {
+      throwsState(() => act(o), 'TRANSITION');
+    }
+  }
+});
+
+test('отмена created: резерв снимается, деньги не возвращаются', () => {
+  const o = newOrder();
+  const f = fakes();
+  assert.equal(cancel(o, f), o);
+  assert.equal(o.status, 'cancelled');
+  assert.deepEqual(f.refunds, []);
+  assert.deepEqual(f.released, [o.items]);
+  assert.equal(o.history.at(-1).status, 'cancelled');
+});
+
+test('отмена paid и packed: возврат totalKopecks и снятие резерва', () => {
+  for (const status of ['paid', 'packed']) {
+    const o = orderIn(status);
+    const f = fakes();
+    cancel(o, f);
+    assert.equal(o.status, 'cancelled', status);
+    assert.deepEqual(f.refunds, [[7, 36000]], status);
+    assert.deepEqual(f.released, [o.items], status);
+  }
+});
+
+test('отмена shipped, delivered, cancelled, returned - CANCEL_FORBIDDEN, ничего не трогается', () => {
+  const cancelled = newOrder();
+  cancel(cancelled, fakes());
+  const returned = orderIn('delivered');
+  returnOrder(returned, { now: new Date(T0.getTime() + DAY), payments: fakes().payments });
+  for (const o of [orderIn('shipped'), orderIn('delivered'), cancelled, returned]) {
+    const status = o.status;
+    const before = structuredClone(o);
+    const f = fakes();
+    throwsState(() => cancel(o, f), 'CANCEL_FORBIDDEN');
+    assert.deepEqual(o, before, status);
+    assert.deepEqual(f.refunds, [], status);
+    assert.deepEqual(f.released, [], status);
+  }
+});
+
+test('возврат доставленного заказа в окне: деньги возвращаются, статус returned', () => {
+  const o = orderIn('delivered');
+  const f = fakes();
+  const now = new Date(T0.getTime() + 3 * DAY);
+  assert.equal(returnOrder(o, { now, payments: f.payments }), o);
+  assert.equal(o.status, 'returned');
+  assert.deepEqual(f.refunds, [[7, 36000]]);
+  assert.deepEqual(o.history.at(-1), { status: 'returned', at: now.toISOString() });
+});
+
+test('возврат: на 14-е сутки принимается', () => {
+  for (const offset of [14 * DAY, 14 * DAY + 23 * 3600e3 + 59 * 60e3]) {
+    const o = orderIn('delivered');
+    const f = fakes();
+    returnOrder(o, { now: new Date(T0.getTime() + offset), payments: f.payments });
+    assert.equal(o.status, 'returned');
+    assert.equal(f.refunds.length, 1);
+  }
+});
+
+test('возврат: на 15-е сутки - RETURN_FORBIDDEN, заказ и деньги не меняются', () => {
+  for (const offset of [15 * DAY, 15 * DAY + 1, 30 * DAY]) {
+    const o = orderIn('delivered');
+    const before = structuredClone(o);
+    const f = fakes();
+    throwsState(() => returnOrder(o, { now: new Date(T0.getTime() + offset), payments: f.payments }), 'RETURN_FORBIDDEN');
+    assert.deepEqual(o, before);
+    assert.deepEqual(f.refunds, []);
+  }
+});
+
+test('возврат не из delivered - RETURN_FORBIDDEN, заказ и деньги не меняются', () => {
+  const cancelled = newOrder();
+  cancel(cancelled, fakes());
+  const returned = orderIn('delivered');
+  returnOrder(returned, { now: new Date(T0.getTime() + DAY), payments: fakes().payments });
+  const orders = ['created', 'paid', 'packed', 'shipped'].map(orderIn).concat(cancelled, returned);
+  for (const o of orders) {
+    const status = o.status;
+    const before = structuredClone(o);
+    const f = fakes();
+    throwsState(() => returnOrder(o, { now: new Date(T0.getTime() + DAY), payments: f.payments }), 'RETURN_FORBIDDEN');
+    assert.deepEqual(o, before, status);
+    assert.deepEqual(f.refunds, [], status);
+  }
+});
diff --git a/test/tariff.test.js b/test/tariff.test.js
new file mode 100644
index 0000000..ef53415
--- /dev/null
+++ b/test/tariff.test.js
@@ -0,0 +1,109 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { TariffError, zoneForPostcode, billableUnits, quote, deliveryDays } from '../src/tariff.js';
+
+const A = '101000';
+const B = '190121';
+const C = '630000';
+
+const throwsCode = (fn, code) =>
+  assert.throws(fn, (e) => e instanceof TariffError && e.code === code);
+
+test('зона A: индексы 10xxxx - 14xxxx', () => {
+  for (const p of ['100000', '101000', '141234', '149999']) assert.equal(zoneForPostcode(p), 'A', p);
+});
+
+test('зона B: индексы 19xxxx', () => {
+  for (const p of ['190000', '190121', '199999']) assert.equal(zoneForPostcode(p), 'B', p);
+});
+
+test('зона C: прочие шестизначные, включая 15xxxx - 18xxxx и 0xxxxx', () => {
+  for (const p of ['000001', '099999', '150000', '189999', '200000', '630000', '999999']) {
+    assert.equal(zoneForPostcode(p), 'C', p);
+  }
+});
+
+test('индекс не из шести цифр - POSTCODE', () => {
+  for (const p of ['10100', '1010000', '10100a', '10 100', '', null, undefined, 101000]) {
+    throwsCode(() => zoneForPostcode(p), 'POSTCODE');
+  }
+});
+
+test('тарифицируемый вес округляется вверх до 0,5 кг', () => {
+  assert.equal(billableUnits(0.1), 1);
+  assert.equal(billableUnits(0.5), 1);
+  assert.equal(billableUnits(0.51), 2);
+  assert.equal(billableUnits(1.2), 3);
+  assert.equal(billableUnits(1.5), 3);
+  assert.equal(billableUnits(29.6), 60);
+  assert.equal(billableUnits(30), 60);
+});
+
+test('границы веса 0,1 и 30 кг допустимы, за ними - WEIGHT_RANGE', () => {
+  assert.doesNotThrow(() => billableUnits(0.1));
+  assert.doesNotThrow(() => billableUnits(30));
+  for (const w of [0.09, 0, -1, 30.01, 31, Infinity]) throwsCode(() => billableUnits(w), 'WEIGHT_RANGE');
+});
+
+test('вес не число - WEIGHT_TYPE', () => {
+  for (const w of ['1.5', NaN, null, undefined, {}, true]) throwsCode(() => billableUnits(w), 'WEIGHT_TYPE');
+});
+
+test('quote: пример из требований, 1,2 кг в зону A - 360 ₽', () => {
+  assert.deepEqual(quote({ weightKg: 1.2, postcode: A }), { zone: 'A', billableKg: 1.5, totalKopecks: 36000 });
+});
+
+test('quote: ставки зон B и C за каждые 0,5 кг', () => {
+  assert.deepEqual(quote({ weightKg: 1.2, postcode: B }), { zone: 'B', billableKg: 1.5, totalKopecks: 45000 });
+  assert.deepEqual(quote({ weightKg: 1.2, postcode: C }), { zone: 'C', billableKg: 1.5, totalKopecks: 63000 });
+});
+
+test('quote: экспресс - плюс 50% к базовой', () => {
+  assert.equal(quote({ weightKg: 1.2, postcode: A, express: true }).totalKopecks, 54000);
+});
+
+test('quote: хрупкое - надбавка 300 ₽', () => {
+  assert.equal(quote({ weightKg: 1.2, postcode: A, fragile: true }).totalKopecks, 66000);
+});
+
+test('quote: экспресс + хрупкое - надбавка 600 ₽ к базе +50%', () => {
+  assert.equal(quote({ weightKg: 1.2, postcode: A, express: true, fragile: true }).totalKopecks, 114000);
+});
+
+test('quote: лояльность - скидка 10% от итога', () => {
+  assert.equal(quote({ weightKg: 1.2, postcode: A, loyalty: true }).totalKopecks, 32400);
+});
+
+test('quote: скидка лояльности считается после надбавки за хрупкость', () => {
+  // (360 + 300) * 0.9 = 594 ₽
+  assert.equal(quote({ weightKg: 1.2, postcode: A, fragile: true, loyalty: true }).totalKopecks, 59400);
+});
+
+test('quote: при экспрессе скидка лояльности не действует', () => {
+  const plain = quote({ weightKg: 1.2, postcode: A, express: true }).totalKopecks;
+  assert.equal(quote({ weightKg: 1.2, postcode: A, express: true, loyalty: true }).totalKopecks, plain);
+  const frag = quote({ weightKg: 1.2, postcode: A, express: true, fragile: true }).totalKopecks;
+  assert.equal(quote({ weightKg: 1.2, postcode: A, express: true, fragile: true, loyalty: true }).totalKopecks, frag);
+});
+
+test('quote: ошибки веса и индекса пробрасываются', () => {
+  throwsCode(() => quote({ weightKg: 31, postcode: A }), 'WEIGHT_RANGE');
+  throwsCode(() => quote({ weightKg: '2', postcode: A }), 'WEIGHT_TYPE');
+  throwsCode(() => quote({ weightKg: 1, postcode: '12' }), 'POSTCODE');
+});
+
+test('срок доставки: таблица стандарт / экспресс по зонам', () => {
+  assert.equal(deliveryDays('A'), 1);
+  assert.equal(deliveryDays('B'), 3);
+  assert.equal(deliveryDays('C'), 5);
+  assert.equal(deliveryDays('A', { express: true }), 1);
+  assert.equal(deliveryDays('B', { express: true }), 2);
+  assert.equal(deliveryDays('C', { express: true }), 3);
+});
+
+test('срок доставки: неизвестная зона - ZONE', () => {
+  for (const z of ['D', undefined, 'toString']) {
+    throwsCode(() => deliveryDays(z), 'ZONE');
+    throwsCode(() => deliveryDays(z, { express: true }), 'ZONE');
+  }
+});