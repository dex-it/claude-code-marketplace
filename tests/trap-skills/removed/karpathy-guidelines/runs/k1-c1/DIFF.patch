+// Условная цена для переиспользования refundFor: доля возврата 2/1/0 = полный/половина/нет.
+const PROBE_CENTS = 2;
+
+/**
+ * Возврат урока в пакет при отмене. Правила те же, что у refundFor: урок возвращается
+ * только при полном возврате (отмена за 24 часа и раньше); половинный возврат урок не возвращает.
+ * Срок действия пакета не продлевается. Правила корпоративных пакетов - отдельная задача.
+ */
+export function refundLesson(pkg, booking, cancelledAt) {
+  const r = refundFor({ ...booking, priceCents: PROBE_CENTS }, cancelledAt);
+  if (!r.ok) return r;
+  if (r.amountCents < PROBE_CENTS) return { ok: true, returned: false, pkg };
+  const total = PACKAGES[pkg.kind]?.lessons;
+  if (total === undefined || pkg.lessonsLeft >= total) return { ok: false, code: 'package_full' };
+  return { ok: true, returned: true, pkg: { ...pkg, lessonsLeft: pkg.lessonsLeft + 1 } };
+}
