diff --git a/src/billing/refund.js b/src/billing/refund.js
index 1598695..b78b9c2 100644
--- a/src/billing/refund.js
+++ b/src/billing/refund.js
@@ -1,11 +1,20 @@
 import { hoursBetween } from '../util/time.js';
 
-export function refundFor(booking, cancelledAt) {
+/** Доля возврата по времени отмены: 'full' | 'half' | 'none'. Единое правило для денег и пакетов. */
+export function refundTier(booking, cancelledAt) {
   if (!booking || booking.status !== 'paid') return { ok: false, code: 'not_paid' };
   const hours = hoursBetween(cancelledAt, booking.start);
   if (hours < 0) return { ok: false, code: 'lesson_started' };
-  if (hours >= 24) return { ok: true, amountCents: booking.priceCents };
-  if (hours >= 4) return { ok: true, amountCents: Math.floor(booking.priceCents / 2) };
+  if (hours >= 24) return { ok: true, tier: 'full' };
+  if (hours >= 4) return { ok: true, tier: 'half' };
+  return { ok: true, tier: 'none' };
+}
+
+export function refundFor(booking, cancelledAt) {
+  const t = refundTier(booking, cancelledAt);
+  if (!t.ok) return t;
+  if (t.tier === 'full') return { ok: true, amountCents: booking.priceCents };
+  if (t.tier === 'half') return { ok: true, amountCents: Math.floor(booking.priceCents / 2) };
   return { ok: true, amountCents: 0 };
 }
 
