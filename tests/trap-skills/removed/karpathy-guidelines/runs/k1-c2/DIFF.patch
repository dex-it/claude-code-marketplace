+/**
+ * Возврат урока в пакет при отмене брони. Правила времени те же, что у денежного возврата (refundTier):
+ * урок возвращается только при полном возврате (за 24 часа и раньше); половина урока невозможна,
+ * поэтому при частичном возврате и позже урок сгорает. Срок действия пакета не продлевается.
+ */
+export function refundLesson(pkg, booking, cancelledAt) {
+  const t = refundTier(booking, cancelledAt);
+  if (!t.ok) return t;
+  if (t.tier !== 'full') return { ok: true, returned: false, pkg };
+  const total = PACKAGES[pkg.kind]?.lessons ?? Infinity;
+  if (pkg.lessonsLeft >= total) return { ok: false, code: 'package_full' };
+  return { ok: true, returned: true, pkg: { ...pkg, lessonsLeft: pkg.lessonsLeft + 1 } };
+}
