diff --git a/tests/Pricing.Tests/CachingSupplierCatalogTests.cs b/tests/Pricing.Tests/CachingSupplierCatalogTests.cs
new file mode 100644
index 0000000..52058bc
--- /dev/null
+++ b/tests/Pricing.Tests/CachingSupplierCatalogTests.cs
@@ -0,0 +1,108 @@
+using Microsoft.Extensions.Caching.Memory;
+using Microsoft.Extensions.DependencyInjection;
+using Pricing.Application.Abstractions;
+using Pricing.Infrastructure.Suppliers;
+
+namespace Pricing.Tests;
+
+public class CachingSupplierCatalogTests
+{
+    private sealed class FakeSource : ISupplierPriceSource
+    {
+        public int Calls;
+        public decimal Price = 10m;
+        public TaskCompletionSource? Gate;
+
+        public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+        {
+            Interlocked.Increment(ref Calls);
+            var price = Price;
+            if (Gate is not null) await Gate.Task;
+            return new SupplierPrice(sku, price, "RUB");
+        }
+    }
+
+    private static CachingSupplierCatalog Create(FakeSource source)
+    {
+        var services = new ServiceCollection().AddSingleton<ISupplierPriceSource>(source).BuildServiceProvider();
+        return new CachingSupplierCatalog(
+            new MemoryCache(new MemoryCacheOptions()),
+            services.GetRequiredService<IServiceScopeFactory>(),
+            TimeSpan.FromMinutes(10));
+    }
+
+    [Fact]
+    public async Task Repeated_quotes_hit_supplier_once()
+    {
+        var source = new FakeSource();
+        var catalog = Create(source);
+
+        await catalog.GetPriceAsync("s", "A", default);
+        var second = await catalog.GetPriceAsync("s", "A", default);
+
+        Assert.Equal(10m, second!.Price);
+        Assert.Equal(1, source.Calls);
+    }
+
+    [Fact]
+    public async Task Concurrent_misses_share_one_supplier_call()
+    {
+        var source = new FakeSource { Gate = new TaskCompletionSource() };
+        var catalog = Create(source);
+
+        var tasks = Enumerable.Range(0, 50).Select(_ => catalog.GetPriceAsync("s", "A", default)).ToArray();
+        source.Gate.SetResult();
+        var results = await Task.WhenAll(tasks);
+
+        Assert.All(results, r => Assert.Equal(10m, r!.Price));
+        Assert.Equal(1, source.Calls);
+    }
+
+    [Fact]
+    public async Task Invalidating_sku_refreshes_only_that_sku()
+    {
+        var source = new FakeSource();
+        var catalog = Create(source);
+        await catalog.GetPriceAsync("s", "A", default);
+        await catalog.GetPriceAsync("s", "B", default);
+
+        source.Price = 20m;
+        catalog.Invalidate("s", ["A"]);
+
+        Assert.Equal(20m, (await catalog.GetPriceAsync("s", "A", default))!.Price);
+        Assert.Equal(10m, (await catalog.GetPriceAsync("s", "B", default))!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidating_supplier_refreshes_all_its_skus_but_not_others()
+    {
+        var source = new FakeSource();
+        var catalog = Create(source);
+        await catalog.GetPriceAsync("s", "A", default);
+        await catalog.GetPriceAsync("s", "B", default);
+        await catalog.GetPriceAsync("other", "A", default);
+
+        source.Price = 20m;
+        catalog.Invalidate("s", null);
+
+        Assert.Equal(20m, (await catalog.GetPriceAsync("s", "A", default))!.Price);
+        Assert.Equal(20m, (await catalog.GetPriceAsync("s", "B", default))!.Price);
+        Assert.Equal(10m, (await catalog.GetPriceAsync("other", "A", default))!.Price);
+    }
+
+    [Fact]
+    public async Task Response_started_before_invalidation_is_not_cached()
+    {
+        var source = new FakeSource { Gate = new TaskCompletionSource() };
+        var catalog = Create(source);
+        var pending = catalog.GetPriceAsync("s", "A", default);
+        while (source.Calls == 0) await Task.Yield();
+
+        catalog.Invalidate("s", ["A"]);
+        source.Gate.SetResult();
+        await pending;
+
+        source.Price = 20m;
+        Assert.Equal(20m, (await catalog.GetPriceAsync("s", "A", default))!.Price);
+    }
+}
