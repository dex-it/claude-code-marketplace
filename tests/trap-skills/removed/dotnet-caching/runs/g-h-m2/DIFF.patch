--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/CachingSupplierCatalog.cs
@@ -0,0 +1,93 @@
+using System.Collections.Concurrent;
+using Microsoft.Extensions.Caching.Memory;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Primitives;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>
+/// Кэш цен поставщика. Одновременные промахи по одному SKU делят один вызов Supplier API;
+/// ответ, начатый до сброса, после сброса не кэшируется.
+/// </summary>
+public sealed class CachingSupplierCatalog(IMemoryCache cache, IServiceScopeFactory scopes, TimeSpan ttl)
+    : ISupplierCatalog, ISupplierPriceCache
+{
+    public static readonly TimeSpan DefaultTtl = TimeSpan.FromMinutes(10);
+
+    private readonly record struct Key(string SupplierId, string Sku);
+
+    private sealed record Entry(SupplierPrice? Price);
+
+    private sealed class Flight
+    {
+        public TaskCompletionSource<Entry> Result { get; } =
+            new(TaskCreationOptions.RunContinuationsAsynchronously);
+    }
+
+    private readonly ConcurrentDictionary<Key, Flight> inflight = new();
+    private readonly ConcurrentDictionary<string, CancellationTokenSource> supplierEpochs = new();
+
+    public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var key = new Key(supplierId, sku);
+        if (cache.TryGetValue(key, out Entry? hit)) return hit!.Price;
+
+        var created = new Flight();
+        var flight = inflight.GetOrAdd(key, created);
+        if (ReferenceEquals(flight, created)) _ = LoadAsync(key, flight);
+
+        // Вызов общий для ожидающих, поэтому отмена одного вызывающего его не обрывает.
+        return (await flight.Result.Task.WaitAsync(ct)).Price;
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        if (skus is null)
+        {
+            if (supplierEpochs.TryRemove(supplierId, out var epoch))
+                epoch.Cancel(); // записи поставщика истекают, ответы в полёте не кэшируются
+            foreach (var key in inflight.Keys.Where(k => k.SupplierId == supplierId))
+                inflight.TryRemove(key, out _);
+            return;
+        }
+
+        foreach (var sku in skus)
+        {
+            var key = new Key(supplierId, sku);
+            cache.Remove(key);
+            inflight.TryRemove(key, out _);
+        }
+    }
+
+    private async Task LoadAsync(Key key, Flight flight)
+    {
+        try
+        {
+            var epochToken = supplierEpochs.GetOrAdd(key.SupplierId, _ => new CancellationTokenSource()).Token;
+            await Task.Yield();
+            using var scope = scopes.CreateScope();
+            var source = scope.ServiceProvider.GetRequiredService<ISupplierPriceSource>();
+            var entry = new Entry(await source.GetPriceAsync(key.SupplierId, key.Sku, CancellationToken.None));
+
+            // Кэшируем, только если за время вызова не было сброса этого SKU или всего поставщика.
+            if (!epochToken.IsCancellationRequested
+                && inflight.TryGetValue(key, out var current) && ReferenceEquals(current, flight))
+            {
+                using var e = cache.CreateEntry(key);
+                e.Value = entry;
+                e.AbsoluteExpirationRelativeToNow = ttl;
+                e.AddExpirationToken(new CancellationChangeToken(epochToken));
+            }
+            flight.Result.SetResult(entry);
+        }
+        catch (Exception ex)
+        {
+            flight.Result.SetException(ex); // ошибка уходит всем ожидающим и не кэшируется
+        }
+        finally
+        {
+            inflight.TryRemove(new KeyValuePair<Key, Flight>(key, flight));
+        }
+    }
+}
