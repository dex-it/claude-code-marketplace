+using System.ComponentModel.DataAnnotations;
+using Microsoft.AspNetCore.Mvc;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+public sealed class SupplierPriceCacheController(ISupplierPriceCacheInvalidator cache) : ControllerBase
+{
+    /// <summary>Вебхук поставщика: Skus - изменённые SKU; null - перезалит весь прайс.</summary>
+    public sealed record SupplierPricesChanged([property: Required] string SupplierId, string[]? Skus);
+
+    [HttpPost("api/webhooks/supplier-prices")]
+    public ActionResult Webhook(SupplierPricesChanged body)
+    {
+        cache.Invalidate(body.SupplierId, body.Skus);
+        return NoContent();
+    }
+
+    /// <summary>Служебный вызов поддержки: сбросить кэш цен поставщика.</summary>
+    [HttpDelete("api/suppliers/{supplierId}/price-cache")]
+    public ActionResult Reset(string supplierId)
+    {
+        cache.Invalidate(supplierId, null);
+        return NoContent();
+    }
+}
