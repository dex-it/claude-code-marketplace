@@ -0,0 +1,134 @@
+using Pricing.Application.Abstractions;
+using Pricing.Infrastructure.Suppliers;
+
+namespace Pricing.Tests;
+
+public class SupplierPriceCacheTests
+{
+    private sealed class TestClock : TimeProvider
+    {
+        public DateTimeOffset Now { get; set; } = new(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private sealed class Supplier
+    {
+        private int _calls;
+        public TaskCompletionSource<SupplierPrice?>? Gate;
+        public int Calls => _calls;
+
+        // Цена = номер вызова, так видно, какой именно вызов вернул значение.
+        public async Task<SupplierPrice?> Fetch(string sku)
+        {
+            var n = Interlocked.Increment(ref _calls);
+            if (Gate is not null) await Gate.Task;
+            return new SupplierPrice(sku, n, "RUB");
+        }
+    }
+
+    private static readonly TimeSpan Ttl = TimeSpan.FromMinutes(10);
+
+    [Fact]
+    public async Task Repeated_calls_within_ttl_hit_supplier_once()
+    {
+        var cache = new SupplierPriceCache(Ttl, new TestClock());
+        var s = new Supplier();
+
+        var a = await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+        var b = await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+
+        Assert.Equal(1, s.Calls);
+        Assert.Equal(a, b);
+    }
+
+    [Fact]
+    public async Task Concurrent_misses_share_one_supplier_call()
+    {
+        var cache = new SupplierPriceCache(Ttl, new TestClock());
+        var s = new Supplier { Gate = new(TaskCreationOptions.RunContinuationsAsynchronously) };
+
+        var tasks = Enumerable.Range(0, 50)
+            .Select(_ => cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default)).ToArray();
+        s.Gate.SetResult(null);
+        var results = await Task.WhenAll(tasks);
+
+        Assert.Equal(1, s.Calls);
+        Assert.All(results, r => Assert.Equal(1m, r!.Price));
+    }
+
+    [Fact]
+    public async Task Entry_expires_after_ttl()
+    {
+        var clock = new TestClock();
+        var cache = new SupplierPriceCache(Ttl, clock);
+        var s = new Supplier();
+
+        await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+        clock.Now += Ttl + TimeSpan.FromSeconds(1);
+        var again = await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+
+        Assert.Equal(2m, again!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidate_skus_resets_only_listed()
+    {
+        var cache = new SupplierPriceCache(Ttl, new TestClock());
+        var s = new Supplier();
+        await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+        await cache.GetOrFetchAsync("sup", "B", _ => s.Fetch("B"), default);
+
+        cache.Invalidate("sup", ["A"]);
+        var a = await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+        var b = await cache.GetOrFetchAsync("sup", "B", _ => s.Fetch("B"), default);
+
+        Assert.Equal(3m, a!.Price);
+        Assert.Equal(2m, b!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidate_null_resets_whole_supplier_but_not_others()
+    {
+        var cache = new SupplierPriceCache(Ttl, new TestClock());
+        var s = new Supplier();
+        await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+        await cache.GetOrFetchAsync("sup", "B", _ => s.Fetch("B"), default);
+        await cache.GetOrFetchAsync("other", "A", _ => s.Fetch("A"), default);
+
+        cache.Invalidate("sup", null);
+        var a = await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+        var other = await cache.GetOrFetchAsync("other", "A", _ => s.Fetch("A"), default);
+
+        Assert.Equal(4m, a!.Price);
+        Assert.Equal(3m, other!.Price);
+    }
+
+    [Fact]
+    public async Task Failure_is_not_cached()
+    {
+        var cache = new SupplierPriceCache(Ttl, new TestClock());
+
+        await Assert.ThrowsAsync<HttpRequestException>(() =>
+            cache.GetOrFetchAsync("sup", "A", _ => throw new HttpRequestException(), default));
+        var s = new Supplier();
+        var ok = await cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+
+        Assert.Equal(1m, ok!.Price);
+    }
+
+    [Fact]
+    public async Task Cancelled_caller_does_not_fail_shared_fetch()
+    {
+        var cache = new SupplierPriceCache(Ttl, new TestClock());
+        var s = new Supplier { Gate = new(TaskCreationOptions.RunContinuationsAsynchronously) };
+        using var cts = new CancellationTokenSource();
+
+        var first = cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), cts.Token);
+        var second = cache.GetOrFetchAsync("sup", "A", _ => s.Fetch("A"), default);
+        cts.Cancel();
+        s.Gate.SetResult(null);
+
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => first);
+        Assert.Equal(1m, (await second)!.Price);
+    }
+}
