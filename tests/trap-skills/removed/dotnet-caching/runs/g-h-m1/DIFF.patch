--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
@@ -0,0 +1,73 @@
+using System.Collections.Concurrent;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>
+/// Кэш цен поставщика. Конкурентные промахи по одному ключу делят один вызов поставщика;
+/// ошибки не кэшируются.
+/// </summary>
+public sealed class SupplierPriceCache(TimeSpan ttl, TimeProvider clock) : ISupplierPriceCacheInvalidator
+{
+    private sealed class Entry(DateTimeOffset expiresAt)
+    {
+        public DateTimeOffset ExpiresAt { get; } = expiresAt;
+        public TaskCompletionSource<SupplierPrice?> Result { get; } =
+            new(TaskCreationOptions.RunContinuationsAsynchronously);
+    }
+
+    private readonly ConcurrentDictionary<string, ConcurrentDictionary<string, Entry>> _suppliers = new();
+
+    public async Task<SupplierPrice?> GetOrFetchAsync(
+        string supplierId, string sku, Func<CancellationToken, Task<SupplierPrice?>> fetch, CancellationToken ct)
+    {
+        var entries = _suppliers.GetOrAdd(supplierId, _ => new ConcurrentDictionary<string, Entry>());
+        while (true)
+        {
+            var now = clock.GetUtcNow();
+            var candidate = new Entry(now + ttl);
+            bool isLeader;
+            if (entries.TryGetValue(sku, out var existing))
+            {
+                if (existing.ExpiresAt > now) return await existing.Result.Task.WaitAsync(ct);
+                isLeader = entries.TryUpdate(sku, candidate, existing);
+            }
+            else
+            {
+                isLeader = entries.TryAdd(sku, candidate);
+            }
+
+            if (!isLeader) continue;
+            // Вызов поставщика не привязан к токену одного вызывающего: его результат ждут и остальные.
+            _ = FetchAsync(entries, sku, candidate, fetch);
+            return await candidate.Result.Task.WaitAsync(ct);
+        }
+    }
+
+    private static async Task FetchAsync(
+        ConcurrentDictionary<string, Entry> entries, string sku, Entry entry,
+        Func<CancellationToken, Task<SupplierPrice?>> fetch)
+    {
+        try
+        {
+            entry.Result.SetResult(await fetch(CancellationToken.None));
+        }
+        catch (Exception ex)
+        {
+            // Не кэшируем сбой; ошибку получат все ожидающие этот вызов.
+            entries.TryRemove(new KeyValuePair<string, Entry>(sku, entry));
+            entry.Result.SetException(ex);
+        }
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        if (skus is null)
+        {
+            _suppliers.TryRemove(supplierId, out _);
+            return;
+        }
+        if (!_suppliers.TryGetValue(supplierId, out var entries)) return;
+        foreach (var sku in skus) entries.TryRemove(sku, out _);
+    }
+}
