+namespace Pricing.Application.Abstractions;
+
+public interface ISupplierPriceCacheInvalidator
+{
+    /// <summary>Сбрасывает кэш цен поставщика: перечисленные SKU; skus == null - весь прайс поставщика.</summary>
+    void Invalidate(string supplierId, IReadOnlyCollection<string>? skus);
+}
