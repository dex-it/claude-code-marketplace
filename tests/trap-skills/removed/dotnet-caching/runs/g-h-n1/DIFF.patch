+using Microsoft.Extensions.Options;
+using Pricing.Application.Abstractions;
+using Pricing.Infrastructure.Suppliers;
+
+namespace Pricing.Tests;
+
+public sealed class SupplierPriceCacheTests
+{
+    private readonly SupplierPriceCache _cache = new(Options.Create(new SupplierOptions()));
+    private int _calls;
+
+    private Task<SupplierPrice?> Fetch(CancellationToken _) =>
+        Task.FromResult<SupplierPrice?>(new SupplierPrice("SKU-1", Interlocked.Increment(ref _calls), "RUB"));
+
+    private Task<SupplierPrice?> Get(string supplier = "sup-1", string sku = "SKU-1") =>
+        _cache.GetOrFetchAsync(supplier, sku, Fetch, default);
+
+    [Fact]
+    public async Task Second_read_returns_cached_price()
+    {
+        var first = await Get();
+        var second = await Get();
+
+        Assert.Equal(1m, first!.Price);
+        Assert.Equal(1m, second!.Price);
+    }
+
+    [Fact]
+    public async Task Concurrent_misses_make_one_supplier_call()
+    {
+        var gate = new TaskCompletionSource();
+        async Task<SupplierPrice?> Slow(CancellationToken _)
+        {
+            Interlocked.Increment(ref _calls);
+            await gate.Task;
+            return new SupplierPrice("SKU-1", 5, "RUB");
+        }
+
+        var tasks = Enumerable.Range(0, 50).Select(_ => _cache.GetOrFetchAsync("sup-1", "SKU-1", Slow, default)).ToArray();
+        gate.SetResult();
+        await Task.WhenAll(tasks);
+
+        Assert.Equal(1, _calls);
+    }
+
+    [Fact]
+    public async Task Invalidate_sku_refetches_only_that_sku()
+    {
+        await Get(sku: "SKU-1");
+        await Get(sku: "SKU-2");
+
+        _cache.Invalidate("sup-1", ["SKU-1"]);
+
+        Assert.Equal(3m, (await Get(sku: "SKU-1"))!.Price);
+        Assert.Equal(2m, (await Get(sku: "SKU-2"))!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidate_all_refetches_every_sku_of_supplier_but_not_others()
+    {
+        await Get("sup-1", "SKU-1");
+        await Get("sup-1", "SKU-2");
+        await Get("sup-2", "SKU-1");
+
+        _cache.Invalidate("sup-1", null);
+
+        Assert.Equal(4m, (await Get("sup-1", "SKU-1"))!.Price);
+        Assert.Equal(5m, (await Get("sup-1", "SKU-2"))!.Price);
+        Assert.Equal(3m, (await Get("sup-2", "SKU-1"))!.Price);
+    }
+
+    [Fact]
+    public async Task Failed_fetch_is_not_cached()
+    {
+        await Assert.ThrowsAsync<HttpRequestException>(() =>
+            _cache.GetOrFetchAsync("sup-1", "SKU-1", _ => throw new HttpRequestException(), default));
+
+        Assert.Equal(1m, (await Get())!.Price);
+    }
+}
