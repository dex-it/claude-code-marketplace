+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Api.Security;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+public sealed class SupplierPricesController(ISupplierPriceCache cache) : ControllerBase
+{
+    [HttpPost("api/webhooks/supplier-prices")]
+    [ApiKey("X-Webhook-Key", "Webhooks:SupplierKey")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    public IActionResult Changed(SupplierPricesChanged request)
+    {
+        cache.Invalidate(request.SupplierId, request.Skus);
+        return NoContent();
+    }
+
+    [HttpDelete("api/suppliers/{supplierId}/price-cache")]
+    [ApiKey("X-Admin-Key", "Admin:ApiKey")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    public IActionResult Reset(string supplierId)
+    {
+        cache.Invalidate(supplierId, null);
+        return NoContent();
+    }
+}
