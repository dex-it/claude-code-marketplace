diff --git a/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
new file mode 100644
index 0000000..bbfc232
--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
@@ -0,0 +1,99 @@
+using System.Collections.Concurrent;
+using Microsoft.Extensions.Caching.Memory;
+using Microsoft.Extensions.Options;
+using Microsoft.Extensions.Primitives;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>Кэш цен поставщика: один запрос к поставщику на ключ при конкурентных промахах.</summary>
+public sealed class SupplierPriceCache(IOptions<SupplierOptions> options) : ISupplierPriceCache, IDisposable
+{
+    private sealed class SupplierState
+    {
+        public CancellationTokenSource Evict = new();
+        public long Generation;
+    }
+
+    private readonly MemoryCache _cache = new(new MemoryCacheOptions());
+    private readonly ConcurrentDictionary<string, SupplierState> _suppliers = new();
+    private readonly ConcurrentDictionary<(string Supplier, string Sku), Lazy<Task<SupplierPrice?>>> _inflight = new();
+    private readonly object _gate = new();
+    private readonly TimeSpan _ttl = options.Value.PriceCacheTtl;
+
+    public async Task<SupplierPrice?> GetOrFetchAsync(
+        string supplierId, string sku, Func<CancellationToken, Task<SupplierPrice?>> fetch, CancellationToken ct)
+    {
+        var key = (supplierId, sku);
+        if (_cache.TryGetValue(key, out SupplierPrice? cached)) return cached;
+
+        // Общий запрос не привязан к токену первого вызывающего; срок ему задаёт resilience-handler клиента.
+        var lazy = _inflight.GetOrAdd(key, k => new Lazy<Task<SupplierPrice?>>(() => LoadAsync(k, fetch)));
+        return await lazy.Value.WaitAsync(ct);
+    }
+
+    private async Task<SupplierPrice?> LoadAsync(
+        (string Supplier, string Sku) key, Func<CancellationToken, Task<SupplierPrice?>> fetch)
+    {
+        var state = _suppliers.GetOrAdd(key.Supplier, _ => new SupplierState());
+        CancellationToken evict;
+        long generation;
+        lock (_gate)
+        {
+            evict = state.Evict.Token;
+            generation = state.Generation;
+        }
+
+        try
+        {
+            var price = await fetch(CancellationToken.None);
+            lock (_gate)
+            {
+                // Сброс во время запроса: ответ мог быть старым, не кэшируем.
+                if (state.Generation == generation)
+                {
+                    using var entry = _cache.CreateEntry(key);
+                    entry.Value = price;
+                    entry.AbsoluteExpirationRelativeToNow = _ttl;
+                    entry.ExpirationTokens.Add(new CancellationChangeToken(evict));
+                }
+            }
+            return price;
+        }
+        finally
+        {
+            _inflight.TryRemove(key, out _);
+        }
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        var state = _suppliers.GetOrAdd(supplierId, _ => new SupplierState());
+        CancellationTokenSource? old = null;
+        lock (_gate)
+        {
+            state.Generation++;
+            if (skus is null)
+            {
+                old = state.Evict;
+                state.Evict = new CancellationTokenSource();
+            }
+            else
+            {
+                foreach (var sku in skus)
+                {
+                    _cache.Remove((supplierId, sku));
+                    _inflight.TryRemove((supplierId, sku), out _);
+                }
+            }
+        }
+        if (old is not null)
+        {
+            old.Cancel();
+            foreach (var key in _inflight.Keys.Where(k => k.Supplier == supplierId))
+                _inflight.TryRemove(key, out _);
+        }
+    }
+
+    public void Dispose() => _cache.Dispose();
+}
