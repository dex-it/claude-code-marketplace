+using Microsoft.Extensions.Options;
+using Pricing.Application.Abstractions;
+using Pricing.Infrastructure.Suppliers;
+
+namespace Pricing.Tests;
+
+public sealed class SupplierPriceCacheTests
+{
+    private sealed class ManualTime : TimeProvider
+    {
+        public DateTimeOffset Now { get; set; } = new(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private readonly ManualTime _time = new();
+    private readonly SupplierPriceCache _cache;
+    private int _calls;
+
+    public SupplierPriceCacheTests() =>
+        _cache = new SupplierPriceCache(Options.Create(new SupplierOptions()), _time);
+
+    private Task<SupplierPrice?> Fetch(CancellationToken _)
+    {
+        var n = Interlocked.Increment(ref _calls);
+        return Task.FromResult<SupplierPrice?>(new SupplierPrice("A", n, "RUB"));
+    }
+
+    [Fact]
+    public async Task Repeated_calls_return_cached_price()
+    {
+        var first = await _cache.GetOrFetchAsync("s", "A", Fetch, default);
+        var second = await _cache.GetOrFetchAsync("s", "A", Fetch, default);
+
+        Assert.Equal(1m, first!.Price);
+        Assert.Equal(1m, second!.Price);
+    }
+
+    [Fact]
+    public async Task Concurrent_misses_share_one_fetch()
+    {
+        var gate = new TaskCompletionSource();
+        async Task<SupplierPrice?> Slow(CancellationToken ct)
+        {
+            Interlocked.Increment(ref _calls);
+            await gate.Task;
+            return new SupplierPrice("A", 5, "RUB");
+        }
+
+        var tasks = Enumerable.Range(0, 20).Select(_ => _cache.GetOrFetchAsync("s", "A", Slow, default)).ToList();
+        gate.SetResult();
+        var prices = await Task.WhenAll(tasks);
+
+        Assert.Equal(1, _calls);
+        Assert.All(prices, p => Assert.Equal(5m, p!.Price));
+    }
+
+    [Fact]
+    public async Task Price_is_refetched_after_ttl()
+    {
+        await _cache.GetOrFetchAsync("s", "A", Fetch, default);
+        _time.Now += TimeSpan.FromMinutes(10) + TimeSpan.FromSeconds(1);
+
+        var price = await _cache.GetOrFetchAsync("s", "A", Fetch, default);
+
+        Assert.Equal(2m, price!.Price);
+    }
+
+    [Fact]
+    public async Task Failure_is_not_cached()
+    {
+        await Assert.ThrowsAsync<HttpRequestException>(() =>
+            _cache.GetOrFetchAsync("s", "A", _ => throw new HttpRequestException(), default));
+
+        var price = await _cache.GetOrFetchAsync("s", "A", Fetch, default);
+
+        Assert.Equal(1m, price!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidate_skus_drops_only_listed()
+    {
+        await _cache.GetOrFetchAsync("s", "A", Fetch, default);
+        await _cache.GetOrFetchAsync("s", "B", Fetch, default);
+
+        _cache.Invalidate("s", new[] { "A" });
+
+        Assert.Equal(3m, (await _cache.GetOrFetchAsync("s", "A", Fetch, default))!.Price);
+        Assert.Equal(2m, (await _cache.GetOrFetchAsync("s", "B", Fetch, default))!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidate_null_drops_whole_supplier_only()
+    {
+        await _cache.GetOrFetchAsync("s", "A", Fetch, default);
+        await _cache.GetOrFetchAsync("other", "A", Fetch, default);
+
+        _cache.Invalidate("s", null);
+
+        Assert.Equal(3m, (await _cache.GetOrFetchAsync("s", "A", Fetch, default))!.Price);
+        Assert.Equal(2m, (await _cache.GetOrFetchAsync("other", "A", Fetch, default))!.Price);
+    }
+}
