diff --git a/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
new file mode 100644
index 0000000..200fc2f
--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
@@ -0,0 +1,66 @@
+using System.Collections.Concurrent;
+using Microsoft.Extensions.Options;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>
+/// Кэш цен поставщика. Одновременные промахи по одному SKU делят один вызов поставщика;
+/// ошибки не кэшируются. Общий вызов не отменяется отказом одного из ожидающих.
+/// </summary>
+public sealed class SupplierPriceCache(IOptions<SupplierOptions> options, TimeProvider time) : ISupplierPriceCacheInvalidator
+{
+    private sealed record Entry(Task<SupplierPrice?> Task, DateTimeOffset ExpiresAt);
+
+    private readonly ConcurrentDictionary<(string SupplierId, string Sku), Entry> _entries = new();
+
+    public Task<SupplierPrice?> GetOrFetchAsync(
+        string supplierId, string sku, Func<CancellationToken, Task<SupplierPrice?>> fetch, CancellationToken ct)
+    {
+        var key = (supplierId, sku);
+        while (true)
+        {
+            var now = time.GetUtcNow();
+            if (_entries.TryGetValue(key, out var existing))
+            {
+                if (existing.ExpiresAt > now) return existing.Task.WaitAsync(ct);
+                _entries.TryRemove(new KeyValuePair<(string SupplierId, string Sku), Entry>(key, existing));
+                continue;
+            }
+
+            var tcs = new TaskCompletionSource<SupplierPrice?>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var entry = new Entry(tcs.Task, now + options.Value.PriceCacheTtl);
+            if (!_entries.TryAdd(key, entry)) continue;
+
+            _ = FetchAsync(key, entry, tcs, fetch);
+            return tcs.Task.WaitAsync(ct);
+        }
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        if (skus is null)
+        {
+            foreach (var key in _entries.Keys)
+                if (key.SupplierId == supplierId) _entries.TryRemove(key, out _);
+            return;
+        }
+
+        foreach (var sku in skus) _entries.TryRemove((supplierId, sku), out _);
+    }
+
+    private async Task FetchAsync(
+        (string SupplierId, string Sku) key, Entry entry, TaskCompletionSource<SupplierPrice?> tcs,
+        Func<CancellationToken, Task<SupplierPrice?>> fetch)
+    {
+        try
+        {
+            tcs.SetResult(await fetch(CancellationToken.None));
+        }
+        catch (Exception ex)
+        {
+            _entries.TryRemove(new KeyValuePair<(string SupplierId, string Sku), Entry>(key, entry));
+            tcs.SetException(ex);
+        }
+    }
+}
