+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+public sealed class SupplierPricesController(ISupplierPriceCacheInvalidator cache) : ControllerBase
+{
+    /// <summary>Вебхук поставщика: цены изменились. skus == null - перезалит весь прайс.</summary>
+    [HttpPost("api/webhooks/supplier-prices")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    public IActionResult OnPricesChanged(SupplierPricesChangedRequest request)
+    {
+        cache.Invalidate(request.SupplierId, request.Skus);
+        return NoContent();
+    }
+
+    /// <summary>Служебный сброс кэша цен поставщика (для поддержки).</summary>
+    [HttpDelete("api/suppliers/{supplierId}/price-cache")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    public IActionResult ResetPriceCache(string supplierId)
+    {
+        cache.Invalidate(supplierId, null);
+        return NoContent();
+    }
+}
