@@ -0,0 +1,56 @@
+using System.Collections.Concurrent;
+using Microsoft.Extensions.Caching.Memory;
+using Microsoft.Extensions.Options;
+using Microsoft.Extensions.Primitives;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>Кэш цен поставщика поверх Supplier API; параллельные промахи одного ключа делят один вызов.</summary>
+public sealed class CachedSupplierCatalog(
+    SupplierApiClient inner, IMemoryCache cache, IOptions<SupplierOptions> options) : ISupplierCatalog, ISupplierPriceCache
+{
+    private readonly ConcurrentDictionary<string, CancellationTokenSource> _supplierResets = new();
+
+    public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var key = Key(supplierId, sku);
+        var lazy = cache.GetOrCreate(key, entry =>
+        {
+            entry.AbsoluteExpirationRelativeToNow = options.Value.PriceCacheTtl;
+            entry.ExpirationTokens.Add(new CancellationChangeToken(ResetSource(supplierId).Token));
+            // Вызов делится между ожидающими, поэтому он не привязан к токену первого вызывающего.
+            return new Lazy<Task<SupplierPrice?>>(() => inner.GetPriceAsync(supplierId, sku, CancellationToken.None));
+        })!;
+
+        try
+        {
+            return await lazy.Value.WaitAsync(ct);
+        }
+        catch (Exception) when (lazy.Value.IsFaulted)
+        {
+            // Сбой не кэшируем.
+            cache.Remove(key);
+            throw;
+        }
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        if (skus is null)
+        {
+            if (_supplierResets.TryRemove(supplierId, out var cts))
+            {
+                cts.Cancel();
+                cts.Dispose();
+            }
+            return;
+        }
+        foreach (var sku in skus) cache.Remove(Key(supplierId, sku));
+    }
+
+    private CancellationTokenSource ResetSource(string supplierId) =>
+        _supplierResets.GetOrAdd(supplierId, _ => new CancellationTokenSource());
+
+    private static string Key(string supplierId, string sku) => $"supplier-price:{supplierId}:{sku}";
+}
