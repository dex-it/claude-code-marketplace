+using System.Net;
+using System.Text;
+using Microsoft.Extensions.Caching.Memory;
+using Microsoft.Extensions.Options;
+using Pricing.Infrastructure.Suppliers;
+
+namespace Pricing.Tests;
+
+public sealed class CachedSupplierCatalogTests
+{
+    private const string PriceJson = "{\"sku\":\"SKU-1\",\"price\":10,\"currency\":\"RUB\"}";
+
+    private sealed class CountingHandler : HttpMessageHandler
+    {
+        public int Calls;
+
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            Interlocked.Increment(ref Calls);
+            await Task.Delay(20, CancellationToken.None);
+            return new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new StringContent(PriceJson, Encoding.UTF8, "application/json")
+            };
+        }
+    }
+
+    private static (CachedSupplierCatalog Catalog, CountingHandler Handler) Create()
+    {
+        var handler = new CountingHandler();
+        var client = new SupplierApiClient(new HttpClient(handler) { BaseAddress = new Uri("http://x/") });
+        var catalog = new CachedSupplierCatalog(client, new MemoryCache(new MemoryCacheOptions()), Options.Create(new SupplierOptions()));
+        return (catalog, handler);
+    }
+
+    [Fact]
+    public async Task Concurrent_misses_make_single_supplier_call()
+    {
+        var (catalog, handler) = Create();
+
+        var prices = await Task.WhenAll(Enumerable.Range(0, 50).Select(_ => catalog.GetPriceAsync("sup-1", "SKU-1", default)));
+
+        Assert.All(prices, p => Assert.Equal(10m, p!.Price));
+        Assert.Equal(1, handler.Calls);
+    }
+
+    [Fact]
+    public async Task Invalidate_sku_forces_reload_of_that_sku_only()
+    {
+        var (catalog, handler) = Create();
+        await catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        await catalog.GetPriceAsync("sup-1", "SKU-2", default);
+
+        catalog.Invalidate("sup-1", ["SKU-1"]);
+        await catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        await catalog.GetPriceAsync("sup-1", "SKU-2", default);
+
+        Assert.Equal(3, handler.Calls);
+    }
+
+    [Fact]
+    public async Task Invalidate_whole_supplier_reloads_all_and_keeps_other_suppliers()
+    {
+        var (catalog, handler) = Create();
+        await catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        await catalog.GetPriceAsync("sup-1", "SKU-2", default);
+        await catalog.GetPriceAsync("sup-2", "SKU-1", default);
+
+        catalog.Invalidate("sup-1", null);
+        await catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        await catalog.GetPriceAsync("sup-1", "SKU-2", default);
+        await catalog.GetPriceAsync("sup-2", "SKU-1", default);
+
+        Assert.Equal(5, handler.Calls);
+    }
+}
