+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Contracts;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api")]
+public sealed class SupplierPricesController(ISupplierPriceCache cache) : ControllerBase
+{
+    /// <summary>Вебхук поставщика: сбрасывает цены перечисленных SKU; skus = null - весь прайс.</summary>
+    [HttpPost("webhooks/supplier-prices")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    public NoContentResult SupplierPricesChanged(SupplierPricesChangedRequest request)
+    {
+        cache.Invalidate(request.SupplierId, request.Skus);
+        return NoContent();
+    }
+
+    /// <summary>Служебный сброс кэша цен поставщика (для поддержки).</summary>
+    [HttpDelete("suppliers/{supplierId}/price-cache")]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    public NoContentResult ResetPriceCache(string supplierId)
+    {
+        cache.Invalidate(supplierId, null);
+        return NoContent();
+    }
+}
