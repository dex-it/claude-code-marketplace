@@ -0,0 +1,14 @@
+using Microsoft.Extensions.Options;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class CachingSupplierCatalog(
+    SupplierApiClient inner, SupplierPriceCache cache, IOptions<SupplierOptions> options) : ISupplierCatalog
+{
+    public Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct) =>
+        // загрузка общая для ожидающих, поэтому не привязана к токену одного запроса
+        cache.GetOrAddAsync(supplierId, sku, options.Value.PriceCacheTtl,
+            () => inner.GetPriceAsync(supplierId, sku, CancellationToken.None))
+            .WaitAsync(ct);
+}
