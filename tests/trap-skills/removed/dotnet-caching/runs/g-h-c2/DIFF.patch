diff --git a/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
new file mode 100644
index 0000000..7cca306
--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
@@ -0,0 +1,55 @@
+using System.Collections.Concurrent;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>Кэш цен поставщика в памяти; параллельные промахи по одному ключу делят один вызов Supplier API.</summary>
+public sealed class SupplierPriceCache(TimeProvider clock) : ISupplierPriceCache
+{
+    private const int SweepThreshold = 10_000;
+
+    private sealed record Entry(Task<SupplierPrice?> Price, DateTimeOffset ExpiresAt);
+
+    private readonly ConcurrentDictionary<(string SupplierId, string Sku), Entry> _entries = new();
+
+    public async Task<SupplierPrice?> GetOrAddAsync(
+        string supplierId, string sku, TimeSpan ttl, Func<Task<SupplierPrice?>> load)
+    {
+        var key = (supplierId, sku);
+        var now = clock.GetUtcNow();
+        if (_entries.TryGetValue(key, out var existing) && existing.ExpiresAt > now)
+            return await existing.Price;
+
+        if (_entries.Count > SweepThreshold) Sweep(now);
+
+        var fresh = new Entry(Task.Run(load), now + ttl);
+        var entry = _entries.AddOrUpdate(key, fresh, (_, old) => old.ExpiresAt > now ? old : fresh);
+        try
+        {
+            return await entry.Price;
+        }
+        catch
+        {
+            // ошибку не кэшируем
+            _entries.TryRemove(new KeyValuePair<(string, string), Entry>(key, entry));
+            throw;
+        }
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        if (skus is null)
+        {
+            foreach (var key in _entries.Keys)
+                if (key.SupplierId == supplierId) _entries.TryRemove(key, out _);
+            return;
+        }
+        foreach (var sku in skus) _entries.TryRemove((supplierId, sku), out _);
+    }
+
+    private void Sweep(DateTimeOffset now)
+    {
+        foreach (var (key, entry) in _entries)
+            if (entry.ExpiresAt <= now) _entries.TryRemove(new KeyValuePair<(string, string), Entry>(key, entry));
+    }
+}
