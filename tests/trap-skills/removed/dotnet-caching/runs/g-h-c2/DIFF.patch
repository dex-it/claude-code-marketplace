+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Options;
+using Pricing.Application.Abstractions;
+using Pricing.Infrastructure.Suppliers;
+
+namespace Pricing.Api.Controllers;
+
+public sealed record SupplierPricesChanged(string SupplierId, IReadOnlyList<string>? Skus);
+
+[ApiController]
+public sealed class SupplierPricesController(ISupplierPriceCache cache, IOptions<SupplierOptions> options)
+    : ControllerBase
+{
+    /// <summary>Вебхук поставщика: skus = null - перезалит весь прайс.</summary>
+    [HttpPost("api/webhooks/supplier-prices")]
+    public IActionResult Webhook(SupplierPricesChanged body)
+    {
+        if (!Authorized()) return Unauthorized();
+        if (string.IsNullOrWhiteSpace(body.SupplierId)) return BadRequest("supplierId обязателен");
+        cache.Invalidate(body.SupplierId, body.Skus);
+        return NoContent();
+    }
+
+    /// <summary>Служебный вызов поддержки: сбросить кэш цен поставщика целиком.</summary>
+    [HttpDelete("api/admin/supplier-prices-cache/{supplierId}")]
+    public IActionResult Reset(string supplierId)
+    {
+        if (!Authorized()) return Unauthorized();
+        cache.Invalidate(supplierId, null);
+        return NoContent();
+    }
+
+    private bool Authorized()
+    {
+        var expected = options.Value.AdminKey;
+        if (string.IsNullOrEmpty(expected)) return false;
+        var given = Request.Headers["X-Admin-Key"].ToString();
+        return CryptographicOperations.FixedTimeEquals(Encoding.UTF8.GetBytes(given), Encoding.UTF8.GetBytes(expected));
+    }
+}
