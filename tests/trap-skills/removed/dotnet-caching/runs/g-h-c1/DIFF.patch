+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class CachedSupplierCatalog(SupplierApiClient inner, SupplierPriceCache cache) : ISupplierCatalog
+{
+    public Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct) =>
+        cache.GetOrFetchAsync(supplierId, sku, () => inner.GetPriceAsync(supplierId, sku, CancellationToken.None), ct);
+}
diff --git a/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
new file mode 100644
index 0000000..8407b84
--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/SupplierPriceCache.cs
@@ -0,0 +1,72 @@
+using System.Collections.Concurrent;
+using Microsoft.Extensions.Caching.Memory;
+using Microsoft.Extensions.Primitives;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>
+/// Кэш цен поставщика на 10 минут. Параллельные запросы одного SKU делят один вызов Supplier API.
+/// </summary>
+public sealed class SupplierPriceCache : ISupplierPriceCache, IDisposable
+{
+    public static readonly TimeSpan Ttl = TimeSpan.FromMinutes(10);
+
+    private readonly MemoryCache _cache = new(new MemoryCacheOptions());
+    private readonly ConcurrentDictionary<string, CancellationTokenSource> _suppliers = new();
+
+    public async Task<SupplierPrice?> GetOrFetchAsync(
+        string supplierId, string sku, Func<Task<SupplierPrice?>> fetch, CancellationToken ct)
+    {
+        var key = Key(supplierId, sku);
+        var lazy = _cache.GetOrCreate(key, entry =>
+        {
+            entry.AbsoluteExpirationRelativeToNow = Ttl;
+            entry.AddExpirationToken(new CancellationChangeToken(SupplierToken(supplierId)));
+            return new Lazy<Task<SupplierPrice?>>(() => LoadAsync(key, fetch));
+        })!;
+        // общий вызов не привязан к токену первого вызвавшего; каждый ждёт со своим токеном
+        return await lazy.Value.WaitAsync(ct);
+    }
+
+    private async Task<SupplierPrice?> LoadAsync(string key, Func<Task<SupplierPrice?>> fetch)
+    {
+        try
+        {
+            return await fetch();
+        }
+        catch
+        {
+            _cache.Remove(key); // ошибки не кэшируем
+            throw;
+        }
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        if (skus is null)
+        {
+            if (_suppliers.TryRemove(supplierId, out var cts))
+            {
+                cts.Cancel();
+                cts.Dispose();
+            }
+            return;
+        }
+        foreach (var sku in skus) _cache.Remove(Key(supplierId, sku));
+    }
+
+    private CancellationToken SupplierToken(string supplierId)
+    {
+        while (true)
+        {
+            var cts = _suppliers.GetOrAdd(supplierId, _ => new CancellationTokenSource());
+            try { return cts.Token; }
+            catch (ObjectDisposedException) { _suppliers.TryRemove(new(supplierId, cts)); }
+        }
+    }
+
+    private static string Key(string supplierId, string sku) => $"{supplierId}\u001f{sku}";
+
+    public void Dispose() => _cache.Dispose();
+}
