+using Microsoft.AspNetCore.Mvc;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Api.Controllers;
+
+public sealed record SupplierPricesChanged(string SupplierId, IReadOnlyList<string>? Skus);
+
+[ApiController]
+public sealed class SupplierPricesController(ISupplierPriceCache cache, IConfiguration config) : ControllerBase
+{
+    /// <summary>Вебхук поставщика: skus == null - перезалит весь прайс.</summary>
+    [HttpPost("api/webhooks/supplier-prices")]
+    public IActionResult Webhook(SupplierPricesChanged body)
+    {
+        if (string.IsNullOrWhiteSpace(body.SupplierId)) return BadRequest("supplierId обязателен");
+        cache.Invalidate(body.SupplierId, body.Skus);
+        return NoContent();
+    }
+
+    /// <summary>Служебный вызов поддержки: сбросить весь кэш цен поставщика. Требует заголовок X-Admin-Key.</summary>
+    [HttpDelete("api/admin/suppliers/{supplierId}/price-cache")]
+    public IActionResult Reset(string supplierId, [FromHeader(Name = "X-Admin-Key")] string? key)
+    {
+        var expected = config["Admin:ApiKey"];
+        if (string.IsNullOrEmpty(expected) || key != expected) return Unauthorized();
+        cache.Invalidate(supplierId, null);
+        return NoContent();
+    }
+}
