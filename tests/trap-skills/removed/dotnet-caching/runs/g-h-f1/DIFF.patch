diff --git a/src/Pricing.Infrastructure/Suppliers/CachingSupplierCatalog.cs b/src/Pricing.Infrastructure/Suppliers/CachingSupplierCatalog.cs
new file mode 100644
index 0000000..97f82d6
--- /dev/null
+++ b/src/Pricing.Infrastructure/Suppliers/CachingSupplierCatalog.cs
@@ -0,0 +1,86 @@
+using System.Collections.Concurrent;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Options;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+/// <summary>
+/// Кэш цен поставщика над <see cref="SupplierApiClient"/>. Конкурентные промахи по одному SKU делят один
+/// вызов в Supplier API; ошибки не кэшируются. Вызов к поставщику не зависит от токена первого
+/// вызывающего (его ждут и остальные) - его срок ограничивает resilience-handler клиента.
+/// </summary>
+public sealed class CachingSupplierCatalog(
+    IServiceScopeFactory scopes,
+    IOptions<SupplierOptions> options,
+    TimeProvider time,
+    ILogger<CachingSupplierCatalog> logger) : ISupplierCatalog, ISupplierPriceCache
+{
+    private sealed class Entry
+    {
+        public TaskCompletionSource<SupplierPrice?> Source { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public long CompletedAt { get; set; }
+    }
+
+    private readonly ConcurrentDictionary<string, ConcurrentDictionary<string, Entry>> _suppliers = new();
+
+    public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var bucket = _suppliers.GetOrAdd(supplierId, _ => new());
+        while (true)
+        {
+            var created = new Entry();
+            var entry = bucket.GetOrAdd(sku, created);
+            if (!ReferenceEquals(entry, created))
+            {
+                if (IsExpired(entry))
+                {
+                    bucket.TryRemove(new KeyValuePair<string, Entry>(sku, entry));
+                    continue;
+                }
+                return await entry.Source.Task.WaitAsync(ct);
+            }
+
+            _ = LoadAsync(bucket, supplierId, sku, entry);
+            return await entry.Source.Task.WaitAsync(ct);
+        }
+    }
+
+    public void Invalidate(string supplierId, IReadOnlyCollection<string>? skus)
+    {
+        if (!_suppliers.TryGetValue(supplierId, out var bucket)) return;
+        if (skus is null)
+        {
+            bucket.Clear();
+        }
+        else
+        {
+            foreach (var sku in skus) bucket.TryRemove(sku, out _);
+        }
+        logger.LogInformation("Кэш цен поставщика {SupplierId} сброшен: {Scope}", supplierId,
+            skus is null ? "весь прайс" : $"{skus.Count} SKU");
+    }
+
+    private bool IsExpired(Entry entry) =>
+        entry.Source.Task.IsCompletedSuccessfully
+        && time.GetElapsedTime(entry.CompletedAt) >= options.Value.PriceCacheTtl;
+
+    private async Task LoadAsync(ConcurrentDictionary<string, Entry> bucket, string supplierId, string sku, Entry entry)
+    {
+        try
+        {
+            using var scope = scopes.CreateScope();
+            var client = scope.ServiceProvider.GetRequiredService<SupplierApiClient>();
+            var price = await client.GetPriceAsync(supplierId, sku, CancellationToken.None);
+            entry.CompletedAt = time.GetTimestamp();
+            entry.Source.SetResult(price);
+        }
+        catch (Exception ex)
+        {
+            bucket.TryRemove(new KeyValuePair<string, Entry>(sku, entry));
+            logger.LogWarning(ex, "Не удалось получить цену {Sku} у поставщика {SupplierId}", sku, supplierId);
+            entry.Source.SetException(ex);
+        }
+    }
+}
