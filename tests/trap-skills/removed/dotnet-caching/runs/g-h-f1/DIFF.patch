diff --git a/tests/Pricing.Tests/CachingSupplierCatalogTests.cs b/tests/Pricing.Tests/CachingSupplierCatalogTests.cs
new file mode 100644
index 0000000..a596024
--- /dev/null
+++ b/tests/Pricing.Tests/CachingSupplierCatalogTests.cs
@@ -0,0 +1,121 @@
+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using Pricing.Infrastructure.Suppliers;
+
+namespace Pricing.Tests;
+
+public sealed class CachingSupplierCatalogTests
+{
+    private sealed class FakeSupplierHandler : HttpMessageHandler
+    {
+        private int _calls;
+        public int Calls => _calls;
+        public bool Fail { get; set; }
+        public TaskCompletionSource? Gate { get; set; }
+        public decimal Price { get; set; } = 100m;
+
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            Interlocked.Increment(ref _calls);
+            if (Gate is not null) await Gate.Task;
+            if (Fail) return new HttpResponseMessage(HttpStatusCode.ServiceUnavailable);
+            var sku = request.RequestUri!.Segments[^1];
+            return new HttpResponseMessage(HttpStatusCode.OK) { Content = JsonContent.Create(new { sku, price = Price, currency = "RUB" }) };
+        }
+    }
+
+    private sealed class ManualTime : TimeProvider
+    {
+        private long _ticks;
+        public override long TimestampFrequency => TimeSpan.TicksPerSecond;
+        public override long GetTimestamp() => _ticks;
+        public void Advance(TimeSpan by) => _ticks += by.Ticks;
+    }
+
+    private readonly FakeSupplierHandler _handler = new();
+    private readonly ManualTime _time = new();
+    private readonly CachingSupplierCatalog _catalog;
+
+    public CachingSupplierCatalogTests()
+    {
+        var services = new ServiceCollection();
+        services.AddHttpClient<SupplierApiClient>(h => h.BaseAddress = new Uri("http://supplier/"))
+            .ConfigurePrimaryHttpMessageHandler(() => _handler);
+        var scopes = services.BuildServiceProvider().GetRequiredService<IServiceScopeFactory>();
+        _catalog = new CachingSupplierCatalog(scopes, Options.Create(new SupplierOptions()), _time, NullLogger<CachingSupplierCatalog>.Instance);
+    }
+
+    [Fact]
+    public async Task Repeated_quotes_use_cached_price()
+    {
+        await _catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        var price = await _catalog.GetPriceAsync("sup-1", "SKU-1", default);
+
+        Assert.Equal(100m, price!.Price);
+        Assert.Equal(1, _handler.Calls);
+    }
+
+    [Fact]
+    public async Task Concurrent_misses_share_one_supplier_call()
+    {
+        _handler.Gate = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        var tasks = Enumerable.Range(0, 50).Select(_ => _catalog.GetPriceAsync("sup-1", "SKU-1", default)).ToArray();
+        _handler.Gate.SetResult();
+        await Task.WhenAll(tasks);
+
+        Assert.Equal(1, _handler.Calls);
+    }
+
+    [Fact]
+    public async Task Price_is_refetched_after_ttl()
+    {
+        await _catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        _handler.Price = 120m;
+        _time.Advance(TimeSpan.FromMinutes(10));
+
+        var price = await _catalog.GetPriceAsync("sup-1", "SKU-1", default);
+
+        Assert.Equal(120m, price!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidate_listed_skus_keeps_others()
+    {
+        await _catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        await _catalog.GetPriceAsync("sup-1", "SKU-2", default);
+        _handler.Price = 120m;
+
+        _catalog.Invalidate("sup-1", ["SKU-1"]);
+
+        Assert.Equal(120m, (await _catalog.GetPriceAsync("sup-1", "SKU-1", default))!.Price);
+        Assert.Equal(100m, (await _catalog.GetPriceAsync("sup-1", "SKU-2", default))!.Price);
+    }
+
+    [Fact]
+    public async Task Invalidate_without_skus_drops_whole_supplier_only()
+    {
+        await _catalog.GetPriceAsync("sup-1", "SKU-1", default);
+        await _catalog.GetPriceAsync("sup-2", "SKU-1", default);
+        _handler.Price = 120m;
+
+        _catalog.Invalidate("sup-1", null);
+
+        Assert.Equal(120m, (await _catalog.GetPriceAsync("sup-1", "SKU-1", default))!.Price);
+        Assert.Equal(100m, (await _catalog.GetPriceAsync("sup-2", "SKU-1", default))!.Price);
+    }
+
+    [Fact]
+    public async Task Failure_is_not_cached()
+    {
+        _handler.Fail = true;
+        await Assert.ThrowsAsync<HttpRequestException>(() => _catalog.GetPriceAsync("sup-1", "SKU-1", default));
+        _handler.Fail = false;
+
+        var price = await _catalog.GetPriceAsync("sup-1", "SKU-1", default);
+
+        Assert.Equal(100m, price!.Price);
+    }
+}
