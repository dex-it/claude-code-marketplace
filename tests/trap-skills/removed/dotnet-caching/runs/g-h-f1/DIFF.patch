+using Microsoft.AspNetCore.Mvc;
+using Pricing.Api.Security;
+using Pricing.Application.Abstractions;
+
+namespace Pricing.Api.Controllers;
+
+[ApiController]
+[Route("api/suppliers/{supplierId}/price-cache")]
+[SharedSecret("X-Admin-Key", "Admin:ApiKey")]
+public sealed class SupplierPriceCacheController(ISupplierPriceCache cache) : ControllerBase
+{
+    /// <summary>Сбрасывает кэш цен поставщика целиком.</summary>
+    [HttpDelete]
+    [ProducesResponseType(StatusCodes.Status204NoContent)]
+    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
+    public IActionResult Reset(string supplierId)
+    {
+        cache.Invalidate(supplierId, null);
+        return NoContent();
+    }
+}
