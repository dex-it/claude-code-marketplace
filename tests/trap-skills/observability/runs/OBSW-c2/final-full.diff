+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using OpenTelemetry.Metrics;
+using OpenTelemetry.Resources;
+using OpenTelemetry.Trace;
+using OrdersApi.Observability;
 using OrdersApi.Orders;
 using Serilog;
 
 var builder = WebApplication.CreateBuilder(args);
-builder.Host.UseSerilog((ctx, cfg) => cfg.ReadFrom.Configuration(ctx.Configuration).WriteTo.Console());
+builder.Host.UseSerilog((ctx, cfg) => cfg.ReadFrom.Configuration(ctx.Configuration)
+    .Enrich.FromLogContext()
+    .Enrich.WithSpan()
+    .WriteTo.Console(outputTemplate:
+        "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {{TraceId={TraceId}, SpanId={SpanId}}}{NewLine}{Exception}"));
 builder.Services.AddSingleton<IOrderRepository, OrderRepository>();
 builder.Services.AddScoped<OrderService>();
 
+// OTLP exporter is configured via standard OTEL_EXPORTER_OTLP_* / OTEL_SERVICE_NAME env vars.
+builder.Services.AddOpenTelemetry()
+    .ConfigureResource(r => r.AddService("orders-api"))
+    .WithTracing(t => t
+        .AddAspNetCoreInstrumentation(o => o.Filter = ctx => !ctx.Request.Path.StartsWithSegments("/health")
+                                                             && !ctx.Request.Path.StartsWithSegments("/metrics"))
+        .AddSource(OrdersTelemetry.Name)
+        .AddSource("Npgsql")
+        .AddOtlpExporter())
+    .WithMetrics(m => m
+        .AddAspNetCoreInstrumentation()
+        .AddMeter(OrdersTelemetry.Name)
+        .AddPrometheusExporter());
+
+builder.Services.AddSingleton<RedisHealthCheck>();
+builder.Services.AddHealthChecks()
+    .AddCheck<PostgresHealthCheck>("postgres", tags: ["ready"])
+    .AddCheck<RedisHealthCheck>("redis", tags: ["ready"]);
+
 var app = builder.Build();
 app.MapPost("/orders", async (CreateOrderRequest r, OrderService s, CancellationToken ct) =>
     Results.Created("/orders", await s.CreateAsync(r, ct)));
 app.MapGet("/orders/{id:guid}", async (Guid id, IOrderRepository repo, CancellationToken ct) =>
     await repo.FindAsync(id, ct) is { } o ? Results.Ok(o) : Results.NotFound());
+
+// liveness: process only, no dependencies; readiness: Postgres + Redis
+app.MapHealthChecks("/health/live", new() { Predicate = _ => false });
+app.MapHealthChecks("/health/ready", new() { Predicate = c => c.Tags.Contains("ready") });
+app.MapPrometheusScrapingEndpoint();
 app.Run();
