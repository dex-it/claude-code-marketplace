+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public class PostgresHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    private readonly string _cs = cfg.GetConnectionString("Orders")!;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await using var c = new NpgsqlConnection(_cs);
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+        return HealthCheckResult.Healthy();
+    }
+}
+
+public class RedisHealthCheck(IConnectionMultiplexer redis) : IHealthCheck
+{
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await redis.GetDatabase().PingAsync().WaitAsync(ct);
+        return HealthCheckResult.Healthy();
+    }
+}
+
+/// Дедлайн на проверку и переиспользование результата между пробами.
+public class BoundedHealthCheck(IHealthCheck inner, TimeSpan timeout, TimeSpan cacheFor, TimeProvider time) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private DateTimeOffset _expires = DateTimeOffset.MinValue;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (time.GetUtcNow() < _expires) return _last;
+
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(timeout);
+            try
+            {
+                _last = await inner.CheckHealthAsync(context, cts.Token);
+            }
+            catch (Exception ex) when (!ct.IsCancellationRequested)
+            {
+                var reason = cts.IsCancellationRequested ? $"timeout after {timeout.TotalSeconds:0.#}s" : ex.Message;
+                _last = new HealthCheckResult(context.Registration.FailureStatus, reason, ex);
+            }
+            _expires = time.GetUtcNow() + cacheFor;
+            return _last;
+        }
+        finally
+        {
+            _gate.Release();
+        }
+    }
+}
