+using System.Diagnostics;
+using System.Diagnostics.Metrics;
+
+namespace OrdersApi.Observability;
+
+public static class OrdersTelemetry
+{
+    public const string Name = "OrdersApi";
+
+    private static readonly string[] KnownChannels = ["web", "mobile", "partner"];
+
+    public static readonly ActivitySource Source = new(Name);
+    private static readonly Meter Meter = new(Name);
+
+    private static readonly Counter<long> Created =
+        Meter.CreateCounter<long>("orders_created", description: "Orders creation attempts by channel and resulting status");
+
+    private static readonly Histogram<double> Duration =
+        Meter.CreateHistogram<double>("orders_create_duration", unit: "s", description: "Order creation duration");
+
+    // Channel comes from the client; unknown values are folded to keep label cardinality bounded.
+    public static string NormalizeChannel(string? channel) =>
+        KnownChannels.Contains(channel) ? channel! : "other";
+
+    public static void RecordCreated(string channel, string status, TimeSpan elapsed)
+    {
+        var tags = new TagList { { "channel", NormalizeChannel(channel) }, { "status", status } };
+        Created.Add(1, tags);
+        Duration.Record(elapsed.TotalSeconds, tags);
+    }
+}
