@@ -0,0 +1,77 @@
+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public class PostgresHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    private static readonly TimeSpan Deadline = TimeSpan.FromSeconds(3);
+    private readonly string _cs = cfg.GetConnectionString("Orders")!;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        cts.CancelAfter(Deadline);
+        await using var c = new NpgsqlConnection(_cs);
+        await c.OpenAsync(cts.Token);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(cts.Token);
+        return HealthCheckResult.Healthy();
+    }
+}
+
+public sealed class RedisHealthCheck(IConfiguration cfg) : IHealthCheck, IDisposable
+{
+    private static readonly TimeSpan Deadline = TimeSpan.FromSeconds(3);
+    private readonly Lazy<Task<ConnectionMultiplexer>> _mux = new(() =>
+    {
+        var o = ConfigurationOptions.Parse(cfg.GetConnectionString("Redis")!);
+        o.AbortOnConnectFail = false;
+        o.ConnectTimeout = (int)Deadline.TotalMilliseconds;
+        return ConnectionMultiplexer.ConnectAsync(o);
+    });
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        cts.CancelAfter(Deadline);
+        var mux = await _mux.Value.WaitAsync(cts.Token);
+        await mux.GetDatabase().PingAsync().WaitAsync(cts.Token);
+        return HealthCheckResult.Healthy();
+    }
+
+    public void Dispose()
+    {
+        if (_mux.IsValueCreated && _mux.Value.IsCompletedSuccessfully) _mux.Value.Result.Dispose();
+    }
+}
+
+// Пробы kubelet приходят часто и от нескольких подов/проб сразу: к зависимостям ходим не чаще раза в ttl.
+public sealed class CachedHealthCheck(IHealthCheck inner, TimeSpan ttl) : IHealthCheck, IDisposable
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private DateTime _at = DateTime.MinValue;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (DateTime.UtcNow - _at < ttl) return _last;
+            try { _last = await inner.CheckHealthAsync(context, ct); }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
+            catch (Exception ex) { _last = new HealthCheckResult(context.Registration.FailureStatus, exception: ex); }
+            _at = DateTime.UtcNow;
+            return _last;
+        }
+        finally { _gate.Release(); }
+    }
+
+    public void Dispose()
+    {
+        (inner as IDisposable)?.Dispose();
+        _gate.Dispose();
+    }
+}
