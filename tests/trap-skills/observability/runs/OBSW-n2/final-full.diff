+using System.Diagnostics;
+using System.Diagnostics.Metrics;
+using OpenTelemetry.Trace;
+
+namespace OrdersApi.Observability;
+
+public static class OrdersTelemetry
+{
+    public const string Name = "OrdersApi";
+
+    public static readonly ActivitySource Source = new(Name);
+    private static readonly Meter Meter = new(Name);
+
+    private static readonly Counter<long> Created = Meter.CreateCounter<long>("orders.created", "{order}", "Orders processed by channel and resulting status");
+    private static readonly Histogram<double> Duration = Meter.CreateHistogram<double>("orders.create.duration", "s", "Order creation duration");
+
+    // Канал приходит от клиента: произвольные значения не должны плодить серии метрик.
+    public static string NormalizeChannel(string? channel) => channel switch
+    {
+        "web" or "mobile" or "partner" => channel,
+        _ => "other"
+    };
+
+    public static void RecordCreate(string? channel, string status, double seconds)
+    {
+        var tags = new TagList { { "channel", NormalizeChannel(channel) }, { "status", status } };
+        Created.Add(1, tags);
+        Duration.Record(seconds, tags);
+    }
+
+    public static void RecordError(this Activity? activity, Exception ex)
+    {
+        activity?.SetStatus(ActivityStatusCode.Error, ex.Message);
+        activity?.RecordException(ex);
+    }
+}
