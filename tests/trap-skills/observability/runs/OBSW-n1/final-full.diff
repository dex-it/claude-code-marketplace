@@ -0,0 +1,87 @@
+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+// Every probe gets its own deadline, so a hung dependency cannot hang the probe request.
+public abstract class DeadlineHealthCheck(TimeSpan timeout) : IHealthCheck
+{
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        cts.CancelAfter(timeout);
+        try
+        {
+            await ProbeAsync(cts.Token);
+            return HealthCheckResult.Healthy();
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            return HealthCheckResult.Unhealthy($"timed out after {timeout.TotalSeconds:0.#}s");
+        }
+        catch (Exception ex)
+        {
+            return HealthCheckResult.Unhealthy(ex.GetType().Name, ex);
+        }
+    }
+
+    protected abstract Task ProbeAsync(CancellationToken ct);
+}
+
+public sealed class PostgresHealthCheck(IConfiguration cfg, TimeSpan timeout) : DeadlineHealthCheck(timeout)
+{
+    private readonly string _cs = cfg.GetConnectionString("Orders")!;
+
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        await using var c = new NpgsqlConnection(_cs);
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+    }
+}
+
+public sealed class RedisHealthCheck : DeadlineHealthCheck
+{
+    private readonly Lazy<Task<ConnectionMultiplexer>> _mux;
+
+    public RedisHealthCheck(IConfiguration cfg, TimeSpan timeout) : base(timeout)
+    {
+        var options = ConfigurationOptions.Parse(cfg.GetConnectionString("Redis")!);
+        options.AbortOnConnectFail = false; // keep retrying in background instead of failing forever
+        options.ConnectTimeout = (int)timeout.TotalMilliseconds;
+        options.AsyncTimeout = (int)timeout.TotalMilliseconds;
+        _mux = new Lazy<Task<ConnectionMultiplexer>>(() => ConnectionMultiplexer.ConnectAsync(options));
+    }
+
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        var mux = await _mux.Value.WaitAsync(ct);
+        await mux.GetDatabase().PingAsync().WaitAsync(ct);
+    }
+}
+
+// Probes arrive every few seconds from kubelet (and from several replicas of the platform stack):
+// reuse the last result instead of hitting the dependency each time.
+public sealed class CachedHealthCheck(IHealthCheck inner, TimeSpan ttl, TimeProvider clock) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private long _expiresAt;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        if (clock.GetTimestamp() < Interlocked.Read(ref _expiresAt)) return _last;
+
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (clock.GetTimestamp() < Interlocked.Read(ref _expiresAt)) return _last;
+            _last = await inner.CheckHealthAsync(context, ct);
+            Interlocked.Exchange(ref _expiresAt, clock.GetTimestamp() + (long)(ttl.TotalSeconds * clock.TimestampFrequency));
+            return _last;
+        }
+        finally { _gate.Release(); }
+    }
+}
