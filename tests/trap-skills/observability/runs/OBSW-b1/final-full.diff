@@ -0,0 +1,75 @@
+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public class PostgresHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    private readonly string _cs = cfg.GetConnectionString("Orders")!;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await using var c = new NpgsqlConnection(_cs);
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+        return HealthCheckResult.Healthy();
+    }
+}
+
+public class RedisHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    private readonly Lazy<Task<ConnectionMultiplexer>> _mux = new(() =>
+    {
+        var o = ConfigurationOptions.Parse(cfg.GetConnectionString("Redis")!);
+        o.AbortOnConnectFail = false;
+        return ConnectionMultiplexer.ConnectAsync(o);
+    });
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        var mux = await _mux.Value.WaitAsync(ct);
+        await mux.GetDatabase().PingAsync().WaitAsync(ct);
+        return HealthCheckResult.Healthy();
+    }
+}
+
+/// <summary>
+/// Runs the inner check under its own deadline and reuses the result for <c>ttl</c>,
+/// so frequent probes do not hit the dependencies each time.
+/// </summary>
+public class CachedHealthCheck(IHealthCheck inner, TimeSpan ttl, TimeSpan deadline, TimeProvider clock) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private long _at;
+    private bool _has;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        if (Fresh()) return _last;
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (Fresh()) return _last;
+            // the shared run must not be cancelled by one caller's token, only by the deadline
+            using var cts = new CancellationTokenSource(deadline);
+            try
+            {
+                _last = await inner.CheckHealthAsync(context, cts.Token);
+            }
+            catch (Exception ex)
+            {
+                var msg = cts.IsCancellationRequested ? $"timed out after {deadline.TotalSeconds:0.#}s" : ex.Message;
+                _last = new HealthCheckResult(context.Registration.FailureStatus, msg, ex);
+            }
+            _at = clock.GetTimestamp();
+            _has = true;
+            return _last;
+        }
+        finally { _gate.Release(); }
+    }
+
+    private bool Fresh() => _has && clock.GetElapsedTime(_at) < ttl;
+}
