+using System.Diagnostics;
+using System.Diagnostics.Metrics;
+
+namespace OrdersApi.Observability;
+
+public static class OrdersTelemetry
+{
+    public const string Name = "OrdersApi";
+
+    public static readonly ActivitySource Source = new(Name);
+    private static readonly Meter Meter = new(Name);
+
+    private static readonly Counter<long> Created = Meter.CreateCounter<long>(
+        "orders.created", description: "Orders by channel and final status");
+    private static readonly Histogram<double> Duration = Meter.CreateHistogram<double>(
+        "orders.create.duration", unit: "s", description: "Order creation duration");
+
+    private static readonly HashSet<string> Channels = new(StringComparer.Ordinal) { "web", "mobile", "partner" };
+
+    // Channel comes from the request body: unknown values must not create new metric series.
+    public static string NormalizeChannel(string? channel) =>
+        channel is not null && Channels.Contains(channel) ? channel : "other";
+
+    public static void RecordCreate(string channel, string status, TimeSpan elapsed)
+    {
+        var tags = new TagList { { "channel", NormalizeChannel(channel) }, { "status", status } };
+        Created.Add(1, tags);
+        Duration.Record(elapsed.TotalSeconds, tags);
+    }
+}
