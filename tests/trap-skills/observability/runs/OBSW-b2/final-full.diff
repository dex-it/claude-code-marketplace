@@ -0,0 +1,67 @@
+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public class PostgresHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await using var c = new NpgsqlConnection(cfg.GetConnectionString("Orders"));
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+        return HealthCheckResult.Healthy();
+    }
+}
+
+public class RedisHealthCheck(IConnectionMultiplexer redis) : IHealthCheck
+{
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        var latency = await redis.GetDatabase().PingAsync().WaitAsync(ct);
+        return HealthCheckResult.Healthy(data: new Dictionary<string, object> { ["latencyMs"] = latency.TotalMilliseconds });
+    }
+}
+
+// Gives the inner check its own deadline (independent of the probe's timeout) and
+// reuses the last result for `ttl`, so frequent probes don't hammer the dependency.
+public class BoundedCachedHealthCheck(IHealthCheck inner, TimeSpan timeout, TimeSpan ttl) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private long _expiresAt;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        if (Environment.TickCount64 < Volatile.Read(ref _expiresAt)) return _last;
+
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (Environment.TickCount64 < _expiresAt) return _last;
+
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(timeout);
+            try
+            {
+                _last = await inner.CheckHealthAsync(context, cts.Token);
+            }
+            catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+            {
+                _last = HealthCheckResult.Unhealthy($"Health check timed out after {timeout.TotalSeconds:0.#}s");
+            }
+            catch (Exception ex)
+            {
+                _last = HealthCheckResult.Unhealthy(ex.GetType().Name, ex);
+            }
+            _expiresAt = Environment.TickCount64 + (long)ttl.TotalMilliseconds;
+            return _last;
+        }
+        finally
+        {
+            _gate.Release();
+        }
+    }
+}
