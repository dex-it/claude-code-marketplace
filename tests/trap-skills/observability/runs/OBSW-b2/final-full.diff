+using System.Diagnostics;
+using Microsoft.AspNetCore.Diagnostics.HealthChecks;
+using OpenTelemetry.Metrics;
+using OpenTelemetry.Resources;
+using OpenTelemetry.Trace;
+using OrdersApi.Observability;
 using OrdersApi.Orders;
 using Serilog;
+using StackExchange.Redis;
 
 var builder = WebApplication.CreateBuilder(args);
-builder.Host.UseSerilog((ctx, cfg) => cfg.ReadFrom.Configuration(ctx.Configuration).WriteTo.Console());
+builder.Host.UseSerilog((ctx, cfg) => cfg
+    .ReadFrom.Configuration(ctx.Configuration)
+    .Enrich.WithSpan()
+    .WriteTo.Console(outputTemplate:
+        "{Timestamp:HH:mm:ss} [{Level:u3}] trace={TraceId} span={SpanId} {Message:lj}{NewLine}{Exception}"));
 builder.Services.AddSingleton<IOrderRepository, OrderRepository>();
 builder.Services.AddScoped<OrderService>();
 
+static bool IsOpsPath(PathString p) =>
+    p.StartsWithSegments("/health") || p.StartsWithSegments("/metrics");
+
+// OTLP endpoint comes from OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_PROTOCOL.
+builder.Services.AddOpenTelemetry()
+    .ConfigureResource(r => r.AddService("orders-api"))
+    .WithTracing(t => t
+        .AddAspNetCoreInstrumentation(o => o.Filter = ctx => !IsOpsPath(ctx.Request.Path))
+        .AddSource(OrdersTelemetry.Name)
+        .AddSource("Npgsql")
+        .AddOtlpExporter())
+    .WithMetrics(m => m
+        .AddAspNetCoreInstrumentation()
+        .AddMeter(OrdersTelemetry.Name)
+        .AddView("orders.create.duration", new ExplicitBucketHistogramConfiguration
+        {
+            Boundaries = [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5]
+        })
+        .AddPrometheusExporter());
+
+builder.Services.AddSingleton<IConnectionMultiplexer>(sp =>
+{
+    var opts = ConfigurationOptions.Parse(sp.GetRequiredService<IConfiguration>().GetConnectionString("Redis")!);
+    opts.AbortOnConnectFail = false; // don't fail startup; the health check reports it
+    opts.ConnectTimeout = 2000;
+    return ConnectionMultiplexer.Connect(opts);
+});
+
+var healthTimeout = TimeSpan.FromSeconds(2);
+var healthTtl = TimeSpan.FromSeconds(10);
+builder.Services.AddHealthChecks()
+    .Add(new("postgres", sp => new BoundedCachedHealthCheck(
+        ActivatorUtilities.CreateInstance<PostgresHealthCheck>(sp), healthTimeout, healthTtl), null, ["ready"]))
+    .Add(new("redis", sp => new BoundedCachedHealthCheck(
+        ActivatorUtilities.CreateInstance<RedisHealthCheck>(sp), healthTimeout, healthTtl), null, ["ready"]));
+
 var app = builder.Build();
 app.MapPost("/orders", async (CreateOrderRequest r, OrderService s, CancellationToken ct) =>
     Results.Created("/orders", await s.CreateAsync(r, ct)));
 app.MapGet("/orders/{id:guid}", async (Guid id, IOrderRepository repo, CancellationToken ct) =>
     await repo.FindAsync(id, ct) is { } o ? Results.Ok(o) : Results.NotFound());
+
+// liveness: process only, no dependencies; readiness: Postgres + Redis
+app.MapHealthChecks("/health/live", new HealthCheckOptions { Predicate = _ => false });
+app.MapHealthChecks("/health/ready", new HealthCheckOptions { Predicate = c => c.Tags.Contains("ready") });
+app.MapPrometheusScrapingEndpoint();
 app.Run();
