@@ -0,0 +1,40 @@
+using Microsoft.Extensions.Diagnostics.HealthChecks;
+
+namespace OrdersApi.Observability;
+
+/// <summary>Проверка со своим дедлайном; результат переиспользуется между пробами на время кэша.</summary>
+public abstract class CachedHealthCheck(TimeSpan timeout, TimeSpan cacheFor) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private long _validUntil; // Environment.TickCount64; 0 - результата ещё нет
+
+    protected abstract Task ProbeAsync(CancellationToken ct);
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken cancellationToken = default)
+    {
+        if (Fresh()) return _last;
+        await _gate.WaitAsync(cancellationToken);
+        try
+        {
+            if (Fresh()) return _last;
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            cts.CancelAfter(timeout);
+            try
+            {
+                await ProbeAsync(cts.Token).WaitAsync(cts.Token);
+                _last = HealthCheckResult.Healthy();
+            }
+            catch (Exception ex) when (!cancellationToken.IsCancellationRequested)
+            {
+                _last = HealthCheckResult.Unhealthy(
+                    ex is OperationCanceledException ? $"timeout after {timeout.TotalSeconds:0.#}s" : ex.GetType().Name, ex);
+            }
+            _validUntil = Environment.TickCount64 + (long)cacheFor.TotalMilliseconds;
+            return _last;
+        }
+        finally { _gate.Release(); }
+    }
+
+    private bool Fresh() => _validUntil != 0 && Environment.TickCount64 < Volatile.Read(ref _validUntil);
+}
