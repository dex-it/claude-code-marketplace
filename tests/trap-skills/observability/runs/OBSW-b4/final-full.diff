@@ -0,0 +1,48 @@
+using Microsoft.Extensions.Diagnostics.HealthChecks;
+
+namespace OrdersApi.Observability;
+
+/// <summary>Health check with its own deadline and a short-lived cached result shared between probes.</summary>
+public abstract class CachedHealthCheck(TimeSpan timeout, TimeSpan ttl) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private DateTime _lastAt = DateTime.MinValue;
+
+    protected abstract Task ProbeAsync(CancellationToken ct);
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (DateTime.UtcNow - _lastAt < ttl) return _last;
+
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(timeout);
+            try
+            {
+                await ProbeAsync(cts.Token);
+                _last = HealthCheckResult.Healthy();
+            }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested)
+            {
+                throw;
+            }
+            catch (OperationCanceledException)
+            {
+                _last = HealthCheckResult.Unhealthy($"timed out after {timeout.TotalSeconds:0.#}s");
+            }
+            catch (Exception ex)
+            {
+                _last = HealthCheckResult.Unhealthy(ex.GetType().Name, ex);
+            }
+            _lastAt = DateTime.UtcNow;
+            return _last;
+        }
+        finally
+        {
+            _gate.Release();
+        }
+    }
+}
