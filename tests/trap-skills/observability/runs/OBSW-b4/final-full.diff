@@ -0,0 +1,36 @@
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public sealed class PostgresHealthCheck(IConfiguration cfg)
+    : CachedHealthCheck(TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5))
+{
+    private readonly string _cs = cfg.GetConnectionString("Orders")!;
+
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        await using var c = new NpgsqlConnection(_cs);
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+    }
+}
+
+public sealed class RedisHealthCheck(IConfiguration cfg)
+    : CachedHealthCheck(TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5)), IAsyncDisposable
+{
+    private readonly string _cs = cfg.GetConnectionString("Redis")!;
+    private IConnectionMultiplexer? _mux;
+
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        _mux ??= await ConnectionMultiplexer.ConnectAsync(_cs).WaitAsync(ct);
+        await _mux.GetDatabase().PingAsync().WaitAsync(ct);
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        if (_mux is not null) await _mux.DisposeAsync();
+    }
+}
