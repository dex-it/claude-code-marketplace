+using System.Diagnostics;
+using System.Diagnostics.Metrics;
+
+namespace OrdersApi.Observability;
+
+public static class OrdersTelemetry
+{
+    public const string Name = "OrdersApi";
+
+    public static readonly ActivitySource Source = new(Name);
+    public static readonly Meter Meter = new(Name);
+
+    public static readonly Counter<long> OrdersCreated =
+        Meter.CreateCounter<long>("orders.created", description: "Orders created, by channel and final status");
+
+    public static readonly Histogram<double> CreateDuration =
+        Meter.CreateHistogram<double>("orders.create.duration", unit: "s", description: "Order creation duration");
+
+    private static readonly HashSet<string> Channels = ["web", "mobile", "partner"];
+
+    // Channel comes from the request; unknown values must not blow up metric cardinality.
+    public static string NormalizeChannel(string? channel) =>
+        channel is not null && Channels.Contains(channel) ? channel : "other";
+
+    public static void RecordError(this Activity? activity, Exception ex)
+    {
+        if (activity is null) return;
+        activity.SetStatus(ActivityStatusCode.Error, ex.Message);
+        activity.AddEvent(new ActivityEvent("exception", tags: new ActivityTagsCollection
+        {
+            ["exception.type"] = ex.GetType().FullName,
+            ["exception.message"] = ex.Message,
+            ["exception.stacktrace"] = ex.ToString(),
+        }));
+    }
+}
