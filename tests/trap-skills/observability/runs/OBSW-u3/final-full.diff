+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+/// <summary>
+/// Base check with its own deadline and a short-lived cached result,
+/// so frequent probes do not hit the dependency each time.
+/// </summary>
+public abstract class CachedHealthCheck(TimeSpan timeout, TimeSpan cacheTtl) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private DateTime _lastAt = DateTime.MinValue;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        if (Fresh()) return _last;
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (Fresh()) return _last;
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(timeout);
+            try
+            {
+                await ProbeAsync(cts.Token);
+                _last = HealthCheckResult.Healthy();
+            }
+            catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+            {
+                _last = new HealthCheckResult(context.Registration.FailureStatus, $"timeout after {timeout.TotalSeconds}s");
+            }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                _last = new HealthCheckResult(context.Registration.FailureStatus, ex.Message, ex);
+            }
+            _lastAt = DateTime.UtcNow;
+            return _last;
+        }
+        finally { _gate.Release(); }
+    }
+
+    private bool Fresh() => DateTime.UtcNow - _lastAt < cacheTtl;
+
+    protected abstract Task ProbeAsync(CancellationToken ct);
+}
+
+public sealed class PostgresHealthCheck(IConfiguration cfg)
+    : CachedHealthCheck(TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(10))
+{
+    private readonly string _cs = cfg.GetConnectionString("Orders")!;
+
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        await using var c = new NpgsqlConnection(_cs);
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+    }
+}
+
+public sealed class RedisHealthCheck(IConfiguration cfg)
+    : CachedHealthCheck(TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(10)), IAsyncDisposable
+{
+    private readonly ConfigurationOptions _opts = Build(cfg.GetConnectionString("Redis")!);
+    private IConnectionMultiplexer? _mux;
+
+    private static ConfigurationOptions Build(string cs)
+    {
+        var o = ConfigurationOptions.Parse(cs);
+        o.AbortOnConnectFail = false; // do not throw from ConnectAsync, report via Ping
+        o.ConnectTimeout = 3000;
+        o.SyncTimeout = 3000;
+        o.AsyncTimeout = 3000;
+        return o;
+    }
+
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        _mux ??= await ConnectionMultiplexer.ConnectAsync(_opts).WaitAsync(ct);
+        await _mux.GetDatabase().PingAsync().WaitAsync(ct);
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        if (_mux is not null) await _mux.DisposeAsync();
+    }
+}
