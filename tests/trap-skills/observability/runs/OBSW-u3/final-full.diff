+// Probes and scraping must not produce traces.
+static bool IsInfraPath(PathString p) =>
+    p.StartsWithSegments("/health") || p.StartsWithSegments("/metrics");
+
+// OTLP endpoint and protocol come from standard OTEL_EXPORTER_OTLP_* env vars.
+builder.Services.AddOpenTelemetry()
+    .ConfigureResource(r => r.AddService("orders-api"))
+    .WithTracing(t => t
+        .AddSource(OrdersTelemetry.Name)
+        .AddSource("Npgsql")
+        .AddAspNetCoreInstrumentation(o =>
+        {
+            o.Filter = ctx => !IsInfraPath(ctx.Request.Path);
+            o.RecordException = true;
+        })
+        .AddOtlpExporter())
+    .WithMetrics(m => m
+        .AddMeter(OrdersTelemetry.Name)
+        .AddAspNetCoreInstrumentation()
+        .AddPrometheusExporter());
+
+// Singletons: AddCheck<T> reuses a registered instance, so cached results survive between probes.
+builder.Services.AddSingleton<PostgresHealthCheck>();
+builder.Services.AddSingleton<RedisHealthCheck>();
+builder.Services.AddHealthChecks()
+    .AddCheck<PostgresHealthCheck>("postgres", tags: ["ready"])
+    .AddCheck<RedisHealthCheck>("redis", tags: ["ready"]);
+
 var app = builder.Build();
+app.MapPrometheusScrapingEndpoint("/metrics");
+app.MapHealthChecks("/health/live", new() { Predicate = _ => false });
+app.MapHealthChecks("/health/ready", new() { Predicate = c => c.Tags.Contains("ready") });
