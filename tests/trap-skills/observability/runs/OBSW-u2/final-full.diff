@@ -0,0 +1,25 @@
+using System.Diagnostics;
+using System.Diagnostics.Metrics;
+
+namespace OrdersApi.Observability;
+
+public static class Telemetry
+{
+    public const string Name = "OrdersApi";
+
+    public static readonly ActivitySource Source = new(Name);
+    public static readonly Meter Meter = new(Name);
+
+    public static readonly Counter<long> OrdersCreated =
+        Meter.CreateCounter<long>("orders.created", "{order}", "Orders by channel and final status");
+
+    public static readonly Histogram<double> OrderCreateDuration =
+        Meter.CreateHistogram<double>("orders.create.duration", "s", "Order creation duration");
+
+    // Канал приходит от клиента - в метку попадает только известное значение, иначе кардинальность не ограничена.
+    public static string ChannelTag(string? channel) => channel switch
+    {
+        "web" or "mobile" or "partner" => channel,
+        _ => "other"
+    };
+}
