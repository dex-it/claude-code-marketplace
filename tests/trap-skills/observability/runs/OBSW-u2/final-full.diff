+using Microsoft.AspNetCore.Diagnostics.HealthChecks;
+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using OpenTelemetry.Metrics;
+using OpenTelemetry.Resources;
+using OpenTelemetry.Trace;
+using OrdersApi.Observability;
 using OrdersApi.Orders;
 using Serilog;
 
 var builder = WebApplication.CreateBuilder(args);
-builder.Host.UseSerilog((ctx, cfg) => cfg.ReadFrom.Configuration(ctx.Configuration).WriteTo.Console());
+builder.Host.UseSerilog((ctx, cfg) => cfg
+    .ReadFrom.Configuration(ctx.Configuration)
+    .Enrich.WithSpan()
+    .WriteTo.Console(outputTemplate:
+        "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}/{SpanId}] {Message:lj}{NewLine}{Exception}"));
 builder.Services.AddSingleton<IOrderRepository, OrderRepository>();
 builder.Services.AddScoped<OrderService>();
 
+// Пробы и скрейп метрик не должны попадать в трассы.
+static bool IsInfra(PathString p) => p.StartsWithSegments("/health") || p.StartsWithSegments("/metrics");
+
+builder.Services.AddOpenTelemetry()
+    .ConfigureResource(r => r.AddService("orders-api"))
+    .WithTracing(t => t
+        .AddSource(Telemetry.Name)
+        .AddAspNetCoreInstrumentation(o => o.Filter = ctx => !IsInfra(ctx.Request.Path))
+        .AddOtlpExporter())
+    .WithMetrics(m => m
+        .AddMeter(Telemetry.Name)
+        .AddAspNetCoreInstrumentation()
+        .AddPrometheusExporter());
+
+builder.Services.AddSingleton(TimeProvider.System);
+var probeTtl = TimeSpan.FromSeconds(10);
+var probeTimeout = TimeSpan.FromSeconds(3);
+builder.Services.AddHealthChecks()
+    .Add(new HealthCheckRegistration("postgres",
+        sp => new CachedHealthCheck(ActivatorUtilities.CreateInstance<PostgresHealthCheck>(sp), probeTtl, sp.GetRequiredService<TimeProvider>()),
+        HealthStatus.Unhealthy, new[] { "ready" }, probeTimeout))
+    .Add(new HealthCheckRegistration("redis",
+        sp => new CachedHealthCheck(ActivatorUtilities.CreateInstance<RedisHealthCheck>(sp), probeTtl, sp.GetRequiredService<TimeProvider>()),
+        HealthStatus.Unhealthy, new[] { "ready" }, probeTimeout));
+
 var app = builder.Build();
 app.MapPost("/orders", async (CreateOrderRequest r, OrderService s, CancellationToken ct) =>
     Results.Created("/orders", await s.CreateAsync(r, ct)));
 app.MapGet("/orders/{id:guid}", async (Guid id, IOrderRepository repo, CancellationToken ct) =>
     await repo.FindAsync(id, ct) is { } o ? Results.Ok(o) : Results.NotFound());
+// liveness не трогает зависимости, readiness проверяет Postgres и Redis
+app.MapHealthChecks("/health/live", new HealthCheckOptions { Predicate = _ => false });
+app.MapHealthChecks("/health/ready", new HealthCheckOptions { Predicate = c => c.Tags.Contains("ready") });
+app.MapPrometheusScrapingEndpoint();
 app.Run();
