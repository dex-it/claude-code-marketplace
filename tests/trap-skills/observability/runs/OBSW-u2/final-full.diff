+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public class PostgresHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        try
+        {
+            await using var c = new NpgsqlConnection(cfg.GetConnectionString("Orders"));
+            await c.OpenAsync(ct);
+            await using var cmd = new NpgsqlCommand("select 1", c);
+            await cmd.ExecuteScalarAsync(ct);
+            return HealthCheckResult.Healthy();
+        }
+        catch (Exception e) when (e is not OperationCanceledException)
+        {
+            return HealthCheckResult.Unhealthy("postgres unavailable", e);
+        }
+    }
+}
+
+public class RedisHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    private readonly SemaphoreSlim _lock = new(1, 1);
+    private IConnectionMultiplexer? _mux;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        try
+        {
+            var mux = await GetAsync(ct);
+            await mux.GetDatabase().PingAsync().WaitAsync(ct);
+            return HealthCheckResult.Healthy();
+        }
+        catch (Exception e) when (e is not OperationCanceledException)
+        {
+            return HealthCheckResult.Unhealthy("redis unavailable", e);
+        }
+    }
+
+    private async Task<IConnectionMultiplexer> GetAsync(CancellationToken ct)
+    {
+        if (_mux is { IsConnected: true }) return _mux;
+        await _lock.WaitAsync(ct);
+        try
+        {
+            if (_mux is { IsConnected: true }) return _mux;
+            var opts = ConfigurationOptions.Parse(cfg.GetConnectionString("Redis")!);
+            opts.AbortOnConnectFail = false;
+            opts.ConnectTimeout = 2000;
+            _mux ??= await ConnectionMultiplexer.ConnectAsync(opts).WaitAsync(ct);
+            return _mux;
+        }
+        finally { _lock.Release(); }
+    }
+}
+
+// Пробы k8s частые, а зависимости дёргать каждый раз незачем: результат живёт ttl.
+public class CachedHealthCheck(IHealthCheck inner, TimeSpan ttl, TimeProvider clock) : IHealthCheck
+{
+    private readonly SemaphoreSlim _lock = new(1, 1);
+    private HealthCheckResult _last;
+    private long _at;
+    private bool _has;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        if (Fresh()) return _last;
+        await _lock.WaitAsync(ct);
+        try
+        {
+            if (Fresh()) return _last;
+            _last = await inner.CheckHealthAsync(context, ct);
+            _at = clock.GetTimestamp();
+            _has = true;
+            return _last;
+        }
+        finally { _lock.Release(); }
+    }
+
+    private bool Fresh() => _has && clock.GetElapsedTime(_at) < ttl;
+}
