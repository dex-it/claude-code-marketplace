+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public class PostgresHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        await using var c = new NpgsqlConnection(cfg.GetConnectionString("Orders"));
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+        return HealthCheckResult.Healthy();
+    }
+}
+
+public sealed class RedisHealthCheck(IConfiguration cfg) : IHealthCheck, IAsyncDisposable
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private IConnectionMultiplexer? _mux;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        var mux = await GetAsync(ct);
+        var latency = await mux.GetDatabase().PingAsync().WaitAsync(ct);
+        return HealthCheckResult.Healthy(data: new Dictionary<string, object> { ["latencyMs"] = latency.TotalMilliseconds });
+    }
+
+    private async Task<IConnectionMultiplexer> GetAsync(CancellationToken ct)
+    {
+        if (_mux is { IsConnected: true } m) return m;
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (_mux is { IsConnected: true } ok) return ok;
+            if (_mux is not null) await _mux.DisposeAsync();
+            var opts = ConfigurationOptions.Parse(cfg.GetConnectionString("Redis")!);
+            opts.AbortOnConnectFail = false;
+            opts.ConnectTimeout = 2000;
+            opts.SyncTimeout = opts.AsyncTimeout = 2000;
+            return _mux = await ConnectionMultiplexer.ConnectAsync(opts).WaitAsync(ct);
+        }
+        finally { _gate.Release(); }
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        if (_mux is not null) await _mux.DisposeAsync();
+        _gate.Dispose();
+    }
+}
+
+/// <summary>Reuses the last result for <paramref name="ttl"/> so frequent probes don't hit the dependencies each time.</summary>
+public sealed class CachedHealthCheck(IHealthCheck inner, TimeSpan ttl) : IHealthCheck
+{
+    private readonly SemaphoreSlim _gate = new(1, 1);
+    private HealthCheckResult _last;
+    private long _expiresAt;
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        if (Environment.TickCount64 < Volatile.Read(ref _expiresAt)) return _last;
+        await _gate.WaitAsync(ct);
+        try
+        {
+            if (Environment.TickCount64 < _expiresAt) return _last;
+            HealthCheckResult result;
+            try { result = await inner.CheckHealthAsync(context, ct); }
+            catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
+            catch (Exception ex) { result = HealthCheckResult.Unhealthy(ex.GetType().Name, ex); }
+            _last = result;
+            Volatile.Write(ref _expiresAt, Environment.TickCount64 + (long)ttl.TotalMilliseconds);
+            return result;
+        }
+        finally { _gate.Release(); }
+    }
+}
