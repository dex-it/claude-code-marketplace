diff --git a/services/orders-api/Telemetry.cs b/services/orders-api/Telemetry.cs
new file mode 100644
index 0000000..5030ccd
--- /dev/null
+++ b/services/orders-api/Telemetry.cs
@@ -0,0 +1,25 @@
+using System.Diagnostics;
+using System.Diagnostics.Metrics;
+
+namespace OrdersApi;
+
+public static class Telemetry
+{
+    public const string Name = "OrdersApi";
+
+    public static readonly ActivitySource Source = new(Name);
+    public static readonly Meter Meter = new(Name);
+
+    public static readonly Counter<long> OrdersCreated =
+        Meter.CreateCounter<long>("orders.created", description: "Orders by channel and final status");
+
+    public static readonly Histogram<double> OrderCreateDuration =
+        Meter.CreateHistogram<double>("orders.create.duration", unit: "s", description: "Order creation duration");
+
+    // Channel comes from the client: bound the label set to keep metric cardinality finite.
+    public static string ChannelTag(string? channel) => channel switch
+    {
+        "web" or "mobile" or "partner" => channel,
+        _ => "other"
+    };
+}
