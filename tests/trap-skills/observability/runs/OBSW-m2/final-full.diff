+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi;
+
+// Each check enforces its own deadline, so a hanging dependency cannot hang the probe.
+public abstract class TimedHealthCheck(TimeSpan timeout) : IHealthCheck
+{
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        cts.CancelAfter(timeout);
+        try
+        {
+            await ProbeAsync(cts.Token);
+            return HealthCheckResult.Healthy();
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            return new HealthCheckResult(context.Registration.FailureStatus, $"timeout after {timeout.TotalSeconds}s");
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException)
+        {
+            return new HealthCheckResult(context.Registration.FailureStatus, ex.Message, ex);
+        }
+    }
+
+    protected abstract Task ProbeAsync(CancellationToken ct);
+}
+
+public class PostgresHealthCheck(IConfiguration cfg) : TimedHealthCheck(TimeSpan.FromSeconds(3))
+{
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        await using var c = new NpgsqlConnection(cfg.GetConnectionString("Orders"));
+        await c.OpenAsync(ct);
+        await using var cmd = new NpgsqlCommand("select 1", c);
+        await cmd.ExecuteScalarAsync(ct);
+    }
+}
+
+public class RedisHealthCheck(IConfiguration cfg) : TimedHealthCheck(TimeSpan.FromSeconds(3))
+{
+    protected override async Task ProbeAsync(CancellationToken ct)
+    {
+        var options = ConfigurationOptions.Parse(cfg.GetConnectionString("Redis")!);
+        options.AbortOnConnectFail = true;
+        options.ConnectTimeout = 2000;
+        options.SyncTimeout = 2000;
+        await using var mux = await ConnectionMultiplexer.ConnectAsync(options).WaitAsync(ct);
+        await mux.GetDatabase().PingAsync().WaitAsync(ct);
+    }
+}
