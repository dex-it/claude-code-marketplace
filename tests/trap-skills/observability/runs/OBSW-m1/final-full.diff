+using Microsoft.Extensions.Diagnostics.HealthChecks;
+using Npgsql;
+using StackExchange.Redis;
+
+namespace OrdersApi.Observability;
+
+public class PostgresHealthCheck(IConfiguration cfg) : IHealthCheck
+{
+    public static readonly TimeSpan Timeout = TimeSpan.FromSeconds(3);
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        cts.CancelAfter(Timeout);
+        try
+        {
+            await using var c = new NpgsqlConnection(cfg.GetConnectionString("Orders"));
+            await c.OpenAsync(cts.Token);
+            await using var cmd = new NpgsqlCommand("select 1", c);
+            await cmd.ExecuteScalarAsync(cts.Token);
+            return HealthCheckResult.Healthy();
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            return HealthCheckResult.Unhealthy($"postgres: timeout after {Timeout.TotalSeconds}s");
+        }
+        catch (Exception ex)
+        {
+            return HealthCheckResult.Unhealthy("postgres unavailable", ex);
+        }
+    }
+}
+
+public class RedisHealthCheck(IConnectionMultiplexer redis) : IHealthCheck
+{
+    public static readonly TimeSpan Timeout = TimeSpan.FromSeconds(3);
+
+    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext context, CancellationToken ct = default)
+    {
+        try
+        {
+            await redis.GetDatabase().PingAsync().WaitAsync(Timeout, ct);
+            return HealthCheckResult.Healthy();
+        }
+        catch (TimeoutException)
+        {
+            return HealthCheckResult.Unhealthy($"redis: timeout after {Timeout.TotalSeconds}s");
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException)
+        {
+            return HealthCheckResult.Unhealthy("redis unavailable", ex);
+        }
+    }
+}
