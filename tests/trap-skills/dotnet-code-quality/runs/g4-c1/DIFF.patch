+++ b/.github/workflows/notifications.yml
@@ -0,0 +1,24 @@
+name: notifications
+
+on:
+  push:
+    paths:
+      - 'services/notifications/**'
+  pull_request:
+    paths:
+      - 'services/notifications/**'
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: services/notifications
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: 8.0.x
+      - run: dotnet restore Billing.Notifications.sln
+      - run: dotnet build Billing.Notifications.sln --no-restore -c Release
+      - run: dotnet test Billing.Notifications.sln --no-build -c Release
