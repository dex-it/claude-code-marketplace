-export async function createShipmentForOrder(order, { carrier }) {
-  const { trackingNumber, eta } = await carrier.createShipment(order);
-  order.trackingNumber = trackingNumber;
-  order.eta = eta;
-  order.carrier = 'courier-service';
-  return order;
+import { CarrierError } from './carrier/errors.js';
+
+// carriers - по порядку предпочтения: основной, затем резервные. К следующему перевозчику переходим
+// только когда предыдущий недоступен (сеть, 5xx); отказ по существу (422, 401) - ошибка заказа.
+export async function createShipmentForOrder(order, { carriers, carrier = undefined }) {
+  const list = carriers ?? [carrier];
+  let lastError;
+  for (const current of list) {
+    try {
+      const { trackingNumber, eta } = await current.createShipment(order);
+      order.trackingNumber = trackingNumber;
+      order.eta = eta;
+      order.carrier = current.name;
+      return order;
+    } catch (error) {
+      if (!(error instanceof CarrierError) || !error.retryable) throw error;
+      lastError = error;
+    }
+  }
+  throw lastError;
 }
diff --git a/test/swiftpost.test.js b/test/swiftpost.test.js
new file mode 100644
index 0000000..cb06981
--- /dev/null
+++ b/test/swiftpost.test.js
@@ -0,0 +1,117 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createSwiftPostClient } from '../src/carrier/swiftpost.js';
+import { createCourierServiceClient } from '../src/carrier/courier-service.js';
+import { CarrierError } from '../src/carrier/errors.js';
+import { createShipmentForOrder } from '../src/shipping.js';
+import { handlePaymentWebhook } from '../src/http/webhooks.js';
+import { createStore } from '../src/store.js';
+import { formatEtaForSms } from '../src/eta.js';
+
+const makeOrder = (extra = {}) => ({
+  id: 1042,
+  status: 'created',
+  weightKg: 1.2,
+  express: false,
+  customer: { name: 'Мария Белова', phone: '+79213456703' },
+  address: { postcode: '190121', line: 'Санкт-Петербург, наб. Крюкова канала, 4, кв. 9' },
+  items: [{ sku: 'KETTLE-2', qty: 1 }],
+  history: [],
+  ...extra,
+});
+
+function fakeFetch(status, body) {
+  const calls = [];
+  const impl = async (url, init) => {
+    calls.push({ url, init });
+    return { ok: status >= 200 && status < 300, status, json: async () => body, text: async () => JSON.stringify(body) };
+  };
+  return { impl, calls };
+}
+
+test('SwiftPost: запрос в контракте песочницы, eta приводится к дате', async () => {
+  const { impl, calls } = fakeFetch(201, { id: 'shp_1', tracking_number: 'SP6326866184', estimated_delivery: '2026-10-08T18:00:00+03:00' });
+  const client = createSwiftPostClient({ baseUrl: 'http://sp.test', token: 'sbx_parcel_dev', fetchImpl: impl });
+  const result = await client.createShipment(makeOrder({ express: true }));
+  assert.deepEqual(result, { trackingNumber: 'SP6326866184', eta: '2026-10-08' });
+  assert.equal(calls[0].url, 'http://sp.test/v2/shipments');
+  assert.equal(calls[0].init.headers.authorization, 'Bearer sbx_parcel_dev');
+  const sent = JSON.parse(calls[0].init.body);
+  assert.equal(sent.weight_grams, 1200);
+  assert.equal(sent.service, 'express');
+  assert.equal(sent.reference, '1042');
+  assert.equal(sent.recipient.address.postcode, '190121');
+  assert.match(formatEtaForSms(result.eta), /^\d\d\.\d\d$/);
+});
+
+test('SwiftPost 503 - retryable; 422 - нет', async () => {
+  const mk = (status) => createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: fakeFetch(status, { code: 'X' }).impl });
+  await assert.rejects(mk(503).createShipment(makeOrder()), (e) => e instanceof CarrierError && e.retryable);
+  await assert.rejects(mk(422).createShipment(makeOrder()), (e) => e instanceof CarrierError && !e.retryable);
+});
+
+const okCarrier = (name, trackingNumber) => ({ name, createShipment: async () => ({ trackingNumber, eta: '2026-10-08' }) });
+const downCarrier = (name, status = 503) => ({ name, createShipment: async () => { throw new CarrierError('down', { carrier: name, status }); } });
+
+test('отправка: SwiftPost основной', async () => {
+  const order = await createShipmentForOrder(makeOrder(), { carriers: [okCarrier('swiftpost', 'SP1'), okCarrier('courier-service', 'CS-1')] });
+  assert.equal(order.carrier, 'swiftpost');
+  assert.equal(order.trackingNumber, 'SP1');
+});
+
+test('отправка: SwiftPost недоступен - резерв Курьер-Сервис', async () => {
+  const order = await createShipmentForOrder(makeOrder(), { carriers: [downCarrier('swiftpost'), okCarrier('courier-service', 'CS-1')] });
+  assert.equal(order.carrier, 'courier-service');
+  assert.equal(order.trackingNumber, 'CS-1');
+});
+
+test('отправка: отказ по существу (422) не уходит в резерв', async () => {
+  await assert.rejects(
+    createShipmentForOrder(makeOrder(), { carriers: [downCarrier('swiftpost', 422), okCarrier('courier-service', 'CS-1')] }),
+    (e) => e.status === 422,
+  );
+});
+
+test('отправка: оба недоступны - ошибка', async () => {
+  await assert.rejects(createShipmentForOrder(makeOrder(), { carriers: [downCarrier('swiftpost'), downCarrier('courier-service')] }), CarrierError);
+});
+
+test('вебхук оплаты: трек-номер и дата доставки', async () => {
+  const store = createStore([makeOrder()]);
+  const res = await handlePaymentWebhook(
+    { event: 'payment.succeeded', data: { order_id: 1042, amount_kopecks: 1 } },
+    { store, carriers: [okCarrier('swiftpost', 'SP1')] },
+  );
+  assert.equal(res.status, 'processed');
+  assert.equal(res.order.status, 'paid');
+  assert.equal(res.order.trackingNumber, 'SP1');
+  assert.equal(res.order.eta, '2026-10-08');
+});
+
+// Живой прогон по песочницам; без SWIFTPOST_SANDBOX_URL пропускается
+const sandbox = process.env.SWIFTPOST_SANDBOX_URL;
+const courierSandbox = process.env.COURIER_SANDBOX_URL;
+const live = { skip: !sandbox || !courierSandbox ? 'нет переменных *_SANDBOX_URL' : false };
+const setMode = (url, mode) => fetch(`${url}/__sandbox/mode`, { method: 'POST', body: JSON.stringify({ mode }) });
+
+test('песочница SwiftPost: трек-номер и дата', live, async () => {
+  const client = createSwiftPostClient({ baseUrl: sandbox, token: 'sbx_parcel_dev' });
+  const r = await client.createShipment(makeOrder());
+  assert.match(r.trackingNumber, /^SP\d+$/);
+  assert.match(r.eta, /^\d{4}-\d\d-\d\d$/);
+});
+
+test('песочница: SwiftPost 503 - резерв Курьер-Сервис', live, async () => {
+  const carriers = [
+    createSwiftPostClient({ baseUrl: sandbox, token: 'sbx_parcel_dev' }),
+    createCourierServiceClient({ baseUrl: courierSandbox, apiKey: 'cs_dev' }),
+  ];
+  await setMode(sandbox, 'unavailable');
+  try {
+    const order = await createShipmentForOrder(makeOrder(), { carriers });
+    assert.equal(order.carrier, 'courier-service');
+    assert.ok(order.trackingNumber && order.eta);
+  } finally {
+    await setMode(sandbox, 'normal');
+  }
+});