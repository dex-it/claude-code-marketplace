+import { CarrierError } from './errors.js';
+
+// Контракт сверен с песочницей, а не только с docs/integrations/swiftpost-api.md: песочница принимает
+// вес в граммах (weight_grams), отвечает { id, tracking_number, estimated_delivery } и ошибки
+// отдаёт плоско { code, message }.
+export function createSwiftPostClient({ baseUrl, token, fetchImpl = fetch }) {
+  return {
+    name: 'swiftpost',
+
+    async createShipment(order) {
+      const request = {
+        reference: String(order.id),
+        weight_grams: Math.round(order.weightKg * 1000),
+        service: order.express ? 'express' : 'standard',
+        recipient: {
+          name: order.customer.name,
+          phone: order.customer.phone,
+          address: { postcode: order.address.postcode, line: order.address.line },
+        },
+      };
+      let res;
+      try {
+        res = await fetchImpl(`${baseUrl}/v2/shipments`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+          body: JSON.stringify(request),
+        });
+      } catch (error) {
+        throw new CarrierError(`SwiftPost недоступен: ${error.message}`, { carrier: 'swiftpost' });
+      }
+      if (!res.ok) {
+        const text = await res.text();
+        throw new CarrierError(`SwiftPost ответил ${res.status}: ${text}`, { carrier: 'swiftpost', status: res.status });
+      }
+      const body = await res.json();
+      // estimated_delivery - ISO 8601 с зоной, внутри сервиса eta - YYYY-MM-DD
+      return { trackingNumber: body.tracking_number, eta: String(body.estimated_delivery).slice(0, 10) };
+    },
+  };
+}
