@@ -0,0 +1,43 @@
+import { CarrierError } from './errors.js';
+
+export function createSwiftPostClient({ baseUrl, token, fetchImpl = fetch }) {
+  return {
+    name: 'swiftpost',
+
+    async createShipment(order) {
+      const request = {
+        reference: String(order.id),
+        // В документации вес в килограммах, песочница принимает целые граммы - отправляем оба поля
+        weight_kg: order.weightKg,
+        weight_grams: Math.round(order.weightKg * 1000),
+        service: order.express ? 'express' : 'standard',
+        recipient: {
+          name: order.customer.name,
+          phone: order.customer.phone,
+          address: { postcode: order.address.postcode, line: order.address.line },
+        },
+      };
+      let res;
+      try {
+        res = await fetchImpl(`${baseUrl}/v2/shipments`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+          body: JSON.stringify(request),
+        });
+      } catch (error) {
+        throw new CarrierError(`SwiftPost недоступен: ${error.message}`, { carrier: 'swiftpost' });
+      }
+      if (!res.ok) {
+        const text = await res.text();
+        throw new CarrierError(`SwiftPost ответил ${res.status}: ${text}`, { carrier: 'swiftpost', status: res.status });
+      }
+      const body = await res.json();
+      // Документация: eta - YYYY-MM-DD; песочница: estimated_delivery - ISO 8601 с зоной. Берём дату.
+      const eta = String(body.eta ?? body.estimated_delivery ?? '').slice(0, 10);
+      if (!body.tracking_number || !/^\d{4}-\d{2}-\d{2}$/.test(eta)) {
+        throw new CarrierError('SwiftPost: в ответе нет трек-номера или даты доставки', { carrier: 'swiftpost', status: 502 });
+      }
+      return { trackingNumber: body.tracking_number, eta };
+    },
+  };
+}
diff --git a/src/carrier/with-fallback.js b/src/carrier/with-fallback.js
new file mode 100644
index 0000000..93cb431
--- /dev/null
+++ b/src/carrier/with-fallback.js
@@ -0,0 +1,19 @@
+import { CarrierError } from './errors.js';
+
+// Основной перевозчик; если он недоступен (CarrierError с retryable) - резервный.
+export function withFallback(primary, fallback) {
+  return {
+    name: primary.name,
+
+    async createShipment(order) {
+      try {
+        const result = await primary.createShipment(order);
+        return { ...result, carrier: primary.name };
+      } catch (error) {
+        if (!(error instanceof CarrierError) || !error.retryable) throw error;
+        const result = await fallback.createShipment(order);
+        return { ...result, carrier: fallback.name };
+      }
+    },
+  };
+}
