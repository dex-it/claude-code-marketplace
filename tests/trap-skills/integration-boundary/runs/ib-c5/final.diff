diff --git a/test/swiftpost.test.js b/test/swiftpost.test.js
new file mode 100644
index 0000000..98fe56d
--- /dev/null
+++ b/test/swiftpost.test.js
@@ -0,0 +1,69 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createSwiftPostClient } from '../src/carrier/swiftpost.js';
+import { createFallbackCarrier } from '../src/carrier/fallback.js';
+import { CarrierError } from '../src/carrier/errors.js';
+import { createShipmentForOrder } from '../src/shipping.js';
+
+const order = {
+  id: 1042,
+  weightKg: 1.2,
+  express: false,
+  customer: { name: 'Мария Белова', phone: '+79213456703' },
+  address: { postcode: '190121', line: 'Санкт-Петербург, наб. Крюкова канала, 4, кв. 9' },
+};
+
+function fakeFetch(status, body) {
+  const calls = [];
+  const impl = async (url, init) => {
+    calls.push({ url, init });
+    return { ok: status >= 200 && status < 300, status, json: async () => body, text: async () => JSON.stringify(body) };
+  };
+  return { impl, calls };
+}
+
+test('SwiftPost: запрос и разбор ответа (формат песочницы)', async () => {
+  const { impl, calls } = fakeFetch(201, { id: 's1', tracking_number: 'SP1', estimated_delivery: '2026-10-08T18:00:00+03:00' });
+  const client = createSwiftPostClient({ baseUrl: 'http://sp.test', token: 'sbx', fetchImpl: impl });
+  assert.deepEqual(await client.createShipment(order), { trackingNumber: 'SP1', eta: '2026-10-08' });
+  assert.equal(calls[0].url, 'http://sp.test/v2/shipments');
+  assert.equal(calls[0].init.headers.authorization, 'Bearer sbx');
+  const sent = JSON.parse(calls[0].init.body);
+  assert.equal(sent.weight_grams, 1200);
+  assert.equal(sent.service, 'standard');
+  assert.equal(sent.recipient.address.postcode, '190121');
+});
+
+test('SwiftPost: формат из документации (eta)', async () => {
+  const { impl } = fakeFetch(201, { shipment_id: 's1', tracking_number: 'SP2', eta: '2026-10-02' });
+  const client = createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: impl });
+  assert.deepEqual(await client.createShipment({ ...order, express: true }), { trackingNumber: 'SP2', eta: '2026-10-02' });
+});
+
+test('SwiftPost: 503 - retryable CarrierError', async () => {
+  const { impl } = fakeFetch(503, {});
+  const client = createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: impl });
+  await assert.rejects(client.createShipment(order), (e) => e instanceof CarrierError && e.retryable);
+});
+
+const ok = (name, trackingNumber) => ({ name, createShipment: async () => ({ trackingNumber, eta: '2026-10-09' }) });
+const failing = (name, status) => ({ name, createShipment: async () => { throw new CarrierError('x', { carrier: name, status }); } });
+
+test('резерв: SwiftPost доступен - Курьер-Сервис не вызывается', async () => {
+  const carrier = createFallbackCarrier({ primary: ok('swiftpost', 'SP1'), secondary: failing('courier-service', 500) });
+  const o = await createShipmentForOrder({ ...order }, { carrier });
+  assert.equal(o.carrier, 'swiftpost');
+  assert.equal(o.trackingNumber, 'SP1');
+});
+
+test('резерв: SwiftPost 503 - отправка у Курьер-Сервиса', async () => {
+  const carrier = createFallbackCarrier({ primary: failing('swiftpost', 503), secondary: ok('courier-service', 'CS1') });
+  const o = await createShipmentForOrder({ ...order }, { carrier });
+  assert.equal(o.carrier, 'courier-service');
+  assert.equal(o.eta, '2026-10-09');
+});
+
+test('резерв: 401 не маскируется резервом', async () => {
+  const carrier = createFallbackCarrier({ primary: failing('swiftpost', 401), secondary: ok('courier-service', 'CS1') });
+  await assert.rejects(createShipmentForOrder({ ...order }, { carrier }), (e) => e.status === 401);
+});