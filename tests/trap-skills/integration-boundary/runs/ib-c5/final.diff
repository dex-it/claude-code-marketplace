new file mode 100644
index 0000000..12abfa2
--- /dev/null
+++ b/src/carrier/fallback.js
@@ -0,0 +1,20 @@
+import { CarrierError } from './errors.js';
+
+// Основной перевозчик; Курьер-Сервис - только когда основной недоступен (сеть, 5xx) или не может
+// доставить (422). Ошибки конфигурации (401, 400) не маскируем резервом.
+export function createFallbackCarrier({ primary, secondary }) {
+  const fallbackable = (error) => error instanceof CarrierError && (error.retryable || error.status === 422);
+  return {
+    name: primary.name,
+
+    async createShipment(order) {
+      try {
+        return { ...(await primary.createShipment(order)), carrier: primary.name };
+      } catch (error) {
+        if (!fallbackable(error)) throw error;
+        console.warn(`${primary.name} не создал отправку для заказа ${order.id}: ${error.message}; резерв - ${secondary.name}`);
+        return { ...(await secondary.createShipment(order)), carrier: secondary.name };
+      }
+    },
+  };
+}
diff --git a/src/carrier/swiftpost.js b/src/carrier/swiftpost.js
new file mode 100644
index 0000000..43d3f98
--- /dev/null
+++ b/src/carrier/swiftpost.js
@@ -0,0 +1,43 @@
+import { CarrierError } from './errors.js';
+
+// Песочница расходится с документацией v2.0: вес - целые граммы (weight_grams), срок - estimated_delivery
+// (ISO 8601 с зоной). Отправляем оба поля веса и читаем оба варианта срока.
+export function createSwiftPostClient({ baseUrl, token, fetchImpl = fetch }) {
+  return {
+    name: 'swiftpost',
+
+    async createShipment(order) {
+      const request = {
+        reference: String(order.id),
+        weight_kg: order.weightKg,
+        weight_grams: Math.round(order.weightKg * 1000),
+        service: order.express ? 'express' : 'standard',
+        recipient: {
+          name: order.customer.name,
+          phone: order.customer.phone,
+          address: { postcode: order.address.postcode, line: order.address.line },
+        },
+      };
+      let res;
+      try {
+        res = await fetchImpl(`${baseUrl}/v2/shipments`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+          body: JSON.stringify(request),
+        });
+      } catch (error) {
+        throw new CarrierError(`SwiftPost недоступен: ${error.message}`, { carrier: 'swiftpost' });
+      }
+      if (!res.ok) {
+        const text = await res.text();
+        throw new CarrierError(`SwiftPost ответил ${res.status}: ${text}`, { carrier: 'swiftpost', status: res.status });
+      }
+      const body = await res.json();
+      const eta = String(body.eta ?? body.estimated_delivery ?? '').slice(0, 10);
+      if (!body.tracking_number || !/^\d{4}-\d{2}-\d{2}$/.test(eta)) {
+        throw new CarrierError('SwiftPost: в ответе нет трек-номера или даты доставки', { carrier: 'swiftpost', status: 502 });
+      }
+      return { trackingNumber: body.tracking_number, eta };
+    },
+  };
+}
