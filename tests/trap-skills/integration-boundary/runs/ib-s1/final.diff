+++ b/src/carrier/fallback.js
@@ -0,0 +1,20 @@
+import { CarrierError } from './errors.js';
+
+// Основной перевозчик; при его недоступности (сеть, 5xx) отправка создаётся у резервного.
+export function createFallbackCarrier({ primary, fallback, onFallback = () => {} }) {
+  return {
+    name: primary.name,
+
+    async createShipment(order) {
+      try {
+        const result = await primary.createShipment(order);
+        return { ...result, carrier: primary.name };
+      } catch (error) {
+        if (!(error instanceof CarrierError) || !error.retryable) throw error;
+        onFallback(error);
+        const result = await fallback.createShipment(order);
+        return { ...result, carrier: fallback.name };
+      }
+    },
+  };
+}
diff --git a/src/carrier/swiftpost.js b/src/carrier/swiftpost.js
