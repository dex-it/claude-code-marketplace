diff --git a/test/swiftpost.test.js b/test/swiftpost.test.js
new file mode 100644
index 0000000..0cd871f
--- /dev/null
+++ b/test/swiftpost.test.js
@@ -0,0 +1,99 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createSwiftPostClient } from '../src/carrier/swiftpost.js';
+import { createCourierServiceClient } from '../src/carrier/courier-service.js';
+import { createFallbackCarrier } from '../src/carrier/fallback.js';
+import { CarrierError } from '../src/carrier/errors.js';
+import { handlePaymentWebhook } from '../src/http/webhooks.js';
+import { createStore } from '../src/store.js';
+
+const makeOrder = () => ({
+  id: 1042,
+  status: 'created',
+  history: [],
+  weightKg: 1.2,
+  express: false,
+  customer: { name: 'Мария Белова', phone: '+79213456703' },
+  address: { postcode: '190121', line: 'Санкт-Петербург, наб. Крюкова канала, 4, кв. 9' },
+});
+
+function fakeFetch(status, body) {
+  const calls = [];
+  const impl = async (url, init) => {
+    calls.push({ url, init });
+    return { ok: status >= 200 && status < 300, status, json: async () => body, text: async () => JSON.stringify(body) };
+  };
+  return { impl, calls };
+}
+
+test('SwiftPost: запрос и разбор ответа (форма - как у песочницы)', async () => {
+  const { impl, calls } = fakeFetch(201, { id: 'shp_1', tracking_number: 'SP0001', estimated_delivery: '2026-10-08T18:00:00+03:00' });
+  const client = createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: impl });
+  assert.deepEqual(await client.createShipment(makeOrder()), { trackingNumber: 'SP0001', eta: '2026-10-08' });
+  assert.equal(calls[0].url, 'http://sp.test/v2/shipments');
+  assert.equal(calls[0].init.headers.authorization, 'Bearer t');
+  const sent = JSON.parse(calls[0].init.body);
+  assert.equal(sent.weight_grams, 1200);
+  assert.equal(sent.reference, '1042');
+  assert.equal(sent.service, 'standard');
+});
+
+test('SwiftPost: дата доставки приводится к московской', async () => {
+  const { impl } = fakeFetch(201, { tracking_number: 'SP1', estimated_delivery: '2026-10-07T22:30:00Z' });
+  const client = createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: impl });
+  assert.equal((await client.createShipment(makeOrder())).eta, '2026-10-08');
+});
+
+test('резерв: 503 SwiftPost - отправка у Курьер-Сервиса', async () => {
+  const sp = fakeFetch(503, { code: 'UNAVAILABLE' });
+  const cs = fakeFetch(200, { trackNo: 'CS-1', deliveryDate: '2026-10-09' });
+  const carrier = createFallbackCarrier({
+    primary: createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: sp.impl }),
+    fallback: createCourierServiceClient({ baseUrl: 'http://cs.test', apiKey: 'cs_dev', fetchImpl: cs.impl }),
+  });
+  const store = createStore([makeOrder()]);
+  const { order } = await handlePaymentWebhook({ event: 'payment.succeeded', data: { order_id: 1042 } }, { store, carrier });
+  assert.deepEqual([order.trackingNumber, order.eta, order.carrier], ['CS-1', '2026-10-09', 'courier-service']);
+});
+
+test('резерв не нужен при отказе по данным (4xx)', async () => {
+  const sp = fakeFetch(422, { error: { code: 'ADDRESS_UNDELIVERABLE' } });
+  const carrier = createFallbackCarrier({
+    primary: createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: sp.impl }),
+    fallback: { name: 'x', createShipment: async () => assert.fail('резерв не должен вызываться') },
+  });
+  await assert.rejects(carrier.createShipment(makeOrder()), CarrierError);
+});
+
+// Живой прогон против песочниц перевозчиков (README); без переменных окружения пропускается
+const SP = process.env.SWIFTPOST_SANDBOX_URL;
+const CS = process.env.COURIER_SANDBOX_URL;
+const live = { skip: !(SP && CS) && 'нет SWIFTPOST_SANDBOX_URL / COURIER_SANDBOX_URL' };
+const liveCarrier = () => createFallbackCarrier({
+  primary: createSwiftPostClient({ baseUrl: SP, token: 'sbx_parcel_dev' }),
+  fallback: createCourierServiceClient({ baseUrl: CS, apiKey: 'cs_dev' }),
+});
+const pay = async (carrier) => {
+  const store = createStore([makeOrder()]);
+  return (await handlePaymentWebhook({ event: 'payment.succeeded', data: { order_id: 1042 } }, { store, carrier })).order;
+};
+
+test('живая песочница: оплата -> трек-номер SwiftPost и дата YYYY-MM-DD', live, async () => {
+  const order = await pay(liveCarrier());
+  assert.equal(order.carrier, 'swiftpost');
+  assert.match(order.trackingNumber, /^SP\d+$/);
+  assert.match(order.eta, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+test('живая песочница: SwiftPost недоступен - резерв Курьер-Сервис', live, async () => {
+  const setMode = (mode) => fetch(`${SP}/__sandbox/mode`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ mode }) });
+  await setMode('unavailable');
+  try {
+    const order = await pay(liveCarrier());
+    assert.equal(order.carrier, 'courier-service');
+    assert.match(order.trackingNumber, /^CS-/);
+    assert.match(order.eta, /^\d{4}-\d{2}-\d{2}$/);
+  } finally {
+    await setMode('normal'); // режим общий - обязательно вернуть
+  }
+});