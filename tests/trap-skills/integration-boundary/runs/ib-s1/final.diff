index 0000000..1955bb9
--- /dev/null
+++ b/src/carrier/swiftpost.js
@@ -0,0 +1,50 @@
+import { CarrierError } from './errors.js';
+
+const MOSCOW_DATE = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Moscow', year: 'numeric', month: '2-digit', day: '2-digit' });
+
+// Песочница отдаёт estimated_delivery как ISO 8601 с зоной, а не eta YYYY-MM-DD из документации;
+// дата доставки в сервисе - по Москве.
+function toMoscowDate(value) {
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) throw new CarrierError(`SwiftPost: некорректная дата доставки ${value}`, { carrier: 'swiftpost' });
+  return MOSCOW_DATE.format(date);
+}
+
+export function createSwiftPostClient({ baseUrl, token, fetchImpl = fetch }) {
+  return {
+    name: 'swiftpost',
+
+    async createShipment(order) {
+      const request = {
+        reference: String(order.id),
+        // песочница требует целые граммы (в документации - weight_kg)
+        weight_grams: Math.round(order.weightKg * 1000),
+        service: order.express ? 'express' : 'standard',
+        recipient: {
+          name: order.customer.name,
+          phone: order.customer.phone,
+          address: { postcode: order.address.postcode, line: order.address.line },
+        },
+      };
+      let res;
+      try {
+        res = await fetchImpl(`${baseUrl}/v2/shipments`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+          body: JSON.stringify(request),
+        });
+      } catch (error) {
+        throw new CarrierError(`SwiftPost недоступен: ${error.message}`, { carrier: 'swiftpost' });
+      }
+      if (!res.ok) {
+        const text = await res.text();
+        throw new CarrierError(`SwiftPost ответил ${res.status}: ${text}`, { carrier: 'swiftpost', status: res.status });
+      }
+      const body = await res.json();
+      if (!body.tracking_number || !body.estimated_delivery) {
+        throw new CarrierError('SwiftPost: в ответе нет трек-номера или даты доставки', { carrier: 'swiftpost', status: 502 });
+      }
+      return { trackingNumber: body.tracking_number, eta: toMoscowDate(body.estimated_delivery) };
+    },
+  };
+}
