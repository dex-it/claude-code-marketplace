diff --git a/test/sqlite-store.test.js b/test/sqlite-store.test.js
new file mode 100644
index 0000000..1eb1867
--- /dev/null
+++ b/test/sqlite-store.test.js
@@ -0,0 +1,40 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { DatabaseSync } from 'node:sqlite';
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createSqliteStore } from '../src/db/sqlite-store.js';
+
+const order = (id, name, createdAt) => ({ id, customerId: 'c', customer: { name }, status: 'paid', createdAt });
+
+test('searchByName: кириллица без учёта регистра, новые сверху, лимит', () => {
+  const store = createSqliteStore({
+    seed: [order(1, 'Анна Котова', '2026-09-01T00:00:00.000Z'), order(2, 'АННА КОТОВА', '2026-09-03T00:00:00.000Z'), order(3, 'Ильдар Сафин', '2026-09-02T00:00:00.000Z')],
+  });
+  for (const q of ['котова', 'Котова', 'КОТОВА']) assert.deepEqual(store.searchByName(q).map((o) => o.id), [2, 1]);
+  assert.deepEqual(store.searchByName('котова', 1).map((o) => o.id), [2]);
+  assert.deepEqual(store.searchByName('%_'), []);
+  store.close();
+});
+
+test('searchByName: put обновляет имя для поиска', () => {
+  const store = createSqliteStore();
+  store.put(order(1, 'Анна Котова', '2026-09-01T00:00:00.000Z'));
+  store.put(order(1, 'Анна Белова', '2026-09-01T00:00:00.000Z'));
+  assert.deepEqual(store.searchByName('котова'), []);
+  assert.equal(store.searchByName('белова').length, 1);
+  store.close();
+});
+
+test('searchByName: существующая база без нового столбца мигрирует', () => {
+  const path = join(mkdtempSync(join(tmpdir(), 'parcel-')), 'old.db');
+  const old = new DatabaseSync(path);
+  old.exec(`CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id TEXT NOT NULL, customer_name TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, doc TEXT NOT NULL)`);
+  const o = order(5, 'Анна Котова', '2026-09-01T00:00:00.000Z');
+  old.prepare('INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?)').run(5, 'c', 'Анна Котова', 'paid', o.createdAt, JSON.stringify(o));
+  old.close();
+  const store = createSqliteStore({ path });
+  assert.deepEqual(store.searchByName('КОТОВА').map((x) => x.id), [5]);
+  store.close();
+});
