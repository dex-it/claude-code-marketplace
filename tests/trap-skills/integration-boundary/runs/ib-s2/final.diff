index 0000000..b3b2245
--- /dev/null
+++ b/src/carrier/swiftpost.js
@@ -0,0 +1,39 @@
+import { CarrierError } from './errors.js';
+
+// Контракт сверен с песочницей: вес в граммах (weight_grams), ответ - tracking_number и
+// estimated_delivery (ISO 8601 с зоной), ошибки - плоское { code, message }.
+// Это расходится с docs/integrations/swiftpost-api.md (weight_kg, eta).
+export function createSwiftPostClient({ baseUrl, token, fetchImpl = fetch }) {
+  return {
+    name: 'swiftpost',
+
+    async createShipment(order) {
+      const request = {
+        reference: String(order.id),
+        weight_grams: Math.round(order.weightKg * 1000),
+        service: order.express ? 'express' : 'standard',
+        recipient: {
+          name: order.customer.name,
+          phone: order.customer.phone,
+          address: { postcode: order.address.postcode, line: order.address.line },
+        },
+      };
+      let res;
+      try {
+        res = await fetchImpl(`${baseUrl}/v2/shipments`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+          body: JSON.stringify(request),
+        });
+      } catch (error) {
+        throw new CarrierError(`SwiftPost недоступен: ${error.message}`, { carrier: 'swiftpost' });
+      }
+      if (!res.ok) {
+        const text = await res.text();
+        throw new CarrierError(`SwiftPost ответил ${res.status}: ${text}`, { carrier: 'swiftpost', status: res.status });
+      }
+      const body = await res.json();
+      return { trackingNumber: body.tracking_number, eta: body.estimated_delivery.slice(0, 10) };
+    },
+  };
+}
diff --git a/src/carrier/with-fallback.js b/src/carrier/with-fallback.js
new file mode 100644
index 0000000..377d47c
--- /dev/null
+++ b/src/carrier/with-fallback.js
@@ -0,0 +1,17 @@
+import { CarrierError } from './errors.js';
+
+// Основной перевозчик; если он недоступен (сеть, 5xx) - резервный. Остальные ошибки (422, 401) не маскируем.
+export function createFallbackCarrier({ primary, fallback }) {
+  return {
+    name: primary.name,
+
+    async createShipment(order) {
+      try {
+        return { ...(await primary.createShipment(order)), carrier: primary.name };
+      } catch (error) {
+        if (!(error instanceof CarrierError) || !error.retryable) throw error;
+        return { ...(await fallback.createShipment(order)), carrier: fallback.name };
+      }
+    },
+  };
+}
