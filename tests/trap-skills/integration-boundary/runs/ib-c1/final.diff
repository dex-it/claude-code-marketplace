+// SwiftPost - основной перевозчик, Курьер-Сервис - резервный
+export function defaultCarriers() {
+  return [
+    createSwiftPostClient({ baseUrl: config.swiftPost.url, token: config.swiftPost.token }),
+    createCourierServiceClient({ baseUrl: config.courierService.url, apiKey: config.courierService.token }),
