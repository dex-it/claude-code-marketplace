-export async function createShipmentForOrder(order, { carrier }) {
-  const { trackingNumber, eta } = await carrier.createShipment(order);
-  order.trackingNumber = trackingNumber;
-  order.eta = eta;
-  order.carrier = 'courier-service';
-  return order;
+import { CarrierError } from './carrier/errors.js';
+
+// 422 - SwiftPost не может доставить (адрес вне зоны, вес): пробуем следующего перевозчика
+function shouldFallBack(error) {
+  return error instanceof CarrierError && (error.retryable || error.status === 422);
+}
+
+// carriers - по порядку предпочтения; следующий пробуется, только если предыдущий недоступен
+export async function createShipmentForOrder(order, { carrier, carriers = [carrier] }) {
+  let lastError;
+  for (const candidate of carriers) {
+    try {
+      const { trackingNumber, eta } = await candidate.createShipment(order);
+      order.trackingNumber = trackingNumber;
+      order.eta = eta;
+      order.carrier = candidate.name;
+      return order;
+    } catch (error) {
+      if (!shouldFallBack(error)) throw error;
+      lastError = error;
+    }
+  }
+  throw lastError;
 }
diff --git a/test/swiftpost.test.js b/test/swiftpost.test.js
new file mode 100644
index 0000000..d6128cb
--- /dev/null
+++ b/test/swiftpost.test.js
@@ -0,0 +1,109 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createSwiftPostClient } from '../src/carrier/swiftpost.js';
+import { createCourierServiceClient } from '../src/carrier/courier-service.js';
+import { createStore } from '../src/store.js';
+import { handlePaymentWebhook } from '../src/http/webhooks.js';
+import { startSwiftPostSandbox } from '../tools/swiftpost-sandbox.mjs';
+import { startCourierSandbox } from '../tools/courier-sandbox.mjs';
+
+const newOrder = (over = {}) => ({
+  id: 1041,
+  status: 'created',
+  history: [],
+  weightKg: 1.2,
+  express: false,
+  totalKopecks: 126000,
+  customer: { name: 'Мария Белова', phone: '+79213456703' },
+  address: { postcode: '190121', line: 'Санкт-Петербург, наб. Крюкова канала, 4, кв. 9' },
+  ...over,
+});
+
+const paid = { event: 'payment.succeeded', data: { order_id: 1041, amount_kopecks: 126000 } };
+
+async function setup() {
+  const swift = await startSwiftPostSandbox({ port: 0 });
+  const courier = await startCourierSandbox({ port: 0 });
+  const carriers = [
+    createSwiftPostClient({ baseUrl: swift.url, token: 'sbx_parcel_dev' }),
+    createCourierServiceClient({ baseUrl: courier.url, apiKey: 'cs_dev' }),
+  ];
+  return { swift, courier, carriers, close: () => Promise.all([swift.close(), courier.close()]) };
+}
+
+test('оплата: отправка у SwiftPost, трек-номер и дата YYYY-MM-DD', async () => {
+  const env = await setup();
+  try {
+    const store = createStore([newOrder()]);
+    const { status, order } = await handlePaymentWebhook(paid, { store, carriers: env.carriers });
+    assert.equal(status, 'processed');
+    assert.equal(order.status, 'paid');
+    assert.equal(order.carrier, 'swiftpost');
+    assert.match(order.trackingNumber, /^SP\d{10}$/);
+    assert.match(order.eta, /^\d{4}-\d{2}-\d{2}$/);
+    assert.equal(env.swift.shipments.length, 1);
+  } finally {
+    await env.close();
+  }
+});
+
+test('SwiftPost недоступен - отправка у Курьер-Сервиса', async () => {
+  const env = await setup();
+  try {
+    env.swift.setMode('unavailable');
+    const store = createStore([newOrder()]);
+    const { order } = await handlePaymentWebhook(paid, { store, carriers: env.carriers });
+    assert.equal(order.carrier, 'courier-service');
+    assert.match(order.trackingNumber, /^CS-\d+$/);
+    assert.match(order.eta, /^\d{4}-\d{2}-\d{2}$/);
+  } finally {
+    await env.close();
+  }
+});
+
+test('адрес вне зоны SwiftPost (422) - резервный перевозчик', async () => {
+  const env = await setup();
+  try {
+    const store = createStore([newOrder({ address: { postcode: '000000', line: 'x' } })]);
+    const { order } = await handlePaymentWebhook(paid, { store, carriers: env.carriers });
+    assert.equal(order.carrier, 'courier-service');
+  } finally {
+    await env.close();
+  }
+});
+
+test('оба перевозчика недоступны - ошибка', async () => {
+  const env = await setup();
+  try {
+    env.swift.setMode('unavailable');
+    env.courier.setMode('unavailable');
+    const store = createStore([newOrder()]);
+    await assert.rejects(handlePaymentWebhook(paid, { store, carriers: env.carriers }), { name: 'CarrierError' });
+  } finally {
+    await env.close();
+  }
+});
+
+test('ошибка авторизации SwiftPost не маскируется резервом', async () => {
+  const env = await setup();
+  try {
+    const bad = createSwiftPostClient({ baseUrl: env.swift.url, token: 'wrong' });
+    const store = createStore([newOrder()]);
+    await assert.rejects(handlePaymentWebhook(paid, { store, carriers: [bad, env.carriers[1]] }), { status: 401 });
+  } finally {
+    await env.close();
+  }
+});
+
+test('eta в формате документации и экспресс - по контракту', async () => {
+  const calls = [];
+  const impl = async (url, init) => {
+    calls.push(JSON.parse(init.body));
+    return { ok: true, status: 201, json: async () => ({ tracking_number: 'SP0001234567', eta: '2026-10-02' }) };
+  };
+  const client = createSwiftPostClient({ baseUrl: 'http://sp.test', token: 't', fetchImpl: impl });
+  const result = await client.createShipment(newOrder({ express: true }));
+  assert.deepEqual(result, { trackingNumber: 'SP0001234567', eta: '2026-10-02' });
+  assert.equal(calls[0].service, 'express');
+  assert.equal(calls[0].weight_kg, 1.2);
+});