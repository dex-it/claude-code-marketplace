@@ -0,0 +1,53 @@
+import { CarrierError } from './errors.js';
+
+const moscowDay = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Moscow', year: 'numeric', month: '2-digit', day: '2-digit' });
+
+// eta приходит как YYYY-MM-DD (документация) или ISO 8601 с зоной (песочница); в заказе - дата по Москве
+function toEtaDate(eta) {
+  if (/^\d{4}-\d{2}-\d{2}$/.test(eta)) return eta;
+  const date = new Date(eta);
+  if (Number.isNaN(date.getTime())) throw new CarrierError(`SwiftPost вернул некорректную дату доставки: ${eta}`, { carrier: 'swiftpost' });
+  return moscowDay.format(date);
+}
+
+export function createSwiftPostClient({ baseUrl, token, fetchImpl = fetch }) {
+  return {
+    name: 'swiftpost',
+
+    async createShipment(order) {
+      const request = {
+        reference: String(order.id),
+        weight_kg: order.weightKg,
+        // песочница ждёт вес в граммах, в документации поля нет - отправляем оба
+        weight_grams: Math.max(1, Math.round(order.weightKg * 1000)),
+        service: order.express ? 'express' : 'standard',
+        recipient: {
+          name: order.customer.name,
+          phone: order.customer.phone,
+          address: { postcode: order.address.postcode, line: order.address.line },
+        },
+      };
+      let res;
+      try {
+        res = await fetchImpl(`${baseUrl}/v2/shipments`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
+          body: JSON.stringify(request),
+        });
+      } catch (error) {
+        throw new CarrierError(`SwiftPost недоступен: ${error.message}`, { carrier: 'swiftpost' });
+      }
+      if (!res.ok) {
+        const text = await res.text();
+        throw new CarrierError(`SwiftPost ответил ${res.status}: ${text}`, { carrier: 'swiftpost', status: res.status });
+      }
+      const body = await res.json();
+      // документация: tracking_number, eta; песочница: tracking_number, estimated_delivery
+      const eta = body.eta ?? body.estimated_delivery;
+      if (!body.tracking_number || !eta) {
+        throw new CarrierError('SwiftPost не вернул трек-номер или дату доставки', { carrier: 'swiftpost', status: res.status });
+      }
+      return { trackingNumber: body.tracking_number, eta: toEtaDate(eta) };
+    },
+  };
+}
