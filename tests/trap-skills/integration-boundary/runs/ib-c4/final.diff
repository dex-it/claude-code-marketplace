diff --git a/test/swiftpost.test.js b/test/swiftpost.test.js
new file mode 100644
index 0000000..4822794
--- /dev/null
+++ b/test/swiftpost.test.js
@@ -0,0 +1,77 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createSwiftPostClient } from '../src/carrier/swiftpost.js';
+import { withFallback } from '../src/carrier/fallback.js';
+import { CarrierError } from '../src/carrier/errors.js';
+import { createShipmentForOrder } from '../src/shipping.js';
+
+const order = {
+  id: 1042,
+  weightKg: 1.2,
+  express: false,
+  customer: { name: 'Мария Белова', phone: '+79213456703' },
+  address: { postcode: '190121', line: 'Санкт-Петербург, наб. Крюкова канала, 4, кв. 9' },
+};
+
+function fakeFetch(status, body) {
+  const calls = [];
+  const impl = async (url, init) => {
+    calls.push({ url, init });
+    return { ok: status >= 200 && status < 300, status, json: async () => body, text: async () => JSON.stringify(body) };
+  };
+  return { impl, calls };
+}
+
+const sp = (impl) => createSwiftPostClient({ baseUrl: 'http://sp.test', token: 'sbx_parcel_dev', fetchImpl: impl });
+const courier = { name: 'courier-service', createShipment: async () => ({ trackingNumber: 'CS-1', eta: '2026-10-05' }) };
+
+test('SwiftPost: запрос по контракту v2', async () => {
+  const { impl, calls } = fakeFetch(201, { id: 'shp_1', tracking_number: 'SP0001234567', estimated_delivery: '2026-10-02T18:00:00+03:00', label_url: 'u' });
+  const result = await sp(impl).createShipment(order);
+  assert.deepEqual(result, { trackingNumber: 'SP0001234567', eta: '2026-10-02T18:00:00+03:00' });
+  assert.equal(calls[0].url, 'http://sp.test/v2/shipments');
+  assert.equal(calls[0].init.headers.authorization, 'Bearer sbx_parcel_dev');
+  assert.deepEqual(JSON.parse(calls[0].init.body), {
+    reference: '1042',
+    weight_grams: 1200,
+    service: 'standard',
+    recipient: { name: 'Мария Белова', phone: '+79213456703', address: order.address },
+  });
+});
+
+test('SwiftPost: express-заказ - service express', async () => {
+  const { impl, calls } = fakeFetch(201, { tracking_number: 'SP1', estimated_delivery: '2026-10-02' });
+  await sp(impl).createShipment({ ...order, express: true });
+  assert.equal(JSON.parse(calls[0].init.body).service, 'express');
+});
+
+test('при 503 SwiftPost отправка создаётся у Курьер-Сервиса', async () => {
+  const { impl } = fakeFetch(503, { error: 'x' });
+  const o = { ...order };
+  await createShipmentForOrder(o, { carrier: withFallback(sp(impl), courier) });
+  assert.equal(o.carrier, 'courier-service');
+  assert.equal(o.trackingNumber, 'CS-1');
+});
+
+test('сетевая ошибка SwiftPost - резервный перевозчик', async () => {
+  const impl = async () => { throw new Error('ECONNREFUSED'); };
+  const o = { ...order };
+  await createShipmentForOrder(o, { carrier: withFallback(sp(impl), courier) });
+  assert.equal(o.carrier, 'courier-service');
+});
+
+test('SwiftPost доступен - трек и дата от SwiftPost, carrier swiftpost', async () => {
+  const { impl } = fakeFetch(201, { tracking_number: 'SP1', estimated_delivery: '2026-10-02' });
+  const o = { ...order };
+  await createShipmentForOrder(o, { carrier: withFallback(sp(impl), courier) });
+  assert.deepEqual([o.carrier, o.trackingNumber, o.eta], ['swiftpost', 'SP1', '2026-10-02']);
+});
+
+test('422 от SwiftPost - ошибка без отката на Курьер-Сервис', async () => {
+  const { impl } = fakeFetch(422, { error: { code: 'ADDRESS_UNDELIVERABLE' } });
+  await assert.rejects(withFallback(sp(impl), courier).createShipment(order), (e) => {
+    assert.ok(e instanceof CarrierError);
+    assert.equal(e.status, 422);
+    return true;
+  });
+});