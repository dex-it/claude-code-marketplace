+const MIN_QUERY_LENGTH = 2;
+const SEARCH_LIMIT = 50;
+
+export function searchOrders({ store, q }) {
+  const query = (q ?? '').trim();
+  if (query.length < MIN_QUERY_LENGTH) return { status: 400, body: { type: 'query-too-short' } };
+  return { status: 200, body: store.searchByName(query, SEARCH_LIMIT).map(toOrderResource) };
+}
