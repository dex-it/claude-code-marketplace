diff --git a/test/sqlite-store.test.js b/test/sqlite-store.test.js
new file mode 100644
index 0000000..05d9ae3
--- /dev/null
+++ b/test/sqlite-store.test.js
@@ -0,0 +1,64 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { createSqliteStore } from '../src/db/sqlite-store.js';
+import { createStore } from '../src/store.js';
+
+const order = (id, name, createdAt = '2026-09-01T10:00:00.000Z') => ({
+  id,
+  customerId: 'c-1',
+  customer: { name },
+  status: 'paid',
+  createdAt,
+});
+
+const orders = [
+  order(1, 'Анна Котова', '2026-09-01T10:00:00.000Z'),
+  order(2, 'Пётр Котов', '2026-09-03T10:00:00.000Z'),
+  order(3, 'Ivan Petrov', '2026-09-02T10:00:00.000Z'),
+  order(4, '100% скидка_'),
+];
+
+for (const [title, make] of [
+  ['память', () => createStore(orders)],
+  ['sqlite', () => createSqliteStore({ seed: orders })],
+]) {
+  test(`searchByName (${title}): кириллица без учёта регистра, новые сверху`, () => {
+    const store = make();
+    assert.deepEqual(store.searchByName('КОТОВА').map((o) => o.id), [1]);
+    assert.deepEqual(store.searchByName('котов').map((o) => o.id), [2, 1]);
+    assert.deepEqual(store.searchByName('PETROV').map((o) => o.id), [3]);
+    assert.deepEqual(store.searchByName('нет такого'), []);
+  });
+
+  test(`searchByName (${title}): % и _ - обычные символы, limit работает`, () => {
+    const store = make();
+    assert.deepEqual(store.searchByName('%').map((o) => o.id), [4]);
+    assert.deepEqual(store.searchByName('а_').map((o) => o.id), [4]);
+    assert.equal(store.searchByName('ко', 1).length, 1);
+    assert.equal(store.searchByName('ко', 1)[0].id, 2);
+  });
+}
+
+test('sqlite: put обновляет имя для поиска', () => {
+  const store = createSqliteStore({ seed: orders });
+  store.put(order(1, 'Анна Смирнова'));
+  assert.deepEqual(store.searchByName('котова'), []);
+  assert.deepEqual(store.searchByName('смирнова').map((o) => o.id), [1]);
+});
+
+test('sqlite: существующая база без столбца для поиска мигрирует и ищет', () => {
+  const path = join(mkdtempSync(join(tmpdir(), 'parcel-')), 'old.db');
+  const old = new DatabaseSync(path);
+  old.exec(`CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id TEXT NOT NULL, customer_name TEXT NOT NULL,
+    status TEXT NOT NULL, created_at TEXT NOT NULL, doc TEXT NOT NULL)`);
+  const o = order(1, 'Анна Котова');
+  old.prepare('INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?)').run(1, o.customerId, 'Анна Котова', o.status, o.createdAt, JSON.stringify(o));
+  old.close();
+  const store = createSqliteStore({ path });
+  assert.deepEqual(store.searchByName('КОТОВА').map((x) => x.id), [1]);
+  store.close();
+});