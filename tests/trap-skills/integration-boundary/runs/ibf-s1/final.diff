diff --git a/test/support-search.test.js b/test/support-search.test.js
new file mode 100644
index 0000000..0703c37
--- /dev/null
+++ b/test/support-search.test.js
@@ -0,0 +1,123 @@
+import { after, before, describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer } from '../src/http/server.js';
+import { createSqliteStore } from '../src/db/sqlite-store.js';
+import { createStore } from '../src/store.js';
+
+const order = (id, name, createdAt) => ({
+  id,
+  customerId: `c-${id}`,
+  customer: { name, phone: '+79210000000' },
+  status: 'paid',
+  totalKopecks: 10000,
+  createdAt,
+  items: [{ sku: 'KETTLE-2', qty: 1 }],
+});
+
+const orders = [
+  order(1, 'Анна Котова', '2026-09-01T10:00:00.000Z'),
+  order(2, 'Иван Петров', '2026-09-02T10:00:00.000Z'),
+  order(3, 'КОТОВА Мария', '2026-09-03T10:00:00.000Z'),
+  order(4, 'Ольга Котовская', '2026-09-04T10:00:00.000Z'),
+  order(5, '100% Смит_', '2026-09-05T10:00:00.000Z'),
+  order(6, 'Ivan Smith', '2026-09-06T10:00:00.000Z'),
+];
+
+// хранилище в памяти и настоящая SQLite: у SQLite свои правила регистра, поэтому прогоняем обе
+const variants = {
+  'в памяти': () => createStore(orders),
+  SQLite: () => createSqliteStore({ seed: orders }),
+};
+
+for (const [name, make] of Object.entries(variants)) {
+  describe(`поиск по имени получателя через HTTP (${name})`, () => {
+    let server, url, store;
+    before(async () => {
+      store = make();
+      server = createServer({ store });
+      await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+      url = `http://127.0.0.1:${server.address().port}`;
+    });
+    after(() => {
+      server.closeAllConnections();
+      store.close?.();
+      return new Promise((resolve) => server.close(resolve));
+    });
+
+    const search = async (q) => {
+      const res = await fetch(`${url}/api/support/orders?q=${encodeURIComponent(q)}`);
+      return { status: res.status, body: await res.json() };
+    };
+
+    for (const q of ['котова', 'Котова', 'КОТОВА']) {
+      it(`«${q}» находит заказы Котовой, новые сверху`, async () => {
+        const { status, body } = await search(q);
+        assert.equal(status, 200);
+        assert.deepEqual(body.map((o) => o.id), [3, 1]);
+      });
+    }
+
+    it('ответ - ресурс заказа как в GET /api/orders/:id', async () => {
+      const { body } = await search('петров');
+      const single = await (await fetch(`${url}/api/orders/2`)).json();
+      assert.deepEqual(body, [single]);
+    });
+
+    it('латиница без учёта регистра', async () => {
+      assert.deepEqual((await search('IVAN')).body.map((o) => o.id), [6]);
+    });
+
+    it('% и _ ищутся как обычные символы', async () => {
+      assert.deepEqual((await search('0% с')).body.map((o) => o.id), [5]);
+      assert.deepEqual((await search('т_')).body.map((o) => o.id), [5]);
+      assert.deepEqual((await search('%%')).body, []);
+    });
+
+    it('кавычка в строке не ломает запрос', async () => {
+      assert.deepEqual(await search("'; DROP TABLE orders; --"), { status: 200, body: [] });
+    });
+
+    it('ничего не найдено - пустой массив', async () => {
+      assert.deepEqual(await search('Несуществующий'), { status: 200, body: [] });
+    });
+
+    it('короче 2 символов или без q - 400 query-too-short', async () => {
+      for (const q of ['', 'к', ' к ']) {
+        assert.deepEqual(await search(q), { status: 400, body: { type: 'query-too-short' } });
+      }
+      const res = await fetch(`${url}/api/support/orders`);
+      assert.equal(res.status, 400);
+    });
+  });
+
+  describe(`не больше 50 результатов (${name})`, () => {
+    it('отдаёт 50 самых новых', () => {
+      const many = Array.from({ length: 60 }, (_, i) =>
+        order(i + 1, 'Массовый Клиент', new Date(Date.UTC(2026, 0, 1, 0, i)).toISOString()),
+      );
+      const store = name === 'SQLite' ? createSqliteStore({ seed: many }) : createStore(many);
+      const found = store.searchByCustomerName('массовый', 50);
+      assert.equal(found.length, 50);
+      assert.equal(found[0].id, 60);
+      assert.equal(found[49].id, 11);
+    });
+  });
+}
+
+describe('SQLite: база, созданная до PAR-31', () => {
+  it('миграция добавляет столбец поиска и заполняет его', async () => {
+    const { mkdtempSync } = await import('node:fs');
+    const { DatabaseSync } = await import('node:sqlite');
+    const { tmpdir } = await import('node:os');
+    const path = `${mkdtempSync(`${tmpdir()}/parcel-`)}/old.db`;
+    const old = new DatabaseSync(path);
+    old.exec(`CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id TEXT NOT NULL, customer_name TEXT NOT NULL,
+      status TEXT NOT NULL, created_at TEXT NOT NULL, doc TEXT NOT NULL)`);
+    const o = orders[0];
+    old.prepare('INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?)').run(o.id, o.customerId, o.customer.name, o.status, o.createdAt, JSON.stringify(o));
+    old.close();
+    const store = createSqliteStore({ path });
+    assert.deepEqual(store.searchByCustomerName('КОТОВА').map((x) => x.id), [1]);
+    store.close();
+  });
+});