diff --git a/test/support-search.test.js b/test/support-search.test.js
new file mode 100644
index 0000000..c72e18c
--- /dev/null
+++ b/test/support-search.test.js
@@ -0,0 +1,162 @@
+import { after, before, describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { createServer } from '../src/http/server.js';
+import { createSqliteStore } from '../src/db/sqlite-store.js';
+import { createStore } from '../src/store.js';
+
+const order = (id, name, createdAt, extra = {}) => ({
+  id,
+  customerId: `c-${id}`,
+  customer: { name, phone: '+79161234501' },
+  status: 'paid',
+  totalKopecks: 10000,
+  createdAt,
+  items: [{ sku: 'KETTLE-2', qty: 1 }],
+  ...extra,
+});
+
+const seed = () => [
+  order(1, 'Анна Котова', '2026-09-01T10:00:00.000Z'),
+  order(2, 'Ильдар Сафин', '2026-09-02T10:00:00.000Z'),
+  order(3, 'Анна Котова', '2026-09-03T10:00:00.000Z', { giftMessage: 'Привет' }),
+  order(4, 'John Smith', '2026-09-04T10:00:00.000Z'),
+  order(5, 'Мария 100%_Белова', '2026-09-05T10:00:00.000Z'),
+];
+
+// SQLite и хранилище в памяти должны отвечать одинаково - гоняем один набор на обоих
+const impls = {
+  sqlite: () => createSqliteStore({ seed: seed() }),
+  memory: () => createStore(seed()),
+};
+
+for (const [kind, make] of Object.entries(impls)) {
+  describe(`searchByCustomerName: ${kind}`, () => {
+    const ids = (rows) => rows.map((o) => o.id);
+
+    it('без учёта регистра, в том числе кириллицы, новые сверху', () => {
+      const store = make();
+      for (const q of ['котова', 'Котова', 'КОТОВА', 'ОТОВ']) {
+        assert.deepEqual(ids(store.searchByCustomerName(q)), [3, 1], q);
+      }
+      assert.deepEqual(ids(store.searchByCustomerName('JOHN')), [4]);
+    });
+
+    it('подстрока в любом месте имени, включая пробел', () => {
+      const store = make();
+      assert.deepEqual(ids(store.searchByCustomerName('а к')), [3, 1]);
+    });
+
+    it('% и _ - обычные символы, не шаблон', () => {
+      const store = make();
+      assert.deepEqual(ids(store.searchByCustomerName('%_')), [5]);
+      assert.deepEqual(ids(store.searchByCustomerName('__')), []);
+      assert.deepEqual(ids(store.searchByCustomerName("'; DROP")), []);
+    });
+
+    it('ничего не нашлось - пустой массив', () => {
+      assert.deepEqual(make().searchByCustomerName('Нет такого'), []);
+    });
+
+    it('не больше limit, самые новые', () => {
+      const store = make();
+      for (let i = 100; i < 160; i++) store.put(order(i, 'Пётр Массовый', new Date(Date.UTC(2026, 0, 1, 0, 0, i)).toISOString()));
+      const found = store.searchByCustomerName('массовый', 50);
+      assert.equal(found.length, 50);
+      assert.equal(found[0].id, 159);
+      assert.equal(found[49].id, 110);
+    });
+
+    it('после put с новым именем ищется по новому', () => {
+      const store = make();
+      store.put(order(2, 'Олег Орлов', '2026-09-02T10:00:00.000Z'));
+      assert.deepEqual(ids(store.searchByCustomerName('сафин')), []);
+      assert.deepEqual(ids(store.searchByCustomerName('ОРЛОВ')), [2]);
+    });
+  });
+}
+
+describe('SQLite: база, созданная до PAR-31 (без столбца поиска)', () => {
+  let dir;
+  before(() => {
+    dir = mkdtempSync(join(tmpdir(), 'parcel-'));
+  });
+  after(() => rmSync(dir, { recursive: true, force: true }));
+
+  it('столбец добавляется и заполняется для существующих заказов', () => {
+    const path = join(dir, 'old.db');
+    const old = new DatabaseSync(path);
+    old.exec(`CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id TEXT NOT NULL, customer_name TEXT NOT NULL,
+      status TEXT NOT NULL, created_at TEXT NOT NULL, doc TEXT NOT NULL)`);
+    const o = order(7, 'Анна Котова', '2026-09-01T10:00:00.000Z');
+    old
+      .prepare('INSERT INTO orders VALUES (?, ?, ?, ?, ?, ?)')
+      .run(7, o.customerId, o.customer.name, o.status, o.createdAt, JSON.stringify(o));
+    old.close();
+
+    const store = createSqliteStore({ path });
+    assert.deepEqual(store.searchByCustomerName('КОТОВ').map((x) => x.id), [7]);
+    store.close();
+  });
+});
+
+describe('GET /api/support/orders (сервер на SQLite)', () => {
+  let server, url, store;
+
+  before(async () => {
+    store = createSqliteStore({ seed: seed() });
+    server = createServer({ store });
+    await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+    url = `http://127.0.0.1:${server.address().port}`;
+  });
+
+  after(() => {
+    server.closeAllConnections();
+    store.close();
+    return new Promise((resolve) => server.close(resolve));
+  });
+
+  const search = (q) => fetch(`${url}/api/support/orders${q === undefined ? '' : `?q=${encodeURIComponent(q)}`}`);
+
+  it('находит заказы по имени в любом регистре, ресурс как в GET /api/orders/:id', async () => {
+    for (const q of ['котова', 'Котова', 'КОТОВА']) {
+      const res = await search(q);
+      assert.equal(res.status, 200);
+      const body = await res.json();
+      assert.deepEqual(body.map((o) => o.id), [3, 1], q);
+    }
+    const [first] = await (await search('котова')).json();
+    const single = await (await fetch(`${url}/api/orders/3`)).json();
+    assert.deepEqual(first, single);
+    assert.equal(first.giftMessage, 'Привет');
+    assert.equal(first.createdAt, Date.parse('2026-09-03T10:00:00.000Z'));
+  });
+
+  it('строка короче 2 символов или без q - 400 query-too-short', async () => {
+    for (const q of ['', 'к', undefined]) {
+      const res = await search(q);
+      assert.equal(res.status, 400, String(q));
+      assert.deepEqual(await res.json(), { type: 'query-too-short' });
+    }
+  });
+
+  it('ровно 2 символа - допустимо', async () => {
+    assert.equal((await search('ко')).status, 200);
+  });
+
+  it('не нашлось - 200 и []', async () => {
+    const res = await search('Нет такого');
+    assert.equal(res.status, 200);
+    assert.deepEqual(await res.json(), []);
+  });
+
+  it('не больше 50 заказов', async () => {
+    for (let i = 100; i < 160; i++) store.put(order(i, 'Пётр Массовый', new Date(Date.UTC(2026, 0, 1, 0, 0, i)).toISOString()));
+    const body = await (await search('массовый')).json();
+    assert.equal(body.length, 50);
+    assert.equal(body[0].id, 159);
+  });
+});