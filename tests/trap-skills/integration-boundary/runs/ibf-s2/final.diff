+const MIN_QUERY = 2;
+const SEARCH_LIMIT = 50;
+
+export function searchOrders({ store, q }) {
+  const query = typeof q === 'string' ? q : '';
+  if ([...query].length < MIN_QUERY) return { status: 400, body: { type: 'query-too-short' } };
+  return { status: 200, body: store.searchByCustomerName(query, SEARCH_LIMIT).map(toOrderResource) };
+}
