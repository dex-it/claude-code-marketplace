@@ -0,0 +1,28 @@
+using System.Net;
+using System.Net.Http.Json;
+
+namespace Pricing.Suppliers;
+
+public sealed record SupplierPrice(string Sku, decimal Price, string Currency);
+
+public interface ISupplierApiClient
+{
+    /// <summary>Текущая цена поставщика; null - поставщик SKU не знает.</summary>
+    Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct);
+}
+
+public sealed class SupplierApiClient(HttpClient http) : ISupplierApiClient
+{
+    private sealed record PriceResponse(string Sku, decimal Price, string Currency);
+
+    public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        using var response = await http.GetAsync(
+            $"v1/suppliers/{Uri.EscapeDataString(supplierId)}/prices/{Uri.EscapeDataString(sku)}", ct);
+        if (response.StatusCode == HttpStatusCode.NotFound) return null;
+        response.EnsureSuccessStatusCode();
+        var body = await response.Content.ReadFromJsonAsync<PriceResponse>(ct)
+            ?? throw new InvalidOperationException("Пустой ответ Supplier API");
+        return new SupplierPrice(body.Sku, body.Price, body.Currency);
+    }
+}
