@@ -0,0 +1,14 @@
+using Pricing.Application.Abstractions;
+using Pricing.Suppliers;
+using AppSupplierPrice = Pricing.Application.Abstractions.SupplierPrice;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class SupplierCatalogAdapter(ISupplierApiClient client) : ISupplierCatalog
+{
+    public async Task<AppSupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var price = await client.GetPriceAsync(supplierId, sku, ct);
+        return price is null ? null : new AppSupplierPrice(price.Sku, price.Price, price.Currency);
+    }
+}
