+using Microsoft.Extensions.Options;
+using Pricing.Suppliers;
+
+namespace Microsoft.Extensions.DependencyInjection;
+
+public static class SupplierApiServiceCollectionExtensions
+{
+    /// <summary>
+    /// Регистрирует клиента Supplier API с политикой устойчивости (retry, circuit breaker, timeouts).
+    /// Настройки берутся из <c>IOptions&lt;SupplierOptions&gt;</c>.
+    /// </summary>
+    public static IHttpClientBuilder AddSupplierApiClient(this IServiceCollection services)
+    {
+        var builder = services.AddHttpClient<ISupplierApiClient, SupplierApiClient>((sp, http) =>
+        {
+            var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+            http.BaseAddress = o.BaseUrl;
+            http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+        });
+        builder.AddStandardResilienceHandler();
+        return builder;
+    }
+}
