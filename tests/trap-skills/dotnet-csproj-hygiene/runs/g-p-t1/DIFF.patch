@@ -0,0 +1,16 @@
+using System.Net;
+using System.Net.Http.Json;
+
+namespace Pricing.Suppliers;
+
+internal sealed class SupplierClient(HttpClient http) : ISupplierClient
+{
+    public async Task<SupplierPriceResponse?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        using var response = await http.GetAsync($"v1/suppliers/{supplierId}/prices/{Uri.EscapeDataString(sku)}", ct);
+        if (response.StatusCode == HttpStatusCode.NotFound) return null;
+        response.EnsureSuccessStatusCode();
+        return await response.Content.ReadFromJsonAsync<SupplierPriceResponse>(ct)
+            ?? throw new InvalidOperationException("Пустой ответ Supplier API");
+    }
+}
