+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierClientExtensions
+{
+    /// <summary>Регистрирует <see cref="ISupplierClient"/> с настройками из секции <see cref="SupplierOptions.Section"/>.</summary>
+    public static IServiceCollection AddSupplierClient(this IServiceCollection services, IConfiguration config)
+    {
+        services.Configure<SupplierOptions>(config.GetSection(SupplierOptions.Section));
+        services.AddHttpClient<ISupplierClient, SupplierClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler();
+        return services;
+    }
+}
