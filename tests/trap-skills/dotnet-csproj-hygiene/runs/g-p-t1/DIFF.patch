+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Pricing.Infrastructure.Suppliers;
+using Pricing.Suppliers;
+
+namespace Pricing.Tests;
+
+public class SupplierCatalogAdapterTests
+{
+    private sealed class FakeSupplierClient(SupplierPriceResponse? response) : ISupplierClient
+    {
+        public Task<SupplierPriceResponse?> GetPriceAsync(string supplierId, string sku, CancellationToken ct) =>
+            Task.FromResult(response);
+    }
+
+    [Fact]
+    public async Task GetPriceAsync_MapsClientResponse()
+    {
+        var adapter = new SupplierCatalogAdapter(new FakeSupplierClient(new SupplierPriceResponse("A-1", 12.5m, "EUR")));
+
+        var price = await adapter.GetPriceAsync("s1", "A-1", CancellationToken.None);
+
+        Assert.NotNull(price);
+        Assert.Equal("A-1", price.Sku);
+        Assert.Equal(12.5m, price.Price);
+        Assert.Equal("EUR", price.Currency);
+    }
+
+    [Fact]
+    public async Task GetPriceAsync_UnknownSku_ReturnsNull()
+    {
+        var adapter = new SupplierCatalogAdapter(new FakeSupplierClient(null));
+
+        Assert.Null(await adapter.GetPriceAsync("s1", "missing", CancellationToken.None));
+    }
+
+    [Fact]
+    public void AddSupplierClient_RegistersClient()
+    {
+        var config = new ConfigurationBuilder().AddInMemoryCollection(new Dictionary<string, string?>
+        {
+            ["Suppliers:BaseUrl"] = "http://supplier.test/",
+            ["Suppliers:ApiKey"] = "k",
+        }).Build();
+        using var provider = new ServiceCollection().AddSupplierClient(config).BuildServiceProvider();
+
+        Assert.NotNull(provider.GetRequiredService<ISupplierClient>());
+    }
+}
