@@ -0,0 +1,21 @@
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierApiRegistration
+{
+    /// <summary>Регистрирует <see cref="ISupplierCatalog"/> как typed HttpClient со стандартной политикой устойчивости.</summary>
+    public static IServiceCollection AddSupplierApi(this IServiceCollection services, Action<SupplierOptions> configure)
+    {
+        services.Configure(configure);
+        services.AddHttpClient<ISupplierCatalog, SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler();
+        return services;
+    }
+}
