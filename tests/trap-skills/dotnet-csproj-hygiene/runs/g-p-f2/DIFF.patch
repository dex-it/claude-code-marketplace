@@ -0,0 +1,51 @@
+using System.Net;
+using System.Text;
+using Pricing.Suppliers;
+
+namespace Pricing.Tests;
+
+public class SupplierApiClientTests
+{
+    private sealed class StubHandler(HttpStatusCode status, string body = "") : HttpMessageHandler
+    {
+        public Uri? RequestUri { get; private set; }
+
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            RequestUri = request.RequestUri;
+            return Task.FromResult(new HttpResponseMessage(status)
+            {
+                Content = new StringContent(body, Encoding.UTF8, "application/json")
+            });
+        }
+    }
+
+    private static SupplierApiClient Create(StubHandler handler) =>
+        new(new HttpClient(handler) { BaseAddress = new Uri("http://supplier.test/") });
+
+    [Fact]
+    public async Task GetPrice_ReturnsPrice_AndEscapesSku()
+    {
+        var handler = new StubHandler(HttpStatusCode.OK, """{"sku":"A/1","price":12.5,"currency":"EUR"}""");
+
+        var price = await Create(handler).GetPriceAsync("s1", "A/1", CancellationToken.None);
+
+        Assert.Equal(new SupplierPriceDto("A/1", 12.5m, "EUR"), price);
+        Assert.Equal("/v1/suppliers/s1/prices/A%2F1", handler.RequestUri!.AbsolutePath + "");
+    }
+
+    [Fact]
+    public async Task GetPrice_ReturnsNull_WhenNotFound()
+    {
+        var price = await Create(new StubHandler(HttpStatusCode.NotFound)).GetPriceAsync("s1", "X", CancellationToken.None);
+
+        Assert.Null(price);
+    }
+
+    [Fact]
+    public async Task GetPrice_Throws_OnServerError()
+    {
+        await Assert.ThrowsAsync<HttpRequestException>(() =>
+            Create(new StubHandler(HttpStatusCode.InternalServerError)).GetPriceAsync("s1", "X", CancellationToken.None));
+    }
+}
