@@ -0,0 +1,22 @@
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierApiServiceCollectionExtensions
+{
+    /// <summary>Регистрирует <see cref="SupplierApiClient"/> с политикой устойчивости (retry, breaker, timeout).</summary>
+    public static IServiceCollection AddSupplierApiClient(this IServiceCollection services, IConfiguration section)
+    {
+        services.Configure<SupplierApiOptions>(section);
+        services.AddHttpClient<SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierApiOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler();
+        return services;
+    }
+}
