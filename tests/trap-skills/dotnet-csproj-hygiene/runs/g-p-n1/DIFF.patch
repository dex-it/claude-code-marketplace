@@ -0,0 +1,13 @@
+using Pricing.Application.Abstractions;
+using Pricing.Suppliers;
+
+namespace Pricing.Infrastructure;
+
+internal sealed class SupplierCatalogAdapter(ISupplierClient client) : ISupplierCatalog
+{
+    public async Task<Pricing.Application.Abstractions.SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var price = await client.GetPriceAsync(supplierId, sku, ct);
+        return price is null ? null : new Pricing.Application.Abstractions.SupplierPrice(price.Sku, price.Price, price.Currency);
+    }
+}
