@@ -0,0 +1,23 @@
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class ServiceCollectionExtensions
+{
+    /// <summary>
+    /// Регистрирует <see cref="ISupplierApiClient"/> со стандартной политикой устойчивости.
+    /// Настройки берутся из <see cref="SupplierOptions"/>.
+    /// </summary>
+    public static IServiceCollection AddSupplierApi(this IServiceCollection services)
+    {
+        services.AddHttpClient<ISupplierApiClient, SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler();
+        return services;
+    }
+}
