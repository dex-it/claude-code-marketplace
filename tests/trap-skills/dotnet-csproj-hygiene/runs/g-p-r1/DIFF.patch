@@ -0,0 +1,13 @@
+using Pricing.Application.Abstractions;
+using Pricing.Suppliers;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class SupplierCatalogAdapter(ISupplierApiClient client) : ISupplierCatalog
+{
+    public async Task<Application.Abstractions.SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var p = await client.GetPriceAsync(supplierId, sku, ct);
+        return p is null ? null : new Application.Abstractions.SupplierPrice(p.Sku, p.Price, p.Currency);
+    }
+}
