+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierClientServiceCollectionExtensions
+{
+    /// <summary>
+    /// Регистрирует <see cref="ISupplierApiClient"/> со стандартной политикой устойчивости.
+    /// Настройки берутся из IOptions&lt;SupplierOptions&gt;.
+    /// </summary>
+    public static IHttpClientBuilder AddSupplierApiClient(this IServiceCollection services)
+    {
+        services.AddOptions<SupplierOptions>();
+        var builder = services.AddHttpClient<ISupplierApiClient, SupplierApiClient>((sp, http) =>
+        {
+            var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+            http.BaseAddress = o.BaseUrl;
+            http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+        });
+        builder.AddStandardResilienceHandler();
+        return builder;
+    }
+}
