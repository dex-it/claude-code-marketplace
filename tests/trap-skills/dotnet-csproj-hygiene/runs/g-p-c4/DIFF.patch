@@ -0,0 +1,14 @@
+using Pricing.Application.Abstractions;
+using Pricing.Suppliers;
+using SupplierPrice = Pricing.Application.Abstractions.SupplierPrice;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+internal sealed class SupplierCatalog(SupplierApiClient client) : ISupplierCatalog
+{
+    public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var p = await client.GetPriceAsync(supplierId, sku, ct);
+        return p is null ? null : new SupplierPrice(p.Sku, p.Price, p.Currency);
+    }
+}
