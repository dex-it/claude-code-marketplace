@@ -0,0 +1,20 @@
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class ServiceCollectionExtensions
+{
+    /// <summary>Регистрирует typed-клиент Supplier API; настройки - секция <see cref="SupplierOptions.Section"/>.</summary>
+    public static IHttpClientBuilder AddSupplierClient(this IServiceCollection services, IConfiguration config)
+    {
+        services.Configure<SupplierOptions>(config.GetSection(SupplierOptions.Section));
+        return services.AddHttpClient<SupplierApiClient>((sp, http) =>
+        {
+            var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+            http.BaseAddress = o.BaseUrl;
+            http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+        });
+    }
+}
