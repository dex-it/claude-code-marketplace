new file mode 100644
index 0000000..a8210a7
--- /dev/null
+++ b/src/Pricing.Suppliers/SupplierApiClient.cs
@@ -0,0 +1,22 @@
+using System.Net;
+using System.Net.Http.Json;
+
+namespace Pricing.Suppliers;
+
+public sealed record SupplierPriceInfo(string Sku, decimal Price, string Currency);
+
+public sealed class SupplierApiClient(HttpClient http)
+{
+    private sealed record PriceResponse(string Sku, decimal Price, string Currency);
+
+    /// <summary>Текущая цена поставщика; null - поставщик SKU не знает.</summary>
+    public async Task<SupplierPriceInfo?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        using var response = await http.GetAsync($"v1/suppliers/{supplierId}/prices/{Uri.EscapeDataString(sku)}", ct);
+        if (response.StatusCode == HttpStatusCode.NotFound) return null;
+        response.EnsureSuccessStatusCode();
+        var body = await response.Content.ReadFromJsonAsync<PriceResponse>(ct)
+            ?? throw new InvalidOperationException("Пустой ответ Supplier API");
+        return new SupplierPriceInfo(body.Sku, body.Price, body.Currency);
+    }
+}
