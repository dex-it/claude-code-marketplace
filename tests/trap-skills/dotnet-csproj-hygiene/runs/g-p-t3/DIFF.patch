@@ -0,0 +1,44 @@
+using System.Net;
+using Pricing.Suppliers;
+
+namespace Pricing.Tests;
+
+public class SupplierApiClientTests
+{
+    private sealed class StubHandler(HttpStatusCode status, string body = "") : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct) =>
+            Task.FromResult(new HttpResponseMessage(status)
+            {
+                Content = new StringContent(body, System.Text.Encoding.UTF8, "application/json")
+            });
+    }
+
+    private static SupplierApiClient Client(HttpStatusCode status, string body = "") =>
+        new(new HttpClient(new StubHandler(status, body)) { BaseAddress = new Uri("http://supplier/") });
+
+    [Fact]
+    public async Task GetPrice_returns_price_from_response()
+    {
+        var client = Client(HttpStatusCode.OK, """{"sku":"A1","price":12.5,"currency":"EUR"}""");
+
+        var price = await client.GetPriceAsync("s1", "A1", CancellationToken.None);
+
+        Assert.Equal(new SupplierPriceInfo("A1", 12.5m, "EUR"), price);
+    }
+
+    [Fact]
+    public async Task GetPrice_returns_null_when_supplier_does_not_know_sku()
+    {
+        var price = await Client(HttpStatusCode.NotFound).GetPriceAsync("s1", "A1", CancellationToken.None);
+
+        Assert.Null(price);
+    }
+
+    [Fact]
+    public async Task GetPrice_throws_on_server_error()
+    {
+        await Assert.ThrowsAsync<HttpRequestException>(() =>
+            Client(HttpStatusCode.InternalServerError).GetPriceAsync("s1", "A1", CancellationToken.None));
+    }
+}
