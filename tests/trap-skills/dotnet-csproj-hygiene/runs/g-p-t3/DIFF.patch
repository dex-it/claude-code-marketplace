+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierServiceCollectionExtensions
+{
+    /// <summary>Регистрирует <see cref="SupplierApiClient"/> со стандартной политикой устойчивости; настройки - <see cref="SupplierOptions"/>.</summary>
+    public static IServiceCollection AddSupplierApiClient(this IServiceCollection services)
+    {
+        services.AddHttpClient<SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler();
+        return services;
+    }
+}
