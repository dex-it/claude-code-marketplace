+using Pricing.Application.Abstractions;
+using Pricing.Suppliers;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class SupplierCatalog(SupplierApiClient client) : ISupplierCatalog
+{
+    public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var price = await client.GetPriceAsync(supplierId, sku, ct);
+        return price is null ? null : new SupplierPrice(price.Sku, price.Price, price.Currency);
+    }
+}
