+namespace Pricing.Suppliers;
+
+public sealed class SupplierApiOptions
+{
+    public Uri BaseUrl { get; set; } = new("http://localhost:5100/");
+    public string ApiKey { get; set; } = "";
+
+    /// <summary>Срок одной попытки.</summary>
+    public TimeSpan AttemptTimeout { get; set; } = TimeSpan.FromSeconds(1);
+
+    /// <summary>Общий срок вызова с повторами; должен быть меньше срока вызывающего (у витрины - 3 с).</summary>
+    public TimeSpan TotalTimeout { get; set; } = TimeSpan.FromMilliseconds(2500);
+
+    /// <summary>Число повторов; поставщик ограничивает 20 запросов в секунду на ключ, повторов немного.</summary>
+    public int MaxRetryAttempts { get; set; } = 1;
+}
