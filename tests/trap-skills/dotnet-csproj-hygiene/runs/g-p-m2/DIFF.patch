+using Pricing.Application.Abstractions;
+using Pricing.Suppliers;
+
+namespace Pricing.Infrastructure.Suppliers;
+
+public sealed class SupplierCatalog(ISupplierApiClient client) : ISupplierCatalog
+{
+    public async Task<Application.Abstractions.SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        var price = await client.GetPriceAsync(supplierId, sku, ct);
+        return price is null ? null : new Application.Abstractions.SupplierPrice(price.Sku, price.Price, price.Currency);
+    }
+}
