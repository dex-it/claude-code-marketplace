@@ -0,0 +1,35 @@
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Http.Resilience;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierApiServiceCollectionExtensions
+{
+    // имя клиента - имя типа, пайплайн стандартного обработчика - "<клиент>-standard"
+    private const string ResilienceName = nameof(ISupplierApiClient) + "-standard";
+
+    /// <summary>Регистрирует <see cref="ISupplierApiClient"/> вместе с политикой устойчивости.</summary>
+    public static IServiceCollection AddSupplierApiClient(this IServiceCollection services, Action<SupplierApiOptions> configure)
+    {
+        services.Configure(configure);
+        services.AddHttpClient<ISupplierApiClient, SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierApiOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler();
+        services.AddOptions<HttpStandardResilienceOptions>(ResilienceName)
+            .Configure<IOptions<SupplierApiOptions>>((o, supplier) =>
+            {
+                var s = supplier.Value;
+                o.AttemptTimeout.Timeout = s.AttemptTimeout;
+                o.TotalRequestTimeout.Timeout = s.TotalTimeout;
+                o.Retry.MaxRetryAttempts = s.MaxRetryAttempts;
+                // окно выборки breaker не короче двух попыток
+                o.CircuitBreaker.SamplingDuration = TimeSpan.FromTicks(s.AttemptTimeout.Ticks * 2);
+            });
+        return services;
+    }
+}
