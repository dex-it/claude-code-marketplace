+using System.Net;
+using System.Text;
+using Pricing.Suppliers;
+
+namespace Pricing.Tests;
+
+public sealed class SupplierApiClientTests
+{
+    private sealed class StubHandler(HttpStatusCode status, string body = "") : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct) =>
+            Task.FromResult(new HttpResponseMessage(status) { Content = new StringContent(body, Encoding.UTF8, "application/json") });
+    }
+
+    private static SupplierApiClient Client(HttpStatusCode status, string body = "") =>
+        new(new HttpClient(new StubHandler(status, body)) { BaseAddress = new Uri("http://supplier.test/") });
+
+    [Fact]
+    public async Task GetPrice_returns_price_from_response()
+    {
+        var client = Client(HttpStatusCode.OK, """{"sku":"SKU-1","price":12.5,"currency":"RUB"}""");
+
+        var price = await client.GetPriceAsync("sup-1", "SKU-1", default);
+
+        Assert.Equal(new SupplierPrice("SKU-1", 12.5m, "RUB"), price);
+    }
+
+    [Fact]
+    public async Task GetPrice_returns_null_when_supplier_does_not_know_sku()
+    {
+        var price = await Client(HttpStatusCode.NotFound).GetPriceAsync("sup-1", "SKU-1", default);
+
+        Assert.Null(price);
+    }
+
+    [Fact]
+    public async Task GetPrice_throws_on_server_error()
+    {
+        await Assert.ThrowsAsync<HttpRequestException>(
+            () => Client(HttpStatusCode.ServiceUnavailable).GetPriceAsync("sup-1", "SKU-1", default));
+    }
+}
