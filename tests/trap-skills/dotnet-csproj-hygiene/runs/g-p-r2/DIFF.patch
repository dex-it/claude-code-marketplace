diff --git a/src/Pricing.Suppliers/SupplierClientExtensions.cs b/src/Pricing.Suppliers/SupplierClientExtensions.cs
new file mode 100644
index 0000000..2f66173
--- /dev/null
+++ b/src/Pricing.Suppliers/SupplierClientExtensions.cs
@@ -0,0 +1,32 @@
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierClientExtensions
+{
+    /// <summary>
+    /// Регистрирует <see cref="ISupplierCatalog"/> с политикой устойчивости. Настройки - секция
+    /// <see cref="SupplierOptions.Section"/>.
+    /// </summary>
+    public static IServiceCollection AddSupplierClient(this IServiceCollection services, IConfiguration config)
+    {
+        services.Configure<SupplierOptions>(config.GetSection(SupplierOptions.Section));
+        services.AddHttpClient<ISupplierCatalog, SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler(o =>
+            {
+                // Витрина ждёт ответа не дольше 3 с: общий срок вызова с повторами укладываем в него.
+                o.AttemptTimeout.Timeout = TimeSpan.FromSeconds(1);
+                o.TotalRequestTimeout.Timeout = TimeSpan.FromSeconds(2.5);
+                o.Retry.MaxRetryAttempts = 2;
+                o.CircuitBreaker.SamplingDuration = TimeSpan.FromSeconds(10);
+            });
+        return services;
+    }
+}
