@@ -0,0 +1,51 @@
+using System.Net;
+using System.Text;
+using Pricing.Suppliers;
+
+namespace Pricing.Tests;
+
+public class SupplierApiClientTests
+{
+    private sealed class StubHandler(HttpStatusCode status, string body = "") : HttpMessageHandler
+    {
+        public Uri? RequestUri { get; private set; }
+
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            RequestUri = request.RequestUri;
+            return Task.FromResult(new HttpResponseMessage(status)
+            {
+                Content = new StringContent(body, Encoding.UTF8, "application/json")
+            });
+        }
+    }
+
+    private static SupplierApiClient Client(StubHandler handler) =>
+        new(new HttpClient(handler) { BaseAddress = new Uri("http://supplier.test/") });
+
+    [Fact]
+    public async Task GetPrice_ReturnsPrice_WhenSupplierKnowsSku()
+    {
+        var handler = new StubHandler(HttpStatusCode.OK, """{"sku":"a b","price":12.5,"currency":"RUB"}""");
+
+        var price = await Client(handler).GetPriceAsync("sup-1", "a b", CancellationToken.None);
+
+        Assert.Equal(new SupplierPrice("a b", 12.5m, "RUB"), price);
+        Assert.Equal("/v1/suppliers/sup-1/prices/a%20b", handler.RequestUri!.AbsolutePath);
+    }
+
+    [Fact]
+    public async Task GetPrice_ReturnsNull_WhenSupplierDoesNotKnowSku()
+    {
+        var price = await Client(new StubHandler(HttpStatusCode.NotFound)).GetPriceAsync("sup-1", "x", CancellationToken.None);
+
+        Assert.Null(price);
+    }
+
+    [Fact]
+    public async Task GetPrice_Throws_WhenSupplierFails()
+    {
+        await Assert.ThrowsAsync<HttpRequestException>(() =>
+            Client(new StubHandler(HttpStatusCode.ServiceUnavailable)).GetPriceAsync("sup-1", "x", CancellationToken.None));
+    }
+}
