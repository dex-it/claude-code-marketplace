@@ -0,0 +1,32 @@
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class SupplierServiceCollectionExtensions
+{
+    /// <summary>Регистрирует <see cref="ISupplierCatalog"/> с повторами, circuit breaker и общим timeout.</summary>
+    public static IServiceCollection AddSupplierApi(this IServiceCollection services, IConfiguration config)
+    {
+        var section = config.GetSection(SupplierOptions.Section);
+        var settings = section.Get<SupplierOptions>() ?? new SupplierOptions();
+        services.Configure<SupplierOptions>(section);
+        services.AddHttpClient<ISupplierCatalog, SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler(options =>
+            {
+                options.TotalRequestTimeout.Timeout = settings.TotalTimeout;
+                options.AttemptTimeout.Timeout = settings.AttemptTimeout;
+                options.Retry.MaxRetryAttempts = settings.MaxRetryAttempts;
+                // Окно breaker должно вдвое превышать срок попытки - требование валидации опций
+                options.CircuitBreaker.SamplingDuration =
+                    TimeSpan.FromSeconds(Math.Max(30, 2 * settings.AttemptTimeout.TotalSeconds));
+            });
+        return services;
+    }
+}
