@@ -0,0 +1,21 @@
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+
+namespace Pricing.Suppliers;
+
+public static class ServiceCollectionExtensions
+{
+    public static IServiceCollection AddSupplierApi(this IServiceCollection services, IConfiguration config)
+    {
+        services.Configure<SupplierOptions>(config.GetSection(SupplierOptions.Section));
+        services.AddHttpClient<SupplierApiClient>((sp, http) =>
+            {
+                var o = sp.GetRequiredService<IOptions<SupplierOptions>>().Value;
+                http.BaseAddress = o.BaseUrl;
+                http.DefaultRequestHeaders.Add("X-Api-Key", o.ApiKey);
+            })
+            .AddStandardResilienceHandler();
+        return services;
+    }
+}
diff --git a/src/Pricing.Suppliers/SupplierApiClient.cs b/src/Pricing.Suppliers/SupplierApiClient.cs
new file mode 100644
index 0000000..20cee2f
--- /dev/null
+++ b/src/Pricing.Suppliers/SupplierApiClient.cs
@@ -0,0 +1,22 @@
+using System.Net;
+using System.Net.Http.Json;
+
+namespace Pricing.Suppliers;
+
+public sealed record SupplierPrice(string Sku, decimal Price, string Currency);
+
+public sealed class SupplierApiClient(HttpClient http)
+{
+    private sealed record PriceResponse(string Sku, decimal Price, string Currency);
+
+    /// <summary>Текущая цена поставщика; null - поставщик SKU не знает.</summary>
+    public async Task<SupplierPrice?> GetPriceAsync(string supplierId, string sku, CancellationToken ct)
+    {
+        using var response = await http.GetAsync($"v1/suppliers/{supplierId}/prices/{Uri.EscapeDataString(sku)}", ct);
+        if (response.StatusCode == HttpStatusCode.NotFound) return null;
+        response.EnsureSuccessStatusCode();
+        var body = await response.Content.ReadFromJsonAsync<PriceResponse>(ct)
+            ?? throw new InvalidOperationException("Пустой ответ Supplier API");
+        return new SupplierPrice(body.Sku, body.Price, body.Currency);
+    }
+}
